    {
      "Id": 100910270,
      "Speaker": "Player",
      "Text": "Were you swamped with work?"
    },
    {
      "Id": 100910280,
      "Speaker": "Player",
      "Text": "What're you doing so late? Class?"
    },
    {
      "Id": 100910290,
      "Speaker": "Student",
      "Text": "Nah."
    },
    {
      "Id": 100910300,
      "Speaker": "Student",
      "Text": "Practice just went pretty late."
    },
    {
      "Id": 100910310,
      "Speaker": "Student",
      "Text": "I'm beat. I don't know if I can make it home."
    },
