    {
      "Id": 100910120,
      "Speaker": "Student",
      "Text": "Where are you right now?"
    },
    {
      "Id": 100910130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'm gonna make you take responsibility."
    },
