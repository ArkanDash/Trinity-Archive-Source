    {
      "Id": 100910630,
      "Speaker": "Student",
      "Text": "#$uy%JE^a34%asjkhtd4a"
    },
    {
      "Id": 100910640,
      "Speaker": "Player",
      "Text": "Whoa, whoa. Calm down."
    },
    {
      "Id": 100910650,
      "Speaker": "Player",
      "Text": "Whoa. Language."
    },
    {
      "Id": 100910660,
      "Speaker": "Student",
      "Text": "No, like"
