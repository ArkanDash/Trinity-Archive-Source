      "Id": 100910790,
      "Speaker": "Student",
      "Text": "Yeah."
    },
    {
      "Id": 100910800,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 100910810,
      "Speaker": "Student",
      "Text": "Do you have a record player by any chance?"
