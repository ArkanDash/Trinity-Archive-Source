      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 100910020,
      "Speaker": "Student",
      "Text": "How'd this happen..."
    },
    {
      "Id": 100910030,
      "Speaker": "Student",
      "Text": "Me? A vocalist?"
    },
