      "Id": 100910070,
      "Speaker": "Student",
      "Text": "?"
    },
    {
      "Id": 100910080,
      "Speaker": "Student",
      "Text": "Wait. Actually..."
    },
    {
      "Id": 100910090,
      "Speaker": "Student",
      "Text": "If I really think about it, it's all your fault."
