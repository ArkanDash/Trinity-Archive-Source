    {
      "Id": 100910100,
      "Speaker": "Player",
      "Text": "หืม...?"
    },
    {
      "Id": 100910110,
      "Speaker": "Player",
      "Text": "โทษครูเหรอ?"
    },
    {
      "Id": 100910120,
      "Speaker": "Student",
      "Text": "ตอนนี้อยู่ที่ไหนน่ะ?"
    },
    {
      "Id": 100910130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ต้องให้มารับผิดชอบหน่อยแล้ว"
