{
  "CharacterId": 10142,
  "DialogJP": [
    {
      "Id": 101420010,
      "Speaker": "Student",
      "Text": "連絡くれてたんだね"
    },
    {
      "Id": 101420020,
      "Speaker": "Student",
      "Text": "急用だった？"
    },
    {
      "Id": 101420030,
      "Speaker": "Player",
      "Text": "最近暑いから大丈夫かなと思って"
    },
    {
      "Id": 101420040,
      "Speaker": "Student",
      "Text": "あ……うん、ありがとう"
    },
    {
      "Id": 101420050,
      "Speaker": "Student",
      "Text": "気にかけてくれて"
    },
    {
      "Id": 101420060,
      "Speaker": "Student",
      "Text": "大丈夫。ちゃんと水で涼んでるから"
    },
    {
      "Id": 101420070,
      "Speaker": "Player",
      "Text": "海で？"
    },
    {
      "Id": 101420080,
      "Speaker": "Player",
      "Text": "プールで？"
    },
    {
      "Id": 101420090,
      "Speaker": "Student",
      "Text": "実は……"
    },
    {
      "Id": 101420100,
      "Speaker": "Student",
      "Text": "庭でちょっとした射撃訓練をしてるんだ"
    },
    {
      "Id": 101420110,
      "Speaker": "Student",
      "Text": "水鉄砲で、だけど"
    },
    {
      "Id": 101420120,
      "Speaker": "Player",
      "Text": "つまり……水鉄砲遊びってこと？"
    },
    {
      "Id": 101420130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "そう言われると……そうかも？"
    },
    {
      "Id": 101420140,
      "Speaker": "Student",
      "Text": "やっぱり……"
    },
    {
      "Id": 101420150,
      "Speaker": "Student",
      "Text": "気にし過ぎだったみたい"
    },
    {
      "Id": 101420160,
      "Speaker": "Student",
      "Text": "百花繚乱のみんなにも同じことを言われた"
    },
    {
      "Id": 101420170,
      "Speaker": "Student",
      "Text": "私の水着姿で苦しむ人はいないって"
    },
    {
      "Id": 101420180,
      "Speaker": "Player",
      "Text": "ほら！言ったとおりでしょ"
    },
    {
      "Id": 101420190,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 101420200,
      "Speaker": "Student",
      "Text": "だから次は……"
    },
    {
      "Id": 101420210,
      "Speaker": "Student",
      "Text": "みんなと海に行ってみる"
    },
    {
      "Id": 101420220,
      "Speaker": "Student",
      "Text": "きっと……楽しいと思う"
    },
    {
      "Id": 101420230,
      "Speaker": "Player",
      "Text": "いいね。日焼け止めを忘れずに！"
    },
    {
      "Id": 101420240,
      "Speaker": "Student",
      "Text": "うん。ありがとう"
    },
    {
      "Id": 101420250,
      "Speaker": "Student",
      "Text": "みんなと海に行ってからというもの……"
    },
    {
      "Id": 101420260,
      "Speaker": "Student",
      "Text": "気づいたら海に行っちゃうんだ"
    },
    {
      "Id": 101420270,
      "Speaker": "Player",
      "Text": "海は楽しいよね"
    },
    {
      "Id": 101420280,
      "Speaker": "Student",
      "Text": "うん。楽しい"
    },
    {
      "Id": 101420290,
      "Speaker": "Student",
      "Text": "水泳は鍛錬になるし"
    },
    {
      "Id": 101420300,
      "Speaker": "Student",
      "Text": "雑念を払うのにも良い"
    },
    {
      "Id": 101420310,
      "Speaker": "Student",
      "Text": "それに、独特な雰囲気もあって"
    },
    {
      "Id": 101420320,
      "Speaker": "Student",
      "Text": "これなら、今までもっと行っておけば良かった"
    },
    {
      "Id": 101420330,
      "Speaker": "Player",
      "Text": "今からでもたくさん行けばいいよ"
    },
    {
      "Id": 101420340,
      "Speaker": "Student",
      "Text": "……うん。そうだね"
    },
    {
      "Id": 101420350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "これからは、どんどん海に行こうと思う"
    },
    {
      "Id": 101420360,
      "Speaker": "Student",
      "Text": "雪女の噂、まだ流れてるみたい"
    },
    {
      "Id": 101420370,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 101420380,
      "Speaker": "Student",
      "Text": "いちいち説明してたら逆に誤解されるかもしれないし"
    },
    {
      "Id": 101420390,
      "Speaker": "Student",
      "Text": "どうしたらいいのかな？"
    },
    {
      "Id": 101420400,
      "Speaker": "Player",
      "Text": "また一緒に海に行こう！"
    },
    {
      "Id": 101420410,
      "Speaker": "Student",
      "Text": "先生と一緒の姿を見せ続けたら"
    },
    {
      "Id": 101420420,
      "Speaker": "Student",
      "Text": "噂もすぐに消えるってこと？"
    },
    {
      "Id": 101420430,
      "Speaker": "Student",
      "Text": "うん……分かった"
    },
    {
      "Id": 101420440,
      "Speaker": "Player",
      "Text": "ナグサのためだからね……"
    },
    {
      "Id": 101420450,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101420460,
      "Speaker": "Student",
      "Text": "やっぱり先生は、したたかだよね"
    },
    {
      "Id": 101420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "どうして！？"
    },
    {
      "Id": 101420480,
      "Speaker": "Student",
      "Text": "帰り道に偶然、聞いたんだけど"
    },
    {
      "Id": 101420490,
      "Speaker": "Student",
      "Text": "海に雪女が出るっていう噂は……"
    },
    {
      "Id": 101420500,
      "Speaker": "Student",
      "Text": "全部嘘だったって"
    },
    {
      "Id": 101420510,
      "Speaker": "Player",
      "Text": "おお、作戦成功だね！"
    },
    {
      "Id": 101420520,
      "Speaker": "Student",
      "Text": "うん。大成功"
    },
    {
      "Id": 101420530,
      "Speaker": "Student",
      "Text": "もう安心して海に行ける"
    },
    {
      "Id": 101420540,
      "Speaker": "Player",
      "Text": "また一緒に行ってくれるよね？"
    },
    {
      "Id": 101420550,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101420560,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 101420570,
      "Speaker": "Student",
      "Text": "じゃあ、またね"
    },
    {
      "Id": 101420580,
      "Speaker": "Student",
      "Text": "今週はずっといい天気が続くみたいだね"
    },
    {
      "Id": 101420590,
      "Speaker": "Student",
      "Text": "それで、先生がよければだけど……"
    },
    {
      "Id": 101420600,
      "Speaker": "Student",
      "Text": "週末に会わない？"
    },
    {
      "Id": 101420610,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 101420620,
      "Speaker": "Player",
      "Text": "私も同じことを考えてたんだ！"
    },
    {
      "Id": 101420630,
      "Speaker": "Student",
      "Text": "それじゃ、また海に行こう"
    },
    {
      "Id": 101420640,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "また楽しいことがあるかも"
    }
  ],
  "DialogKR": [
    {
      "Id": 101420010,
      "Speaker": "Student",
      "Text": "안녕, 선생님."
    },
    {
      "Id": 101420020,
      "Speaker": "Student",
      "Text": "연락했었네. 무슨 일이야?"
    },
    {
      "Id": 101420030,
      "Speaker": "Player",
      "Text": "요즘 더운데 잘 지내나 해서"
    },
    {
      "Id": 101420040,
      "Speaker": "Student",
      "Text": "아…… 응."
    },
    {
      "Id": 101420050,
      "Speaker": "Student",
      "Text": "신경 써줘서 고마워."
    },
    {
      "Id": 101420060,
      "Speaker": "Student",
      "Text": "난 괜찮아. 틈틈이 피서를 즐기고 있거든."
    },
    {
      "Id": 101420070,
      "Speaker": "Player",
      "Text": "바다에서 놀기?"
    },
    {
      "Id": 101420080,
      "Speaker": "Player",
      "Text": "워터파크에서 놀기?"
    },
    {
      "Id": 101420090,
      "Speaker": "Student",
      "Text": "그게……"
    },
    {
      "Id": 101420100,
      "Speaker": "Student",
      "Text": "평소와 같은 사격 연습이야."
    },
    {
      "Id": 101420110,
      "Speaker": "Student",
      "Text": "물총으로 하는 게 좀 다르긴 하지만."
    },
    {
      "Id": 101420120,
      "Speaker": "Player",
      "Text": "즉…… 물총놀이를 한다?"
    },
    {
      "Id": 101420130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "그렇게 부른다면…… 그럴지도."
    },
    {
      "Id": 101420140,
      "Speaker": "Student",
      "Text": "선생님. 그게 말인데……."
    },
    {
      "Id": 101420150,
      "Speaker": "Student",
      "Text": "아무래도 내가 너무 걱정했던 것 같아."
    },
    {
      "Id": 101420160,
      "Speaker": "Student",
      "Text": "우리 부원들도 선생님과 똑같은 이야기를 하더라."
    },
    {
      "Id": 101420170,
      "Speaker": "Student",
      "Text": "내가 수영복을 입어도 사람들이 불편해하진 않을 거라고."
    },
    {
      "Id": 101420180,
      "Speaker": "Player",
      "Text": "그래! 괜한 걱정이라니까."
    },
    {
      "Id": 101420190,
      "Speaker": "Student",
      "Text": "응."
    },
    {
      "Id": 101420200,
      "Speaker": "Student",
      "Text": "그래서 다음엔……."
    },
    {
      "Id": 101420210,
      "Speaker": "Student",
      "Text": "부원 모두와 바다에 가보려고 해."
    },
    {
      "Id": 101420220,
      "Speaker": "Student",
      "Text": "분명…… 즐거운 시간이 될 거야."
    },
    {
      "Id": 101420230,
      "Speaker": "Player",
      "Text": "그래! 선크림 꼭 바르고!"
    },
    {
      "Id": 101420240,
      "Speaker": "Student",
      "Text": "응. 고마워, 선생님."
    },
    {
      "Id": 101420250,
      "Speaker": "Student",
      "Text": "부원들과 바다에 다녀온 뒤로……"
    },
    {
      "Id": 101420260,
      "Speaker": "Student",
      "Text": "요즘 시간이 날 때마다 해변을 찾고 있어."
    },
    {
      "Id": 101420270,
      "Speaker": "Player",
      "Text": "바다는 즐겁지?"
    },
    {
      "Id": 101420280,
      "Speaker": "Student",
      "Text": "응. 즐거워."
    },
    {
      "Id": 101420290,
      "Speaker": "Student",
      "Text": "수영은 신체 단련에 도움도 되고"
    },
    {
      "Id": 101420300,
      "Speaker": "Student",
      "Text": "잡생각을 떨치기에도 좋아."
    },
    {
      "Id": 101420310,
      "Speaker": "Student",
      "Text": "바다만이 가지는 고유의 운치도 있고."
    },
    {
      "Id": 101420320,
      "Speaker": "Student",
      "Text": "나는 왜 좀 더 일찍 바다에 가지 않았을까?"
    },
    {
      "Id": 101420330,
      "Speaker": "Player",
      "Text": "지금부터라도 더 자주 가면 되지!"
    },
    {
      "Id": 101420340,
      "Speaker": "Student",
      "Text": "……응. 그러게."
    },
    {
      "Id": 101420350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "좀 더 자주 바다에 가야겠어."
    },
    {
      "Id": 101420360,
      "Speaker": "Student",
      "Text": "으음……."
    },
    {
      "Id": 101420370,
      "Speaker": "Student",
      "Text": "여전히 해변에 설녀가 나타난다는 소문이 도는 것 같아."
    },
    {
      "Id": 101420380,
      "Speaker": "Student",
      "Text": "일일이 해명하면 오해만 키울 텐데."
    },
    {
      "Id": 101420390,
      "Speaker": "Student",
      "Text": "어떻게 해야 좋을까?"
    },
    {
      "Id": 101420400,
      "Speaker": "Player",
      "Text": "계속 같이 바다에 가는 거야!"
    },
    {
      "Id": 101420410,
      "Speaker": "Student",
      "Text": "설녀가 아닌 내 모습을 계속 보여주면"
    },
    {
      "Id": 101420420,
      "Speaker": "Student",
      "Text": "이상한 소문도 곧 사라질 거라는 거지?"
    },
    {
      "Id": 101420430,
      "Speaker": "Student",
      "Text": "응……. 알았어."
    },
    {
      "Id": 101420440,
      "Speaker": "Player",
      "Text": "모두 나구사를 위한 거니까."
    },
    {
      "Id": 101420450,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 101420460,
      "Speaker": "Student",
      "Text": "역시 선생님은 엉큼해."
    },
    {
      "Id": 101420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "어째서?!"
    },
    {
      "Id": 101420480,
      "Speaker": "Student",
      "Text": "오늘 돌아가는 길에 우연히 이런 이야기를 들었어."
    },
    {
      "Id": 101420490,
      "Speaker": "Student",
      "Text": "해변에 설녀가 나타났다는 소문은……"
    },
    {
      "Id": 101420500,
      "Speaker": "Student",
      "Text": "전부 헛소문인 것 같다고."
    },
    {
      "Id": 101420510,
      "Speaker": "Player",
      "Text": "오오, 계획 성공이네!"
    },
    {
      "Id": 101420520,
      "Speaker": "Student",
      "Text": "응. 성공이야."
    },
    {
      "Id": 101420530,
      "Speaker": "Student",
      "Text": "이제 안심하고 바다에 갈 수 있어."
    },
    {
      "Id": 101420540,
      "Speaker": "Player",
      "Text": "또 나랑 같이 가주는 거지?"
    },
    {
      "Id": 101420550,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 101420560,
      "Speaker": "Student",
      "Text": "응."
    },
    {
      "Id": 101420570,
      "Speaker": "Student",
      "Text": "그럼 다음에 또 보자."
    },
    {
      "Id": 101420580,
      "Speaker": "Student",
      "Text": "선생님. 이번 주는 야외 활동하기 좋은 날씨가 이어진대."
    },
    {
      "Id": 101420590,
      "Speaker": "Student",
      "Text": "그래서 말인데……"
    },
    {
      "Id": 101420600,
      "Speaker": "Student",
      "Text": "주말에 시간 괜찮아?"
    },
    {
      "Id": 101420610,
      "Speaker": "Player",
      "Text": "물론이지!"
    },
    {
      "Id": 101420620,
      "Speaker": "Player",
      "Text": "내가 먼저 물어보려던 참이었어!"
    },
    {
      "Id": 101420630,
      "Speaker": "Student",
      "Text": "그럼 또 바다에 가자."
    },
    {
      "Id": 101420640,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "이번에도 왠지 즐거운 일이 있을 것 같아."
    }
  ],
