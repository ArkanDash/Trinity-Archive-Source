{
  "CharacterId": 10076,
  "DialogJP": [
    {
      "Id": 100760010,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 100760020,
      "Speaker": "Student",
      "Text": "今お時間いかがでしょう？"
    },
    {
      "Id": 100760030,
      "Speaker": "Player",
      "Text": "暇してるよ"
    },
    {
      "Id": 100760040,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100760050,
      "Speaker": "Student",
      "Text": "おぉ！"
    },
    {
      "Id": 100760060,
      "Speaker": "Student",
      "Text": "もしよろしければ"
    },
    {
      "Id": 100760070,
      "Speaker": "Student",
      "Text": "少しご提案があるのですが！"
    },
    {
      "Id": 100760080,
      "Speaker": "Student",
      "Text": "べ、別に何か説明したいわけではないですよ！"
    },
    {
      "Id": 100760090,
      "Speaker": "Player",
      "Text": "説明じゃない……？"
    },
    {
      "Id": 100760100,
      "Speaker": "Player",
      "Text": "いいよ、いつでも来てね"
    },
    {
      "Id": 100760110,
      "Speaker": "Student",
      "Text": "え"
    },
    {
      "Id": 100760120,
      "Speaker": "Student",
      "Text": "ええっと！"
    },
    {
      "Id": 100760130,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 100760140,
      "Speaker": "Student",
      "Text": "はい！！"
    },
    {
      "Id": 100760150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "今すぐ行きます！"
    },
    {
      "Id": 100760160,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100760170,
      "Speaker": "Student",
      "Text": "お力になれたらと思って伺ったのに"
    },
    {
      "Id": 100760180,
      "Speaker": "Student",
      "Text": "逆に助けられてしまいました"
    },
    {
      "Id": 100760190,
      "Speaker": "Student",
      "Text": "その、ありがとうございました"
    },
    {
      "Id": 100760200,
      "Speaker": "Player",
      "Text": "コトリのおかげですっきりできたよ"
    },
    {
      "Id": 100760210,
      "Speaker": "Player",
      "Text": "自分ではやらなかったと思うし"
    },
    {
      "Id": 100760220,
      "Speaker": "Student",
      "Text": "そ"
    },
    {
      "Id": 100760230,
      "Speaker": "Student",
      "Text": "そうですか？"
    },
    {
      "Id": 100760240,
      "Speaker": "Student",
      "Text": "それは"
    },
    {
      "Id": 100760250,
      "Speaker": "Student",
      "Text": "よかったです！！"
    },
    {
      "Id": 100760260,
      "Speaker": "Student",
      "Text": "ありがとうございます！！"
    },
    {
      "Id": 100760270,
      "Speaker": "Student",
      "Text": "人が多いからでしょうか"
    },
    {
      "Id": 100760280,
      "Speaker": "Student",
      "Text": "仕事も山積みですね"
    },
    {
      "Id": 100760290,
      "Speaker": "Student",
      "Text": "さすがは大運動会！"
    },
    {
      "Id": 100760300,
      "Speaker": "Student",
      "Text": "先生も今頃きっと"
    },
    {
      "Id": 100760310,
      "Speaker": "Student",
      "Text": "目が回るくらい忙しいですよね！"
    },
    {
      "Id": 100760320,
      "Speaker": "Player",
      "Text": "運営管理の仕事だからね"
    },
    {
      "Id": 100760330,
      "Speaker": "Player",
      "Text": "色んな学園が集まってるから"
    },
    {
      "Id": 100760340,
      "Speaker": "Student",
      "Text": "やっぱり！"
    },
    {
      "Id": 100760350,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 100760360,
      "Speaker": "Student",
      "Text": "でしたら、書類の整理を手伝わせてください！"
    },
    {
      "Id": 100760370,
      "Speaker": "Student",
      "Text": "こちらの仕事は一段落しましたし！"
    },
    {
      "Id": 100760380,
      "Speaker": "Student",
      "Text": "待っていてください！"
    },
    {
      "Id": 100760390,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "今すぐ行きます！"
    },
    {
      "Id": 100760400,
      "Speaker": "Student",
      "Text": "お疲れ様です！"
    },
    {
      "Id": 100760410,
      "Speaker": "Student",
      "Text": "さっきの理由は未だによくわからないのですが"
    },
    {
      "Id": 100760420,
      "Speaker": "Student",
      "Text": "ちゃんと先生のお役に立てたみたいで"
    },
    {
      "Id": 100760430,
      "Speaker": "Student",
      "Text": "すごく嬉しいです！"
    },
    {
      "Id": 100760440,
      "Speaker": "Student",
      "Text": "……勘違いじゃ、ないですよね？"
    },
    {
      "Id": 100760450,
      "Speaker": "Player",
      "Text": "救世主かと思った"
    },
    {
      "Id": 100760460,
      "Speaker": "Player",
      "Text": "スーパーコトリ、万歳！"
    },
    {
      "Id": 100760470,
      "Speaker": "Student",
      "Text": "……！！"
    },
    {
      "Id": 100760480,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 100760490,
      "Speaker": "Student",
      "Text": "ありがとうございます、先生！"
    },
    {
      "Id": 100760500,
      "Speaker": "Student",
      "Text": "またいつでも呼んでくださいね！！"
    },
    {
      "Id": 100760510,
      "Speaker": "Student",
      "Text": "うう"
    },
    {
      "Id": 100760520,
      "Speaker": "Student",
      "Text": "予想はしていましたが"
    },
    {
      "Id": 100760530,
      "Speaker": "Student",
      "Text": "体を動かすのは思ったより大変ですね"
    },
    {
      "Id": 100760540,
      "Speaker": "Student",
      "Text": "普段から運動しておけばよかったです"
    },
    {
      "Id": 100760550,
      "Speaker": "Student",
      "Text": "反省です……"
    },
    {
      "Id": 100760560,
      "Speaker": "Player",
      "Text": "お疲れだね。今どこにいるの？"
    },
    {
      "Id": 100760570,
      "Speaker": "Player",
      "Text": "様子を見にいくよ"
    },
    {
      "Id": 100760580,
      "Speaker": "Student",
      "Text": "あっ"
    },
    {
      "Id": 100760590,
      "Speaker": "Student",
      "Text": "別にそういう意味じゃ"
    },
    {
      "Id": 100760600,
      "Speaker": "Student",
      "Text": "でも"
    },
    {
      "Id": 100760610,
      "Speaker": "Student",
      "Text": "先生にお会いできるなら……"
    },
    {
      "Id": 100760620,
      "Speaker": "Student",
      "Text": "はい"
    },
    {
      "Id": 100760630,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "待ってますね"
    },
    {
      "Id": 100760640,
      "Speaker": "Student",
      "Text": "うわあああ！！"
    },
    {
      "Id": 100760650,
      "Speaker": "Student",
      "Text": "さっきのこと、よく考えたら"
    },
    {
      "Id": 100760660,
      "Speaker": "Student",
      "Text": "すごく恥ずかしいことをしてしまいましたよね！？"
    },
    {
      "Id": 100760670,
      "Speaker": "Student",
      "Text": "あんなに無防備な姿をお見せするなんて！！"
    },
    {
      "Id": 100760680,
      "Speaker": "Player",
      "Text": "全然大丈夫だよ"
    },
    {
      "Id": 100760690,
      "Speaker": "Player",
      "Text": "見守るのも、先生の仕事だよ"
    },
    {
      "Id": 100760700,
      "Speaker": "Student",
      "Text": "はい？"
    },
    {
      "Id": 100760710,
      "Speaker": "Student",
      "Text": "そうなんですか？"
    },
    {
      "Id": 100760720,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 100760730,
      "Speaker": "Student",
      "Text": "先生がおっしゃるなら……？"
    },
    {
      "Id": 100760740,
      "Speaker": "Student",
      "Text": "とにかくありがとうございました！先生のおかげで完全復活です！！"
    },
    {
      "Id": 100760750,
      "Speaker": "Student",
      "Text": "それでは失礼します！！"
    },
    {
      "Id": 100760760,
      "Speaker": "Student",
      "Text": "もうこんな時間ですか"
    },
    {
      "Id": 100760770,
      "Speaker": "Student",
      "Text": "いつの間にか大運動会も終盤ですね"
    },
    {
      "Id": 100760780,
      "Speaker": "Student",
      "Text": "なんだか"
    },
    {
      "Id": 100760790,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 100760800,
      "Speaker": "Student",
      "Text": "変な気分です"
    },
    {
      "Id": 100760810,
      "Speaker": "Player",
      "Text": "終わってほしくない？"
    },
    {
      "Id": 100760820,
      "Speaker": "Player",
      "Text": "一生懸命だった証拠だよ"
    },
    {
      "Id": 100760830,
      "Speaker": "Student",
      "Text": "そうでしょうか？"
    },
    {
      "Id": 100760840,
      "Speaker": "Student",
      "Text": "んん"
    },
    {
      "Id": 100760850,
      "Speaker": "Student",
      "Text": "このことは"
    },
    {
      "Id": 100760860,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "もう少し、考えてみたいと思います"
    }
  ],
  "DialogKR": [
    {
      "Id": 100760010,
      "Speaker": "Student",
      "Text": "선생님!"
    },
    {
      "Id": 100760020,
      "Speaker": "Student",
      "Text": "지금 바쁘신가요!"
    },
    {
      "Id": 100760030,
      "Speaker": "Player",
      "Text": "아니, 한가해."
    },
    {
      "Id": 100760040,
      "Speaker": "Player",
      "Text": "무슨 일이야?"
    },
    {
      "Id": 100760050,
      "Speaker": "Student",
      "Text": "오!"
    },
    {
      "Id": 100760060,
      "Speaker": "Student",
      "Text": "좋군요!"
    },
    {
      "Id": 100760070,
      "Speaker": "Student",
      "Text": "괜찮으시다면, 보여드릴 게 있습니다!"
    },
    {
      "Id": 100760080,
      "Speaker": "Student",
      "Text": "따, 딱히 설명 때문만은 아니니까요! 그럼요!"
    },
    {
      "Id": 100760090,
      "Speaker": "Player",
      "Text": "때문'만'은 아니라니……?"
    },
    {
      "Id": 100760100,
      "Speaker": "Player",
      "Text": "뭐든 괜찮아. 편하게 와."
    },
    {
      "Id": 100760110,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100760120,
      "Speaker": "Student",
      "Text": "아무튼!"
    },
    {
      "Id": 100760130,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100760140,
      "Speaker": "Student",
      "Text": "네!!"
    },
    {
      "Id": 100760150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "지금 바로 가겠습니다!"
    },
    {
      "Id": 100760160,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100760170,
      "Speaker": "Student",
      "Text": "뭔가 도와드리고 싶어서 찾아뵌 거였는데,"
    },
    {
      "Id": 100760180,
      "Speaker": "Student",
      "Text": "오히려 도움을 받은 느낌이 돼버렸네요"
    },
    {
      "Id": 100760190,
      "Speaker": "Student",
      "Text": "으윽 감사합니다"
    },
    {
      "Id": 100760200,
      "Speaker": "Player",
      "Text": "아냐. 분명히 도움받았어."
    },
    {
      "Id": 100760210,
      "Speaker": "Player",
      "Text": "코토리가 아니었으면 귀찮아서 안 했을 거야."
    },
    {
      "Id": 100760220,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 100760230,
      "Speaker": "Student",
      "Text": "그런가요?"
    },
    {
      "Id": 100760240,
      "Speaker": "Student",
      "Text": "그럼"
    },
    {
      "Id": 100760250,
      "Speaker": "Student",
      "Text": "다행인 것으로!! 네!!"
    },
    {
      "Id": 100760260,
      "Speaker": "Student",
      "Text": "감사합니다!!"
    },
    {
      "Id": 100760270,
      "Speaker": "Student",
      "Text": "어우"
    },
    {
      "Id": 100760280,
      "Speaker": "Student",
      "Text": "사람이 많아서 그런지 일도 많네요."
    },
    {
      "Id": 100760290,
      "Speaker": "Student",
      "Text": "그야말로 대운동회라는 이름이 아깝지 않습니다!"
    },
    {
      "Id": 100760300,
      "Speaker": "Student",
      "Text": "분명"
    },
    {
      "Id": 100760310,
      "Speaker": "Student",
      "Text": "선생님께서도 일이 많으시겠지요!"
    },
    {
      "Id": 100760320,
      "Speaker": "Player",
      "Text": "아무래도 운영관리 일이 있다 보니"
    },
    {
      "Id": 100760330,
      "Speaker": "Player",
      "Text": "여러 학교가 모이는 일이다 보니"
    },
    {
      "Id": 100760340,
      "Speaker": "Student",
      "Text": "역시!"
    },
    {
      "Id": 100760350,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100760360,
      "Speaker": "Student",
      "Text": "그럼 도움이 되신다면, 서류 업무 같은 건 도와드리고 싶군요!"
    },
    {
      "Id": 100760370,
      "Speaker": "Student",
      "Text": "마침 지금은 저도 시간이 좀 비어 있으니"
    },
    {
      "Id": 100760380,
      "Speaker": "Student",
      "Text": "기다려 주세요!"
    },
    {
      "Id": 100760390,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "바로 찾아가겠습니다!"
    },
    {
      "Id": 100760400,
      "Speaker": "Student",
      "Text": "음!"
    },
    {
      "Id": 100760410,
      "Speaker": "Student",
      "Text": "뭔가 잘은 모르지만"
    },
    {
      "Id": 100760420,
      "Speaker": "Student",
      "Text": "진짜로 선생님께 도움이 된 것 같아요."
    },
    {
      "Id": 100760430,
      "Speaker": "Student",
      "Text": "정말로 기쁘네요!"
    },
    {
      "Id": 100760440,
      "Speaker": "Student",
      "Text": "기분 탓……은 아니겠죠?"
    },
    {
      "Id": 100760450,
      "Speaker": "Player",
      "Text": "장난 아니었지. 구세주인 줄 알았어."
    },
    {
      "Id": 100760460,
      "Speaker": "Player",
      "Text": "그야말로 '슈퍼'했달까?"
    },
    {
      "Id": 100760470,
      "Speaker": "Student",
      "Text": "……!!"
    },
    {
      "Id": 100760480,
      "Speaker": "Student",
      "Text": "오옷!!"
    },
    {
      "Id": 100760490,
      "Speaker": "Student",
      "Text": "히히"
    },
    {
      "Id": 100760500,
      "Speaker": "Student",
      "Text": "언제든 또 불러주세요! 선생님!!"
    },
    {
      "Id": 100760510,
      "Speaker": "Student",
      "Text": "으"
    },
    {
      "Id": 100760520,
      "Speaker": "Student",
      "Text": "예상은 했지만, 그것보다 훨씬"
    },
    {
      "Id": 100760530,
      "Speaker": "Student",
      "Text": "몸 쓰는 일은 힘이 많이 드는군요"
    },
    {
      "Id": 100760540,
      "Speaker": "Student",
      "Text": "평소에 좀 해 둘 걸"
    },
    {
      "Id": 100760550,
      "Speaker": "Student",
      "Text": "반성합니다"
    },
    {
      "Id": 100760560,
      "Speaker": "Player",
      "Text": "지친 모양이구나. 지금 어디?"
    },
    {
      "Id": 100760570,
      "Speaker": "Player",
      "Text": "아이고. 이건 상태를 좀 봐야겠는걸."
    },
    {
      "Id": 100760580,
      "Speaker": "Student",
      "Text": "앗"
    },
    {
      "Id": 100760590,
      "Speaker": "Student",
      "Text": "그런 의도로 말씀드린 건 아니었는데"
    },
    {
      "Id": 100760600,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100760610,
      "Speaker": "Student",
      "Text": "그래도 뭐든 좋겠죠. 선생님이 와 주실 빌미가 될 수 있다니"
    },
    {
      "Id": 100760620,
      "Speaker": "Student",
      "Text": "네"
    },
    {
      "Id": 100760630,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "그럼 기다리겠습니다"
    },
    {
      "Id": 100760640,
      "Speaker": "Student",
      "Text": "으아아아악!!"
    },
    {
      "Id": 100760650,
      "Speaker": "Student",
      "Text": "조금 전까지는 별생각 없었는데"
    },
    {
      "Id": 100760660,
      "Speaker": "Student",
      "Text": "생각해 보니, 굉장히 부끄러운 사태!"
    },
    {
      "Id": 100760670,
      "Speaker": "Student",
      "Text": "무방비하게 늘어진 모습을 보여드리고 말았어요!!"
    },
    {
      "Id": 100760680,
      "Speaker": "Player",
      "Text": "전혀 이상하지 않아요~."
    },
    {
      "Id": 100760690,
      "Speaker": "Player",
      "Text": "그런 걸 지켜보는 것도 선생님의 일이야."
    },
    {
      "Id": 100760700,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 100760710,
      "Speaker": "Student",
      "Text": "그런 건가요?"
    },
    {
      "Id": 100760720,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100760730,
      "Speaker": "Student",
      "Text": "잘은 모르겠지만, 선생님이 그러시다니……."
    },
    {
      "Id": 100760740,
      "Speaker": "Student",
      "Text": "아무튼 감사합니다, 선생님! 덕분에 완전히 힘을 되찾았어요!!"
    },
    {
      "Id": 100760750,
      "Speaker": "Student",
      "Text": "그럼 이만!!"
    },
    {
      "Id": 100760760,
      "Speaker": "Student",
      "Text": "시간도 꽤 늦었네요."
    },
    {
      "Id": 100760770,
      "Speaker": "Student",
      "Text": "어느덧 일정도 다 끝나고"
    },
    {
      "Id": 100760780,
      "Speaker": "Student",
      "Text": "그런데"
    },
    {
      "Id": 100760790,
      "Speaker": "Student",
      "Text": "뭔가"
    },
    {
      "Id": 100760800,
      "Speaker": "Student",
      "Text": "이상한 기분이에요"
    },
    {
      "Id": 100760810,
      "Speaker": "Player",
      "Text": "조금 아쉬운 걸까"
    },
    {
      "Id": 100760820,
      "Speaker": "Player",
      "Text": "열심히 했을수록, 그럴 수 있지"
    },
    {
      "Id": 100760830,
      "Speaker": "Student",
      "Text": "그런 걸까요?"
    },
    {
      "Id": 100760840,
      "Speaker": "Student",
      "Text": "으음"
    },
    {
      "Id": 100760850,
      "Speaker": "Student",
      "Text": "이 부분은,"
    },
    {
      "Id": 100760860,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "좀 더 생각해 봐야겠어요."
    }
  ],
  "DialogEN": [
    {
      "Id": 100760010,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 100760020,
      "Speaker": "Student",
      "Text": "Are you busy right now?"
    },
    {
      "Id": 100760030,
      "Speaker": "Player",
      "Text": "Not at the moment."
    },
    {
      "Id": 100760040,
      "Speaker": "Player",
      "Text": "What's up?"
    },
    {
      "Id": 100760050,
      "Speaker": "Student",
      "Text": "Oh!"
    },
    {
      "Id": 100760060,
      "Speaker": "Student",
      "Text": "Great!"
    },
    {
      "Id": 100760070,
      "Speaker": "Student",
      "Text": "I have something to show you! If that's okay!"
    },
    {
      "Id": 100760080,
      "Speaker": "Student",
      "Text": "It's, um, not exactly something I can explain!"
    },
    {
      "Id": 100760090,
      "Speaker": "Player",
      "Text": "What do you mean...?"
    },
    {
      "Id": 100760100,
      "Speaker": "Player",
      "Text": "Whatever it is, drop by anytime."
    },
    {
      "Id": 100760110,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100760120,
      "Speaker": "Student",
      "Text": "Anyway!"
    },
    {
      "Id": 100760130,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 100760140,
      "Speaker": "Student",
      "Text": "Yes!!"
    },
    {
      "Id": 100760150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'll be there right away!"
    },
    {
      "Id": 100760160,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100760170,
      "Speaker": "Student",
      "Text": "I came because I wanted to help you,"
    },
    {
      "Id": 100760180,
      "Speaker": "Student",
      "Text": "but you ended up helping me, instead."
    },
    {
      "Id": 100760190,
      "Speaker": "Student",
      "Text": "Thank you so much!"
    },
    {
      "Id": 100760200,
      "Speaker": "Player",
      "Text": "No, you helped me plenty."
    },
    {
      "Id": 100760210,
      "Speaker": "Player",
      "Text": "I would've been too lazy to do this if it wasn't for you, Kotori."
    },
    {
      "Id": 100760220,
      "Speaker": "Student",
      "Text": "Um"
    },
    {
      "Id": 100760230,
      "Speaker": "Student",
      "Text": "Really?"
    },
    {
      "Id": 100760240,
      "Speaker": "Student",
      "Text": "Well then"
    },
    {
      "Id": 100760250,
      "Speaker": "Student",
      "Text": "I'm glad!"
    },
    {
      "Id": 100760260,
      "Speaker": "Student",
      "Text": "Thank you!!"
    },
    {
      "Id": 100760270,
      "Speaker": "Student",
      "Text": "Whoa"
    },
    {
      "Id": 100760280,
      "Speaker": "Student",
      "Text": "There are so many people to manage, so much to do..."
    },
    {
      "Id": 100760290,
      "Speaker": "Student",
      "Text": "It really is a grand field day!"
    },
    {
      "Id": 100760300,
      "Speaker": "Student",
      "Text": "Of course"
    },
    {
      "Id": 100760310,
      "Speaker": "Student",
      "Text": "I bet you have a ton to do as well!"
    },
    {
      "Id": 100760320,
      "Speaker": "Player",
      "Text": "So much to manage..."
    },
    {
      "Id": 100760330,
      "Speaker": "Player",
      "Text": "So many schools gathering..."
    },
    {
      "Id": 100760340,
      "Speaker": "Student",
      "Text": "For sure!"
    },
    {
      "Id": 100760350,
      "Speaker": "Student",
      "Text": "Hm"
    },
    {
      "Id": 100760360,
      "Speaker": "Student",
      "Text": "Maybe I could help you out with some paperwork!"
    },
    {
      "Id": 100760370,
      "Speaker": "Student",
      "Text": "I've got some free time,"
    },
    {
      "Id": 100760380,
      "Speaker": "Student",
      "Text": "so wait for me!"
    },
    {
      "Id": 100760390,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "I'll be there soon!"
    },
    {
      "Id": 100760400,
      "Speaker": "Student",
      "Text": "Hm!"
    },
    {
      "Id": 100760410,
      "Speaker": "Student",
      "Text": "I'm not certain,"
    },
    {
      "Id": 100760420,
      "Speaker": "Student",
      "Text": "but I feel like I was of some help."
    },
    {
      "Id": 100760430,
      "Speaker": "Student",
      "Text": "What a great feeling!"
    },
    {
      "Id": 100760440,
      "Speaker": "Student",
      "Text": "It's not just my imagination, is it?"
    },
    {
      "Id": 100760450,
      "Speaker": "Player",
      "Text": "No, you basically saved me."
    },
    {
      "Id": 100760460,
      "Speaker": "Player",
      "Text": "You were a super star!"
    },
    {
      "Id": 100760470,
      "Speaker": "Student",
      "Text": "...!"
    },
    {
      "Id": 100760480,
      "Speaker": "Student",
      "Text": "Hee!"
    },
    {
      "Id": 100760490,
      "Speaker": "Student",
      "Text": "Heehee!"
    },
    {
      "Id": 100760500,
      "Speaker": "Student",
      "Text": "Call on me anytime, Sensei!"
    },
    {
      "Id": 100760510,
      "Speaker": "Student",
      "Text": "Ummm"
    },
    {
      "Id": 100760520,
      "Speaker": "Student",
      "Text": "Maybe I shouldn't be surprised"
    },
    {
      "Id": 100760530,
      "Speaker": "Student",
      "Text": "but manual labor is exhausting."
    },
    {
      "Id": 100760540,
      "Speaker": "Student",
      "Text": "I ought to exercise more."
    },
    {
      "Id": 100760550,
      "Speaker": "Student",
      "Text": "I kinda let myself go..."
    },
    {
      "Id": 100760560,
      "Speaker": "Player",
      "Text": "Sounds like you're hard at work. Where are you?"
    },
    {
      "Id": 100760570,
      "Speaker": "Player",
      "Text": "I've got to see this."
    },
    {
      "Id": 100760580,
      "Speaker": "Student",
      "Text": "Oh"
    },
    {
      "Id": 100760590,
      "Speaker": "Student",
      "Text": "I didn't mean for you to..."
    },
    {
      "Id": 100760600,
      "Speaker": "Student",
      "Text": "Hm"
    },
    {
      "Id": 100760610,
      "Speaker": "Student",
      "Text": "Well I'd be happy to see you, Sensei."
    },
    {
      "Id": 100760620,
      "Speaker": "Student",
      "Text": "Okay."
    },
    {
      "Id": 100760630,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "I'll be waiting for you."
    },
    {
      "Id": 100760640,
      "Speaker": "Student",
      "Text": "Ahhh!"
    },
    {
      "Id": 100760650,
      "Speaker": "Student",
      "Text": "It didn't occur to me before,"
    },
    {
      "Id": 100760660,
      "Speaker": "Student",
      "Text": "but this is really embarrassing!"
    },
    {
      "Id": 100760670,
      "Speaker": "Student",
      "Text": "You've seen me all sweaty and out of sorts!"
    },
    {
      "Id": 100760680,
      "Speaker": "Player",
      "Text": "It's fine."
    },
    {
      "Id": 100760690,
      "Speaker": "Player",
      "Text": "This is all part of the job."
    },
    {
      "Id": 100760700,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 100760710,
      "Speaker": "Student",
      "Text": "Are you sure about that?"
    },
    {
      "Id": 100760720,
      "Speaker": "Student",
      "Text": "Hm"
    },
    {
      "Id": 100760730,
      "Speaker": "Student",
      "Text": "If you say so, Sensei..."
    },
    {
      "Id": 100760740,
      "Speaker": "Student",
      "Text": "Anyway, you did help me feel better."
    },
    {
      "Id": 100760750,
      "Speaker": "Student",
      "Text": "See you later!"
    },
    {
      "Id": 100760760,
      "Speaker": "Student",
      "Text": "It's getting late."
    },
    {
      "Id": 100760770,
      "Speaker": "Student",
      "Text": "All the scheduled events are over."
    },
    {
      "Id": 100760780,
      "Speaker": "Student",
      "Text": "And yet"
    },
    {
      "Id": 100760790,
      "Speaker": "Student",
      "Text": "I feel"
    },
    {
      "Id": 100760800,
      "Speaker": "Student",
      "Text": "kind of strange."
    },
    {
      "Id": 100760810,
      "Speaker": "Player",
      "Text": "Maybe you're sad that it's over."
    },
    {
      "Id": 100760820,
      "Speaker": "Player",
      "Text": "You worked hard on this. I can see why you'd feel that way."
    },
    {
      "Id": 100760830,
      "Speaker": "Student",
      "Text": "Is that what this is?"
    },
    {
      "Id": 100760840,
      "Speaker": "Student",
      "Text": "Huh"
    },
    {
      "Id": 100760850,
      "Speaker": "Student",
      "Text": "I think..."
    },
    {
      "Id": 100760860,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I need to give that some thought."
    }
  ],
  "DialogTH": [
    {
      "Id": 100760010,
      "Speaker": "Student",
      "Text": "คุณครู!"
    },
    {
      "Id": 100760020,
      "Speaker": "Student",
      "Text": "ตอนนี้ยุ่งอยู่รึเปล่าคะ?!"
    },
    {
      "Id": 100760030,
      "Speaker": "Player",
      "Text": "ไม่เลย ว่างมาก"
    },
    {
      "Id": 100760040,
      "Speaker": "Player",
      "Text": "มีอะไรเหรอ?"
    },
    {
      "Id": 100760050,
      "Speaker": "Student",
      "Text": "โอ๊ะ!"
    },
    {
      "Id": 100760060,
      "Speaker": "Student",
      "Text": "ดีเลยค่ะ!"
    },
    {
      "Id": 100760070,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูสะดวกละก็ ฉันมีของที่อยาก\nให้คุณครูดูค่ะ!"
    },
    {
      "Id": 100760080,
      "Speaker": "Student",
      "Text": "มะ...ไม่ใช่แค่เรื่องการอธิบาย\nอะไรหรอกนะคะ!"
    },
    {
      "Id": 100760090,
      "Speaker": "Player",
      "Text": "ไม่ใช่ \"แค่\" งั้นเหรอ...?"
    },
    {
      "Id": 100760100,
      "Speaker": "Player",
      "Text": "ยังไงก็ได้ ค่อยๆ มาก็แล้วกันนะ"
    },
    {
      "Id": 100760110,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 100760120,
      "Speaker": "Student",
      "Text": "ยังไงก็เถอะค่ะ!"
    },
    {
      "Id": 100760130,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 100760140,
      "Speaker": "Student",
      "Text": "ค่ะ...!!"
    },
    {
      "Id": 100760150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ฉันจะไปเดี๋ยวนี้เลยค่ะ!"
    },
    {
      "Id": 100760160,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100760170,
      "Speaker": "Student",
      "Text": "ฉันไปหาเพราะอยากไปช่วยคุณครู\nแท้ๆ เชียว..."
    },
    {
      "Id": 100760180,
      "Speaker": "Student",
      "Text": "แต่กลับรู้สึกเหมือนฉันเป็นฝ่ายได้รับ\nความช่วยเหลือแทนเลยค่ะ"
    },
    {
      "Id": 100760190,
      "Speaker": "Student",
      "Text": "ยังไงก็ขอบคุณมากเลยค่ะ!"
    },
    {
      "Id": 100760200,
      "Speaker": "Player",
      "Text": "ไม่หรอก เธอก็ช่วยครูได้เยอะเลย"
    },
    {
      "Id": 100760210,
      "Speaker": "Player",
      "Text": "ถ้าไม่ได้โคโทริละก็ ครูคงขี้เกียจ\nจนไม่ยอมทำแน่ๆ"
    },
    {
      "Id": 100760220,
      "Speaker": "Student",
      "Text": "เอ่อ..."
    },
    {
      "Id": 100760230,
      "Speaker": "Student",
      "Text": "งั้นเหรอคะ?"
    },
    {
      "Id": 100760240,
      "Speaker": "Student",
      "Text": "ถ้างั้นก็..."
    },
    {
      "Id": 100760250,
      "Speaker": "Student",
      "Text": "ค่อยยังชั่วหน่อยค่ะ!!"
    },
    {
      "Id": 100760260,
      "Speaker": "Student",
      "Text": "ขอบคุณนะคะ!!"
    },
    {
      "Id": 100760270,
      "Speaker": "Student",
      "Text": "เฮ้อ"
    },
    {
      "Id": 100760280,
      "Speaker": "Student",
      "Text": "คงเพราะคนเยอะ งานที่ต้องทำ\nก็เลยเยอะตามไปด้วยสินะคะ"
    },
    {
      "Id": 100760290,
      "Speaker": "Student",
      "Text": "ไม่เสียชื่องานมหกรรมแข่งขันกีฬา\nเลยค่ะ!"
    },
    {
      "Id": 100760300,
      "Speaker": "Student",
      "Text": "แน่นอนว่า..."
    },
    {
      "Id": 100760310,
      "Speaker": "Student",
      "Text": "คุณครูเองก็คงงานเยอะเหมือนกัน\nสินะคะ!"
    },
    {
      "Id": 100760320,
      "Speaker": "Player",
      "Text": "งานเยอะสุดๆ..."
    },
    {
      "Id": 100760330,
      "Speaker": "Player",
      "Text": "เด็กหลายโรงเรียนสุดๆ..."
    },
    {
      "Id": 100760340,
      "Speaker": "Student",
      "Text": "คิดแล้วเชียว!"
    },
    {
      "Id": 100760350,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100760360,
      "Speaker": "Student",
      "Text": "ถ้าฉันพอจะช่วยได้ ก็อยากช่วยทำ\nพวกงานเอกสารให้ค่ะ!"
    },
    {
      "Id": 100760370,
      "Speaker": "Student",
      "Text": "ตอนนี้ฉันเองก็ว่างๆ อยู่พอดีน่ะค่ะ"
    },
    {
      "Id": 100760380,
      "Speaker": "Student",
      "Text": "รอสักครู่นะคะ!"
    },
    {
      "Id": 100760390,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ฉันจะรีบไปหาเดี๋ยวนี้เลยค่ะ!"
    },
    {
      "Id": 100760400,
      "Speaker": "Student",
      "Text": "อืม!"
    },
    {
      "Id": 100760410,
      "Speaker": "Student",
      "Text": "ฉันไม่ค่อยแน่ใจเลย..."
    },
    {
      "Id": 100760420,
      "Speaker": "Student",
      "Text": "แต่ก็รู้สึกเหมือนว่าได้ช่วยคุณครู\nนิดหน่อยค่ะ"
    },
    {
      "Id": 100760430,
      "Speaker": "Student",
      "Text": "ฉันมีความสุขมากๆ เลยค่ะ!"
    },
    {
      "Id": 100760440,
      "Speaker": "Student",
      "Text": "อาจเป็นเพราะอารมณ์พาไป...\nก็ได้สินะคะ?"
    },
    {
      "Id": 100760450,
      "Speaker": "Player",
      "Text": "ไม่ได้ล้อเล่นเลยนะ เธอเหมือน\nผู้ช่วยชีวิตครูเลย"
    },
    {
      "Id": 100760460,
      "Speaker": "Player",
      "Text": "แบบนี้สิถึงกับสมเป็น\nซูเปอร์สตาร์น่ะ!"
    },
    {
      "Id": 100760470,
      "Speaker": "Student",
      "Text": "...!!"
    },
    {
      "Id": 100760480,
      "Speaker": "Student",
      "Text": "โอ๊สสส!!"
    },
    {
      "Id": 100760490,
      "Speaker": "Student",
      "Text": "ฮิฮิ"
    },
    {
      "Id": 100760500,
      "Speaker": "Student",
      "Text": "ถ้างั้นก็เรียกใช้ฉันได้ตลอดเลยนะคะ\nคุณครู!!"
    },
    {
      "Id": 100760510,
      "Speaker": "Student",
      "Text": "ฮือ..."
    },
    {
      "Id": 100760520,
      "Speaker": "Student",
      "Text": "ถึงจะคาดการณ์เอาไว้แล้ว แต่ว่า..."
    },
    {
      "Id": 100760530,
      "Speaker": "Student",
      "Text": "การขยับร่างกาย เป็นเรื่องยากกว่าที่\nคิดอีกนะคะ"
    },
    {
      "Id": 100760540,
      "Speaker": "Student",
      "Text": "รู้งี้ทำเป็นประจำก็คงดี"
    },
    {
      "Id": 100760550,
      "Speaker": "Student",
      "Text": "สำนึกผิดแล้วค่ะ"
    },
    {
      "Id": 100760560,
      "Speaker": "Player",
      "Text": "คงจะเหนื่อยสินะ ตอนนี้อยู่ไหนล่ะ?"
    },
    {
      "Id": 100760570,
      "Speaker": "Player",
      "Text": "โธ่ คงต้องไปดูอาการหน่อยแล้วสินะ"
    },
    {
      "Id": 100760580,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 100760590,
      "Speaker": "Student",
      "Text": "ฉันไม่ได้บอกคุณครูเพื่อให้ทำแบบนั้น\nเลยนะคะ"
    },
    {
      "Id": 100760600,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100760610,
      "Speaker": "Student",
      "Text": "แต่ว่าแบบนั้นก็ดีค่ะ อย่างน้อยก็ใช้\nเป็นข้ออ้างชวนคุณครูมาได้"
    },
    {
      "Id": 100760620,
      "Speaker": "Student",
      "Text": "ค่ะ"
    },
    {
      "Id": 100760630,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ถ้างั้นฉันจะรอนะคะ"
    },
    {
      "Id": 100760640,
      "Speaker": "Student",
      "Text": "อ๊ายยยยย!!"
    },
    {
      "Id": 100760650,
      "Speaker": "Student",
      "Text": "เมื่อกี้ฉันไม่ทันคิดอะไร"
    },
    {
      "Id": 100760660,
      "Speaker": "Student",
      "Text": "แต่พอมาทบทวนดูแล้ว มันเป็น\nสถานการณ์ที่น่าอายมากเลยค่ะ!"
    },
    {
      "Id": 100760670,
      "Speaker": "Student",
      "Text": "ดันเผลอให้เห็นด้านที่ไร้เรี่ยวแรง\nโดยไม่ระวังซะแล้วค่ะ!"
    },
    {
      "Id": 100760680,
      "Speaker": "Player",
      "Text": "มันไม่ได้แปลกอะไรสักหน่อย~"
    },
    {
      "Id": 100760690,
      "Speaker": "Player",
      "Text": "การคอยเฝ้าจับตาดูก็เป็นงาน\nของครูอย่างหนึ่งนะ"
    },
    {
      "Id": 100760700,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 100760710,
      "Speaker": "Student",
      "Text": "อย่างนั้นเหรอคะ?"
    },
    {
      "Id": 100760720,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100760730,
      "Speaker": "Student",
      "Text": "ฉันไม่ค่อยเข้าใจเท่าไร แต่ถ้าคุณครู\nพูดแบบนั้น..."
    },
    {
      "Id": 100760740,
      "Speaker": "Student",
      "Text": "ยังไงก็ขอบคุณนะคะคุณครู! ฉันมีแรง\nฮึดขึ้นแล้วละค่ะ!!"
    },
    {
      "Id": 100760750,
      "Speaker": "Student",
      "Text": "ถ้างั้น... ขอตัวก่อนนะคะ!!"
    },
    {
      "Id": 100760760,
      "Speaker": "Student",
      "Text": "ดึกเลยนะคะเนี่ย"
    },
    {
      "Id": 100760770,
      "Speaker": "Student",
      "Text": "แต่ยังไงงานวันนี้ก็ผ่านไปแล้ว"
    },
    {
      "Id": 100760780,
      "Speaker": "Student",
      "Text": "แต่ว่า..."
    },
    {
      "Id": 100760790,
      "Speaker": "Student",
      "Text": "มัน..."
    },
    {
      "Id": 100760800,
      "Speaker": "Student",
      "Text": "รู้สึกแปลกๆ ค่ะ"
    },
    {
      "Id": 100760810,
      "Speaker": "Player",
      "Text": "จะเรียกว่าเสียดายนิดหน่อยก็ได้..."
    },
    {
      "Id": 100760820,
      "Speaker": "Player",
      "Text": "ยิ่งตั้งใจเท่าไร ก็คงยิ่งรู้สึกแบบนั้น\nแหละนะ"
    },
    {
      "Id": 100760830,
      "Speaker": "Student",
      "Text": "งั้นเหรอคะ?"
    },
    {
      "Id": 100760840,
      "Speaker": "Student",
      "Text": "อืม..."
    },
    {
      "Id": 100760850,
      "Speaker": "Student",
      "Text": "เรื่องนี้..."
    },
    {
      "Id": 100760860,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ฉันจะขอคิดให้ละเอียดอีกสักหน่อยค่ะ"
    }
  ],
  "DialogTW": [
    {
