    {
      "Id": 200270190,
      "Speaker": "Student",
      "Text": "可以嗎？"
    },
    {
      "Id": 200270200,
      "Speaker": "Player",
      "Text": "當然，隨時都能過去哦"
    },
    {
      "Id": 200270210,
      "Speaker": "Player",
      "Text": "你好像很高興呢"
    },
    {
      "Id": 200270220,
      "Speaker": "Student",
      "Text": "唔嗯……"
    },
    {
      "Id": 200270230,
      "Speaker": "Student",
      "Text": "嗯"
    },
    {
      "Id": 200270240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "可能是"
    },
    {
      "Id": 200270250,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 200270260,
      "Speaker": "Student",
      "Text": "還醒著嗎？"
