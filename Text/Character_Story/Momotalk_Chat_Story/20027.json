{
  "CharacterId": 20027,
  "DialogJP": [
    {
      "Id": 200270010,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200270020,
      "Speaker": "Student",
      "Text": "もし、大丈夫なら"
    },
    {
      "Id": 200270030,
      "Speaker": "Student",
      "Text": "今から来れる？"
    },
    {
      "Id": 200270040,
      "Speaker": "Player",
      "Text": "うん、大丈夫だよ"
    },
    {
      "Id": 200270050,
      "Speaker": "Player",
      "Text": "どこにいるの？"
    },
    {
      "Id": 200270060,
      "Speaker": "Student",
      "Text": "ん"
    },
    {
      "Id": 200270070,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "えっと……"
    },
    {
      "Id": 200270080,
      "Speaker": "Student",
      "Text": "幻なんて言うくらいだし、もっと美味しいと思ってた"
    },
    {
      "Id": 200270090,
      "Speaker": "Student",
      "Text": "ちょっと残念"
    },
    {
      "Id": 200270100,
      "Speaker": "Player",
      "Text": "でも、楽しかったね"
    },
    {
      "Id": 200270110,
      "Speaker": "Player",
      "Text": "シロコと一緒に過ごせて、すごく嬉しかったよ"
    },
    {
      "Id": 200270120,
      "Speaker": "Student",
      "Text": "先生……"
    },
    {
      "Id": 200270130,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200270140,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 200270150,
      "Speaker": "Student",
      "Text": "私も……嬉しい"
    },
    {
      "Id": 200270160,
      "Speaker": "Student",
      "Text": "ありがとう"
    },
    {
      "Id": 200270170,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200270180,
      "Speaker": "Student",
      "Text": "また今日も……"
    },
    {
      "Id": 200270190,
      "Speaker": "Student",
      "Text": "大丈夫？"
    },
    {
      "Id": 200270200,
      "Speaker": "Player",
      "Text": "もちろん、いつでも行くよ"
    },
    {
      "Id": 200270210,
      "Speaker": "Player",
      "Text": "なんだか楽しそうだね"
    },
    {
      "Id": 200270220,
      "Speaker": "Student",
      "Text": "ん……"
    },
    {
      "Id": 200270230,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 200270240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "そうかも"
    },
    {
      "Id": 200270250,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200270260,
      "Speaker": "Student",
      "Text": "起きてる？"
    },
    {
      "Id": 200270270,
      "Speaker": "Student",
      "Text": "もう寝ちゃったかな"
    },
    {
      "Id": 200270280,
      "Speaker": "Player",
      "Text": "こんな時間にどうしたの？"
    },
    {
      "Id": 200270290,
      "Speaker": "Player",
      "Text": "シロコ……？"
    },
    {
      "Id": 200270300,
      "Speaker": "Student",
      "Text": "あ……"
    },
    {
      "Id": 200270310,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 200270320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ちょっと、眠れなくて"
    }
  ],
  "DialogKR": [
    {
      "Id": 200270010,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200270020,
      "Speaker": "Student",
      "Text": "괜찮다면"
    },
    {
      "Id": 200270030,
      "Speaker": "Student",
      "Text": "혹시 지금 좀 와 줄 수 있어?"
    },
    {
      "Id": 200270040,
      "Speaker": "Player",
      "Text": "응. 무슨 일이야?"
    },
    {
      "Id": 200270050,
      "Speaker": "Player",
      "Text": "괜찮지. 지금 어딘데?"
    },
    {
      "Id": 200270060,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200270070,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "그게……."
    },
    {
      "Id": 200270080,
      "Speaker": "Student",
      "Text": "생각했던 것만큼, 대단한 재료는 아니었어."
    },
    {
      "Id": 200270090,
      "Speaker": "Student",
      "Text": "좀 아쉽네"
    },
    {
      "Id": 200270100,
      "Speaker": "Player",
      "Text": "그래도 과정은 즐거웠잖아?"
    },
    {
      "Id": 200270110,
      "Speaker": "Player",
      "Text": "그래도 시로코가 만들어 준 거라 좋았어."
    },
    {
      "Id": 200270120,
      "Speaker": "Student",
      "Text": "선생님……."
    },
    {
      "Id": 200270130,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 200270140,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 200270150,
      "Speaker": "Student",
      "Text": "다시 생각해 보니, 나도 좋은 것 같아."
    },
    {
      "Id": 200270160,
      "Speaker": "Student",
      "Text": "다행이야."
    },
    {
      "Id": 200270170,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200270180,
      "Speaker": "Student",
      "Text": "또……이긴 하지만,"
    },
    {
      "Id": 200270190,
      "Speaker": "Student",
      "Text": "혹시 지금 괜찮아?"
    },
    {
      "Id": 200270200,
      "Speaker": "Player",
      "Text": "즐거워 보이네, 시로코."
    },
    {
      "Id": 200270210,
      "Speaker": "Player",
      "Text": "몇 번이라도 괜찮으니 신경 쓰지 마."
    },
    {
      "Id": 200270220,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 200270230,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200270240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "응"
    },
    {
      "Id": 200270250,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200270260,
      "Speaker": "Student",
      "Text": "자?"
    },
    {
      "Id": 200270270,
      "Speaker": "Student",
      "Text": "자는 건가"
    },
    {
      "Id": 200270280,
      "Speaker": "Player",
      "Text": "이 이른 새벽에 모모톡이?"
    },
    {
      "Id": 200270290,
      "Speaker": "Player",
      "Text": "시로코는? 설마 밤을 새운 거야?"
    },
    {
      "Id": 200270300,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 200270310,
      "Speaker": "Student",
      "Text": "응 조금"
    },
    {
      "Id": 200270320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "잠이 안 와서"
    }
  ],
  "DialogEN": [
    {
      "Id": 200270010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 200270020,
      "Speaker": "Student",
      "Text": "If you have a moment,"
    },
    {
      "Id": 200270030,
      "Speaker": "Student",
      "Text": "can you help me with something?"
    },
    {
      "Id": 200270040,
      "Speaker": "Player",
      "Text": "Yeah. What is it?"
    },
    {
      "Id": 200270050,
      "Speaker": "Player",
      "Text": "I can help. Where are you?"
    },
    {
      "Id": 200270060,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 200270070,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "How do I say this..."
    },
    {
      "Id": 200270080,
      "Speaker": "Student",
      "Text": "It wasn't as great of an ingredient as I thought it'd be."
    },
    {
      "Id": 200270090,
      "Speaker": "Student",
      "Text": "It was disappointing."
    },
    {
      "Id": 200270100,
      "Speaker": "Player",
      "Text": "But you had fun catching it, didn't you?"
    },
    {
      "Id": 200270110,
      "Speaker": "Player",
      "Text": "And I enjoyed it because you made it."
    },
    {
      "Id": 200270120,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 200270130,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200270140,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 200270150,
      "Speaker": "Student",
      "Text": "Come to think of it, I agree."
    },
    {
      "Id": 200270160,
      "Speaker": "Student",
      "Text": "I'm glad."
    },
    {
      "Id": 200270170,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 200270180,
      "Speaker": "Student",
      "Text": "I don't mean to be a bother, but..."
    },
    {
      "Id": 200270190,
      "Speaker": "Student",
      "Text": "Are you busy right now?"
    },
    {
      "Id": 200270200,
      "Speaker": "Player",
      "Text": "You seem happy, Shiroko."
    },
    {
      "Id": 200270210,
      "Speaker": "Player",
      "Text": "Ask me whatever you want."
    },
    {
      "Id": 200270220,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 200270230,
      "Speaker": "Student",
      "Text": "Well"
    },
    {
      "Id": 200270240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Right"
    },
    {
      "Id": 200270250,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 200270260,
      "Speaker": "Student",
      "Text": "Sleeping?"
    },
    {
      "Id": 200270270,
      "Speaker": "Student",
      "Text": "Are you asleep?"
    },
    {
      "Id": 200270280,
      "Speaker": "Player",
      "Text": "This is pretty early for a MomoTalk..."
    },
    {
      "Id": 200270290,
      "Speaker": "Player",
      "Text": "Shiroko? Are you still awake?"
    },
    {
      "Id": 200270300,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 200270310,
      "Speaker": "Student",
      "Text": "Yeah, kind of."
    },
    {
      "Id": 200270320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "I couldn't sleep."
    }
  ],
  "DialogTH": [
    {
      "Id": 200270010,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 200270020,
      "Speaker": "Student",
      "Text": "ถ้ามีเวลา"
    },
    {
      "Id": 200270030,
      "Speaker": "Student",
      "Text": "ออกมาข้างนอกหน่อยได้มั้ย?"
    },
    {
      "Id": 200270040,
      "Speaker": "Player",
      "Text": "หืม มีอะไรเหรอ?"
    },
    {
      "Id": 200270050,
      "Speaker": "Player",
      "Text": "ได้เลย ให้ไปที่ไหนล่ะ?"
    },
    {
      "Id": 200270060,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 200270070,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "จะว่ายังไงดีล่ะ"
    },
    {
      "Id": 200270080,
      "Speaker": "Student",
      "Text": "มันไม่ใช่วัตถุดิบชั้นเลิศเหมือนกับ\nที่ฉันคิดเอาไว้"
    },
    {
      "Id": 200270090,
      "Speaker": "Student",
      "Text": "น่าเสียดายจัง..."
    },
    {
      "Id": 200270100,
      "Speaker": "Player",
      "Text": "แต่ตอนลงไปงมหาก็สนุกดีนี่นา?"
    },
    {
      "Id": 200270110,
      "Speaker": "Player",
      "Text": "แต่ครูชอบนะ\nชิโรโกะอุตส่าห์ทำให้เลย"
    },
    {
      "Id": 200270120,
      "Speaker": "Student",
      "Text": "คุณครู..."
    },
    {
      "Id": 200270130,
      "Speaker": "Student",
      "Text": "......"
    },
    {
      "Id": 200270140,
      "Speaker": "Student",
      "Text": "อื้อ"
    },
    {
      "Id": 200270150,
      "Speaker": "Student",
      "Text": "พอคิดดูแล้ว ฉันเองก็ชอบเหมือนกัน"
    },
    {
      "Id": 200270160,
      "Speaker": "Student",
      "Text": "ดีใจจัง..."
    },
    {
      "Id": 200270170,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 200270180,
      "Speaker": "Student",
      "Text": "คือ...ขอโทษที่รบกวนบ่อยๆ..."
    },
    {
      "Id": 200270190,
      "Speaker": "Student",
      "Text": "ตอนนี้ว่างรึเปล่า?"
    },
    {
      "Id": 200270200,
      "Speaker": "Player",
      "Text": "ดูสนุกใหญ่เลยนะ ชิโรโกะ"
    },
    {
      "Id": 200270210,
      "Speaker": "Player",
      "Text": "มาเรียกได้ตลอดเลย ไม่ต้องคิดมากนะ"
    },
    {
      "Id": 200270220,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 200270230,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 200270240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "อื้อ"
    },
    {
      "Id": 200270250,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 200270260,
      "Speaker": "Student",
      "Text": "นอนอยู่เหรอ?"
    },
    {
      "Id": 200270270,
      "Speaker": "Student",
      "Text": "ยังไม่ตื่นเหรอ?"
    },
    {
      "Id": 200270280,
      "Speaker": "Player",
      "Text": "ส่ง MOMOTALK มาแต่เช้ามืดเลยนะ?"
    },
    {
      "Id": 200270290,
      "Speaker": "Player",
      "Text": "ชิโรโกะล่ะ? โต้รุ่งงั้นเหรอ?"
    },
    {
      "Id": 200270300,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 200270310,
      "Speaker": "Student",
      "Text": "อื้อ คือฉัน..."
    },
    {
      "Id": 200270320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "นอนไม่หลับน่ะ"
    }
  ],
