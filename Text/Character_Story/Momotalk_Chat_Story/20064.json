{
  "CharacterId": 20064,
  "DialogJP": [
    {
      "Id": 200640010,
      "Speaker": "Student",
      "Text": "ごきげんよう"
    },
    {
      "Id": 200640020,
      "Speaker": "Student",
      "Text": "少々お時間よろしいでしょうか？"
    },
    {
      "Id": 200640030,
      "Speaker": "Player",
      "Text": "大丈夫だよ！"
    },
    {
      "Id": 200640040,
      "Speaker": "Student",
      "Text": "折り入ってのご相談なのですが"
    },
    {
      "Id": 200640050,
      "Speaker": "Student",
      "Text": "マナミ様から通達がありまして"
    },
    {
      "Id": 200640060,
      "Speaker": "Student",
      "Text": "評議会の役員は先生と親睦を図るように"
    },
    {
      "Id": 200640070,
      "Speaker": "Student",
      "Text": "と"
    },
    {
      "Id": 200640080,
      "Speaker": "Player",
      "Text": "私も連絡をもらってるよ"
    },
    {
      "Id": 200640090,
      "Speaker": "Student",
      "Text": "あら、すでにご存じだったのですね"
    },
    {
      "Id": 200640100,
      "Speaker": "Student",
      "Text": "それでは"
    },
    {
      "Id": 200640110,
      "Speaker": "Student",
      "Text": "ご迷惑でなければ、お時間を……"
    },
    {
      "Id": 200640120,
      "Speaker": "Player",
      "Text": "喜んで！"
    },
    {
      "Id": 200640130,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    },
    {
      "Id": 200640140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "すぐに日程を組んでご連絡いたします"
    },
    {
      "Id": 200640150,
      "Speaker": "Student",
      "Text": "本日はありがとうございました"
    },
    {
      "Id": 200640160,
      "Speaker": "Student",
      "Text": "とても楽しかったです"
    },
    {
      "Id": 200640170,
      "Speaker": "Player",
      "Text": "また一緒に映画を観ようね"
    },
    {
      "Id": 200640180,
      "Speaker": "Student",
      "Text": "また……"
    },
    {
      "Id": 200640190,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 200640200,
      "Speaker": "Student",
      "Text": "先生のお望みでしたら"
    },
    {
      "Id": 200640210,
      "Speaker": "Student",
      "Text": "断ることはできません"
    },
    {
      "Id": 200640220,
      "Speaker": "Player",
      "Text": "強制ではないから！"
    },
    {
      "Id": 200640230,
      "Speaker": "Student",
      "Text": "ええ、理解しております"
    },
    {
      "Id": 200640240,
      "Speaker": "Student",
      "Text": "先生からは……"
    },
    {
      "Id": 200640250,
      "Speaker": "Student",
      "Text": "優しさの香りがしましたから"
    },
    {
      "Id": 200640260,
      "Speaker": "Student",
      "Text": "では、ごきげんよう"
    },
    {
      "Id": 200640270,
      "Speaker": "Student",
      "Text": "ごきげんよう"
    },
    {
      "Id": 200640280,
      "Speaker": "Student",
      "Text": "本日はお仕事があると伺いました"
    },
    {
      "Id": 200640290,
      "Speaker": "Student",
      "Text": "ワイルドハントでお手伝いできることがありましたら"
    },
    {
      "Id": 200640300,
      "Speaker": "Student",
      "Text": "ご遠慮なくお申し付けください"
    },
    {
      "Id": 200640310,
      "Speaker": "Player",
      "Text": "ありがとう！"
    },
    {
      "Id": 200640320,
      "Speaker": "Student",
      "Text": "とんでもございません"
    },
    {
      "Id": 200640330,
      "Speaker": "Student",
      "Text": "わたくしの務めですから"
    },
    {
      "Id": 200640340,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "では本日も、のどけき香りに満ちたる日となりますことを"
    },
    {
      "Id": 200640350,
      "Speaker": "Student",
      "Text": "突然申し訳ありません"
    },
    {
      "Id": 200640360,
      "Speaker": "Student",
      "Text": "悩みを聞いていただけないでしょうか？"
    },
    {
      "Id": 200640370,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 200640380,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    },
    {
      "Id": 200640390,
      "Speaker": "Student",
      "Text": "この話を相談できる方は"
    },
    {
      "Id": 200640400,
      "Speaker": "Student",
      "Text": "先生以外に思い浮かばないのです"
    },
    {
      "Id": 200640410,
      "Speaker": "Player",
      "Text": "どんな悩みなの？"
    },
    {
      "Id": 200640420,
      "Speaker": "Student",
      "Text": "記録が残るといけませんので"
    },
    {
      "Id": 200640430,
      "Speaker": "Student",
      "Text": "対面でお話できればと思います"
    },
    {
      "Id": 200640440,
      "Speaker": "Student",
      "Text": "ご面倒をおかけしますが……"
    },
    {
      "Id": 200640450,
      "Speaker": "Student",
      "Text": "よろしいですか？"
    },
    {
      "Id": 200640460,
      "Speaker": "Player",
      "Text": "大丈夫だよ"
    },
    {
      "Id": 200640470,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    },
    {
      "Id": 200640480,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "場所をお送りしますので、そちらで後ほど"
    },
    {
      "Id": 200640490,
      "Speaker": "Student",
      "Text": "先生、無事にお戻りになりましたか？"
    },
    {
      "Id": 200640500,
      "Speaker": "Player",
      "Text": "うん！預かった物も無事だよ！"
    },
    {
      "Id": 200640510,
      "Speaker": "Student",
      "Text": "何よりです"
    },
    {
      "Id": 200640520,
      "Speaker": "Student",
      "Text": "しばらくの間、よろしくお願いします"
    },
    {
      "Id": 200640530,
      "Speaker": "Student",
      "Text": "わたくしもできる限りのことはしてみるつもりです"
    },
    {
      "Id": 200640540,
      "Speaker": "Student",
      "Text": "このままでは"
    },
    {
      "Id": 200640550,
      "Speaker": "Student",
      "Text": "芸術の多様性を守れませんから"
    },
    {
      "Id": 200640560,
      "Speaker": "Student",
      "Text": "次にお会いする時には良いご報告ができればと"
    },
    {
      "Id": 200640570,
      "Speaker": "Student",
      "Text": "本日は本当にお疲れさまでした"
    },
    {
      "Id": 200640580,
      "Speaker": "Student",
      "Text": "ゆっくりお休みください"
    },
    {
      "Id": 200640590,
      "Speaker": "Student",
      "Text": "ごきげんよう"
    },
    {
      "Id": 200640600,
      "Speaker": "Student",
      "Text": "今日という日をさらに輝かせるご報告です"
    },
    {
      "Id": 200640610,
      "Speaker": "Student",
      "Text": "例の演劇が禁止リストから除外されました"
    },
    {
      "Id": 200640620,
      "Speaker": "Player",
      "Text": "何があったの？"
    },
    {
      "Id": 200640630,
      "Speaker": "Student",
      "Text": "ふふ……"
    },
    {
      "Id": 200640640,
      "Speaker": "Student",
      "Text": "お話しましたよね"
    },
    {
      "Id": 200640650,
      "Speaker": "Student",
      "Text": "わたくしもできる限りのことはしてみると"
    },
    {
      "Id": 200640660,
      "Speaker": "Student",
      "Text": "幸いにも努力が実を結びました"
    },
    {
      "Id": 200640670,
      "Speaker": "Student",
      "Text": "物品の所持も問題なくなりましたので"
    },
    {
      "Id": 200640680,
      "Speaker": "Student",
      "Text": "預かっていただいたものを"
    },
    {
      "Id": 200640690,
      "Speaker": "Student",
      "Text": "引き取りたいと思います"
    },
    {
      "Id": 200640700,
      "Speaker": "Player",
      "Text": "すぐに持っていくね！"
    },
    {
      "Id": 200640710,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    },
    {
      "Id": 200640720,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "詳しいことは後ほど"
    },
    {
      "Id": 200640730,
      "Speaker": "Student",
      "Text": "先生、本日は楽しんでいただけましたか？"
    },
    {
      "Id": 200640740,
      "Speaker": "Player",
      "Text": "うん！また行ってもいい？"
    },
    {
      "Id": 200640750,
      "Speaker": "Student",
      "Text": "ええ、いつでもお越しください"
    },
    {
      "Id": 200640760,
      "Speaker": "Student",
      "Text": "以前のわたくしならお断りしていましたが……"
    },
    {
      "Id": 200640770,
      "Speaker": "Student",
      "Text": "今は物語が進みましたので"
    },
    {
      "Id": 200640780,
      "Speaker": "Student",
      "Text": "その代わり、他の方には秘密ですよ"
    },
    {
      "Id": 200640790,
      "Speaker": "Student",
      "Text": "よろしいですね？"
    },
    {
      "Id": 200640800,
      "Speaker": "Player",
      "Text": "やっぱりウララは秘密が多いね"
    },
    {
      "Id": 200640810,
      "Speaker": "Student",
      "Text": "ふふ……"
    },
    {
      "Id": 200640820,
      "Speaker": "Student",
      "Text": "先生ほどではありません"
    },
    {
      "Id": 200640830,
      "Speaker": "Student",
      "Text": "では……"
    },
    {
      "Id": 200640840,
      "Speaker": "Student",
      "Text": "次もまた、美しい花が咲き誇る逢瀬となりますように"
    }
  ],
  "DialogKR": [
    {
      "Id": 200640010,
      "Speaker": "Student",
      "Text": "안녕하세요, 선생님."
    },
    {
      "Id": 200640020,
      "Speaker": "Student",
      "Text": "혹시 시간 괜찮으실까요?"
    },
    {
      "Id": 200640030,
      "Speaker": "Player",
      "Text": "응! 괜찮아!"
    },
    {
      "Id": 200640040,
      "Speaker": "Student",
      "Text": "저, 그게……"
    },
    {
      "Id": 200640050,
      "Speaker": "Student",
      "Text": "마나미 님으로부터 권고안이 왔는데"
    },
    {
      "Id": 200640060,
      "Speaker": "Student",
      "Text": "평의회 임원들은 선생님과 교류회를 가질 것……"
    },
    {
      "Id": 200640070,
      "Speaker": "Student",
      "Text": "이라고 하셔서요."
    },
    {
      "Id": 200640080,
      "Speaker": "Player",
      "Text": "나도 전달받았어!"
    },
    {
      "Id": 200640090,
      "Speaker": "Student",
      "Text": "아, 미리 연락받으셨었군요."
    },
    {
      "Id": 200640100,
      "Speaker": "Student",
      "Text": "그렇다면……"
    },
    {
      "Id": 200640110,
      "Speaker": "Student",
      "Text": "폐가 안 된다면 저와 교류회를……"
    },
    {
      "Id": 200640120,
      "Speaker": "Player",
      "Text": "응! 좋아!"
    },
    {
      "Id": 200640130,
      "Speaker": "Student",
      "Text": "가, 감사합니다."
    },
    {
      "Id": 200640140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "그럼 곧 일정을 잡아서 연락드릴게요."
    },
    {
      "Id": 200640150,
      "Speaker": "Student",
      "Text": "선생님. 잘 돌아가셨나요?"
    },
    {
      "Id": 200640160,
      "Speaker": "Student",
      "Text": "오늘 정말 즐거웠어요."
    },
    {
      "Id": 200640170,
      "Speaker": "Player",
      "Text": "응! 또 같이 영화를 보면 좋겠네."
    },
    {
      "Id": 200640180,
      "Speaker": "Student",
      "Text": "또…… 또요?"
    },
    {
      "Id": 200640190,
      "Speaker": "Student",
      "Text": "음……."
    },
    {
      "Id": 200640200,
      "Speaker": "Student",
      "Text": "저는 선생님이 원하신다면……."
    },
    {
      "Id": 200640210,
      "Speaker": "Student",
      "Text": "거부하지 않을게요."
    },
    {
      "Id": 200640220,
      "Speaker": "Player",
      "Text": "가, 강제의 의미는 없으니까!"
    },
    {
      "Id": 200640230,
      "Speaker": "Student",
      "Text": "네. 알고 있어요."
    },
    {
      "Id": 200640240,
      "Speaker": "Student",
      "Text": "선생님에게서는……"
    },
    {
      "Id": 200640250,
      "Speaker": "Student",
      "Text": "친절한 향기가 나니까."
    },
    {
      "Id": 200640260,
      "Speaker": "Student",
      "Text": "그럼, 다음에 또 뵐게요."
    },
    {
      "Id": 200640270,
      "Speaker": "Student",
      "Text": "안녕하세요, 선생님."
    },
    {
      "Id": 200640280,
      "Speaker": "Student",
      "Text": "오늘 업무차 이쪽에 오신다 들었어요."
    },
    {
      "Id": 200640290,
      "Speaker": "Student",
      "Text": "혹시라도 필요한 일이 있다면"
    },
    {
      "Id": 200640300,
      "Speaker": "Student",
      "Text": "부담 없이 말씀해 주세요."
    },
    {
      "Id": 200640310,
      "Speaker": "Player",
      "Text": "응! 고마워!"
    },
    {
      "Id": 200640320,
      "Speaker": "Student",
      "Text": "별말씀을요."
    },
    {
      "Id": 200640330,
      "Speaker": "Student",
      "Text": "해야만 하는 일인데요."
    },
    {
      "Id": 200640340,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그럼 오늘도 평온한 향기가 가득한 하루가 되시길."
    },
    {
      "Id": 200640350,
      "Speaker": "Student",
      "Text": "선생님. 갑자기 죄송한데……."
    },
    {
      "Id": 200640360,
      "Speaker": "Student",
      "Text": "제 고민을 들어주실 수 있을까요?"
    },
    {
      "Id": 200640370,
      "Speaker": "Player",
      "Text": "오! 물론이지!"
    },
    {
      "Id": 200640380,
      "Speaker": "Student",
      "Text": "가, 감사해요."
    },
    {
      "Id": 200640390,
      "Speaker": "Student",
      "Text": "면목 없지만 이 고민을 들어줄 사람은"
    },
    {
      "Id": 200640400,
      "Speaker": "Student",
      "Text": "선생님 이외엔 떠오르지 않아서……."
    },
    {
      "Id": 200640410,
      "Speaker": "Player",
      "Text": "어떤 고민인데?"
    },
    {
      "Id": 200640420,
      "Speaker": "Student",
      "Text": "이거, 기록이 남으면 안 되거든요."
    },
    {
      "Id": 200640430,
      "Speaker": "Student",
      "Text": "그러니 다소 번거로우시겠지만……"
    },
    {
      "Id": 200640440,
      "Speaker": "Student",
      "Text": "직접 만나서 이야기했으면 하는데."
    },
    {
      "Id": 200640450,
      "Speaker": "Student",
      "Text": "괜찮을까요?"
    },
    {
      "Id": 200640460,
      "Speaker": "Player",
      "Text": "언제든 괜찮아!"
    },
    {
      "Id": 200640470,
      "Speaker": "Student",
      "Text": "아…… 정말 감사합니다."
    },
    {
      "Id": 200640480,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "그럼 장소를 지정해 드릴 테니 그곳에서 봬요."
    },
    {
      "Id": 200640490,
      "Speaker": "Student",
      "Text": "선생님. 잘 돌아가셨나요?"
    },
    {
      "Id": 200640500,
      "Speaker": "Player",
      "Text": "응! 굿즈들도 무사해!"
    },
    {
      "Id": 200640510,
      "Speaker": "Student",
      "Text": "다행이네요……."
    },
    {
      "Id": 200640520,
      "Speaker": "Student",
      "Text": "부디 잘 보관해 주세요."
    },
    {
      "Id": 200640530,
      "Speaker": "Student",
      "Text": "저도 할 수 있는 걸 해볼 생각이에요."
    },
    {
      "Id": 200640540,
      "Speaker": "Student",
      "Text": "이대로 있다간……."
    },
    {
      "Id": 200640550,
      "Speaker": "Student",
      "Text": "예술의 다양성을 지키지 못할 테니."
    },
    {
      "Id": 200640560,
      "Speaker": "Student",
      "Text": "그럼 다음엔 좋은 소식으로 다시 뵐게요."
    },
    {
      "Id": 200640570,
      "Speaker": "Student",
      "Text": "오늘 정말 수고 많으셨습니다."
    },
    {
      "Id": 200640580,
      "Speaker": "Student",
      "Text": "편히 쉬세요."
    },
    {
      "Id": 200640590,
      "Speaker": "Student",
      "Text": "선생님. 기쁜 소식이 있어요."
    },
    {
      "Id": 200640600,
      "Speaker": "Student",
      "Text": "제가 좋아하는 그 연극이……."
    },
    {
      "Id": 200640610,
      "Speaker": "Student",
      "Text": "이번에 금지 항목에서 제외되었어요."
    },
    {
      "Id": 200640620,
      "Speaker": "Player",
      "Text": "오? 무슨 일이 있었던 거야?"
    },
    {
      "Id": 200640630,
      "Speaker": "Student",
      "Text": "후후……."
    },
    {
      "Id": 200640640,
      "Speaker": "Student",
      "Text": "말씀드렸잖아요."
    },
    {
      "Id": 200640650,
      "Speaker": "Student",
      "Text": "저도 할 수 있는 걸 해보겠다고."
    },
    {
      "Id": 200640660,
      "Speaker": "Student",
      "Text": "다행히 좋은 결과가 있었네요."
    },
    {
      "Id": 200640670,
      "Speaker": "Student",
      "Text": "금지됐던 물품들도 소지할 수 있게 됐으니……"
    },
    {
      "Id": 200640680,
      "Speaker": "Student",
      "Text": "괜찮으시다면 저번에 맡겨둔 물건들"
    },
    {
      "Id": 200640690,
      "Speaker": "Student",
      "Text": "돌려받을 수 있을까요?"
    },
    {
      "Id": 200640700,
      "Speaker": "Player",
      "Text": "응! 지금 그쪽으로 갈게!"
    },
    {
      "Id": 200640710,
      "Speaker": "Student",
      "Text": "네. 정말 감사합니다."
    },
    {
      "Id": 200640720,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "그럼 자세한 이야기는 만나서 하도록 해요."
    },
    {
      "Id": 200640730,
      "Speaker": "Student",
      "Text": "선생님. 오늘 즐거우셨을까요?"
    },
    {
      "Id": 200640740,
      "Speaker": "Player",
      "Text": "응! 다음에 또 들러도 될까?"
    },
    {
      "Id": 200640750,
      "Speaker": "Student",
      "Text": "예전의 저라면 안 된다고 했겠지만……"
    },
    {
      "Id": 200640760,
      "Speaker": "Student",
      "Text": "지금은 조금 다를지도 모르겠네요."
    },
    {
      "Id": 200640770,
      "Speaker": "Student",
      "Text": "네. 얼마든지 찾아와 주세요."
    },
    {
      "Id": 200640780,
      "Speaker": "Student",
      "Text": "대신 다른 분들께는 비밀이에요."
    },
    {
      "Id": 200640790,
      "Speaker": "Student",
      "Text": "아시죠?"
    },
    {
      "Id": 200640800,
      "Speaker": "Player",
      "Text": "역시 우라라는 비밀이 많네~"
    },
    {
      "Id": 200640810,
      "Speaker": "Student",
      "Text": "후후……"
    },
    {
      "Id": 200640820,
      "Speaker": "Student",
      "Text": "선생님 정도는 아니에요."
    },
    {
      "Id": 200640830,
      "Speaker": "Student",
      "Text": "그럼……"
    },
    {
      "Id": 200640840,
      "Speaker": "Student",
      "Text": "다음 만남도, 아름다운 꽃처럼 피어나기를."
    }
  ],
