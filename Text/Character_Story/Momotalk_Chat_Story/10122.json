    {
      "Id": 101220900,
      "Speaker": "Student",
      "Text": "Yeah"
    },
    {
      "Id": 101220910,
      "Speaker": "Student",
      "Text": "I just wanted to make one for some reason"
    },
    {
      "Id": 101220920,
      "Speaker": "Student",
      "StoryEpisode": 6,
      "Text": "Would you eat it, Sensei?"
    },
    {
      "Id": 101220930,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 101220940,
      "Speaker": "Player",
      "Text": "Yes, Mika."
    },
