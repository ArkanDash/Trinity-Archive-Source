{
  "CharacterId": 10122,
  "DialogJP": [
    {
      "Id": 101220010,
      "Speaker": "Student",
      "Text": "先生はろはろ～"
    },
    {
      "Id": 101220020,
      "Speaker": "Student",
      "Text": "届いてる？こんにちは！"
    },
    {
      "Id": 101220030,
      "Speaker": "Player",
      "Text": "こんにちは、ミカ"
    },
    {
      "Id": 101220040,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 101220050,
      "Speaker": "Student",
      "Text": "改めて挨拶しようと思って"
    },
    {
      "Id": 101220060,
      "Speaker": "Student",
      "Text": "ちょっと送ってみたんだ！"
    },
    {
      "Id": 101220070,
      "Speaker": "Student",
      "Text": "迷惑じゃなかった？"
    },
    {
      "Id": 101220080,
      "Speaker": "Player",
      "Text": "全然迷惑じゃないよ"
    },
    {
      "Id": 101220090,
      "Speaker": "Student",
      "Text": "よかった！"
    },
    {
      "Id": 101220100,
      "Speaker": "Student",
      "Text": "先生は今どこにいるの？"
    },
    {
      "Id": 101220110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ちょっと後で会いに行ってもいいかな"
    },
    {
      "Id": 101220120,
      "Speaker": "Student",
      "Text": "ねぇ、先生"
    },
    {
      "Id": 101220130,
      "Speaker": "Student",
      "Text": "聞きたいことがあるんだけど……"
    },
    {
      "Id": 101220140,
      "Speaker": "Student",
      "Text": "先生にもさ……あるの？"
    },
    {
      "Id": 101220150,
      "Speaker": "Student",
      "Text": "もう一つの顔、というか……"
    },
    {
      "Id": 101220160,
      "Speaker": "Student",
      "Text": "先生も知らない"
    },
    {
      "Id": 101220170,
      "Speaker": "Student",
      "Text": "別の側面、みたいなもの"
    },
    {
      "Id": 101220180,
      "Speaker": "Player",
      "Text": "あると思うよ"
    },
    {
      "Id": 101220190,
      "Speaker": "Player",
      "Text": "多分ね"
    },
    {
      "Id": 101220200,
      "Speaker": "Student",
      "Text": "へえ"
    },
    {
      "Id": 101220210,
      "Speaker": "Student",
      "Text": "そっか"
    },
    {
      "Id": 101220220,
      "Speaker": "Student",
      "Text": "大人もあるんだ……"
    },
    {
      "Id": 101220230,
      "Speaker": "Student",
      "Text": "ふふっ"
    },
    {
      "Id": 101220240,
      "Speaker": "Student",
      "Text": "なんか、ほっとした"
    },
    {
      "Id": 101220250,
      "Speaker": "Student",
      "Text": "先生の別の姿も見てみたいかも♪"
    },
    {
      "Id": 101220260,
      "Speaker": "Student",
      "Text": "先生……忙しい？"
    },
    {
      "Id": 101220270,
      "Speaker": "Student",
      "Text": "今大丈夫？"
    },
    {
      "Id": 101220280,
      "Speaker": "Player",
      "Text": "暇してるよ"
    },
    {
      "Id": 101220290,
      "Speaker": "Student",
      "Text": "わーお"
    },
    {
      "Id": 101220300,
      "Speaker": "Student",
      "Text": "よかった"
    },
    {
      "Id": 101220310,
      "Speaker": "Player",
      "Text": "ミカも一緒にぼーっとする？"
    },
    {
      "Id": 101220320,
      "Speaker": "Student",
      "Text": "！！すふ！！"
    },
    {
      "Id": 101220330,
      "Speaker": "Student",
      "Text": "する！！"
    },
    {
      "Id": 101220340,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 101220350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "どこにいるの～？"
    },
    {
      "Id": 101220360,
      "Speaker": "Student",
      "Text": "今日の授業が"
    },
    {
      "Id": 101220370,
      "Speaker": "Student",
      "Text": "今まで一番楽しかった！"
    },
    {
      "Id": 101220380,
      "Speaker": "Player",
      "Text": "授業というよりは、遊びかも……？"
    },
    {
      "Id": 101220390,
      "Speaker": "Student",
      "Text": "えへへ、そうかも"
    },
    {
      "Id": 101220400,
      "Speaker": "Student",
      "Text": "また……遊んでね☆"
    },
    {
      "Id": 101220410,
      "Speaker": "Student",
      "Text": "先生知ってる？"
    },
    {
      "Id": 101220420,
      "Speaker": "Student",
      "Text": "浜辺には"
    },
    {
      "Id": 101220430,
      "Speaker": "Student",
      "Text": "綺麗なものがいっぱいあるんだ"
    },
    {
      "Id": 101220440,
      "Speaker": "Student",
      "Text": "先生は見たことある？"
    },
    {
      "Id": 101220450,
      "Speaker": "Player",
      "Text": "例えば？"
    },
    {
      "Id": 101220460,
      "Speaker": "Student",
      "Text": "ええっと……"
    },
    {
      "Id": 101220470,
      "Speaker": "Student",
      "Text": "私……とか？"
    },
    {
      "Id": 101220480,
      "Speaker": "Student",
      "Text": "あはは、冗談だって☆"
    },
    {
      "Id": 101220490,
      "Speaker": "Student",
      "Text": "先生がどんな顔したのか、なんとなくわかるよ！"
    },
    {
      "Id": 101220500,
      "Speaker": "Student",
      "Text": "浜辺の綺麗なものといえば……"
    },
    {
      "Id": 101220510,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "貝殻、かな"
    },
    {
      "Id": 101220520,
      "Speaker": "Student",
      "Text": "せえんせーーー；－？"
    },
    {
      "Id": 101220530,
      "Speaker": "Student",
      "Text": "へっえ へ"
    },
    {
      "Id": 101220540,
      "Speaker": "Player",
      "Text": "ミカ……？"
    },
    {
      "Id": 101220550,
      "Speaker": "Student",
      "Text": "ちっと"
    },
    {
      "Id": 101220560,
      "Speaker": "Student",
      "Text": "おくっえみあ"
    },
    {
      "Id": 101220570,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "たけえ"
    },
    {
      "Id": 101220580,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101220590,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101220600,
      "Speaker": "Student",
      "Text": "ごめんなさい"
    },
    {
      "Id": 101220610,
      "Speaker": "Student",
      "Text": "寝ちゃったね……"
    },
    {
      "Id": 101220620,
      "Speaker": "Player",
      "Text": "ただのジュースだったのに……"
    },
    {
      "Id": 101220630,
      "Speaker": "Student",
      "Text": "なんかこれでいいんだって思ったら"
    },
    {
      "Id": 101220640,
      "Speaker": "Student",
      "Text": "緊張が解けちゃったみたいで……"
    },
    {
      "Id": 101220650,
      "Speaker": "Student",
      "Text": "迷惑かけて、ごめんね"
    },
    {
      "Id": 101220660,
      "Speaker": "Player",
      "Text": "ゆっくり休んでね、ミカ"
    },
    {
      "Id": 101220670,
      "Speaker": "Student",
      "Text": "うん、ありがとう"
    },
    {
      "Id": 101220680,
      "Speaker": "Student",
      "Text": "先生、その……今日のことは……"
    },
    {
      "Id": 101220690,
      "Speaker": "Student",
      "Text": "ええっと……"
    },
    {
      "Id": 101220700,
      "Speaker": "Student",
      "Text": "いや、何でもない"
    },
    {
      "Id": 101220710,
      "Speaker": "Student",
      "Text": "先生もゆっくり休んでね！"
    },
    {
      "Id": 101220720,
      "Speaker": "Student",
      "Text": "先生今大丈夫？"
    },
    {
      "Id": 101220730,
      "Speaker": "Student",
      "Text": "ちょっとだけ時間ちょうだい！"
    },
    {
      "Id": 101220740,
      "Speaker": "Student",
      "Text": "実はね……"
    },
    {
      "Id": 101220750,
      "Speaker": "Student",
      "Text": "……素敵なところを見つけちゃったの！"
    },
    {
      "Id": 101220760,
      "Speaker": "Student",
      "Text": "急いで来ないと間に合わないかも！"
    },
    {
      "Id": 101220770,
      "Speaker": "Player",
      "Text": "わかった、今どこ？"
    },
    {
      "Id": 101220780,
      "Speaker": "Student",
      "Text": "やった！"
    },
    {
      "Id": 101220790,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "えっとね？"
    },
    {
      "Id": 101220800,
      "Speaker": "Student",
      "Text": "先生！お腹すいたよね？"
    },
    {
      "Id": 101220810,
      "Speaker": "Player",
      "Text": "空いてないかも……"
    },
    {
      "Id": 101220820,
      "Speaker": "Student",
      "Text": "またまたそんなこと言って～"
    },
    {
      "Id": 101220830,
      "Speaker": "Student",
      "Text": "私、知ってるんだから"
    },
    {
      "Id": 101220840,
      "Speaker": "Student",
      "Text": "お腹すいたでしょ？"
    },
    {
      "Id": 101220850,
      "Speaker": "Student",
      "Text": "もうすっごくペコペコだったりしない～？"
    },
    {
      "Id": 101220860,
      "Speaker": "Player",
      "Text": "い、言われてみれば……？"
    },
    {
      "Id": 101220870,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 101220880,
      "Speaker": "Student",
      "Text": "待っててね！お弁当持ってくから！"
    },
    {
      "Id": 101220890,
      "Speaker": "Player",
      "Text": "ミカの手作り？"
    },
    {
      "Id": 101220900,
      "Speaker": "Student",
      "Text": "実はね"
    },
    {
      "Id": 101220910,
      "Speaker": "Student",
      "Text": "先生のために作ったの"
    },
    {
      "Id": 101220920,
      "Speaker": "Student",
      "StoryEpisode": 6,
      "Text": "食べてくれる？"
    },
    {
      "Id": 101220930,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101220940,
      "Speaker": "Player",
      "Text": "うん"
    },
    {
      "Id": 101220950,
      "Speaker": "Student",
      "Text": "あの"
    },
    {
      "Id": 101220960,
      "Speaker": "Student",
      "Text": "いつも本当に……"
    },
    {
      "Id": 101220970,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    }
  ],
  "DialogKR": [
    {
      "Id": 101220010,
      "Speaker": "Student",
      "Text": "선생님 안녕안녕~"
