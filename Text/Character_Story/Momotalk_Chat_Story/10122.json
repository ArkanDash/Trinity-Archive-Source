    {
      "Id": 101220650,
      "Speaker": "Student",
      "Text": "Sorry."
    },
    {
      "Id": 101220660,
      "Speaker": "Player",
      "Text": "You couldn't help it. Get some rest, Mika."
    },
    {
      "Id": 101220670,
      "Speaker": "Student",
      "Text": "Okay thanks..."
    },
    {
      "Id": 101220680,
      "Speaker": "Student",
      "Text": "About today"
