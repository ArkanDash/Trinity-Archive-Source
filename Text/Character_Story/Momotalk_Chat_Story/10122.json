  "DialogEN": [
    {
      "Id": 101220010,
      "Speaker": "Student",
      "Text": "Sensei, hi, hi!"
    },
    {
      "Id": 101220020,
      "Speaker": "Student",
      "Text": "You there?"
    },
    {
      "Id": 101220030,
      "Speaker": "Player",
      "Text": "Hi, Mika."
    },
    {
      "Id": 101220040,
      "Speaker": "Student",
      "Text": "Heeheehee"
    },
    {
      "Id": 101220050,
      "Speaker": "Student",
      "Text": "Siiince it's a special occasion,"
    },
    {
      "Id": 101220060,
      "Speaker": "Student",
      "Text": "I figured I'd text you!"
    },
    {
      "Id": 101220070,
      "Speaker": "Student",
