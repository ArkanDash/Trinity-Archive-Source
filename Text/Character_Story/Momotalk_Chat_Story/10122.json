      "Id": 101220610,
      "Speaker": "Student",
      "Text": "I fell asleep..."
    },
    {
      "Id": 101220620,
      "Speaker": "Player",
      "Text": "There weren't any sleep-inducing ingredients in it..."
    },
    {
      "Id": 101220630,
      "Speaker": "Student",
      "Text": "I just got super relaxed."
    },
    {
      "Id": 101220640,
      "Speaker": "Student",
      "Text": "For some reason, I felt really comfy."
