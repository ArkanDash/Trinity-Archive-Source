    {
      "Id": 101220730,
      "Speaker": "Student",
      "Text": "Do you have a minute?"
    },
    {
      "Id": 101220740,
      "Speaker": "Student",
      "Text": "It's nothing serious!"
    },
    {
      "Id": 101220750,
      "Speaker": "Student",
      "Text": "I just found this really cool spot."
    },
    {
      "Id": 101220760,
      "Speaker": "Student",
      "Text": "And right now happens to be the perfect time to go see it!"
    },
    {
      "Id": 101220770,
      "Speaker": "Player",
      "Text": "Where should I meet you?"
