    {
      "Id": 101220690,
      "Speaker": "Student",
      "Text": "Um"
    },
    {
      "Id": 101220700,
      "Speaker": "Student",
      "Text": "No, never mind."
    },
    {
      "Id": 101220710,
      "Speaker": "Student",
      "Text": "You should rest up too, Sensei!"
    },
    {
      "Id": 101220720,
      "Speaker": "Student",
      "Text": "Sensei"
