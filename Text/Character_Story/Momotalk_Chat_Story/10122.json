    {
      "Id": 101220300,
      "Speaker": "Student",
      "Text": "그렇구나"
    },
    {
      "Id": 101220310,
      "Speaker": "Player",
      "Text": "미카도 같이 할래?"
    },
    {
      "Id": 101220320,
