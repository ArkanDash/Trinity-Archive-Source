{
  "CharacterId": 10026,
  "DialogJP": [
    {
      "Id": 100260010,
      "Speaker": "Student",
      "Text": "なあ"
    },
    {
      "Id": 100260020,
      "Speaker": "Student",
      "Text": "ちょっと手伝ってもらいてぇんだけど"
    },
    {
      "Id": 100260030,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 100260040,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100260050,
      "Speaker": "Student",
      "Text": "あー"
    },
    {
      "Id": 100260060,
      "Speaker": "Student",
      "Text": "何つーか……"
    },
    {
      "Id": 100260070,
      "Speaker": "Student",
      "Text": ""
    },
    {
      "Id": 100260080,
      "Speaker": "Player",
      "Text": "……え？"
    },
    {
      "Id": 100260090,
      "Speaker": "Player",
      "Text": "？？？？？"
    },
    {
      "Id": 100260100,
      "Speaker": "Student",
      "Text": "とにかく"
    },
    {
      "Id": 100260110,
      "Speaker": "Student",
      "Text": "着方が分かんなくてよ"
    },
    {
      "Id": 100260120,
      "Speaker": "Student",
      "Text": "悪ぃんだけど"
    },
    {
      "Id": 100260130,
      "Speaker": "Student",
      "Text": "服が破れる前に来てくれ"
    },
    {
      "Id": 100260140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "よろしく"
    },
    {
      "Id": 100260150,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100260160,
      "Speaker": "Student",
      "Text": "今日はあんがとな"
    },
    {
      "Id": 100260170,
      "Speaker": "Student",
      "Text": "これからも、その"
    },
    {
      "Id": 100260180,
      "Speaker": "Student",
      "Text": "まあ、たまには連絡するからよ"
    },
    {
      "Id": 100260190,
      "Speaker": "Student",
      "Text": "無視とかすんじゃねーぞ？"
    },
    {
      "Id": 100260200,
      "Speaker": "Student",
      "Text": "じゃ、またな"
    },
    {
      "Id": 100260210,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100260220,
      "Speaker": "Student",
      "Text": "今大丈夫か？"
    },
    {
      "Id": 100260230,
      "Speaker": "Player",
      "Text": "もちろん、どうしたの？"
    },
    {
      "Id": 100260240,
      "Speaker": "Player",
      "Text": "本当に連絡くれた！"
    },
    {
      "Id": 100260250,
      "Speaker": "Student",
      "Text": "いや、大したことじゃねーんだけどよ"
    },
    {
      "Id": 100260260,
      "Speaker": "Student",
      "Text": "先生が連絡してほしいって言ったんだろーが……"
    },
    {
      "Id": 100260270,
      "Speaker": "Student",
      "Text": "絆創膏買ってきてくれねーか"
    },
    {
      "Id": 100260280,
      "Speaker": "Student",
      "Text": "忙しいなら、今じゃなくても良い"
    },
    {
      "Id": 100260290,
      "Speaker": "Player",
      "Text": "分かった、すぐ行くね"
    },
    {
      "Id": 100260300,
      "Speaker": "Player",
      "Text": "怪我したの？大丈夫？"
    },
    {
      "Id": 100260310,
      "Speaker": "Student",
      "Text": "おう"
    },
    {
      "Id": 100260320,
      "Speaker": "Student",
      "Text": "まあ気にすんな、大したことじゃねぇから"
    },
    {
      "Id": 100260330,
      "Speaker": "Student",
      "Text": "とりあえず、サンキュ"
    },
    {
      "Id": 100260340,
      "Speaker": "Student",
      "Text": "じゃ"
    },
    {
      "Id": 100260350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "待ってっから"
    },
    {
      "Id": 100260360,
      "Speaker": "Student",
      "Text": "ははっ"
    },
    {
      "Id": 100260370,
      "Speaker": "Student",
      "Text": "こうしてしょっちゅうやり取りすんのも、何か変な感じだな"
    },
    {
      "Id": 100260380,
      "Speaker": "Student",
      "Text": "……先生は、面倒だとか思わねぇか？"
    },
    {
      "Id": 100260390,
      "Speaker": "Player",
      "Text": "もちろん、そんなことないよ。いつでも連絡して"
    },
    {
      "Id": 100260400,
      "Speaker": "Student",
      "Text": "はっ、言ったな？"
    },
    {
      "Id": 100260410,
      "Speaker": "Student",
      "Text": "じゃあ、また連絡するからな"
    },
    {
      "Id": 100260420,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100260430,
      "Speaker": "Student",
      "Text": "ちっとお願いっつーか"
    },
    {
      "Id": 100260440,
      "Speaker": "Student",
      "Text": "いや正確にはお願いっていうか、確認っていうか"
    },
    {
      "Id": 100260450,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 100260460,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 100260470,
      "Speaker": "Student",
      "Text": "何つーか"
    },
    {
      "Id": 100260480,
      "Speaker": "Student",
      "Text": "んー、何て説明すりゃ良いんだ……？"
    },
    {
      "Id": 100260490,
      "Speaker": "Student",
      "Text": "直接会った方が早ぇな"
    },
    {
      "Id": 100260500,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "今から時間あるか？"
    }
  ],
  "DialogKR": [
    {
      "Id": 100260010,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100260020,
      "Speaker": "Student",
      "Text": "대체 이게 어떻게 된……."
    },
    {
      "Id": 100260030,
      "Speaker": "Player",
      "Text": "……?"
    },
    {
      "Id": 100260040,
      "Speaker": "Player",
      "Text": "무슨 일이야?"
    },
    {
      "Id": 100260050,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 100260060,
      "Speaker": "Student",
      "Text": "좀 봐봐"
    },
    {
      "Id": 100260070,
      "Speaker": "Student",
      "Text": ""
    },
    {
      "Id": 100260080,
      "Speaker": "Player",
      "Text": "……."
    },
    {
      "Id": 100260090,
      "Speaker": "Player",
      "Text": "????????????"
    },
    {
      "Id": 100260100,
      "Speaker": "Student",
      "Text": "이거"
    },
    {
      "Id": 100260110,
      "Speaker": "Student",
      "Text": "어떻게 입는지 모르겠다."
    },
    {
      "Id": 100260120,
      "Speaker": "Student",
      "Text": "이대로라면 짜증 나서 찢어버릴지도 모르니까"
    },
    {
      "Id": 100260130,
      "Speaker": "Student",
      "Text": "와서 좀 봐줘 봐."
    },
    {
      "Id": 100260140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "지금 바로"
    },
    {
      "Id": 100260150,
      "Speaker": "Student",
      "Text": "선생."
    },
    {
      "Id": 100260160,
      "Speaker": "Student",
      "Text": "아까 한 말에 대답을 해주지."
    },
    {
      "Id": 100260170,
      "Speaker": "Student",
      "Text": "좋아."
    },
    {
      "Id": 100260180,
      "Speaker": "Student",
      "Text": "앞으로도 종종 불러줄 테니까 말이야."
    },
    {
      "Id": 100260190,
      "Speaker": "Student",
      "Text": "무시하면 안 된다고. 알았지?"
    },
    {
      "Id": 100260200,
      "Speaker": "Student",
      "Text": "크하하."
    },
    {
      "Id": 100260210,
      "Speaker": "Student",
      "Text": "선생."
    },
    {
      "Id": 100260220,
      "Speaker": "Student",
      "Text": "지금 부탁 하나만 해도 될까."
    },
    {
      "Id": 100260230,
      "Speaker": "Player",
      "Text": "물론이지. 무슨 일이야?"
    },
    {
      "Id": 100260240,
      "Speaker": "Player",
      "Text": "오, 진짜로 불러주는 건가."
    },
    {
      "Id": 100260250,
      "Speaker": "Student",
      "Text": "아니. 별일은 아니야."
    },
    {
      "Id": 100260260,
      "Speaker": "Student",
      "Text": "뭐야. 선생이 괜찮다고 했잖아."
    },
    {
      "Id": 100260270,
      "Speaker": "Student",
      "Text": "선생 아니면 부탁하기 힘든 거니까 그런 거라고."
    },
    {
      "Id": 100260280,
      "Speaker": "Student",
      "Text": "그냥 밴드 하나만 사 와 주면 돼. 안 되면 말고."
    },
    {
      "Id": 100260290,
      "Speaker": "Player",
      "Text": "알았어. 지금 갈게."
    },
    {
      "Id": 100260300,
      "Speaker": "Player",
      "Text": "밴드? 어디 다쳤어?"
    },
    {
      "Id": 100260310,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 100260320,
      "Speaker": "Student",
      "Text": "신경 쓸 거 없어. 그런 건 아니니까."
    },
    {
      "Id": 100260330,
      "Speaker": "Student",
      "Text": "음."
    },
    {
      "Id": 100260340,
      "Speaker": "Student",
      "Text": "……고마워, 일단은."
    },
    {
      "Id": 100260350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "조금 이따가 오면 보자고."
    },
    {
      "Id": 100260360,
      "Speaker": "Student",
      "Text": "하하."
    },
    {
      "Id": 100260370,
      "Speaker": "Student",
      "Text": "생각보다는 좀 편하구만. 이런 식으로 부탁하는 거."
    },
    {
      "Id": 100260380,
      "Speaker": "Student",
      "Text": "……가끔 또 이런 식으로 부탁해도 괜찮겠지? 선생?"
    },
    {
      "Id": 100260390,
      "Speaker": "Player",
      "Text": "물론이지."
    },
    {
      "Id": 100260400,
      "Speaker": "Student",
      "Text": "크하하. 좋아."
    },
    {
      "Id": 100260410,
      "Speaker": "Student",
      "Text": "기회가 되면 또 보자고."
    },
    {
      "Id": 100260420,
      "Speaker": "Student",
      "Text": "선생."
    },
    {
      "Id": 100260430,
      "Speaker": "Student",
      "Text": "또 부탁하고 싶은 일이 하나 생겼는데."
    },
    {
      "Id": 100260440,
      "Speaker": "Student",
      "Text": "아니, 정확히는 부탁이 아니라 확인이라고 봐야겠지만."
    },
    {
      "Id": 100260450,
      "Speaker": "Player",
      "Text": "……? 궁금한 거?"
    },
    {
      "Id": 100260460,
      "Speaker": "Player",
      "Text": "무슨 일이야?"
    },
    {
      "Id": 100260470,
      "Speaker": "Student",
      "Text": "별 건 아니고."
    },
    {
      "Id": 100260480,
      "Speaker": "Student",
      "Text": "그냥 사람들이 좀 이상해서."
    },
    {
      "Id": 100260490,
      "Speaker": "Student",
      "Text": "말로는 설명이 안 되는군."
    },
    {
      "Id": 100260500,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "지금 시간 괜찮아? 와줄 수 있나?"
    }
  ],
  "DialogEN": [
    {
      "Id": 100260010,
      "Speaker": "Student",
      "Text": "Oh"
    },
    {
      "Id": 100260020,
      "Speaker": "Student",
      "Text": "Why is this happening?"
    },
    {
      "Id": 100260030,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 100260040,
      "Speaker": "Player",
      "Text": "What's going on?"
    },
    {
      "Id": 100260050,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 100260060,
      "Speaker": "Student",
      "Text": "Look at this."
    },
    {
      "Id": 100260070,
      "Speaker": "Student",
      "Text": ""
    },
    {
      "Id": 100260080,
      "Speaker": "Player",
      "Text": "..."
    },
    {
      "Id": 100260090,
      "Speaker": "Player",
      "Text": "???"
    },
    {
      "Id": 100260100,
      "Speaker": "Student",
      "Text": "This..."
    },
    {
      "Id": 100260110,
      "Speaker": "Student",
      "Text": "I don't know how to wear this."
    },
    {
      "Id": 100260120,
      "Speaker": "Student",
      "Text": "At this rate, I might get fed up and tear it apart"
    },
    {
      "Id": 100260130,
      "Speaker": "Student",
      "Text": "so come and help me."
    },
    {
      "Id": 100260140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Right now."
    },
    {
      "Id": 100260150,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100260160,
      "Speaker": "Student",
      "Text": "Remember what you said to me earlier?"
    },
    {
      "Id": 100260170,
      "Speaker": "Student",
      "Text": "Sure."
    },
    {
      "Id": 100260180,
      "Speaker": "Student",
      "Text": "I'll be calling you more often from now on."
    },
    {
      "Id": 100260190,
      "Speaker": "Student",
      "Text": "So don't ignore me. Got it?"
    },
    {
      "Id": 100260200,
      "Speaker": "Student",
      "Text": "Hahaha."
    },
    {
      "Id": 100260210,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100260220,
      "Speaker": "Student",
      "Text": "Could you do me a favor right now?"
    },
    {
      "Id": 100260230,
      "Speaker": "Player",
      "Text": "Of course. How can I help?"
    },
    {
      "Id": 100260240,
      "Speaker": "Player",
      "Text": "That was fast."
    },
    {
      "Id": 100260250,
      "Speaker": "Student",
      "Text": "Well, it's nothing really."
    },
    {
      "Id": 100260260,
      "Speaker": "Student",
      "Text": "Come on, you said it was fine, Sensei."
    },
    {
      "Id": 100260270,
      "Speaker": "Student",
      "Text": "This is something I only feel comfortable asking you to do."
    },
    {
      "Id": 100260280,
      "Speaker": "Student",
      "Text": "I just need you to buy me a bandage. It's okay if you can't."
    },
    {
      "Id": 100260290,
      "Speaker": "Player",
      "Text": "Okay. I'll come right now."
    },
    {
      "Id": 100260300,
      "Speaker": "Player",
      "Text": "A bandage? Are you hurt?"
    },
    {
      "Id": 100260310,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100260320,
      "Speaker": "Student",
      "Text": "Don't worry about it. It's not anything like that."
    },
    {
      "Id": 100260330,
      "Speaker": "Student",
      "Text": "Hmm."
    },
    {
      "Id": 100260340,
      "Speaker": "Student",
      "Text": "I'll just say thanks for now."
    },
    {
      "Id": 100260350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "See you when you get here."
    },
    {
      "Id": 100260360,
      "Speaker": "Student",
      "Text": "Haha."
    },
    {
      "Id": 100260370,
      "Speaker": "Student",
      "Text": "Asking for favors is a lot easier than I thought."
    },
    {
      "Id": 100260380,
      "Speaker": "Student",
      "Text": "Would it be okay if I asked for more favors from time to time?"
    },
    {
      "Id": 100260390,
      "Speaker": "Player",
      "Text": "Of course."
    },
    {
      "Id": 100260400,
      "Speaker": "Student",
      "Text": "Haha. Good."
    },
    {
      "Id": 100260410,
      "Speaker": "Student",
      "Text": "Let's meet again soon."
    },
    {
      "Id": 100260420,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100260430,
      "Speaker": "Student",
      "Text": "There's something else I want to ask."
    },
    {
      "Id": 100260440,
      "Speaker": "Student",
      "Text": "Actually, to be precise, it's more like something I want to confirm."
    },
    {
      "Id": 100260450,
      "Speaker": "Player",
      "Text": "Curious about something?"
    },
    {
      "Id": 100260460,
      "Speaker": "Player",
      "Text": "What's going on?"
    },
    {
      "Id": 100260470,
      "Speaker": "Student",
      "Text": "It's nothing serious."
    },
    {
      "Id": 100260480,
      "Speaker": "Student",
      "Text": "It's just that people are being weird."
    },
    {
      "Id": 100260490,
      "Speaker": "Student",
      "Text": "I can't really explain it."
    },
    {
      "Id": 100260500,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Are you free right now? Can you come over?"
    }
  ],
  "DialogTH": [
    {
      "Id": 100260010,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 100260020,
      "Speaker": "Student",
      "Text": "นี่มันเกิดอะไรขึ้น..."
    },
    {
      "Id": 100260030,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 100260040,
      "Speaker": "Player",
      "Text": "มีอะไรเหรอ?"
    },
    {
      "Id": 100260050,
      "Speaker": "Student",
      "Text": "คือ..."
    },
    {
      "Id": 100260060,
      "Speaker": "Student",
      "Text": "ฟังก่อนนะ"
    },
    {
      "Id": 100260070,
      "Speaker": "Student",
      "Text": ""
    },
    {
      "Id": 100260080,
      "Speaker": "Player",
      "Text": "..."
    },
    {
      "Id": 100260090,
      "Speaker": "Player",
      "Text": "????????????"
    },
    {
      "Id": 100260100,
      "Speaker": "Student",
      "Text": "ชุดนี่..."
    },
    {
      "Id": 100260110,
      "Speaker": "Student",
      "Text": "ฉันไม่รู้หรอกว่าจะใส่ได้ยังไง"
    },
    {
      "Id": 100260120,
      "Speaker": "Student",
      "Text": "ถ้าเป็นแบบนี้ละก็ ฉันอาจจะรำคาญจน\nฉีกมันขาด เป็นชิ้นๆ เลยก็ได้"
    },
    {
      "Id": 100260130,
      "Speaker": "Student",
      "Text": "ลองมาดูให้หน่อยสิ"
    },
    {
      "Id": 100260140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "มาเดี๋ยวนี้เลยนะ"
    },
    {
      "Id": 100260150,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100260160,
      "Speaker": "Student",
      "Text": "ฉันจะตอบในเรื่องที่ครูบอกเมื่อกี้"
    },
    {
      "Id": 100260170,
      "Speaker": "Student",
      "Text": "ดีล่ะ"
    },
    {
      "Id": 100260180,
      "Speaker": "Student",
      "Text": "ต่อไปฉันจะเรียกคุณครูมาบ่อยๆ นะ"
    },
    {
      "Id": 100260190,
      "Speaker": "Student",
      "Text": "ห้ามเมินเวลาฉันเรียกล่ะ เข้าใจมั้ย?"
    },
    {
      "Id": 100260200,
      "Speaker": "Student",
      "Text": "ฮะฮ่าฮ่า"
    },
    {
      "Id": 100260210,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100260220,
      "Speaker": "Student",
      "Text": "ฉันรบกวนคุณครูสักเรื่องได้มั้ย"
    },
    {
      "Id": 100260230,
      "Speaker": "Player",
      "Text": "ได้อยู่แล้ว เรื่องอะไรเหรอ?"
    },
    {
      "Id": 100260240,
      "Speaker": "Player",
      "Text": "โอ้ เรียกจริงๆ ด้วยแฮะ"
    },
    {
      "Id": 100260250,
      "Speaker": "Student",
      "Text": "เปล่า ไม่มีอะไรหรอก"
    },
    {
      "Id": 100260260,
      "Speaker": "Student",
      "Text": "อะไรน่ะ ไหนครูบอกว่าไม่เป็นไรยังไงล่ะ"
    },
    {
      "Id": 100260270,
      "Speaker": "Student",
      "Text": "จะไปขอร้องคนอื่นที่ไม่ใช่ครูละก็ มันลำบากนิดหน่อยน่ะ"
    },
    {
      "Id": 100260280,
      "Speaker": "Student",
      "Text": "ครูช่วยซื้อพลาสเตอร์มาให้ฉันหน่อย\nได้มั้ย ถ้าไม่ได้ก็ไม่เป็นไร"
    },
    {
      "Id": 100260290,
      "Speaker": "Player",
      "Text": "เข้าใจแล้ว จะไปเดี๋ยวนี้แหละ"
    },
    {
      "Id": 100260300,
      "Speaker": "Player",
      "Text": "พลาสเตอร์? บาดเจ็บตรงไหนงั้นเหรอ?"
    },
    {
      "Id": 100260310,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100260320,
      "Speaker": "Student",
      "Text": "ไม่ต้องสนใจหรอก ไม่ได้บาดเจ็บอะไรมาก"
    },
    {
      "Id": 100260330,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100260340,
      "Speaker": "Student",
      "Text": "ยังไงก็ขอบคุณนะ..."
    },
    {
      "Id": 100260350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "แล้วเดี๋ยวเจอกัน"
    },
    {
      "Id": 100260360,
      "Speaker": "Student",
      "Text": "ฮะฮะ..."
    },
    {
      "Id": 100260370,
      "Speaker": "Student",
      "Text": "สบายกว่าที่คิดไว้อีกแฮะ การขอร้องแบบนี้น่ะ"
    },
    {
      "Id": 100260380,
      "Speaker": "Student",
      "Text": "บางครั้งขอร้องแบบนี้ก็คงไม่เป็นไร\nใช่มั้ยล่ะ? คุณครู?"
    },
    {
      "Id": 100260390,
      "Speaker": "Player",
      "Text": "แน่นอนอยู่แล้ว"
    },
    {
      "Id": 100260400,
      "Speaker": "Student",
      "Text": "ฮะฮ่าฮ่า ดีล่ะ"
    },
    {
      "Id": 100260410,
      "Speaker": "Student",
      "Text": "ถ้ามีโอกาสก็ไว้เจอกันใหม่นะ"
    },
    {
      "Id": 100260420,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100260430,
      "Speaker": "Student",
      "Text": "ฉันมีเรื่องอยากจะขอร้องอีกเรื่องน่ะ"
    },
    {
      "Id": 100260440,
      "Speaker": "Student",
      "Text": "ไม่สิ ที่จริงแล้วก็ไม่ใช่เรื่องขอร้องหรอก แต่ขอให้ตรวจสอบมากกว่า"
    },
    {
      "Id": 100260450,
      "Speaker": "Player",
      "Text": "...? เรื่องที่เธอสงสัยเหรอ?"
    },
    {
      "Id": 100260460,
      "Speaker": "Player",
      "Text": "มีอะไรเหรอ?"
    },
    {
      "Id": 100260470,
      "Speaker": "Student",
      "Text": "ไม่ใช่เรื่องใหญ่หรอก"
    },
    {
      "Id": 100260480,
      "Speaker": "Student",
      "Text": "คือว่าท่าทางคนอื่นดูแปลกๆ น่ะ"
    },
    {
      "Id": 100260490,
      "Speaker": "Student",
      "Text": "ฉันก็อธิบายไม่ถูกแฮะ"
    },
    {
      "Id": 100260500,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ตอนนี้คุณครูว่างมั้ย? มาที่นี่หน่อยได้รึเปล่า?"
    }
  ],
