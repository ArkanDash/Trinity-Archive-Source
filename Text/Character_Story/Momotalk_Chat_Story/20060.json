{
  "CharacterId": 20060,
  "DialogJP": [
    {
      "Id": 200600010,
      "Speaker": "Student",
      "Text": "せん"
    },
    {
      "Id": 200600020,
      "Speaker": "Student",
      "Text": "せい"
    },
    {
      "Id": 200600030,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200600040,
      "Speaker": "Player",
      "Text": "準備はできてるよ～"
    },
    {
      "Id": 200600050,
      "Speaker": "Student",
      "Text": "やったー！"
    },
    {
      "Id": 200600060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "イブキいくね！"
    },
    {
      "Id": 200600070,
      "Speaker": "Student",
      "Text": "先生先生"
    },
    {
      "Id": 200600080,
      "Speaker": "Student",
      "Text": "イブキ、げんきになったー！"
    },
    {
      "Id": 200600090,
      "Speaker": "Student",
      "Text": "先生はどう？"
    },
    {
      "Id": 200600100,
      "Speaker": "Player",
      "Text": "こっちも完全回復だよ！"
    },
    {
      "Id": 200600110,
      "Speaker": "Student",
      "Text": "今日はね、イブキの授業があるの"
    },
    {
      "Id": 200600120,
      "Speaker": "Student",
      "Text": "き"
    },
    {
      "Id": 200600130,
      "Speaker": "Student",
      "Text": "きてくれる？"
    },
    {
      "Id": 200600140,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 200600150,
      "Speaker": "Student",
      "Text": "じゃあ"
    },
    {
      "Id": 200600160,
      "Speaker": "Student",
      "Text": "このあと"
    },
    {
      "Id": 200600170,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ビーチの岩のとこにきて！"
    },
    {
      "Id": 200600180,
      "Speaker": "Student",
      "Text": "先生……ごめんなさい……"
    },
    {
      "Id": 200600190,
      "Speaker": "Student",
      "Text": "重かったよね……？"
    },
    {
      "Id": 200600200,
      "Speaker": "Player",
      "Text": "ううん全然"
    },
    {
      "Id": 200600210,
      "Speaker": "Player",
      "Text": "一日中おんぶできるよ"
    },
    {
      "Id": 200600220,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 200600230,
      "Speaker": "Student",
      "Text": "ありがとうございます、先生！"
    },
    {
      "Id": 200600240,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 200600250,
      "Speaker": "Student",
      "Text": "ビーチに新しいお店がたくさんできてる！"
    },
    {
      "Id": 200600260,
      "Speaker": "Player",
      "Text": "えっ！本当に？"
    },
    {
      "Id": 200600270,
      "Speaker": "Student",
      "Text": "い"
    },
    {
      "Id": 200600280,
      "Speaker": "Student",
      "Text": "いっしょに見にいこう！"
    },
    {
      "Id": 200600290,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "喜んで！"
    },
    {
      "Id": 200600300,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 200600310,
      "Speaker": "Student",
      "Text": "イブキね"
    },
    {
      "Id": 200600320,
      "Speaker": "Student",
      "Text": "新しい絵の描き方、見つけたの！"
    },
    {
      "Id": 200600330,
      "Speaker": "Player",
      "Text": "おお、どんな方法？"
    },
    {
      "Id": 200600340,
      "Speaker": "Student",
      "Text": "それはね"
    },
    {
      "Id": 200600350,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 200600360,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "このあと見せてあげる！"
    },
    {
      "Id": 200600370,
      "Speaker": "Student",
      "Text": "先生先生"
    },
    {
      "Id": 200600380,
      "Speaker": "Student",
      "Text": "シャーレにつきましたかー？"
    },
    {
      "Id": 200600390,
      "Speaker": "Player",
      "Text": "ついてるよ！"
    },
    {
      "Id": 200600400,
      "Speaker": "Player",
      "Text": "絵は完成した？"
    },
    {
      "Id": 200600410,
      "Speaker": "Student",
      "Text": "あ……えっと……"
    },
    {
      "Id": 200600420,
      "Speaker": "Student",
      "Text": "実はね……ちょっと足りなくて"
    },
    {
      "Id": 200600430,
      "Speaker": "Student",
      "Text": "画用紙の半分くらいしか埋まらなかったんだ！"
    },
    {
      "Id": 200600440,
      "Speaker": "Player",
      "Text": "あっ……"
    },
    {
      "Id": 200600450,
      "Speaker": "Student",
      "Text": "大丈夫！"
    },
    {
      "Id": 200600460,
      "Speaker": "Student",
      "Text": "また海に行って"
    },
    {
      "Id": 200600470,
      "Speaker": "Student",
      "Text": "拾えばいいから！"
    },
    {
      "Id": 200600480,
      "Speaker": "Student",
      "Text": "そのときはまた"
    },
    {
      "Id": 200600490,
      "Speaker": "Student",
      "Text": "先生も一緒に、行ってくれるよね？"
    },
    {
      "Id": 200600500,
      "Speaker": "Player",
      "Text": "もちろん！"
    }
  ],
  "DialogKR": [
    {
      "Id": 200600010,
      "Speaker": "Student",
      "Text": "선"
    },
    {
      "Id": 200600020,
      "Speaker": "Student",
      "Text": "선새ㅇ"
    },
    {
      "Id": 200600030,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200600040,
      "Speaker": "Player",
      "Text": "파라솔이랑 돗자리 펴 놨어~"
    },
    {
      "Id": 200600050,
      "Speaker": "Student",
      "Text": "가ㄹ"
    },
    {
      "Id": 200600060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "이부키 갈래!"
    },
    {
      "Id": 200600070,
      "Speaker": "Student",
      "Text": "선생님 선생님"
    },
    {
      "Id": 200600080,
      "Speaker": "Student",
      "Text": "이부키, 완전히 회복했어!"
    },
    {
      "Id": 200600090,
      "Speaker": "Student",
      "Text": "선생님은 어때?"
    },
    {
      "Id": 200600100,
      "Speaker": "Player",
      "Text": "푹 쉬고 잘 회복했지!"
    },
    {
      "Id": 200600110,
      "Speaker": "Student",
      "Text": "그럼 오늘 이부키의 수업이 있는데"
    },
    {
      "Id": 200600120,
      "Speaker": "Student",
      "Text": "와ㅇ"
    },
    {
      "Id": 200600130,
      "Speaker": "Student",
      "Text": "와 줄 수 있어?"
    },
    {
      "Id": 200600140,
      "Speaker": "Player",
      "Text": "물론이죠!"
    },
    {
      "Id": 200600150,
      "Speaker": "Student",
      "Text": "헤헤"
    },
    {
      "Id": 200600160,
      "Speaker": "Student",
      "Text": "그럼 30분 뒤에"
    },
    {
      "Id": 200600170,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "해변 바위 지대에서 봐!"
    },
    {
      "Id": 200600180,
      "Speaker": "Student",
      "Text": "죄송합니다 선생님……."
    },
    {
      "Id": 200600190,
      "Speaker": "Student",
      "Text": "무거웠었지……?"
    },
    {
      "Id": 200600200,
      "Speaker": "Player",
      "Text": "아뇨."
    },
    {
      "Id": 200600210,
      "Speaker": "Player",
      "Text": "하루 종일도 업을 수 있어."
    },
    {
      "Id": 200600220,
      "Speaker": "Student",
      "Text": "헤헤"
    },
    {
      "Id": 200600230,
      "Speaker": "Student",
      "Text": "고맙습니다 선생님……!"
    },
    {
      "Id": 200600240,
      "Speaker": "Student",
      "Text": "선생님!"
    },
    {
      "Id": 200600250,
      "Speaker": "Student",
      "Text": "해변 쪽에 새로 상점가가 생겨났어!"
    },
    {
      "Id": 200600260,
      "Speaker": "Player",
      "Text": "응? 정말?!"
    },
    {
      "Id": 200600270,
      "Speaker": "Student",
      "Text": "그러니까 가ㅈ"
    },
    {
      "Id": 200600280,
      "Speaker": "Student",
      "Text": "같이 구경 가자!"
    },
    {
      "Id": 200600290,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "이부키의 부름이라면 기꺼이……!"
    },
    {
      "Id": 200600300,
      "Speaker": "Student",
      "Text": "선생님!"
    },
    {
      "Id": 200600310,
      "Speaker": "Student",
      "Text": "이부키 말이지"
    },
    {
      "Id": 200600320,
      "Speaker": "Student",
      "Text": "그림 그리는 새로운 방법을 찾아냈어!"
    },
    {
      "Id": 200600330,
      "Speaker": "Player",
      "Text": "오, 어떤 건데?"
    },
    {
      "Id": 200600340,
      "Speaker": "Student",
      "Text": "그건 말이지"
    },
    {
      "Id": 200600350,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200600360,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "직접 만나서 보여줄게!"
    },
    {
      "Id": 200600370,
      "Speaker": "Student",
      "Text": "선생님 선생님"
    },
    {
      "Id": 200600380,
      "Speaker": "Student",
      "Text": "샬레에는 잘 돌아가셨나요?"
    },
    {
      "Id": 200600390,
      "Speaker": "Player",
      "Text": "물론, 잘 들어갔지!"
    },
    {
      "Id": 200600400,
      "Speaker": "Player",
      "Text": "이부키는 그림 잘 완성했어?"
    },
    {
      "Id": 200600410,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 200600420,
      "Speaker": "Student",
      "Text": "사실 조각 수가 부족해서"
    },
    {
      "Id": 200600430,
      "Speaker": "Student",
      "Text": "절반밖에 못 그렸어!"
    },
    {
      "Id": 200600440,
      "Speaker": "Player",
      "Text": "앗……."
    },
    {
      "Id": 200600450,
      "Speaker": "Student",
      "Text": "이부키는 괜찮아!"
    },
    {
      "Id": 200600460,
      "Speaker": "Student",
      "Text": "다음에 바닷가에 가서"
    },
    {
      "Id": 200600470,
      "Speaker": "Student",
      "Text": "또 주워 오면 되니까!"
    },
    {
      "Id": 200600480,
      "Speaker": "Student",
      "Text": "그때도 어제처럼"
    },
    {
      "Id": 200600490,
      "Speaker": "Student",
      "Text": "또 같이 가 줄 거지?"
    },
    {
      "Id": 200600500,
      "Speaker": "Player",
      "Text": "물론이지!"
    }
  ],
  "DialogEN": [
    {
      "Id": 200600010,
      "Speaker": "Student",
      "Text": "Sen"
    },
    {
      "Id": 200600020,
      "Speaker": "Student",
      "Text": "Sens"
    },
    {
      "Id": 200600030,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 200600040,
      "Speaker": "Player",
      "Text": "I have a parasol and picnic mat!"
    },
    {
      "Id": 200600050,
      "Speaker": "Student",
      "Text": "gooo"
    },
    {
      "Id": 200600060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Ibuki wanna go!"
    },
    {
      "Id": 200600070,
      "Speaker": "Student",
      "Text": "Sensei Sensei"
    },
    {
      "Id": 200600080,
      "Speaker": "Student",
      "Text": "Ibuki is completely better!"
    },
    {
      "Id": 200600090,
      "Speaker": "Student",
      "Text": "How about you, Sensei?"
    },
    {
      "Id": 200600100,
      "Speaker": "Player",
      "Text": "I'm raring to go!"
    },
    {
      "Id": 200600110,
      "Speaker": "Student",
      "Text": "Ibuki has a class today"
    },
    {
      "Id": 200600120,
      "Speaker": "Student",
      "Text": "Ca"
    },
    {
      "Id": 200600130,
      "Speaker": "Student",
      "Text": "Can you come?"
    },
    {
      "Id": 200600140,
      "Speaker": "Player",
      "Text": "Of course!"
    },
    {
      "Id": 200600150,
      "Speaker": "Student",
      "Text": "Heehee"
    },
    {
      "Id": 200600160,
      "Speaker": "Student",
      "Text": "I'll see you at the rocky place on the beach"
    },
    {
      "Id": 200600170,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "in 30 min!"
    },
    {
      "Id": 200600180,
      "Speaker": "Student",
      "Text": "Sorry, Sensei..."
    },
    {
      "Id": 200600190,
      "Speaker": "Student",
      "Text": "Was I heavy...?"
    },
    {
      "Id": 200600200,
      "Speaker": "Player",
      "Text": "Not at all."
    },
    {
      "Id": 200600210,
      "Speaker": "Player",
      "Text": "I could carry you all day long."
    },
    {
      "Id": 200600220,
      "Speaker": "Student",
      "Text": "Heehee"
    },
    {
      "Id": 200600230,
      "Speaker": "Student",
      "Text": "Thank you, Sensei...!"
    },
    {
      "Id": 200600240,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 200600250,
      "Speaker": "Student",
      "Text": "There's a new shopping street near the beach!"
    },
    {
      "Id": 200600260,
      "Speaker": "Player",
      "Text": "What? Really?!"
    },
    {
      "Id": 200600270,
      "Speaker": "Student",
      "Text": "Ibuki wanna go"
    },
    {
      "Id": 200600280,
      "Speaker": "Student",
      "Text": "with Sensei!"
    },
    {
      "Id": 200600290,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "I will always answer your call, Ibuki!"
    },
    {
      "Id": 200600300,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 200600310,
      "Speaker": "Student",
      "Text": "Ibuki"
    },
    {
      "Id": 200600320,
      "Speaker": "Student",
      "Text": "discovered a new way to draw!"
    },
    {
      "Id": 200600330,
      "Speaker": "Player",
      "Text": "Huh, what is it?"
    },
    {
      "Id": 200600340,
      "Speaker": "Student",
      "Text": "It is"
    },
    {
      "Id": 200600350,
      "Speaker": "Student",
      "Text": "um"
    },
    {
      "Id": 200600360,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Ibuki will show you!"
    },
    {
      "Id": 200600370,
      "Speaker": "Student",
      "Text": "Sensei Sensei"
    },
    {
      "Id": 200600380,
      "Speaker": "Student",
      "Text": "Didja get back okay?"
    },
    {
      "Id": 200600390,
      "Speaker": "Player",
      "Text": "I did! What about your drawing?"
    },
    {
      "Id": 200600400,
      "Speaker": "Player",
      "Text": "Did you finish your drawing, Ibuki?"
    },
    {
      "Id": 200600410,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 200600420,
      "Speaker": "Student",
      "Text": "Ibuki ran outta pieces"
    },
    {
      "Id": 200600430,
      "Speaker": "Student",
      "Text": "so Ibuki only got half done!"
    },
    {
      "Id": 200600440,
      "Speaker": "Player",
      "Text": "Ah..."
    },
    {
      "Id": 200600450,
      "Speaker": "Student",
      "Text": "Ibuki is fine!"
    },
    {
      "Id": 200600460,
      "Speaker": "Student",
      "Text": "Ibuki can go to the beach again"
    },
    {
      "Id": 200600470,
      "Speaker": "Student",
      "Text": "and get more!"
    },
    {
      "Id": 200600480,
      "Speaker": "Student",
      "Text": "And Sensei will come too, right?"
    },
    {
      "Id": 200600490,
      "Speaker": "Student",
      "Text": "Just like yesterday, right?"
    },
    {
      "Id": 200600500,
      "Speaker": "Player",
      "Text": "Of course!"
    }
  ],
  "DialogTH": [
    {
