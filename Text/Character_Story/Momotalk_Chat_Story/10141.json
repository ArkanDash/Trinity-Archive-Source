{
  "CharacterId": 10141,
  "DialogJP": [
    {
      "Id": 101410010,
      "Speaker": "Student",
      "Text": "先生、あの、一つご相談したいことが……"
    },
    {
      "Id": 101410020,
      "Speaker": "Student",
      "Text": "その、なんと言いますか……"
    },
    {
      "Id": 101410030,
      "Speaker": "Student",
      "Text": "ドレスって、私なんかが着てもいいのでしょうか……？"
    },
    {
      "Id": 101410040,
      "Speaker": "Student",
      "Text": "いえすみません気にしないでください"
    },
    {
      "Id": 101410050,
      "Speaker": "Student",
      "Text": "どうしても、自信が持てなくて……"
    },
    {
      "Id": 101410060,
      "Speaker": "Player",
      "Text": "大丈夫。ハルカが着たいものを着ていいんだよ"
    },
    {
      "Id": 101410070,
      "Speaker": "Student",
      "Text": "そ"
    },
    {
      "Id": 101410080,
      "Speaker": "Student",
      "Text": "そうなんですか……？"
    },
    {
      "Id": 101410090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "あ、ありがとうございます……先生……"
    },
    {
      "Id": 101410100,
      "Speaker": "Student",
      "Text": "さっきの傷、本当に大丈夫ですか……？"
    },
    {
      "Id": 101410110,
      "Speaker": "Student",
      "Text": "あれから酷くなったり、していませんか？"
    },
    {
      "Id": 101410120,
      "Speaker": "Player",
      "Text": "大丈夫！気にしないで！"
    },
    {
      "Id": 101410130,
      "Speaker": "Player",
      "Text": "ちょっとかすっただけだから！"
    },
    {
      "Id": 101410140,
      "Speaker": "Student",
      "Text": "すみません……"
    },
    {
      "Id": 101410150,
      "Speaker": "Student",
      "Text": "警備員として、真っ先に止めるべきだったのに……"
    },
    {
      "Id": 101410160,
      "Speaker": "Student",
      "Text": "また同じ仕事をすることになったら"
    },
    {
      "Id": 101410170,
      "Speaker": "Student",
      "Text": "今度こそ絶対に、止めてみせます……！"
    },
    {
      "Id": 101410180,
      "Speaker": "Student",
      "Text": "先生、ハルカです"
    },
    {
      "Id": 101410190,
      "Speaker": "Student",
      "Text": "本日当番でお邪魔する予定ですが……"
    },
    {
      "Id": 101410200,
      "Speaker": "Student",
      "Text": "そ"
    },
    {
      "Id": 101410210,
      "Speaker": "Student",
      "Text": "その……"
    },
    {
      "Id": 101410220,
      "Speaker": "Student",
      "Text": "私の顔を見て、先日の傷が痛むようなことがあればと思うと……"
    },
    {
      "Id": 101410230,
      "Speaker": "Student",
      "Text": "行かないほうが……よいかと……思っているのですが……"
    },
    {
      "Id": 101410240,
      "Speaker": "Player",
      "Text": "むしろ、来てくれたら嬉しいな"
    },
    {
      "Id": 101410250,
      "Speaker": "Player",
      "Text": "ハルカの顔も見たいし"
    },
    {
      "Id": 101410260,
      "Speaker": "Student",
      "Text": "ち"
    },
    {
      "Id": 101410270,
      "Speaker": "Student",
      "Text": "ちあちにあふ！"
    },
    {
      "Id": 101410280,
      "Speaker": "Student",
      "Text": "い"
    },
    {
      "Id": 101410290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "いま行きます！"
    },
    {
      "Id": 101410300,
      "Speaker": "Student",
      "Text": "か"
    },
    {
      "Id": 101410310,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 101410320,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 101410330,
      "Speaker": "Student",
      "Text": "すみません"
    },
    {
      "Id": 101410340,
      "Speaker": "Student",
      "Text": "今のは入力ミスでした"
    },
    {
      "Id": 101410350,
      "Speaker": "Student",
      "Text": "おかに"
    },
    {
      "Id": 101410360,
      "Speaker": "Student",
      "Text": "お気になさらないでください"
    },
    {
      "Id": 101410370,
      "Speaker": "Student",
      "Text": "すみませんすみませんすみません……！"
    },
    {
      "Id": 101410380,
      "Speaker": "Player",
      "Text": "ハルカ、今どこ？"
    },
    {
      "Id": 101410390,
      "Speaker": "Student",
      "Text": "え？"
    },
    {
      "Id": 101410400,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "その、シャーレの前ですが……"
    },
    {
      "Id": 101410410,
      "Speaker": "Student",
      "Text": "先生、ハルカです"
    },
    {
      "Id": 101410420,
      "Speaker": "Student",
      "Text": "その、あまりご興味ない話かもしれませんが"
    },
    {
      "Id": 101410430,
      "Speaker": "Student",
      "Text": "もしよろしければ、一緒に美術館に行きませんか？"
    },
    {
      "Id": 101410440,
      "Speaker": "Player",
      "Text": "すぐ行こう"
