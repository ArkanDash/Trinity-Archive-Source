{
  "CharacterId": 10042,
  "DialogJP": [
    {
      "Id": 100420010,
      "Speaker": "Student",
      "Text": "先生、いる？"
    },
    {
      "Id": 100420020,
      "Speaker": "Student",
      "Text": "今大丈夫？このトーク届いてる？"
    },
    {
      "Id": 100420030,
      "Speaker": "Player",
      "Text": "アツコ？"
    },
    {
      "Id": 100420040,
      "Speaker": "Student",
      "Text": "うん、そうだよ。おはよう"
    },
    {
      "Id": 100420050,
      "Speaker": "Player",
      "Text": "おはよう"
    },
    {
      "Id": 100420060,
      "Speaker": "Player",
      "Text": "もうそろそろ夜だけど、おはよう"
    },
    {
      "Id": 100420070,
      "Speaker": "Student",
      "Text": "私たち、今あっちこっちを転々としてて"
    },
    {
      "Id": 100420080,
      "Speaker": "Student",
      "Text": "一つの場所に長居しちゃいけないから"
    },
    {
      "Id": 100420090,
      "Speaker": "Student",
      "Text": "それと、みんなバラバラでいる事が多くて"
    },
    {
      "Id": 100420100,
      "Speaker": "Student",
      "Text": "一人でいると、退屈なの"
    },
    {
      "Id": 100420110,
      "Speaker": "Student",
      "Text": "だから先生に会うには"
    },
    {
      "Id": 100420120,
      "Speaker": "Student",
      "Text": "先生がこっちに来てくれないと難しい"
    },
    {
      "Id": 100420130,
      "Speaker": "Player",
      "Text": "要するに、退屈だから会おうって捉え方で良い……？"
    },
    {
      "Id": 100420140,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 100420150,
      "Speaker": "Student",
      "Text": "その通り"
    },
    {
      "Id": 100420160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "じゃあ、後で"
    },
    {
      "Id": 100420170,
      "Speaker": "Student",
      "Text": "先生、こんばんは"
    },
    {
      "Id": 100420180,
      "Speaker": "Student",
      "Text": "今からここを離れることになったよ"
    },
    {
      "Id": 100420190,
      "Speaker": "Student",
      "Text": "じゃあ、また。場所が変わったら連絡する"
    },
    {
      "Id": 100420200,
      "Speaker": "Student",
      "Text": "先生、おはよう"
    },
    {
      "Id": 100420210,
      "Speaker": "Student",
      "Text": "面白い場所を見つけたの"
    },
    {
      "Id": 100420220,
      "Speaker": "Student",
      "Text": "時間があったら、遊びに来ない？"
    },
    {
      "Id": 100420230,
      "Speaker": "Player",
      "Text": "どんな場所？"
    },
    {
      "Id": 100420240,
      "Speaker": "Student",
      "Text": "学校ごっこができるところ"
    },
    {
      "Id": 100420250,
      "Speaker": "Student",
      "Text": "きっと、楽しいと思う"
    },
    {
      "Id": 100420260,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "うん、分かった。楽しみにしてるね"
    },
    {
      "Id": 100420270,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100420280,
      "Speaker": "Student",
      "Text": "私の趣味、なんだけど"
    },
    {
      "Id": 100420290,
      "Speaker": "Student",
      "Text": "私、花が好き"
    },
    {
      "Id": 100420300,
      "Speaker": "Player",
      "Text": "花……花を育てること？"
    },
    {
      "Id": 100420310,
      "Speaker": "Student",
      "Text": "うん。今度、園芸部でも作ってみようかな"
    },
    {
      "Id": 100420320,
      "Speaker": "Student",
      "Text": "部員は、私ひとりしかいないけど"
    },
    {
      "Id": 100420330,
      "Speaker": "Student",
      "Text": "じゃあ、おやすみ"
    },
    {
      "Id": 100420340,
      "Speaker": "Student",
      "Text": "先生、おはよう"
    },
    {
      "Id": 100420350,
      "Speaker": "Student",
      "Text": "私、決めた"
    },
    {
      "Id": 100420360,
      "Speaker": "Student",
      "Text": "お花を、趣味にしようと思う"
    },
    {
      "Id": 100420370,
      "Speaker": "Player",
      "Text": "なるほど。生け花とか？"
    },
    {
      "Id": 100420380,
      "Speaker": "Player",
      "Text": "良いんじゃないかな"
    },
    {
      "Id": 100420390,
      "Speaker": "Student",
      "Text": "応援よろしくね、先生"
    },
    {
      "Id": 100420400,
      "Speaker": "Player",
      "Text": "うん。アツコは好きな花とかある？"
    },
    {
      "Id": 100420410,
      "Speaker": "Student",
      "Text": "……好きな花？"
    },
    {
      "Id": 100420420,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 100420430,
      "Speaker": "Student",
      "Text": "私、花なら何でも好き"
    },
    {
      "Id": 100420440,
      "Speaker": "Student",
      "Text": "アジサイも好きだし"
    },
    {
      "Id": 100420450,
      "Speaker": "Student",
      "Text": "薔薇も好き"
    },
    {
      "Id": 100420460,
      "Speaker": "Student",
      "Text": "なんで？"
    },
    {
      "Id": 100420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "ううん、ありがとう"
    },
    {
      "Id": 100420480,
      "Speaker": "Student",
      "Text": "先生、今日はお疲れ様"
    },
    {
      "Id": 100420490,
      "Speaker": "Student",
      "Text": "おかげで、たくさん植え替えることができた"
    },
    {
      "Id": 100420500,
      "Speaker": "Player",
      "Text": "元気に育つといいね"
    },
    {
      "Id": 100420510,
      "Speaker": "Student",
      "Text": "うん。そうだね"
    },
    {
      "Id": 100420520,
      "Speaker": "Student",
      "Text": "それと、ありがとう"
    },
    {
      "Id": 100420530,
      "Speaker": "Student",
      "Text": "みんなには内緒で、大切にするね"
    },
    {
      "Id": 100420540,
      "Speaker": "Student",
      "Text": "こんにちは、先生"
    },
    {
      "Id": 100420550,
      "Speaker": "Student",
      "Text": "昨夜、大雨が降った"
    },
    {
      "Id": 100420560,
      "Speaker": "Student",
      "Text": "花壇は大丈夫かな……"
    },
    {
      "Id": 100420570,
      "Speaker": "Student",
      "Text": "確認しに行きたいけど、一人じゃ不安"
    },
    {
      "Id": 100420580,
      "Speaker": "Student",
      "Text": "一緒に、行ってくれる？"
    },
    {
      "Id": 100420590,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "もちろん、喜んで"
    }
  ],
  "DialogKR": [
    {
      "Id": 100420010,
      "Speaker": "Student",
      "Text": "선생님-"
    },
    {
      "Id": 100420020,
      "Speaker": "Student",
      "Text": "선생님 있어?"
    },
    {
      "Id": 100420030,
      "Speaker": "Player",
      "Text": "아츠코?"
    },
    {
      "Id": 100420040,
      "Speaker": "Student",
      "Text": "응. 맞아. 좋은 아침."
    },
    {
      "Id": 100420050,
      "Speaker": "Player",
      "Text": "좋은 아침."
    },
    {
      "Id": 100420060,
      "Speaker": "Player",
      "Text": "지금은 아침은 아니지만."
    },
    {
      "Id": 100420070,
      "Speaker": "Student",
      "Text": "선생님도 알겠지만 우리는 지금 여기저기를 떠돌아다니고 있어."
    },
    {
      "Id": 100420080,
      "Speaker": "Student",
      "Text": "한곳에 오래 있으면 안 되니까."
    },
    {
      "Id": 100420090,
      "Speaker": "Student",
      "Text": "게다가 다들 제각각 흩어져 있는 시간도 많아서"
    },
    {
      "Id": 100420100,
      "Speaker": "Student",
      "Text": "혼자 있으면 심심해."
    },
    {
      "Id": 100420110,
      "Speaker": "Student",
      "Text": "그러니까 선생님을 만나려면"
    },
    {
      "Id": 100420120,
      "Speaker": "Student",
      "Text": "선생님이 여기로 와야 해."
    },
    {
      "Id": 100420130,
      "Speaker": "Player",
      "Text": "요컨대, 심심하니까 만나자는 거지……?"
    },
    {
      "Id": 100420140,
      "Speaker": "Student",
      "Text": "응."
    },
    {
      "Id": 100420150,
      "Speaker": "Student",
      "Text": "정확해."
    },
    {
      "Id": 100420160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "그럼 조금 이따가 봐."
    },
    {
      "Id": 100420170,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100420180,
      "Speaker": "Student",
      "Text": "여기를 떠나기로 했어."
    },
    {
      "Id": 100420190,
      "Speaker": "Student",
      "Text": "그럼 다음에 봐. 위치가 바뀌면 또 연락할게."
    },
    {
      "Id": 100420200,
      "Speaker": "Student",
      "Text": "선생님. 좋은 아침."
    },
    {
      "Id": 100420210,
      "Speaker": "Student",
      "Text": "재미있는 곳을 발견했어."
    },
    {
      "Id": 100420220,
      "Speaker": "Student",
      "Text": "시간이 되면 놀러 올래?"
    },
    {
      "Id": 100420230,
      "Speaker": "Player",
      "Text": "응? 어떤 곳이길래?"
    },
    {
      "Id": 100420240,
      "Speaker": "Student",
      "Text": "응. 학교 놀이를 할 수 있는 곳."
    },
    {
      "Id": 100420250,
      "Speaker": "Student",
      "Text": "재미있을 거 같아. 분명."
    },
    {
      "Id": 100420260,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "아아. 알겠어."
    },
    {
      "Id": 100420270,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100420280,
      "Speaker": "Student",
      "Text": "내 취미 물었었잖아?"
    },
    {
      "Id": 100420290,
      "Speaker": "Student",
      "Text": "나는 꽃을 좋아해."
    },
    {
      "Id": 100420300,
      "Speaker": "Player",
      "Text": "꽃이라……. 꽃을 기르는 거?"
    },
    {
      "Id": 100420310,
      "Speaker": "Student",
      "Text": "응. 나중에 화훼 동아리라도 만들어볼까?"
    },
    {
      "Id": 100420320,
      "Speaker": "Student",
      "Text": "부원은 나 혼자겠지만."
    },
    {
      "Id": 100420330,
      "Speaker": "Student",
      "Text": "그럼 잘 자."
    },
    {
      "Id": 100420340,
      "Speaker": "Student",
      "Text": "선생님. 좋은 아침."
    },
    {
      "Id": 100420350,
      "Speaker": "Student",
      "Text": "나 결심했어."
    },
    {
      "Id": 100420360,
      "Speaker": "Student",
      "Text": "꽃과 관계된 취미를 해볼까 해."
    },
    {
      "Id": 100420370,
      "Speaker": "Player",
      "Text": "꽃꽂이 같은 건가?"
    },
    {
      "Id": 100420380,
      "Speaker": "Player",
      "Text": "동아리 활동 시작인가……."
    },
    {
      "Id": 100420390,
      "Speaker": "Student",
      "Text": "행운을 빌어줘. 선생님."
    },
    {
      "Id": 100420400,
      "Speaker": "Player",
      "Text": "아츠코가 좋아하는 꽃이 뭐야?"
    },
    {
      "Id": 100420410,
      "Speaker": "Student",
      "Text": "응?"
    },
    {
      "Id": 100420420,
      "Speaker": "Student",
      "Text": "좋아하는 꽃?"
    },
    {
      "Id": 100420430,
      "Speaker": "Student",
      "Text": "응. 나 꽃이라면 뭐든 좋아하지만"
    },
    {
      "Id": 100420440,
      "Speaker": "Student",
      "Text": "수국도 좋고"
    },
    {
      "Id": 100420450,
      "Speaker": "Student",
      "Text": "장미도 좋아해"
    },
    {
      "Id": 100420460,
      "Speaker": "Student",
      "Text": "왜?"
    },
    {
      "Id": 100420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "알겠어."
    },
    {
      "Id": 100420480,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100420490,
      "Speaker": "Student",
      "Text": "오늘 수고했어."
    },
    {
      "Id": 100420500,
      "Speaker": "Player",
      "Text": "잘 자랐으면 좋겠네."
    },
    {
      "Id": 100420510,
      "Speaker": "Student",
      "Text": "응. 그러게."
    },
    {
      "Id": 100420520,
      "Speaker": "Student",
      "Text": "그리고 고마워."
    },
    {
      "Id": 100420530,
      "Speaker": "Student",
      "Text": "아무도 모르게 간직할 거니까."
    },
    {
      "Id": 100420540,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100420550,
      "Speaker": "Student",
      "Text": "어젯밤에 폭우가 몰아쳤어."
    },
    {
      "Id": 100420560,
      "Speaker": "Student",
      "Text": "화단이 괜찮을까?"
    },
    {
      "Id": 100420570,
      "Speaker": "Student",
      "Text": "확인하러 가고 싶은데 혼자서 가고 싶지가 않아."
    },
    {
      "Id": 100420580,
      "Speaker": "Student",
      "Text": "같이 가주지 않을래?"
    },
    {
      "Id": 100420590,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "응. 알겠어."
    }
  ],
  "DialogEN": [
    {
      "Id": 100420010,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 100420020,
      "Speaker": "Student",
      "Text": "Sensei, are you there?"
    },
    {
      "Id": 100420030,
      "Speaker": "Player",
      "Text": "Atsuko?"
    },
    {
      "Id": 100420040,
      "Speaker": "Student",
      "Text": "Yes. Good morning."
    },
    {
      "Id": 100420050,
      "Speaker": "Player",
      "Text": "Good morning."
    },
    {
      "Id": 100420060,
      "Speaker": "Player",
      "Text": "It's not morning anymore though."
    },
    {
      "Id": 100420070,
      "Speaker": "Student",
      "Text": "As you know, we're wandering around all over the place now."
    },
    {
      "Id": 100420080,
      "Speaker": "Student",
      "Text": "We can't stay in one place for long."
    },
    {
      "Id": 100420090,
      "Speaker": "Student",
      "Text": "Not only that, but we spend a lot of time away from each other."
    },
    {
      "Id": 100420100,
      "Speaker": "Student",
      "Text": "It's boring to be alone."
    },
    {
      "Id": 100420110,
      "Speaker": "Student",
      "Text": "So, for us to meet,"
    },
    {
      "Id": 100420120,
      "Speaker": "Student",
      "Text": "you have to come here."
    },
    {
      "Id": 100420130,
      "Speaker": "Player",
      "Text": "You want me to come see you because you're bored...?"
    },
    {
      "Id": 100420140,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 100420150,
      "Speaker": "Student",
      "Text": "Exactly."
    },
    {
      "Id": 100420160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'll see you soon."
    },
    {
      "Id": 100420170,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100420180,
      "Speaker": "Student",
      "Text": "I've decided to leave."
    },
    {
      "Id": 100420190,
      "Speaker": "Student",
      "Text": "I'll see you later. I'll contact you if the location changes."
    },
    {
      "Id": 100420200,
      "Speaker": "Student",
      "Text": "Sensei, good morning."
    },
    {
      "Id": 100420210,
      "Speaker": "Student",
      "Text": "I found an interesting place."
    },
    {
      "Id": 100420220,
      "Speaker": "Student",
      "Text": "Stop by if you have time?"
    },
    {
      "Id": 100420230,
      "Speaker": "Player",
      "Text": "Huh? What kind of a place?"
    },
    {
      "Id": 100420240,
      "Speaker": "Student",
      "Text": "It's a place where we can play school."
    },
    {
      "Id": 100420250,
      "Speaker": "Student",
      "Text": "I think it'll be fun. I guarantee it."
    },
    {
      "Id": 100420260,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "Oh. Okay."
    },
    {
      "Id": 100420270,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100420280,
      "Speaker": "Student",
      "Text": "You asked me about hobbies, right?"
    },
    {
      "Id": 100420290,
      "Speaker": "Student",
      "Text": "I like flowers."
    },
    {
      "Id": 100420300,
      "Speaker": "Player",
      "Text": "You mean like...growing flowers?"
    },
    {
      "Id": 100420310,
      "Speaker": "Student",
      "Text": "Perhaps I can make a flower club one day."
    },
    {
      "Id": 100420320,
      "Speaker": "Student",
      "Text": "I'm sure I'll be the only member though."
    },
    {
      "Id": 100420330,
      "Speaker": "Student",
      "Text": "Okay. Good night."
    },
    {
      "Id": 100420340,
      "Speaker": "Student",
      "Text": "Sensei, good morning."
    },
    {
      "Id": 100420350,
      "Speaker": "Student",
      "Text": "I've made a decision."
    },
    {
      "Id": 100420360,
      "Speaker": "Student",
      "Text": "I'm gonna get a hobby related to flowers."
    },
    {
      "Id": 100420370,
      "Speaker": "Player",
      "Text": "Like flower arrangement?"
    },
    {
      "Id": 100420380,
      "Speaker": "Player",
      "Text": "Is this the start of a club activity?"
    },
    {
      "Id": 100420390,
      "Speaker": "Student",
      "Text": "Wish me good luck, Sensei."
    },
    {
      "Id": 100420400,
      "Speaker": "Player",
      "Text": "What's your favorite flower, Atsuko?"
    },
    {
      "Id": 100420410,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 100420420,
      "Speaker": "Student",
      "Text": "My favorite flower?"
    },
    {
      "Id": 100420430,
      "Speaker": "Student",
      "Text": "Well, I like all kinds, but..."
    },
    {
      "Id": 100420440,
      "Speaker": "Student",
      "Text": "I like hydrangeas"
    },
    {
      "Id": 100420450,
      "Speaker": "Student",
      "Text": "and roses."
    },
    {
      "Id": 100420460,
      "Speaker": "Student",
      "Text": "What?"
    },
    {
      "Id": 100420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "Okay."
    },
    {
      "Id": 100420480,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100420490,
      "Speaker": "Student",
      "Text": "Great work."
    },
    {
      "Id": 100420500,
      "Speaker": "Player",
      "Text": "I hope it grows okay."
    },
    {
      "Id": 100420510,
      "Speaker": "Student",
      "Text": "Yes, I know."
    },
    {
      "Id": 100420520,
      "Speaker": "Student",
      "Text": "And, thank you."
    },
    {
      "Id": 100420530,
      "Speaker": "Student",
      "Text": "I'll keep this as my little secret."
    },
    {
      "Id": 100420540,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100420550,
      "Speaker": "Student",
      "Text": "There was a rainstorm last night."
    },
    {
      "Id": 100420560,
      "Speaker": "Student",
      "Text": "Do you think the flower garden is okay?"
    },
    {
      "Id": 100420570,
      "Speaker": "Student",
      "Text": "I need to check, but I don't wanna go alone."
    },
    {
      "Id": 100420580,
      "Speaker": "Student",
      "Text": "Can you go with me?"
    },
    {
      "Id": 100420590,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "Yeah, okay."
    }
  ],
  "DialogTH": [
    {
      "Id": 100420010,
      "Speaker": "Student",
      "Text": "คุณครู..."
    },
    {
      "Id": 100420020,
      "Speaker": "Student",
      "Text": "อยู่รึเปล่า...?"
    },
    {
      "Id": 100420030,
      "Speaker": "Player",
      "Text": "อาสึโกะ...?"
    },
    {
      "Id": 100420040,
      "Speaker": "Student",
      "Text": "อื้อ ฉันเอง อรุณสวัสดิ์"
    },
    {
      "Id": 100420050,
      "Speaker": "Player",
      "Text": "อรุณสวัสดิ์นะ"
    },
    {
      "Id": 100420060,
      "Speaker": "Player",
      "Text": "ถึงไม่เช้าแล้ว\nแต่ก็อรุณสวัสดิ์นะ"
    },
    {
      "Id": 100420070,
      "Speaker": "Student",
      "Text": "คุณครูเองก็คงรู้แล้วว่าตอนนี้พวกเรา\nตระเวนไปที่ต่างๆ อยู่"
    },
    {
      "Id": 100420080,
      "Speaker": "Student",
      "Text": "ก็พวกเราอยู่ที่เดิมนานๆ ไม่ได้นี่นะ"
    },
    {
      "Id": 100420090,
      "Speaker": "Student",
      "Text": "อีกอย่างตอนนี้ทุกคนก็กระจายตัว\nแยกกันไปหมด"
    },
    {
      "Id": 100420100,
      "Speaker": "Student",
      "Text": "ฉันอยู่คนเดียวเลยรู้สึกเบื่อๆ น่ะ"
    },
    {
      "Id": 100420110,
      "Speaker": "Student",
      "Text": "เพราะงั้นถ้าจะเจอคุณครูละก็..."
    },
    {
      "Id": 100420120,
      "Speaker": "Student",
      "Text": "คงต้องให้คุณครูเป็นฝ่ายมาที่นี่"
    },
    {
      "Id": 100420130,
      "Speaker": "Player",
      "Text": "สรุปคือชวนครูไปหาเพราะเบื่อ\nที่อยู่คนเดียวสินะ...?"
    },
    {
      "Id": 100420140,
      "Speaker": "Student",
      "Text": "อื้อ"
    },
    {
      "Id": 100420150,
      "Speaker": "Student",
      "Text": "ใช่แล้ว"
    },
    {
      "Id": 100420160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ถ้างั้นเดี๋ยวเจอกัน"
    },
    {
      "Id": 100420170,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100420180,
      "Speaker": "Student",
      "Text": "พวกเราจะไปจากที่นี่แล้ว"
    },
    {
      "Id": 100420190,
      "Speaker": "Student",
      "Text": "ไว้เจอกันใหม่นะถ้าเปลี่ยนพิกัดที่อยู่อีก\nจะติดต่อไปใหม่"
    },
    {
      "Id": 100420200,
      "Speaker": "Student",
      "Text": "อรุณสวัสดิ์ คุณครู"
    },
    {
      "Id": 100420210,
      "Speaker": "Student",
      "Text": "ฉันเจอสถานที่ที่น่าสนใจด้วยล่ะ"
    },
    {
      "Id": 100420220,
      "Speaker": "Student",
      "Text": "ถ้ามีเวลาอยากแวะมาเที่ยวหน่อยมั้ย?"
    },
    {
      "Id": 100420230,
      "Speaker": "Player",
      "Text": "หืม? ที่แบบไหนกันนะ?"
    },
    {
      "Id": 100420240,
      "Speaker": "Student",
      "Text": "อืม สถานที่ที่เล่นสนุกได้เหมือนที่โรงเรียน"
    },
    {
      "Id": 100420250,
      "Speaker": "Student",
      "Text": "ดูน่าสนุกมากเลยนะ"
    },
    {
      "Id": 100420260,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "อื้อ เข้าใจแล้ว"
    },
    {
      "Id": 100420270,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100420280,
      "Speaker": "Student",
      "Text": "คุณครูเคยถามถึงงานอดิเรกฉันใช่มั้ย?"
    },
    {
      "Id": 100420290,
      "Speaker": "Student",
      "Text": "ฉันชอบดอกไม้น่ะ"
    },
    {
      "Id": 100420300,
      "Speaker": "Player",
      "Text": "ดอกไม้เหรอ…\nหมายถึงปลูกต้นไม้งั้นเหรอ?"
    },
    {
      "Id": 100420310,
      "Speaker": "Student",
      "Text": "อื้อ ไว้ตั้งชมรมจัดดอกไม้\nขึ้นมาดีมั้ย?"
    },
    {
      "Id": 100420320,
      "Speaker": "Student",
      "Text": "ถึงสมาชิกอาจจะมีแค่ฉันคนเดียวก็เถอะ"
    },
    {
      "Id": 100420330,
      "Speaker": "Student",
      "Text": "ถ้างั้นฝันดีนะ"
    },
    {
      "Id": 100420340,
      "Speaker": "Student",
      "Text": "อรุณสวัสดิ์ คุณครู"
    },
    {
      "Id": 100420350,
      "Speaker": "Student",
      "Text": "ฉันตัดสินใจแล้วล่ะ"
    },
    {
      "Id": 100420360,
      "Speaker": "Student",
      "Text": "ฉันจะลองหางานอดิเรกที่เกี่ยวกับ\nดอกไม้ดู"
    },
    {
      "Id": 100420370,
      "Speaker": "Player",
      "Text": "อย่างพวกจัดดอกไม้เหรอ?"
    },
    {
      "Id": 100420380,
      "Speaker": "Player",
      "Text": "จะเริ่มทำกิจกรรมชมรมแล้วเหรอ...?"
    },
    {
      "Id": 100420390,
      "Speaker": "Student",
      "Text": "อวยพรให้ฉันด้วยนะ คุณครู"
    },
    {
      "Id": 100420400,
      "Speaker": "Player",
      "Text": "อาสึโกะชอบดอกไม้อะไรเหรอ?"
    },
    {
      "Id": 100420410,
      "Speaker": "Student",
      "Text": "หืม?"
    },
    {
      "Id": 100420420,
      "Speaker": "Student",
      "Text": "ดอกไม้ที่ชอบเหรอ?"
    },
    {
      "Id": 100420430,
      "Speaker": "Student",
      "Text": "อืม ถ้าเป็นดอกไม้ก็ชอบทั้งหมดนั่นแหละ"
    },
    {
      "Id": 100420440,
      "Speaker": "Student",
      "Text": "ดอกไฮเดรนเยียก็ชอบ"
    },
    {
      "Id": 100420450,
      "Speaker": "Student",
      "Text": "แล้วก็ชอบดอกกุหลาบด้วย"
    },
    {
      "Id": 100420460,
      "Speaker": "Student",
      "Text": "ทำไมเหรอ?"
    },
    {
      "Id": 100420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "เข้าใจแล้วล่ะ"
    },
    {
      "Id": 100420480,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100420490,
      "Speaker": "Student",
      "Text": "วันนี้ขอบคุณมากนะ"
    },
    {
      "Id": 100420500,
      "Speaker": "Player",
      "Text": "ถ้าดอกไม้พวกนั้นโตขึ้นมา\nอย่างปลอดภัยก็คงดี"
    },
    {
      "Id": 100420510,
      "Speaker": "Student",
      "Text": "อืม นั่นสินะ"
    },
    {
      "Id": 100420520,
      "Speaker": "Student",
      "Text": "แล้วก็ขอบคุณนะ"
    },
    {
      "Id": 100420530,
      "Speaker": "Student",
      "Text": "ฉันจะเก็บเป็นความลับไว้อย่างดีเลย"
    },
    {
      "Id": 100420540,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100420550,
      "Speaker": "Student",
      "Text": "เมื่อคืนนี้ฝนตกหนักมาก"
    },
    {
      "Id": 100420560,
      "Speaker": "Student",
      "Text": "แปลงดอกไม้จะเป็นอะไรรึเปล่านะ?"
    },
    {
      "Id": 100420570,
      "Speaker": "Student",
      "Text": "ฉันอยากออกไปดูแต่ก็ไม่อยากไปคนเดียว..."
    },
    {
      "Id": 100420580,
      "Speaker": "Student",
      "Text": "คุณครูไปกับฉันหน่อยได้มั้ย?"
    },
    {
      "Id": 100420590,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "อื้อ ได้สิ"
    }
  ],
  "DialogTW": [
    {
      "Id": 100420010,
      "Speaker": "Student",
      "Text": "老師，在嗎？"
    },
    {
      "Id": 100420020,
      "Speaker": "Student",
      "Text": "現在沒事嗎？訊息有收到嗎？"
    },
    {
      "Id": 100420030,
      "Speaker": "Player",
      "Text": "敦子？"
    },
    {
      "Id": 100420040,
      "Speaker": "Student",
      "Text": "嗯，是的。早安"
    },
    {
      "Id": 100420050,
      "Speaker": "Player",
      "Text": "早安"
    },
    {
      "Id": 100420060,
      "Speaker": "Player",
      "Text": "雖然差不多快要晚上了，但早安"
    },
    {
      "Id": 100420070,
      "Speaker": "Student",
      "Text": "我們現在到處轉移陣地"
    },
    {
      "Id": 100420080,
      "Speaker": "Student",
      "Text": "因為不能在同個地方待太久"
    },
    {
      "Id": 100420090,
      "Speaker": "Student",
      "Text": "而且大家都很分散"
    },
    {
      "Id": 100420100,
      "Speaker": "Student",
      "Text": "一個人的話很無聊"
    },
    {
      "Id": 100420110,
      "Speaker": "Student",
      "Text": "所以，如果老師不來的話"
    },
    {
      "Id": 100420120,
      "Speaker": "Student",
      "Text": "就很難跟老師見面"
    },
    {
      "Id": 100420130,
      "Speaker": "Player",
      "Text": "簡單來說，是因為無聊，所以想跟我見面嗎……？"
    },
    {
      "Id": 100420140,
      "Speaker": "Student",
      "Text": "嗯"
    },
    {
      "Id": 100420150,
      "Speaker": "Student",
      "Text": "就是那樣"
    },
    {
      "Id": 100420160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "那麼，晚點見"
    },
    {
      "Id": 100420170,
      "Speaker": "Student",
      "Text": "老師，晚上好"
    },
    {
      "Id": 100420180,
      "Speaker": "Student",
      "Text": "我現在要離開這裡了"
    },
    {
      "Id": 100420190,
      "Speaker": "Student",
      "Text": "那麼，再見。換了地方後會再聯繫你的"
    },
    {
      "Id": 100420200,
      "Speaker": "Student",
      "Text": "老師，早安"
    },
    {
      "Id": 100420210,
      "Speaker": "Student",
      "Text": "我發現了一個有趣的地方"
    },
    {
      "Id": 100420220,
      "Speaker": "Student",
      "Text": "有空的話，要不要過來玩？"
    },
    {
      "Id": 100420230,
      "Speaker": "Player",
      "Text": "什麼樣的地方？"
    },
    {
      "Id": 100420240,
      "Speaker": "Student",
      "Text": "可以玩學校遊戲的地方"
    },
    {
      "Id": 100420250,
      "Speaker": "Student",
      "Text": "感覺一定很有趣"
    },
    {
      "Id": 100420260,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "嗯，我知道了。很期待唷"
    },
    {
      "Id": 100420270,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100420280,
      "Speaker": "Student",
      "Text": "你問我有什麼興趣"
    },
    {
      "Id": 100420290,
      "Speaker": "Student",
      "Text": "我，喜歡花"
    },
    {
      "Id": 100420300,
      "Speaker": "Player",
      "Text": "花啊……種花之類的嗎？"
    },
    {
      "Id": 100420310,
      "Speaker": "Student",
      "Text": "嗯。下次在園藝部試做看看吧"
    },
    {
      "Id": 100420320,
      "Speaker": "Student",
      "Text": "雖然部員只有我一個"
    },
    {
      "Id": 100420330,
      "Speaker": "Student",
      "Text": "那麼，晚安"
    },
    {
      "Id": 100420340,
      "Speaker": "Student",
      "Text": "老師，早安"
    },
    {
      "Id": 100420350,
      "Speaker": "Student",
      "Text": "我，決定了"
    },
    {
      "Id": 100420360,
      "Speaker": "Student",
      "Text": "我想要培養和花有關的興趣"
    },
    {
      "Id": 100420370,
      "Speaker": "Player",
      "Text": "原來如此。插花一類的嗎？"
    },
    {
      "Id": 100420380,
      "Speaker": "Player",
      "Text": "這不是挺好的嗎"
    },
    {
      "Id": 100420390,
      "Speaker": "Student",
      "Text": "為我加油吧，老師"
    },
    {
      "Id": 100420400,
      "Speaker": "Player",
      "Text": "嗯。敦子有喜歡的花嗎？"
    },
    {
      "Id": 100420410,
      "Speaker": "Student",
      "Text": "……喜歡的花？"
    },
    {
      "Id": 100420420,
      "Speaker": "Student",
      "Text": "唔嗯……"
    },
    {
      "Id": 100420430,
      "Speaker": "Student",
      "Text": "我，只要是花都喜歡"
    },
    {
      "Id": 100420440,
      "Speaker": "Student",
      "Text": "喜歡繡球花"
    },
    {
      "Id": 100420450,
      "Speaker": "Student",
      "Text": "也喜歡玫瑰"
    },
    {
      "Id": 100420460,
      "Speaker": "Student",
      "Text": "怎麼了？"
    },
    {
      "Id": 100420470,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "沒什麼，謝謝"
    },
    {
      "Id": 100420480,
      "Speaker": "Student",
      "Text": "老師，今天辛苦了"
    },
    {
      "Id": 100420490,
      "Speaker": "Student",
      "Text": "託你的福，重新種植了很多種"
    },
    {
      "Id": 100420500,
      "Speaker": "Player",
      "Text": "如果能健康地成長就好了呢"
    },
    {
      "Id": 100420510,
      "Speaker": "Student",
      "Text": "嗯。就是說啊"
    },
    {
      "Id": 100420520,
      "Speaker": "Student",
      "Text": "還有，謝謝你"
    },
    {
      "Id": 100420530,
      "Speaker": "Student",
      "Text": "我會對大家保密，好好珍惜的"
    },
    {
      "Id": 100420540,
      "Speaker": "Student",
      "Text": "你好，老師"
    },
    {
      "Id": 100420550,
      "Speaker": "Student",
      "Text": "昨晚，下了一場大雨"
    },
    {
      "Id": 100420560,
      "Speaker": "Student",
      "Text": "花圃沒事吧……"
    },
    {
      "Id": 100420570,
      "Speaker": "Student",
      "Text": "雖然想去確認，但一個人去有點不安"
    },
    {
      "Id": 100420580,
      "Speaker": "Student",
      "Text": "可以跟我一起去嗎？"
    },
    {
      "Id": 100420590,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "當然，很樂意"
    }
  ]
}