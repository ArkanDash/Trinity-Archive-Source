{
  "CharacterId": 10145,
  "DialogJP": [
    {
      "Id": 101450010,
      "Speaker": "Student",
      "Text": "せっかく渓谷にまで来たのならば"
    },
    {
      "Id": 101450020,
      "Speaker": "Student",
      "Text": "相応の過ごし方をすべきだとは思わぬかえ？"
    },
    {
      "Id": 101450030,
      "Speaker": "Player",
      "Text": "たしかにそうだね"
    },
    {
      "Id": 101450040,
      "Speaker": "Student",
      "Text": "うむ"
    },
    {
      "Id": 101450050,
      "Speaker": "Student",
      "Text": "見解は一致しておるようじゃな"
    },
    {
      "Id": 101450060,
      "Speaker": "Student",
      "Text": "では、今から言う場所で落ち合うとしよう"
    },
    {
      "Id": 101450070,
      "Speaker": "Player",
      "Text": "あ、今すぐ！？"
    },
    {
      "Id": 101450080,
      "Speaker": "Student",
      "Text": "安心せい。気は長いほうじゃ"
    },
    {
      "Id": 101450090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "……限度はあるがの"
    },
    {
      "Id": 101450100,
      "Speaker": "Student",
      "Text": "ふと"
    },
    {
      "Id": 101450110,
      "Speaker": "Student",
      "Text": "昨日を思い出したのじゃ"
    },
    {
      "Id": 101450120,
      "Speaker": "Player",
      "Text": "楽しかったよね"
    },
    {
      "Id": 101450130,
      "Speaker": "Student",
      "Text": "そうじゃな"
    },
    {
      "Id": 101450140,
      "Speaker": "Student",
      "Text": "とはいえ"
    },
    {
      "Id": 101450150,
      "Speaker": "Student",
      "Text": "過去にするのはまだ早かろう"
    },
    {
      "Id": 101450160,
      "Speaker": "Student",
      "Text": "では、今日も待っておるぞ"
    },
    {
      "Id": 101450170,
      "Speaker": "Student",
      "Text": "だって、先生はいつだって最高ですから！"
    },
    {
      "Id": 101450180,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "キサキ……？"
    },
    {
      "Id": 101450190,
      "Speaker": "Student",
      "Text": "先生、起きておるか？"
    },
    {
      "Id": 101450200,
      "Speaker": "Player",
      "Text": "ん……？"
    },
    {
      "Id": 101450210,
      "Speaker": "Player",
      "Text": "朝早くにどうしたの？"
    },
    {
      "Id": 101450220,
      "Speaker": "Student",
      "Text": "早起きとは感心じゃな"
    },
    {
      "Id": 101450230,
      "Speaker": "Student",
      "Text": "時は絶えず流れ続ける"
    },
    {
      "Id": 101450240,
      "Speaker": "Student",
      "Text": "少しでも有効に使うことが"
    },
    {
      "Id": 101450250,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "悔いのない休暇に繋がるのじゃ"
    },
    {
      "Id": 101450260,
      "Speaker": "Student",
      "Text": "暑い日が続くが、息災かえ？"
    },
    {
      "Id": 101450270,
      "Speaker": "Student",
      "Text": "こうも日差しが強くては"
    },
    {
      "Id": 101450280,
      "Speaker": "Student",
      "Text": "あの渓谷が恋しくなってしまうのう"
    },
    {
      "Id": 101450290,
      "Speaker": "Student",
      "Text": "先生もどうじゃ？"
    },
    {
      "Id": 101450300,
      "Speaker": "Student",
      "Text": "水着にふさわしき場所へ"
    },
    {
      "Id": 101450310,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "ん……？"
    },
    {
      "Id": 101450320,
      "Speaker": "Student",
      "Text": "この夏を共にしてくれたこと、礼を言う"
    },
    {
      "Id": 101450330,
      "Speaker": "Student",
      "Text": "どれも忘れられない思い出ばかりじゃ"
    },
    {
      "Id": 101450340,
      "Speaker": "Player",
      "Text": "まだだよ"
    },
    {
      "Id": 101450350,
      "Speaker": "Student",
      "Text": "ほう？"
    },
    {
      "Id": 101450360,
      "Speaker": "Player",
      "Text": "外はまだ暑いでしょ？"
    },
    {
      "Id": 101450370,
      "Speaker": "Player",
      "Text": "夏はまだ続くでしょ？"
    },
    {
      "Id": 101450380,
      "Speaker": "Student",
      "Text": "それはそうじゃが……"
    },
    {
      "Id": 101450390,
      "Speaker": "Student",
      "Text": "そうか"
    },
    {
      "Id": 101450400,
      "Speaker": "Student",
      "Text": "ならば、妾とまだ一緒にいてくれるのかえ？"
    },
    {
      "Id": 101450410,
      "Speaker": "Player",
      "Text": "望むなら、いくらでも"
    },
    {
      "Id": 101450420,
      "Speaker": "Student",
      "Text": "そうか"
    },
    {
      "Id": 101450430,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 101450440,
      "Speaker": "Student",
      "Text": "あまり他所でそういうことは言わぬようにな"
    },
    {
      "Id": 101450450,
      "Speaker": "Student",
      "Text": "先生ならば心配は不要やもしれぬが……"
    },
    {
      "Id": 101450460,
      "Speaker": "Student",
      "Text": "とある蝶は、永久に約束を記憶するそうじゃからの"
    }
  ],
  "DialogKR": [
    {
      "Id": 101450010,
      "Speaker": "Student",
      "Text": "모처럼 계곡까지 온 참인데"
    },
    {
      "Id": 101450020,
      "Speaker": "Student",
      "Text": "평소와는 다른 시간을 보내야 하지 않겠는가?"
    },
    {
      "Id": 101450030,
      "Speaker": "Player",
      "Text": "그건 확실히 그래야 할 것 같네."
    },
    {
      "Id": 101450040,
      "Speaker": "Student",
      "Text": "음."
    },
    {
      "Id": 101450050,
      "Speaker": "Student",
      "Text": "그렇게 선생도 동의하였으니."
    },
    {
      "Id": 101450060,
      "Speaker": "Student",
      "Text": "지금부터 내가 이야기하는 곳으로 와 주었으면 한다."
    },
    {
      "Id": 101450070,
      "Speaker": "Player",
      "Text": "전개가 엄청나게 빠르지 않아?!"
    },
    {
      "Id": 101450080,
      "Speaker": "Student",
      "Text": "덧붙여서"
    },
    {
      "Id": 101450090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "지각은 용서하지 않을 것이야."
    },
    {
      "Id": 101450100,
      "Speaker": "Student",
      "Text": "문득"
    },
    {
      "Id": 101450110,
      "Speaker": "Student",
      "Text": "어제 있었던 일이 기억나는구나."
    },
    {
      "Id": 101450120,
      "Speaker": "Player",
      "Text": "어리광…… 말이야?"
    },
    {
      "Id": 101450130,
      "Speaker": "Student",
      "Text": "후후."
    },
    {
      "Id": 101450140,
      "Speaker": "Student",
      "Text": "선생에게서 그 말을 들으니."
    },
    {
      "Id": 101450150,
      "Speaker": "Student",
      "Text": "조금 마음에 찔리는 부분이 있는 것 같군."
    },
    {
      "Id": 101450160,
      "Speaker": "Student",
      "Text": "그러면 오늘도 잘 부탁하겠다."
    },
    {
      "Id": 101450170,
      "Speaker": "Student",
      "Text": "왜냐하면 선생님은 언제나 최고니까요!"
    },
    {
      "Id": 101450180,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "키사키……?"
    },
    {
      "Id": 101450190,
      "Speaker": "Student",
      "Text": "일어났는가, 선생."
    },
    {
      "Id": 101450200,
      "Speaker": "Player",
      "Text": "어……?"
    },
    {
      "Id": 101450210,
      "Speaker": "Player",
      "Text": "지금, 조금 이르지 않아……?"
    },
    {
      "Id": 101450220,
      "Speaker": "Student",
      "Text": "그렇게 생각할 수도 있겠지."
    },
    {
      "Id": 101450230,
      "Speaker": "Student",
      "Text": "하지만 여름은 영원하지 않다."
    },
    {
      "Id": 101450240,
      "Speaker": "Student",
      "Text": "촌음을 아껴 써야만"
    },
    {
      "Id": 101450250,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "비로소 후회 없는 휴가를 보냈다고 할 수 있을 것이야."
    },
    {
      "Id": 101450260,
      "Speaker": "Student",
      "Text": "계곡에서 돌아왔지만"
    },
    {
      "Id": 101450270,
      "Speaker": "Student",
      "Text": "아직 밖은 여름이구나."
    },
    {
      "Id": 101450280,
      "Speaker": "Student",
      "Text": "하여."
    },
    {
      "Id": 101450290,
      "Speaker": "Student",
      "Text": "보다 수영복이 어울리는 장소를"
    },
    {
      "Id": 101450300,
      "Speaker": "Student",
      "Text": "더 찾아가고 싶다는 생각이 든 것이다."
    },
    {
      "Id": 101450310,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "뭐……?"
    },
    {
      "Id": 101450320,
      "Speaker": "Student",
      "Text": "이번 여름을 함께 해 주어 고마웠다, 선생."
    },
    {
      "Id": 101450330,
      "Speaker": "Student",
      "Text": "잊지 못할 추억들뿐이었구나."
    },
    {
      "Id": 101450340,
      "Speaker": "Player",
      "Text": "아직 아니야, 키사키."
    },
    {
      "Id": 101450350,
      "Speaker": "Student",
      "Text": "그것은 무슨 뜻인가?"
    },
    {
      "Id": 101450360,
      "Speaker": "Player",
      "Text": "키사키가 처음에 이야기했잖아?"
    },
    {
      "Id": 101450370,
      "Speaker": "Player",
      "Text": "밖은 아직 여름이라고."
    },
    {
      "Id": 101450380,
      "Speaker": "Student",
      "Text": "그렇게 이야기하기는 했다만……"
    },
    {
      "Id": 101450390,
      "Speaker": "Student",
      "Text": "그런가."
    },
    {
      "Id": 101450400,
      "Speaker": "Student",
      "Text": "그렇다면 아직, 나와 여름을 더 함께해 준다는 뜻인가?"
    },
    {
      "Id": 101450410,
      "Speaker": "Player",
      "Text": "키사키가 바란다면 얼마든지!"
    },
    {
      "Id": 101450420,
      "Speaker": "Student",
      "Text": "그렇구나."
    },
    {
      "Id": 101450430,
      "Speaker": "Student",
      "Text": "후후."
    },
    {
      "Id": 101450440,
      "Speaker": "Student",
      "Text": "물론 선생은 그럴 만한 사람이 아니겠지만."
    },
    {
      "Id": 101450450,
      "Speaker": "Student",
      "Text": "너무 가벼이 이야기하지 않는 편이 좋을 것이야."
    },
    {
      "Id": 101450460,
      "Speaker": "Student",
      "Text": "어떤 나비는, 약속을 영원히 기억한다고 하니 말이다."
    }
  ],
