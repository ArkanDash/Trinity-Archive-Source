{
  "CharacterId": 10077,
  "DialogJP": [
    {
      "Id": 100770010,
      "Speaker": "Student",
      "Text": "先生、こんにちは"
    },
    {
      "Id": 100770020,
      "Speaker": "Student",
      "Text": "今度、トリニティに来るって聞いたんですが"
    },
    {
      "Id": 100770030,
      "Speaker": "Student",
      "Text": "どういうわけか"
    },
    {
      "Id": 100770040,
      "Speaker": "Student",
      "Text": "今回は私が先生を手伝うことになったみたいで"
    },
    {
      "Id": 100770050,
      "Speaker": "Student",
      "Text": "そういうことなので、よろしくお願いします"
    },
    {
      "Id": 100770060,
      "Speaker": "Player",
      "Text": "こんにちは、イチカ"
    },
    {
      "Id": 100770070,
      "Speaker": "Player",
      "Text": "よろしくね！"
    },
    {
      "Id": 100770080,
      "Speaker": "Student",
      "Text": "はい！"
    },
    {
      "Id": 100770090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "では、また後ほど"
    },
    {
      "Id": 100770100,
      "Speaker": "Student",
      "Text": "先生、着きました？"
    },
    {
      "Id": 100770110,
      "Speaker": "Player",
      "Text": "うん、おかげさまで"
    },
    {
      "Id": 100770120,
      "Speaker": "Player",
      "Text": "ありがとう、イチカ"
    },
    {
      "Id": 100770130,
      "Speaker": "Student",
      "Text": "これくらいお安いご用です"
    },
    {
      "Id": 100770140,
      "Speaker": "Student",
      "Text": "それじゃ"
    },
    {
      "Id": 100770150,
      "Speaker": "Student",
      "Text": "私もそろそろ寝るんで"
    },
    {
      "Id": 100770160,
      "Speaker": "Student",
      "Text": "おやすみなさーい"
    },
    {
      "Id": 100770170,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 100770180,
      "Speaker": "Student",
      "Text": "どうしたもんかなぁ"
    },
    {
      "Id": 100770190,
      "Speaker": "Student",
      "Text": "先生って"
    },
    {
      "Id": 100770200,
      "Speaker": "Student",
      "Text": "仕事がないときは何してるんですか？"
    },
    {
      "Id": 100770210,
      "Speaker": "Player",
      "Text": "死んだように寝てるかな……"
    },
    {
      "Id": 100770220,
      "Speaker": "Player",
      "Text": "漫画を読んだりゲームをしてるよ"
    },
    {
      "Id": 100770230,
      "Speaker": "Student",
      "Text": "あー"
    },
    {
      "Id": 100770240,
      "Speaker": "Student",
      "Text": "なるほど"
    },
    {
      "Id": 100770250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "そんな感じなんですね"
    },
    {
      "Id": 100770260,
      "Speaker": "Student",
      "Text": "やー、楽しかった"
    },
    {
      "Id": 100770270,
      "Speaker": "Student",
      "Text": "今日はすっごい充実しましたね"
    },
    {
      "Id": 100770280,
      "Speaker": "Player",
      "Text": "ギターはまだ弾いてるの？"
    },
    {
      "Id": 100770290,
      "Speaker": "Player",
      "Text": "演奏に興味は出てきた？"
    },
    {
      "Id": 100770300,
      "Speaker": "Student",
      "Text": "へ？"
    },
    {
      "Id": 100770310,
      "Speaker": "Student",
      "Text": "あーいや"
    },
    {
      "Id": 100770320,
      "Speaker": "Student",
      "Text": "家でも何回かやってみたけど"
    },
    {
      "Id": 100770330,
      "Speaker": "Student",
      "Text": "あんまり気が乗らなくて"
    },
    {
      "Id": 100770340,
      "Speaker": "Student",
      "Text": "押し入れに入れちゃったんすよね"
    },
    {
      "Id": 100770350,
      "Speaker": "Student",
      "Text": "あはは"
    },
    {
      "Id": 100770360,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100770370,
      "Speaker": "Student",
      "Text": "今って時間あります？"
    },
    {
      "Id": 100770380,
      "Speaker": "Player",
      "Text": "うん？どうしたの？"
    },
    {
      "Id": 100770390,
      "Speaker": "Player",
      "Text": "ちょうど暇してたところ"
    },
    {
      "Id": 100770400,
      "Speaker": "Student",
      "Text": "あーえっと"
    },
    {
      "Id": 100770410,
      "Speaker": "Student",
      "Text": "いや、なんとなく"
    },
    {
      "Id": 100770420,
      "Speaker": "Student",
      "Text": "ちょっと暇だなって……"
    },
    {
      "Id": 100770430,
      "Speaker": "Student",
      "Text": "予定まで結構時間があるんですけど"
    },
    {
      "Id": 100770440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "思ったよりやることがないんですよね"
    },
    {
      "Id": 100770450,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100770460,
      "Speaker": "Student",
      "Text": "今って何してます？"
    },
    {
      "Id": 100770470,
      "Speaker": "Student",
      "Text": "ああっと"
    },
    {
      "Id": 100770480,
      "Speaker": "Student",
      "Text": "別に何か用があるわけじゃないんですが……"
    },
    {
      "Id": 100770490,
      "Speaker": "Player",
      "Text": "仕事が終わって休憩してるところだよ"
    },
    {
      "Id": 100770500,
      "Speaker": "Player",
      "Text": "公園で会おっか"
    },
    {
      "Id": 100770510,
      "Speaker": "Student",
      "Text": "おっ"
    },
    {
      "Id": 100770520,
      "Speaker": "Student",
      "Text": "いいですね"
    },
    {
      "Id": 100770530,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "それじゃ、後ほど！"
    },
    {
      "Id": 100770540,
      "Speaker": "Student",
      "Text": "ふぅ"
    },
    {
      "Id": 100770550,
      "Speaker": "Student",
      "Text": "今日は先生のおかげで楽しかったです"
    },
    {
      "Id": 100770560,
      "Speaker": "Student",
      "Text": "ありがとうございました、先生"
    },
    {
      "Id": 100770570,
      "Speaker": "Student",
      "Text": "また遊びに行きたいです！"
    },
    {
      "Id": 100770580,
      "Speaker": "Student",
      "Text": "先生がそうした方がいいって言ったんですからね！"
    },
    {
      "Id": 100770590,
      "Speaker": "Player",
      "Text": "もちろん、いつでも付き合うよ"
    },
    {
      "Id": 100770600,
      "Speaker": "Player",
      "Text": "夢中になれるものが見つかるといいね"
    },
    {
      "Id": 100770610,
      "Speaker": "Student",
      "Text": "はい！"
    },
    {
      "Id": 100770620,
      "Speaker": "Student",
      "Text": "……ん～"
    },
    {
      "Id": 100770630,
      "Speaker": "Student",
      "Text": "でも……"
    },
    {
      "Id": 100770640,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100770650,
      "Speaker": "Student",
      "Text": "まだしばらくは"
    },
    {
      "Id": 100770660,
      "Speaker": "Student",
      "Text": "今が最高なので大丈夫です！"
    },
    {
      "Id": 100770670,
      "Speaker": "Student",
      "Text": "はは"
    }
  ],
  "DialogKR": [
    {
      "Id": 100770010,
      "Speaker": "Student",
      "Text": "이야기 들었습니다"
    },
    {
      "Id": 100770020,
      "Speaker": "Student",
      "Text": "이번에 트리니티 오신다면서요?"
    },
    {
      "Id": 100770030,
      "Speaker": "Student",
      "Text": "하하"
    },
    {
      "Id": 100770040,
      "Speaker": "Student",
      "Text": "어쩌다 보니"
    },
    {
      "Id": 100770050,
      "Speaker": "Student",
      "Text": "이번에는 제가 옆에서 돕게 됐네요"
    },
    {
      "Id": 100770060,
      "Speaker": "Player",
      "Text": "오, 안녕. 이치카."
    },
    {
      "Id": 100770070,
      "Speaker": "Player",
      "Text": "잘 부탁해!"
    },
    {
      "Id": 100770080,
      "Speaker": "Student",
      "Text": "네~"
    },
    {
      "Id": 100770090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "그때 뵙겠습니다!"
    },
    {
      "Id": 100770100,
      "Speaker": "Student",
      "Text": "선생님~ 잘 들어가셨습니까"
    },
    {
      "Id": 100770110,
      "Speaker": "Player",
      "Text": "잘 들어왔어."
    },
    {
      "Id": 100770120,
      "Speaker": "Player",
      "Text": "덕분에 안전하게 왔네."
    },
    {
      "Id": 100770130,
      "Speaker": "Student",
      "Text": "뭐 이런 걸로 ㅎㅎ"
    },
    {
      "Id": 100770140,
      "Speaker": "Student",
      "Text": "그럼 무사히 들어가신 걸로 알고"
    },
    {
      "Id": 100770150,
      "Speaker": "Student",
      "Text": "저도 이만 자겠습니다"
    },
    {
      "Id": 100770160,
      "Speaker": "Student",
      "Text": "좋은 밤~"
    },
    {
      "Id": 100770170,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100770180,
      "Speaker": "Student",
      "Text": "뭐하지"
    },
    {
      "Id": 100770190,
      "Speaker": "Student",
      "Text": "선생님은"
    },
    {
      "Id": 100770200,
      "Speaker": "Student",
      "Text": "일 없을 때 뭐 하시나요"
    },
    {
      "Id": 100770210,
      "Speaker": "Player",
      "Text": "죽은 듯이 자는 편이지"
    },
    {
      "Id": 100770220,
      "Speaker": "Player",
      "Text": "게임이나…… 취미? 그런데 왜?"
    },
    {
      "Id": 100770230,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100770240,
      "Speaker": "Student",
      "Text": "그렇군요"
    },
    {
      "Id": 100770250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "네ㅎ"
    },
    {
      "Id": 100770260,
      "Speaker": "Student",
      "Text": "이야~ 즐거웠습니다."
    },
    {
      "Id": 100770270,
      "Speaker": "Student",
      "Text": "저로서는 완전 이득 본 날이네요. 여러모로."
    },
    {
      "Id": 100770280,
      "Speaker": "Player",
      "Text": "기타는 계속 치고 있어?"
    },
    {
      "Id": 100770290,
      "Speaker": "Player",
      "Text": "연주에는 흥미가 좀 붙었어?"
    },
    {
      "Id": 100770300,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 100770310,
      "Speaker": "Student",
      "Text": "아아"
    },
    {
      "Id": 100770320,
      "Speaker": "Student",
      "Text": "아뇨"
    },
    {
      "Id": 100770330,
      "Speaker": "Student",
      "Text": "집에서 혼자 몇 번 더 쳐 보긴 했는데, 역시 흥미가 안 붙어서"
    },
    {
      "Id": 100770340,
      "Speaker": "Student",
      "Text": "방 한쪽에 놔뒀습니다"
    },
    {
      "Id": 100770350,
      "Speaker": "Student",
      "Text": "하하"
    },
    {
      "Id": 100770360,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100770370,
      "Speaker": "Student",
      "Text": "지금 한가하시나요"
    },
    {
      "Id": 100770380,
      "Speaker": "Player",
      "Text": "그럭저럭? 무슨 일이야?"
    },
    {
      "Id": 100770390,
      "Speaker": "Player",
      "Text": "마침 빈둥거리고 있었어"
    },
    {
      "Id": 100770400,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100770410,
      "Speaker": "Student",
      "Text": "아뇨 그냥"
    },
    {
      "Id": 100770420,
      "Speaker": "Student",
      "Text": "진짜 그냥 심심해서"
    },
    {
      "Id": 100770430,
      "Speaker": "Student",
      "Text": "사람들 기다리는 중이라 할 게 없네요"
    },
    {
      "Id": 100770440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ㅎㅎ"
    },
    {
      "Id": 100770450,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100770460,
      "Speaker": "Student",
      "Text": "지금 시간 괜찮으십니까?"
    },
    {
      "Id": 100770470,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100770480,
      "Speaker": "Student",
      "Text": "무슨 일 있는 건 아닙니다만"
    },
    {
      "Id": 100770490,
      "Speaker": "Player",
      "Text": "마침 한가하네, 나갈게."
    },
    {
      "Id": 100770500,
      "Speaker": "Player",
      "Text": "조금 있다 공원에서 볼까?"
    },
    {
      "Id": 100770510,
      "Speaker": "Student",
      "Text": "오"
    },
    {
      "Id": 100770520,
      "Speaker": "Student",
      "Text": "좋네요"
    },
    {
      "Id": 100770530,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "그럼 그때 뵙겠습니다"
    },
    {
      "Id": 100770540,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100770550,
      "Speaker": "Student",
      "Text": "오늘은 덕분에 아주 좋았던 듯"
    },
    {
      "Id": 100770560,
      "Speaker": "Student",
      "Text": "감사합니다, 선생님"
    },
    {
      "Id": 100770570,
      "Speaker": "Student",
      "Text": "다음에도 또 부탁드릴 거예요"
    },
    {
      "Id": 100770580,
      "Speaker": "Student",
      "Text": "선생님이 그러라고 한 거니까"
    },
    {
      "Id": 100770590,
      "Speaker": "Player",
      "Text": "좋지. 비슷한 느낌도 더 찾아봐."
    },
    {
      "Id": 100770600,
      "Speaker": "Player",
      "Text": "앞으로도 그렇게 하는 거야."
    },
    {
      "Id": 100770610,
      "Speaker": "Student",
      "Text": "네~"
    },
    {
      "Id": 100770620,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100770630,
      "Speaker": "Student",
      "Text": "그런데, 뭐"
    },
    {
      "Id": 100770640,
      "Speaker": "Student",
      "Text": "당분간은"
    },
    {
      "Id": 100770650,
      "Speaker": "Student",
      "Text": "ㅎㅎ"
    },
    {
      "Id": 100770660,
      "Speaker": "Student",
      "Text": "이거보다 더 마음 가는 건,"
    },
    {
      "Id": 100770670,
      "Speaker": "Student",
      "Text": "없을지도 모르겠네요"
    }
  ],
  "DialogEN": [
    {
      "Id": 100770010,
      "Speaker": "Student",
      "Text": "Rumor has it"
    },
    {
      "Id": 100770020,
      "Speaker": "Student",
      "Text": "that you're coming to Trinity today."
    },
    {
      "Id": 100770030,
      "Speaker": "Student",
      "Text": "Haha"
    },
    {
      "Id": 100770040,
      "Speaker": "Student",
      "Text": "Believe it or not,"
    },
    {
      "Id": 100770050,
      "Speaker": "Student",
      "Text": "I've been assigned to help you out this time."
    },
    {
      "Id": 100770060,
      "Speaker": "Player",
      "Text": "Hello, Ichika."
    },
    {
      "Id": 100770070,
      "Speaker": "Player",
      "Text": "Let's do our best!"
    },
    {
      "Id": 100770080,
      "Speaker": "Student",
      "Text": "Yes!"
    },
    {
      "Id": 100770090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'll see you there!"
    },
    {
      "Id": 100770100,
      "Speaker": "Student",
      "Text": "Sensei! Did you make it back all right?"
    },
    {
      "Id": 100770110,
      "Speaker": "Player",
      "Text": "I did."
    },
    {
      "Id": 100770120,
      "Speaker": "Player",
      "Text": "Thanks to you."
    },
    {
      "Id": 100770130,
      "Speaker": "Student",
      "Text": "It was nothing. Haha."
    },
    {
      "Id": 100770140,
      "Speaker": "Student",
      "Text": "Now that I've confirmed your safe return,"
    },
    {
      "Id": 100770150,
      "Speaker": "Student",
      "Text": "I shall go to bed as well."
    },
    {
      "Id": 100770160,
      "Speaker": "Student",
      "Text": "Good night!"
    },
    {
      "Id": 100770170,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 100770180,
      "Speaker": "Student",
      "Text": "What to do?"
    },
    {
      "Id": 100770190,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 100770200,
      "Speaker": "Student",
      "Text": "What do you do when you don't have any work?"
    },
    {
      "Id": 100770210,
      "Speaker": "Player",
      "Text": "I sleep like a log."
    },
    {
      "Id": 100770220,
      "Speaker": "Player",
      "Text": "I play games...or work on other hobbies. Why do you ask?"
    },
    {
      "Id": 100770230,
      "Speaker": "Student",
      "Text": "Mm."
    },
    {
      "Id": 100770240,
      "Speaker": "Student",
      "Text": "I see."
    },
    {
      "Id": 100770250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Yes. Haha..."
    },
    {
      "Id": 100770260,
      "Speaker": "Student",
      "Text": "Wow, that was fun."
    },
    {
      "Id": 100770270,
      "Speaker": "Student",
      "Text": "I got a lot out of today. In many ways."
    },
    {
      "Id": 100770280,
      "Speaker": "Player",
      "Text": "Are you going to keep up the guitar?"
    },
    {
      "Id": 100770290,
      "Speaker": "Player",
      "Text": "Playing was fun, right?"
    },
    {
      "Id": 100770300,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 100770310,
      "Speaker": "Student",
      "Text": "Ahhh..."
    },
    {
      "Id": 100770320,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100770330,
      "Speaker": "Student",
      "Text": "I tried playing a few times at home, but I just can't get into it."
    },
    {
      "Id": 100770340,
      "Speaker": "Student",
      "Text": "Now my guitar sits in the corner of my room."
    },
    {
      "Id": 100770350,
      "Speaker": "Student",
      "Text": "Haha."
    },
    {
      "Id": 100770360,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100770370,
      "Speaker": "Student",
      "Text": "Are you free at the moment?"
    },
    {
      "Id": 100770380,
      "Speaker": "Player",
      "Text": "More or less. What's going on?"
    },
    {
      "Id": 100770390,
      "Speaker": "Player",
      "Text": "I was just relaxing."
    },
    {
      "Id": 100770400,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 100770410,
      "Speaker": "Student",
      "Text": "It's nothing."
    },
    {
      "Id": 100770420,
      "Speaker": "Student",
      "Text": "I'm just really bored."
    },
    {
      "Id": 100770430,
      "Speaker": "Student",
      "Text": "I'm waiting on some other people and have nothing to do."
    },
    {
      "Id": 100770440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Haha."
    },
    {
      "Id": 100770450,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100770460,
      "Speaker": "Student",
      "Text": "Do you have some time now?"
    },
    {
      "Id": 100770470,
      "Speaker": "Student",
      "Text": "Oh..."
    },
    {
      "Id": 100770480,
      "Speaker": "Student",
      "Text": "Don't worry. There's nothing wrong."
    },
    {
      "Id": 100770490,
      "Speaker": "Player",
      "Text": "I do have some time. I'll come see you."
    },
    {
      "Id": 100770500,
      "Speaker": "Player",
      "Text": "Why don't we meet at the park?"
    },
    {
      "Id": 100770510,
      "Speaker": "Student",
      "Text": "Oh!"
    },
    {
      "Id": 100770520,
      "Speaker": "Student",
      "Text": "That would be great."
    },
    {
      "Id": 100770530,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I'll see you there."
    },
    {
      "Id": 100770540,
      "Speaker": "Student",
      "Text": "Mm."
    },
    {
      "Id": 100770550,
      "Speaker": "Student",
      "Text": "I had a great time today thanks to you."
    },
    {
      "Id": 100770560,
      "Speaker": "Student",
      "Text": "Thank you, Sensei."
    },
    {
      "Id": 100770570,
      "Speaker": "Student",
      "Text": "I'll be sure to reach out whenever I need help."
    },
    {
      "Id": 100770580,
      "Speaker": "Student",
      "Text": "You did ask me to, after all."
    },
    {
      "Id": 100770590,
      "Speaker": "Player",
      "Text": "Sounds good. And remember to trust your heart."
    },
    {
      "Id": 100770600,
      "Speaker": "Player",
      "Text": "That's all you've got to do, okay?"
    },
    {
      "Id": 100770610,
      "Speaker": "Student",
      "Text": "Yes!"
    },
    {
      "Id": 100770620,
      "Speaker": "Student",
      "Text": "Mm..."
    },
    {
      "Id": 100770630,
      "Speaker": "Student",
      "Text": "Although..."
    },
    {
      "Id": 100770640,
      "Speaker": "Student",
      "Text": "For the time being..."
    },
    {
      "Id": 100770650,
      "Speaker": "Student",
      "Text": "Haha."
    },
    {
      "Id": 100770660,
      "Speaker": "Student",
      "Text": "I'm not sure I'll find anything"
    },
    {
      "Id": 100770670,
      "Speaker": "Student",
      "Text": "that speaks to me more than this."
    }
  ],
  "DialogTH": [
    {
      "Id": 100770010,
      "Speaker": "Student",
      "Text": "ฉันได้ยินข่าวมาค่ะ"
    },
    {
      "Id": 100770020,
      "Speaker": "Student",
      "Text": "ว่าวันนี้คุณครูมาที่ทรีนิตี้?"
    },
    {
      "Id": 100770030,
      "Speaker": "Student",
      "Text": "ฮะฮ่า"
    },
    {
      "Id": 100770040,
      "Speaker": "Student",
      "Text": "บังเอิญว่า..."
    },
    {
      "Id": 100770050,
      "Speaker": "Student",
      "Text": "คราวนี้ฉันได้รับหน้าที่ให้คอยช่วย\nคุณครูค่ะ"
    },
    {
      "Id": 100770060,
      "Speaker": "Player",
      "Text": "ว่าไง อิจิกะ"
    },
    {
      "Id": 100770070,
      "Speaker": "Player",
      "Text": "ครูฝากด้วยนะ!"
    },
    {
      "Id": 100770080,
      "Speaker": "Student",
      "Text": "ค่า~"
    },
    {
      "Id": 100770090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "แล้วเจอกันนะคะ!"
    },
    {
      "Id": 100770100,
      "Speaker": "Student",
      "Text": "คุณครู~ กลับถึงอย่างปลอดภัย\nใช่มั้ยคะ?"
    },
    {
      "Id": 100770110,
      "Speaker": "Player",
      "Text": "อื้อ ถึงแล้วละ"
    },
    {
      "Id": 100770120,
      "Speaker": "Player",
      "Text": "ขอบใจที่ดูแลครูให้มาถึง\nอย่างปลอดภัยนะ"
    },
    {
      "Id": 100770130,
      "Speaker": "Student",
      "Text": "ขอบจงขอบใจอะไรกัน ฮิฮิ"
    },
    {
      "Id": 100770140,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูถึงที่พักอย่างปลอดภัยแล้ว"
    },
    {
      "Id": 100770150,
      "Speaker": "Student",
      "Text": "ฉันขอตัวไปนอนก่อนนะคะ"
    },
    {
      "Id": 100770160,
      "Speaker": "Student",
      "Text": "ฝันดีค่า~"
    },
    {
      "Id": 100770170,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100770180,
      "Speaker": "Student",
      "Text": "ทำอะไรดีนะ"
    },
    {
      "Id": 100770190,
      "Speaker": "Student",
      "Text": "ตอนไม่มีงาน"
    },
    {
      "Id": 100770200,
      "Speaker": "Student",
      "Text": "คุณครูชอบทำอะไรเหรอคะ?"
    },
    {
      "Id": 100770210,
      "Speaker": "Player",
      "Text": "ส่วนมากนอนหลับเหมือนตายเลยละ"
    },
    {
      "Id": 100770220,
      "Speaker": "Player",
      "Text": "ไม่เล่นเกม... ก็ทำงานอดิเรก?\nว่ามีอะไรรึเปล่า?"
    },
    {
      "Id": 100770230,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100770240,
      "Speaker": "Student",
      "Text": "อย่างนั้นเหรอคะ"
    },
    {
      "Id": 100770250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ค่ะ ฮิฮิ"
    },
    {
      "Id": 100770260,
      "Speaker": "Student",
      "Text": "ฮื้ม~ วันนี้สนุกจังเลยค่ะ"
    },
    {
      "Id": 100770270,
      "Speaker": "Student",
      "Text": "สำหรับฉันแล้ว วันนี้ได้ถือว่ากำไร\nมากเลยละค่ะ ในหลายๆ เรื่องเลย"
    },
    {
      "Id": 100770280,
      "Speaker": "Player",
      "Text": "ยังเล่นกีตาร์อยู่มั้ย?"
    },
    {
      "Id": 100770290,
      "Speaker": "Player",
      "Text": "เริ่มสนุกกับการเล่นดนตรีหรือยัง?"
    },
    {
      "Id": 100770300,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 100770310,
      "Speaker": "Student",
      "Text": "อ้อ"
    },
    {
      "Id": 100770320,
      "Speaker": "Student",
      "Text": "ไม่ค่ะ"
    },
    {
      "Id": 100770330,
      "Speaker": "Student",
      "Text": "ฉันลองเล่นที่บ้านคนเดียวอยู่ 2-3 ครั้ง\nแต่ก็ยังไม่ค่อยอินเท่าไหร่"
    },
    {
      "Id": 100770340,
      "Speaker": "Student",
      "Text": "ก็เลยเอาวางไว้ที่มุมห้องค่ะ"
    },
    {
      "Id": 100770350,
      "Speaker": "Student",
      "Text": "ฮ่าๆ"
    },
    {
      "Id": 100770360,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100770370,
      "Speaker": "Student",
      "Text": "ตอนนี้ว่างมั้ยคะ?"
    },
    {
      "Id": 100770380,
      "Speaker": "Player",
      "Text": "ก็พอว่างอยู่? มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 100770390,
      "Speaker": "Player",
      "Text": "กำลังนั่งขี้เกียจอยู่เลย"
    },
    {
      "Id": 100770400,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100770410,
      "Speaker": "Student",
      "Text": "เปล่าหรอกค่ะ ก็แค่..."
    },
    {
      "Id": 100770420,
      "Speaker": "Student",
      "Text": "ฉันเบื่อมากๆ เลยน่ะ"
    },
    {
      "Id": 100770430,
      "Speaker": "Student",
      "Text": "ฉันกำลังนั่งรอคนอื่นๆ อยู่ เลยไม่มี\nอะไรทำค่ะ"
    },
    {
      "Id": 100770440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ฮิฮิ"
    },
    {
      "Id": 100770450,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100770460,
      "Speaker": "Student",
      "Text": "ตอนนี้พอมีเวลามั้ยคะ?"
    },
    {
      "Id": 100770470,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100770480,
      "Speaker": "Student",
      "Text": "ไม่ต้องห่วงค่ะ ไม่ได้มีเรื่องอะไร\nหรอกค่ะ"
    },
    {
      "Id": 100770490,
      "Speaker": "Player",
      "Text": "ครูว่างอยู่พอดี เดี๋ยวออกไปหานะ"
    },
    {
      "Id": 100770500,
      "Speaker": "Player",
      "Text": "เดี๋ยวไปเจอกันที่สวนสาธารณะมั้ย?"
    },
    {
      "Id": 100770510,
      "Speaker": "Student",
      "Text": "โอ้"
    },
    {
      "Id": 100770520,
      "Speaker": "Student",
      "Text": "ดีเลยค่ะ"
    },
    {
      "Id": 100770530,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "งั้นไว้เจอกันนะคะ"
    },
    {
      "Id": 100770540,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100770550,
      "Speaker": "Student",
      "Text": "วันนี้ฉันสนุกมากเลยค่ะ"
    },
    {
      "Id": 100770560,
      "Speaker": "Student",
      "Text": "ขอบคุณนะคะคุณครู"
    },
    {
      "Id": 100770570,
      "Speaker": "Student",
      "Text": "คราวหน้าฉันจะมาขอให้ช่วยอีกนะคะ"
    },
    {
      "Id": 100770580,
      "Speaker": "Student",
      "Text": "ก็คุณครูบอกไว้นี่ว่าทำได้"
    },
    {
      "Id": 100770590,
      "Speaker": "Player",
      "Text": "ได้สิ ไว้ลองหาอะไรที่รู้สึกคล้ายๆ กันอีกนะ"
    },
    {
      "Id": 100770600,
      "Speaker": "Player",
      "Text": "ต่อไปก็ทำแบบนี้อีกนะ"
    },
    {
      "Id": 100770610,
      "Speaker": "Student",
      "Text": "ค่า~"
    },
    {
      "Id": 100770620,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100770630,
      "Speaker": "Student",
      "Text": "แต่ว่า"
    },
    {
      "Id": 100770640,
      "Speaker": "Student",
      "Text": "ฉันคิดว่า"
    },
    {
      "Id": 100770650,
      "Speaker": "Student",
      "Text": "ฮิฮิ"
    },
    {
      "Id": 100770660,
      "Speaker": "Student",
      "Text": "ฉันอาจจะไม่สนุกกับอะไรอื่น"
    },
    {
      "Id": 100770670,
      "Speaker": "Student",
      "Text": "นอกจากสิ่งนี้ไปสักพักเลยก็ได้ค่ะ"
    }
  ],
  "DialogTW": [
    {
      "Id": 100770010,
      "Speaker": "Student",
      "Text": "老師，我聽說了"
    },
    {
      "Id": 100770020,
      "Speaker": "Student",
      "Text": "你這次要來三一對吧？"
    },
    {
      "Id": 100770030,
      "Speaker": "Student",
      "Text": "哈哈"
    },
    {
      "Id": 100770040,
      "Speaker": "Student",
      "Text": "不知道為什麼"
    },
    {
      "Id": 100770050,
      "Speaker": "Student",
      "Text": "這次似乎是由我來協助老師"
    },
    {
      "Id": 100770060,
      "Speaker": "Player",
      "Text": "你好呀，一花"
    },
    {
      "Id": 100770070,
      "Speaker": "Player",
      "Text": "那就拜託你囉！"
    },
    {
      "Id": 100770080,
      "Speaker": "Student",
      "Text": "好～"
    },
    {
      "Id": 100770090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "待會見！"
    },
    {
      "Id": 100770100,
      "Speaker": "Student",
      "Text": "老師～平安回去了嗎？"
    },
    {
      "Id": 100770110,
      "Speaker": "Player",
      "Text": "順利回來囉"
    },
    {
      "Id": 100770120,
      "Speaker": "Player",
      "Text": "託你的福，安全回來了"
    },
    {
      "Id": 100770130,
      "Speaker": "Student",
      "Text": "老師太客氣了啦，呵呵"
    },
    {
      "Id": 100770140,
      "Speaker": "Student",
      "Text": "既然老師已經順利抵達"
    },
    {
      "Id": 100770150,
      "Speaker": "Student",
      "Text": "那我也差不多該睡了"
    },
    {
      "Id": 100770160,
      "Speaker": "Student",
      "Text": "晚安～"
    },
    {
      "Id": 100770170,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 100770180,
      "Speaker": "Student",
      "Text": "該怎麼說呢"
    },
    {
      "Id": 100770190,
      "Speaker": "Student",
      "Text": "老師你"
    },
    {
      "Id": 100770200,
      "Speaker": "Student",
      "Text": "工作之餘都在做什麼？"
    },
    {
      "Id": 100770210,
      "Speaker": "Player",
      "Text": "睡得像死人一樣"
    },
    {
      "Id": 100770220,
      "Speaker": "Player",
      "Text": "玩遊戲……或是做有興趣的事吧？怎麼了嗎？"
    },
    {
      "Id": 100770230,
      "Speaker": "Student",
      "Text": "嗯……"
    },
    {
      "Id": 100770240,
      "Speaker": "Student",
      "Text": "原來如此"
    },
    {
      "Id": 100770250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "這樣啊，呵呵"
    },
    {
      "Id": 100770260,
      "Speaker": "Student",
      "Text": "哎呀～真開心"
    },
    {
      "Id": 100770270,
      "Speaker": "Student",
      "Text": "對我來說，今天真是在各方面都賺到了"
    },
    {
      "Id": 100770280,
      "Speaker": "Player",
      "Text": "還在彈吉他嗎？"
    },
    {
      "Id": 100770290,
      "Speaker": "Player",
      "Text": "對演奏產生興趣了嗎？"
    },
    {
      "Id": 100770300,
      "Speaker": "Student",
      "Text": "咦？"
    },
    {
      "Id": 100770310,
      "Speaker": "Student",
      "Text": "這個……"
    },
    {
      "Id": 100770320,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100770330,
      "Speaker": "Student",
      "Text": "我在家裡又彈了幾次，但還是沒什麼興趣"
    },
    {
      "Id": 100770340,
      "Speaker": "Student",
      "Text": "所以就放在房間的角落了"
    },
    {
      "Id": 100770350,
      "Speaker": "Student",
      "Text": "啊哈哈"
    },
    {
      "Id": 100770360,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100770370,
      "Speaker": "Student",
      "Text": "現在有空嗎？"
    },
    {
      "Id": 100770380,
      "Speaker": "Player",
      "Text": "馬馬虎虎吧？有什麼事嗎？"
    },
    {
      "Id": 100770390,
      "Speaker": "Player",
      "Text": "現在正好很閒"
    },
    {
      "Id": 100770400,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 100770410,
      "Speaker": "Student",
      "Text": "沒有，我只是"
    },
    {
      "Id": 100770420,
      "Speaker": "Student",
      "Text": "因為有點閒"
    },
    {
      "Id": 100770430,
      "Speaker": "Student",
      "Text": "在等人的時候沒事可做"
    },
    {
      "Id": 100770440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "嘻嘻"
    },
    {
      "Id": 100770450,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100770460,
      "Speaker": "Student",
      "Text": "現在有空嗎？"
    },
    {
      "Id": 100770470,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 100770480,
      "Speaker": "Student",
      "Text": "其實也沒什麼事"
    },
    {
      "Id": 100770490,
      "Speaker": "Player",
      "Text": "正好沒事，打算出門走走"
    },
    {
      "Id": 100770500,
      "Speaker": "Player",
      "Text": "待會要不要在公園碰面？"
    },
    {
      "Id": 100770510,
      "Speaker": "Student",
      "Text": "哦～"
    },
    {
      "Id": 100770520,
      "Speaker": "Student",
      "Text": "聽起來不錯"
    },
    {
      "Id": 100770530,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "那待會見！"
    },
    {
      "Id": 100770540,
      "Speaker": "Student",
      "Text": "嗯……"
    },
    {
      "Id": 100770550,
      "Speaker": "Student",
      "Text": "今天多虧了老師，真的玩得很開心"
    },
    {
      "Id": 100770560,
      "Speaker": "Student",
      "Text": "謝謝你，老師"
    },
    {
      "Id": 100770570,
      "Speaker": "Student",
      "Text": "之後還想要一起玩！"
    },
    {
      "Id": 100770580,
      "Speaker": "Student",
      "Text": "因為老師也是這麼說的！"
    },
    {
      "Id": 100770590,
      "Speaker": "Player",
      "Text": "嗯，繼續尋找類似的感覺吧"
    },
    {
      "Id": 100770600,
      "Speaker": "Player",
      "Text": "以後也要持續下去"
    },
    {
      "Id": 100770610,
      "Speaker": "Student",
      "Text": "好～"
    },
    {
      "Id": 100770620,
      "Speaker": "Student",
      "Text": "嗯……"
    },
    {
      "Id": 100770630,
      "Speaker": "Student",
      "Text": "但是"
    },
    {
