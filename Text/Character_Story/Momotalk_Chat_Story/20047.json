{
  "CharacterId": 20047,
  "DialogJP": [
    {
      "Id": 200470010,
      "Speaker": "Student",
      "Text": "先生ってちゃんと休み取れてるの？"
    },
    {
      "Id": 200470020,
      "Speaker": "Player",
      "Text": "も、もちろんだよ？"
    },
    {
      "Id": 200470030,
      "Speaker": "Player",
      "Text": "オフィスのクーラーって最高だよね！"
    },
    {
      "Id": 200470040,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200470050,
      "Speaker": "Student",
      "Text": "だと思った"
    },
    {
      "Id": 200470060,
      "Speaker": "Student",
      "Text": "どうせ働きづめなんでしょ？"
    },
    {
      "Id": 200470070,
      "Speaker": "Player",
      "Text": "キキョウはどうなの？"
    },
    {
      "Id": 200470080,
      "Speaker": "Student",
      "Text": "私の計画に抜かりがあると思う？"
    },
    {
      "Id": 200470090,
      "Speaker": "Player",
      "Text": "い、一体なにを……！？"
    },
    {
      "Id": 200470100,
      "Speaker": "Student",
      "Text": "教えない"
    },
    {
      "Id": 200470110,
      "Speaker": "Student",
      "Text": "気になるなら……来てみれば？"
    },
    {
      "Id": 200470120,
      "Speaker": "Student",
      "Text": "今、私以外に誰もいないから"
    },
    {
      "Id": 200470130,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "すぐ行きます！"
    },
    {
      "Id": 200470140,
      "Speaker": "Student",
      "Text": "はい、清書したスケジュール"
    },
    {
      "Id": 200470150,
      "Speaker": "Student",
      "Text": "送ったから確認しておいて"
    },
    {
      "Id": 200470160,
      "Speaker": "Player",
      "Text": "楽しみだね！"
    },
    {
      "Id": 200470170,
      "Speaker": "Student",
      "Text": "当たり前"
    },
    {
      "Id": 200470180,
      "Speaker": "Student",
      "Text": "あれだけ考えたんだから、計画は完璧"
    },
    {
      "Id": 200470190,
      "Speaker": "Student",
      "Text": "それじゃ"
    },
    {
      "Id": 200470200,
      "Speaker": "Student",
      "Text": "あ、そうだ"
    },
    {
      "Id": 200470210,
      "Speaker": "Student",
      "Text": "他の子たちには内緒だからね"
    },
    {
      "Id": 200470220,
      "Speaker": "Student",
      "Text": "絶対に"
    },
    {
      "Id": 200470230,
      "Speaker": "Student",
      "Text": "分かった？"
    },
    {
      "Id": 200470240,
      "Speaker": "Student",
      "Text": "明日が何の日か覚えてる？"
    },
    {
      "Id": 200470250,
      "Speaker": "Player",
      "Text": "キキョウの誕生日？"
    },
    {
      "Id": 200470260,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200470270,
      "Speaker": "Student",
      "Text": "たしかに"
    },
    {
      "Id": 200470280,
      "Speaker": "Student",
      "Text": "私の誕生日は夏だけど"
    },
    {
      "Id": 200470290,
      "Speaker": "Student",
      "Text": "分かりにくいボケをするのはやめて"
    },
    {
      "Id": 200470300,
      "Speaker": "Student",
      "Text": "まぁ？たくさんの生徒と交流してる先生なら？"
    },
    {
      "Id": 200470310,
      "Speaker": "Student",
      "Text": "勘違いすることもあるかもしれないけど？"
    },
    {
      "Id": 200470320,
      "Speaker": "Player",
      "Text": "冗談だよ！"
    },
    {
      "Id": 200470330,
      "Speaker": "Player",
      "Text": "海に行く日だよね！"
    },
    {
      "Id": 200470340,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200470350,
      "Speaker": "Student",
      "Text": "なんだ"
    },
    {
      "Id": 200470360,
      "Speaker": "Student",
      "Text": "ちゃんと覚えてるんだ"
    },
    {
      "Id": 200470370,
      "Speaker": "Player",
      "Text": "海に行くの"
    },
    {
      "Id": 200470380,
      "Speaker": "Player",
      "Text": "楽しみにしてくれてたんだね"
    },
    {
      "Id": 200470390,
      "Speaker": "Student",
      "Text": "……どういう意味？"
    },
    {
      "Id": 200470400,
      "Speaker": "Student",
      "Text": "とにかく明日、時間通りに"
    },
    {
      "Id": 200470410,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "遅れるなら……覚悟してね"
    },
    {
      "Id": 200470420,
      "Speaker": "Student",
      "Text": "その……今日は楽しかった"
    },
    {
      "Id": 200470430,
      "Speaker": "Student",
      "Text": "水に入るのも、案外悪くないかも"
    },
    {
      "Id": 200470440,
      "Speaker": "Student",
      "Text": "こんなの初めて"
    },
    {
      "Id": 200470450,
      "Speaker": "Player",
      "Text": "私も楽しかったよ！"
    },
    {
      "Id": 200470460,
      "Speaker": "Player",
      "Text": "また行こうね！"
    },
    {
      "Id": 200470470,
      "Speaker": "Student",
      "Text": "また？"
    },
    {
      "Id": 200470480,
      "Speaker": "Student",
      "Text": "……二人きりで？"
    },
    {
      "Id": 200470490,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 200470500,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 200470510,
      "Speaker": "Student",
      "Text": "分かった"
    },
    {
      "Id": 200470520,
      "Speaker": "Student",
      "Text": "じゃあ先生の空いている日を教えて"
    },
    {
      "Id": 200470530,
      "Speaker": "Student",
      "Text": "私も合わせるから"
    },
    {
      "Id": 200470540,
      "Speaker": "Student",
      "Text": "それと……"
    },
    {
      "Id": 200470550,
      "Speaker": "Student",
      "Text": "今日できなかった事もやってみたい"
    },
    {
      "Id": 200470560,
      "Speaker": "Student",
      "Text": "何をするかは……"
    },
    {
      "Id": 200470570,
      "Speaker": "Student",
      "Text": "当日のお楽しみ"
    },
    {
      "Id": 200470580,
      "Speaker": "Student",
      "Text": "念のため"
    },
    {
      "Id": 200470590,
      "Speaker": "Student",
      "Text": "明日が何の日か分かってるよね？"
    },
    {
      "Id": 200470600,
      "Speaker": "Player",
      "Text": "キキョウが楽しみにしてる日！"
    },
    {
      "Id": 200470610,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200470620,
      "Speaker": "Student",
      "Text": "何言ってるの"
    },
    {
      "Id": 200470630,
      "Speaker": "Student",
      "Text": "それはあんたもでしょ"
    },
    {
      "Id": 200470640,
      "Speaker": "Student",
      "Text": "前とは違う海岸だから"
    },
    {
      "Id": 200470650,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "間違えないようにね"
    },
    {
      "Id": 200470660,
      "Speaker": "Student",
      "Text": "どう？"
    },
    {
      "Id": 200470670,
      "Speaker": "Student",
      "Text": "疲れは取れた？"
    },
    {
      "Id": 200470680,
      "Speaker": "Player",
      "Text": "体が軽くなった気がする！"
    },
    {
      "Id": 200470690,
      "Speaker": "Player",
      "Text": "ちゃんとリフレッシュできたかも！"
    },
    {
      "Id": 200470700,
      "Speaker": "Student",
      "Text": "私もすっきりした"
    },
    {
      "Id": 200470710,
      "Speaker": "Student",
      "Text": "……先生"
    },
    {
      "Id": 200470720,
      "Speaker": "Student",
      "Text": "海でやりたいこと、他にもあるんだけど……"
    },
    {
      "Id": 200470730,
      "Speaker": "Student",
      "Text": "また誘ってもいい？"
    },
    {
      "Id": 200470740,
      "Speaker": "Player",
      "Text": "いつでも呼んで！"
    },
    {
      "Id": 200470750,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 200470760,
      "Speaker": "Student",
      "Text": "じゃあ、今度また連絡する"
    },
    {
      "Id": 200470770,
      "Speaker": "Student",
      "Text": "えっと"
    },
    {
      "Id": 200470780,
      "Speaker": "Student",
      "Text": "楽しみにしてるから"
    },
    {
      "Id": 200470790,
      "Speaker": "Student",
      "Text": "明日なんだけど"
    },
    {
      "Id": 200470800,
      "Speaker": "Student",
      "Text": "ちょっとやることがあって"
    },
    {
      "Id": 200470810,
      "Speaker": "Student",
      "Text": "私は先に行くから"
    },
    {
      "Id": 200470820,
      "Speaker": "Student",
      "Text": "現地集合でお願い"
    },
    {
      "Id": 200470830,
      "Speaker": "Player",
      "Text": "何か手伝おうか？"
    },
    {
      "Id": 200470840,
      "Speaker": "Student",
      "Text": "お気遣いどうも"
    },
    {
      "Id": 200470850,
      "Speaker": "Student",
      "Text": "でも、大丈夫"
    },
    {
      "Id": 200470860,
      "Speaker": "Student",
      "Text": "先生はゆっくり、時間通り来てくれればそれでいいから"
    },
    {
      "Id": 200470870,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "……遅刻したら許さない"
    },
    {
      "Id": 200470880,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200470890,
      "Speaker": "Student",
      "Text": "ちゃんと帰れた？"
    },
    {
      "Id": 200470900,
      "Speaker": "Student",
      "Text": "その……今日のことは"
    },
    {
      "Id": 200470910,
      "Speaker": "Student",
      "Text": "みんなに内緒だから"
    },
    {
      "Id": 200470920,
      "Speaker": "Player",
      "Text": "二人だけの秘密だね！"
    },
    {
      "Id": 200470930,
      "Speaker": "Student",
      "Text": "えっ"
    },
    {
      "Id": 200470940,
      "Speaker": "Student",
      "Text": "まあ、うん"
    },
    {
      "Id": 200470950,
      "Speaker": "Player",
      "Text": "それよりキキョウ"
    },
    {
      "Id": 200470960,
      "Speaker": "Student",
      "Text": "ん？"
    },
    {
      "Id": 200470970,
      "Speaker": "Student",
      "Text": "何？"
    },
    {
      "Id": 200470980,
      "Speaker": "Player",
      "Text": "ハンモックで遊ぶ猫の動画を送ってあげるね"
    },
    {
      "Id": 200470990,
      "Speaker": "Student",
      "Text": "なんで？"
    },
    {
      "Id": 200471000,
      "Speaker": "Student",
      "Text": "別に興味は無いんだけど……"
    },
    {
      "Id": 200471010,
      "Speaker": "Student",
      "Text": "はあ……まあいいや。またね"
    }
  ],
  "DialogKR": [
    {
      "Id": 200470010,
      "Speaker": "Student",
      "Text": "선생님은 휴식을 제대로 취하고 있어?"
    },
    {
      "Id": 200470020,
      "Speaker": "Player",
      "Text": "물론이지!"
    },
    {
      "Id": 200470030,
      "Speaker": "Player",
      "Text": "사무실 에어컨 최고!"
    },
    {
      "Id": 200470040,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 200470050,
      "Speaker": "Student",
      "Text": "역시 그럴 줄 알았어."
    },
    {
      "Id": 200470060,
      "Speaker": "Student",
      "Text": "사무실에 있다면 쉬는 게 아니잖아."
    },
    {
      "Id": 200470070,
      "Speaker": "Player",
      "Text": "그러는 키쿄는 잘 쉬고 있어?"
    },
    {
      "Id": 200470080,
      "Speaker": "Student",
      "Text": "내 계획에 빈틈이 있을 거라고 생각해?"
    },
    {
      "Id": 200470090,
      "Speaker": "Player",
      "Text": "도, 도대체 무슨……?"
    },
    {
      "Id": 200470100,
      "Speaker": "Student",
      "Text": "안 알려줘."
    },
    {
      "Id": 200470110,
      "Speaker": "Student",
      "Text": "궁금하면…… 직접 와보던가."
    },
    {
      "Id": 200470120,
      "Speaker": "Student",
      "Text": "지금은 나 말고 아무도 없으니까."
    },
    {
      "Id": 200470130,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "당장 가겠습니다!"
    },
    {
      "Id": 200470140,
      "Speaker": "Student",
      "Text": "선생님이 돌아간 사이에 휴가 일정을 완성했어."
    },
    {
      "Id": 200470150,
      "Speaker": "Student",
      "Text": "바로 보내줄 테니까 확인해 봐."
    },
    {
      "Id": 200470160,
      "Speaker": "Player",
      "Text": "후후, 기대된다!"
    },
    {
      "Id": 200470170,
      "Speaker": "Student",
      "Text": "당연하지."
    },
    {
      "Id": 200470180,
      "Speaker": "Student",
      "Text": "나와 당신이 세운 완벽한 계획이니까."
    },
    {
      "Id": 200470190,
      "Speaker": "Student",
      "Text": "그럼 약속일에 보자."
    },
    {
      "Id": 200470200,
      "Speaker": "Student",
      "Text": "아, 참. 혹시나 해서 하는 말인데."
    },
    {
      "Id": 200470210,
      "Speaker": "Student",
      "Text": "다른 아이들에겐 말하지 마."
    },
    {
      "Id": 200470220,
      "Speaker": "Student",
      "Text": "절대로."
    },
    {
      "Id": 200470230,
      "Speaker": "Student",
      "Text": "알겠지?"
    },
    {
      "Id": 200470240,
      "Speaker": "Student",
      "Text": "선생님. 내일이 무슨 날인지 기억해?"
    },
    {
      "Id": 200470250,
      "Speaker": "Player",
      "Text": "어…… 키쿄의 생일?"
    },
    {
      "Id": 200470260,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 200470270,
      "Speaker": "Student",
      "Text": "확실히"
    },
    {
      "Id": 200470280,
      "Speaker": "Student",
      "Text": "내 생일은 여름이지만"
    },
    {
      "Id": 200470290,
      "Speaker": "Student",
      "Text": "이해하기 어려운 농담은 그만해줘."
    },
    {
      "Id": 200470300,
      "Speaker": "Student",
      "Text": "뭐, 많은 학생과 교류하는 선생님이라면"
    },
    {
      "Id": 200470310,
      "Speaker": "Student",
      "Text": "착각할 수도 있겠지만?"
    },
    {
      "Id": 200470320,
      "Speaker": "Player",
      "Text": "노, 농담이야!"
    },
    {
      "Id": 200470330,
      "Speaker": "Player",
      "Text": "바다에 가기로 한 날이잖아!"
    },
    {
      "Id": 200470340,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 200470350,
      "Speaker": "Student",
      "Text": "뭐야."
    },
    {
      "Id": 200470360,
      "Speaker": "Student",
      "Text": "제대로 기억하고 있었네."
    },
    {
      "Id": 200470370,
      "Speaker": "Player",
      "Text": "정말 기대하고 있었나 보네."
    },
    {
      "Id": 200470380,
      "Speaker": "Player",
      "Text": "같이 바다에 가는 거."
    },
    {
      "Id": 200470390,
      "Speaker": "Student",
      "Text": "무슨 말인지 잘 모르겠네."
    },
    {
      "Id": 200470400,
      "Speaker": "Student",
      "Text": "그럼 내일 보자."
    },
    {
      "Id": 200470410,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "늦으면 정말로 화낼 테니까."
    },
    {
      "Id": 200470420,
      "Speaker": "Student",
      "Text": "그…… 오늘 즐거웠어."
    },
    {
      "Id": 200470430,
      "Speaker": "Student",
      "Text": "물에 들어가는 게 즐거울 줄이야."
    },
    {
      "Id": 200470440,
      "Speaker": "Student",
      "Text": "이런 경험은 또 처음이네."
    },
    {
      "Id": 200470450,
      "Speaker": "Player",
      "Text": "나도 즐거웠어!"
    },
    {
      "Id": 200470460,
      "Speaker": "Player",
      "Text": "다음에 또 바다에 가자!"
    },
    {
      "Id": 200470470,
      "Speaker": "Student",
      "Text": "또 가자고?"
    },
    {
      "Id": 200470480,
      "Speaker": "Student",
      "Text": "……이번에도 단둘이?"
    },
    {
      "Id": 200470490,
      "Speaker": "Player",
      "Text": "응! 단둘이!"
    },
    {
      "Id": 200470500,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 200470510,
      "Speaker": "Student",
      "Text": "좋아. 알겠어."
    },
    {
      "Id": 200470520,
      "Speaker": "Student",
      "Text": "그럼 비는 일정을 말해줘."
    },
    {
      "Id": 200470530,
      "Speaker": "Student",
      "Text": "나도 거기에 시간을 맞춰볼 테니까."
    },
    {
      "Id": 200470540,
      "Speaker": "Student",
      "Text": "그리고……."
    },
    {
      "Id": 200470550,
      "Speaker": "Student",
      "Text": "다음엔 오늘 못했던 걸 해보자."
    },
    {
      "Id": 200470560,
      "Speaker": "Student",
      "Text": "그게 뭔지는 나중에 알려줄게."
    },
    {
      "Id": 200470570,
      "Speaker": "Student",
      "Text": "기대해도 좋아."
    },
    {
      "Id": 200470580,
      "Speaker": "Student",
      "Text": "혹시 모르니까"
    },
    {
      "Id": 200470590,
      "Speaker": "Student",
      "Text": "내일이 무슨 날인지 알고 있지?"
    },
    {
      "Id": 200470600,
      "Speaker": "Player",
      "Text": "키쿄가 기대하고 기대하던 날!"
    },
    {
      "Id": 200470610,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 200470620,
      "Speaker": "Student",
      "Text": "무슨 소리야."
    },
    {
      "Id": 200470630,
      "Speaker": "Student",
      "Text": "기대는 당신이 더 하고 있었겠지."
    },
    {
      "Id": 200470640,
      "Speaker": "Student",
      "Text": "저번과는 다른 해안이니까."
    },
    {
      "Id": 200470650,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "착각하면 안 돼."
    },
    {
      "Id": 200470660,
      "Speaker": "Student",
      "Text": "후후……."
    },
    {
      "Id": 200470670,
      "Speaker": "Student",
      "Text": "오늘 일로 피로가 풀렸을까?"
    },
    {
      "Id": 200470680,
      "Speaker": "Player",
      "Text": "근육통이 싹 나았어!"
    },
    {
      "Id": 200470690,
      "Speaker": "Player",
      "Text": "피로가 싹 사라졌어!"
    },
    {
      "Id": 200470700,
      "Speaker": "Student",
      "Text": "나도 모래찜질 덕분에 상쾌한 기분이야."
    },
    {
      "Id": 200470710,
      "Speaker": "Student",
      "Text": "……선생님"
    },
    {
      "Id": 200470720,
      "Speaker": "Student",
      "Text": "바다에서 하고 싶은 거, 또 있는데……"
    },
    {
      "Id": 200470730,
      "Speaker": "Student",
      "Text": "시간 괜찮겠지?"
    },
    {
      "Id": 200470740,
      "Speaker": "Player",
      "Text": "언제든 불러만 줘!"
    },
    {
      "Id": 200470750,
      "Speaker": "Student",
      "Text": "후후, 그래."
    },
    {
      "Id": 200470760,
      "Speaker": "Student",
      "Text": "그럼 다음에 또 연락할게."
    },
    {
      "Id": 200470770,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200470780,
      "Speaker": "Student",
      "Text": "기대하고 있을 테니까."
    },
    {
      "Id": 200470790,
      "Speaker": "Student",
      "Text": "내일 말인데."
    },
    {
      "Id": 200470800,
      "Speaker": "Student",
      "Text": "좀 할 일이 있어서"
    },
    {
      "Id": 200470810,
      "Speaker": "Student",
      "Text": "나는 먼저 가 있을 테니까."
    },
    {
      "Id": 200470820,
      "Speaker": "Student",
      "Text": "약속 장소에서 만나."
    },
    {
      "Id": 200470830,
      "Speaker": "Player",
      "Text": "뭐라도 도와줄까?"
    },
    {
      "Id": 200470840,
      "Speaker": "Student",
      "Text": "신경 써줘서 고마워."
    },
    {
      "Id": 200470850,
      "Speaker": "Student",
      "Text": "그래도, 괜찮아."
    },
    {
      "Id": 200470860,
      "Speaker": "Student",
      "Text": "선생님은 천천히 시간에 맞춰서 와주면 되니까."
    },
    {
      "Id": 200470870,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "……지각하면 용서 안 해."
    },
    {
      "Id": 200470880,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 200470890,
      "Speaker": "Student",
      "Text": "잘 들어갔지?"
    },
    {
      "Id": 200470900,
      "Speaker": "Student",
      "Text": "그…… 오늘 있었던 일들"
    },
    {
      "Id": 200470910,
      "Speaker": "Student",
      "Text": "모두에겐 비밀이니까."
    },
    {
      "Id": 200470920,
      "Speaker": "Player",
      "Text": "둘만의 비밀이네!"
    },
    {
      "Id": 200470930,
      "Speaker": "Student",
      "Text": "엇"
    },
    {
      "Id": 200470940,
      "Speaker": "Student",
      "Text": "뭐, 응."
    },
    {
      "Id": 200470950,
      "Speaker": "Player",
      "Text": "그나저나 키쿄."
    },
    {
      "Id": 200470960,
      "Speaker": "Student",
      "Text": "응?"
    },
    {
      "Id": 200470970,
      "Speaker": "Student",
      "Text": "왜?"
    },
    {
      "Id": 200470980,
      "Speaker": "Player",
      "Text": "그물침대에서 노는 고양이 동영상을 보내줄게."
    },
    {
      "Id": 200470990,
      "Speaker": "Student",
      "Text": "왜?"
    },
    {
      "Id": 200471000,
      "Speaker": "Student",
      "Text": "딱히 관심 없는데……"
    },
    {
      "Id": 200471010,
      "Speaker": "Student",
      "Text": "하아…… 뭐 좋아. 또 봐."
    }
  ],
  "DialogEN": [
    {
      "Id": 200470010,
      "Speaker": "Student",
      "Text": "Have you been getting proper rest, Sensei?"
    },
    {
      "Id": 200470020,
      "Speaker": "Player",
      "Text": "Of course!"
    },
    {
      "Id": 200470030,
      "Speaker": "Player",
      "Text": "I love the office AC!"
    },
    {
      "Id": 200470040,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200470050,
      "Speaker": "Student",
      "Text": "As I suspected."
    },
    {
      "Id": 200470060,
      "Speaker": "Student",
      "Text": "You cannot achieve proper rest in an office."
    },
    {
      "Id": 200470070,
      "Speaker": "Player",
      "Text": "Well, what about you, Kikyou? Have you been resting?"
    },
    {
      "Id": 200470080,
      "Speaker": "Student",
      "Text": "Are you accusing me of formulating a flawed operation?"
    },
    {
      "Id": 200470090,
      "Speaker": "Player",
      "Text": "What does that even...?"
    },
    {
      "Id": 200470100,
      "Speaker": "Student",
      "Text": "I won't tell you."
    },
    {
      "Id": 200470110,
      "Speaker": "Student",
      "Text": "If you'd like to know... You can come see with your own eyes."
    },
    {
      "Id": 200470120,
      "Speaker": "Student",
      "Text": "It is only I at the clubroom at the moment."
    },
    {
      "Id": 200470130,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "I'm on my way!"
    },
    {
      "Id": 200470140,
      "Speaker": "Student",
      "Text": "I completed the vacation plan after you departed."
    },
    {
      "Id": 200470150,
      "Speaker": "Student",
      "Text": "I will send it your way. Please review it."
    },
    {
      "Id": 200470160,
      "Speaker": "Player",
      "Text": "Fufu, I'm looking forward to it!"
    },
    {
      "Id": 200470170,
      "Speaker": "Student",
      "Text": "Naturally."
    },
    {
      "Id": 200470180,
      "Speaker": "Student",
      "Text": "It is the perfect plan we concocted together."
    },
    {
      "Id": 200470190,
      "Speaker": "Student",
      "Text": "Until next time."
    },
    {
      "Id": 200470200,
      "Speaker": "Student",
      "Text": "Ah. I would just like to say."
    },
    {
      "Id": 200470210,
      "Speaker": "Student",
      "Text": "Do not ever speak of this to the others."
    },
    {
      "Id": 200470220,
      "Speaker": "Student",
      "Text": "Never."
    },
    {
      "Id": 200470230,
      "Speaker": "Student",
      "Text": "Understood?"
    },
    {
      "Id": 200470240,
      "Speaker": "Student",
      "Text": "Sensei. Do you recall what tomorrow is?"
    },
    {
      "Id": 200470250,
      "Speaker": "Player",
      "Text": "Uh... Kikyou's birthday?"
    },
    {
      "Id": 200470260,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200470270,
      "Speaker": "Student",
      "Text": "Well"
    },
    {
      "Id": 200470280,
      "Speaker": "Student",
      "Text": "my birthday does take place during the summer."
    },
    {
      "Id": 200470290,
      "Speaker": "Student",
      "Text": "However, I must request that you abandon these befuddling jokes."
    },
    {
      "Id": 200470300,
      "Speaker": "Student",
      "Text": "Or perhaps you were confused"
    },
    {
      "Id": 200470310,
      "Speaker": "Student",
      "Text": "since you speak with such a large number of students?"
    },
    {
      "Id": 200470320,
      "Speaker": "Player",
      "Text": "I was kidding! Just kidding! I do know!"
    },
    {
      "Id": 200470330,
      "Speaker": "Player",
      "Text": "We're going to the beach!"
    },
    {
      "Id": 200470340,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200470350,
      "Speaker": "Student",
      "Text": "Huh."
    },
    {
      "Id": 200470360,
      "Speaker": "Student",
      "Text": "So you did remember."
    },
    {
      "Id": 200470370,
      "Speaker": "Player",
      "Text": "I guess you really were looking forward to today!"
    },
    {
      "Id": 200470380,
      "Speaker": "Player",
      "Text": "Are you excited we're going to the beach?"
    },
    {
      "Id": 200470390,
      "Speaker": "Student",
      "Text": "I won't deign to that nonsense with a response."
    },
    {
      "Id": 200470400,
      "Speaker": "Student",
      "Text": "Then, we shall meet tomorrow."
    },
    {
      "Id": 200470410,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "I'll be quite infuriated if you dare be late."
    },
    {
      "Id": 200470420,
      "Speaker": "Student",
      "Text": "Um... I enjoyed myself today."
    },
    {
      "Id": 200470430,
      "Speaker": "Student",
      "Text": "I did not expect going into the water to be...fun."
    },
    {
      "Id": 200470440,
      "Speaker": "Student",
      "Text": "It was a new experience for me."
    },
    {
      "Id": 200470450,
      "Speaker": "Player",
      "Text": "I had fun too!"
    },
    {
      "Id": 200470460,
      "Speaker": "Player",
      "Text": "Let's go again sometime!"
    },
    {
      "Id": 200470470,
      "Speaker": "Student",
      "Text": "Again?"
    },
    {
      "Id": 200470480,
      "Speaker": "Student",
      "Text": "...Just the two of us, again?"
    },
    {
      "Id": 200470490,
      "Speaker": "Player",
      "Text": "Yep! Just the two of us!"
    },
    {
      "Id": 200470500,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200470510,
      "Speaker": "Student",
      "Text": "Understood."
    },
    {
      "Id": 200470520,
      "Speaker": "Student",
      "Text": "Reach out with your availability."
    },
    {
      "Id": 200470530,
      "Speaker": "Student",
      "Text": "I will match my schedule to yours."
    },
    {
      "Id": 200470540,
      "Speaker": "Student",
      "Text": "And..."
    },
    {
      "Id": 200470550,
      "Speaker": "Student",
      "Text": "We will attempt something different next time as well."
    },
    {
      "Id": 200470560,
      "Speaker": "Student",
      "Text": "You'll find out then."
    },
    {
      "Id": 200470570,
      "Speaker": "Student",
      "Text": "Simply...look forward to it for now."
    },
    {
      "Id": 200470580,
      "Speaker": "Student",
      "Text": "Surely I don't even need to check..."
    },
    {
      "Id": 200470590,
      "Speaker": "Student",
      "Text": "You know what day tomorrow is, right?"
    },
    {
      "Id": 200470600,
      "Speaker": "Player",
      "Text": "The day you've been looking forward to!"
    },
    {
      "Id": 200470610,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200470620,
      "Speaker": "Student",
      "Text": "What are you saying?"
    },
    {
      "Id": 200470630,
      "Speaker": "Student",
      "Text": "Clearly, you are the one filled with anticipation."
    },
    {
      "Id": 200470640,
      "Speaker": "Student",
      "Text": "The location is at a different beach."
    },
    {
      "Id": 200470650,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Don't get lost."
    },
    {
      "Id": 200470660,
      "Speaker": "Student",
      "Text": "Fufu..."
    },
    {
      "Id": 200470670,
      "Speaker": "Student",
      "Text": "Do you feel relaxed after today?"
    },
    {
      "Id": 200470680,
      "Speaker": "Player",
      "Text": "My body doesn't ache anymore!"
    },
    {
      "Id": 200470690,
      "Speaker": "Player",
      "Text": "My fatigue is gone!"
    },
    {
      "Id": 200470700,
      "Speaker": "Student",
      "Text": "Yes. I enjoyed the sand bath as well."
    },
    {
      "Id": 200470710,
      "Speaker": "Student",
      "Text": "...Sensei."
    },
    {
      "Id": 200470720,
      "Speaker": "Student",
      "Text": "I have another thing I wish to do at the beach."
    },
    {
      "Id": 200470730,
      "Speaker": "Student",
      "Text": "You have the availability, yes?"
    },
    {
      "Id": 200470740,
      "Speaker": "Player",
      "Text": "Anytime!"
    },
    {
      "Id": 200470750,
      "Speaker": "Student",
      "Text": "Fufu, okay."
    },
    {
      "Id": 200470760,
      "Speaker": "Student",
      "Text": "I shall reach out."
    },
    {
      "Id": 200470770,
      "Speaker": "Student",
      "Text": "Mm"
    },
    {
      "Id": 200470780,
      "Speaker": "Student",
      "Text": "Our next meeting... I'll look forward to it."
    },
    {
      "Id": 200470790,
      "Speaker": "Student",
      "Text": "About tomorrow."
    },
    {
      "Id": 200470800,
      "Speaker": "Student",
      "Text": "I have some things to attend to,"
    },
    {
      "Id": 200470810,
      "Speaker": "Student",
      "Text": "so I will be in the area early."
    },
    {
      "Id": 200470820,
      "Speaker": "Student",
      "Text": "Come to our meeting spot."
    },
    {
      "Id": 200470830,
      "Speaker": "Player",
      "Text": "Can I help you with your errands?"
    },
    {
      "Id": 200470840,
      "Speaker": "Student",
      "Text": "I appreciate the sentiment."
    },
    {
      "Id": 200470850,
      "Speaker": "Student",
      "Text": "But I will be fine."
    },
    {
      "Id": 200470860,
      "Speaker": "Student",
      "Text": "You may come at your leisure."
    },
    {
      "Id": 200470870,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "...However, I won't forgive you if you're late."
    },
    {
      "Id": 200470880,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 200470890,
      "Speaker": "Student",
      "Text": "Did you return safely?"
    },
    {
      "Id": 200470900,
      "Speaker": "Student",
      "Text": "Regarding today's events..."
    },
    {
      "Id": 200470910,
      "Speaker": "Student",
      "Text": "They should remain between you and me, understood?"
    },
    {
      "Id": 200470920,
      "Speaker": "Player",
      "Text": "So it's our special secret!"
    },
    {
      "Id": 200470930,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 200470940,
      "Speaker": "Student",
      "Text": "I suppose"
    },
    {
      "Id": 200470950,
      "Speaker": "Player",
      "Text": "By the way, Kikyou!"
    },
    {
      "Id": 200470960,
      "Speaker": "Student",
      "Text": "Hm?"
    },
    {
      "Id": 200470970,
      "Speaker": "Student",
      "Text": "What is it?"
    },
    {
      "Id": 200470980,
      "Speaker": "Player",
      "Text": "I'll send you a video of cat playing in a hammock!"
    },
    {
      "Id": 200470990,
      "Speaker": "Student",
      "Text": "What?"
    },
    {
      "Id": 200471000,
      "Speaker": "Student",
      "Text": "I have no particular need of..."
    },
    {
      "Id": 200471010,
      "Speaker": "Student",
      "Text": "Ugh. Fine. I'll speak with you later."
    }
  ],
  "DialogTH": [
    {
      "Id": 200470010,
      "Speaker": "Student",
      "Text": "คุณครูกำลังพักผ่อนสบายๆ อยู่\nหรือเปล่า?"
    },
    {
      "Id": 200470020,
      "Speaker": "Player",
      "Text": "อื้อ!"
    },
    {
      "Id": 200470030,
      "Speaker": "Player",
      "Text": "แอร์ที่สำนักงานเย็นฉ่ำเลยละ!"
    },
    {
      "Id": 200470040,
      "Speaker": "Student",
      "Text": "......"
    },
    {
      "Id": 200470050,
      "Speaker": "Student",
      "Text": "กะไว้แล้วว่าต้องเป็นแบบนี้"
    },
    {
      "Id": 200470060,
      "Speaker": "Student",
      "Text": "ถ้าอยู่ที่สำนักงาน ก็ไม่ได้กำลังพักผ่อน\nน่ะสิ"
    },
    {
      "Id": 200470070,
      "Speaker": "Player",
      "Text": "แล้วคิเคียวพักผ่อนอยู่หรือเปล่า?"
    },
    {
      "Id": 200470080,
      "Speaker": "Student",
      "Text": "คิดว่าแผนการของฉันจะมีจุดบกพร่อง\nงั้นเหรอ?"
    },
    {
      "Id": 200470090,
      "Speaker": "Player",
      "Text": "มะ... หมายความว่ายังไง...?"
    },
    {
      "Id": 200470100,
      "Speaker": "Student",
      "Text": "ไม่บอกหรอก"
    },
    {
      "Id": 200470110,
      "Speaker": "Student",
      "Text": "ถ้าอยากรู้ก็... มาดูเองกับตาสิ"
    },
    {
      "Id": 200470120,
      "Speaker": "Student",
      "Text": "ตอนนี้มีแค่ฉันคนเดียวนะ"
    },
    {
      "Id": 200470130,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "ครูจะไปเดี๋ยวนี้ละ!"
    },
    {
      "Id": 200470140,
      "Speaker": "Student",
      "Text": "ระหว่างที่คุณครูกลับไป ฉันวางแผน\nพักร้อนจนเสร็จเลย"
    },
    {
      "Id": 200470150,
      "Speaker": "Student",
      "Text": "ฉันจะส่งให้ดูเดี๋ยวนี้เลย ลองเปิดดูสิ"
    },
    {
      "Id": 200470160,
      "Speaker": "Player",
      "Text": "ฮุฮุ อยากเห็นแล้วสิ!"
    },
    {
      "Id": 200470170,
      "Speaker": "Student",
      "Text": "ต้องอย่างนั้นละ"
    },
    {
      "Id": 200470180,
      "Speaker": "Student",
      "Text": "ก็มันเป็นแผนการที่สมบูรณ์แบบ\nของเรานี่นา"
    },
    {
      "Id": 200470190,
      "Speaker": "Student",
      "Text": "งั้นเอาไว้เจอกันตามนัดนะ"
    },
    {
      "Id": 200470200,
      "Speaker": "Student",
      "Text": "อ้อ จริงสิ ฉันแค่พูดไว้เผื่อๆ นะ"
    },
    {
      "Id": 200470210,
      "Speaker": "Student",
      "Text": "อย่าไปบอกคนอื่นล่ะ"
    },
    {
      "Id": 200470220,
      "Speaker": "Student",
      "Text": "ห้ามเด็ดขาดเลย"
    },
    {
      "Id": 200470230,
      "Speaker": "Student",
      "Text": "เข้าใจมั้ย?"
    },
    {
      "Id": 200470240,
      "Speaker": "Student",
      "Text": "คุณครู จำได้หรือเปล่าว่าพรุ่งนี้วันอะไร?"
    },
    {
      "Id": 200470250,
      "Speaker": "Player",
      "Text": "อ่า... วันเกิดคิเคียว?"
    },
    {
      "Id": 200470260,
      "Speaker": "Student",
      "Text": "......"
    },
    {
      "Id": 200470270,
      "Speaker": "Student",
      "Text": "จริงๆ เลย"
    },
    {
      "Id": 200470280,
      "Speaker": "Student",
      "Text": "ก็จริงอยู่หรอกที่ฉันเกิดในฤดูร้อน"
    },
    {
      "Id": 200470290,
      "Speaker": "Student",
      "Text": "แต่เลิกล้อเล่นในเรื่องที่เข้าใจยากได้แล้ว"
    },
    {
      "Id": 200470300,
      "Speaker": "Student",
      "Text": "แต่ถ้าเป็นคุณครูที่ต้องติดต่อกับ\nนักเรียนหลายคน"
    },
    {
      "Id": 200470310,
      "Speaker": "Student",
