{
  "CharacterId": 20062,
  "DialogJP": [
    {
      "Id": 200620010,
      "Speaker": "Student",
      "Text": "せんせー、こんちゃー！"
    },
    {
      "Id": 200620020,
      "Speaker": "Student",
      "Text": "わたしはだれでしょーか？"
    },
    {
      "Id": 200620030,
      "Speaker": "Player",
      "Text": "君は二木エリナだな！"
    },
    {
      "Id": 200620040,
      "Speaker": "Player",
      "Text": "正体見たり！"
    },
    {
      "Id": 200620050,
      "Speaker": "Student",
      "Text": "な、なんで分かるんですか！話し方も変えたのに！"
    },
    {
      "Id": 200620060,
      "Speaker": "Student",
      "Text": "まさか、あれ保存してたんですか？"
    },
    {
      "Id": 200620070,
      "Speaker": "Student",
      "Text": "えっと、なんだっけ……"
    },
    {
      "Id": 200620080,
      "Speaker": "Student",
      "Text": "あれです、あれ！"
    },
    {
      "Id": 200620090,
      "Speaker": "Player",
      "Text": "連絡先？"
    },
    {
      "Id": 200620100,
      "Speaker": "Student",
      "Text": "そうそれです！ちょっと思い出せなくって……"
    },
    {
      "Id": 200620110,
      "Speaker": "Student",
      "Text": "だから私だって分かったんですね"
    },
    {
      "Id": 200620120,
      "Speaker": "Student",
      "Text": "そういえば、今日研究を手伝ってもらうことってできますか？"
    },
    {
      "Id": 200620130,
      "Speaker": "Player",
      "Text": "もちろん大丈夫！"
    },
    {
      "Id": 200620140,
      "Speaker": "Student",
      "Text": "やりぃ～！"
    },
    {
      "Id": 200620150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "じゃあ183号で！"
    },
    {
      "Id": 200620160,
      "Speaker": "Student",
      "Text": "先生のおかげで研究データがたくさん集まりました！"
    },
    {
      "Id": 200620170,
      "Speaker": "Student",
      "Text": "いぇ～い！やりぃ～！"
    },
    {
      "Id": 200620180,
      "Speaker": "Student",
      "Text": "やっぱり料理は化学、ですね！"
    },
    {
      "Id": 200620190,
      "Speaker": "Player",
      "Text": "本当においしかったよ！"
    },
    {
      "Id": 200620200,
      "Speaker": "Player",
      "Text": "まさか調味料をその場で作るとは思わなかったけど！"
    },
    {
      "Id": 200620210,
      "Speaker": "Student",
      "Text": "あんなのヨユーです！いぇいいぇい♪"
    },
    {
      "Id": 200620220,
      "Speaker": "Student",
      "Text": "醤油は昨日作っといてよかった～！"
    },
    {
      "Id": 200620230,
      "Speaker": "Student",
      "Text": "またなんか作るんで、遊びに来てくださいね！"
    },
    {
      "Id": 200620240,
      "Speaker": "Student",
      "Text": "勉強の最大の欠点"
    },
    {
      "Id": 200620250,
      "Speaker": "Student",
      "Text": "それは……終わりがないことです"
    },
    {
      "Id": 200620260,
      "Speaker": "Player",
      "Text": "欠点かどうかはともかく、たしかにね"
    },
    {
      "Id": 200620270,
      "Speaker": "Student",
      "Text": "勉強やだ！本もやだ！"
    },
    {
      "Id": 200620280,
      "Speaker": "Student",
      "Text": "勉強しないで知識だけ吸収したい～！"
    },
    {
      "Id": 200620290,
      "Speaker": "Student",
      "Text": "先生もそう思いません？"
    },
    {
      "Id": 200620300,
      "Speaker": "Player",
      "Text": "先生として黙秘権を行使します"
    },
    {
      "Id": 200620310,
      "Speaker": "Student",
      "Text": "ブー！ブー！"
    },
    {
      "Id": 200620320,
      "Speaker": "Student",
      "Text": "先生は生徒の肩を持つべきだー！"
    },
    {
      "Id": 200620330,
      "Speaker": "Student",
      "Text": "最近、相手を説得するには知識も必要なのかもと思って……"
    },
    {
      "Id": 200620340,
      "Speaker": "Student",
      "Text": "勉強してたんですけど、集中できなかったので連絡しちゃいました、えへっ！"
    },
    {
      "Id": 200620350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "というわけで、勉強にもどりま～す"
    },
    {
      "Id": 200620360,
      "Speaker": "Student",
      "Text": "先生、あれから大丈夫でしたか？"
    },
    {
      "Id": 200620370,
      "Speaker": "Student",
      "Text": "怪我はないんですよね？うまく立てないように見えたんですけど……"
    },
    {
      "Id": 200620380,
      "Speaker": "Player",
      "Text": "生きてるから万事おっけー！"
    },
    {
      "Id": 200620390,
      "Speaker": "Student",
      "Text": "やっぱり一度手を付けた勉強は最後までやりきらないといけませんね"
    },
    {
      "Id": 200620400,
      "Speaker": "Student",
      "Text": "危うく永遠に一つの体で生きていくところでした"
    },
    {
      "Id": 200620410,
      "Speaker": "Player",
      "Text": "これも挑戦のうちだよ！心配しないで！"
    },
    {
      "Id": 200620420,
      "Speaker": "Student",
      "Text": "ありがとうございます……"
    },
    {
      "Id": 200620430,
      "Speaker": "Student",
      "Text": "外出許可、きたあああーー！！"
    },
    {
      "Id": 200620440,
      "Speaker": "Student",
      "Text": "先生、特大のリアクションをお願いします！"
    },
    {
      "Id": 200620450,
      "Speaker": "Player",
      "Text": "うおおお！すごい！！"
    },
    {
      "Id": 200620460,
      "Speaker": "Player",
      "Text": "すごいけど、どうやってもらったの？"
    },
    {
      "Id": 200620470,
      "Speaker": "Student",
      "Text": "ふっふっふ"
    },
    {
      "Id": 200620480,
      "Speaker": "Student",
      "Text": "研究目的、というやつです"
    },
    {
      "Id": 200620490,
      "Speaker": "Student",
      "Text": "先生も来てください！損はさせませんので！"
    },
    {
      "Id": 200620500,
      "Speaker": "Player",
      "Text": "すぐ行くね！"
    },
    {
      "Id": 200620510,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "やりぃ！！"
    },
    {
      "Id": 200620520,
      "Speaker": "Student",
      "Text": "研究倫理の勉強中なんですけど"
    },
    {
      "Id": 200620530,
      "Speaker": "Student",
      "Text": "先生のことを思い出して連絡してみました"
    },
    {
      "Id": 200620540,
      "Speaker": "Player",
      "Text": "すごく大事な勉強だよね、えらい！"
    },
    {
      "Id": 200620550,
      "Speaker": "Player",
      "Text": "報告書は無事通った？"
    },
    {
      "Id": 200620560,
      "Speaker": "Student",
      "Text": "いえ"
    },
    {
      "Id": 200620570,
      "Speaker": "Student",
      "Text": "鉛筆で書いた跡が残ってて……バレちゃいました"
    },
    {
      "Id": 200620580,
      "Speaker": "Student",
      "Text": "今、ツルツルのブラウスとヒアリパンツ、分解されるコートを着て"
    },
    {
      "Id": 200620590,
      "Speaker": "Student",
      "Text": "研究倫理の本を精読してます"
    },
    {
      "Id": 200620600,
      "Speaker": "Student",
      "Text": "ベッドから3回落ちたし寒いしチクチクします"
    },
    {
      "Id": 200620610,
      "Speaker": "Student",
      "Text": "助けてください先生"
    },
    {
      "Id": 200620620,
      "Speaker": "Student",
      "Text": "おねがい！！！"
    },
    {
      "Id": 200620630,
      "Speaker": "Student",
      "Text": "先生～、ちょっと聞きたいことがあるんですけどぉ～"
    },
    {
      "Id": 200620640,
      "Speaker": "Student",
      "Text": "あ、これはなんて言うんだっけ"
    },
    {
      "Id": 200620650,
      "Speaker": "Student",
      "Text": "親しみや感謝を込めて何かをあげること……"
    },
    {
      "Id": 200620660,
      "Speaker": "Player",
      "Text": "贈り物？"
    },
    {
      "Id": 200620670,
      "Speaker": "Student",
      "Text": "あ、そうです！なんか単語が難しくて"
    },
    {
      "Id": 200620680,
      "Speaker": "Student",
      "Text": "それで、先生欲しいものとかありますか？"
    },
    {
      "Id": 200620690,
      "Speaker": "Player",
      "Text": "どうして急に？"
    },
    {
      "Id": 200620700,
      "Speaker": "Student",
      "Text": "いやなんというか、ふと何かあげたくなったんです"
    },
    {
      "Id": 200620710,
      "Speaker": "Student",
      "Text": "でも何をあげたらいいのか分からなくて……"
    },
    {
      "Id": 200620720,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 200620730,
      "Speaker": "Student",
      "Text": "そうだ！アレを作ろう！"
    },
    {
      "Id": 200620740,
      "Speaker": "Student",
      "Text": "よ～し！じゃあ今から作ってみます！溶鉱炉つけなきゃ"
    },
    {
      "Id": 200620750,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "溶鉱炉！？"
    }
  ],
  "DialogKR": [
    {
      "Id": 200620010,
      "Speaker": "Student",
      "Text": "선생님 안녕하세용!"
    },
    {
      "Id": 200620020,
      "Speaker": "Student",
      "Text": "누굴까용-!"
    },
    {
      "Id": 200620030,
      "Speaker": "Player",
      "Text": "니키 에리나, 라고 알려져 있는 녀석이군."
    },
    {
      "Id": 200620040,
      "Speaker": "Player",
      "Text": "간파했단다 후후."
    },
    {
      "Id": 200620050,
      "Speaker": "Student",
      "Text": "에이 뭐야! 일부러 말투도 바꿨는데!"
    },
    {
      "Id": 200620060,
      "Speaker": "Student",
      "Text": "그거 저장해두셨군요!"
    },
    {
      "Id": 200620070,
      "Speaker": "Student",
      "Text": "아 뭐더라"
    },
    {
      "Id": 200620080,
      "Speaker": "Student",
      "Text": "그거 있잖아요, 그거!"
    },
    {
      "Id": 200620090,
      "Speaker": "Player",
      "Text": "연락처?"
    },
    {
      "Id": 200620100,
      "Speaker": "Student",
      "Text": "맞아요 그거! 단어가 생각이 안 나서요!"
    },
    {
      "Id": 200620110,
      "Speaker": "Student",
      "Text": "연락처 저장하셔서 바로 아셨군요, 기쁘네요!"
    },
    {
      "Id": 200620120,
      "Speaker": "Student",
      "Text": "혹시, 연구하는 거 도와주실 수 있어요?"
    },
    {
      "Id": 200620130,
      "Speaker": "Player",
      "Text": "얼마든지 오케이!"
    },
    {
      "Id": 200620140,
      "Speaker": "Student",
      "Text": "진짜 최고!"
    },
    {
      "Id": 200620150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "183호로 와 주세요!"
    },
    {
      "Id": 200620160,
      "Speaker": "Student",
      "Text": "선생님 덕분에 연구 데이터를 많이 쌓았어요!"
    },
    {
      "Id": 200620170,
      "Speaker": "Student",
      "Text": "선생님 최고!"
    },
    {
      "Id": 200620180,
      "Speaker": "Student",
      "Text": "역시 요리는 화학이네요!"
    },
    {
      "Id": 200620190,
      "Speaker": "Player",
      "Text": "진짜 맛있었어!"
    },
    {
      "Id": 200620200,
      "Speaker": "Player",
      "Text": "재료를 대부분 즉석에서 만들 거라곤 생각 못 했지만!"
    },
    {
      "Id": 200620210,
      "Speaker": "Student",
      "Text": "이 정도는 껌이죠! 거의 풍선껌!"
    },
    {
      "Id": 200620220,
      "Speaker": "Student",
      "Text": "간장은 어제 미리 만들어두길 잘했어요!"
    },
    {
      "Id": 200620230,
      "Speaker": "Student",
      "Text": "다음에도 맛있는 거 해드릴게요! 꼭 오세요!"
    },
    {
      "Id": 200620240,
      "Speaker": "Student",
      "Text": "공부의 최대 단점."
    },
    {
      "Id": 200620250,
      "Speaker": "Student",
      "Text": "바로…… 끝이 없다는 것……."
    },
    {
      "Id": 200620260,
      "Speaker": "Player",
      "Text": "단점인지는 모르겠지만, 이해는 되네!"
    },
    {
      "Id": 200620270,
      "Speaker": "Student",
      "Text": "공부 싫어! 책도 싫어!"
    },
    {
      "Id": 200620280,
      "Speaker": "Student",
      "Text": "공부 안 하고 지식만 얻을 수 있음 진짜 좋을 텐데!"
    },
    {
      "Id": 200620290,
      "Speaker": "Student",
      "Text": "그쵸! 선생님!"
    },
    {
      "Id": 200620300,
      "Speaker": "Player",
      "Text": "선생님으로서 묵비권을 행사합니다."
    },
    {
      "Id": 200620310,
      "Speaker": "Student",
      "Text": "우-! 우-!"
    },
    {
      "Id": 200620320,
      "Speaker": "Student",
      "Text": "학생의 편을 들어달라!"
    },
    {
      "Id": 200620330,
      "Speaker": "Student",
      "Text": "요새, 지식이 부족하면 설득력이 떨어지는 걸 느꼈거든요."
    },
    {
      "Id": 200620340,
      "Speaker": "Student",
      "Text": "그래서 공부하다가 집중이 잘 안돼서 연락해봤어요, 에헷!"
    },
    {
      "Id": 200620350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그럼 다시 공부하러-"
    },
    {
      "Id": 200620360,
      "Speaker": "Student",
      "Text": "선생님 괜찮으세요?!"
    },
    {
      "Id": 200620370,
      "Speaker": "Student",
      "Text": "다리 다치신 건 아니죠? 제대로 일어나지 못하셨는데……."
    },
    {
      "Id": 200620380,
      "Speaker": "Player",
      "Text": "괜찮아 살아있으면 오케이!"
    },
    {
      "Id": 200620390,
      "Speaker": "Student",
      "Text": "역시 한번 시작한 공부는 끝까지 해야 했어요!"
    },
    {
      "Id": 200620400,
      "Speaker": "Student",
      "Text": "영영 한 몸으로 살아갈 뻔했네요."
    },
    {
      "Id": 200620410,
      "Speaker": "Player",
      "Text": "시행착오라고 치자! 걱정 말라구!"
    },
    {
      "Id": 200620420,
      "Speaker": "Student",
      "Text": "감사합니다아……."
    },
    {
      "Id": 200620430,
      "Speaker": "Student",
      "Text": "외출권 땄다아아아앗!!"
    },
    {
      "Id": 200620440,
      "Speaker": "Student",
      "Text": "선생님, 특대 반응 부탁드립니다."
    },
    {
      "Id": 200620450,
      "Speaker": "Player",
      "Text": "우오오오오!! 외출권이라니!! 멋져!!!"
    },
    {
      "Id": 200620460,
      "Speaker": "Player",
      "Text": "멋지긴 한데! 외출은 어떻게 따낸 거야?"
    },
    {
      "Id": 200620470,
      "Speaker": "Student",
      "Text": "훗훗훗훗훗"
    },
    {
      "Id": 200620480,
      "Speaker": "Student",
      "Text": "연구 목적 출장이죠! 훗훗훗"
    },
    {
      "Id": 200620490,
      "Speaker": "Student",
      "Text": "선생님도 오세요! 같이 다니면 진짜 좋을 거예요!"
    },
    {
      "Id": 200620500,
      "Speaker": "Player",
      "Text": "바로 갈게!"
    },
    {
      "Id": 200620510,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "끼얏호우!"
    },
    {
      "Id": 200620520,
      "Speaker": "Student",
      "Text": "연구 윤리 공부 중인데요,"
    },
    {
      "Id": 200620530,
      "Speaker": "Student",
      "Text": "선생님 생각나서 연락드려요."
    },
    {
      "Id": 200620540,
      "Speaker": "Player",
      "Text": "연구 윤리는 아주 중요하지! 기특해!"
    },
    {
      "Id": 200620550,
      "Speaker": "Player",
      "Text": "보고서는 잘 통과됐어?"
    },
    {
      "Id": 200620560,
      "Speaker": "Student",
      "Text": "아뇨"
    },
    {
      "Id": 200620570,
      "Speaker": "Student",
      "Text": "연필로 쓴 자국이 남아서 원래 연구 목표가 뭐였는지 들켰거든요."
    },
    {
      "Id": 200620580,
      "Speaker": "Student",
      "Text": "그래서 미끌미끌한 블라우스에 불개미 바지에 분해되는 코트 입고"
    },
    {
      "Id": 200620590,
      "Speaker": "Student",
      "Text": "연구 윤리 책 강제로 정독하고 있어요."
    },
    {
      "Id": 200620600,
      "Speaker": "Student",
      "Text": "침대에서 세 번 떨어졌고, 춥고, 따가워요."
    },
    {
      "Id": 200620610,
      "Speaker": "Student",
      "Text": "살려줘요"
    },
    {
      "Id": 200620620,
      "Speaker": "Student",
      "Text": "선생님 제발!!!"
    },
    {
      "Id": 200620630,
      "Speaker": "Student",
      "Text": "선생님~ 뭐 묻고 싶은 게 있는데요오~"
    },
    {
      "Id": 200620640,
      "Speaker": "Student",
      "Text": "아, 그거 뭐라고 하더라"
    },
    {
      "Id": 200620650,
      "Speaker": "Student",
      "Text": "친근함이나 감사를 담아 남에게 선사로 주는 물품……?"
    },
    {
      "Id": 200620660,
      "Speaker": "Player",
      "Text": "선물?"
    },
    {
      "Id": 200620670,
      "Speaker": "Student",
      "Text": "아 맞아요! 은근히 단어가 어렵다니깐."
    },
    {
      "Id": 200620680,
      "Speaker": "Student",
      "Text": "아무튼, 선생님 받고 싶은 선물 있어요?"
    },
    {
      "Id": 200620690,
      "Speaker": "Player",
      "Text": "갑자기?"
    },
    {
      "Id": 200620700,
      "Speaker": "Student",
      "Text": "갑자기는 아니고! 뭔가 드리고 싶다고 생각하긴 했거든요."
    },
    {
      "Id": 200620710,
      "Speaker": "Student",
      "Text": "근데 뭘 드려야 할지 몰라서"
    },
    {
      "Id": 200620720,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200620730,
      "Speaker": "Student",
      "Text": "아! 그거 만들면 되겠다!"
    },
    {
      "Id": 200620740,
      "Speaker": "Student",
      "Text": "좋아! 지금 바로 만들어볼게요! 용광로 불 켜야지!"
    },
    {
      "Id": 200620750,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "용광로?!"
    }
  ],
