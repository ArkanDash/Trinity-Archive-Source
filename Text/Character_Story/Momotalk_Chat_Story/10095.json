{
  "CharacterId": 10095,
  "DialogJP": [
    {
      "Id": 100950010,
      "Speaker": "Student",
      "Text": "こんにちは、先生"
    },
    {
      "Id": 100950020,
      "Speaker": "Student",
      "Text": "その……今日はお忙しいでしょうか？"
    },
    {
      "Id": 100950030,
      "Speaker": "Player",
      "Text": "忙しいというか……"
    },
    {
      "Id": 100950040,
      "Speaker": "Player",
      "Text": "ミレニアムの仕事だから、何かあればすぐ行けるよ"
    },
    {
      "Id": 100950050,
      "Speaker": "Student",
      "Text": "！"
    },
    {
      "Id": 100950060,
      "Speaker": "Student",
      "Text": "な、なるほど……！"
    },
    {
      "Id": 100950070,
      "Speaker": "Player",
      "Text": "何かあった？"
    },
    {
      "Id": 100950080,
      "Speaker": "Student",
      "Text": "えっと"
    },
    {
      "Id": 100950090,
      "Speaker": "Student",
      "Text": "もしよろしければ"
    },
    {
      "Id": 100950100,
      "Speaker": "Student",
      "Text": "その、時間があったらで大丈夫なので"
    },
    {
      "Id": 100950110,
      "Speaker": "Student",
      "Text": "部室に寄っていただけませんか"
    },
    {
      "Id": 100950120,
      "Speaker": "Student",
      "Text": "いつでも大丈夫です"
    },
    {
      "Id": 100950130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "今日はずっと部室にいますので……！"
    },
    {
      "Id": 100950140,
      "Speaker": "Student",
      "Text": "先生？"
    },
    {
      "Id": 100950150,
      "Speaker": "Student",
      "Text": "今送ってくださった展示会の情報……"
    },
    {
      "Id": 100950160,
      "Speaker": "Player",
      "Text": "うん、服飾美術展が開かれるみたいで"
    },
    {
      "Id": 100950170,
      "Speaker": "Player",
      "Text": "ミドリの役に立つかなって"
    },
    {
      "Id": 100950180,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 100950190,
      "Speaker": "Student",
      "Text": "その……"
    },
    {
      "Id": 100950200,
      "Speaker": "Student",
      "Text": "もしよろしければ……"
    },
    {
      "Id": 100950210,
      "Speaker": "Student",
      "Text": "き、気が向いたらで構いませんから"
    },
    {
      "Id": 100950220,
      "Speaker": "Student",
      "Text": "この展示会……先生も一緒に……行って、いただけたり……？"
    },
    {
      "Id": 100950230,
      "Speaker": "Player",
      "Text": "そうしよっか。ちょうどチケットも2枚あるし"
    },
    {
      "Id": 100950240,
      "Speaker": "Student",
      "Text": "ほ、本当ですか！？"
    },
    {
      "Id": 100950250,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 100950260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "わ、私、その……期待しても、良いんですよね？"
    },
    {
      "Id": 100950270,
      "Speaker": "Student",
      "Text": "ご主人様、いらっしゃいますか？"
    },
    {
      "Id": 100950280,
      "Speaker": "Player",
      "Text": "ご主人様じゃないですよ！？"
    },
    {
      "Id": 100950290,
      "Speaker": "Student",
      "Text": "あ、すみません。先生"
    },
    {
      "Id": 100950300,
      "Speaker": "Student",
      "Text": "何だかこの呼び方、癖になってきて……"
    },
    {
      "Id": 100950310,
      "Speaker": "Player",
      "Text": "私は先生として失格かもしれない……"
    },
    {
      "Id": 100950320,
      "Speaker": "Student",
      "Text": "そ、そんなことありませんよ！"
    },
    {
      "Id": 100950330,
      "Speaker": "Student",
      "Text": "……多分"
    },
    {
      "Id": 100950340,
      "Speaker": "Student",
      "Text": "それではご主人様"
    },
    {
      "Id": 100950350,
      "Speaker": "Student",
      "Text": "ではなく、先生"
    },
    {
      "Id": 100950360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "今日も部室……来てくれますか？"
    },
    {
      "Id": 100950370,
      "Speaker": "Student",
      "Text": "先生？"
    },
    {
      "Id": 100950380,
      "Speaker": "Student",
      "Text": "今、大丈夫ですか……？"
    },
    {
      "Id": 100950390,
      "Speaker": "Player",
      "Text": "イラストは順調？"
    },
    {
      "Id": 100950400,
      "Speaker": "Student",
      "Text": "え？"
    },
    {
      "Id": 100950410,
      "Speaker": "Student",
      "Text": "は、はい！"
    },
    {
      "Id": 100950420,
      "Speaker": "Student",
      "Text": "先生のおかげです"
    },
    {
      "Id": 100950430,
      "Speaker": "Student",
      "Text": "あの……今日の写真のことなんですが"
    },
    {
      "Id": 100950440,
      "Speaker": "Student",
      "Text": "もし良ければ……"
    },
    {
      "Id": 100950450,
      "Speaker": "Player",
      "Text": "もしかして消しちゃった？また送ろうか？"
    },
    {
      "Id": 100950460,
      "Speaker": "Student",
      "Text": "い、いえ！"
    },
    {
      "Id": 100950470,
      "Speaker": "Student",
      "Text": "そうではなく"
    },
    {
      "Id": 100950480,
      "Speaker": "Student",
      "Text": "えっと"
    },
    {
      "Id": 100950490,
      "Speaker": "Student",
      "Text": "できればずっと……持っていてほしいなと"
    },
    {
      "Id": 100950500,
      "Speaker": "Student",
      "Text": "ずっと、先生のお傍に"
    }
  ],
  "DialogKR": [
    {
      "Id": 100950010,
      "Speaker": "Student",
      "Text": "안녕하세요. 선생님."
    },
    {
      "Id": 100950020,
      "Speaker": "Student",
      "Text": "오늘도 역시…… 바쁘신가요?"
    },
    {
      "Id": 100950030,
      "Speaker": "Player",
      "Text": "바쁘다면 바쁜데……."
    },
    {
      "Id": 100950040,
      "Speaker": "Player",
      "Text": "아마 밀레니엄 일로 바쁘게 될 것 같아."
    },
    {
      "Id": 100950050,
      "Speaker": "Student",
      "Text": "네? 혹시 저희 학교로"
    },
    {
      "Id": 100950060,
      "Speaker": "Student",
      "Text": "오실 일이 있으신 건가요?"
    },
    {
      "Id": 100950070,
      "Speaker": "Player",
      "Text": "맞아. 그거야."
    },
    {
      "Id": 100950080,
      "Speaker": "Student",
      "Text": "그, 그렇군요……."
    },
    {
      "Id": 100950090,
      "Speaker": "Student",
      "Text": "저, 선생님."
    },
    {
      "Id": 100950100,
      "Speaker": "Student",
      "Text": "혹시 괜찮으시다면……."
    },
    {
      "Id": 100950110,
      "Speaker": "Student",
      "Text": "만에 하나 시간이 남으실 때의 이야기이지만……."
    },
    {
      "Id": 100950120,
      "Speaker": "Student",
      "Text": "저희 부실에도, 한 번 들러 주시면"
    },
    {
      "Id": 100950130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "기쁠 것 같아요."
    },
    {
      "Id": 100950140,
      "Speaker": "Student",
      "Text": "저, 선생님?"
    },
    {
      "Id": 100950150,
      "Speaker": "Student",
      "Text": "지금 보내 주신 이 전시회 정보……."
    },
    {
      "Id": 100950160,
      "Speaker": "Player",
      "Text": "응. 고전 복식 미술전이 열린대."
    },
    {
      "Id": 100950170,
      "Speaker": "Player",
      "Text": "혹시 미도리에게 도움이 될까 해서."
    },
    {
      "Id": 100950180,
      "Speaker": "Student",
      "Text": "감사합니다!"
    },
    {
      "Id": 100950190,
      "Speaker": "Student",
      "Text": "저기, 혹시 말인데요."
    },
    {
      "Id": 100950200,
      "Speaker": "Student",
      "Text": "정말 만에 하나의, 이야기이지만……."
    },
    {
      "Id": 100950210,
      "Speaker": "Student",
      "Text": "이 전시회"
    },
    {
      "Id": 100950220,
      "Speaker": "Student",
      "Text": "선생님께서도 같이…… 가 주실 수, 있으실까요……?"
    },
    {
      "Id": 100950230,
      "Speaker": "Player",
      "Text": "그럴까? 마침 표도 두 장이었고."
    },
    {
      "Id": 100950240,
      "Speaker": "Student",
      "Text": "정말요?!"
    },
    {
      "Id": 100950250,
      "Speaker": "Student",
      "Text": "감사합니다!"
    },
    {
      "Id": 100950260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "저, 기대하고 있어도…… 되는 거죠?"
    },
    {
      "Id": 100950270,
      "Speaker": "Student",
      "Text": "주인님, 계세요?"
    },
    {
      "Id": 100950280,
      "Speaker": "Player",
      "Text": "그거 아니야!"
    },
    {
      "Id": 100950290,
      "Speaker": "Student",
      "Text": "아, 죄송해요. 선생님."
    },
    {
      "Id": 100950300,
      "Speaker": "Student",
      "Text": "슬슬 이쪽 호칭이 입에 붙고 있는 것 같네요……."
    },
    {
      "Id": 100950310,
      "Speaker": "Player",
      "Text": "괜찮은가, 나는…… 교육자로서 괜찮은가……."
    },
    {
      "Id": 100950320,
      "Speaker": "Student",
      "Text": "괘, 괜찮을 거예요!"
    },
    {
      "Id": 100950330,
      "Speaker": "Student",
      "Text": "……아마도요."
    },
    {
      "Id": 100950340,
      "Speaker": "Student",
      "Text": "그러면, 주인님."
    },
    {
      "Id": 100950350,
      "Speaker": "Student",
      "Text": "아니, 선생님."
    },
    {
      "Id": 100950360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "오늘도…… 와 주실 거죠?"
    },
    {
      "Id": 100950370,
      "Speaker": "Student",
      "Text": "선생님?"
    },
    {
      "Id": 100950380,
      "Speaker": "Student",
      "Text": "계신가요……?"
    },
    {
      "Id": 100950390,
      "Speaker": "Player",
      "Text": "일러스트 작업은 잘 돼?"
    },
    {
      "Id": 100950400,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 100950410,
      "Speaker": "Student",
      "Text": "네."
    },
    {
      "Id": 100950420,
      "Speaker": "Student",
      "Text": "덕분에요."
    },
    {
      "Id": 100950430,
      "Speaker": "Student",
      "Text": "그보다, 저기, 혹시 괜찮으시다면……."
    },
    {
      "Id": 100950440,
      "Speaker": "Student",
      "Text": "그 사진 말인데요……."
    },
    {
      "Id": 100950450,
      "Speaker": "Player",
      "Text": "응? 원본 없어졌어? 공유해 줄까?"
    },
    {
      "Id": 100950460,
      "Speaker": "Student",
      "Text": "아뇨! 그건 아니에요."
    },
    {
      "Id": 100950470,
      "Speaker": "Student",
      "Text": "단지……."
    },
    {
      "Id": 100950480,
      "Speaker": "Student",
      "Text": "그, 정말로 선생님께서 괜찮으시다면, 이지만요."
    },
    {
      "Id": 100950490,
      "Speaker": "Student",
      "Text": "가능하면 오래…… 가지고 있어 주셨으면 해요."
    },
    {
      "Id": 100950500,
      "Speaker": "Student",
      "Text": "네. 오랫동안이요."
    }
  ],
  "DialogEN": [
    {
      "Id": 100950010,
      "Speaker": "Student",
      "Text": "Hello, Sensei."
    },
    {
      "Id": 100950020,
      "Speaker": "Student",
      "Text": "Are you...busy today?"
    },
    {
      "Id": 100950030,
      "Speaker": "Player",
      "Text": "I am, but I'll be in your area."
    },
    {
      "Id": 100950040,
      "Speaker": "Player",
      "Text": "I have business at Millennium, actually."
    },
    {
      "Id": 100950050,
      "Speaker": "Student",
      "Text": "Huh? Are you..."
    },
    {
      "Id": 100950060,
      "Speaker": "Student",
      "Text": "You're visiting Millennium?"
    },
    {
      "Id": 100950070,
      "Speaker": "Player",
      "Text": "Yup! You got it!"
    },
    {
      "Id": 100950080,
      "Speaker": "Student",
      "Text": "I-I see..."
    },
    {
      "Id": 100950090,
      "Speaker": "Student",
      "Text": "Um, Sensei?"
    },
    {
      "Id": 100950100,
      "Speaker": "Student",
      "Text": "Then, if you don't mind..."
    },
    {
      "Id": 100950110,
      "Speaker": "Student",
      "Text": "And only if you have some free time!"
    },
    {
      "Id": 100950120,
      "Speaker": "Student",
      "Text": "It'd make me really happy"
    },
    {
      "Id": 100950130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "if you stopped by the club room..."
    },
    {
      "Id": 100950140,
      "Speaker": "Student",
      "Text": "Um, Sensei?"
    },
    {
      "Id": 100950150,
      "Speaker": "Student",
      "Text": "The exhibition info you just sent..."
    },
    {
      "Id": 100950160,
      "Speaker": "Player",
      "Text": "Yeah. It's for a classic fashion art exhibition."
    },
    {
      "Id": 100950170,
      "Speaker": "Player",
      "Text": "I thought you might find it helpful."
    },
    {
      "Id": 100950180,
      "Speaker": "Student",
      "Text": "Thank you!"
    },
    {
      "Id": 100950190,
      "Speaker": "Student",
      "Text": "Um, by any chance..."
    },
    {
      "Id": 100950200,
      "Speaker": "Student",
      "Text": "Really, seriously, just by ANY chance,"
    },
    {
      "Id": 100950210,
      "Speaker": "Student",
      "Text": "this exhibition..."
    },
    {
      "Id": 100950220,
      "Speaker": "Student",
      "Text": "Can we...go together, Sensei?"
    },
    {
      "Id": 100950230,
      "Speaker": "Player",
      "Text": "Shall we? We do have two tickets."
    },
    {
      "Id": 100950240,
      "Speaker": "Student",
      "Text": "Really?!"
    },
    {
      "Id": 100950250,
      "Speaker": "Student",
      "Text": "Thank you!"
    },
    {
      "Id": 100950260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "I'll look forward to it...okay?"
    },
    {
      "Id": 100950270,
      "Speaker": "Student",
      "Text": "Are you here, Master?"
    },
    {
      "Id": 100950280,
      "Speaker": "Player",
      "Text": "Stop that!"
    },
    {
      "Id": 100950290,
      "Speaker": "Student",
      "Text": "Ah! Sorry, Sensei."
    },
    {
      "Id": 100950300,
      "Speaker": "Student",
      "Text": "I've been getting too used to the title..."
    },
    {
      "Id": 100950310,
      "Speaker": "Player",
      "Text": "As an educator...is this...okay?"
    },
    {
      "Id": 100950320,
      "Speaker": "Student",
      "Text": "T-Totally okay!"
    },
    {
      "Id": 100950330,
      "Speaker": "Student",
      "Text": "...Probably."
    },
    {
      "Id": 100950340,
      "Speaker": "Student",
      "Text": "Now then, Master."
    },
    {
      "Id": 100950350,
      "Speaker": "Student",
      "Text": "No! Sensei!"
    },
    {
      "Id": 100950360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "You're...gonna come today too, right?"
    },
    {
      "Id": 100950370,
      "Speaker": "Student",
      "Text": "Sensei?"
    },
    {
      "Id": 100950380,
      "Speaker": "Student",
      "Text": "You here...?"
    },
    {
      "Id": 100950390,
      "Speaker": "Player",
      "Text": "Is the illustration work going well?"
    },
    {
      "Id": 100950400,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 100950410,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 100950420,
      "Speaker": "Student",
      "Text": "Because of you."
    },
    {
      "Id": 100950430,
      "Speaker": "Student",
      "Text": "More importantly, if you don't mind..."
    },
    {
      "Id": 100950440,
      "Speaker": "Student",
      "Text": "About the picture..."
    },
    {
      "Id": 100950450,
      "Speaker": "Player",
      "Text": "Did you lose the original? Do you need another copy?"
    },
    {
      "Id": 100950460,
      "Speaker": "Student",
      "Text": "No, no! I wouldn't lose that."
    },
    {
      "Id": 100950470,
      "Speaker": "Student",
      "Text": "It's more so..."
    },
    {
      "Id": 100950480,
      "Speaker": "Student",
      "Text": "Um, and this really is only if you don't mind, Sensei."
    },
    {
      "Id": 100950490,
      "Speaker": "Student",
      "Text": "Will you...keep it? Forever?"
    },
    {
      "Id": 100950500,
      "Speaker": "Student",
      "Text": "Yes... Forever."
    }
  ],
  "DialogTH": [
    {
      "Id": 100950010,
      "Speaker": "Student",
      "Text": "สวัสดีค่ะ คุณครู"
    },
    {
      "Id": 100950020,
      "Speaker": "Student",
      "Text": "วันนี้คุณครูก็... งานยุ่งมั้ยคะ?"
    },
    {
      "Id": 100950030,
      "Speaker": "Player",
      "Text": "จะว่ายุ่งก็ได้นะ..."
    },
    {
      "Id": 100950040,
      "Speaker": "Player",
      "Text": "ครูน่าจะยุ่งกับงานของมิลเลเนียมน่ะ"
    },
    {
      "Id": 100950050,
      "Speaker": "Student",
      "Text": "คะ? คุณครูมีธุระ"
    },
    {
      "Id": 100950060,
      "Speaker": "Student",
      "Text": "ต้องมาที่โรงเรียนของเราเหรอคะ?"
    },
    {
      "Id": 100950070,
      "Speaker": "Player",
      "Text": "ใช่ ครูต้องไปที่นั่น"
    },
    {
      "Id": 100950080,
      "Speaker": "Student",
      "Text": "ยะ... อย่างนั้นสินะคะ..."
    },
    {
      "Id": 100950090,
      "Speaker": "Student",
      "Text": "เอ่อ... คุณครูคะ"
    },
    {
      "Id": 100950100,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูไม่ว่าอะไร..."
    },
    {
      "Id": 100950110,
      "Speaker": "Student",
      "Text": "ถ้าเกิดว่าคุณครูมีเวลาเหลือจากงาน..."
    },
    {
      "Id": 100950120,
      "Speaker": "Student",
      "Text": "ฉันอยากให้คุณครู"
    },
    {
      "Id": 100950130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "แวะมาที่ห้องชมรมของเราหน่อยค่ะ"
    },
    {
      "Id": 100950140,
      "Speaker": "Student",
      "Text": "คือว่า คุณครูคะ?"
    },
    {
      "Id": 100950150,
      "Speaker": "Student",
      "Text": "ข้อมูลนิทรรศการที่ส่งมา..."
    },
    {
      "Id": 100950160,
      "Speaker": "Player",
      "Text": "อื้ม จะมีนิทรรศการเครื่องแต่งกาย\nโบราณน่ะ"
    },
    {
      "Id": 100950170,
      "Speaker": "Player",
      "Text": "ครูส่งให้เพราะคิดว่าน่าจะ\nเป็นประโยชน์กับมิโดริ"
    },
    {
      "Id": 100950180,
      "Speaker": "Student",
      "Text": "ขอบคุณค่ะ!"
    },
    {
      "Id": 100950190,
      "Speaker": "Student",
      "Text": "คือ... ขอถามเผื่อๆ ไว้นะคะ"
    },
    {
      "Id": 100950200,
      "Speaker": "Student",
      "Text": "แค่สมมตินะคะ..."
    },
    {
      "Id": 100950210,
      "Speaker": "Student",
      "Text": "คุณครูไปนิทรรศการนี้..."
    },
    {
      "Id": 100950220,
      "Speaker": "Student",
      "Text": "ด้วยกันกับฉัน... จะได้หรือเปล่าคะ...?"
    },
    {
      "Id": 100950230,
      "Speaker": "Player",
      "Text": "ได้สิ ครูมีตั๋ว 2 ใบพอดี"
    },
    {
      "Id": 100950240,
      "Speaker": "Student",
      "Text": "จริงเหรอคะ?!"
    },
    {
      "Id": 100950250,
      "Speaker": "Student",
      "Text": "ขอบคุณค่ะ!"
    },
    {
      "Id": 100950260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ฉัน... ตั้งตารอ... ได้ใช่มั้ยคะ?"
    },
    {
      "Id": 100950270,
      "Speaker": "Student",
      "Text": "นายท่าน อยู่มั้ยคะ?"
    },
    {
      "Id": 100950280,
      "Speaker": "Player",
      "Text": "เรียกผิดแล้ว"
    },
    {
      "Id": 100950290,
      "Speaker": "Student",
      "Text": "อ่า ขอโทษด้วยค่ะ คุณครู"
    },
    {
      "Id": 100950300,
      "Speaker": "Student",
      "Text": "ฉันคงเริ่มชินกับคำเรียกแบบนี้น่ะค่ะ..."
    },
    {
      "Id": 100950310,
      "Speaker": "Player",
      "Text": "จะไม่เป็นไรเหรอ... ครูเป็นครูนะ..."
    },
    {
      "Id": 100950320,
      "Speaker": "Student",
      "Text": "มะ... ไม่เป็นไรหรอกค่ะ!"
    },
    {
      "Id": 100950330,
      "Speaker": "Student",
      "Text": "น่าจะนะคะ..."
    },
    {
      "Id": 100950340,
      "Speaker": "Student",
      "Text": "ถ้างั้น นายท่าน"
    },
    {
      "Id": 100950350,
      "Speaker": "Student",
      "Text": "ไม่สิ คุณครูคะ"
    },
    {
      "Id": 100950360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "วันนี้... ก็จะมาหากันใช่มั้ยคะ?"
    },
    {
      "Id": 100950370,
      "Speaker": "Student",
      "Text": "คุณครู?"
    },
    {
      "Id": 100950380,
      "Speaker": "Student",
      "Text": "อยู่มั้ยคะ...?"
    },
    {
      "Id": 100950390,
      "Speaker": "Player",
      "Text": "งานวาดภาพเป็นยังไงบ้าง?"
    },
    {
      "Id": 100950400,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 100950410,
      "Speaker": "Student",
      "Text": "ค่ะ"
    },
    {
      "Id": 100950420,
      "Speaker": "Student",
      "Text": "ต้องขอบคุณคุณครูเลยค่ะ"
    },
    {
      "Id": 100950430,
      "Speaker": "Student",
      "Text": "แต่ว่าถ้าคุณครูไม่ติดอะไร..."
    },
    {
      "Id": 100950440,
      "Speaker": "Student",
      "Text": "รูปนั้นน่ะค่ะ..."
    },
    {
      "Id": 100950450,
      "Speaker": "Player",
      "Text": "หืม? รูปต้นฉบับหายไปเหรอ?\nครูส่งให้มั้ย?"
    },
    {
      "Id": 100950460,
      "Speaker": "Student",
      "Text": "ไม่ค่ะ! ไม่ใช่อย่างนั้นค่ะ"
    },
    {
      "Id": 100950470,
      "Speaker": "Student",
      "Text": "เพียงแต่ว่า..."
    },
    {
      "Id": 100950480,
      "Speaker": "Student",
      "Text": "เอ่อ... ถ้าคุณครูสะดวกละก็"
    },
    {
      "Id": 100950490,
      "Speaker": "Student",
      "Text": "ถ้าเป็นไปได้... ฉันอยากให้คุณครู\nเก็บไว้นานๆ น่ะค่ะ"
    },
    {
      "Id": 100950500,
      "Speaker": "Student",
      "Text": "ค่ะ เก็บไว้นานๆ เลย"
    }
  ],
  "DialogTW": [
    {
