{
  "CharacterId": 20063,
  "DialogJP": [
    {
      "Id": 200630010,
      "Speaker": "Student",
      "Text": "こちらペンギン"
    },
    {
      "Id": 200630020,
      "Speaker": "Student",
      "Text": "アヒル、応答せよ"
    },
    {
      "Id": 200630030,
      "Speaker": "Student",
      "Text": "会いたい"
    },
    {
      "Id": 200630040,
      "Speaker": "Player",
      "Text": "こちらアヒル、承知した"
    },
    {
      "Id": 200630050,
      "Speaker": "Player",
      "Text": "座標を求む"
    },
    {
      "Id": 200630060,
      "Speaker": "Student",
      "Text": "ペンギン、感度良好"
    },
    {
      "Id": 200630070,
      "Speaker": "Student",
      "Text": "宿の第2駐車場だ"
    },
    {
      "Id": 200630080,
      "Speaker": "Player",
      "Text": "座標じゃないんだ……！？"
    },
    {
      "Id": 200630090,
      "Speaker": "Student",
      "Text": "目印がはっきりしているなら座標は必要ない"
    },
    {
      "Id": 200630100,
      "Speaker": "Student",
      "Text": "では、現地で合流しよう"
    },
    {
      "Id": 200630110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ペンギンからは以上"
    },
    {
      "Id": 200630120,
      "Speaker": "Student",
      "Text": "こちらペンギン。アヒル、応答せよ"
    },
    {
      "Id": 200630130,
      "Speaker": "Player",
      "Text": "こんにちは、ペンギン！"
    },
    {
      "Id": 200630140,
      "Speaker": "Player",
      "Text": "ペンギン、こんにちは！"
    },
    {
      "Id": 200630150,
      "Speaker": "Student",
      "Text": "よし、接続状態に異常なし"
    },
    {
      "Id": 200630160,
      "Speaker": "Student",
      "Text": "今日は助かった"
    },
    {
      "Id": 200630170,
      "Speaker": "Student",
      "Text": "それと"
    },
    {
      "Id": 200630180,
      "Speaker": "Student",
      "Text": "ありがとう"
    },
    {
      "Id": 200630190,
      "Speaker": "Student",
      "Text": "普通を教えてくれて"
    },
    {
      "Id": 200630200,
      "Speaker": "Student",
      "Text": "ペンギンからは以上"
    },
    {
      "Id": 200630210,
      "Speaker": "Student",
      "Text": "先生、時間はあるか？"
    },
    {
      "Id": 200630220,
      "Speaker": "Student",
      "Text": "買い出しに行きたい"
    },
    {
      "Id": 200630230,
      "Speaker": "Student",
      "Text": "専門家の支援が必要だ"
    },
    {
      "Id": 200630240,
      "Speaker": "Player",
      "Text": "買い物専門家をお呼びかな？"
    },
    {
      "Id": 200630250,
      "Speaker": "Player",
      "Text": "任せて！"
    },
    {
      "Id": 200630260,
      "Speaker": "Student",
      "Text": "では、駐車場で合流しよう"
    },
    {
      "Id": 200630270,
      "Speaker": "Student",
      "Text": "屋外第1駐車場のA113番だ"
    },
    {
      "Id": 200630280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "通信終わり"
    },
    {
      "Id": 200630290,
      "Speaker": "Student",
      "Text": "流石、先生だ"
    },
    {
      "Id": 200630300,
      "Speaker": "Student",
      "Text": "おかげでスカルマンも寂しくないし、香りもきつくなくなった"
    },
    {
      "Id": 200630310,
      "Speaker": "Student",
      "Text": "私は歯磨き粉を塗ることしか思いつかなかった"
    },
    {
      "Id": 200630320,
      "Speaker": "Player",
      "Text": "アズサも、寂しくない？"
    },
    {
      "Id": 200630330,
      "Speaker": "Student",
      "Text": "もちろんだ"
    },
    {
      "Id": 200630340,
      "Speaker": "Student",
      "Text": "……先生のおかげ"
    },
    {
      "Id": 200630350,
      "Speaker": "Student",
      "Text": "ありがとう、ペンギンからは以上"
    },
    {
      "Id": 200630360,
      "Speaker": "Student",
      "Text": "先生はデルタタンゴって知ってる？"
    },
    {
      "Id": 200630370,
      "Speaker": "Student",
      "Text": "これから向かう予定"
    },
    {
      "Id": 200630380,
      "Speaker": "Player",
      "Text": "ダンスかな？"
    },
    {
      "Id": 200630390,
      "Speaker": "Student",
      "Text": "詳細は現地で確かめる"
    },
    {
      "Id": 200630400,
      "Speaker": "Student",
      "Text": "困難な任務になるはず"
    },
    {
      "Id": 200630410,
      "Speaker": "Student",
      "Text": "支援を求む"
    },
    {
      "Id": 200630420,
      "Speaker": "Player",
      "Text": "了解……？"
    },
    {
      "Id": 200630430,
      "Speaker": "Student",
      "Text": "何が待っているか分からない"
    },
    {
      "Id": 200630440,
      "Speaker": "Student",
      "Text": "念のため戦車で向かおう"
    },
    {
      "Id": 200630450,
      "Speaker": "Student",
      "Text": "合流地点を伝える"
    },
    {
      "Id": 200630460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "通信終了"
    },
    {
      "Id": 200630470,
      "Speaker": "Student",
      "Text": "先生、どうしよう"
    },
    {
      "Id": 200630480,
      "Speaker": "Student",
      "Text": "もうデルタタンゴに行きたくなった"
    },
    {
      "Id": 200630490,
      "Speaker": "Student",
      "Text": "一緒に行く約束だったと思うけど"
    },
    {
      "Id": 200630500,
      "Speaker": "Student",
      "Text": "次はいつ行ける？"
    },
    {
      "Id": 200630510,
      "Speaker": "Player",
      "Text": "呼ばれたらいつでも行くよ！"
    },
    {
      "Id": 200630520,
      "Speaker": "Student",
      "Text": "よし、すぐに行こう"
    },
    {
      "Id": 200630530,
      "Speaker": "Student",
      "Text": "次も注文は私に任せて"
    },
    {
      "Id": 200630540,
      "Speaker": "Student",
      "Text": "通信終了"
    },
    {
      "Id": 200630550,
      "Speaker": "Student",
      "Text": "先生、私だ"
    },
    {
      "Id": 200630560,
      "Speaker": "Player",
      "Text": "こんにちは、リス！"
    },
    {
      "Id": 200630570,
      "Speaker": "Student",
      "Text": "うん？ああ"
    },
    {
      "Id": 200630580,
      "Speaker": "Student",
      "Text": "私がリスなら、先生はドングリにしよう"
    },
    {
      "Id": 200630590,
      "Speaker": "Student",
      "Text": "ではドングリ、支援を要請する"
    },
    {
      "Id": 200630600,
      "Speaker": "Student",
      "Text": "SSEの一環として、PSR用のIMINTが必要になった"
    },
    {
      "Id": 200630610,
      "Speaker": "Student",
      "Text": "正規の手順ではないから、私だけでは心許ない"
    },
    {
      "Id": 200630620,
      "Speaker": "Player",
      "Text": "なにが……なんて？"
    },
    {
      "Id": 200630630,
      "Speaker": "Student",
      "Text": "SVを急ぎたい。詳細は現地で説明する"
    },
    {
      "Id": 200630640,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "リスからは以上"
    },
    {
      "Id": 200630650,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200630660,
      "Speaker": "Student",
      "Text": "もう大丈夫だ"
    },
    {
      "Id": 200630670,
      "Speaker": "Student",
      "Text": "そばにいてくれてありがとう"
    },
    {
      "Id": 200630680,
      "Speaker": "Student",
      "Text": "今日だけじゃなくて、これまでも……"
    },
    {
      "Id": 200630690,
      "Speaker": "Player",
      "Text": "私はいつだってアズサのそばにいるよ！"
    },
    {
      "Id": 200630700,
      "Speaker": "Player",
      "Text": "ところで、暗号名を使わなくても大丈夫？"
    },
    {
      "Id": 200630710,
      "Speaker": "Student",
      "Text": "暗号名、か"
    },
    {
      "Id": 200630720,
      "Speaker": "Student",
      "Text": "平文なら、使わなくてもいい場合がある"
    },
    {
      "Id": 200630730,
      "Speaker": "Student",
      "Text": "それに"
    },
    {
      "Id": 200630740,
      "Speaker": "Student",
      "Text": "「普通」は使わないと思うから"
    },
    {
      "Id": 200630750,
      "Speaker": "Student",
      "Text": "だからアズサで十分だ"
    },
    {
      "Id": 200630760,
      "Speaker": "Student",
      "Text": "また会おう、先生"
    }
  ],
  "DialogKR": [
    {
      "Id": 200630010,
      "Speaker": "Student",
      "Text": "당소 펭귄"
    },
    {
      "Id": 200630020,
      "Speaker": "Student",
      "Text": "오리, 응답하라."
    },
    {
      "Id": 200630030,
      "Speaker": "Student",
      "Text": "만나고 싶다."
    },
    {
      "Id": 200630040,
      "Speaker": "Player",
      "Text": "당소 오리, 수신했다."
    },
    {
      "Id": 200630050,
      "Speaker": "Player",
      "Text": "좌표 요청한다."
    },
    {
      "Id": 200630060,
      "Speaker": "Student",
      "Text": "펭귄, 감도 양호."
    },
    {
      "Id": 200630070,
      "Speaker": "Student",
      "Text": "선수촌 야외 제2주차장이야."
    },
    {
      "Id": 200630080,
      "Speaker": "Player",
      "Text": "좌표가 아니네……?!"
    },
    {
      "Id": 200630090,
      "Speaker": "Student",
      "Text": "더 확실한 참고점이 있으면 좌표는 필요 없어."
    },
    {
      "Id": 200630100,
      "Speaker": "Student",
      "Text": "그럼 거기서 보자."
    },
    {
      "Id": 200630110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "펭귄 아웃, 통신 종료."
    },
    {
      "Id": 200630120,
      "Speaker": "Student",
      "Text": "당소 펭귄, 오리 응답하라."
    },
    {
      "Id": 200630130,
      "Speaker": "Player",
      "Text": "안녕 펭귄!"
    },
    {
      "Id": 200630140,
      "Speaker": "Player",
      "Text": "펭귄 안녕!"
    },
    {
      "Id": 200630150,
      "Speaker": "Student",
      "Text": "좋아, 연결 상태 이상 없네."
    },
    {
      "Id": 200630160,
      "Speaker": "Student",
      "Text": "오늘 도와줘서 고마워."
    },
    {
      "Id": 200630170,
      "Speaker": "Student",
      "Text": "그리고"
    },
    {
      "Id": 200630180,
      "Speaker": "Student",
      "Text": "고마워."
    },
    {
      "Id": 200630190,
      "Speaker": "Student",
      "Text": "평범한 하루를 알려줘서."
    },
    {
      "Id": 200630200,
      "Speaker": "Student",
      "Text": "펭귄 아웃."
    },
    {
      "Id": 200630210,
      "Speaker": "Student",
      "Text": "선생님, 오늘 시간 괜찮을까?"
    },
    {
      "Id": 200630220,
      "Speaker": "Student",
      "Text": "물건을 좀 사러 가야 하는데,"
    },
    {
      "Id": 200630230,
      "Speaker": "Student",
      "Text": "전문가의 도움이 필요해."
    },
    {
      "Id": 200630240,
      "Speaker": "Player",
      "Text": "물건 사는 건 내가 전문가지!"
    },
    {
      "Id": 200630250,
      "Speaker": "Player",
      "Text": "선생님이 도와줄게!"
    },
    {
      "Id": 200630260,
      "Speaker": "Student",
      "Text": "그러면 주차장에서 보자."
    },
    {
      "Id": 200630270,
      "Speaker": "Student",
      "Text": "야외 제1주차장 A113번 자리야."
    },
    {
      "Id": 200630280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "통신 종료."
    },
    {
      "Id": 200630290,
      "Speaker": "Student",
      "Text": "선생님은 항상 현명해."
    },
    {
      "Id": 200630300,
      "Speaker": "Student",
      "Text": "덕분에 스컬맨도 외롭지 않고, 향도 독하지 않게 됐어."
    },
    {
      "Id": 200630310,
      "Speaker": "Student",
      "Text": "나는 고작 치약을 바르는 것밖에 생각하지 못했어."
    },
    {
      "Id": 200630320,
      "Speaker": "Player",
      "Text": "아즈사도 외롭지 않겠지?"
    },
    {
      "Id": 200630330,
      "Speaker": "Student",
      "Text": "물론이지."
    },
    {
      "Id": 200630340,
      "Speaker": "Student",
      "Text": "……선생님 덕분이야."
    },
    {
      "Id": 200630350,
      "Speaker": "Student",
      "Text": "고마워, 펭귄 아웃."
    },
    {
      "Id": 200630360,
      "Speaker": "Student",
      "Text": "선생님은 델타 탱고가 뭔지 알아?"
    },
    {
      "Id": 200630370,
      "Speaker": "Student",
      "Text": "지금부터 갈 예정이야."
    },
    {
      "Id": 200630380,
      "Speaker": "Player",
      "Text": "델타 탱고……? 춤인가?"
    },
    {
      "Id": 200630390,
      "Speaker": "Student",
      "Text": "자세한 건 현지에서 확인하자."
    },
    {
      "Id": 200630400,
      "Speaker": "Student",
      "Text": "어려움이 예상돼."
    },
    {
      "Id": 200630410,
      "Speaker": "Student",
      "Text": "지원 부탁할게."
    },
    {
      "Id": 200630420,
      "Speaker": "Player",
      "Text": "오케이……?"
    },
    {
      "Id": 200630430,
      "Speaker": "Student",
      "Text": "어떻게 될지 예상하기가 힘들어."
    },
    {
      "Id": 200630440,
      "Speaker": "Student",
      "Text": "혹시 모르니 전차로 가자."
    },
    {
      "Id": 200630450,
      "Speaker": "Student",
      "Text": "합류지점으로 와."
    },
    {
      "Id": 200630460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "통신 종료."
    },
    {
      "Id": 200630470,
      "Speaker": "Student",
      "Text": "선생님, 어쩌지."
    },
    {
      "Id": 200630480,
      "Speaker": "Student",
      "Text": "또 델타 탱고에 가고 싶어졌어."
    },
    {
      "Id": 200630490,
      "Speaker": "Student",
      "Text": "함께 가기로 약속했던 것 같은데,"
    },
    {
      "Id": 200630500,
      "Speaker": "Student",
      "Text": "다음엔 언제 갈 수 있어?"
    },
    {
      "Id": 200630510,
      "Speaker": "Player",
      "Text": "언제든지 아즈사가 부른다면!"
    },
    {
      "Id": 200630520,
      "Speaker": "Student",
      "Text": "좋아, 바로 가자."
    },
    {
      "Id": 200630530,
      "Speaker": "Student",
      "Text": "이번에도 주문은 내가 할게."
    },
    {
      "Id": 200630540,
      "Speaker": "Student",
      "Text": "수신 종료."
    },
    {
      "Id": 200630550,
      "Speaker": "Student",
      "Text": "선생님, 나야."
    },
    {
      "Id": 200630560,
      "Speaker": "Player",
      "Text": "안녕, 다람쥐!"
    },
    {
      "Id": 200630570,
      "Speaker": "Student",
      "Text": "아. 음어."
    },
    {
      "Id": 200630580,
      "Speaker": "Student",
      "Text": "나는 다람쥐인가, 그러면 선생님은 도토리로 하자."
    },
    {
      "Id": 200630590,
      "Speaker": "Student",
      "Text": "도토리, 다른 게 아니라 도움이 필요해."
    },
    {
      "Id": 200630600,
      "Speaker": "Student",
      "Text": "이번에 SSE의 일환으로 PSR의 IMINT가 필요해."
    },
    {
      "Id": 200630610,
      "Speaker": "Student",
      "Text": "비정규 절차라서 익숙하지 않다 보니 선생님이 도와주었으면 좋겠어."
    },
    {
      "Id": 200630620,
      "Speaker": "Player",
      "Text": "PS…… 응?"
    },
    {
      "Id": 200630630,
      "Speaker": "Student",
      "Text": "자세한 건 현장에서. SV가 시급해."
    },
    {
      "Id": 200630640,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "다람쥐, 아웃."
    },
    {
      "Id": 200630650,
      "Speaker": "Student",
      "Text": "선생님,"
    },
    {
      "Id": 200630660,
      "Speaker": "Student",
      "Text": "이제 괜찮아졌어."
    },
    {
      "Id": 200630670,
      "Speaker": "Student",
      "Text": "곁에 있어 줘서 고마워."
    },
    {
      "Id": 200630680,
      "Speaker": "Student",
      "Text": "오늘만이 아니라, 지금까지 계속……."
    },
    {
      "Id": 200630690,
      "Speaker": "Player",
      "Text": "아즈사의 곁에 항상 있을게!"
    },
    {
      "Id": 200630700,
      "Speaker": "Player",
      "Text": "그런데, 음어는 사용하지 않아도 괜찮아?"
    },
    {
      "Id": 200630710,
      "Speaker": "Student",
      "Text": "음어, 말이지."
    },
    {
      "Id": 200630720,
      "Speaker": "Student",
      "Text": "평문에서는 음어를 사용하지 않아도 괜찮은 경우가 있어."
    },
    {
      "Id": 200630730,
      "Speaker": "Student",
      "Text": "그리고"
    },
    {
      "Id": 200630740,
      "Speaker": "Student",
      "Text": "'보통'은 쓰지 않을 테니까."
    },
    {
      "Id": 200630750,
      "Speaker": "Student",
      "Text": "그러니까 아즈사로 충분해."
    },
    {
      "Id": 200630760,
      "Speaker": "Student",
      "Text": "다음에 보자, 선생님."
    }
  ],
