{
  "CharacterId": 10152,
  "DialogJP": [
    {
      "Id": 101520010,
      "Speaker": "Student",
      "Text": "バーン"
    },
    {
      "Id": 101520020,
      "Speaker": "Student",
      "Text": "こんにちは、先生"
    },
    {
      "Id": 101520030,
      "Speaker": "Student",
      "Text": "バンド界の白雪姫"
    },
    {
      "Id": 101520040,
      "Speaker": "Student",
      "Text": "椎名ツムギです"
    },
    {
      "Id": 101520050,
      "Speaker": "Player",
      "Text": "し、白雪姫？"
    },
    {
      "Id": 101520060,
      "Speaker": "Student",
      "Text": "もちろん、鏡に世界一美しいと言われたわけではありませんが――"
    },
    {
      "Id": 101520070,
      "Speaker": "Student",
      "Text": "――「アピール」"
    },
    {
      "Id": 101520080,
      "Speaker": "Student",
      "Text": "……は大事ですから"
    },
    {
      "Id": 101520090,
      "Speaker": "Student",
      "Text": "ここで、先生に一つ質問です"
    },
    {
      "Id": 101520100,
      "Speaker": "Student",
      "Text": "今日は何の日か分かりますか？"
    },
    {
      "Id": 101520110,
      "Speaker": "Player",
      "Text": "ツムギの路上ライブの日！"
    },
    {
      "Id": 101520120,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 101520130,
      "Speaker": "Student",
      "Text": "素晴らしい記憶力です"
    },
    {
      "Id": 101520140,
      "Speaker": "Student",
      "Text": "やはり先生は、私の期待を裏切りませんね"
    },
    {
      "Id": 101520150,
      "Speaker": "Student",
      "Text": "では、お時間がある時にお越しください"
    },
    {
      "Id": 101520160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "私はずっと、あの場所でお待ちしておりますので"
    },
    {
      "Id": 101520170,
      "Speaker": "Student",
      "Text": "楽しいステージでしたね"
    },
    {
      "Id": 101520180,
      "Speaker": "Student",
      "Text": "先生はどうでした？"
    },
    {
      "Id": 101520190,
      "Speaker": "Student",
      "Text": "楽しんでいただけましたか？"
    },
    {
      "Id": 101520200,
      "Speaker": "Player",
      "Text": "ストレスが吹き飛んだよ！"
    },
    {
      "Id": 101520210,
      "Speaker": "Student",
      "Text": "ふふっ、良かったです"
    },
    {
      "Id": 101520220,
      "Speaker": "Student",
      "Text": "今なら、毒リンゴを食べて深い眠りについても悔いはありません"
    },
    {
      "Id": 101520230,
      "Speaker": "Student",
      "Text": "もちろん、本当に毒リンゴを食べるわけでも"
    },
    {
      "Id": 101520240,
      "Speaker": "Student",
      "Text": "深い眠りにつくわけでもありませんが"
    },
    {
      "Id": 101520250,
      "Speaker": "Student",
      "Text": "ここではそのような――"
    },
    {
      "Id": 101520260,
      "Speaker": "Player",
      "Text": "「表現力」が、大事だから？"
    },
    {
      "Id": 101520270,
      "Speaker": "Student",
      "Text": "あら"
    },
    {
      "Id": 101520280,
      "Speaker": "Student",
      "Text": "以心伝心ですね"
    },
    {
      "Id": 101520290,
      "Speaker": "Student",
      "Text": "それでは、またお会いしましょう"
    },
    {
      "Id": 101520300,
      "Speaker": "Student",
      "Text": "その時も、願わくば――"
    },
    {
      "Id": 101520310,
      "Speaker": "Student",
      "Text": "平和なひとときとなりますように"
    },
    {
      "Id": 101520320,
      "Speaker": "Student",
      "Text": "先日小耳にはさんだのですが……"
    },
    {
      "Id": 101520330,
      "Speaker": "Student",
      "Text": "先生はよく夜勤をされているのだとか"
    },
    {
      "Id": 101520340,
      "Speaker": "Student",
      "Text": "作業中、睡魔に襲われた時は"
    },
    {
      "Id": 101520350,
      "Speaker": "Student",
      "Text": "どうなさっているのですか？"
    },
    {
      "Id": 101520360,
      "Speaker": "Player",
      "Text": "公園を散歩したりしてるかな"
    },
    {
      "Id": 101520370,
      "Speaker": "Student",
      "Text": "そうなのですね"
    },
    {
      "Id": 101520380,
      "Speaker": "Student",
      "Text": "「眠れる森の美女」である私としては"
    },
    {
      "Id": 101520390,
      "Speaker": "Student",
      "Text": "運命的なものを感じずにはいられません"
    },
    {
      "Id": 101520400,
      "Speaker": "Player",
      "Text": "そ、それはどういう……？"
    },
    {
      "Id": 101520410,
      "Speaker": "Student",
      "Text": "ふふっ、何でもありません"
    },
    {
      "Id": 101520420,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "今日も良い一日をお過ごしください"
    },
    {
      "Id": 101520430,
      "Speaker": "Student",
      "Text": "先日はありがとうございました、先生"
    },
    {
      "Id": 101520440,
      "Speaker": "Student",
      "Text": "おかげで、誰にも気づかれることなく寮に戻れました"
    },
    {
      "Id": 101520450,
      "Speaker": "Player",
      "Text": "こっちもツムギのおかげで、仕事が片付いたよ"
    },
    {
      "Id": 101520460,
      "Speaker": "Student",
      "Text": "お互いにウィンウィンというわけですね"
    },
    {
      "Id": 101520470,
      "Speaker": "Student",
      "Text": "また夜に抜け出すようなことがあれば"
    },
    {
      "Id": 101520480,
      "Speaker": "Student",
      "Text": "先生のところへ伺いますね"
    },
    {
      "Id": 101520490,
      "Speaker": "Student",
      "Text": "デスメタルも良いですが"
    },
    {
      "Id": 101520500,
      "Speaker": "Student",
      "Text": "その時はもう少し……"
    },
    {
      "Id": 101520510,
      "Speaker": "Student",
      "Text": "甘美な曲も、聴いていただきたいです"
    },
    {
      "Id": 101520520,
      "Speaker": "Student",
      "Text": "先生、いかがお過ごしですか？"
    },
    {
      "Id": 101520530,
      "Speaker": "Student",
      "Text": "毎日、楽しんでいらっしゃいますか？"
    },
    {
      "Id": 101520540,
      "Speaker": "Player",
      "Text": "うん、毎日楽しいよ！"
    },
    {
      "Id": 101520550,
      "Speaker": "Student",
      "Text": "それはよかったです"
    },
    {
      "Id": 101520560,
      "Speaker": "Student",
      "Text": "私も、心躍る毎日を送っています"
    },
    {
      "Id": 101520570,
      "Speaker": "Student",
      "Text": "人生は楽しんでこそ、ですからね"
    },
    {
      "Id": 101520580,
      "Speaker": "Student",
      "Text": "もちろん、時には気が滅入る日もありますが"
    },
    {
      "Id": 101520590,
      "Speaker": "Student",
      "Text": "憂鬱な気分は、早々に手放してしまうのが一番です"
    },
    {
      "Id": 101520600,
      "Speaker": "Player",
      "Text": "私もそう思う！"
    },
    {
      "Id": 101520610,
      "Speaker": "Student",
      "Text": "ああ、皆が同じように考えることが出来たなら"
    },
    {
      "Id": 101520620,
      "Speaker": "Student",
      "Text": "世界はもっと平和になるでしょうに……"
    },
    {
      "Id": 101520630,
      "Speaker": "Student",
      "Text": "では今日も、人々の喜びと平和のため"
    },
    {
      "Id": 101520640,
      "Speaker": "Student",
      "Text": "ギターを奏でてきます"
    },
    {
      "Id": 101520650,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "お時間がありましたら、あの公園でお会いしましょう"
    },
    {
      "Id": 101520660,
      "Speaker": "Student",
      "Text": "今日は"
    },
    {
      "Id": 101520670,
      "Speaker": "Student",
      "Text": "創作意欲の高まりを感じます"
    },
    {
      "Id": 101520680,
      "Speaker": "Student",
      "Text": "実は、先生と一緒に行きたい場所があるのですが"
    },
    {
      "Id": 101520690,
      "Speaker": "Student",
      "Text": "よろしいでしょうか？"
    },
    {
      "Id": 101520700,
      "Speaker": "Player",
      "Text": "もちろん付き合うよ！"
    },
    {
      "Id": 101520710,
      "Speaker": "Student",
      "Text": "ではこれから"
    },
    {
      "Id": 101520720,
      "Speaker": "Student",
      "Text": "ワイルドハントの美術館に行きませんか？"
    },
    {
      "Id": 101520730,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "新しい展示会が始まったんです"
    }
  ],
  "DialogKR": [
    {
      "Id": 101520010,
      "Speaker": "Student",
      "Text": "두둥"
    },
    {
      "Id": 101520020,
      "Speaker": "Student",
      "Text": "안녕하세요, 선생님."
    },
    {
      "Id": 101520030,
      "Speaker": "Student",
      "Text": "밴드계의 백설공주."
    },
    {
      "Id": 101520040,
      "Speaker": "Student",
      "Text": "시이나 츠무기의 등장입니다."
    },
    {
      "Id": 101520050,
      "Speaker": "Player",
      "Text": "배, 백설공주?"
    },
    {
      "Id": 101520060,
      "Speaker": "Student",
      "Text": "물론 거울이 저를 아름답다고 말하진 않습니다만……"
    },
    {
      "Id": 101520070,
      "Speaker": "Student",
      "Text": "어필"
    },
    {
      "Id": 101520080,
      "Speaker": "Student",
      "Text": "은 언제나 중요하니까요."
    },
    {
      "Id": 101520090,
      "Speaker": "Student",
      "Text": "그런 의미에서 질문."
    },
    {
      "Id": 101520100,
      "Speaker": "Student",
      "Text": "오늘은 무슨 날일까요?"
    },
    {
      "Id": 101520110,
      "Speaker": "Player",
      "Text": "츠무기가 공원에서 버스킹 하는 날!"
    },
    {
      "Id": 101520120,
      "Speaker": "Student",
      "Text": "후후."
    },
    {
      "Id": 101520130,
      "Speaker": "Student",
      "Text": "이 얼마나 놀라운 통찰력."
    },
    {
      "Id": 101520140,
      "Speaker": "Student",
      "Text": "역시 제 기대를 저버리지 않으시네요."
    },
    {
      "Id": 101520150,
      "Speaker": "Student",
      "Text": "그럼 시간이 날 때 찾아와 주세요."
    },
    {
      "Id": 101520160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "저는 항상 그곳에 있을 테니."
    },
    {
      "Id": 101520170,
      "Speaker": "Student",
      "Text": "아아, 오늘 연주는 평소보다 즐거웠네요."
    },
    {
      "Id": 101520180,
      "Speaker": "Student",
      "Text": "선생님은 어떠셨나요?"
    },
    {
      "Id": 101520190,
      "Speaker": "Student",
      "Text": "충분히 즐겨 주셨나요?"
    },
    {
      "Id": 101520200,
      "Speaker": "Player",
      "Text": "스트레스가 모두 날아갔어!"
    },
    {
      "Id": 101520210,
      "Speaker": "Student",
      "Text": "후후, 그렇다면 다행이네요."
    },
    {
      "Id": 101520220,
      "Speaker": "Student",
      "Text": "독 사과를 먹고 긴 잠에 빠져도 여한이 없어요."
    },
    {
      "Id": 101520230,
      "Speaker": "Student",
      "Text": "물론 진짜 독 사과를 먹는 것도"
    },
    {
      "Id": 101520240,
      "Speaker": "Student",
      "Text": "긴 잠에 빠지는 것도 아닙니다만,"
    },
    {
      "Id": 101520250,
      "Speaker": "Student",
      "Text": "여기서는 그런……."
    },
    {
      "Id": 101520260,
      "Speaker": "Player",
      "Text": "표현력이 중요하니까?"
    },
    {
      "Id": 101520270,
      "Speaker": "Student",
      "Text": "어머나."
    },
    {
      "Id": 101520280,
      "Speaker": "Student",
      "Text": "역시 저와 마음이 통하는 분."
    },
    {
      "Id": 101520290,
      "Speaker": "Student",
      "Text": "그럼 다음 만남도 기다리고 있겠습니다."
    },
    {
      "Id": 101520300,
      "Speaker": "Student",
      "Text": "그때도 부디"
    },
    {
      "Id": 101520310,
      "Speaker": "Student",
      "Text": "평화로운 한때가 되기를."
    },
    {
      "Id": 101520320,
      "Speaker": "Student",
      "Text": "그러고 보니 선생님."
    },
    {
      "Id": 101520330,
      "Speaker": "Student",
      "Text": "야근을 많이 하신다 들었습니다만."
    },
    {
      "Id": 101520340,
      "Speaker": "Student",
      "Text": "참을 수 없이 잠이 쏟아질 때는"
    },
    {
      "Id": 101520350,
      "Speaker": "Student",
      "Text": "어떻게 하시나요?"
    },
    {
      "Id": 101520360,
      "Speaker": "Player",
      "Text": "요즘엔 잠깐 공원을 산책해."
    },
    {
      "Id": 101520370,
      "Speaker": "Student",
      "Text": "아하. 그러셨군요."
    },
    {
      "Id": 101520380,
      "Speaker": "Student",
      "Text": "잠자는 숲속의 공주인 저로서는"
    },
    {
      "Id": 101520390,
      "Speaker": "Student",
      "Text": "센티멘탈리즘한 운명을 느끼게 되네요."
    },
    {
      "Id": 101520400,
      "Speaker": "Player",
      "Text": "어, 어느 부분에서?"
    },
    {
      "Id": 101520410,
      "Speaker": "Student",
      "Text": "후후, 아무것도 아니랍니다."
    },
    {
      "Id": 101520420,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그럼 오늘 하루도 힘내시길."
    },
    {
      "Id": 101520430,
      "Speaker": "Student",
      "Text": "감사합니다, 선생님."
    },
    {
      "Id": 101520440,
      "Speaker": "Student",
      "Text": "덕분에 들키지 않고 기숙사에 복귀했어요."
    },
    {
      "Id": 101520450,
      "Speaker": "Player",
      "Text": "나도 덕분에 일을 모두 마무리할 수 있었어."
    },
    {
      "Id": 101520460,
      "Speaker": "Student",
      "Text": "이걸로 서로 윈윈인 거네요."
    },
    {
      "Id": 101520470,
      "Speaker": "Student",
      "Text": "혹시 또 외박할 일이 생긴다면"
    },
    {
      "Id": 101520480,
      "Speaker": "Student",
      "Text": "선생님을 찾아갈게요."
    },
    {
      "Id": 101520490,
      "Speaker": "Student",
      "Text": "데스메탈도 좋지만"
    },
    {
      "Id": 101520500,
      "Speaker": "Student",
      "Text": "그때는 좀 더……"
    },
    {
      "Id": 101520510,
      "Speaker": "Student",
      "Text": "감미로운 곡을 연주했으면 좋겠네요."
    },
    {
      "Id": 101520520,
      "Speaker": "Student",
      "Text": "선생님. 요즘 어떠신가요?"
    },
    {
      "Id": 101520530,
      "Speaker": "Student",
      "Text": "즐거우신가요?"
    },
    {
      "Id": 101520540,
      "Speaker": "Player",
      "Text": "매일이 즐거워!"
    },
    {
      "Id": 101520550,
      "Speaker": "Student",
      "Text": "다행이네요."
    },
    {
      "Id": 101520560,
      "Speaker": "Student",
      "Text": "저도 매일이 즐겁답니다."
    },
    {
      "Id": 101520570,
      "Speaker": "Student",
      "Text": "역시 인생은 즐거워야죠."
    },
    {
      "Id": 101520580,
      "Speaker": "Student",
      "Text": "물론 즐겁지 않은 날도 있습니다만"
    },
    {
      "Id": 101520590,
      "Speaker": "Student",
      "Text": "안 좋은 생각은 빨리 털어버리는 게 좋죠."
    },
    {
      "Id": 101520600,
      "Speaker": "Player",
      "Text": "그렇지!"
    },
    {
      "Id": 101520610,
      "Speaker": "Student",
      "Text": "아아, 모두가 우리와 같다면"
    },
    {
      "Id": 101520620,
      "Speaker": "Student",
      "Text": "이 세계엔 평화가 가득할 텐데."
    },
    {
      "Id": 101520630,
      "Speaker": "Student",
      "Text": "그럼 오늘도 모두의 즐거움과 평화를 위해"
    },
    {
      "Id": 101520640,
      "Speaker": "Student",
      "Text": "기타를 들겠습니다."
    },
    {
      "Id": 101520650,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "시간이 되신다면 그 공원에서 뵈어요."
    },
    {
      "Id": 101520660,
      "Speaker": "Student",
      "Text": "오늘은"
    },
    {
      "Id": 101520670,
      "Speaker": "Student",
      "Text": "영감이 샘솟는 하루네요."
    },
    {
      "Id": 101520680,
      "Speaker": "Student",
      "Text": "그런 의미에서 같이 가보고 싶은 장소가 있는데"
    },
    {
      "Id": 101520690,
      "Speaker": "Student",
      "Text": "어떠실까요?"
    },
    {
      "Id": 101520700,
      "Speaker": "Player",
      "Text": "언제든 불러만 줘."
    },
    {
      "Id": 101520710,
      "Speaker": "Student",
      "Text": "그럼 오늘은"
    },
    {
      "Id": 101520720,
      "Speaker": "Student",
      "Text": "우리 학원의 미술관에서 만날까요?"
    },
    {
      "Id": 101520730,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "오늘부터 새로운 작품전이 개최된다고 해요."
    }
  ],
