    {
      "Id": 260150340,
      "Speaker": "Student",
      "Text": "그래도 그건"
    },
    {
      "Id": 260150350,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 260150360,
      "Speaker": "Student",
      "Text": "좋습니다 ㅎㅎ"
    },
    {
      "Id": 260150370,
      "Speaker": "Student",
      "Text": "안녕히 주무세요"
    },
    {
      "Id": 260150380,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 260150390,
      "Speaker": "Student",
      "Text": "주무십니까?"
    },
    {
      "Id": 260150400,
      "Speaker": "Player",
      "Text": "아니, 깨 있어."
    },
    {
      "Id": 260150410,
      "Speaker": "Player",
      "Text": "이 메시지만을 기다리고 있었습니다."
    },
    {
      "Id": 260150420,
      "Speaker": "Student",
      "Text": "그러면"
    },
    {
      "Id": 260150430,
      "Speaker": "Student",
      "Text": "잠깐 시간 괜찮습니까?"
