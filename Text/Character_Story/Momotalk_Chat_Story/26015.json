      "Speaker": "Player",
      "Text": "무슨 일이야?"
    },
    {
      "Id": 260150510,
      "Speaker": "Student",
      "Text": "으으"
    },
    {
      "Id": 260150520,
      "Speaker": "Student",
      "Text": "그걸 꼭"
    },
    {
      "Id": 260150530,
      "Speaker": "Student",
      "Text": "제가 말하게 합니까?"
    },
    {
      "Id": 260150540,
      "Speaker": "Student",
      "Text": "저번 밤 말입니다"
    },
    {
      "Id": 260150550,
      "Speaker": "Player",
      "Text": "안 그래도 할 말이 있었어."
    },
    {
      "Id": 260150560,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 260150570,
      "Speaker": "Player",
      "Text": "숙소 앞에서 보자!"
    },
    {
      "Id": 260150580,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 260150590,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "아 네"
    },
    {
      "Id": 260150600,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 260150610,
      "Speaker": "Student",
      "Text": "진짜 막해요?"
    },
    {
      "Id": 260150620,
      "Speaker": "Player",
