    {
      "Id": 260150640,
      "Speaker": "Student",
      "Text": "ㅋㅋ"
    },
    {
      "Id": 260150650,
      "Speaker": "Student",
      "Text": "네"
    }
  ],
  "DialogEN": [
    {
      "Id": 260150010,
      "Speaker": "Student",
      "Text": "The ocean"
    },
    {
      "Id": 260150020,
      "Speaker": "Student",
      "Text": "The thing about it is"
    },
    {
      "Id": 260150030,
      "Speaker": "Student",
      "Text": "it always looks like some fantasy paradise in shows and stuff"
    },
    {
      "Id": 260150040,
      "Speaker": "Student",
      "Text": "But there's actually not that much to do here..."
    },
    {
      "Id": 260150050,
      "Speaker": "Player",
      "Text": "Please enjoy your youth a little more."
    },
    {
      "Id": 260150060,
      "Speaker": "Player",
      "Text": "You sound like a jaded, corporate slave..."
    },
    {
      "Id": 260150070,
      "Speaker": "Student",
      "Text": "Haha"
    },
    {
      "Id": 260150080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Fair point."
    },
    {
      "Id": 260150090,
      "Speaker": "Student",
      "Text": "I've been"
    },
    {
      "Id": 260150100,
      "Speaker": "Student",
      "Text": "thinking."
    },
    {
      "Id": 260150110,
      "Speaker": "Student",
      "Text": "I don't think this \"vacation\" thing is really for me"
    },
    {
      "Id": 260150120,
      "Speaker": "Student",
      "Text": "hah"
    },
    {
      "Id": 260150130,
      "Speaker": "Player",
      "Text": "Please enjoy your youth a little more."
    },
    {
      "Id": 260150140,
      "Speaker": "Player",
      "Text": "You sound like a jaded, corporate slave..."
    },
    {
      "Id": 260150150,
      "Speaker": "Student",
      "Text": "Deja vu? lol"
    },
    {
      "Id": 260150160,
      "Speaker": "Student",
      "Text": "You asleep?"
    },
    {
      "Id": 260150170,
      "Speaker": "Player",
      "Text": "No, why?"
    },
    {
      "Id": 260150180,
      "Speaker": "Player",
      "Text": "Yes, I'm sleeping."
    },
    {
      "Id": 260150190,
      "Speaker": "Student",
      "Text": "Oh. I just can't fall sleep."
    },
    {
      "Id": 260150200,
      "Speaker": "Student",
      "Text": "It's okay, though."
    },
    {
      "Id": 260150210,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 260150220,
      "Speaker": "Student",
      "Text": "...?"
    },
    {
      "Id": 260150230,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 260150240,
      "Speaker": "Student",
      "Text": "hah"
    },
    {
      "Id": 260150250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Good night."
    },
    {
      "Id": 260150260,
      "Speaker": "Student",
      "Text": "I really do"
    },
    {
      "Id": 260150270,
      "Speaker": "Student",
      "Text": "feel like I lost"
    },
    {
      "Id": 260150280,
      "Speaker": "Player",
      "Text": "Hm? About what?"
    },
    {
      "Id": 260150290,
      "Speaker": "Student",
      "Text": "A precious walk"
    },
    {
      "Id": 260150300,
      "Speaker": "Student",
      "Text": "turned into a therapy session."
    },
    {
      "Id": 260150310,
      "Speaker": "Player",
      "Text": "Call me again if you can't sleep!"
    },
    {
      "Id": 260150320,
      "Speaker": "Player",
      "Text": "Let's go for a night walk again!"
    },
    {
      "Id": 260150330,
      "Speaker": "Student",
      "Text": "no"
    },
    {
      "Id": 260150340,
      "Speaker": "Student",
      "Text": "That's a bit"
    },
    {
      "Id": 260150350,
      "Speaker": "Student",
      "Text": "Mm"
    },
    {
      "Id": 260150360,
      "Speaker": "Student",
      "Text": "Fine. Sounds good. lol"
    },
    {
      "Id": 260150370,
      "Speaker": "Student",
      "Text": "Good night."
    },
    {
      "Id": 260150380,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 260150390,
      "Speaker": "Student",
      "Text": "Are you asleep?"
    },
    {
      "Id": 260150400,
      "Speaker": "Player",
      "Text": "No, I'm awake."
    },
    {
      "Id": 260150410,
      "Speaker": "Player",
      "Text": "I've been waiting for your message!"
    },
    {
      "Id": 260150420,
      "Speaker": "Student",
      "Text": "In that case"
    },
    {
      "Id": 260150430,
      "Speaker": "Student",
      "Text": "Do you have some time?"
    },
    {
      "Id": 260150440,
      "Speaker": "Student",
      "Text": "Haha"
    },
    {
      "Id": 260150450,
      "Speaker": "Student",
      "Text": "You're so dramatic."
    },
    {
      "Id": 260150460,
      "Speaker": "Player",
      "Text": "Let's meet at the beach out front!"
    },
    {
      "Id": 260150470,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Got it"
    },
    {
      "Id": 260150480,
      "Speaker": "Student",
      "Text": "I'm sorry..."
