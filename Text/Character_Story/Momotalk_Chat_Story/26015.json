{
  "CharacterId": 26015,
  "DialogJP": [
    {
      "Id": 260150010,
      "Speaker": "Student",
      "Text": "海って……"
    },
    {
      "Id": 260150020,
      "Speaker": "Student",
      "Text": "雑誌やテレビでいうほど"
    },
    {
      "Id": 260150030,
      "Speaker": "Student",
      "Text": "キラキラしてないっていうか"
    },
    {
      "Id": 260150040,
      "Speaker": "Student",
      "Text": "あんまりやることないっすね"
    },
    {
      "Id": 260150050,
      "Speaker": "Player",
      "Text": "ドライだなぁ……"
    },
    {
      "Id": 260150060,
      "Speaker": "Player",
      "Text": "せっかくの青春、楽しまなきゃ！"
    },
    {
      "Id": 260150070,
      "Speaker": "Student",
      "Text": "はは"
    },
    {
      "Id": 260150080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "それもそうっすね"
    },
    {
      "Id": 260150090,
      "Speaker": "Student",
      "Text": "あれから考えてみたんですけど"
    },
    {
      "Id": 260150100,
      "Speaker": "Student",
      "Text": "やっぱ"
    },
    {
      "Id": 260150110,
      "Speaker": "Student",
      "Text": "お休みを満喫するのって"
    },
    {
      "Id": 260150120,
      "Speaker": "Student",
      "Text": "あんまり得意じゃないっすね！"
    },
    {
      "Id": 260150130,
      "Speaker": "Player",
      "Text": "ドライだなぁ……"
    },
    {
      "Id": 260150140,
      "Speaker": "Player",
      "Text": "せっかくの青春、楽しまなきゃ！"
    },
    {
      "Id": 260150150,
      "Speaker": "Student",
      "Text": "前にもこんなやりとりしませんでしたっけ？"
    },
    {
      "Id": 260150160,
      "Speaker": "Student",
      "Text": "先生、起きてます？"
    },
    {
      "Id": 260150170,
      "Speaker": "Player",
      "Text": "起きてるよ、どうしたの？"
    },
    {
      "Id": 260150180,
      "Speaker": "Player",
      "Text": "そろそろ寝ようかなって"
    },
    {
      "Id": 260150190,
      "Speaker": "Student",
      "Text": "ちょっと眠れないなって"
    },
    {
      "Id": 260150200,
      "Speaker": "Student",
      "Text": "でも平気です！"
    },
    {
      "Id": 260150210,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 260150220,
      "Speaker": "Student",
      "Text": "それなら大丈夫です"
    },
    {
      "Id": 260150230,
      "Speaker": "Student",
      "Text": "お邪魔しました！"
    },
    {
      "Id": 260150240,
      "Speaker": "Student",
      "Text": "んじゃ"
    },
    {
      "Id": 260150250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "おやすみなさい"
    },
    {
      "Id": 260150260,
      "Speaker": "Student",
      "Text": "ふむ"
    },
    {
      "Id": 260150270,
      "Speaker": "Student",
      "Text": "ちょっと損した気分です"
    },
    {
      "Id": 260150280,
      "Speaker": "Player",
      "Text": "何が？"
    },
    {
      "Id": 260150290,
      "Speaker": "Student",
      "Text": "せっかくの夜の散歩が"
    },
    {
      "Id": 260150300,
      "Speaker": "Student",
      "Text": "途中から面談になってました"
    },
    {
      "Id": 260150310,
      "Speaker": "Player",
      "Text": "眠れなくなったら、いつでも呼んで！"
    },
    {
      "Id": 260150320,
      "Speaker": "Player",
      "Text": "また散歩しよう！"
    },
    {
      "Id": 260150330,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 260150340,
      "Speaker": "Student",
      "Text": "それって"
    },
    {
      "Id": 260150350,
      "Speaker": "Student",
      "Text": "ええと"
    },
    {
      "Id": 260150360,
      "Speaker": "Student",
      "Text": "…了解です！"
    },
    {
      "Id": 260150370,
      "Speaker": "Student",
      "Text": "おやすみなさい、先生"
    },
    {
      "Id": 260150380,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 260150390,
      "Speaker": "Student",
      "Text": "寝てます？"
    },
    {
      "Id": 260150400,
      "Speaker": "Player",
      "Text": "起きてるよ！"
    },
    {
      "Id": 260150410,
      "Speaker": "Player",
      "Text": "待ってました！"
    },
    {
      "Id": 260150420,
      "Speaker": "Student",
      "Text": "じゃあ"
    },
    {
      "Id": 260150430,
      "Speaker": "Student",
      "Text": "ちょっとお時間、いいっすか？"
    },
    {
      "Id": 260150440,
      "Speaker": "Student",
      "Text": "はは"
    },
    {
      "Id": 260150450,
      "Speaker": "Student",
      "Text": "またまた～"
    },
    {
      "Id": 260150460,
      "Speaker": "Player",
      "Text": "宿の前で会おうね"
    },
    {
      "Id": 260150470,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "はーい"
    },
    {
      "Id": 260150480,
      "Speaker": "Student",
      "Text": "すみません……"
    },
    {
      "Id": 260150490,
      "Speaker": "Player",
      "Text": "何事？"
    },
    {
      "Id": 260150500,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 260150510,
      "Speaker": "Student",
      "Text": "う"
    },
    {
      "Id": 260150520,
      "Speaker": "Student",
      "Text": "それ私から"
    },
    {
      "Id": 260150530,
      "Speaker": "Student",
      "Text": "言わせるんですか？"
    },
    {
      "Id": 260150540,
      "Speaker": "Student",
      "Text": "…昨夜のことです"
    },
    {
      "Id": 260150550,
      "Speaker": "Player",
      "Text": "ちょっと話したいことがあるんだけれど"
    },
    {
      "Id": 260150560,
      "Speaker": "Student",
      "Text": "はい？"
    },
    {
      "Id": 260150570,
      "Speaker": "Player",
      "Text": "宿の前集合！"
    },
    {
      "Id": 260150580,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 260150590,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "了解です"
    },
    {
      "Id": 260150600,
      "Speaker": "Student",
      "Text": "もう"
    },
    {
      "Id": 260150610,
      "Speaker": "Student",
      "Text": "手加減しないっすからね？"
    },
    {
      "Id": 260150620,
      "Speaker": "Player",
      "Text": "わ、分かった！"
    },
    {
      "Id": 260150630,
      "Speaker": "Player",
      "Text": "お手柔らかにお願いします……！"
    },
    {
      "Id": 260150640,
      "Speaker": "Student",
      "Text": "ははっ"
    },
    {
      "Id": 260150650,
      "Speaker": "Student",
      "Text": "これからもよろしくっす、先生"
    }
  ],
  "DialogKR": [
    {
      "Id": 260150010,
      "Speaker": "Student",
      "Text": "바다"
    },
