    {
      "Id": 160140110,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "แน่นอน มาได้นะ"
    },
    {
      "Id": 160140120,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "ครูยินดีต้อนรับอิบูกิเสมอเลย"
