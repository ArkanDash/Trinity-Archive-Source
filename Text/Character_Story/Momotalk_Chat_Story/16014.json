    {
      "Id": 160140090,
      "Speaker": "Student",
      "Text": "ดีใจจุง!"
    },
    {
      "Id": 160140100,
      "Speaker": "Student",
      "Text": "งั้นอิบูกิไปหาคุณครูได้มั้ย?"
