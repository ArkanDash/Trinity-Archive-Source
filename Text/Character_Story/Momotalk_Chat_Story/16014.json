{
  "CharacterId": 16014,
  "DialogJP": [
    {
      "Id": 160140010,
      "Speaker": "Student",
      "Text": "せんせい"
    },
    {
      "Id": 160140020,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 160140030,
      "Speaker": "Student",
      "Text": "おはよう！"
    },
    {
      "Id": 160140040,
      "Speaker": "Student",
      "Text": "イブキだよ！"
    },
    {
      "Id": 160140050,
      "Speaker": "Player",
      "Text": "おはようイブキ！元気にしてる？"
    },
    {
      "Id": 160140060,
      "Speaker": "Student",
      "Text": "うん！元気だよ！"
    },
    {
      "Id": 160140070,
      "Speaker": "Student",
      "Text": "先生は？"
    },
    {
      "Id": 160140080,
      "Speaker": "Player",
      "Text": "うん、先生も元気だよ！"
    },
    {
      "Id": 160140090,
      "Speaker": "Student",
      "Text": "よかった！"
    },
    {
      "Id": 160140100,
      "Speaker": "Student",
      "Text": "これから先生のところ行ってもいい？"
    },
    {
      "Id": 160140110,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "もちろんだよ"
    },
    {
      "Id": 160140120,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "いつでもおいで"
    },
    {
      "Id": 160140130,
      "Speaker": "Student",
      "Text": "せんせい！"
    },
    {
      "Id": 160140140,
      "Speaker": "Student",
      "Text": "イブキたよ！"
    },
    {
      "Id": 160140150,
      "Speaker": "Student",
      "Text": "イブキだよ！"
    },
    {
      "Id": 160140160,
      "Speaker": "Student",
      "Text": "今日も遊びに行っていい？"
    },
    {
      "Id": 160140170,
      "Speaker": "Student",
      "Text": "イブキ、先生と遊びたい！"
    },
    {
      "Id": 160140180,
      "Speaker": "Player",
      "Text": "もちろん、待ってるね"
    },
    {
      "Id": 160140190,
      "Speaker": "Player",
      "Text": "気をつけておいでね"
    },
    {
      "Id": 160140200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ありがとう！すぐ行くね、せんせい！"
    },
    {
      "Id": 160140210,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 160140220,
      "Speaker": "Student",
      "Text": "今日すっごく楽しかった！"
    },
    {
      "Id": 160140230,
      "Speaker": "Student",
      "Text": "先生とゲームして、鬼ごっこして、かくれんぼして……"
    },
    {
      "Id": 160140240,
      "Speaker": "Player",
      "Text": "あんなに遊んで疲れてない？"
    },
    {
      "Id": 160140250,
      "Speaker": "Student",
      "Text": "全然疲れてないよ！"
    },
    {
      "Id": 160140260,
      "Speaker": "Student",
      "Text": "イブキ、明日も遊びたい！"
    },
    {
      "Id": 160140270,
      "Speaker": "Player",
      "Text": "も、もちろん私も遊びたいよ"
    },
    {
      "Id": 160140280,
      "Speaker": "Student",
      "Text": "やったぁ！遊びに行くね！"
    },
    {
      "Id": 160140290,
      "Speaker": "Student",
      "Text": "じゃあまたね、先生！"
    },
    {
      "Id": 160140300,
      "Speaker": "Student",
      "Text": "せんせい"
    },
    {
      "Id": 160140310,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 160140320,
      "Speaker": "Student",
      "Text": "聞きたいことがあるの！"
    },
    {
      "Id": 160140330,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 160140340,
      "Speaker": "Student",
      "Text": "先生はいつも忙しそうだけど"
    },
    {
      "Id": 160140350,
      "Speaker": "Student",
      "Text": "お仕事って楽しいの？"
    },
    {
      "Id": 160140360,
      "Speaker": "Player",
      "Text": "そ、そうだね……"
    },
    {
      "Id": 160140370,
      "Speaker": "Player",
      "Text": "た、楽しいよ……うん……"
    },
    {
      "Id": 160140380,
      "Speaker": "Player",
      "Text": "それで急にどうしたの？"
    },
    {
      "Id": 160140390,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 160140400,
      "Speaker": "Student",
      "Text": "イブキ、文字だと時間かかるから"
    },
    {
      "Id": 160140410,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "会って話すね！"
    },
    {
      "Id": 160140420,
      "Speaker": "Student",
      "Text": "先生！！"
    },
    {
      "Id": 160140430,
      "Speaker": "Student",
      "Text": "忙しい？"
    },
    {
      "Id": 160140440,
      "Speaker": "Player",
      "Text": "全然！"
    },
    {
      "Id": 160140450,
      "Speaker": "Player",
      "Text": "ちょうど今、時間ができたところだよ！"
    },
    {
      "Id": 160140460,
      "Speaker": "Student",
      "Text": "良かった！"
    },
    {
      "Id": 160140470,
      "Speaker": "Student",
      "Text": "あれからたくさん考えてみたの"
    },
    {
      "Id": 160140480,
      "Speaker": "Student",
      "Text": "イブキには何ができるのか"
    },
    {
      "Id": 160140490,
      "Speaker": "Student",
      "Text": "一番好きなことは何なのか！"
    },
    {
      "Id": 160140500,
      "Speaker": "Student",
      "Text": "それでね"
    },
    {
      "Id": 160140510,
      "Speaker": "Student",
      "Text": "先生を招待しようと思って！"
    },
    {
      "Id": 160140520,
      "Speaker": "Player",
      "Text": "招待？"
    },
    {
      "Id": 160140530,
      "Speaker": "Student",
      "Text": "うん！"
    },
    {
      "Id": 160140540,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "今からイブキのところ来てくれる？"
    }
  ],
  "DialogKR": [
    {
      "Id": 160140010,
      "Speaker": "Student",
      "Text": "선ㅅ애님"
    },
    {
      "Id": 160140020,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 160140030,
      "Speaker": "Student",
      "Text": "안ㄴ녕하세요!"
    },
    {
      "Id": 160140040,
      "Speaker": "Student",
      "Text": "이부키입니다!!"
    },
    {
      "Id": 160140050,
      "Speaker": "Player",
      "Text": "안녕, 이부키. 잘 지냈니?"
    },
    {
      "Id": 160140060,
      "Speaker": "Student",
      "Text": "응! 나는 잘 지ㅆ내어!"
    },
    {
      "Id": 160140070,
      "Speaker": "Student",
      "Text": "선생님은 어때?"
    },
    {
      "Id": 160140080,
      "Speaker": "Player",
      "Text": "응, 선생님도 잘 지냈어요."
    },
    {
      "Id": 160140090,
      "Speaker": "Student",
      "Text": "다행이다!"
    },
    {
      "Id": 160140100,
      "Speaker": "Student",
      "Text": "그럼 선생님한테 가도 돼?"
    },
    {
      "Id": 160140110,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "물론이지."
    },
    {
      "Id": 160140120,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "이부키는 언제나 환영이야."
    },
    {
      "Id": 160140130,
      "Speaker": "Student",
      "Text": "선생님선생님"
    },
    {
      "Id": 160140140,
      "Speaker": "Student",
      "Text": "이부키ㅇ빕니다"
    },
    {
      "Id": 160140150,
      "Speaker": "Student",
      "Text": "이부키입니다!"
    },
    {
      "Id": 160140160,
      "Speaker": "Student",
      "Text": "샬레에 놀러 가도 돼?"
    },
    {
      "Id": 160140170,
      "Speaker": "Student",
      "Text": "오늘 당번은 아니지만 선생님이랑 놀고 싶어!"
    },
    {
      "Id": 160140180,
      "Speaker": "Player",
      "Text": "물론이지. 기다리고 있을게."
    },
    {
      "Id": 160140190,
      "Speaker": "Player",
      "Text": "뛰지 말고 조심해서 와야 한다?"
    },
    {
      "Id": 160140200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "응! 고마워! 이따가 만ㄴ나요 선ㅅ생님!"
    },
    {
      "Id": 160140210,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 160140220,
      "Speaker": "Student",
      "Text": "오늘 너무 재밌었어!"
    },
    {
      "Id": 160140230,
      "Speaker": "Student",
      "Text": "선생님이랑 게임도 하고, 술래잡기도 하고, 숨바꼭질도 하고……."
    },
    {
      "Id": 160140240,
      "Speaker": "Player",
      "Text": "하루 종일 뛰어놀았는데 힘들지는 않아, 이부키?"
    },
    {
      "Id": 160140250,
      "Speaker": "Student",
      "Text": "아니, 하나도 안 힘들어!"
    },
    {
      "Id": 160140260,
      "Speaker": "Student",
      "Text": "선생님도 그렇지?"
    },
    {
      "Id": 160140270,
      "Speaker": "Player",
      "Text": "무, 물론이지."
    },
    {
      "Id": 160140280,
      "Speaker": "Student",
      "Text": "그럼 다음번에 또 샬레 파크에 놀러 갈게!"
    },
    {
      "Id": 160140290,
      "Speaker": "Student",
      "Text": "또 같이 놀자, 선생님!"
    },
    {
      "Id": 160140300,
      "Speaker": "Student",
      "Text": "선ㅅ앵님"
    },
    {
      "Id": 160140310,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 160140320,
      "Speaker": "Student",
      "Text": "궁금한 게 생겼어!"
    },
    {
      "Id": 160140330,
      "Speaker": "Player",
      "Text": "뭐가 궁금하니, 이부키?"
    },
    {
      "Id": 160140340,
      "Speaker": "Student",
      "Text": "샬레에 갈 때마다 선생님은 일을 하고 있잖아?"
    },
    {
      "Id": 160140350,
      "Speaker": "Student",
      "Text": "일이 그렇게 재미있는 거야?"
    },
    {
      "Id": 160140360,
      "Speaker": "Player",
      "Text": "그, 그렇게 생각할 수도 있겠네……."
    },
    {
      "Id": 160140370,
      "Speaker": "Player",
      "Text": "재미……있죠……그럼요……."
    },
    {
      "Id": 160140380,
      "Speaker": "Player",
      "Text": "근데 갑자기 그건 왜 궁금해진 거야?"
    },
    {
      "Id": 160140390,
      "Speaker": "Student",
      "Text": "응, 그게"
    },
    {
      "Id": 160140400,
      "Speaker": "Student",
      "Text": "이부키는 손가락이 느리니까"
    },
    {
      "Id": 160140410,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "직접 가서 말해줄게!"
    },
    {
      "Id": 160140420,
      "Speaker": "Student",
      "Text": "선생님!!"
    },
    {
      "Id": 160140430,
      "Speaker": "Student",
      "Text": "지금 바빠?"
    },
    {
      "Id": 160140440,
      "Speaker": "Player",
      "Text": "아니, 한가해."
    },
    {
      "Id": 160140450,
      "Speaker": "Player",
      "Text": "방금 안 바빠졌어."
    },
    {
      "Id": 160140460,
      "Speaker": "Student",
      "Text": "다행이다!"
    },
    {
      "Id": 160140470,
      "Speaker": "Student",
      "Text": "이부키, 지난번에 선생님이랑 여러 곳을 다닌 다음에 생각해 봤어."
    },
    {
      "Id": 160140480,
      "Speaker": "Student",
      "Text": "이부키가 무엇을 하고 싶은지"
    },
    {
      "Id": 160140490,
      "Speaker": "Student",
      "Text": "이부키가 가장 좋아하는 것이 무엇인지!"
    },
    {
      "Id": 160140500,
      "Speaker": "Student",
      "Text": "그래서"
    },
    {
      "Id": 160140510,
      "Speaker": "Student",
      "Text": "선생님을 초대하기로 했어!"
    },
    {
      "Id": 160140520,
      "Speaker": "Player",
      "Text": "초대?"
    },
    {
      "Id": 160140530,
      "Speaker": "Student",
      "Text": "응!"
    },
    {
      "Id": 160140540,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "선생님, 지금 만마전 휴게실로 와 줘!"
    }
  ],
  "DialogEN": [
    {
      "Id": 160140010,
      "Speaker": "Student",
      "Text": "SensEi"
    },
    {
      "Id": 160140020,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 160140030,
      "Speaker": "Student",
      "Text": "HelLO"
    },
    {
      "Id": 160140040,
      "Speaker": "Student",
      "Text": "It's Ibuki!!"
    },
    {
      "Id": 160140050,
      "Speaker": "Player",
      "Text": "Hi, Ibuki. How are you?"
    },
    {
      "Id": 160140060,
      "Speaker": "Student",
      "Text": "Ibuki is doing gREat!"
    },
    {
      "Id": 160140070,
      "Speaker": "Student",
      "Text": "How are you, Sensei?"
    },
    {
      "Id": 160140080,
      "Speaker": "Player",
      "Text": "I'm feeling great, too."
    },
    {
      "Id": 160140090,
      "Speaker": "Student",
      "Text": "That's great!"
    },
    {
      "Id": 160140100,
      "Speaker": "Student",
      "Text": "Can Ibuki come over?"
    },
    {
      "Id": 160140110,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "Of course."
    },
    {
      "Id": 160140120,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "My students are always welcome, Ibuki."
    },
    {
      "Id": 160140130,
      "Speaker": "Student",
      "Text": "SenseiSensei"
    },
    {
      "Id": 160140140,
      "Speaker": "Student",
      "Text": "It's Ibukii"
    },
    {
      "Id": 160140150,
      "Speaker": "Student",
      "Text": "It's Ibuki!"
    },
    {
      "Id": 160140160,
      "Speaker": "Student",
      "Text": "Can Ibuki come hang out at Schale?"
    },
    {
      "Id": 160140170,
      "Speaker": "Student",
      "Text": "Ibuki isn't the Student Rep today, but Ibuki wants to play games again!"
    },
    {
      "Id": 160140180,
      "Speaker": "Player",
      "Text": "Sure. I'll be waiting."
    },
    {
      "Id": 160140190,
      "Speaker": "Player",
      "Text": "No running in the halls to get here, okay?"
    },
    {
      "Id": 160140200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Yup! Thanks! See you soon, SenSei!"
    },
    {
      "Id": 160140210,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 160140220,
      "Speaker": "Student",
      "Text": "Today was so fun!"
    },
    {
      "Id": 160140230,
      "Speaker": "Student",
      "Text": "Ibuki got to play tag and hIDe and seek with Sensei at Schale Park..."
    },
    {
      "Id": 160140240,
      "Speaker": "Player",
      "Text": "Aren't you tired from all that running, Ibuki?"
    },
    {
      "Id": 160140250,
      "Speaker": "Student",
      "Text": "Nope, not a bit!"
    },
    {
      "Id": 160140260,
      "Speaker": "Student",
      "Text": "Why? Are you, Sensei?"
    },
    {
      "Id": 160140270,
      "Speaker": "Player",
      "Text": "O-Of course not."
    },
    {
      "Id": 160140280,
      "Speaker": "Student",
      "Text": "Then Ibuki can't wait to play at Schale Park again!"
    },
    {
      "Id": 160140290,
      "Speaker": "Student",
      "Text": "Let's play again soon, Sensei!"
    },
    {
      "Id": 160140300,
      "Speaker": "Student",
      "Text": "SensEi"
    },
    {
      "Id": 160140310,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 160140320,
      "Speaker": "Student",
      "Text": "Ibuki is curious!"
    },
    {
      "Id": 160140330,
      "Speaker": "Player",
      "Text": "What is it, Ibuki?"
    },
    {
      "Id": 160140340,
      "Speaker": "Student",
      "Text": "You're always working whenever Ibuki visits Schale, right?"
    },
    {
      "Id": 160140350,
      "Speaker": "Student",
      "Text": "Is work really that much fun?"
    },
    {
      "Id": 160140360,
      "Speaker": "Player",
      "Text": "I-I suppose it looks that way..."
    },
    {
      "Id": 160140370,
      "Speaker": "Player",
      "Text": "It's...fun... Most days..."
    },
    {
      "Id": 160140380,
      "Speaker": "Player",
      "Text": "But what about my work made you so curious?"
    },
    {
      "Id": 160140390,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 160140400,
      "Speaker": "Student",
      "Text": "Ibuki isn't great at typing,"
    },
    {
      "Id": 160140410,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "so Ibuki will tell you in person!"
    },
    {
      "Id": 160140420,
      "Speaker": "Student",
      "Text": "Sensei!!"
    },
    {
      "Id": 160140430,
      "Speaker": "Student",
      "Text": "Are you busy right now?"
    },
    {
      "Id": 160140440,
      "Speaker": "Player",
      "Text": "No, not at the moment."
    },
    {
      "Id": 160140450,
      "Speaker": "Player",
      "Text": "My schedule just opened up."
    },
    {
      "Id": 160140460,
      "Speaker": "Student",
      "Text": "That's great!"
    },
    {
      "Id": 160140470,
      "Speaker": "Student",
      "Text": "Ibuki can't stop thinking about all the jobs we tried, Sensei."
    },
    {
      "Id": 160140480,
      "Speaker": "Student",
      "Text": "What Ibuki wants to do..."
    },
    {
      "Id": 160140490,
      "Speaker": "Student",
      "Text": "What Ibuki likes the most..."
    },
    {
      "Id": 160140500,
      "Speaker": "Student",
      "Text": "So,"
    },
    {
      "Id": 160140510,
      "Speaker": "Student",
      "Text": "Ibuki decided to give you an invitation!"
    },
    {
      "Id": 160140520,
      "Speaker": "Player",
      "Text": "Invitation?"
    },
    {
      "Id": 160140530,
      "Speaker": "Student",
      "Text": "Yup!"
    },
    {
      "Id": 160140540,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Come to the Pandemonium Society break room right now!"
    }
  ],
