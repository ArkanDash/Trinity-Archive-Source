{
  "CharacterId": 13013,
  "DialogJP": [
    {
      "Id": 130130010,
      "Speaker": "Student",
      "Text": "あの……先生"
    },
    {
      "Id": 130130020,
      "Speaker": "Student",
      "Text": "今、お時間大丈夫ですか？"
    },
    {
      "Id": 130130030,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 130130040,
      "Speaker": "Student",
      "Text": "良かったです……"
    },
    {
      "Id": 130130050,
      "Speaker": "Student",
      "Text": "実は、先生にお願いがあるんですが……"
    },
    {
      "Id": 130130060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "分かった、すぐ向かうね"
    },
    {
      "Id": 130130070,
      "Speaker": "Student",
      "Text": "無事に帰れましたか？"
    },
    {
      "Id": 130130080,
      "Speaker": "Student",
      "Text": "すみません、私のせいで遅くまで迷惑を……"
    },
    {
      "Id": 130130090,
      "Speaker": "Player",
      "Text": "迷惑だなんて、私も楽しかったよ"
    },
    {
      "Id": 130130100,
      "Speaker": "Player",
      "Text": "同人誌、ちゃんと保管しないとね"
    },
    {
      "Id": 130130110,
      "Speaker": "Student",
      "Text": "はい！"
    },
    {
      "Id": 130130120,
      "Speaker": "Student",
      "Text": "先生は"
    },
    {
      "Id": 130130130,
      "Speaker": "Student",
      "Text": "何かをコレクションしたりしていますか？"
    },
    {
      "Id": 130130140,
      "Speaker": "Player",
      "Text": "疲労のレパートリーならコレクションされてるよ……"
    },
    {
      "Id": 130130150,
      "Speaker": "Student",
      "Text": "そ、それは"
    },
    {
      "Id": 130130160,
      "Speaker": "Student",
      "Text": "大変ですね……"
    },
    {
      "Id": 130130170,
      "Speaker": "Player",
      "Text": "モミジはどう？"
    },
    {
      "Id": 130130180,
      "Speaker": "Player",
      "Text": "何か集めてる？"
    },
    {
      "Id": 130130190,
      "Speaker": "Student",
      "Text": "えへへ……"
    },
    {
      "Id": 130130200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "私は、とある作家さんの絶版本を集めてるんです"
    },
    {
      "Id": 130130210,
      "Speaker": "Student",
      "Text": "先生……"
    },
    {
      "Id": 130130220,
      "Speaker": "Student",
      "Text": "先生……！"
    },
    {
      "Id": 130130230,
      "Speaker": "Student",
      "Text": "いよいよ……開催です……！"
    },
    {
      "Id": 130130240,
      "Speaker": "Player",
      "Text": "な、何が？"
    },
    {
      "Id": 130130250,
      "Speaker": "Player",
      "Text": "楽しそうだね、モミジ"
    },
    {
      "Id": 130130260,
      "Speaker": "Student",
      "Text": "わわっ、すみません……"
    },
    {
      "Id": 130130270,
      "Speaker": "Student",
      "Text": "思わず、浮かれてしまいました……"
    },
    {
      "Id": 130130280,
      "Speaker": "Player",
      "Text": "聞かせてもらえる？"
    },
    {
      "Id": 130130290,
      "Speaker": "Student",
      "Text": "今日は……"
    },
    {
      "Id": 130130300,
      "Speaker": "Student",
      "Text": "レッドウィンターブックフェスティバルの日です！"
    },
    {
      "Id": 130130310,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "うん……？"
    },
    {
      "Id": 130130320,
      "Speaker": "Student",
      "Text": "先生、今日はお付き合いいただきありがとうございました！"
    },
    {
      "Id": 130130330,
      "Speaker": "Student",
      "Text": "たくさん歩き回りましたが……疲れてませんか？"
    },
    {
      "Id": 130130340,
      "Speaker": "Player",
      "Text": "これくらい大丈夫だよ！"
    },
    {
      "Id": 130130350,
      "Speaker": "Student",
      "Text": "良かったです"
    },
    {
      "Id": 130130360,
      "Speaker": "Student",
      "Text": "明日も楽しみですね！"
    },
    {
      "Id": 130130370,
      "Speaker": "Player",
      "Text": "あ、明日も！？"
    },
    {
      "Id": 130130380,
      "Speaker": "Student",
      "Text": "ブックフェスティバルは2日間ありますから！"
    },
    {
      "Id": 130130390,
      "Speaker": "Student",
      "Text": "明日で残りのコーナーを完全制覇したいと思います！"
    },
    {
      "Id": 130130400,
      "Speaker": "Player",
      "Text": "が、頑張るね……"
    },
    {
      "Id": 130130410,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 130130420,
      "Speaker": "Student",
      "Text": "えへへ、楽しみにしてますね"
    },
    {
      "Id": 130130430,
      "Speaker": "Student",
      "Text": "おやすみなさい！"
    },
    {
      "Id": 130130440,
      "Speaker": "Student",
      "Text": "おはようございます、先生"
    },
    {
      "Id": 130130450,
      "Speaker": "Player",
      "Text": "おはよう、モミジ……"
    },
    {
      "Id": 130130460,
      "Speaker": "Student",
      "Text": "あれ？"
    },
    {
      "Id": 130130470,
      "Speaker": "Student",
      "Text": "どうしたんですか？"
    },
    {
      "Id": 130130480,
      "Speaker": "Player",
      "Text": "実は……"
    },
    {
      "Id": 130130490,
      "Speaker": "Player",
      "Text": "2日連続の徹夜で頭がぼーっとして……"
    },
    {
      "Id": 130130500,
      "Speaker": "Student",
      "Text": "そんな！大変です！"
    },
    {
      "Id": 130130510,
      "Speaker": "Student",
      "Text": "私も本を読んでいると気づいたら朝になっている日もありますが……"
    },
    {
      "Id": 130130520,
      "Speaker": "Student",
      "Text": "あの、先生"
    },
    {
      "Id": 130130530,
      "Speaker": "Student",
      "Text": "もしよろしければ……レッドウィンターの図書館に来ていただけませんか？"
    },
    {
      "Id": 130130540,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "図書館に……？"
    },
    {
      "Id": 130130550,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 130130560,
      "Speaker": "Student",
      "Text": "ごめんなさい"
    },
    {
      "Id": 130130570,
      "Speaker": "Student",
      "Text": "今日はお会いできません"
    },
    {
      "Id": 130130580,
      "Speaker": "Player",
      "Text": "ど、どうしたの！？"
    },
    {
      "Id": 130130590,
      "Speaker": "Student",
      "Text": "図書館で大切な……"
    },
    {
      "Id": 130130600,
      "Speaker": "Student",
      "Text": "いやちょっとした……"
    },
    {
      "Id": 130130610,
      "Speaker": "Student",
      "Text": "落とし物を……"
    },
    {
      "Id": 130130620,
      "Speaker": "Student",
      "Text": "……探さないと"
    },
    {
      "Id": 130130630,
      "Speaker": "Player",
      "Text": "私も手伝うよ"
    },
    {
      "Id": 130130640,
      "Speaker": "Student",
      "Text": "えっ？"
    },
    {
      "Id": 130130650,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "先生が、ですか？"
    }
  ],
  "DialogKR": [
    {
      "Id": 130130010,
      "Speaker": "Student",
      "Text": "저…… 선생님?"
    },
    {
      "Id": 130130020,
      "Speaker": "Student",
      "Text": "지금, 시간 괜찮으신가요?"
    },
    {
      "Id": 130130030,
      "Speaker": "Player",
      "Text": "안녕. 모미지. 물론 괜찮아."
    },
    {
      "Id": 130130040,
      "Speaker": "Student",
      "Text": "다행이에요……"
    },
    {
      "Id": 130130050,
      "Speaker": "Student",
      "Text": "실례일지도 모르지만, 선생님께 부탁드리고 싶은 것이 있어서……"
    },
    {
      "Id": 130130060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "그래. 알았어."
    },
    {
      "Id": 130130070,
      "Speaker": "Student",
      "Text": "잘 들어가셨나요. 선생님?"
    },
    {
      "Id": 130130080,
      "Speaker": "Student",
      "Text": "괜히 저 때문에 고생만 하시고……"
    },
    {
      "Id": 130130090,
      "Speaker": "Player",
      "Text": "고생이라니, 무슨."
    },
    {
      "Id": 130130100,
      "Speaker": "Player",
      "Text": "회지, 잘 보관해야겠네."
    },
    {
      "Id": 130130110,
      "Speaker": "Student",
      "Text": "물론이죠!"
    },
    {
      "Id": 130130120,
      "Speaker": "Student",
      "Text": "선생님께서는"
    },
    {
      "Id": 130130130,
      "Speaker": "Student",
      "Text": "무언가를 콜렉팅 해 본 적 있으세요?"
    },
    {
      "Id": 130130140,
      "Speaker": "Player",
      "Text": "피로라면 열심히 콜렉팅하고 있어……"
    },
    {
      "Id": 130130150,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 130130160,
      "Speaker": "Student",
      "Text": "그, 그건 큰일이네요."
    },
    {
      "Id": 130130170,
      "Speaker": "Player",
      "Text": "그런 걸 묻는 걸 보니"
    },
    {
      "Id": 130130180,
      "Speaker": "Player",
      "Text": "모미지는 뭔가 모으는 게 있나 봐?"
    },
    {
      "Id": 130130190,
      "Speaker": "Student",
      "Text": "저는……"
    },
    {
      "Id": 130130200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "에헤헤. 개인적으로 콜렉팅하는 판본이 있어요."
    },
    {
      "Id": 130130210,
      "Speaker": "Student",
      "Text": "선생님……"
    },
    {
      "Id": 130130220,
      "Speaker": "Student",
      "Text": "선생님……!"
    },
    {
      "Id": 130130230,
      "Speaker": "Student",
      "Text": "드디어…… 열려요."
    },
    {
      "Id": 130130240,
      "Speaker": "Player",
      "Text": "뭐, 뭐가?"
    },
    {
      "Id": 130130250,
      "Speaker": "Player",
      "Text": "모미지가 이렇게까지 흥분하다니, 드문 일이네."
    },
    {
      "Id": 130130260,
      "Speaker": "Student",
      "Text": "아, 아앗. 죄송해요……"
    },
    {
      "Id": 130130270,
      "Speaker": "Student",
      "Text": "너무 기대된 나머지, 그만……"
    },
    {
      "Id": 130130280,
      "Speaker": "Player",
      "Text": "진정하고, 차근차근 이야기해 줘."
    },
    {
      "Id": 130130290,
      "Speaker": "Student",
      "Text": "네……"
    },
    {
      "Id": 130130300,
      "Speaker": "Student",
      "Text": "그러니까, 붉은겨울 책 축제예요!"
    },
    {
      "Id": 130130310,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "응……?"
    },
    {
      "Id": 130130320,
      "Speaker": "Student",
      "Text": "선생님. 잘 들어가셨나요?"
    },
    {
      "Id": 130130330,
      "Speaker": "Student",
      "Text": "너무 피곤하다거나 하지는…… 않으시고요?"
    },
    {
      "Id": 130130340,
      "Speaker": "Player",
      "Text": "이 정도는 괜찮아."
    },
    {
      "Id": 130130350,
      "Speaker": "Student",
      "Text": "다행이에요."
    },
    {
      "Id": 130130360,
      "Speaker": "Student",
      "Text": "그러면 내일도 함께 해 주신다는 거죠?"
    },
    {
      "Id": 130130370,
      "Speaker": "Player",
      "Text": "내, 내일도?!"
    },
    {
      "Id": 130130380,
      "Speaker": "Student",
      "Text": "네. 붉은겨울 책 축제는 내일까지니까요!"
    },
    {
      "Id": 130130390,
      "Speaker": "Student",
      "Text": "내일은 오늘 다 못 돌아본 코너를 완전히 정복할 거예요!"
    },
    {
      "Id": 130130400,
      "Speaker": "Player",
      "Text": "선생님, 힘낼게……"
    },
    {
      "Id": 130130410,
      "Speaker": "Student",
      "Text": "와아, 감사합니다!"
    },
    {
      "Id": 130130420,
      "Speaker": "Student",
      "Text": "저, 내일이 정말 기대돼요."
    },
    {
      "Id": 130130430,
      "Speaker": "Student",
      "Text": "그러면 오늘은 안녕히 주무세요!"
    },
    {
      "Id": 130130440,
      "Speaker": "Student",
      "Text": "안녕하세요. 선생님."
    },
    {
      "Id": 130130450,
      "Speaker": "Player",
      "Text": "안녀엉…… 모미지……"
    },
    {
      "Id": 130130460,
      "Speaker": "Student",
      "Text": "어라?"
    },
    {
      "Id": 130130470,
      "Speaker": "Student",
      "Text": "무슨 일이라도 있으세요?"
    },
    {
      "Id": 130130480,
      "Speaker": "Player",
      "Text": "별 건 아니고……"
    },
    {
      "Id": 130130490,
      "Speaker": "Player",
      "Text": "그냥, 이틀째 철야를 했더니 정신이 없네……"
    },
    {
      "Id": 130130500,
      "Speaker": "Student",
      "Text": "세상에, 그거 정말 큰 일이잖아요!"
    },
    {
      "Id": 130130510,
      "Speaker": "Student",
      "Text": "물론 저도 만화를 읽다가 밤을 새우는 적도 가끔씩 있지만……"
    },
    {
      "Id": 130130520,
      "Speaker": "Student",
      "Text": "저, 선생님."
    },
    {
      "Id": 130130530,
      "Speaker": "Student",
      "Text": "괜찮으시다면…… 붉은겨울 도서관에, 한 번 들러 주실 수 있으세요?"
    },
    {
      "Id": 130130540,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "도서관에……?"
    },
    {
      "Id": 130130550,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 130130560,
      "Speaker": "Student",
      "Text": "죄송한데요"
    },
    {
      "Id": 130130570,
      "Speaker": "Student",
      "Text": "오늘 찾아뵙기로 한 약속, 못 지킬 것 같아요"
    },
    {
      "Id": 130130580,
      "Speaker": "Player",
      "Text": "갑자기 왜?"
    },
    {
      "Id": 130130590,
      "Speaker": "Student",
      "Text": "도서관에서 중요한"
    },
    {
      "Id": 130130600,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 130130610,
      "Speaker": "Student",
      "Text": "사소한 걸 잃어버려서"
    },
    {
      "Id": 130130620,
      "Speaker": "Student",
      "Text": "그걸 우선 찾아야 할 것 같아요"
    },
    {
      "Id": 130130630,
      "Speaker": "Player",
      "Text": "그러면 나도 도와줄게"
    },
    {
      "Id": 130130640,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 130130650,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "선생님이 직접요?"
    }
  ],
  "DialogEN": [
    {
      "Id": 130130010,
      "Speaker": "Student",
      "Text": "Umm...Sensei?"
    },
    {
      "Id": 130130020,
      "Speaker": "Student",
      "Text": "Can I borrow you for a little while?"
    },
    {
      "Id": 130130030,
      "Speaker": "Player",
      "Text": "Hi, Momiji. Of course you can."
    },
    {
      "Id": 130130040,
      "Speaker": "Student",
      "Text": "Good..."
    },
    {
      "Id": 130130050,
      "Speaker": "Student",
      "Text": "If you don't mind, I'd like to ask you a favor..."
    },
    {
      "Id": 130130060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "Sure."
    },
    {
      "Id": 130130070,
      "Speaker": "Student",
      "Text": "Did you make it home safely, Sensei?"
    },
    {
      "Id": 130130080,
      "Speaker": "Student",
      "Text": "I put you through so much..."
    },
    {
      "Id": 130130090,
      "Speaker": "Player",
      "Text": "Oh, it was nothing."
    },
    {
      "Id": 130130100,
      "Speaker": "Player",
      "Text": "You'd better find a safe place to keep that fanzine."
    },
    {
      "Id": 130130110,
      "Speaker": "Student",
      "Text": "Of course!"
    },
    {
      "Id": 130130120,
      "Speaker": "Student",
      "Text": "Sensei,"
    },
    {
      "Id": 130130130,
      "Speaker": "Student",
      "Text": "do you collect anything?"
    },
    {
      "Id": 130130140,
      "Speaker": "Player",
      "Text": "I've collected a lot of fatigue..."
    },
    {
      "Id": 130130150,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 130130160,
      "Speaker": "Student",
      "Text": "That's not good!"
    },
    {
      "Id": 130130170,
      "Speaker": "Player",
      "Text": "What about you?"
    },
    {
      "Id": 130130180,
      "Speaker": "Player",
      "Text": "Do you collect something?"
    },
    {
      "Id": 130130190,
      "Speaker": "Student",
      "Text": "I..."
    },
    {
      "Id": 130130200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Heehee. I collect books."
    },
    {
      "Id": 130130210,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 130130220,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 130130230,
      "Speaker": "Student",
      "Text": "It's starting! finally!"
    },
    {
      "Id": 130130240,
      "Speaker": "Player",
      "Text": "What's that?"
    },
    {
      "Id": 130130250,
      "Speaker": "Player",
      "Text": "Momiji, you seem extra excited!"
    },
    {
      "Id": 130130260,
      "Speaker": "Student",
      "Text": "Ah, yes, that's because!"
    },
    {
      "Id": 130130270,
      "Speaker": "Student",
      "Text": "Sorry, I got ahead of myself and"
    },
    {
      "Id": 130130280,
      "Speaker": "Player",
      "Text": "Calm down and type it out slowly."
    },
    {
      "Id": 130130290,
      "Speaker": "Student",
      "Text": "Right..."
    },
    {
      "Id": 130130300,
      "Speaker": "Student",
      "Text": "It's the Red Winter Book Festival!"
    },
    {
      "Id": 130130310,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "Hm?"
    },
    {
      "Id": 130130320,
      "Speaker": "Student",
      "Text": "Sensei, did you make it home safely?"
    },
    {
      "Id": 130130330,
      "Speaker": "Student",
      "Text": "You're not too tired, are you?"
    },
    {
      "Id": 130130340,
      "Speaker": "Player",
      "Text": "I'm fine."
    },
    {
      "Id": 130130350,
      "Speaker": "Student",
      "Text": "What a relief!"
    },
    {
      "Id": 130130360,
      "Speaker": "Student",
      "Text": "You'll help out tomorrow too, right?"
    },
    {
      "Id": 130130370,
      "Speaker": "Player",
      "Text": "T-Tomorrow?!"
    },
    {
      "Id": 130130380,
      "Speaker": "Student",
      "Text": "Yes! The Red Winter Book Festival continues until tomorrow!"
    },
    {
      "Id": 130130390,
      "Speaker": "Student",
      "Text": "And there are so many sections I still need to see!"
    },
    {
      "Id": 130130400,
      "Speaker": "Player",
      "Text": "I'll be there..."
    },
    {
      "Id": 130130410,
      "Speaker": "Student",
      "Text": "Yay! Thank you!"
    },
    {
      "Id": 130130420,
      "Speaker": "Student",
      "Text": "I can't wait!"
    },
    {
      "Id": 130130430,
      "Speaker": "Student",
      "Text": "Sleep tight!"
    },
    {
      "Id": 130130440,
      "Speaker": "Student",
      "Text": "Hello, Sensei."
    },
    {
      "Id": 130130450,
      "Speaker": "Player",
      "Text": "Hello........"
    },
    {
      "Id": 130130460,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 130130470,
      "Speaker": "Student",
      "Text": "Is something wrong?"
    },
    {
      "Id": 130130480,
      "Speaker": "Player",
      "Text": "It's nothing..."
    },
    {
      "Id": 130130490,
      "Speaker": "Player",
      "Text": "Just feeling tired after staying up two nights in a row..."
    },
    {
      "Id": 130130500,
      "Speaker": "Student",
      "Text": "Oh no, that is something!"
    },
    {
      "Id": 130130510,
      "Speaker": "Student",
      "Text": "I mean, I've stayed up a few nights reading manga, but..."
    },
    {
      "Id": 130130520,
      "Speaker": "Student",
      "Text": "Uh, Sensei?"
    },
    {
      "Id": 130130530,
      "Speaker": "Student",
      "Text": "If you feel up to it...could you stop by the Red Winter Library?"
    },
    {
      "Id": 130130540,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "The library...?"
    },
    {
      "Id": 130130550,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 130130560,
      "Speaker": "Student",
      "Text": "I'm sorry."
    },
    {
      "Id": 130130570,
      "Speaker": "Student",
      "Text": "Can't meet up today anymore"
    },
    {
      "Id": 130130580,
      "Speaker": "Player",
      "Text": "Why?"
    },
    {
      "Id": 130130590,
      "Speaker": "Student",
      "Text": "I lost something important"
    },
    {
      "Id": 130130600,
      "Speaker": "Student",
      "Text": "no"
    },
    {
      "Id": 130130610,
      "Speaker": "Student",
      "Text": "something trivial in the library."
    },
    {
      "Id": 130130620,
      "Speaker": "Student",
      "Text": "So I need to find that first."
    },
    {
      "Id": 130130630,
      "Speaker": "Player",
      "Text": "I'll help you then."
    },
    {
      "Id": 130130640,
      "Speaker": "Student",
      "Text": "Pardon?"
    },
    {
      "Id": 130130650,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "You will?"
    }
  ],
  "DialogTH": [
    {
      "Id": 130130010,
      "Speaker": "Student",
      "Text": "เอ่อ... คุณครูคะ?"
    },
    {
      "Id": 130130020,
      "Speaker": "Student",
      "Text": "ตอนนี้... พอมีเวลาสักครู่รึเปล่าคะ?"
    },
    {
      "Id": 130130030,
      "Speaker": "Player",
      "Text": "ว่าไง โมมิจิ\nตอนนี้ครูว่างพอดีเลย"
    },
    {
      "Id": 130130040,
      "Speaker": "Student",
      "Text": "งั้นก็โล่งอกไปทีค่ะ..."
    },
    {
      "Id": 130130050,
      "Speaker": "Student",
      "Text": "อาจเป็นเรื่องที่เสียมารยาทไปสัก\nหน่อย แต่ว่าฉันมีเรื่องที่อยากขอร้อง\nคุณครู..."
    },
    {
      "Id": 130130060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "งั้นเหรอ ได้อยู่แล้ว"
    },
    {
      "Id": 130130070,
      "Speaker": "Student",
      "Text": "กลับถึงที่พักอย่างปลอดภัย\nใช่มั้ยคะ คุณครู?"
    },
    {
      "Id": 130130080,
      "Speaker": "Student",
      "Text": "คุณครูต้องมาลำบากเพราะฉันเลย..."
    },
    {
      "Id": 130130090,
      "Speaker": "Player",
      "Text": "ลำบากอะไรกัน"
    },
    {
      "Id": 130130100,
      "Speaker": "Player",
      "Text": "โดจินชิเล่มนั้นน่ะ\nคงจะเก็บไว้อย่างดีเลยสินะ"
    },
    {
      "Id": 130130110,
      "Speaker": "Student",
      "Text": "แน่นอนค่ะ!"
    },
    {
      "Id": 130130120,
      "Speaker": "Student",
      "Text": "คุณครู..."
    },
    {
      "Id": 130130130,
      "Speaker": "Student",
      "Text": "เคยสะสมอะไรบ้างหรือเปล่าคะ?"
    },
    {
      "Id": 130130140,
      "Speaker": "Player",
      "Text": "ครูสะสมความเหนื่อยล้า\nไว้เพียบเลย..."
    },
    {
      "Id": 130130150,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 130130160,
      "Speaker": "Student",
      "Text": "บะ...แบบนั้นไม่ใช่เรื่องดีเลยนะคะ!"
    },
    {
      "Id": 130130170,
      "Speaker": "Player",
      "Text": "โมมิจิถามทำไมเหรอ?"
    },
    {
      "Id": 130130180,
      "Speaker": "Player",
      "Text": "โมมิจิก็คงสะสมอะไรเหมือนกันสินะ?"
    },
    {
      "Id": 130130190,
      "Speaker": "Student",
      "Text": "ฉัน..."
    },
    {
      "Id": 130130200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ฮิฮิ... ฉันสะสมหนังสือแบบรูปเล่ม\nอยู่น่ะค่ะ"
    },
    {
      "Id": 130130210,
      "Speaker": "Student",
      "Text": "คุณครู..."
    },
    {
      "Id": 130130220,
      "Speaker": "Student",
      "Text": "คุณครูคะ...!"
    },
    {
      "Id": 130130230,
      "Speaker": "Student",
      "Text": "ในที่สุด...ก็เริ่มแล้วค่ะ"
    },
    {
      "Id": 130130240,
      "Speaker": "Player",
      "Text": "อะ...อะไรเหรอ?"
    },
    {
      "Id": 130130250,
      "Speaker": "Player",
      "Text": "ไม่ค่อยได้เห็นโมมิจิ\nตื่นเต้นขนาดนี้เลยนะเนี่ย"
    },
    {
      "Id": 130130260,
      "Speaker": "Student",
      "Text": "อ่า...อ๊ะ ขอโทษด้วยค่ะ"
    },
    {
      "Id": 130130270,
      "Speaker": "Student",
      "Text": "คือฉันรอมันมานานมากๆ ก็เลย..."
    },
    {
      "Id": 130130280,
      "Speaker": "Player",
      "Text": "ใจเย็นๆ ค่อยๆ เล่านะ"
    },
    {
      "Id": 130130290,
      "Speaker": "Student",
      "Text": "ค่ะ..."
    },
    {
      "Id": 130130300,
      "Speaker": "Student",
      "Text": "คือ... งานเทศกาลหนังสือ\nเรดวินเทอร์ค่ะ!"
    },
    {
      "Id": 130130310,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "หืม...?"
    },
    {
      "Id": 130130320,
      "Speaker": "Student",
      "Text": "คุณครู... กลับถึงที่พัก\nอย่างปลอดภัยใช่มั้ยคะ?"
    },
    {
      "Id": 130130330,
      "Speaker": "Student",
      "Text": "ไม่ได้เหนื่อยหรือรู้สึกเมื่อยตัว...\nใช่มั้ยคะ?"
    },
    {
      "Id": 130130340,
      "Speaker": "Player",
      "Text": "แค่นี้สบายมาก"
    },
    {
      "Id": 130130350,
      "Speaker": "Student",
      "Text": "โล่งอกไปทีค่ะ..."
    },
    {
      "Id": 130130360,
      "Speaker": "Student",
      "Text": "ถ้างั้นพรุ่งนี้ก็มาด้วยกันอีกใช่มั้ยคะ?"
    },
    {
      "Id": 130130370,
      "Speaker": "Player",
      "Text": "พะ...พรุ่งนี้ด้วยเรอะ?!"
    },
    {
      "Id": 130130380,
      "Speaker": "Student",
      "Text": "ค่ะ งานเทศกาลหนังสือเรดวินเทอร์\nจัดถึงวันพรุ่งนี้ค่ะ!"
    },
    {
      "Id": 130130390,
      "Speaker": "Student",
      "Text": "พรุ่งนี้เราจะต้องพิชิตบูทหนังสือ\nที่ยังไม่ได้ไปวันนี้ให้ครบค่ะ!"
    },
    {
      "Id": 130130400,
      "Speaker": "Player",
      "Text": "ครูจะสู้นะ..."
    },
    {
      "Id": 130130410,
      "Speaker": "Student",
      "Text": "ว้าว... ขอบคุณค่ะ!"
    },
    {
      "Id": 130130420,
      "Speaker": "Student",
      "Text": "ฉันอยากให้ถึงวันพรุ่งนี้แล้วละค่ะ"
    },
    {
      "Id": 130130430,
      "Speaker": "Student",
      "Text": "งั้นก็ราตรีสวัสดิ์นะคะ!"
    },
    {
      "Id": 130130440,
      "Speaker": "Student",
      "Text": "สวัสดีค่ะ คุณครู"
    },
    {
      "Id": 130130450,
      "Speaker": "Player",
      "Text": "ว่าไง... โมมิจิ..."
    },
    {
      "Id": 130130460,
      "Speaker": "Student",
      "Text": "เอ๋?"
    },
    {
      "Id": 130130470,
      "Speaker": "Student",
      "Text": "มีอะไรรึเปล่าคะคุณครู?"
    },
    {
      "Id": 130130480,
      "Speaker": "Player",
      "Text": "เปล่าหรอก..."
    },
    {
      "Id": 130130490,
      "Speaker": "Player",
      "Text": "ก็แค่... ครูโต้รุ่งมาสองวันแล้ว\nเลยไม่ค่อยมีสติแล้วน่ะ..."
    },
    {
      "Id": 130130500,
      "Speaker": "Student",
      "Text": "แย่เลย... แบบนี้เรื่องใหญ่เลยนะคะ!"
    },
    {
      "Id": 130130510,
      "Speaker": "Student",
      "Text": "ถึงบางทีฉันจะนอนอ่านมังงะโต้รุ่ง\nบ้างก็เถอะ..."
    },
    {
      "Id": 130130520,
      "Speaker": "Student",
      "Text": "คือ... คุณครูคะ"
    },
    {
      "Id": 130130530,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูสะดวก... แวะมาที่ห้องสมุด\nเรดวินเทอร์หน่อยได้หรือเปล่าคะ?"
    },
    {
      "Id": 130130540,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "ห้องสมุดเหรอ?"
    },
    {
      "Id": 130130550,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 130130560,
      "Speaker": "Student",
      "Text": "ขอโทษนะคะ"
    },
    {
      "Id": 130130570,
      "Speaker": "Student",
      "Text": "ฉันคงทำตามสัญญาที่บอกว่าจะไปหา\nคุณครูไม่ได้แล้วค่ะ"
    },
    {
      "Id": 130130580,
      "Speaker": "Player",
      "Text": "อ้าว ทำไมล่ะ?"
    },
    {
      "Id": 130130590,
      "Speaker": "Student",
      "Text": "สิ่งสำคัญในห้องสมุด"
    },
    {
      "Id": 130130600,
      "Speaker": "Student",
      "Text": "ไม่สิ"
    },
    {
      "Id": 130130610,
      "Speaker": "Student",
      "Text": "มีของเล็กๆ น้อยๆ หายไป..."
    },
    {
      "Id": 130130620,
      "Speaker": "Student",
      "Text": "และฉันน่าจะต้องไปตามหามันก่อนค่ะ"
    },
    {
      "Id": 130130630,
      "Speaker": "Player",
      "Text": "งั้นเดี๋ยวครูช่วยนะ"
    },
    {
      "Id": 130130640,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 130130650,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "คุณครูจะมาด้วยตัวเองเลยเหรอคะ?"
    }
  ],
  "DialogTW": [
    {
      "Id": 130130010,
      "Speaker": "Student",
      "Text": "那個……老師？"
    },
    {
      "Id": 130130020,
      "Speaker": "Student",
      "Text": "請問，現在有空嗎？"
    },
    {
      "Id": 130130030,
      "Speaker": "Player",
      "Text": "嗨，紅葉，當然有空"
    },
    {
      "Id": 130130040,
      "Speaker": "Student",
      "Text": "太好了……"
    },
    {
      "Id": 130130050,
      "Speaker": "Student",
      "Text": "不好意思，其實我有事想拜託老師……"
    },
    {
      "Id": 130130060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "嗯，我馬上過去"
    },
    {
      "Id": 130130070,
      "Speaker": "Student",
      "Text": "平安回去了嗎，老師？"
    },
    {
      "Id": 130130080,
      "Speaker": "Student",
      "Text": "不好意思，害你忙到這麼晚……"
    },
    {
      "Id": 130130090,
      "Speaker": "Player",
      "Text": "別這麼說，我也很開心"
    },
    {
      "Id": 130130100,
      "Speaker": "Player",
      "Text": "同人誌，記得要好好保存哦"
    },
    {
      "Id": 130130110,
      "Speaker": "Student",
      "Text": "是！"
    },
    {
      "Id": 130130120,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 130130130,
      "Speaker": "Student",
      "Text": "你有收集過什麼東西嗎？"
    },
    {
      "Id": 130130140,
      "Speaker": "Player",
      "Text": "收集了很多疲勞……"
    },
    {
      "Id": 130130150,
      "Speaker": "Student",
      "Text": "咦？"
    },
    {
      "Id": 130130160,
      "Speaker": "Student",
      "Text": "那，那還真是辛苦呢"
    },
    {
      "Id": 130130170,
      "Speaker": "Player",
      "Text": "既然會這麼問"
    },
    {
      "Id": 130130180,
      "Speaker": "Player",
      "Text": "代表紅葉你有在收集東西吧？"
    },
    {
      "Id": 130130190,
      "Speaker": "Student",
      "Text": "我……"
    },
    {
      "Id": 130130200,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "耶嘿嘿，我在收集某位作家的絕版書"
    },
    {
      "Id": 130130210,
      "Speaker": "Student",
      "Text": "老師……"
    },
    {
      "Id": 130130220,
      "Speaker": "Student",
      "Text": "老師……！"
    },
    {
      "Id": 130130230,
      "Speaker": "Student",
      "Text": "終於……要舉辦了！"
    },
    {
      "Id": 130130240,
      "Speaker": "Player",
      "Text": "舉，舉辦什麼？"
    },
    {
      "Id": 130130250,
      "Speaker": "Player",
      "Text": "紅葉竟然這麼激動，真少見"
    },
    {
      "Id": 130130260,
      "Speaker": "Student",
      "Text": "哇，哇哇。不好意思……"
    },
    {
      "Id": 130130270,
      "Speaker": "Student",
      "Text": "因為太期待，不小心就……"
    },
    {
      "Id": 130130280,
      "Speaker": "Player",
      "Text": "冷靜下來慢慢說吧"
    },
    {
      "Id": 130130290,
      "Speaker": "Student",
      "Text": "嗯……"
    },
    {
      "Id": 130130300,
      "Speaker": "Student",
      "Text": "今天，是赤冬書展的日子！"
    },
    {
      "Id": 130130310,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "嗯……？"
    },
    {
      "Id": 130130320,
      "Speaker": "Student",
      "Text": "老師，平安到家了嗎？"
    },
    {
      "Id": 130130330,
      "Speaker": "Student",
      "Text": "今天走了不少路……會不會很累呢？"
    },
    {
      "Id": 130130340,
      "Speaker": "Player",
      "Text": "這點程度不算什麼！"
    },
    {
      "Id": 130130350,
      "Speaker": "Student",
      "Text": "太好了"
    },
    {
      "Id": 130130360,
      "Speaker": "Student",
      "Text": "明天也很令人期待呢！"
    },
    {
      "Id": 130130370,
      "Speaker": "Player",
      "Text": "明，明天也要！？"
    },
    {
      "Id": 130130380,
      "Speaker": "Student",
      "Text": "嗯，赤冬書展明天才結束！"
    },
    {
      "Id": 130130390,
      "Speaker": "Student",
      "Text": "我打算在明天把剩下的攤位完全征服！"
    },
    {
      "Id": 130130400,
      "Speaker": "Player",
      "Text": "老師我會加油的……"
    },
    {
      "Id": 130130410,
      "Speaker": "Student",
      "Text": "哇啊，謝謝老師！"
    },
    {
      "Id": 130130420,
      "Speaker": "Student",
      "Text": "我真的很期待"
    },
    {
      "Id": 130130430,
      "Speaker": "Student",
      "Text": "那麼，祝你有個好夢！"
    },
    {
      "Id": 130130440,
      "Speaker": "Student",
      "Text": "你好，老師"
    },
    {
      "Id": 130130450,
      "Speaker": "Player",
      "Text": "你好呀……紅葉……"
    },
    {
      "Id": 130130460,
      "Speaker": "Student",
      "Text": "咦？"
    },
    {
      "Id": 130130470,
      "Speaker": "Student",
      "Text": "發生什麼事了嗎？"
    },
    {
      "Id": 130130480,
