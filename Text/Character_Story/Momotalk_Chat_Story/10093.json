{
  "CharacterId": 10093,
  "DialogJP": [
    {
      "Id": 100930010,
      "Speaker": "Student",
      "Text": "はろはろ～"
    },
    {
      "Id": 100930020,
      "Speaker": "Student",
      "Text": "これ、先生のアカウントで合ってるよね？"
    },
    {
      "Id": 100930030,
      "Speaker": "Player",
      "Text": "はろはろ～"
    },
    {
      "Id": 100930040,
      "Speaker": "Student",
      "Text": "合ってた～！はろはろ～！"
    },
    {
      "Id": 100930050,
      "Speaker": "Student",
      "Text": "今日友達と話しててさー"
    },
    {
      "Id": 100930060,
      "Speaker": "Student",
      "Text": "「好きなもの」の話になったんだけど"
    },
    {
      "Id": 100930070,
      "Speaker": "Student",
      "Text": "やっぱあたし、おしゃべりが好きだな～って思って！"
    },
    {
      "Id": 100930080,
      "Speaker": "Student",
      "Text": "先生はどう？"
    },
    {
      "Id": 100930090,
      "Speaker": "Student",
      "Text": "おしゃべり好き？"
    },
    {
      "Id": 100930100,
      "Speaker": "Player",
      "Text": "好きだよ"
    },
    {
      "Id": 100930110,
      "Speaker": "Player",
      "Text": "私もキララと話すのは好きだよ"
    },
    {
      "Id": 100930120,
      "Speaker": "Student",
      "Text": "えっ、マジ～？"
    },
    {
      "Id": 100930130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "同じこと考えたんだ！ウケる！"
    },
    {
      "Id": 100930140,
      "Speaker": "Student",
      "Text": "はろはろ～"
    },
    {
      "Id": 100930150,
      "Speaker": "Student",
      "Text": "良いこと思いついたの、あたし天才！"
    },
    {
      "Id": 100930160,
      "Speaker": "Student",
      "Text": "先生、キラキラ部の顧問にならない？"
    },
    {
      "Id": 100930170,
      "Speaker": "Student",
      "Text": "あ、返事はいつでも良いから！好きな時に言ってね！"
    },
    {
      "Id": 100930180,
      "Speaker": "Student",
      "Text": "コンコン"
    },
    {
      "Id": 100930190,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100930200,
      "Speaker": "Student",
      "Text": "せんせえ！(´；ω；`)"
    },
    {
      "Id": 100930210,
      "Speaker": "Player",
      "Text": "キララ……だよね？"
    },
    {
      "Id": 100930220,
      "Speaker": "Student",
      "Text": "うえーん！"
    },
    {
      "Id": 100930230,
      "Speaker": "Student",
      "Text": "先生助けて！（＞＜）"
    },
    {
      "Id": 100930240,
      "Speaker": "Student",
      "Text": "テスト、赤点だった～(´；ω；`)"
    },
    {
      "Id": 100930250,
      "Speaker": "Student",
      "Text": "シャーレで勉強教えて～(´；ω；`)"
    },
    {
      "Id": 100930260,
      "Speaker": "Student",
      "Text": "あ、今は忙しい？"
    },
    {
      "Id": 100930270,
      "Speaker": "Player",
      "Text": "ううん、大丈夫だよ。待ってるね"
    },
    {
      "Id": 100930280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "さすが先生(＞＜)マジ感謝！"
    },
    {
      "Id": 100930290,
      "Speaker": "Student",
      "Text": "先生、マジでありがと(´；ω；`)"
    },
    {
      "Id": 100930300,
      "Speaker": "Student",
      "Text": "おかげで勉強めっちゃ頑張れた！"
    },
    {
      "Id": 100930310,
      "Speaker": "Player",
      "Text": "役に立てたならよかった……"
    },
    {
      "Id": 100930320,
      "Speaker": "Student",
      "Text": "あれ？先生元気無い？"
    },
    {
      "Id": 100930330,
      "Speaker": "Student",
      "Text": "今度、元気注入してあげよっか？"
    },
    {
      "Id": 100930340,
      "Speaker": "Student",
      "Text": "じゃあまたね！次もよろしく！"
    },
    {
      "Id": 100930350,
      "Speaker": "Player",
      "Text": "次……？"
    },
    {
      "Id": 100930360,
      "Speaker": "Student",
      "Text": "うん！また近いうちに連絡するね(＞＜)"
    },
    {
      "Id": 100930370,
      "Speaker": "Student",
      "Text": "先生！！！！！"
    },
    {
      "Id": 100930380,
      "Speaker": "Student",
      "Text": "今日って時間ある？"
    },
    {
      "Id": 100930390,
      "Speaker": "Player",
      "Text": "うん、大丈夫だよ"
    },
    {
      "Id": 100930400,
      "Speaker": "Student",
      "Text": "よかった♪"
    },
    {
      "Id": 100930410,
      "Speaker": "Student",
      "Text": "んじゃ、こないだみたいに勉強教えてくんない？"
    },
    {
      "Id": 100930420,
      "Speaker": "Player",
      "Text": "うん、任せて"
    },
    {
      "Id": 100930430,
      "Speaker": "Student",
      "Text": "今度はうちの教室に来てよ！"
    },
    {
      "Id": 100930440,
      "Speaker": "Student",
      "Text": "今日は誰もいないから、静かに勉強できるし！"
    },
    {
      "Id": 100930450,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "んじゃ、待ってるね～！"
    },
    {
      "Id": 100930460,
      "Speaker": "Student",
      "Text": "ちょっと気になったんだけど"
    },
    {
      "Id": 100930470,
      "Speaker": "Student",
      "Text": "本当に何も考えてなかったんだよね？"
    },
    {
      "Id": 100930480,
      "Speaker": "Student",
      "Text": "あ、いや、疑ってるとかじゃなくて！"
    },
    {
      "Id": 100930490,
      "Speaker": "Player",
      "Text": "えっと、感想が欲しいってこと……？"
    },
    {
      "Id": 100930500,
      "Speaker": "Student",
      "Text": "それはどうゆ"
    },
    {
      "Id": 100930510,
      "Speaker": "Student",
      "Text": "ちょっ"
    },
    {
      "Id": 100930520,
      "Speaker": "Student",
      "Text": "何言わせる気！？"
    },
    {
      "Id": 100930530,
      "Speaker": "Player",
      "Text": "キララって、真面目なところもあるよね"
    },
    {
      "Id": 100930540,
      "Speaker": "Student",
      "Text": "？"
    },
    {
      "Id": 100930550,
      "Speaker": "Student",
      "Text": "あー"
    },
    {
      "Id": 100930560,
      "Speaker": "Student",
      "Text": "勉強の話？"
    },
    {
      "Id": 100930570,
      "Speaker": "Player",
      "Text": "追試、頑張って！"
    },
    {
      "Id": 100930580,
      "Speaker": "Student",
      "Text": "う、うん……"
    },
    {
      "Id": 100930590,
      "Speaker": "Student",
      "Text": "とりあえず、サンキュ♪"
    },
    {
      "Id": 100930600,
      "Speaker": "Student",
      "Text": "先生！！！！！"
    },
    {
      "Id": 100930610,
      "Speaker": "Student",
      "Text": "先生先生せんせい先生せんせい！！！！！！！！！！！"
    },
    {
      "Id": 100930620,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100930630,
      "Speaker": "Student",
      "Text": "やった！"
    },
    {
      "Id": 100930640,
      "Speaker": "Student",
      "Text": "追試、合格したよ！！"
    },
    {
      "Id": 100930650,
      "Speaker": "Player",
      "Text": "おめでとう！"
    },
    {
      "Id": 100930660,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 100930670,
      "Speaker": "Student",
      "Text": "全部先生のおかげ♪"
    },
    {
      "Id": 100930680,
      "Speaker": "Student",
      "Text": "だからお礼させてくんない？"
    },
    {
      "Id": 100930690,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ほら、遊びに行こ！"
    },
    {
      "Id": 100930700,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 100930710,
      "Speaker": "Student",
      "Text": "えっとね"
    },
    {
      "Id": 100930720,
      "Speaker": "Student",
      "Text": "またテストに合格したら、2人で遊びに行かない？"
    },
    {
      "Id": 100930730,
      "Speaker": "Player",
      "Text": "もちろん"
    },
    {
      "Id": 100930740,
      "Speaker": "Player",
      "Text": "キララと一緒に回るの、楽しかったから"
    },
    {
      "Id": 100930750,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 100930760,
      "Speaker": "Student",
      "Text": "じゃあ、勉強めっちゃ頑張らなきゃね(´；ω；`)笑"
    },
    {
      "Id": 100930770,
      "Speaker": "Student",
      "Text": "んじゃまたね！"
    },
    {
      "Id": 100930780,
      "Speaker": "Student",
      "Text": "先生！大変！"
    },
    {
      "Id": 100930790,
      "Speaker": "Student",
      "Text": "リングノート無くしちゃった！"
    },
    {
      "Id": 100930800,
      "Speaker": "Student",
      "Text": "先生、どこかで見てたりしてない……？"
    },
    {
      "Id": 100930810,
      "Speaker": "Student",
      "Text": "覚えてたらでいいんだけど"
    },
    {
      "Id": 100930820,
      "Speaker": "Player",
      "Text": "どんなノート……？"
    },
    {
      "Id": 100930830,
      "Speaker": "Student",
      "Text": "やっぱそうだよねー"
    },
    {
      "Id": 100930840,
      "Speaker": "Student",
      "Text": "ごめん気にしないで……！"
    },
    {
      "Id": 100930850,
      "Speaker": "Student",
      "Text": "また後で！"
    },
    {
      "Id": 100930860,
      "Speaker": "Player",
      "StoryEpisode": 5,
      "Text": "……キララ？"
    },
    {
      "Id": 100930870,
      "Speaker": "Student",
      "Text": "ごめん先生！"
    },
    {
      "Id": 100930880,
      "Speaker": "Student",
      "Text": "ちょっと急用を思い出しちゃって！"
    },
    {
      "Id": 100930890,
      "Speaker": "Student",
      "Text": "それと"
    },
    {
      "Id": 100930900,
      "Speaker": "Student",
      "Text": "あの"
    },
    {
      "Id": 100930910,
      "Speaker": "Student",
      "Text": "さっきのヤツ……"
    },
    {
      "Id": 100930920,
      "Speaker": "Student",
      "Text": "あれのことは"
    },
    {
      "Id": 100930930,
      "Speaker": "Student",
      "Text": "わ"
    },
    {
      "Id": 100930940,
      "Speaker": "Student",
      "Text": "忘れて……"
    },
    {
      "Id": 100930950,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 100930960,
      "Speaker": "Student",
      "Text": "気にしないで！"
    },
    {
      "Id": 100930970,
      "Speaker": "Student",
      "Text": "分かった！？"
    },
    {
      "Id": 100930980,
      "Speaker": "Player",
      "Text": "わ……分かりました？"
    },
    {
      "Id": 100930990,
      "Speaker": "Student",
      "Text": "うん！そういうことで！"
    },
    {
      "Id": 100931000,
      "Speaker": "Student",
      "Text": "それじゃあ"
    },
    {
      "Id": 100931010,
      "Speaker": "Student",
      "Text": "またね！先生！"
    }
  ],
  "DialogKR": [
    {
      "Id": 100930010,
      "Speaker": "Student",
      "Text": "안냥~"
    },
    {
      "Id": 100930020,
      "Speaker": "Student",
      "Text": "이거 쌤 번호 맞나요??"
    },
    {
      "Id": 100930030,
      "Speaker": "Player",
      "Text": "응, 안녕, 키라라."
    },
    {
      "Id": 100930040,
      "Speaker": "Student",
      "Text": "앗~ 안녕안녕~ 쌤~"
    },
    {
      "Id": 100930050,
      "Speaker": "Student",
      "Text": "있잖아, 오늘 누가 나한테 뭘 제일 좋아하냐고 물어보는 거 있지?"
    },
    {
      "Id": 100930060,
      "Speaker": "Student",
      "Text": "그래서 뭘 좋아하더라~ 하고 생각하고 생각~해봤더니"
    },
    {
      "Id": 100930070,
      "Speaker": "Student",
      "Text": "역시! 나 수다 떠는 걸 제일 좋아하는 것 같아!"
    },
    {
      "Id": 100930080,
      "Speaker": "Student",
      "Text": "쌤은 어때?"
    },
    {
      "Id": 100930090,
      "Speaker": "Student",
      "Text": "이야기하는 거 좋아해?"
    },
    {
      "Id": 100930100,
      "Speaker": "Player",
      "Text": "수다 떠는 거라면 좋아하는 편이야."
    },
    {
      "Id": 100930110,
      "Speaker": "Player",
      "Text": "나도 키라라와 이야기하는 거라면 좋아해."
    },
    {
      "Id": 100930120,
      "Speaker": "Student",
      "Text": "어. 진짜?!"
    },
    {
      "Id": 100930130,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "쌤이랑 나랑 똑같이 생각했네~ 아하하!"
    },
    {
      "Id": 100930140,
      "Speaker": "Student",
      "Text": "쌤쌤~"
    },
    {
      "Id": 100930150,
      "Speaker": "Student",
      "Text": "쌤도 반짝반짝부의 활동을 할 수 있는 방법을 찾았어!"
    },
    {
      "Id": 100930160,
      "Speaker": "Student",
      "Text": "쌤이 원한다면 우리 부의 고문으로 삼아 줄게~"
    },
    {
      "Id": 100930170,
      "Speaker": "Student",
      "Text": "그러니까, 같이 하교하고 싶으면 언제든 환영이야!"
    },
    {
      "Id": 100930180,
      "Speaker": "Student",
      "Text": "똑똑"
    },
    {
      "Id": 100930190,
      "Speaker": "Student",
      "Text": "쌤"
    },
    {
      "Id": 100930200,
      "Speaker": "Student",
      "Text": "ㅆ애애앰ㅠㅠㅠ"
    },
    {
      "Id": 100930210,
      "Speaker": "Player",
      "Text": "키라라……맞지?"
    },
    {
      "Id": 100930220,
      "Speaker": "Student",
      "Text": "ㅇㅇㅇ맞아!"
    },
    {
      "Id": 100930230,
      "Speaker": "Student",
      "Text": "쌤 나 좀 도와줘!"
    },
    {
      "Id": 100930240,
      "Speaker": "Student",
      "Text": "이번 시험 낙제했어ㅠㅠㅠ"
    },
    {
      "Id": 100930250,
      "Speaker": "Student",
      "Text": "샬레로 갈 테니 공부 좀 도와주라ㅠㅠ"
    },
    {
      "Id": 100930260,
      "Speaker": "Student",
      "Text": "앗, 하지만, 혹시…. 지금은 바빠서, 곤란… 하다든가?"
    },
    {
      "Id": 100930270,
      "Speaker": "Player",
      "Text": "아냐, 괜찮아. 기다리고 있을게."
    },
    {
      "Id": 100930280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "역시 쌤이야><"
    },
    {
      "Id": 100930290,
      "Speaker": "Student",
      "Text": "쌤 땡큐ㅠㅠㅠㅠ"
    },
    {
      "Id": 100930300,
      "Speaker": "Student",
      "Text": "쌤 덕분에 공부 완전 열심히 한 듯!!!!"
    },
    {
      "Id": 100930310,
      "Speaker": "Player",
      "Text": "도움이 되었다면 다행이고……."
    },
    {
      "Id": 100930320,
      "Speaker": "Student",
      "Text": "어? 답장이 어째 힘이 없는 느낌?"
    },
    {
      "Id": 100930330,
      "Speaker": "Student",
      "Text": "쌤, 완전 잘 가르쳐 줬는데?"
    },
    {
      "Id": 100930340,
      "Speaker": "Student",
      "Text": "다음에도 잘 부탁해!"
    },
    {
      "Id": 100930350,
      "Speaker": "Player",
      "Text": "아직 시험 범위가 남아 있었던 거야?"
    },
    {
      "Id": 100930360,
      "Speaker": "Student",
      "Text": "응! 조만간 또 연락할게><"
    },
    {
      "Id": 100930370,
      "Speaker": "Student",
      "Text": "쌤!!!!!"
    },
    {
      "Id": 100930380,
      "Speaker": "Student",
      "Text": "혹시 오늘 시간 괜찮아?"
    },
    {
      "Id": 100930390,
      "Speaker": "Player",
      "Text": "응, 오늘은 좀 한가한데."
    },
    {
      "Id": 100930400,
      "Speaker": "Student",
      "Text": "잘 됐다!"
    },
    {
      "Id": 100930410,
      "Speaker": "Student",
      "Text": "그러면 저번에 하던 과외, 오늘 계속 해주면 안 될까?"
    },
    {
      "Id": 100930420,
      "Speaker": "Player",
      "Text": "참, 시험 범위가 남았다고 했지?"
    },
    {
      "Id": 100930430,
      "Speaker": "Student",
      "Text": "이번엔 우리 교실로 오지 않을래?"
    },
    {
      "Id": 100930440,
      "Speaker": "Student",
      "Text": "오늘은 교실에 아무도 없을 예정이니까, 조용하게 공부 가능!"
    },
    {
      "Id": 100930450,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "그럼 기다릴게!"
    },
    {
      "Id": 100930460,
      "Speaker": "Student",
      "Text": "쌤"
    },
    {
      "Id": 100930470,
      "Speaker": "Student",
      "Text": "이거 진짜 그냥 순수하게 궁금해서 물어보는 건데"
    },
    {
      "Id": 100930480,
      "Speaker": "Student",
      "Text": "아까 별 생각 안 들었지?"
    },
    {
      "Id": 100930490,
      "Speaker": "Player",
      "Text": "감상을 원하는 거야?"
    },
    {
      "Id": 100930500,
      "Speaker": "Student",
      "Text": "그게무ㅡㅅㄴ"
    },
    {
      "Id": 100930510,
      "Speaker": "Student",
      "Text": "무슨"
    },
    {
      "Id": 100930520,
      "Speaker": "Student",
      "Text": "미쳤나봐"
    },
    {
      "Id": 100930530,
      "Speaker": "Player",
      "Text": "키라라는 의외로 성실하구나, 하는 생각이 들었어."
    },
    {
      "Id": 100930540,
      "Speaker": "Student",
      "Text": "?"
    },
    {
      "Id": 100930550,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100930560,
      "Speaker": "Student",
      "Text": "공부 얘기?"
    },
    {
      "Id": 100930570,
      "Speaker": "Player",
