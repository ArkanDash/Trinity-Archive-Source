{
  "CharacterId": 10020,
  "DialogJP": [
    {
      "Id": 100200010,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100200020,
      "Speaker": "Student",
      "Text": "今って暇？"
    },
    {
      "Id": 100200030,
      "Speaker": "Student",
      "Text": "実は……"
    },
    {
      "Id": 100200040,
      "Speaker": "Student",
      "Text": "ちょっと聞きたいことがあって"
    },
    {
      "Id": 100200050,
      "Speaker": "Student",
      "Text": "純粋に。生徒として、先生に"
    },
    {
      "Id": 100200060,
      "Speaker": "Player",
      "Text": "勉強関連のこと？"
    },
    {
      "Id": 100200070,
      "Speaker": "Player",
      "Text": "そこまで強調しなくても……"
    },
    {
      "Id": 100200080,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 100200090,
      "Speaker": "Student",
      "Text": "別に他意は無いから"
    },
    {
      "Id": 100200100,
      "Speaker": "Student",
      "Text": "いや、別に"
    },
    {
      "Id": 100200110,
      "Speaker": "Student",
      "Text": "強調とかじゃないから"
    },
    {
      "Id": 100200120,
      "Speaker": "Student",
      "Text": "場所は後でまた連絡する"
    },
    {
      "Id": 100200130,
      "Speaker": "Student",
      "Text": "もう一度言うけど、本当に勉強のためだから"
    },
    {
      "Id": 100200140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "それ以外の変なこととか期待しないでよね"
    },
    {
      "Id": 100200150,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 100200160,
      "Speaker": "Student",
      "Text": "せｎ"
    },
    {
      "Id": 100200170,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100200180,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 100200190,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100200200,
      "Speaker": "Student",
      "Text": "ｓ"
    },
    {
      "Id": 100200210,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 100200220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "なんでもない"
    },
    {
      "Id": 100200230,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100200240,
      "Speaker": "Student",
      "Text": "今どこ？"
    },
    {
      "Id": 100200250,
      "Speaker": "Student",
      "Text": "またどこかで、変なこと企ててたりしないよね？"
    },
    {
      "Id": 100200260,
      "Speaker": "Player",
      "Text": "どういうこと……？"
    },
    {
      "Id": 100200270,
      "Speaker": "Player",
      "Text": "……バレた？"
    },
    {
      "Id": 100200280,
      "Speaker": "Student",
      "Text": "ま、またそうやって"
    },
    {
      "Id": 100200290,
      "Speaker": "Student",
      "Text": "知らんぷりしても無駄なんだから"
    },
    {
      "Id": 100200300,
      "Speaker": "Student",
      "Text": "……やっ"
    },
    {
      "Id": 100200310,
      "Speaker": "Student",
      "Text": "やっぱり！！！"
    },
    {
      "Id": 100200320,
      "Speaker": "Student",
      "Text": "このままじゃダメ"
    },
    {
      "Id": 100200330,
      "Speaker": "Student",
      "Text": "私がしっかり監視しないと……"
    },
    {
      "Id": 100200340,
      "Speaker": "Student",
      "Text": "うん、仕方ない"
    },
    {
      "Id": 100200350,
      "Speaker": "Student",
      "Text": "今すぐに来て"
    },
    {
      "Id": 100200360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "場所はこの後すぐに送る。待ってるから"
    },
    {
      "Id": 100200370,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100200380,
      "Speaker": "Student",
      "Text": "……えっと"
    },
    {
      "Id": 100200390,
      "Speaker": "Student",
      "Text": "先生？"
    },
    {
      "Id": 100200400,
      "Speaker": "Player",
      "Text": "大丈夫、秘密にするよ。そういう時期もあるよね"
    },
    {
      "Id": 100200410,
      "Speaker": "Player",
      "Text": "本当はあんまり良くないから、次からはもう少しうまく隠しておこうね"
    },
    {
      "Id": 100200420,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200430,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200440,
      "Speaker": "Student",
      "Text": "……うん"
    },
    {
      "Id": 100200450,
      "Speaker": "Student",
      "Text": "先生……？"
    },
    {
      "Id": 100200460,
      "Speaker": "Student",
      "Text": "今、時間大丈夫？"
    },
    {
      "Id": 100200470,
      "Speaker": "Student",
      "Text": "時間、あるよね？"
    },
    {
      "Id": 100200480,
      "Speaker": "Student",
      "Text": "どうせ、何もやってないでしょ……？"
    },
    {
      "Id": 100200490,
      "Speaker": "Player",
      "Text": "いや、実は結構忙しくって……"
    },
    {
      "Id": 100200500,
      "Speaker": "Player",
      "Text": "徹夜で全然寝てなくって、寝ようとしてたとこ……"
    },
    {
      "Id": 100200510,
      "Speaker": "Student",
      "Text": "……ふうん"
    },
    {
      "Id": 100200520,
      "Speaker": "Student",
      "Text": "と、とにかく"
    },
    {
      "Id": 100200530,
      "Speaker": "Student",
      "Text": "この前のこともあるし、ちょっと来て欲しいんだけど……"
    },
    {
      "Id": 100200540,
      "Speaker": "Player",
      "Text": "これも監視の一環……？"
    },
    {
      "Id": 100200550,
      "Speaker": "Player",
      "Text": "たまにはシャーレの方に来てみる？"
    },
    {
      "Id": 100200560,
      "Speaker": "Student",
      "Text": "えっと、そうって言うかそうじゃないって言うか……"
    },
    {
      "Id": 100200570,
      "Speaker": "Student",
      "Text": "な、ななな何を言ってるの！？"
    },
    {
      "Id": 100200580,
      "Speaker": "Student",
      "Text": "そ、そういう風に誘導しても無駄だから"
    },
    {
      "Id": 100200590,
      "Speaker": "Student",
      "Text": "と、とにかく来て……"
    },
    {
      "Id": 100200600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "学校で待ってるから"
    },
    {
      "Id": 100200610,
      "Speaker": "Student",
      "Text": "先生……"
    },
    {
      "Id": 100200620,
      "Speaker": "Student",
      "Text": "……先生？"
    },
    {
      "Id": 100200630,
      "Speaker": "Student",
      "Text": "さ"
    },
    {
      "Id": 100200640,
      "Speaker": "Student",
      "Text": "さっきの……その……"
    },
    {
      "Id": 100200650,
      "Speaker": "Student",
      "Text": "……？"
    },
    {
      "Id": 100200660,
      "Speaker": "Student",
      "Text": "……先生？"
    },
    {
      "Id": 100200670,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200680,
      "Speaker": "Student",
      "Text": "……もう寝ちゃった？"
    }
  ],
  "DialogKR": [
    {
      "Id": 100200010,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100200020,
      "Speaker": "Student",
      "Text": "시간 있어?"
    },
    {
      "Id": 100200030,
      "Speaker": "Student",
      "Text": "다른 건 아니고……"
    },
    {
      "Id": 100200040,
      "Speaker": "Student",
      "Text": "그냥 물어보고 싶은 게 좀 있어."
    },
    {
      "Id": 100200050,
      "Speaker": "Student",
      "Text": "순수하게. 학생으로서. 선생님한테."
    },
    {
      "Id": 100200060,
      "Speaker": "Player",
      "Text": "공부와 관련된 거야?"
    },
    {
      "Id": 100200070,
      "Speaker": "Player",
      "Text": "굳이 그걸 강조하시는 이유는……"
    },
    {
      "Id": 100200080,
      "Speaker": "Student",
      "Text": "응."
    },
    {
      "Id": 100200090,
      "Speaker": "Student",
      "Text": "일절. 다른 이유 없이."
    },
    {
      "Id": 100200100,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100200110,
      "Speaker": "Student",
      "Text": "강조한 거 아냐 절대 아냐"
    },
    {
      "Id": 100200120,
      "Speaker": "Student",
      "Text": "장소는 내가 정해 둘 테니까"
    },
    {
      "Id": 100200130,
      "Speaker": "Student",
      "Text": "다시 한번 이야기하는 거지만, 정말로 공부 때문이야."
    },
    {
      "Id": 100200140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "일절 다른 이유는 없으니까"
    },
    {
      "Id": 100200150,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 100200160,
      "Speaker": "Student",
      "Text": "선ㅅ"
    },
    {
      "Id": 100200170,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100200180,
      "Speaker": "Player",
      "Text": "……?"
    },
    {
      "Id": 100200190,
      "Speaker": "Player",
      "Text": "무슨 일이야?"
    },
    {
      "Id": 100200200,
      "Speaker": "Student",
      "Text": "ㅅ"
    },
    {
      "Id": 100200210,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 100200220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "아니야"
    },
    {
      "Id": 100200230,
      "Speaker": "Student",
      "Text": "선생님……"
    },
    {
      "Id": 100200240,
      "Speaker": "Student",
      "Text": "지금 어디야"
    },
    {
      "Id": 100200250,
      "Speaker": "Student",
      "Text": "또 어딘가에서 이상한 생각을 하고 있는 건 아니겠지?"
    },
    {
      "Id": 100200260,
      "Speaker": "Player",
      "Text": "갑자기 또 무슨 소릴……"
    },
    {
      "Id": 100200270,
      "Speaker": "Player",
      "Text": "……들켰나?"
    },
    {
      "Id": 100200280,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200290,
      "Speaker": "Student",
      "Text": "시치미 떼도 소용없어……"
    },
    {
      "Id": 100200300,
      "Speaker": "Student",
      "Text": "……역시……"
    },
    {
      "Id": 100200310,
      "Speaker": "Student",
      "Text": "역시!!"
    },
    {
      "Id": 100200320,
      "Speaker": "Student",
      "Text": "으으으…… 역시 안 되겠어."
    },
    {
      "Id": 100200330,
      "Speaker": "Student",
      "Text": "내가 감시하지 않으면……"
    },
    {
      "Id": 100200340,
      "Speaker": "Student",
      "Text": "그런 고로"
    },
    {
      "Id": 100200350,
      "Speaker": "Student",
      "Text": "지금 바로 나와줘야겠어."
    },
    {
      "Id": 100200360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "위치는 내가 정한 곳에서, 기다리고 있을 테니까."
    },
    {
      "Id": 100200370,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100200380,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200390,
      "Speaker": "Student",
      "Text": "선생님?"
    },
    {
      "Id": 100200400,
      "Speaker": "Player",
      "Text": "비밀로 할 테니 걱정 마."
    },
    {
      "Id": 100200410,
      "Speaker": "Player",
      "Text": "다음부턴 좀 더 잘 숨기는 게 좋을 거 같아."
    },
    {
      "Id": 100200420,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200430,
      "Speaker": "Student",
      "Text": "으으……"
    },
    {
      "Id": 100200440,
      "Speaker": "Student",
      "Text": "……응"
    },
    {
      "Id": 100200450,
      "Speaker": "Student",
      "Text": "선생님……?"
    },
    {
      "Id": 100200460,
      "Speaker": "Student",
      "Text": "지금 혹시 시간 괜찮을까?"
    },
    {
      "Id": 100200470,
      "Speaker": "Student",
      "Text": "아니, 괜찮겠……지?"
    },
    {
      "Id": 100200480,
      "Speaker": "Student",
      "Text": "딱히 지금 하는 거 없잖아……?"
    },
    {
      "Id": 100200490,
      "Speaker": "Player",
      "Text": "아니…… 일이 없진 않았는데요……"
    },
    {
      "Id": 100200500,
      "Speaker": "Player",
      "Text": "철야 작업으로 잠 한숨 못 잔 상황이지만……"
    },
    {
      "Id": 100200510,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200520,
      "Speaker": "Student",
      "Text": "아, 아무튼. 아무튼."
    },
    {
      "Id": 100200530,
      "Speaker": "Student",
      "Text": "일전의 일도 있고 하니까 나와줬으면 하는데……"
    },
    {
      "Id": 100200540,
      "Speaker": "Player",
      "Text": "뭐…… 또 감시의 일환?"
    },
    {
      "Id": 100200550,
      "Speaker": "Player",
      "Text": "슬슬 그쪽에서 오는 게 맞지 않을까 싶은데."
    },
    {
      "Id": 100200560,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100200570,
      "Speaker": "Student",
      "Text": "무, 무무무 무슨 소리야"
    },
    {
      "Id": 100200580,
      "Speaker": "Student",
      "Text": "그런 식으로 유도해도 소용없어"
    },
    {
      "Id": 100200590,
      "Speaker": "Student",
      "Text": "그냥 일단 나와주면 안 돼……?"
    },
    {
      "Id": 100200600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "학교에서 기다리고 있을 테니까"
    },
    {
      "Id": 100200610,
      "Speaker": "Student",
      "Text": "선생님?"
    },
    {
      "Id": 100200620,
      "Speaker": "Student",
      "Text": "……선생님?"
    },
    {
      "Id": 100200630,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100200640,
      "Speaker": "Student",
      "Text": "아까 전에…… 그……"
    },
    {
      "Id": 100200650,
      "Speaker": "Student",
      "Text": "……?"
    },
    {
      "Id": 100200660,
      "Speaker": "Student",
      "Text": "……선생님?"
    },
    {
      "Id": 100200670,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200680,
      "Speaker": "Student",
      "Text": "……자?"
    }
  ],
  "DialogEN": [
    {
      "Id": 100200010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100200020,
      "Speaker": "Student",
      "Text": "Do you have time?"
    },
    {
      "Id": 100200030,
      "Speaker": "Student",
      "Text": "It's nothing serious, but..."
    },
    {
      "Id": 100200040,
      "Speaker": "Student",
      "Text": "I have something to ask you."
    },
    {
      "Id": 100200050,
      "Speaker": "Student",
      "Text": "Just an innocent student-to-teacher thing."
    },
    {
      "Id": 100200060,
      "Speaker": "Player",
      "Text": "Is it about your classes?"
    },
    {
      "Id": 100200070,
      "Speaker": "Player",
      "Text": "Do you really need to emphasize the innocent part?"
    },
    {
      "Id": 100200080,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 100200090,
      "Speaker": "Student",
      "Text": "There's no other reason. None at all."
    },
    {
      "Id": 100200100,
      "Speaker": "Student",
      "Text": "Oh..."
    },
    {
      "Id": 100200110,
      "Speaker": "Student",
      "Text": "I didn't mean to come off that way. Not at all."
    },
    {
      "Id": 100200120,
      "Speaker": "Student",
      "Text": "I'll tell you where we should meet."
    },
    {
      "Id": 100200130,
      "Speaker": "Student",
      "Text": "I assure you, it's really about my classes."
    },
    {
      "Id": 100200140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "There's no other reason."
    },
    {
      "Id": 100200150,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 100200160,
      "Speaker": "Student",
      "Text": "Sen..."
    },
    {
      "Id": 100200170,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 100200180,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 100200190,
      "Speaker": "Player",
      "Text": "What's going on?"
    },
    {
      "Id": 100200200,
      "Speaker": "Student",
      "Text": "S..."
    },
    {
      "Id": 100200210,
      "Speaker": "Student",
      "Text": "Never mind."
    },
    {
      "Id": 100200220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Never mind."
    },
    {
      "Id": 100200230,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 100200240,
      "Speaker": "Student",
      "Text": "Where are you?"
    },
    {
      "Id": 100200250,
      "Speaker": "Student",
      "Text": "You're not thinking something weird again, are you?"
    },
    {
      "Id": 100200260,
      "Speaker": "Player",
      "Text": "I have no idea what you're talking about."
    },
    {
      "Id": 100200270,
      "Speaker": "Player",
      "Text": "...You got me."
    },
    {
      "Id": 100200280,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200290,
      "Speaker": "Student",
      "Text": "You can't fool me..."
    },
    {
      "Id": 100200300,
      "Speaker": "Student",
      "Text": "...I knew it."
    },
    {
      "Id": 100200310,
      "Speaker": "Student",
      "Text": "I knew it!"
    },
    {
      "Id": 100200320,
      "Speaker": "Student",
      "Text": "Ugh... I just can't with you."
    },
    {
      "Id": 100200330,
      "Speaker": "Student",
      "Text": "If I don't keep an eye on you..."
    },
    {
      "Id": 100200340,
      "Speaker": "Student",
      "Text": "That's why"
    },
    {
      "Id": 100200350,
      "Speaker": "Student",
      "Text": "you need to come see me right away."
    },
    {
      "Id": 100200360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "I'll tell you where to meet. I'll be waiting for you there."
    },
    {
      "Id": 100200370,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100200380,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200390,
      "Speaker": "Student",
      "Text": "Sensei?"
    },
    {
      "Id": 100200400,
      "Speaker": "Player",
      "Text": "I'll keep it a secret. Don't worry."
    },
    {
      "Id": 100200410,
      "Speaker": "Player",
      "Text": "You should really do a better job hiding it next time."
    },
    {
      "Id": 100200420,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200430,
      "Speaker": "Student",
      "Text": "Ugh..."
    },
    {
      "Id": 100200440,
      "Speaker": "Student",
      "Text": "Okay..."
    },
    {
      "Id": 100200450,
      "Speaker": "Student",
      "Text": "Sensei...?"
    },
    {
      "Id": 100200460,
      "Speaker": "Student",
      "Text": "Are you free, by any chance?"
    },
    {
      "Id": 100200470,
      "Speaker": "Student",
      "Text": "I mean, surely you are...right?"
    },
    {
      "Id": 100200480,
      "Speaker": "Student",
      "Text": "You're not doing anything right now...?"
    },
    {
      "Id": 100200490,
      "Speaker": "Player",
      "Text": "Well...I'm not up to nothing, exactly..."
    },
    {
      "Id": 100200500,
      "Speaker": "Player",
      "Text": "I stayed up all night working and didn't get any sleep..."
    },
    {
      "Id": 100200510,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200520,
      "Speaker": "Student",
      "Text": "But anyway..."
    },
    {
      "Id": 100200530,
      "Speaker": "Student",
      "Text": "Considering there was that incident just a few days ago, I really need you to come out here..."
    },
    {
      "Id": 100200540,
      "Speaker": "Player",
      "Text": "Huh? You want to monitor me again?"
    },
    {
      "Id": 100200550,
      "Speaker": "Player",
      "Text": "You know, I'd really like it if you came to visit me instead."
    },
    {
      "Id": 100200560,
      "Speaker": "Student",
      "Text": "Oh..."
    },
    {
      "Id": 100200570,
      "Speaker": "Student",
      "Text": "What are you getting at?!"
    },
    {
      "Id": 100200580,
      "Speaker": "Student",
      "Text": "That sorta thing won't work on me, okay??"
    },
    {
      "Id": 100200590,
      "Speaker": "Student",
      "Text": "Can't you just come...?"
    },
    {
      "Id": 100200600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I'll be waiting for you at school."
    },
    {
      "Id": 100200610,
      "Speaker": "Student",
      "Text": "Sensei?"
    },
    {
      "Id": 100200620,
      "Speaker": "Student",
      "Text": "...Sensei?"
    },
    {
      "Id": 100200630,
      "Speaker": "Student",
      "Text": "Oh..."
    },
    {
      "Id": 100200640,
      "Speaker": "Student",
      "Text": "That... From before..."
    },
    {
      "Id": 100200650,
      "Speaker": "Student",
      "Text": "...?"
    },
    {
      "Id": 100200660,
      "Speaker": "Student",
      "Text": "...Sensei?"
    },
    {
      "Id": 100200670,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200680,
      "Speaker": "Student",
      "Text": "...Are you asleep?"
    }
  ],
  "DialogTH": [
    {
      "Id": 100200010,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100200020,
      "Speaker": "Student",
      "Text": "พอมีเวลามั้ย?"
    },
    {
      "Id": 100200030,
      "Speaker": "Student",
      "Text": "คือว่าฉัน..."
    },
    {
      "Id": 100200040,
      "Speaker": "Student",
      "Text": "มีเรื่องอยากถามหน่อยน่ะ"
    },
    {
      "Id": 100200050,
      "Speaker": "Student",
      "Text": "คำถามถึงคุณครู... จากนักเรียน\nไร้เดียงสา..."
    },
    {
      "Id": 100200060,
      "Speaker": "Player",
      "Text": "เกี่ยวกับการเรียนเหรอ?"
    },
    {
      "Id": 100200070,
      "Speaker": "Player",
      "Text": "ทำไมถึงย้ำขนาดนั้นล่ะ..."
    },
    {
      "Id": 100200080,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100200090,
      "Speaker": "Student",
      "Text": "ไม่มีเหตุผลอะไรอื่นหรอก"
    },
    {
      "Id": 100200100,
      "Speaker": "Student",
      "Text": "อีกอย่าง..."
    },
    {
      "Id": 100200110,
      "Speaker": "Student",
      "Text": "เมื่อกี๊ฉันไม่ได้จะเน้นย้ำอะไรเลยนะ"
    },
    {
      "Id": 100200120,
      "Speaker": "Student",
      "Text": "แล้วฉันจะคิดเองว่าเจอกันที่ไหนดี"
    },
    {
      "Id": 100200130,
      "Speaker": "Student",
      "Text": "แล้วก็... มันเกี่ยวกับการเรียนจริงๆ นะ"
    },
    {
      "Id": 100200140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ไม่มีเหตุผลอะไรอื่นเลย"
    },
    {
      "Id": 100200150,
      "Speaker": "Student",
      "Text": "เอ่อ..."
    },
    {
      "Id": 100200160,
      "Speaker": "Student",
      "Text": "คะ.."
    },
    {
      "Id": 100200170,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100200180,
      "Speaker": "Player",
      "Text": ".....?"
    },
    {
      "Id": 100200190,
      "Speaker": "Player",
      "Text": "มีอะไรเหรอ?"
    },
    {
      "Id": 100200200,
      "Speaker": "Student",
      "Text": "คะ..."
    },
    {
      "Id": 100200210,
      "Speaker": "Student",
      "Text": "ไม่สิ"
    },
    {
      "Id": 100200220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ไม่ๆ"
    },
    {
      "Id": 100200230,
      "Speaker": "Student",
      "Text": "คุณครู..."
    },
    {
      "Id": 100200240,
      "Speaker": "Student",
      "Text": "ตอนนี้อยู่ไหนเหรอ?"
    },
    {
      "Id": 100200250,
      "Speaker": "Student",
      "Text": "มัวแต่นั่งคิดอะไรแปลกๆ อยู่ที่ไหน\nใช่มั้ย?"
    },
    {
      "Id": 100200260,
      "Speaker": "Player",
      "Text": "พูดอะไรของเธอน่ะ?"
    },
    {
      "Id": 100200270,
      "Speaker": "Player",
      "Text": "ทำไมรู้ล่ะ...?"
    },
    {
      "Id": 100200280,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200290,
      "Speaker": "Student",
      "Text": "อย่ามาทำเป็นไม่รู้ไม่ชี้เลยน่า..."
    },
    {
      "Id": 100200300,
      "Speaker": "Student",
      "Text": "ว่าแล้วเชียว..."
    },
    {
      "Id": 100200310,
      "Speaker": "Student",
      "Text": "ว่าแล้ว!!"
    },
    {
      "Id": 100200320,
      "Speaker": "Student",
      "Text": "ไม่ได้การแล้ว คุณครูคนนี้...."
    },
    {
      "Id": 100200330,
      "Speaker": "Student",
      "Text": "ถ้าไม่ได้ฉันมาสอดส่องดูแลละก็..."
    },
    {
      "Id": 100200340,
      "Speaker": "Student",
      "Text": "ต้องเป็นเรื่องแน่"
    },
    {
      "Id": 100200350,
      "Speaker": "Student",
      "Text": "ต้องออกมาหาฉันหน่อยแล้วละ"
    },
    {
      "Id": 100200360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "แล้วฉันจะรออยู่ตรงที่ที่เคยบอกไว้นะ"
    },
    {
      "Id": 100200370,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100200380,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200390,
      "Speaker": "Student",
      "Text": "คุณครู?"
    },
    {
      "Id": 100200400,
      "Speaker": "Player",
      "Text": "ไม่ต้องกังวลหรอกน่า\nครูจะเก็บเป็นความลับ"
    },
    {
      "Id": 100200410,
      "Speaker": "Player",
      "Text": "ต่อไปทำอะไรก็ปิดบังให้ดีด้วยล่ะ"
    },
    {
      "Id": 100200420,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200430,
      "Speaker": "Student",
      "Text": "เอ่อ......"
    },
    {
      "Id": 100200440,
      "Speaker": "Student",
      "Text": "อื้มม..."
    },
    {
      "Id": 100200450,
      "Speaker": "Student",
      "Text": "คุณครู...?"
    },
    {
      "Id": 100200460,
      "Speaker": "Student",
      "Text": "ตอนนี้คุณครูยุ่งมั้ย?"
    },
    {
      "Id": 100200470,
      "Speaker": "Student",
      "Text": "ไม่น่าจะยุ่ง... ใช่มั้ย?"
    },
    {
      "Id": 100200480,
      "Speaker": "Student",
      "Text": "ตอนนี้ไม่มีอะไรทำไม่ใช่เหรอ?"
    },
    {
      "Id": 100200490,
      "Speaker": "Player",
      "Text": "ไม่นะ... งานให้ทำก็มีตลอดนะ"
    },
    {
      "Id": 100200500,
      "Speaker": "Player",
      "Text": "แต่เมื่อคืนครูโต้รุ่งจนไม่ได้นอน..."
    },
    {
      "Id": 100200510,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200520,
      "Speaker": "Student",
      "Text": "อ่า... เอาเป็นว่า"
    },
    {
      "Id": 100200530,
      "Speaker": "Student",
      "Text": "ออกมาเจอกันหน่อยได้มั้ย?\nเราต้องคุยเรื่องวันก่อนด้วย"
    },
    {
      "Id": 100200540,
      "Speaker": "Player",
      "Text": "เดี๋ยวนะ... จะมาจับตาดูอะไรอีก?"
    },
    {
      "Id": 100200550,
      "Speaker": "Player",
      "Text": "เธอน่าจะเป็นคนมาหาครูบ้างนะ"
    },
    {
      "Id": 100200560,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 100200570,
      "Speaker": "Student",
      "Text": "พะ... พะ... พูดอะไรน่ะ?"
    },
    {
      "Id": 100200580,
      "Speaker": "Student",
      "Text": "พูดโน้มน้าวแบบนั้นไม่มีประโยชน์\nหรอกน่า"
    },
    {
      "Id": 100200590,
      "Speaker": "Student",
      "Text": "เอาเป็นว่า คุณครูออกมาหาก่อน\nไม่ได้เหรอ?"
    },
    {
      "Id": 100200600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ฉันจะรอที่อยู่โรงเรียนก็แล้วกัน"
    },
    {
      "Id": 100200610,
      "Speaker": "Student",
      "Text": "คุณครู?"
    },
    {
      "Id": 100200620,
      "Speaker": "Student",
      "Text": "คุณครู...?"
    },
    {
      "Id": 100200630,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 100200640,
      "Speaker": "Student",
      "Text": "คือว่า... เมื่อกี๊น่ะ..."
    },
    {
      "Id": 100200650,
      "Speaker": "Student",
      "Text": ".....?"
    },
    {
      "Id": 100200660,
      "Speaker": "Student",
      "Text": "คุณครู...?"
    },
    {
      "Id": 100200670,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100200680,
      "Speaker": "Student",
      "Text": "หลับเหรอ...?"
    }
  ],
  "DialogTW": [
    {
      "Id": 100200010,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100200020,
      "Speaker": "Student",
      "Text": "現在有空嗎？"
    },
    {
      "Id": 100200030,
      "Speaker": "Student",
      "Text": "其實……"
    },
    {
      "Id": 100200040,
      "Speaker": "Student",
      "Text": "我有些事情想請教"
    },
    {
      "Id": 100200050,
      "Speaker": "Student",
      "Text": "單純是，以學生和老師的身分"
    },
    {
      "Id": 100200060,
      "Speaker": "Player",
      "Text": "學習相關的事？"
    },
    {
      "Id": 100200070,
      "Speaker": "Player",
      "Text": "不用那麼強調……"
    },
    {
      "Id": 100200080,
      "Speaker": "Student",
      "Text": "嗯"
    },
    {
      "Id": 100200090,
      "Speaker": "Student",
      "Text": "沒有別的意思"
    },
    {
      "Id": 100200100,
      "Speaker": "Student",
      "Text": "不，不是那樣"
    },
    {
      "Id": 100200110,
      "Speaker": "Student",
      "Text": "我沒有要強調什麼"
    },
    {
      "Id": 100200120,
      "Speaker": "Student",
      "Text": "地點稍後再聯絡你"
    },
    {
      "Id": 100200130,
      "Speaker": "Student",
      "Text": "再說一遍，真的是為了學習"
    },
    {
      "Id": 100200140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "不要期待其他奇怪的事情唷"
    },
    {
      "Id": 100200150,
      "Speaker": "Student",
      "Text": "那個"
    },
    {
      "Id": 100200160,
      "Speaker": "Student",
      "Text": "老"
    },
    {
      "Id": 100200170,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100200180,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 100200190,
      "Speaker": "Player",
      "Text": "怎麼了？"
    },
    {
      "Id": 100200200,
      "Speaker": "Student",
      "Text": "師"
    },
    {
      "Id": 100200210,
      "Speaker": "Student",
      "Text": "不"
    },
    {
      "Id": 100200220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "沒什麼"
    },
    {
      "Id": 100200230,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100200240,
      "Speaker": "Student",
      "Text": "你現在在哪？"
    },
    {
      "Id": 100200250,
      "Speaker": "Student",
      "Text": "不會又在哪裡，計劃著奇怪的事情吧？"
    },
    {
      "Id": 100200260,
      "Speaker": "Player",
      "Text": "什麼意思……？"
    },
    {
      "Id": 100200270,
      "Speaker": "Player",
      "Text": "……被發現了嗎？"
    },
    {
      "Id": 100200280,
      "Speaker": "Student",
      "Text": "又，又這樣子"
    },
    {
      "Id": 100200290,
      "Speaker": "Student",
      "Text": "裝作不知道也沒用"
    },
    {
      "Id": 100200300,
      "Speaker": "Student",
      "Text": "……果"
    },
    {
      "Id": 100200310,
      "Speaker": "Student",
      "Text": "果然！！！"
    },
    {
      "Id": 100200320,
      "Speaker": "Student",
      "Text": "這樣下去不行"
    },
    {
      "Id": 100200330,
      "Speaker": "Student",
      "Text": "如果我不好好監視的話……"
    },
    {
      "Id": 100200340,
      "Speaker": "Student",
      "Text": "唔，沒辦法"
    },
    {
      "Id": 100200350,
      "Speaker": "Student",
      "Text": "現在馬上過來"
    },
    {
      "Id": 100200360,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "地點之後馬上發過去。我會等著的"
    },
    {
      "Id": 100200370,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100200380,
      "Speaker": "Student",
      "Text": "……那個"
    },
    {
      "Id": 100200390,
      "Speaker": "Student",
      "Text": "老師？"
    },
    {
      "Id": 100200400,
      "Speaker": "Player",
      "Text": "沒事，我會保密的。人生就是會有這種時期呢"
    },
    {
      "Id": 100200410,
      "Speaker": "Player",
      "Text": "老實說這種東西不太好，下次再藏好一點吧"
    },
    {
      "Id": 100200420,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200430,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200440,
      "Speaker": "Student",
      "Text": "……嗯"
    },
    {
      "Id": 100200450,
      "Speaker": "Student",
      "Text": "老師……？"
    },
    {
      "Id": 100200460,
      "Speaker": "Student",
      "Text": "現在時間上方便嗎？"
    },
    {
      "Id": 100200470,
      "Speaker": "Student",
      "Text": "有時間吧？"
    },
    {
      "Id": 100200480,
      "Speaker": "Student",
      "Text": "反正沒事可做對吧……？"
    },
    {
      "Id": 100200490,
      "Speaker": "Player",
      "Text": "不，其實還挺忙的……"
    },
    {
      "Id": 100200500,
      "Speaker": "Player",
      "Text": "熬了一整夜沒睡，正要去睡覺……"
    },
    {
      "Id": 100200510,
      "Speaker": "Student",
      "Text": "……哼嗯嗯"
    },
    {
      "Id": 100200520,
      "Speaker": "Student",
      "Text": "總，總之"
    },
    {
      "Id": 100200530,
      "Speaker": "Student",
      "Text": "因為之前的事，希望你能來一下……"
    },
    {
      "Id": 100200540,
      "Speaker": "Player",
      "Text": "這也是監視的一環……？"
    },
    {
      "Id": 100200550,
      "Speaker": "Player",
      "Text": "偶爾換你來夏萊這邊如何？"
    },
    {
      "Id": 100200560,
      "Speaker": "Student",
      "Text": "那個，可以說是也可以說不是啦……"
    },
    {
      "Id": 100200570,
      "Speaker": "Student",
      "Text": "說，說說說什麼呢！？"
    },
    {
      "Id": 100200580,
      "Speaker": "Student",
      "Text": "你，你想誘導我也是沒用的"
    },
    {
      "Id": 100200590,
      "Speaker": "Student",
      "Text": "總之你先過來……"
    },
    {
      "Id": 100200600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "我在學校等著"
    },
    {
      "Id": 100200610,
      "Speaker": "Student",
      "Text": "老師……"
    },
    {
      "Id": 100200620,
      "Speaker": "Student",
      "Text": "……老師？"
    },
    {
      "Id": 100200630,
      "Speaker": "Student",
      "Text": "剛"
    },
    {
      "Id": 100200640,
      "Speaker": "Student",
      "Text": "剛才的……那個……"
    },
    {
      "Id": 100200650,
      "Speaker": "Student",
      "Text": "……？"
    },
    {
      "Id": 100200660,
      "Speaker": "Student",
      "Text": "……老師？"
    },
    {
      "Id": 100200670,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100200680,
      "Speaker": "Student",
      "Text": "……已經睡了嗎？"
    }
  ]
