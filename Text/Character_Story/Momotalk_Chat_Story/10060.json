{
  "CharacterId": 10060,
  "DialogJP": [
    {
      "Id": 100600010,
      "Speaker": "Student",
      "Text": "！"
    },
    {
      "Id": 100600020,
      "Speaker": "Student",
      "Text": "先生！！！！！！！！！！！"
    },
    {
      "Id": 100600030,
      "Speaker": "Player",
      "Text": "メグ、どうしたの？"
    },
    {
      "Id": 100600040,
      "Speaker": "Player",
      "Text": "何かあったの！？"
    },
    {
      "Id": 100600050,
      "Speaker": "Student",
      "Text": "えっとね"
    },
    {
      "Id": 100600060,
      "Speaker": "Student",
      "Text": "今ちょっと……"
    },
    {
      "Id": 100600070,
      "Speaker": "Student",
      "Text": "大変なことになってるんだ"
    },
    {
      "Id": 100600080,
      "Speaker": "Student",
      "Text": "助けてほしいの！"
    },
    {
      "Id": 100600090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "へるぷ・み～！"
    },
    {
      "Id": 100600100,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 100600110,
      "Speaker": "Student",
      "Text": "今日は本当にありがとう！"
    },
    {
      "Id": 100600120,
      "Speaker": "Student",
      "Text": "また今度、一緒に食べよ？"
    },
    {
      "Id": 100600130,
      "Speaker": "Student",
      "Text": "約束だからね～！"
    },
    {
      "Id": 100600140,
      "Speaker": "Student",
      "Text": "ううっ"
    },
    {
      "Id": 100600150,
      "Speaker": "Student",
      "Text": "つらい……"
    },
    {
      "Id": 100600160,
      "Speaker": "Student",
      "Text": "先生……つらいよぉ"
    },
    {
      "Id": 100600170,
      "Speaker": "Player",
      "Text": "メグ！？"
    },
    {
      "Id": 100600180,
      "Speaker": "Player",
      "Text": "どうしたの！？"
    },
    {
      "Id": 100600190,
      "Speaker": "Student",
      "Text": "今、一人なんだ……"
    },
    {
      "Id": 100600200,
      "Speaker": "Student",
      "Text": "どうしよう……"
    },
    {
      "Id": 100600210,
      "Speaker": "Student",
      "Text": "先生の知恵が必要なの！"
    },
    {
      "Id": 100600220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "助けてくれる……？"
    },
    {
      "Id": 100600230,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100600240,
      "Speaker": "Student",
      "Text": "怒られちゃった……"
    },
    {
      "Id": 100600250,
      "Speaker": "Player",
      "Text": "そんな気がしてたよ"
    },
    {
      "Id": 100600260,
      "Speaker": "Player",
      "Text": "何度も携帯が鳴ってたからね……"
    },
    {
      "Id": 100600270,
      "Speaker": "Student",
      "Text": "あははっ"
    },
    {
      "Id": 100600280,
      "Speaker": "Student",
      "Text": "でも大丈夫！楽しかったから、それで良し！"
    },
    {
      "Id": 100600290,
      "Speaker": "Student",
      "Text": "また一緒に遊ぼうね、先生！"
    },
    {
      "Id": 100600300,
      "Speaker": "Student",
      "Text": "ばいば～い！！"
    },
    {
      "Id": 100600310,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 100600320,
      "Speaker": "Student",
      "Text": "話は聞いたよ！"
    },
    {
      "Id": 100600330,
      "Speaker": "Student",
      "Text": "お湯が出なくなっちゃったんだって？そしたら冷たいシャワー浴びてるの？"
    },
    {
      "Id": 100600340,
      "Speaker": "Player",
      "Text": "そうなんだよね……"
    },
    {
      "Id": 100600350,
      "Speaker": "Player",
      "Text": "給湯器が壊れちゃって……"
    },
    {
      "Id": 100600360,
      "Speaker": "Student",
      "Text": "！！！！！！！！！！"
    },
    {
      "Id": 100600370,
      "Speaker": "Student",
      "Text": "ダメだよ、先生。それじゃあ身体が休まらないんだから"
    },
    {
      "Id": 100600380,
      "Speaker": "Student",
      "Text": "こんな寒い日に冷水なんて浴びたら、風邪引いちゃう！"
    },
    {
      "Id": 100600390,
      "Speaker": "Player",
      "Text": "急に正論を……"
    },
    {
      "Id": 100600400,
      "Speaker": "Player",
      "Text": "我慢が必要な時もあるよ"
    },
    {
      "Id": 100600410,
      "Speaker": "Student",
      "Text": "も～っ！"
    },
    {
      "Id": 100600420,
      "Speaker": "Student",
      "Text": "仕方ないな～。ここは私の出番だね！"
    },
    {
      "Id": 100600430,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 100600440,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "……メグ？"
    },
    {
      "Id": 100600450,
      "Speaker": "Student",
      "Text": "楽しかったね～！"
    },
    {
      "Id": 100600460,
      "Speaker": "Student",
      "Text": "ゴリゴリくん、ごちそうさまでした！"
    },
    {
      "Id": 100600470,
      "Speaker": "Player",
      "Text": "こちらこそありがとう、メグ"
    },
    {
      "Id": 100600480,
      "Speaker": "Player",
      "Text": "またいつでも誘ってね"
    },
    {
      "Id": 100600490,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100600500,
      "Speaker": "Student",
      "Text": "今度は温泉、一緒に入ろうね？"
    },
    {
      "Id": 100600510,
      "Speaker": "Student",
      "Text": "えへへっ！"
    },
    {
      "Id": 100600520,
      "Speaker": "Student",
      "Text": "ねねっ"
    },
    {
      "Id": 100600530,
      "Speaker": "Student",
      "Text": "先生はどんなラーメンが好き？"
    },
    {
      "Id": 100600540,
      "Speaker": "Student",
      "Text": "私はね～袋麺が好き！"
    },
    {
      "Id": 100600550,
      "Speaker": "Player",
      "Text": "私も好きだよ"
    },
    {
      "Id": 100600560,
      "Speaker": "Player",
      "Text": "袋麺、おいしいよね"
    },
    {
      "Id": 100600570,
      "Speaker": "Student",
      "Text": "わっ、ほんと？"
    },
    {
      "Id": 100600580,
      "Speaker": "Student",
      "Text": "良かった～！"
    },
    {
      "Id": 100600590,
      "Speaker": "Student",
      "Text": "今度一緒に食べよ？私が作ってあげるから！！"
    },
    {
      "Id": 100600600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "インスタントなら自信があるよ！"
    },
    {
      "Id": 100600610,
      "Speaker": "Student",
      "Text": "あ！"
    },
    {
      "Id": 100600620,
      "Speaker": "Student",
      "Text": "先生！！そういえば、うっかりしてたんだけど"
    },
    {
      "Id": 100600630,
      "Speaker": "Student",
      "Text": "ラーメンの調理器具、忘れちゃって……"
    },
    {
      "Id": 100600640,
      "Speaker": "Player",
      "Text": "いつ取りに来ても大丈夫だよ"
    },
    {
      "Id": 100600650,
      "Speaker": "Player",
      "Text": "ちゃんと洗っておいたから"
    },
    {
      "Id": 100600660,
      "Speaker": "Student",
      "Text": "！！！"
    },
    {
      "Id": 100600670,
      "Speaker": "Student",
      "Text": "流石だね、先生！"
    },
    {
      "Id": 100600680,
      "Speaker": "Student",
      "Text": "ありがと～～～！"
    },
    {
      "Id": 100600690,
      "Speaker": "Student",
      "Text": "今度取りに行くから！"
    },
    {
      "Id": 100600700,
      "Speaker": "Student",
      "Text": "その時また作ってあげるね♪"
    }
  ],
  "DialogKR": [
    {
      "Id": 100600010,
      "Speaker": "Student",
      "Text": "!"
    },
    {
      "Id": 100600020,
      "Speaker": "Student",
      "Text": "선생님!!!!!!!!!!"
    },
    {
      "Id": 100600030,
      "Speaker": "Player",
      "Text": "메구? 무슨 일이야?"
    },
    {
      "Id": 100600040,
      "Speaker": "Player",
      "Text": "굉장히 다급해 보이는 외침이네."
    },
    {
      "Id": 100600050,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 100600060,
      "Speaker": "Student",
      "Text": "지금"
    },
    {
      "Id": 100600070,
      "Speaker": "Student",
      "Text": "아주 큰일이 났어."
    },
    {
      "Id": 100600080,
      "Speaker": "Student",
      "Text": "선생님의 도움이 필요해"
    },
    {
      "Id": 100600090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "도움-!"
    },
    {
      "Id": 100600100,
      "Speaker": "Student",
      "Text": "선생님!"
    },
    {
      "Id": 100600110,
      "Speaker": "Student",
      "Text": "그래도 오늘 정말 고마웠어!"
    },
    {
      "Id": 100600120,
      "Speaker": "Student",
      "Text": "다음에 꼭 같이 더 사 먹자! 알겠지?"
    },
    {
      "Id": 100600130,
      "Speaker": "Student",
      "Text": "약속이야!!"
    },
    {
      "Id": 100600140,
      "Speaker": "Student",
      "Text": "으윽"
    },
    {
      "Id": 100600150,
      "Speaker": "Student",
      "Text": "괴로워"
    },
    {
      "Id": 100600160,
      "Speaker": "Student",
      "Text": "선생님…… 너무 괴로워"
    },
    {
      "Id": 100600170,
      "Speaker": "Player",
      "Text": "……!? 메구!?"
    },
    {
      "Id": 100600180,
      "Speaker": "Player",
      "Text": "무슨 일 있어!?"
    },
    {
      "Id": 100600190,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 100600200,
      "Speaker": "Student",
      "Text": "지혜"
    },
    {
      "Id": 100600210,
      "Speaker": "Student",
      "Text": "선생님의 지혜가 필요해"
    },
    {
      "Id": 100600220,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "도와줘, 선생님~!!"
    },
    {
      "Id": 100600230,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100600240,
      "Speaker": "Student",
      "Text": "나 혼났어"
    },
    {
      "Id": 100600250,
      "Speaker": "Player",
      "Text": "뭔가 그럴 거 같았어"
    },
    {
      "Id": 100600260,
      "Speaker": "Player",
      "Text": "연락도 안 받고 몰두했었으니……."
    },
    {
      "Id": 100600270,
      "Speaker": "Student",
      "Text": "응응"
    },
    {
      "Id": 100600280,
      "Speaker": "Student",
      "Text": "그치만 괜찮아! 재밌었으니까!"
    },
    {
      "Id": 100600290,
      "Speaker": "Student",
      "Text": "다음에 또 가르쳐줘! 선생님!!"
    },
    {
      "Id": 100600300,
      "Speaker": "Student",
      "Text": "또 보자~~!!"
    },
    {
      "Id": 100600310,
      "Speaker": "Student",
      "Text": "선생님!"
    },
    {
      "Id": 100600320,
      "Speaker": "Student",
      "Text": "선생님! 이야기는 들었어!"
    },
    {
      "Id": 100600330,
      "Speaker": "Student",
      "Text": "온수가 안 나온다고? 그럼 찬물로 씻는 거야?"
    },
    {
      "Id": 100600340,
      "Speaker": "Player",
      "Text": "으으 죽겠어, 정말~"
    },
    {
      "Id": 100600350,
      "Speaker": "Player",
      "Text": "뭐, 괜찮긴 한데"
    },
    {
      "Id": 100600360,
      "Speaker": "Student",
      "Text": "!!!!!!!!"
    },
    {
      "Id": 100600370,
      "Speaker": "Student",
      "Text": "그건 안 돼 선생님!! 온수는 중대 사안이라고!!"
    },
    {
      "Id": 100600380,
      "Speaker": "Student",
      "Text": "날도 추운데 찬물로 씻는다니!! 그러다 몸 상해!!"
    },
    {
      "Id": 100600390,
      "Speaker": "Player",
      "Text": "여기서 갑자기 정론을……?"
    },
    {
      "Id": 100600400,
      "Speaker": "Player",
      "Text": "참아야 할 때도 있는 거겠지"
    },
    {
      "Id": 100600410,
      "Speaker": "Student",
      "Text": "음!"
    },
    {
      "Id": 100600420,
      "Speaker": "Student",
      "Text": "어쩔 수 없네. 여기선 바로 내가 나설 때!!"
    },
    {
      "Id": 100600430,
      "Speaker": "Player",
      "Text": "……???"
    },
    {
      "Id": 100600440,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "……메구??"
    },
    {
      "Id": 100600450,
      "Speaker": "Student",
      "Text": "아, 재밌었다!"
    },
    {
      "Id": 100600460,
      "Speaker": "Student",
      "Text": "모리모리군, 잘 먹었습니다!"
    },
    {
      "Id": 100600470,
      "Speaker": "Player",
      "Text": "나야말로 고마워, 메구."
    },
    {
      "Id": 100600480,
      "Speaker": "Player",
      "Text": "필요하면 언제든 이야기해."
    },
    {
      "Id": 100600490,
      "Speaker": "Student",
      "Text": "!!!!"
    },
    {
      "Id": 100600500,
      "Speaker": "Student",
      "Text": "다음에는 온천같이 들어가자?"
    },
    {
      "Id": 100600510,
      "Speaker": "Student",
      "Text": "에헤헤!!"
    },
    {
      "Id": 100600520,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100600530,
      "Speaker": "Student",
      "Text": "라면 좋아해?"
    },
    {
      "Id": 100600540,
      "Speaker": "Student",
      "Text": "끓여 먹는 냄비 라면이라든가"
    },
    {
      "Id": 100600550,
      "Speaker": "Player",
      "Text": "물론 좋아하지. 근데 왜?"
    },
    {
      "Id": 100600560,
      "Speaker": "Player",
      "Text": "일하다 보면 자주 먹긴 하지."
    },
    {
      "Id": 100600570,
      "Speaker": "Student",
      "Text": "흐음~!"
    },
    {
      "Id": 100600580,
      "Speaker": "Student",
      "Text": "나는 엄청 좋아하는데"
    },
    {
      "Id": 100600590,
      "Speaker": "Student",
      "Text": "괜찮으면 나중에 같이 먹을래? 내가 끓여 줄게!!"
    },
    {
      "Id": 100600600,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "나름 자신 있다고!"
    },
    {
      "Id": 100600610,
      "Speaker": "Student",
      "Text": "아!"
    },
    {
      "Id": 100600620,
      "Speaker": "Student",
      "Text": "선생님!! 그러고 보니 깜빡했는데"
    },
    {
      "Id": 100600630,
      "Speaker": "Student",
      "Text": "라면 끓이는 도구들"
    },
    {
      "Id": 100600640,
      "Speaker": "Player",
      "Text": "챙겨 놨으니 나중에 받으러 와."
    },
    {
      "Id": 100600650,
      "Speaker": "Player",
      "Text": "잘 정리해 놨어. 걱정하지 마."
    },
    {
      "Id": 100600660,
      "Speaker": "Student",
      "Text": "!!!"
    },
    {
      "Id": 100600670,
      "Speaker": "Student",
      "Text": "역시 선생님이야!!"
    },
    {
      "Id": 100600680,
      "Speaker": "Student",
      "Text": "고마워!!"
    },
    {
      "Id": 100600690,
      "Speaker": "Student",
      "Text": "다음에 받으러 갈게!!"
    },
    {
      "Id": 100600700,
      "Speaker": "Student",
      "Text": "그때 또 끓여 줄게!!"
    }
  ],
