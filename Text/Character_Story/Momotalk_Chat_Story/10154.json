{
  "CharacterId": 10154,
  "DialogJP": [
    {
      "Id": 101540010,
      "Speaker": "Student",
      "Text": "お世話になっております"
    },
    {
      "Id": 101540020,
      "Speaker": "Student",
      "Text": "先生との交流は、シャーレとの交流"
    },
    {
      "Id": 101540030,
      "Speaker": "Student",
      "Text": "実に楽しみです"
    },
    {
      "Id": 101540040,
      "Speaker": "Player",
      "Text": "ちょっと身構えちゃうな"
    },
    {
      "Id": 101540050,
      "Speaker": "Student",
      "Text": "ふふっ"
    },
    {
      "Id": 101540060,
      "Speaker": "Student",
      "Text": "文字通りの意味ですよ？"
    },
    {
      "Id": 101540070,
      "Speaker": "Student",
      "Text": "ただ、楽しみなだけ"
    },
    {
      "Id": 101540080,
      "Speaker": "Student",
      "Text": "他意はありません"
    },
    {
      "Id": 101540090,
      "Speaker": "Student",
      "Text": "本・当・です"
    },
    {
      "Id": 101540100,
      "Speaker": "Student",
      "Text": "何か誤解を？"
    },
    {
      "Id": 101540110,
      "Speaker": "Player",
      "Text": "いやいや、気になっただけだよ"
    },
    {
      "Id": 101540120,
      "Speaker": "Student",
      "Text": "そうでしたか"
    },
    {
      "Id": 101540130,
      "Speaker": "Student",
      "Text": "ではまた後ほど、お約束の場所で"
    },
    {
      "Id": 101540140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "楽しく芸術を語らいましょう"
    },
    {
      "Id": 101540150,
      "Speaker": "Student",
      "Text": "先生、シャーレに到着されましたか？"
    },
    {
      "Id": 101540160,
      "Speaker": "Student",
      "Text": "本日はとても楽しい交流でした"
    },
    {
      "Id": 101540170,
      "Speaker": "Student",
      "Text": "すでに次回が待ち遠しいくらいに"
    },
    {
      "Id": 101540180,
      "Speaker": "Student",
      "Text": "ええ、実に楽しみです"
    },
    {
      "Id": 101540190,
      "Speaker": "Player",
      "Text": "言葉通りなんだよね？"
    },
    {
      "Id": 101540200,
      "Speaker": "Student",
      "Text": "もちろん"
    },
    {
      "Id": 101540210,
      "Speaker": "Student",
      "Text": "私は決して悩んではいませんから"
    },
    {
      "Id": 101540220,
      "Speaker": "Student",
      "Text": "あまりにも怪しい噂の多い先生を"
    },
    {
      "Id": 101540230,
      "Speaker": "Student",
      "Text": "信用していいものか否か"
    },
    {
      "Id": 101540240,
      "Speaker": "Player",
      "Text": "期待に応えられるよう頑張るよ……"
    },
    {
      "Id": 101540250,
      "Speaker": "Student",
      "Text": "引き続きよろしくお願いいたします"
    },
    {
      "Id": 101540260,
      "Speaker": "Student",
      "Text": "お世話になっております"
    },
    {
      "Id": 101540270,
      "Speaker": "Student",
      "Text": "一点、ご相談がありまして"
    },
    {
      "Id": 101540280,
      "Speaker": "Student",
      "Text": "芸術品の展示についてなのですが"
    },
    {
      "Id": 101540290,
      "Speaker": "Student",
      "Text": "お時間よろしいでしょうか？"
    },
    {
      "Id": 101540300,
      "Speaker": "Player",
      "Text": "もちろん、なんでも言って"
    },
    {
      "Id": 101540310,
      "Speaker": "Student",
      "Text": "なんでも？"
    },
    {
      "Id": 101540320,
      "Speaker": "Student",
      "Text": "なんでも……"
    },
    {
      "Id": 101540330,
      "Speaker": "Student",
      "Text": "なるほど"
    },
    {
      "Id": 101540340,
      "Speaker": "Student",
      "Text": "こうして生徒の懐に入るのですね"
    },
    {
      "Id": 101540350,
      "Speaker": "Player",
      "Text": "何の話？"
    },
    {
      "Id": 101540360,
      "Speaker": "Student",
      "Text": "お構いなく"
    },
    {
      "Id": 101540370,
      "Speaker": "Student",
      "Text": "スケジュールを組んでおきますので"
    },
    {
      "Id": 101540380,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "詳しいことは、その時に"
    },
    {
      "Id": 101540390,
      "Speaker": "Student",
      "Text": "お世話になっております"
    },
    {
      "Id": 101540400,
      "Speaker": "Student",
      "Text": "本日は快晴ですね"
    },
    {
      "Id": 101540410,
      "Speaker": "Student",
      "Text": "何をするにも望ましい日ですが"
    },
    {
      "Id": 101540420,
      "Speaker": "Student",
      "Text": "このような日の「疲労解消法」といえば？"
    },
    {
      "Id": 101540430,
      "Speaker": "Player",
      "Text": "近くを散歩するとか？"
    },
    {
      "Id": 101540440,
      "Speaker": "Student",
      "Text": "思いのほか健全ですね"
    },
    {
      "Id": 101540450,
      "Speaker": "Student",
      "Text": "先生なら秘蔵のコレクションを……"
    },
    {
      "Id": 101540460,
      "Speaker": "Student",
      "Text": "あら、失礼"
    },
    {
      "Id": 101540470,
      "Speaker": "Student",
      "Text": "これは秘密なのでしたね"
    },
    {
      "Id": 101540480,
      "Speaker": "Player",
      "Text": "分からないけど、誤解だと思うな……"
    },
    {
      "Id": 101540490,
      "Speaker": "Student",
      "Text": "真実やいかに"
    },
    {
      "Id": 101540500,
      "Speaker": "Student",
      "Text": "話は逸れましたが、参考になりました"
    },
    {
      "Id": 101540510,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "それでは本日も平和に過ごせますように"
    },
    {
      "Id": 101540520,
      "Speaker": "Student",
      "Text": "どうです、気分転換になりましたか？"
    },
    {
      "Id": 101540530,
      "Speaker": "Student",
      "Text": "私は、とても楽しい時間でした"
    },
    {
      "Id": 101540540,
      "Speaker": "Student",
      "Text": "まさか先生にあんな秘密があるなんて"
    },
    {
      "Id": 101540550,
      "Speaker": "Student",
      "Text": "少々驚きました"
    },
    {
      "Id": 101540560,
      "Speaker": "Student",
      "Text": "ですがご安心を"
    },
    {
      "Id": 101540570,
      "Speaker": "Student",
      "Text": "秘密の共有は二人だけのモノ"
    },
    {
      "Id": 101540580,
      "Speaker": "Student",
      "Text": "絶対に"
    },
    {
      "Id": 101540590,
      "Speaker": "Student",
      "Text": "絶対に言いふらしません"
    },
    {
      "Id": 101540600,
      "Speaker": "Player",
      "Text": "なんのこと！？"
    },
    {
      "Id": 101540610,
      "Speaker": "Student",
      "Text": "あらあら"
    },
    {
      "Id": 101540620,
      "Speaker": "Student",
      "Text": "偶然を装って一緒にお出かけして"
    },
    {
      "Id": 101540630,
      "Speaker": "Student",
      "Text": "あんなに特別な話をしたのに"
    },
    {
      "Id": 101540640,
      "Speaker": "Student",
      "Text": "先生も、ずいぶんズルい人ですね"
    },
    {
      "Id": 101540650,
      "Speaker": "Player",
      "Text": "自己紹介の時間ですか！？"
    },
    {
      "Id": 101540660,
      "Speaker": "Student",
      "Text": "ふふっ、先生の反応はいつも面白いですね"
    },
    {
      "Id": 101540670,
      "Speaker": "Student",
      "Text": "では、また楽しいお話をしましょう"
    },
    {
      "Id": 101540680,
      "Speaker": "Student",
      "Text": "残された今日も有意義なものとなりますように"
    },
    {
      "Id": 101540690,
      "Speaker": "Student",
      "Text": "お時間よろしいでしょうか？"
    },
    {
      "Id": 101540700,
      "Speaker": "Student",
      "Text": "頼み事ばかりですが"
    },
    {
      "Id": 101540710,
      "Speaker": "Student",
      "Text": "先生の協力が必要でして"
    },
    {
      "Id": 101540720,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 101540730,
      "Speaker": "Student",
      "Text": "今回は評議会からの正式な依頼です"
    },
    {
      "Id": 101540740,
      "Speaker": "Student",
      "Text": "以前お話しした10年前の盗難事件"
    },
    {
      "Id": 101540750,
      "Speaker": "Student",
      "Text": "その手がかりをつかみました"
    },
    {
      "Id": 101540760,
      "Speaker": "Player",
      "Text": "すぐ行くね！"
    },
    {
      "Id": 101540770,
      "Speaker": "Student",
      "Text": "感謝します"
    },
    {
      "Id": 101540780,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "それでは、現場でお待ちしております"
    },
    {
      "Id": 101540790,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101540800,
      "Speaker": "Student",
      "Text": "これで先生と私は"
    },
    {
      "Id": 101540810,
      "Speaker": "Student",
      "Text": "一夜を共にした関係になりましたね"
    },
    {
      "Id": 101540820,
      "Speaker": "Player",
      "Text": "言い方！"
    },
    {
      "Id": 101540830,
      "Speaker": "Student",
      "Text": "無駄ですよ"
    },
    {
      "Id": 101540840,
      "Speaker": "Student",
      "Text": "物的証拠もありますから"
    },
    {
      "Id": 101540850,
      "Speaker": "Student",
      "Text": "先生の入退出記録です"
    },
    {
      "Id": 101540860,
      "Speaker": "Student",
      "Text": "私たちが評議会室で作った思い出"
    },
    {
      "Id": 101540870,
      "Speaker": "Student",
      "Text": "まさか否定なさるおつもりで？"
    },
    {
      "Id": 101540880,
      "Speaker": "Player",
      "Text": "くっ……！"
    },
    {
      "Id": 101540890,
      "Speaker": "Student",
      "Text": "ふふっ、これで切り札ができました"
    },
    {
      "Id": 101540900,
      "Speaker": "Student",
      "Text": "ひどいなんて言わないでくださいね"
    },
    {
      "Id": 101540910,
      "Speaker": "Student",
      "Text": "全て先生が望んだことではありませんか"
    },
    {
      "Id": 101540920,
      "Speaker": "Student",
      "Text": "私は、帰るよう促したというのに"
    },
    {
      "Id": 101540930,
      "Speaker": "Player",
      "Text": "そうだけど……！"
    },
    {
      "Id": 101540940,
      "Speaker": "Student",
      "Text": "ふふっ"
    },
    {
      "Id": 101540950,
      "Speaker": "Student",
      "Text": "このくらいで勘弁して差し上げましょう"
    },
    {
      "Id": 101540960,
      "Speaker": "Student",
      "Text": "では、今後ともよろしくお願いいたします"
    }
  ],
  "DialogKR": [
    {
      "Id": 101540010,
      "Speaker": "Student",
      "Text": "선생님. 안녕하십니까?"
    },
    {
      "Id": 101540020,
      "Speaker": "Student",
      "Text": "샬레와 정식 교류라니."
    },
    {
      "Id": 101540030,
      "Speaker": "Student",
      "Text": "여러 가지 의미로 기대되네요."
    },
    {
      "Id": 101540040,
      "Speaker": "Player",
      "Text": "여러 가지 의미?"
    },
    {
      "Id": 101540050,
      "Speaker": "Student",
      "Text": "후후."
    },
    {
      "Id": 101540060,
      "Speaker": "Student",
      "Text": "정말로 기대가 된다는 뜻이랍니다."
    },
    {
      "Id": 101540070,
      "Speaker": "Student",
      "Text": "별다른 의미는 없어요."
    },
    {
      "Id": 101540080,
      "Speaker": "Student",
      "Text": "네."
    },
    {
      "Id": 101540090,
      "Speaker": "Student",
      "Text": "정. 말. 로. 요."
    },
    {
      "Id": 101540100,
      "Speaker": "Student",
      "Text": "혹시 제 말을 오해하신 걸까요?"
    },
    {
      "Id": 101540110,
      "Speaker": "Player",
      "Text": "아니야! 난 그냥 궁금해서!"
    },
    {
      "Id": 101540120,
      "Speaker": "Student",
      "Text": "네. 다행이네요."
    },
    {
      "Id": 101540130,
      "Speaker": "Student",
      "Text": "그럼 오늘 약속 장소에서 뵙겠습니다."
    },
    {
      "Id": 101540140,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "즐겁게 감각의 예술을 논하죠."
    },
    {
      "Id": 101540150,
      "Speaker": "Student",
      "Text": "선생님. 잘 돌아가셨는지요?"
    },
    {
      "Id": 101540160,
      "Speaker": "Student",
      "Text": "오늘은 정말 즐거운 시간이었습니다."
    },
    {
      "Id": 101540170,
      "Speaker": "Student",
      "Text": "다음에 있을 교류도 기대되네요."
    },
    {
      "Id": 101540180,
      "Speaker": "Student",
      "Text": "긍정적인 의미로요."
    },
    {
      "Id": 101540190,
      "Speaker": "Player",
      "Text": "긍정적인 의미……?"
    },
    {
      "Id": 101540200,
      "Speaker": "Student",
      "Text": "후후, 다른 의미는 없답니다."
    },
    {
      "Id": 101540210,
      "Speaker": "Student",
      "Text": "정말 기대한다는 뜻이었어요."
    },
    {
      "Id": 101540220,
      "Speaker": "Student",
      "Text": "저는 절대로 수상한 소문이 가득한 선생님을"
    },
    {
      "Id": 101540230,
      "Speaker": "Student",
      "Text": "신용해도 될지 고민한 적은 없었으니까요."
    },
    {
      "Id": 101540240,
      "Speaker": "Player",
      "Text": "항상 기대에 부합하도록 하겠습니다!"
    },
    {
      "Id": 101540250,
      "Speaker": "Student",
      "Text": "네. 그럼 앞으로도 잘 부탁드리겠습니다."
    },
    {
      "Id": 101540260,
      "Speaker": "Student",
      "Text": "선생님. 좋은 하루입니다."
    },
    {
      "Id": 101540270,
      "Speaker": "Student",
      "Text": "조금 갑작스럽습니다만"
    },
    {
      "Id": 101540280,
      "Speaker": "Student",
      "Text": "예술품 전시 관련으로 상의드릴 게 있습니다."
    },
    {
      "Id": 101540290,
      "Speaker": "Student",
      "Text": "괜찮으신지요?"
    },
    {
      "Id": 101540300,
      "Speaker": "Player",
      "Text": "응. 뭐든 말해줘."
    },
    {
      "Id": 101540310,
      "Speaker": "Student",
      "Text": "뭐든?"
    },
    {
      "Id": 101540320,
      "Speaker": "Student",
      "Text": "뭐든 말입니까?"
    },
    {
      "Id": 101540330,
      "Speaker": "Student",
      "Text": "흠, 과연."
    },
    {
      "Id": 101540340,
      "Speaker": "Student",
      "Text": "이렇게 학생들의 호감을 샀던 거군요."
    },
    {
      "Id": 101540350,
      "Speaker": "Player",
      "Text": "무, 무슨 이야기야?"
    },
    {
      "Id": 101540360,
      "Speaker": "Student",
      "Text": "아무튼 괜찮다고 하시니"
    },
    {
      "Id": 101540370,
      "Speaker": "Student",
      "Text": "곧 일정을 잡아보도록 하겠습니다."
    },
    {
      "Id": 101540380,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "자세한 건 그때 이야기하죠."
    },
    {
      "Id": 101540390,
      "Speaker": "Student",
      "Text": "선생님. 안녕하십니까?"
    },
    {
      "Id": 101540400,
      "Speaker": "Student",
      "Text": "오늘은 날씨가 매우 좋군요."
    },
    {
      "Id": 101540410,
      "Speaker": "Student",
      "Text": "선생님은 오늘 같은 날 피로가 쌓이면"
    },
    {
      "Id": 101540420,
      "Speaker": "Student",
      "Text": "어떤 식으로 해결하시나요?"
    },
    {
      "Id": 101540430,
      "Speaker": "Player",
      "Text": "가볍게 사무실 근처를 산책해."
    },
    {
      "Id": 101540440,
      "Speaker": "Student",
      "Text": "생각보다 건전한 방법이군요."
    },
    {
      "Id": 101540450,
      "Speaker": "Student",
      "Text": "선생님이라면 몰래 숨겨둔 학생들의……"
    },
    {
      "Id": 101540460,
      "Speaker": "Student",
      "Text": "아. 실례."
    },
    {
      "Id": 101540470,
      "Speaker": "Student",
      "Text": "이건 선생님의 비밀이었죠?"
    },
    {
      "Id": 101540480,
      "Speaker": "Player",
      "Text": "뭔진 몰라도 아냐!"
    },
    {
      "Id": 101540490,
      "Speaker": "Student",
      "Text": "후후, 정말로요?"
    },
    {
      "Id": 101540500,
      "Speaker": "Student",
      "Text": "아무튼 참고가 되었습니다."
    },
    {
      "Id": 101540510,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "부디 평안한 하루 되시길."
    },
    {
      "Id": 101540520,
      "Speaker": "Student",
      "Text": "선생님. 기분 전환은 잘 되었는지요?"
    },
    {
      "Id": 101540530,
      "Speaker": "Student",
      "Text": "오늘은 정말 즐거운 시간이었습니다."
    },
    {
      "Id": 101540540,
      "Speaker": "Student",
      "Text": "선생님에게 그런 비밀이 있다니……."
    },
    {
      "Id": 101540550,
      "Speaker": "Student",
      "Text": "솔직히 조금 놀랐어요."
    },
    {
      "Id": 101540560,
      "Speaker": "Student",
      "Text": "하지만 안심하시길."
    },
    {
      "Id": 101540570,
      "Speaker": "Student",
      "Text": "절대로."
    },
    {
      "Id": 101540580,
      "Speaker": "Student",
      "Text": "절대로 절대로."
    },
    {
      "Id": 101540590,
      "Speaker": "Student",
      "Text": "그 누구에게도 발설하지 않겠어요."
    },
    {
      "Id": 101540600,
      "Speaker": "Player",
      "Text": "도대체 무슨 비밀을 말하는 건데?!"
    },
    {
      "Id": 101540610,
      "Speaker": "Student",
      "Text": "어머나."
    },
    {
      "Id": 101540620,
      "Speaker": "Student",
      "Text": "우연을 가장해 함께 외출한 뒤"
    },
    {
      "Id": 101540630,
      "Speaker": "Student",
      "Text": "그렇게나 특별한 말씀을 하셔 놓곤……"
    },
    {
      "Id": 101540640,
      "Speaker": "Student",
      "Text": "선생님도 참 음험한 사람이네요."
    },
    {
      "Id": 101540650,
      "Speaker": "Player",
      "Text": "자기소개 시간입니까?!"
    },
    {
      "Id": 101540660,
      "Speaker": "Student",
      "Text": "후후, 항상 반응이 재미있으시네요."
    },
    {
      "Id": 101540670,
      "Speaker": "Student",
      "Text": "그럼, 다음에도 또 즐겁게 이야기를 나누죠."
    },
    {
      "Id": 101540680,
      "Speaker": "Student",
      "Text": "남은 하루, 부디 잘 마무리하시길."
    },
    {
      "Id": 101540690,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101540700,
      "Speaker": "Student",
      "Text": "이번에도 조금 갑작스럽습니다만."
    },
    {
      "Id": 101540710,
      "Speaker": "Student",
      "Text": "선생님의 협조가 필요합니다."
    },
    {
      "Id": 101540720,
      "Speaker": "Player",
      "Text": "어떤 일이야?"
    },
    {
      "Id": 101540730,
      "Speaker": "Student",
      "Text": "이번엔 우리 평의회의 공식 요청입니다."
    },
    {
      "Id": 101540740,
      "Speaker": "Student",
      "Text": "미제로 남았던 10년 전 도난 사건."
    },
    {
      "Id": 101540750,
      "Speaker": "Student",
      "Text": "그 사건의 단서를 잡았어요."
    },
    {
      "Id": 101540760,
      "Speaker": "Player",
      "Text": "바로 갈게!"
    },
    {
      "Id": 101540770,
      "Speaker": "Student",
      "Text": "감사합니다."
    },
    {
      "Id": 101540780,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "그럼 현장에서 뵙죠."
    },
    {
      "Id": 101540790,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101540800,
      "Speaker": "Student",
      "Text": "이걸로 선생님과 저는"
    },
    {
      "Id": 101540810,
      "Speaker": "Student",
      "Text": "함께 밤을 보낸 사이가 됐군요."
    },
    {
      "Id": 101540820,
      "Speaker": "Player",
      "Text": "무슨 소리야?!"
    },
    {
      "Id": 101540830,
      "Speaker": "Student",
      "Text": "모르는 척해도 소용없답니다."
    },
    {
      "Id": 101540840,
      "Speaker": "Student",
      "Text": "물증도 있으니까요."
    },
    {
      "Id": 101540850,
      "Speaker": "Student",
      "Text": "바로 선생님의 출입 기록이죠."
    },
    {
      "Id": 101540860,
      "Speaker": "Student",
      "Text": "단둘이 평의회실에서 만든 추억들……."
    },
    {
      "Id": 101540870,
      "Speaker": "Student",
      "Text": "설마 부정하진 않으시겠죠?"
    },
    {
      "Id": 101540880,
      "Speaker": "Player",
      "Text": "큿……!"
    },
    {
      "Id": 101540890,
      "Speaker": "Student",
      "Text": "후후, 이걸로 선생님의 약점을 잡았군요."
    },
    {
      "Id": 101540900,
      "Speaker": "Student",
      "Text": "너무하다고 말씀하진 마세요."
    },
    {
      "Id": 101540910,
      "Speaker": "Student",
      "Text": "모두 선생님이 원해서 했던 거잖아요?"
    },
    {
      "Id": 101540920,
      "Speaker": "Student",
      "Text": "저는 돌아가시라고 재촉했는데 말이에요."
    },
    {
      "Id": 101540930,
      "Speaker": "Player",
      "Text": "그, 그렇긴 한데……!"
    },
    {
      "Id": 101540940,
      "Speaker": "Student",
      "Text": "후후……."
    },
    {
      "Id": 101540950,
      "Speaker": "Student",
      "Text": "이 정도에서 넘어가도록 하죠."
    },
    {
      "Id": 101540960,
      "Speaker": "Student",
      "Text": "그럼 앞으로도 잘 부탁드립니다."
    }
  ],
