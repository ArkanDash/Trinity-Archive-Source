{
  "CharacterId": 20061,
  "DialogJP": [
    {
      "Id": 200610010,
      "Speaker": "Student",
      "Text": "んむ！！"
    },
    {
      "Id": 200610020,
      "Speaker": "Student",
      "Text": "んむむっ！！！"
    },
    {
      "Id": 200610030,
      "Speaker": "Student",
      "Text": "むむむむむ～っ！！！！"
    },
    {
      "Id": 200610040,
      "Speaker": "Player",
      "Text": "見たことあるパターンだ……"
    },
    {
      "Id": 200610050,
      "Speaker": "Player",
      "Text": "何かお困り？"
    },
    {
      "Id": 200610060,
      "Speaker": "Student",
      "Text": "さすがは先生"
    },
    {
      "Id": 200610070,
      "Speaker": "Student",
      "Text": "察しが良くて助かる！"
    },
    {
      "Id": 200610080,
      "Speaker": "Student",
      "Text": "そうだな――まずは"
    },
    {
      "Id": 200610090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "会って話すとしようか？"
    },
    {
      "Id": 200610100,
      "Speaker": "Student",
      "Text": "おかげで買い物がはかどった"
    },
    {
      "Id": 200610110,
      "Speaker": "Student",
      "Text": "感謝する"
    },
    {
      "Id": 200610120,
      "Speaker": "Player",
      "Text": "たい焼きと一緒に封筒が入ってたよ"
    },
    {
      "Id": 200610130,
      "Speaker": "Player",
      "Text": "これはカスミの？"
    },
    {
      "Id": 200610140,
      "Speaker": "Student",
      "Text": "ああ"
    },
    {
      "Id": 200610150,
      "Speaker": "Student",
      "Text": "それはちょっとした手間賃さ"
    },
    {
      "Id": 200610160,
      "Speaker": "Student",
      "Text": "とっておくといい"
    },
    {
      "Id": 200610170,
      "Speaker": "Player",
      "Text": "返しに行くよ"
    },
    {
      "Id": 200610180,
      "Speaker": "Player",
      "Text": "今どこ？"
    },
    {
      "Id": 200610190,
      "Speaker": "Student",
      "Text": "遠慮は無用だ"
    },
    {
      "Id": 200610200,
      "Speaker": "Student",
      "Text": "そうせねば気が済まんのだよ"
    },
    {
      "Id": 200610210,
      "Speaker": "Player",
      "Text": "カスミ？"
    },
    {
      "Id": 200610220,
      "Speaker": "Student",
      "Text": "はぁ……"
    },
    {
      "Id": 200610230,
      "Speaker": "Student",
      "Text": "分かった"
    },
    {
      "Id": 200610240,
      "Speaker": "Student",
      "Text": "分かったとも"
    },
    {
      "Id": 200610250,
      "Speaker": "Student",
      "Text": "予定は空いているかね？"
    },
    {
      "Id": 200610260,
      "Speaker": "Student",
      "Text": "前に旅行の準備を手伝ってくれただろう？"
    },
    {
      "Id": 200610270,
      "Speaker": "Student",
      "Text": "今日がその日なんだ"
    },
    {
      "Id": 200610280,
      "Speaker": "Student",
      "Text": "世話になりっぱなしという訳にもいかないのでな"
    },
    {
      "Id": 200610290,
      "Speaker": "Student",
      "Text": "先生をゲストとして招待しよう"
    },
    {
      "Id": 200610300,
      "Speaker": "Player",
      "Text": "私が混ざっていいの？"
    },
    {
      "Id": 200610310,
      "Speaker": "Player",
      "Text": "部活の旅行じゃなかった？"
    },
    {
      "Id": 200610320,
      "Speaker": "Student",
      "Text": "先生なら大歓迎だとも"
    },
    {
      "Id": 200610330,
      "Speaker": "Student",
      "Text": "この話を聞いて"
    },
    {
      "Id": 200610340,
      "Speaker": "Student",
      "Text": "部員は舞い上がっているぞ"
    },
    {
      "Id": 200610350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "これでもしも来なかったらどうなることやら……"
    },
    {
      "Id": 200610360,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200610370,
      "Speaker": "Student",
      "Text": "ちゃんと帰れたか？"
    },
    {
      "Id": 200610380,
      "Speaker": "Player",
      "Text": "すごく怒られました"
    },
    {
      "Id": 200610390,
      "Speaker": "Player",
      "Text": "なんとかね"
    },
    {
      "Id": 200610400,
      "Speaker": "Student",
      "Text": "巻き込んでしまってすまなかった"
    },
    {
      "Id": 200610410,
      "Speaker": "Student",
      "Text": "借りを返すつもりが増えてしまったな"
    },
    {
      "Id": 200610420,
      "Speaker": "Student",
      "Text": "この埋め合わせは改めて必ず"
    },
    {
      "Id": 200610430,
      "Speaker": "Student",
      "Text": "んむ"
    },
    {
      "Id": 200610440,
      "Speaker": "Student",
      "Text": "困ったな"
    },
    {
      "Id": 200610450,
      "Speaker": "Student",
      "Text": "こんなつもりではなかったのだが"
    },
    {
      "Id": 200610460,
      "Speaker": "Player",
      "Text": "このパターンにも慣れてきたよ"
    },
    {
      "Id": 200610470,
      "Speaker": "Player",
      "Text": "何か手伝おうか？"
    },
    {
      "Id": 200610480,
      "Speaker": "Student",
      "Text": "話が早くて助かるよ"
    },
    {
      "Id": 200610490,
      "Speaker": "Student",
      "Text": "今回は風紀委員会が相当にお冠のようでな"
    },
    {
      "Id": 200610500,
      "Speaker": "Student",
      "Text": "出歩くのすら難しいんだ"
    },
    {
      "Id": 200610510,
      "Speaker": "Player",
      "Text": "私が付き添ってたら安心ってこと？"
    },
    {
      "Id": 200610520,
      "Speaker": "Player",
      "Text": "いいよ、一緒に出かけよっか！"
    },
    {
      "Id": 200610530,
      "Speaker": "Student",
      "Text": "まあ先生がよければの話だ"
    },
    {
      "Id": 200610540,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "居場所は送っておくから、気が向いたら来てくれ"
    },
    {
      "Id": 200610550,
      "Speaker": "Student",
      "Text": "ちゃんと帰れたか？"
    },
    {
      "Id": 200610560,
      "Speaker": "Student",
      "Text": "この辺りは物騒だからな"
    },
    {
      "Id": 200610570,
      "Speaker": "Player",
      "Text": "風紀委員会がいない場所ばっかり行ったけど"
    },
    {
      "Id": 200610580,
      "Speaker": "Player",
      "Text": "私が一緒に行く必要あったかな？"
    },
    {
      "Id": 200610590,
      "Speaker": "Student",
      "Text": "む？"
    },
    {
      "Id": 200610600,
      "Speaker": "Student",
      "Text": "当然さ"
    },
    {
      "Id": 200610610,
      "Speaker": "Student",
      "Text": "それともなにか"
    },
    {
      "Id": 200610620,
      "Speaker": "Student",
      "Text": "先生と一緒にいる口実だったとでも？"
    },
    {
      "Id": 200610630,
      "Speaker": "Student",
      "Text": "少しいいだろうか"
    },
    {
      "Id": 200610640,
      "Speaker": "Student",
      "Text": "お礼をするといつも言っているのに"
    },
    {
      "Id": 200610650,
      "Speaker": "Student",
      "Text": "ちゃんとできていないからな"
    },
    {
      "Id": 200610660,
      "Speaker": "Player",
      "Text": "大丈夫だよ"
    },
    {
      "Id": 200610670,
      "Speaker": "Player",
      "Text": "生徒を助けるのが仕事だからね"
    },
    {
      "Id": 200610680,
      "Speaker": "Student",
      "Text": "私が大丈夫じゃないんだ"
    },
    {
      "Id": 200610690,
      "Speaker": "Student",
      "Text": "いつも言っているだろう？"
    },
    {
      "Id": 200610700,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "借りを作るのは嫌だと"
    },
    {
      "Id": 200610710,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200610720,
      "Speaker": "Student",
      "Text": "本当にすまない"
    },
    {
      "Id": 200610730,
      "Speaker": "Student",
      "Text": "忙しいだろうに勝手を言ってしまった"
    },
    {
      "Id": 200610740,
      "Speaker": "Student",
      "Text": "帰り道は特に何もなかったか？"
    },
    {
      "Id": 200610750,
      "Speaker": "Player",
      "Text": "なかったけど……"
    },
    {
      "Id": 200610760,
      "Speaker": "Player",
      "Text": "本当に大丈夫？"
    },
    {
      "Id": 200610770,
      "Speaker": "Student",
      "Text": "私のことは気にするな"
    },
    {
      "Id": 200610780,
      "Speaker": "Student",
      "Text": "また連絡する"
    },
    {
      "Id": 200610790,
      "Speaker": "Student",
      "Text": "まったく……"
    },
    {
      "Id": 200610800,
      "Speaker": "Student",
      "Text": "お礼とはこんなにも難しいものだっただろうか？"
    },
    {
      "Id": 200610810,
      "Speaker": "Student",
      "Text": "それで……"
    },
    {
      "Id": 200610820,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200610830,
      "Speaker": "Player",
      "Text": "大丈夫だよ"
    },
    {
      "Id": 200610840,
      "Speaker": "Player",
      "Text": "今日はどこで待ち合わせる？"
    },
    {
      "Id": 200610850,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "地図を送ろう"
    },
    {
      "Id": 200610860,
      "Speaker": "Student",
      "Text": "他でもない先生のことだ"
    },
    {
      "Id": 200610870,
      "Speaker": "Student",
      "Text": "万が一など無いと思っている"
    },
    {
      "Id": 200610880,
      "Speaker": "Student",
      "Text": "だから今日の話がどこからか聞こえてきたら……"
    },
    {
      "Id": 200610890,
      "Speaker": "Student",
      "Text": "まずは先生の無事を確認することだろう"
    },
    {
      "Id": 200610900,
      "Speaker": "Player",
      "Text": "怖っ！"
    },
    {
      "Id": 200610910,
      "Speaker": "Player",
      "Text": "重っ！"
    },
    {
      "Id": 200610920,
      "Speaker": "Student",
      "Text": "冗談だ"
    },
    {
      "Id": 200610930,
      "Speaker": "Student",
      "Text": "信じているからな"
    }
  ],
  "DialogKR": [
    {
      "Id": 200610010,
      "Speaker": "Student",
      "Text": "음~"
    },
    {
      "Id": 200610020,
      "Speaker": "Student",
      "Text": "으으음~~~"
    },
    {
      "Id": 200610030,
      "Speaker": "Student",
      "Text": "으으으으으음!!!!"
    },
    {
      "Id": 200610040,
      "Speaker": "Player",
      "Text": "봤던 패턴이다……."
    },
    {
      "Id": 200610050,
      "Speaker": "Player",
      "Text": "뭐 도와줄까?"
    },
    {
      "Id": 200610060,
      "Speaker": "Student",
      "Text": "역시 선생님!"
    },
    {
      "Id": 200610070,
      "Speaker": "Student",
      "Text": "말하지 않아도 알아준다니까!"
    },
    {
      "Id": 200610080,
      "Speaker": "Student",
      "Text": "일단은……."
    },
    {
      "Id": 200610090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "만나서 이야기할까?"
    },
    {
      "Id": 200610100,
      "Speaker": "Student",
      "Text": "오늘은 덕분에 살았네~"
    },
    {
      "Id": 200610110,
      "Speaker": "Student",
      "Text": "고마웠어~"
    },
    {
      "Id": 200610120,
      "Speaker": "Player",
      "Text": "붕어빵에 봉투가 끼워져 있는데."
    },
    {
      "Id": 200610130,
      "Speaker": "Player",
      "Text": "잘못 섞여온 거 같아."
    },
    {
      "Id": 200610140,
      "Speaker": "Student",
      "Text": "아."
    },
    {
      "Id": 200610150,
      "Speaker": "Student",
      "Text": "그건 거마비야."
    },
    {
      "Id": 200610160,
      "Speaker": "Student",
      "Text": "챙겨둬."
    },
    {
      "Id": 200610170,
      "Speaker": "Player",
      "Text": "지금 어디야?"
    },
    {
      "Id": 200610180,
      "Speaker": "Player",
      "Text": "만나서 돌려줄게."
    },
    {
      "Id": 200610190,
      "Speaker": "Student",
      "Text": "거참, 사양 안 해도 된다니까."
    },
    {
      "Id": 200610200,
      "Speaker": "Student",
      "Text": "내가 불편해서 그래."
    },
    {
      "Id": 200610210,
      "Speaker": "Player",
      "Text": "카스미."
    },
    {
      "Id": 200610220,
      "Speaker": "Student",
      "Text": "알겠어."
    },
    {
      "Id": 200610230,
      "Speaker": "Student",
      "Text": "알겠습니다, 선생님."
    },
    {
      "Id": 200610240,
      "Speaker": "Student",
      "Text": "됐지?"
    },
    {
      "Id": 200610250,
      "Speaker": "Student",
      "Text": "선생님~"
    },
    {
      "Id": 200610260,
      "Speaker": "Student",
      "Text": "아니, 전에 여행 준비 도와줬잖아?"
    },
    {
      "Id": 200610270,
      "Speaker": "Student",
      "Text": "실은 그게 오늘이라서."
    },
    {
      "Id": 200610280,
      "Speaker": "Student",
      "Text": "일방적으로 도움받기도 좀 그렇고."
    },
    {
      "Id": 200610290,
      "Speaker": "Student",
      "Text": "모처럼이니까 첫 손님으로 선생님을 초대할까 하는데."
    },
    {
      "Id": 200610300,
      "Speaker": "Player",
      "Text": "괜찮겠어?"
    },
    {
      "Id": 200610310,
      "Speaker": "Player",
      "Text": "부원들이랑 여행 아니야?"
    },
    {
      "Id": 200610320,
      "Speaker": "Student",
      "Text": "괜찮아, 괜찮아~"
    },
    {
      "Id": 200610330,
      "Speaker": "Student",
      "Text": "오히려 첫 손님으로 선생님이 올지 모른다고 하니까"
    },
    {
      "Id": 200610340,
      "Speaker": "Student",
      "Text": "다들 텐션이 올라가 버려서 말이야."
    },
    {
      "Id": 200610350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "이제는 안 오면 큰일이라고?"
    },
    {
      "Id": 200610360,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 200610370,
      "Speaker": "Student",
      "Text": "무사히 돌아갔어?"
    },
    {
      "Id": 200610380,
      "Speaker": "Player",
      "Text": "무지 혼났습니다."
    },
    {
      "Id": 200610390,
      "Speaker": "Player",
      "Text": "어떻게든."
    },
    {
      "Id": 200610400,
      "Speaker": "Student",
      "Text": "아니, 진짜 미안하네."
    },
    {
      "Id": 200610410,
      "Speaker": "Student",
      "Text": "빚을 갚으려다가 더 써버렸네."
    },
    {
      "Id": 200610420,
      "Speaker": "Student",
      "Text": "나중에 꼭 벌충하게 해줘."
    },
    {
      "Id": 200610430,
      "Speaker": "Student",
      "Text": "음."
    },
    {
      "Id": 200610440,
      "Speaker": "Student",
      "Text": "곤란하네."
    },
    {
      "Id": 200610450,
      "Speaker": "Student",
      "Text": "이럴 셈은 없었는데."
    },
    {
      "Id": 200610460,
      "Speaker": "Player",
      "Text": "이 패턴, 익숙해진다……!"
    },
    {
      "Id": 200610470,
      "Speaker": "Player",
      "Text": "뭘 도와줄까?"
    },
    {
      "Id": 200610480,
      "Speaker": "Student",
      "Text": "선생님, 역시 척하면 척이네!"
    },
    {
      "Id": 200610490,
      "Speaker": "Student",
      "Text": "실은, 이번에 선도부에 단단히 찍힌 모양이라."
    },
    {
      "Id": 200610500,
      "Speaker": "Student",
      "Text": "혼자서는 돌아다니지도 못하겠어."
    },
    {
      "Id": 200610510,
      "Speaker": "Player",
      "Text": "보증인이 필요한 건가."
    },
    {
      "Id": 200610520,
      "Speaker": "Player",
      "Text": "같이 외출하자!"
    },
    {
      "Id": 200610530,
      "Speaker": "Student",
      "Text": "뭐, 선생님만 괜찮다면 말이야."
    },
    {
      "Id": 200610540,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "일단, 주소는 보내둘 테니, 생각 있으면 찾아오라고."
    },
    {
      "Id": 200610550,
      "Speaker": "Student",
      "Text": "잘 돌아갔어?"
    },
    {
      "Id": 200610560,
      "Speaker": "Student",
      "Text": "이 근방은 치안이 나쁘니까 조심해서 나쁠 건 없지."
    },
    {
      "Id": 200610570,
      "Speaker": "Player",
      "Text": "근데 선도부가 없는 장소만 골라 갔는데."
    },
    {
      "Id": 200610580,
      "Speaker": "Player",
      "Text": "나랑 동행할 필요 있었어?"
    },
    {
      "Id": 200610590,
      "Speaker": "Student",
      "Text": "허."
    },
    {
      "Id": 200610600,
      "Speaker": "Student",
      "Text": "그야 당연하지."
    },
    {
      "Id": 200610610,
      "Speaker": "Student",
      "Text": "뭐, 그러면"
    },
    {
      "Id": 200610620,
      "Speaker": "Student",
      "Text": "내가 선생님이랑 둘이서 다닐 핑계라도 만들었게?"
    },
    {
      "Id": 200610630,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 200610640,
      "Speaker": "Student",
      "Text": "매번 보답을 한다고 하는데"
    },
    {
      "Id": 200610650,
      "Speaker": "Student",
      "Text": "막상 제대로 못하고 있는 거 같단 말이지."
    },
    {
      "Id": 200610660,
      "Speaker": "Player",
      "Text": "나는 괜찮은데."
    },
    {
      "Id": 200610670,
      "Speaker": "Player",
      "Text": "학생을 돕는 게 일인 걸."
    },
    {
      "Id": 200610680,
      "Speaker": "Student",
      "Text": "아니, 내가 안 괜찮아."
    },
    {
      "Id": 200610690,
      "Speaker": "Student",
      "Text": "늘 말하잖아."
    },
    {
      "Id": 200610700,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "빚지고는 못 산다고."
    },
    {
      "Id": 200610710,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 200610720,
      "Speaker": "Student",
      "Text": "오늘은 정말로 미안."
    },
    {
      "Id": 200610730,
      "Speaker": "Student",
      "Text": "바쁜 사람을 이렇게 오라 가라……."
    },
    {
      "Id": 200610740,
      "Speaker": "Student",
      "Text": "돌아가는 길에는 별 문제없었지?"
    },
    {
      "Id": 200610750,
      "Speaker": "Player",
      "Text": "응, 그렇긴 한데……."
    },
    {
      "Id": 200610760,
      "Speaker": "Player",
      "Text": "진짜 괜찮아?"
    },
    {
      "Id": 200610770,
      "Speaker": "Student",
      "Text": "나는 신경 쓰지 말고."
    },
    {
      "Id": 200610780,
      "Speaker": "Student",
      "Text": "다음에 또 연락할게."
    },
    {
      "Id": 200610790,
      "Speaker": "Student",
      "Text": "아~"
    },
    {
      "Id": 200610800,
      "Speaker": "Student",
      "Text": "참, 이게 답례 한 번이 이렇게 어렵나?"
    },
    {
      "Id": 200610810,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200610820,
      "Speaker": "Student",
      "Text": "그, 있잖아."
    },
    {
      "Id": 200610830,
      "Speaker": "Player",
      "Text": "괜찮아, 괜찮아."
    },
    {
      "Id": 200610840,
      "Speaker": "Player",
      "Text": "오늘은 어디서 만나?"
    },
    {
      "Id": 200610850,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "일단, 주소 보낼게."
    },
    {
      "Id": 200610860,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 200610870,
      "Speaker": "Student",
      "Text": "선생님이니까 만에 하나라도 그런 경우는 없다고 생각할게."
    },
    {
      "Id": 200610880,
      "Speaker": "Student",
      "Text": "하지만, 오늘 이야기가 어디선가 들려오면."
    },
    {
      "Id": 200610890,
      "Speaker": "Student",
      "Text": "……우선 선생님의 무사를 확인해야 하려나?"
    },
    {
      "Id": 200610900,
      "Speaker": "Player",
      "Text": "무셔!"
    },
    {
      "Id": 200610910,
      "Speaker": "Player",
      "Text": "무거워!"
    },
    {
      "Id": 200610920,
      "Speaker": "Student",
      "Text": "농담이야, 농담."
    },
    {
      "Id": 200610930,
      "Speaker": "Student",
      "Text": "믿으니까 한 말이니까."
    }
  ],
