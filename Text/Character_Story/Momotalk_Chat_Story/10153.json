{
  "CharacterId": 10153,
  "DialogJP": [
    {
      "Id": 101530010,
      "Speaker": "Student",
      "Text": "先生、プレゼントしたいものがありまして"
    },
    {
      "Id": 101530020,
      "Speaker": "Student",
      "Text": "ゲヘナカップコラボのペロロ様です！"
    },
    {
      "Id": 101530030,
      "Speaker": "Student",
      "Text": "運よく2個もらえたので"
    },
    {
      "Id": 101530040,
      "Speaker": "Student",
      "Text": "1個は先生に差し上げます！ (≧∇≦)v"
    },
    {
      "Id": 101530050,
      "Speaker": "Player",
      "Text": "そんなレアアイテムもらっちゃっていいの！？"
    },
    {
      "Id": 101530060,
      "Speaker": "Student",
      "Text": "もちろんです！"
    },
    {
      "Id": 101530070,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "では後ほど！"
    },
    {
      "Id": 101530080,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101530090,
      "Speaker": "Student",
      "Text": "私の勘違いかもしれないのですが"
    },
    {
      "Id": 101530100,
      "Speaker": "Student",
      "Text": "今日、なんだか視線を集めていたような……"
    },
    {
      "Id": 101530110,
      "Speaker": "Player",
      "Text": "私もなんとなく感じてたけど"
    },
    {
      "Id": 101530120,
      "Speaker": "Player",
      "Text": "気にしないでいいと思うよ"
    },
    {
      "Id": 101530130,
      "Speaker": "Student",
      "Text": "そう言われましても……"
    },
    {
      "Id": 101530140,
      "Speaker": "Student",
      "Text": "やっぱり"
    },
    {
      "Id": 101530150,
      "Speaker": "Student",
      "Text": "もっと派手にしたほうがよかったでしょうか"
    },
    {
      "Id": 101530160,
      "Speaker": "Student",
      "Text": "選手らしくなかったのかもしれません"
    },
    {
      "Id": 101530170,
      "Speaker": "Player",
      "Text": "多分そうじゃないから"
    },
    {
      "Id": 101530180,
      "Speaker": "Player",
      "Text": "今のままでいいと思うよ！"
    },
    {
      "Id": 101530190,
      "Speaker": "Student",
      "Text": "そうなんですか！？"
    },
    {
      "Id": 101530200,
      "Speaker": "Student",
      "Text": "では何が問題だったんでしょう？ ((º□º;))"
    },
    {
      "Id": 101530210,
      "Speaker": "Student",
      "Text": "こんにちは、先生！"
    },
    {
      "Id": 101530220,
      "Speaker": "Student",
      "Text": "もしよければ"
    },
    {
      "Id": 101530230,
      "Speaker": "Student",
      "Text": "このあと買い物をご一緒しませんか？"
    },
    {
      "Id": 101530240,
      "Speaker": "Player",
      "Text": "いいよ！ちょうど気分転換したかったんだ"
    },
    {
      "Id": 101530250,
      "Speaker": "Student",
      "Text": "ありがとうございます！(≧∇≦)"
    },
    {
      "Id": 101530260,
      "Speaker": "Student",
      "Text": "クルセイダーちゃんを出すので！"
    },
    {
      "Id": 101530270,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "迎えに行きます！ヾ(•ω•`)o"
    },
    {
      "Id": 101530280,
      "Speaker": "Student",
      "Text": "先生、大丈夫ですか……？"
    },
    {
      "Id": 101530290,
      "Speaker": "Student",
      "Text": "あんな運転をするつもりではなかったのですが"
    },
    {
      "Id": 101530300,
      "Speaker": "Student",
      "Text": "どうしても止めたくて、つい……"
    },
    {
      "Id": 101530310,
      "Speaker": "Player",
      "Text": "大丈夫だよ！かっこよかった！"
    },
    {
      "Id": 101530320,
      "Speaker": "Player",
      "Text": "英雄みたいだった！"
    },
    {
      "Id": 101530330,
      "Speaker": "Student",
      "Text": "そ、そこまでじゃないですよ……！"
    },
    {
      "Id": 101530340,
      "Speaker": "Student",
      "Text": "次からは安全運転しますので！"
    },
    {
      "Id": 101530350,
      "Speaker": "Student",
      "Text": "絶対に！"
    },
    {
      "Id": 101530360,
      "Speaker": "Student",
      "Text": "こんにちは、先生！"
    },
    {
      "Id": 101530370,
      "Speaker": "Student",
      "Text": "突然ですが、署名をもらえませんか？"
    },
    {
      "Id": 101530380,
      "Speaker": "Player",
      "Text": "いいけど、なんの書類？"
    },
    {
      "Id": 101530390,
      "Speaker": "Student",
      "Text": "課外活動の参加証明書です！"
    },
    {
      "Id": 101530400,
      "Speaker": "Student",
      "Text": "顧問の署名が必要みたいで"
    },
    {
      "Id": 101530410,
      "Speaker": "Student",
      "Text": "よろしければ後で伺いますね！"
    },
    {
      "Id": 101530420,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 101530430,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 101530440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "では後ほど！ (^▽^)v"
    },
    {
      "Id": 101530450,
      "Speaker": "Student",
      "Text": "先生、無事に戻られましたか？"
    },
    {
      "Id": 101530460,
      "Speaker": "Student",
      "Text": "先ほどは署名してくださり、ありがとうございます"
    },
    {
      "Id": 101530470,
      "Speaker": "Student",
      "Text": "先生には本当にお世話になってばかりですね……"
    },
    {
      "Id": 101530480,
      "Speaker": "Player",
      "Text": "気にしないで！特別なヒフミのお願いだからね！"
    },
    {
      "Id": 101530490,
      "Speaker": "Student",
      "Text": "特別だなんて……えへへ"
    },
    {
      "Id": 101530500,
      "Speaker": "Student",
      "Text": "なんだか元気が出てきました。ありがとうございます、先生！"
    },
    {
      "Id": 101530510,
      "Speaker": "Student",
      "Text": "いま、お忙しいですか？"
    },
    {
      "Id": 101530520,
      "Speaker": "Student",
      "Text": "意見を聞きたいことがありまして"
    },
    {
      "Id": 101530530,
      "Speaker": "Student",
      "Text": "ぜひお願いできると嬉しいのですが……"
    },
    {
      "Id": 101530540,
      "Speaker": "Player",
      "Text": "もちろん！任せて！"
    },
    {
      "Id": 101530550,
      "Speaker": "Player",
      "Text": "最優先で手伝うよ！"
    },
    {
      "Id": 101530560,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 101530570,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "では、宿の裏山で待っていますね！(≧∇≦)/"
    },
    {
      "Id": 101530580,
      "Speaker": "Student",
      "Text": "先生！！"
    },
    {
      "Id": 101530590,
      "Speaker": "Student",
      "Text": "服、汚れてませんか！？"
    },
    {
      "Id": 101530600,
      "Speaker": "Player",
      "Text": "大丈夫だと思うけど……どうしたの？"
    },
    {
      "Id": 101530610,
      "Speaker": "Student",
      "Text": "ふう、良かったです……"
    },
    {
      "Id": 101530620,
      "Speaker": "Student",
      "Text": "あ、その……もしかして手についていたりしませんか？"
    },
    {
      "Id": 101530630,
      "Speaker": "Player",
      "Text": "あ、ちょこっとだけついてた"
    },
    {
      "Id": 101530640,
      "Speaker": "Student",
      "Text": "あわわ！"
    },
    {
      "Id": 101530650,
      "Speaker": "Student",
      "Text": "ごめんなさい！！"
    },
    {
      "Id": 101530660,
      "Speaker": "Student",
      "Text": "すぐ洗剤を持っていきます！！"
    }
  ],
  "DialogKR": [
    {
      "Id": 101530010,
      "Speaker": "Student",
      "Text": "선생님, 선물 드리고 싶은 게 있어서요."
    },
    {
      "Id": 101530020,
      "Speaker": "Student",
      "Text": "바로- 게헨나컵 콜라보 페로로님이랍니다!"
    },
    {
      "Id": 101530030,
      "Speaker": "Student",
      "Text": "운 좋게 두 개를 동시에 얻어서,"
    },
    {
      "Id": 101530040,
      "Speaker": "Student",
      "Text": "하나는 선생님께 드리려고 해요. (≧∇≦)v"
    },
    {
      "Id": 101530050,
      "Speaker": "Player",
      "Text": "이런 좋은 걸 받아도 되려나!"
    },
    {
      "Id": 101530060,
      "Speaker": "Student",
      "Text": "물론이죠!"
    },
    {
      "Id": 101530070,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "그러면 이따 뵙겠습니다!"
    },
    {
      "Id": 101530080,
      "Speaker": "Student",
      "Text": "선생님,"
    },
    {
      "Id": 101530090,
      "Speaker": "Student",
      "Text": "혹시…… 눈치채셨나요?"
    },
    {
      "Id": 101530100,
      "Speaker": "Student",
      "Text": "오늘 주변에서 왠지 시선이……."
    },
    {
      "Id": 101530110,
      "Speaker": "Player",
      "Text": "어…… 나도 조금 느끼긴 했는데"
    },
    {
      "Id": 101530120,
      "Speaker": "Player",
      "Text": "크게 신경…… 쓰지 말자!"
    },
    {
      "Id": 101530130,
      "Speaker": "Student",
      "Text": "신경이 조금 쓰이긴 해요……."
    },
    {
      "Id": 101530140,
      "Speaker": "Student",
      "Text": "역시……."
    },
    {
      "Id": 101530150,
      "Speaker": "Student",
      "Text": "머리 모양이 너무 평범해서 그런 걸까요?"
    },
    {
      "Id": 101530160,
      "Speaker": "Student",
      "Text": "기왕 이런 대회인데, 조금은 더 꾸며봤어야 했을까요?!"
    },
    {
      "Id": 101530170,
      "Speaker": "Player",
      "Text": "지금의 히후미가 좋아!"
    },
    {
      "Id": 101530180,
      "Speaker": "Player",
      "Text": "그리고 원인은 아마 그게 아닐 거야!"
    },
    {
      "Id": 101530190,
      "Speaker": "Student",
      "Text": "그런가요?!"
    },
    {
      "Id": 101530200,
      "Speaker": "Student",
      "Text": "그러면 뭐가 문제였을까요? ((º□º;))"
    },
    {
      "Id": 101530210,
      "Speaker": "Student",
      "Text": "선생님! 안녕하세요!"
    },
    {
      "Id": 101530220,
      "Speaker": "Student",
      "Text": "혹시 괜찮으시다면"
    },
    {
      "Id": 101530230,
      "Speaker": "Student",
      "Text": "이따가 같이 쇼핑하지 않으실래요?"
    },
    {
      "Id": 101530240,
      "Speaker": "Player",
      "Text": "바람 좀 쐬러 가보실까!"
    },
    {
      "Id": 101530250,
      "Speaker": "Student",
      "Text": "좋아요 선생님! (≧∇≦)"
    },
    {
      "Id": 101530260,
      "Speaker": "Student",
      "Text": "그러면 크루세이더 쨩으로 같이 가요!"
    },
    {
      "Id": 101530270,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "픽업하러 갈게요! ヾ(•ω•`)o"
    },
    {
      "Id": 101530280,
      "Speaker": "Student",
      "Text": "선생님 괜찮으세요……?"
    },
    {
      "Id": 101530290,
      "Speaker": "Student",
      "Text": "그 정도로 운전을 할 생각은 없었는데"
    },
    {
      "Id": 101530300,
      "Speaker": "Student",
      "Text": "꼭 막아야 한다는 생각에 마음이 급해져서……."
    },
    {
      "Id": 101530310,
      "Speaker": "Player",
      "Text": "괜찮아! 오히려 멋있었어!"
    },
    {
      "Id": 101530320,
      "Speaker": "Player",
      "Text": "도로 위의 영웅 같다고 생각해!"
    },
    {
      "Id": 101530330,
      "Speaker": "Student",
      "Text": "그, 그 정도는 아니에요……!"
    },
    {
      "Id": 101530340,
      "Speaker": "Student",
      "Text": "다음부터는 꼭 꼭 안전하게 운전할게요!"
    },
    {
      "Id": 101530350,
      "Speaker": "Student",
      "Text": "약속이에요, 선생님!"
    },
    {
      "Id": 101530360,
      "Speaker": "Student",
      "Text": "선생님, 안녕하세요!"
    },
    {
      "Id": 101530370,
      "Speaker": "Student",
      "Text": "나중에 서명 하나 받을 수 있을까요?"
    },
    {
      "Id": 101530380,
      "Speaker": "Player",
      "Text": "물론! 그런데, 어떤 서명?"
    },
    {
      "Id": 101530390,
      "Speaker": "Student",
      "Text": "보충수업부의 과외활동 참가 확인증이에요!"
    },
    {
      "Id": 101530400,
      "Speaker": "Student",
      "Text": "고문의 서명이 필요하다고 해서요,"
    },
    {
      "Id": 101530410,
      "Speaker": "Student",
      "Text": "괜찮으시다면 나중에 부탁드리겠습니다!"
    },
    {
      "Id": 101530420,
      "Speaker": "Player",
      "Text": "우리 히후미가 해달라는데 당연히 가능하지!"
    },
    {
      "Id": 101530430,
      "Speaker": "Student",
      "Text": "감사합니다!"
    },
    {
      "Id": 101530440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "그러면 나중에 서명받으러 찾아뵐게요! (^~^)v"
    },
    {
      "Id": 101530450,
      "Speaker": "Student",
      "Text": "선생님, 잘 들어가셨나요?"
    },
    {
      "Id": 101530460,
      "Speaker": "Student",
      "Text": "서명해주셔서 감사합니다."
    },
    {
      "Id": 101530470,
      "Speaker": "Student",
      "Text": "항상, 여러 가지로 신세를 지네요……."
    },
    {
      "Id": 101530480,
      "Speaker": "Player",
      "Text": "신세는 무슨! 특별한 히후미의 부탁인걸!"
    },
    {
      "Id": 101530490,
      "Speaker": "Student",
      "Text": "특별하다니 에헤헤,"
    },
    {
      "Id": 101530500,
      "Speaker": "Student",
      "Text": "기운이 났어요, 고마워요 선생님!"
    },
    {
      "Id": 101530510,
      "Speaker": "Student",
      "Text": "선생님, 바쁘신가요?"
    },
    {
      "Id": 101530520,
      "Speaker": "Student",
      "Text": "여쭤보고 싶은 게 있어서요."
    },
    {
      "Id": 101530530,
      "Speaker": "Student",
      "Text": "괜찮으시다면 도움 부탁드리고 싶어요……."
    },
    {
      "Id": 101530540,
      "Speaker": "Player",
      "Text": "히후미를 돕는 게 최우선 업무야!"
    },
    {
      "Id": 101530550,
      "Speaker": "Player",
      "Text": "최선을 다해보겠습니닷!"
    },
    {
      "Id": 101530560,
      "Speaker": "Student",
      "Text": "감사합니다!"
    },
    {
      "Id": 101530570,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "그러면 선수촌 뒤 숲에서 뵐게요! (≧∇≦)/"
    },
    {
      "Id": 101530580,
      "Speaker": "Student",
      "Text": "선생님!!"
    },
    {
      "Id": 101530590,
      "Speaker": "Student",
      "Text": "옷, 혹시 더러워지지 않으셨나요?!"
    },
    {
      "Id": 101530600,
      "Speaker": "Player",
      "Text": "괜찮은 것 같은데…… 왜?"
    },
    {
      "Id": 101530610,
      "Speaker": "Student",
      "Text": "휴, 다행이에요……."
    },
    {
      "Id": 101530620,
      "Speaker": "Student",
      "Text": "……혹시, 손에는 묻으셨나요?"
    },
    {
      "Id": 101530630,
      "Speaker": "Player",
      "Text": "손에 조금 묻었네?"
    },
    {
      "Id": 101530640,
      "Speaker": "Student",
      "Text": "으와앗!"
    },
    {
      "Id": 101530650,
      "Speaker": "Student",
      "Text": "죄송해요!!"
    },
    {
      "Id": 101530660,
      "Speaker": "Student",
      "Text": "바로 닦는 거 가지고 갈게요!!"
    }
  ],
