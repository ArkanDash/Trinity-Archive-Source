{
  "CharacterId": 10132,
  "DialogJP": [
    {
      "Id": 101320010,
      "Speaker": "Student",
      "Text": "ごめんなさい、部長……"
    },
    {
      "Id": 101320020,
      "Speaker": "Student",
      "Text": "次の動画撮影なのですが……"
    },
    {
      "Id": 101320030,
      "Speaker": "Student",
      "Text": "日程を調整してもらえますか……？"
    },
    {
      "Id": 101320040,
      "Speaker": "Player",
      "Text": "いつの間に私が部長に……！？"
    },
    {
      "Id": 101320050,
      "Speaker": "Student",
      "Text": "先生！？"
    },
    {
      "Id": 101320060,
      "Speaker": "Student",
      "Text": "ごめんなさい！！"
    },
    {
      "Id": 101320070,
      "Speaker": "Student",
      "Text": "送信先を間違えてしまいました！"
    },
    {
      "Id": 101320080,
      "Speaker": "Player",
      "Text": "なにか急用でも入ったの？"
    },
    {
      "Id": 101320090,
      "Speaker": "Student",
      "Text": "実は……"
    },
    {
      "Id": 101320100,
      "Speaker": "Student",
      "Text": "ちょうどその日"
    },
    {
      "Id": 101320110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ファッションモデルのアルバイトをすることになりまして……"
    },
    {
      "Id": 101320120,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101320130,
      "Speaker": "Student",
      "Text": "美術はお好きですか？"
    },
    {
      "Id": 101320140,
      "Speaker": "Player",
      "Text": "急にどうしたの……？"
    },
    {
      "Id": 101320150,
      "Speaker": "Student",
      "Text": "もしよろしければ"
    },
    {
      "Id": 101320160,
      "Speaker": "Student",
      "Text": "お願いがありまして……"
    },
    {
      "Id": 101320170,
      "Speaker": "Player",
      "Text": "何でも言って！"
    },
    {
      "Id": 101320180,
      "Speaker": "Student",
      "Text": "私……"
    },
    {
      "Id": 101320190,
      "Speaker": "Student",
      "Text": "美術予備校へ行くことになったんです……！"
    },
    {
      "Id": 101320200,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "絵に目覚めた！？"
    },
    {
      "Id": 101320210,
      "Speaker": "Student",
      "Text": "先生も無事に帰られましたか？"
    },
    {
      "Id": 101320220,
      "Speaker": "Student",
      "Text": "今日の食事、とても美味しかったです！"
    },
    {
      "Id": 101320230,
      "Speaker": "Student",
      "Text": "考えてみたら"
    },
    {
      "Id": 101320240,
      "Speaker": "Student",
      "Text": "何だか、奢っていただいてばかりで……"
    },
    {
      "Id": 101320250,
      "Speaker": "Student",
      "Text": "次は、必ず私が……！"
    },
    {
      "Id": 101320260,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101320270,
      "Speaker": "Student",
      "Text": "お昼ご飯、もう食べましたか……？"
    },
    {
      "Id": 101320280,
      "Speaker": "Player",
      "Text": "ま、まだ朝の8時だから……"
    },
    {
      "Id": 101320290,
      "Speaker": "Student",
      "Text": "つまり、食べてないと……！"
    },
    {
      "Id": 101320300,
      "Speaker": "Student",
      "Text": "では"
    },
    {
      "Id": 101320310,
      "Speaker": "Student",
      "Text": "お昼は二人で"
    },
    {
      "Id": 101320320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "食べに行きませんか……？"
    },
    {
      "Id": 101320330,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101320340,
      "Speaker": "Student",
      "Text": "これが最後です……！"
    },
    {
      "Id": 101320350,
      "Speaker": "Player",
      "Text": "えっ？"
    },
    {
      "Id": 101320360,
      "Speaker": "Student",
      "Text": "その……"
    },
    {
      "Id": 101320370,
      "Speaker": "Student",
      "Text": "本当の本当の最後に"
    },
    {
      "Id": 101320380,
      "Speaker": "Student",
      "Text": "ファッションショーへ出ようと思います……！"
    },
    {
      "Id": 101320390,
      "Speaker": "Student",
      "Text": "それで……"
    },
    {
      "Id": 101320400,
      "Speaker": "Student",
      "Text": "一緒に行っていただきたくて……"
    },
    {
      "Id": 101320410,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "行こう！"
    },
    {
      "Id": 101320420,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101320430,
      "Speaker": "Student",
      "Text": "先ほどは失礼しました……"
    },
    {
      "Id": 101320440,
      "Speaker": "Player",
      "Text": "大丈夫だよ、気にしないで"
    },
    {
      "Id": 101320450,
      "Speaker": "Student",
      "Text": "どんな服装でも"
    },
    {
      "Id": 101320460,
      "Speaker": "Student",
      "Text": "フェンスを越えられるように"
    },
    {
      "Id": 101320470,
      "Speaker": "Student",
      "Text": "もっと修行します……！"
    },
    {
      "Id": 101320480,
      "Speaker": "Player",
      "Text": "うん、応援してるね！"
    },
    {
      "Id": 101320490,
      "Speaker": "Student",
      "Text": "はい、先生！"
    }
  ],
  "DialogKR": [
    {
      "Id": 101320010,
      "Speaker": "Student",
      "Text": "부장님 죄송해요……."
    },
    {
      "Id": 101320020,
      "Speaker": "Student",
      "Text": "이번 영상 촬영 말인데……"
    },
    {
      "Id": 101320030,
      "Speaker": "Student",
      "Text": "날짜를 바꿀 수 있을까요……?"
    },
    {
      "Id": 101320040,
      "Speaker": "Player",
      "Text": "나, 인법연구부 부장이었구나……!"
    },
    {
      "Id": 101320050,
      "Speaker": "Student",
      "Text": "흐ㅔ에엑 서 선생님?!"
    },
    {
      "Id": 101320060,
      "Speaker": "Student",
      "Text": "죄송해요!"
    },
    {
      "Id": 101320070,
      "Speaker": "Student",
      "Text": "제가 메시지를 잘못 보냈나 봐요!"
    },
    {
      "Id": 101320080,
      "Speaker": "Player",
      "Text": "무슨 일로 참석을 못 하게 된 거야?"
    },
    {
      "Id": 101320090,
      "Speaker": "Student",
      "Text": "아, 그게……"
    },
    {
      "Id": 101320100,
      "Speaker": "Student",
      "Text": "하필 그날"
    },
    {
      "Id": 101320110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "패션모델 알바를 하게 되어서요……"
    },
    {
      "Id": 101320120,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 101320130,
      "Speaker": "Student",
      "Text": "혹시…… 미술 좋아하세요?"
    },
    {
      "Id": 101320140,
      "Speaker": "Player",
      "Text": "어…… 글쎄……?"
    },
    {
      "Id": 101320150,
      "Speaker": "Student",
      "Text": "혹시 싫어하지 않으시면"
    },
    {
      "Id": 101320160,
      "Speaker": "Student",
      "Text": "저 좀 도와주실 수 있으신가요……?"
    },
    {
      "Id": 101320170,
      "Speaker": "Player",
      "Text": "물론이지! 그런데…… 무엇을?"
    },
    {
      "Id": 101320180,
      "Speaker": "Student",
      "Text": "저……"
    },
    {
      "Id": 101320190,
      "Speaker": "Student",
      "Text": "미술 학원에 가야 해서요!"
    },
    {
      "Id": 101320200,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "미술 학원?!"
    },
    {
      "Id": 101320210,
      "Speaker": "Student",
      "Text": "잘 들어가셨나요, 선생님?"
    },
    {
      "Id": 101320220,
      "Speaker": "Student",
      "Text": "오늘 정말 맛있게 먹었습니다!"
    },
    {
      "Id": 101320230,
      "Speaker": "Student",
      "Text": "그런데 돌아와서 생각해 보니, 저……"
    },
    {
      "Id": 101320240,
      "Speaker": "Student",
      "Text": "매번…… 선생님께 받기만 하는 것 같아서……"
    },
    {
      "Id": 101320250,
      "Speaker": "Student",
      "Text": "그러니까…… 다음에는 꼭……!"
    },
    {
      "Id": 101320260,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 101320270,
      "Speaker": "Student",
      "Text": "혹시 점심 식사하셨나요……!"
    },
    {
      "Id": 101320280,
      "Speaker": "Player",
      "Text": "……지금 오전 8시인데?!"
    },
    {
      "Id": 101320290,
      "Speaker": "Student",
      "Text": "다, 다행이다……!"
    },
    {
      "Id": 101320300,
      "Speaker": "Student",
      "Text": "그럼 혹시"
    },
    {
      "Id": 101320310,
      "Speaker": "Student",
      "Text": "점심시간……"
    },
    {
      "Id": 101320320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "내주실 수 있으신가요……!"
    },
    {
      "Id": 101320330,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 101320340,
      "Speaker": "Student",
      "Text": "이번이 마지막이에요……!"
    },
    {
      "Id": 101320350,
      "Speaker": "Player",
      "Text": "응……?"
    },
    {
      "Id": 101320360,
      "Speaker": "Student",
      "Text": "아, 그……."
    },
    {
      "Id": 101320370,
      "Speaker": "Student",
      "Text": "제가 진짜 진짜 마지막으로"
    },
    {
      "Id": 101320380,
      "Speaker": "Student",
      "Text": "패션쇼에 나가게 되어서요……!"
    },
    {
      "Id": 101320390,
      "Speaker": "Student",
      "Text": "혹시……"
    },
    {
      "Id": 101320400,
      "Speaker": "Student",
      "Text": "함께 가 주실 수 있으신가요……?"
    },
    {
      "Id": 101320410,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "물론이지!"
    },
    {
      "Id": 101320420,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101320430,
      "Speaker": "Student",
      "Text": "아까는 죄송했어요……."
    },
    {
      "Id": 101320440,
      "Speaker": "Player",
      "Text": "괜찮아, 그럴 수 있지."
    },
    {
      "Id": 101320450,
      "Speaker": "Student",
      "Text": "앞으로는 어떤 옷을 입어도"
    },
    {
      "Id": 101320460,
      "Speaker": "Student",
      "Text": "이런 일이 벌어지지 않도록"
    },
    {
      "Id": 101320470,
      "Speaker": "Student",
      "Text": "닌자 기술을 더더욱 연마하겠어요……!"
    },
    {
      "Id": 101320480,
      "Speaker": "Player",
      "Text": "으, 응원할게!"
    },
    {
      "Id": 101320490,
      "Speaker": "Student",
      "Text": "네! 선생님!"
    }
  ],
  "DialogEN": [
    {
      "Id": 101320010,
      "Speaker": "Student",
      "Text": "President, my apologies in advance..."
    },
    {
      "Id": 101320020,
      "Speaker": "Student",
      "Text": "But would you mind if we changed the date..."
    },
    {
      "Id": 101320030,
      "Speaker": "Student",
      "Text": "for our next video shoot...?"
    },
    {
      "Id": 101320040,
      "Speaker": "Player",
      "Text": "Wow! When did I get promoted to Ninjutsu Research Club President?"
    },
    {
      "Id": 101320050,
      "Speaker": "Student",
      "Text": "ASDFGHKLDSG SENSEI?!"
    },
    {
      "Id": 101320060,
      "Speaker": "Student",
      "Text": "I'm verryy very sorry!"
    },
    {
      "Id": 101320070,
      "Speaker": "Student",
      "Text": "I messaged the wrong person...!"
    },
    {
      "Id": 101320080,
      "Speaker": "Player",
      "Text": "How come you can't make it, though?"
    },
    {
      "Id": 101320090,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 101320100,
      "Speaker": "Student",
      "Text": "I happen to be..."
    },
    {
      "Id": 101320110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "working a modeling gig on that day..."
    },
    {
      "Id": 101320120,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 101320130,
      "Speaker": "Student",
      "Text": "Do you like art...?"
    },
    {
      "Id": 101320140,
      "Speaker": "Player",
      "Text": "Uh... Depends?"
    },
    {
      "Id": 101320150,
      "Speaker": "Student",
      "Text": "If you don't HATE it..."
    },
    {
      "Id": 101320160,
      "Speaker": "Student",
      "Text": "could you help me with something art-related...?"
    },
    {
      "Id": 101320170,
      "Speaker": "Player",
      "Text": "Always! But with what...exactly?"
    },
    {
      "Id": 101320180,
      "Speaker": "Student",
      "Text": "I..."
    },
    {
      "Id": 101320190,
      "Speaker": "Student",
      "Text": "have to attend an art lesson...!"
    },
    {
      "Id": 101320200,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "An art lesson?!"
    },
    {
      "Id": 101320210,
      "Speaker": "Student",
      "Text": "Did you get home okay, Sensei?"
    },
    {
      "Id": 101320220,
      "Speaker": "Student",
      "Text": "The food was so good today...!"
    },
    {
      "Id": 101320230,
      "Speaker": "Student",
      "Text": "Once I got home, I realized..."
    },
    {
      "Id": 101320240,
      "Speaker": "Student",
      "Text": "You're always the one helping me..."
    },
    {
      "Id": 101320250,
      "Speaker": "Student",
      "Text": "So...for sure...next time...!"
    },
    {
      "Id": 101320260,
      "Speaker": "Student",
      "Text": "Sensei?"
    },
    {
      "Id": 101320270,
      "Speaker": "Student",
      "Text": "Have you eaten lunch yet...?"
    },
    {
      "Id": 101320280,
      "Speaker": "Player",
      "Text": "...Is it not 8 in the morning right now?!"
    },
    {
      "Id": 101320290,
      "Speaker": "Student",
      "Text": "So you haven't...! What a relief...!"
    },
    {
      "Id": 101320300,
      "Speaker": "Student",
      "Text": "In that case"
    },
    {
      "Id": 101320310,
      "Speaker": "Student",
      "Text": "could I borrow a moment"
    },
    {
      "Id": 101320320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "of your lunch hour...?"
    },
    {
      "Id": 101320330,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 101320340,
      "Speaker": "Student",
      "Text": "This will really be the last one...!"
    },
    {
      "Id": 101320350,
      "Speaker": "Player",
      "Text": "Huh...?"
    },
    {
      "Id": 101320360,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 101320370,
      "Speaker": "Student",
      "Text": "This is really, very, truly the absolute last"
    },
    {
      "Id": 101320380,
      "Speaker": "Student",
      "Text": "fashion show I'll be in...!"
    },
    {
      "Id": 101320390,
      "Speaker": "Student",
      "Text": "Would you..."
    },
    {
      "Id": 101320400,
      "Speaker": "Student",
      "Text": "go with me...?"
    },
    {
      "Id": 101320410,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "Of course!"
    },
    {
      "Id": 101320420,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101320430,
      "Speaker": "Student",
      "Text": "I really am very sorry still..."
    },
    {
      "Id": 101320440,
      "Speaker": "Player",
      "Text": "It's okay. Things happen sometimes."
    },
    {
      "Id": 101320450,
      "Speaker": "Student",
      "Text": "I will train my ninja skills diligently..."
    },
    {
      "Id": 101320460,
      "Speaker": "Student",
      "Text": "so something like this never happens again"
    },
    {
      "Id": 101320470,
      "Speaker": "Student",
      "Text": "no matter what I'm wearing...!"
    },
    {
      "Id": 101320480,
      "Speaker": "Player",
      "Text": "I believe in you!"
    },
    {
      "Id": 101320490,
      "Speaker": "Student",
      "Text": "Thank you! Sensei!"
    }
  ],
  "DialogTH": [
    {
      "Id": 101320010,
      "Speaker": "Student",
      "Text": "ขอโทษนะคะ หัวหน้า..."
    },
    {
      "Id": 101320020,
      "Speaker": "Student",
      "Text": "เรื่องการถ่ายวิดีโอครั้งนี้..."
    },
    {
      "Id": 101320030,
      "Speaker": "Student",
      "Text": "พอจะเปลี่ยนวันได้มั้ยคะ...?"
    },
    {
      "Id": 101320040,
      "Speaker": "Player",
      "Text": "ครูได้เป็นหัวหน้าชมรม\nวิจัยศาสตร์นินจาสินะ...!"
    },
    {
      "Id": 101320050,
      "Speaker": "Student",
      "Text": "เฮือกกก คะ... คุณครู?!"
    },
    {
      "Id": 101320060,
      "Speaker": "Student",
      "Text": "ขอโทษค่ะ!"
    },
    {
      "Id": 101320070,
      "Speaker": "Student",
      "Text": "ฉันน่าจะส่งข้อความหาผิดคนค่ะ!"
    },
    {
      "Id": 101320080,
      "Speaker": "Player",
      "Text": "ติดงานอะไรถึงไปถ่ายวิดีโอ\nไม่ได้เหรอ?"
    },
    {
      "Id": 101320090,
      "Speaker": "Student",
      "Text": "อ่า คือว่า..."
    },
    {
      "Id": 101320100,
      "Speaker": "Student",
      "Text": "พอดีวันนั้น..."
    },
    {
      "Id": 101320110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ฉันต้องไปทำงานพาร์ทไทม์นางแบบ\nแฟชั่นค่ะ..."
    },
    {
      "Id": 101320120,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101320130,
      "Speaker": "Student",
      "Text": "ไม่ทราบว่า... ชอบศิลปะมั้ยคะ?"
    },
    {
      "Id": 101320140,
      "Speaker": "Player",
      "Text": "อืม... ไม่รู้สิ...?"
    },
    {
      "Id": 101320150,
      "Speaker": "Student",
      "Text": "ถ้าไม่ติดอะไรละก็"
    },
    {
      "Id": 101320160,
      "Speaker": "Student",
      "Text": "มาช่วยฉันสักหน่อยได้มั้ยคะ...?"
    },
    {
      "Id": 101320170,
      "Speaker": "Player",
      "Text": "ได้อยู่แล้ว! ว่าแต่...\nให้ช่วยอะไรเหรอ?"
    },
    {
      "Id": 101320180,
      "Speaker": "Student",
      "Text": "คือว่า..."
    },
    {
      "Id": 101320190,
      "Speaker": "Student",
      "Text": "ฉันต้องไปสถาบันศิลปะน่ะค่ะ!"
    },
    {
      "Id": 101320200,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "สถาบันศิลปะ?!"
    },
    {
      "Id": 101320210,
      "Speaker": "Student",
      "Text": "กลับไปถึงหรือยังคะ คุณครู?"
    },
    {
      "Id": 101320220,
      "Speaker": "Student",
      "Text": "วันนี้ฉันได้กินอย่างอิ่มอร่อยเลยค่ะ!"
    },
    {
      "Id": 101320230,
      "Speaker": "Student",
      "Text": "แต่พอกลับมาคิดดู ฉันว่า..."
    },
    {
      "Id": 101320240,
      "Speaker": "Student",
      "Text": "ฉันเป็นฝ่ายได้รับนู่นนี่จากคุณครู...\nทุกครั้งเลย..."
    },
    {
      "Id": 101320250,
      "Speaker": "Student",
      "Text": "เพราะงั้น... ต่อไปฉันขอตอบแทน\nบ้างนะคะ...!"
    },
    {
      "Id": 101320260,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101320270,
      "Speaker": "Student",
      "Text": "ทานมื้อกลางวันหรือยังคะ...!"
    },
    {
      "Id": 101320280,
      "Speaker": "Player",
      "Text": "ตอนนี้เพิ่ง 8 โมงเช้าเองนะ...?!"
    },
    {
      "Id": 101320290,
      "Speaker": "Student",
      "Text": "ละ... โล่งอกไปที...!"
    },
    {
      "Id": 101320300,
      "Speaker": "Student",
      "Text": "ถ้างั้น"
    },
    {
      "Id": 101320310,
      "Speaker": "Student",
      "Text": "ฉันขอเวลา..."
    },
    {
      "Id": 101320320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "พักกลางวันของคุณครูได้มั้ยคะ...!"
    },
    {
      "Id": 101320330,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101320340,
      "Speaker": "Student",
      "Text": "นี่เป็นครั้งสุดท้ายแล้วค่ะ...!"
    },
    {
      "Id": 101320350,
      "Speaker": "Player",
      "Text": "หืม...?"
    },
    {
      "Id": 101320360,
      "Speaker": "Student",
      "Text": "อ่า คือว่า..."
    },
    {
      "Id": 101320370,
      "Speaker": "Student",
      "Text": "ฉันจะได้ไปเดินแฟชั่นโชว์"
    },
    {
      "Id": 101320380,
      "Speaker": "Student",
      "Text": "เป็นครั้งสุดท้ายแล้วจริงๆ ค่ะ...!"
    },
    {
      "Id": 101320390,
      "Speaker": "Student",
      "Text": "ไม่ทราบว่า..."
    },
    {
      "Id": 101320400,
      "Speaker": "Student",
      "Text": "คุณครูช่วยไปด้วยกันได้มั้ยคะ...?"
    },
    {
      "Id": 101320410,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "ได้อยู่แล้ว!"
    },
    {
      "Id": 101320420,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101320430,
      "Speaker": "Student",
      "Text": "เมื่อกี้ฉันขอโทษนะคะ..."
    },
    {
      "Id": 101320440,
      "Speaker": "Player",
      "Text": "ไม่เป็นไร ครูไม่ว่าหรอก"
    },
    {
      "Id": 101320450,
      "Speaker": "Student",
      "Text": "ฉันต้องไปฝึกทักษะนินจาให้มากขึ้น\nแล้วค่ะ...!"
    },
    {
      "Id": 101320460,
      "Speaker": "Student",
      "Text": "ต่อไปไม่ว่าจะได้ใส่ชุดแบบไหน"
    },
    {
      "Id": 101320470,
      "Speaker": "Student",
      "Text": "จะได้ไม่เกิดเรื่องแบบนี้อีก"
    },
    {
      "Id": 101320480,
      "Speaker": "Player",
      "Text": "คะ... ครูจะเป็นกำลังใจให้นะ!"
    },
    {
      "Id": 101320490,
      "Speaker": "Student",
      "Text": "ค่ะ! คุณครู!"
    }
  ],
