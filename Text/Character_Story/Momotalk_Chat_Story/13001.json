{
  "CharacterId": 13001,
  "DialogJP": [
    {
      "Id": 909,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 910,
      "Speaker": "Student",
      "Text": "今日は、綺麗な雲がいっぱい"
    },
    {
      "Id": 911,
      "Speaker": "Player",
      "Text": "雲？"
    },
    {
      "Id": 912,
      "Speaker": "Player",
      "Text": "あ、本当だ。今日の空、良い感じだね。"
    },
    {
      "Id": 913,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 914,
      "Speaker": "Student",
      "Text": "だから、もしかしたら"
    },
    {
      "Id": 915,
      "Speaker": "Student",
      "Text": "今日だったら、見つけられるかも"
    },
    {
      "Id": 916,
      "Speaker": "Student",
      "Text": "そう思って"
    },
    {
      "Id": 917,
      "Speaker": "Student",
      "Text": "先生、探しに行こう"
    },
    {
      "Id": 918,
      "Speaker": "Player",
      "Text": "探す？何を？"
    },
    {
      "Id": 919,
      "Speaker": "Student",
      "Text": "雲"
    },
    {
      "Id": 920,
      "Speaker": "Player",
      "Text": "雲……？"
    },
    {
      "Id": 921,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "商店街で待ってるね"
    },
    {
      "Id": 922,
      "Speaker": "Student",
      "Text": "先生は今、暇だったり、する？"
    },
    {
      "Id": 923,
      "Speaker": "Student",
      "Text": "新しい俳句集が出たから、買いに行きたい"
    },
    {
      "Id": 924,
      "Speaker": "Player",
      "Text": "うん、大丈夫だよ"
    },
    {
      "Id": 925,
      "Speaker": "Player",
      "Text": "たとえ暇じゃなかったとしても、チセのためなら……！"
    },
    {
      "Id": 926,
      "Speaker": "Student",
      "Text": "そうなの？"
    },
    {
      "Id": 927,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "じゃあ、行こっか"
    },
    {
      "Id": 928,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 929,
      "Speaker": "Student",
      "Text": "エマージェンシー"
    },
    {
      "Id": 930,
      "Speaker": "Player",
      "Text": "エマージェンシー？"
    },
    {
      "Id": 931,
      "Speaker": "Player",
      "Text": "急にどうしたの？"
    },
    {
      "Id": 932,
      "Speaker": "Student",
      "Text": "締め切りが"
    },
    {
      "Id": 933,
      "Speaker": "Student",
      "Text": "目の前なのに"
    },
    {
      "Id": 934,
      "Speaker": "Student",
      "Text": "白めいて"
    },
    {
      "Id": 935,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 936,
      "Speaker": "Student",
      "Text": "公園"
    },
    {
      "Id": 937,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "待ってるね"
    },
    {
      "Id": 130010010,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 130010020,
      "Speaker": "Student",
      "Text": "夏だよ"
    },
    {
      "Id": 130010030,
      "Speaker": "Student",
      "Text": "暑いね～"
    },
    {
      "Id": 130010040,
      "Speaker": "Player",
      "Text": "今年は特に暑いね"
    },
    {
      "Id": 130010050,
      "Speaker": "Student",
      "Text": "でも"
    },
    {
      "Id": 130010060,
      "Speaker": "Student",
      "Text": "風が来る音を聞けるから"
    },
    {
      "Id": 130010070,
      "Speaker": "Player",
      "Text": "風の音？"
    },
    {
      "Id": 130010080,
      "Speaker": "Student",
      "Text": "ううん"
    },
    {
      "Id": 130010090,
      "Speaker": "Student",
      "Text": "風が来る音"
    },
    {
      "Id": 130010100,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 130010110,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "先生にも聞かせてあげる"
    }
  ],
  "DialogKR": [
    {
      "Id": 909,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 910,
      "Speaker": "Student",
      "Text": "이쁜 구름을 봤어."
    },
    {
      "Id": 911,
      "Speaker": "Player",
      "Text": "구름?"
    },
    {
      "Id": 912,
      "Speaker": "Player",
      "Text": "그러게 오늘 날씨 좋지?"
    },
    {
      "Id": 913,
      "Speaker": "Student",
      "Text": "응."
    },
    {
      "Id": 914,
      "Speaker": "Student",
      "Text": "그래서 오늘이라면"
    },
    {
      "Id": 915,
      "Speaker": "Student",
      "Text": "찾을 수 있을지도 모른다고."
    },
    {
      "Id": 916,
      "Speaker": "Student",
      "Text": "생각했어."
    },
    {
      "Id": 917,
      "Speaker": "Student",
      "Text": "선생님. 찾으러 가자."
    },
    {
      "Id": 918,
      "Speaker": "Player",
      "Text": "찾는다니? 뭘?"
    },
    {
      "Id": 919,
      "Speaker": "Student",
      "Text": "구름."
    },
    {
      "Id": 920,
      "Speaker": "Player",
      "Text": "구름……?"
    },
    {
      "Id": 921,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "상점가에서 기다릴게."
    },
    {
      "Id": 922,
      "Speaker": "Student",
      "Text": "선생님, 한가, 해?"
    },
    {
      "Id": 923,
      "Speaker": "Student",
      "Text": "하이쿠 시집 신간이 나와서 사러 가고 싶어."
    },
    {
      "Id": 924,
      "Speaker": "Player",
      "Text": "치세를 위해서라면 당연히 한가하지."
    },
    {
      "Id": 925,
      "Speaker": "Player",
      "Text": "한가하지 않아도 치세를 위해서라면 얼마든지……!"
    },
    {
      "Id": 926,
      "Speaker": "Student",
      "Text": "그으래?"
    },
    {
      "Id": 927,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그럼, 같이 사러 가자."
    },
    {
      "Id": 928,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 929,
      "Speaker": "Student",
      "Text": "이머-전-시."
    },
    {
      "Id": 930,
      "Speaker": "Player",
      "Text": "이머전시?"
    },
    {
      "Id": 931,
      "Speaker": "Player",
      "Text": "치세, 갑자기 무슨 일이야?"
    },
    {
      "Id": 932,
      "Speaker": "Student",
      "Text": "동아리 출품"
    },
    {
      "Id": 933,
      "Speaker": "Student",
      "Text": "마감이 코앞인데"
    },
    {
      "Id": 934,
      "Speaker": "Student",
      "Text": "뭘 써야 할까?"
    },
    {
      "Id": 935,
      "Speaker": "Player",
      "Text": "치세……?"
    },
    {
      "Id": 936,
      "Speaker": "Student",
      "Text": "선생님, 공원."
    },
    {
      "Id": 937,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "기다리고 있을게."
    },
    {
      "Id": 130010010,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 130010020,
      "Speaker": "Student",
      "Text": "여름이야."
    },
    {
      "Id": 130010030,
      "Speaker": "Student",
      "Text": "더워~."
    },
    {
      "Id": 130010040,
      "Speaker": "Player",
      "Text": "그러게. 이번 여름은 유난히 더운걸."
    },
    {
      "Id": 130010050,
      "Speaker": "Student",
      "Text": "그래도"
    },
    {
      "Id": 130010060,
      "Speaker": "Student",
      "Text": "바람이 오는 소리를 들을 수 있으니까."
    },
    {
      "Id": 130010070,
      "Speaker": "Player",
      "Text": "바람 소리?"
    },
    {
      "Id": 130010080,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 130010090,
      "Speaker": "Student",
      "Text": "바람이 오는 소리."
    },
    {
      "Id": 130010100,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 130010110,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "선생님한테도 들려줄게."
    }
  ],
  "DialogEN": [
    {
      "Id": 909,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 910,
      "Speaker": "Student",
      "Text": "I saw some lovely clouds."
    },
    {
      "Id": 911,
      "Speaker": "Player",
      "Text": "Clouds?"
    },
    {
      "Id": 912,
      "Speaker": "Player",
      "Text": "It's a beautiful day today!"
    },
    {
      "Id": 913,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 914,
      "Speaker": "Student",
      "Text": "So today..."
    },
    {
      "Id": 915,
      "Speaker": "Student",
      "Text": "I might be able to find them."
    },
    {
      "Id": 916,
      "Speaker": "Student",
      "Text": "At least, I think so."
    },
    {
      "Id": 917,
      "Speaker": "Student",
      "Text": "Sensei, let's go find them."
