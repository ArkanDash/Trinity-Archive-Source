    {
      "Id": 918,
      "Speaker": "Player",
      "Text": "Find what?"
    },
    {
      "Id": 919,
      "Speaker": "Student",
      "Text": "Clouds."
    },
    {
      "Id": 920,
      "Speaker": "Player",
      "Text": "Clouds?"
    },
    {
      "Id": 921,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'll wait for you in the shopping district."
    },
    {
      "Id": 922,
      "Speaker": "Student",
      "Text": "Sensei, are you free today?"
    },
    {
      "Id": 923,
      "Speaker": "Student",
      "Text": "A new haiku book came out. I wanna go buy it."
    },
    {
      "Id": 924,
      "Speaker": "Player",
      "Text": "I always have time for you, Chise."
    },
    {
      "Id": 925,
      "Speaker": "Player",
      "Text": "And if I don't, I'll make some!"
    },
    {
      "Id": 926,
      "Speaker": "Student",
      "Text": "Really?"
    },
    {
      "Id": 927,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Then let's go together."
    },
    {
      "Id": 928,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 929,
      "Speaker": "Student",
      "Text": "It's an emergency."
    },
    {
      "Id": 930,
      "Speaker": "Player",
      "Text": "An emergency?"
    },
    {
      "Id": 931,
      "Speaker": "Player",
      "Text": "Chise, what's going on?"
    },
    {
      "Id": 932,
      "Speaker": "Student",
      "Text": "The club submission"
    },
    {
      "Id": 933,
      "Speaker": "Student",
      "Text": "deadline is almost here."
    },
    {
      "Id": 934,
      "Speaker": "Student",
      "Text": "What should I do?"
    },
    {
      "Id": 935,
      "Speaker": "Player",
      "Text": "Chise?"
    },
    {
      "Id": 936,
      "Speaker": "Student",
      "Text": "The park, Sensei."
    },
    {
      "Id": 937,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "I'll be waiting."
    },
    {
      "Id": 130010010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 130010020,
      "Speaker": "Student",
      "Text": "Summer is here."
    },
    {
      "Id": 130010030,
      "Speaker": "Student",
      "Text": "It's hot."
    },
    {
      "Id": 130010040,
      "Speaker": "Player",
      "Text": "It really is hotter than usual this summer."
    },
    {
      "Id": 130010050,
      "Speaker": "Student",
      "Text": "But still"
    },
    {
      "Id": 130010060,
      "Speaker": "Student",
      "Text": "I can hear the sound of the incoming wind."
    },
    {
      "Id": 130010070,
      "Speaker": "Player",
      "Text": "The sound of the wind?"
    },
    {
      "Id": 130010080,
      "Speaker": "Student",
      "Text": "No"
    },
    {
      "Id": 130010090,
      "Speaker": "Student",
      "Text": "The sound of the incoming wind."
    },
    {
      "Id": 130010100,
      "Speaker": "Student",
      "Text": "Hm."
    },
    {
      "Id": 130010110,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I'll show you."
    }
  ],
  "DialogTH": [
    {
