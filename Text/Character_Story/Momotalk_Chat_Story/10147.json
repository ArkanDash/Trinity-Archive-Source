{
  "CharacterId": 10147,
  "DialogJP": [
    {
      "Id": 101470010,
      "Speaker": "Student",
      "Text": "先生、ちょっといいかしら"
    },
    {
      "Id": 101470020,
      "Speaker": "Player",
      "Text": "大丈夫だよ。どうしたの？"
    },
    {
      "Id": 101470030,
      "Speaker": "Student",
      "Text": "先生は……"
    },
    {
      "Id": 101470040,
      "Speaker": "Student",
      "Text": "海がどれだけ危険な場所か"
    },
    {
      "Id": 101470050,
      "Speaker": "Student",
      "Text": "ちゃんと理解してるかしら？"
    },
    {
      "Id": 101470060,
      "Speaker": "Player",
      "Text": "いや、あんまり……"
    },
    {
      "Id": 101470070,
      "Speaker": "Student",
      "Text": "……これは直接説明した方がよさそうね"
    },
    {
      "Id": 101470080,
      "Speaker": "Student",
      "Text": "今から行くから、待っていて頂戴"
    },
    {
      "Id": 101470090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "う、うん。待ってるね……"
    },
    {
      "Id": 101470100,
      "Speaker": "Student",
      "Text": "私が教えた海の安全対策……"
    },
    {
      "Id": 101470110,
      "Speaker": "Student",
      "Text": "ちゃんと覚えているかしら？"
    },
    {
      "Id": 101470120,
      "Speaker": "Student",
      "Text": "忘れたらダメよ？"
    },
    {
      "Id": 101470130,
      "Speaker": "Player",
      "Text": "大丈夫、覚えてるよ！"
    },
    {
      "Id": 101470140,
      "Speaker": "Student",
      "Text": "それを聞いて安心したわ"
    },
    {
      "Id": 101470150,
      "Speaker": "Student",
      "Text": "でもまだ少し心配だから……"
    },
    {
      "Id": 101470160,
      "Speaker": "Student",
      "Text": "これからもずっと、私がそばでケアしてあげる"
    },
    {
      "Id": 101470170,
      "Speaker": "Player",
      "Text": "それはうれしいな"
    },
    {
      "Id": 101470180,
      "Speaker": "Student",
      "Text": "ふふ、でしょう？"
    },
    {
      "Id": 101470190,
      "Speaker": "Student",
      "Text": "それじゃあ、またね"
    },
    {
      "Id": 101470200,
      "Speaker": "Student",
      "Text": "海は、とても恐ろしい場所よ。"
    },
    {
      "Id": 101470210,
      "Speaker": "Player",
      "Text": "い、いきなりだね。"
    },
    {
      "Id": 101470220,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 101470230,
      "Speaker": "Student",
      "Text": "水の中だと息もできないし"
    },
    {
      "Id": 101470240,
      "Speaker": "Student",
      "Text": "自由に動けないわ"
    },
    {
      "Id": 101470250,
      "Speaker": "Student",
      "Text": "もし波にさらわれたりでもしたらと考えると――"
    },
    {
      "Id": 101470260,
      "Speaker": "Player",
      "Text": "たしかに、そう思うと怖いね……"
    },
    {
      "Id": 101470270,
      "Speaker": "Student",
      "Text": "危険なものからは距離を取る"
    },
    {
      "Id": 101470280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "それが一番よね"
    },
    {
      "Id": 101470290,
      "Speaker": "Student",
      "Text": "海って……"
    },
    {
      "Id": 101470300,
      "Speaker": "Student",
      "Text": "案外楽しい場所なのかもしれないわね"
    },
    {
      "Id": 101470310,
      "Speaker": "Student",
      "Text": "教えてくれて感謝するわ"
    },
    {
      "Id": 101470320,
      "Speaker": "Player",
      "Text": "そうでしょう？"
    },
    {
      "Id": 101470330,
      "Speaker": "Student",
      "Text": "でも油断は禁物よ"
    },
    {
      "Id": 101470340,
      "Speaker": "Student",
      "Text": "先生は慣れているみたいだけど"
    },
    {
      "Id": 101470350,
      "Speaker": "Student",
      "Text": "常に警戒を怠らないこと"
    },
    {
      "Id": 101470360,
      "Speaker": "Player",
      "Text": "うん、気をつけるよ"
    },
    {
      "Id": 101470370,
      "Speaker": "Student",
      "Text": "ふふ、いい返事ね"
    },
    {
      "Id": 101470380,
      "Speaker": "Student",
      "Text": "海ってとっても怖い場所よね"
    },
    {
      "Id": 101470390,
      "Speaker": "Student",
      "Text": "先生もそう思うでしょう？"
    },
    {
      "Id": 101470400,
      "Speaker": "Player",
      "Text": "デジャブだね"
    },
    {
      "Id": 101470410,
      "Speaker": "Player",
      "Text": "サツキはもう大丈夫じゃないの？"
    },
    {
      "Id": 101470420,
      "Speaker": "Student",
      "Text": "海のずぅっと深いところには――"
    },
    {
      "Id": 101470430,
      "Speaker": "Student",
      "Text": "恐ろしい何かが潜んでいる気がするの"
    },
    {
      "Id": 101470440,
      "Speaker": "Player",
      "Text": "そういうのもいるかもしれないね"
    },
    {
      "Id": 101470450,
      "Speaker": "Student",
      "Text": "浅いところなら平気かもしれないわ"
    },
    {
      "Id": 101470460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "だって、先生が守ってくれるもの"
    },
    {
      "Id": 101470470,
      "Speaker": "Student",
      "Text": "ねえ先生"
    },
    {
      "Id": 101470480,
      "Speaker": "Student",
      "Text": "知ってる？"
    },
    {
      "Id": 101470490,
      "Speaker": "Player",
      "Text": "多分しらないかも？"
    },
    {
      "Id": 101470500,
      "Speaker": "Student",
      "Text": "クラゲ同士って"
    },
    {
      "Id": 101470510,
      "Speaker": "Student",
      "Text": "お互いの毒が効かないらしいのよ"
    },
    {
      "Id": 101470520,
      "Speaker": "Player",
      "Text": "そうなんだ！すごいね！"
    },
    {
      "Id": 101470530,
      "Speaker": "Student",
      "Text": "つまり……"
    },
    {
      "Id": 101470540,
      "Speaker": "Student",
      "Text": "先生と私みたいな関係ってこと"
    },
    {
      "Id": 101470550,
      "Speaker": "Player",
      "Text": "よく分からないけど……"
    },
    {
      "Id": 101470560,
      "Speaker": "Player",
      "Text": "サツキが言うのなら、そうなのかもね"
    },
    {
      "Id": 101470570,
      "Speaker": "Student",
      "Text": "ふふっ、そうよ"
    },
    {
      "Id": 101470580,
      "Speaker": "Student",
      "Text": "ねぇ、先生に聞きたいことがあるの"
    },
    {
      "Id": 101470590,
      "Speaker": "Player",
      "Text": "いいよ。どうしたの？"
    },
    {
      "Id": 101470600,
      "Speaker": "Student",
      "Text": "紫外線対策はしてる？"
    },
    {
      "Id": 101470610,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 101470620,
      "Speaker": "Student",
      "Text": "クラゲ対策は？"
    },
    {
      "Id": 101470630,
      "Speaker": "Player",
      "Text": "大丈夫！"
    },
    {
      "Id": 101470640,
      "Speaker": "Student",
      "Text": "ふむ……いいでしょう"
    },
    {
      "Id": 101470650,
      "Speaker": "Student",
      "Text": "じゃあ、出発するわよ！"
    },
    {
      "Id": 101470660,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "どこに？"
    },
    {
      "Id": 101470670,
      "Speaker": "Student",
      "Text": "ああ、そういえば"
    },
    {
      "Id": 101470680,
      "Speaker": "Student",
      "Text": "先生は知っているかしら？"
    },
    {
      "Id": 101470690,
      "Speaker": "Player",
      "Text": "たぶん……？"
    },
    {
      "Id": 101470700,
      "Speaker": "Student",
      "Text": "あら？私の気持ちが分かったの？"
    },
    {
      "Id": 101470710,
      "Speaker": "Student",
      "Text": "さすが先生ね"
    },
    {
      "Id": 101470720,
      "Speaker": "Player",
      "Text": "そ、そういう話だったの？"
    },
    {
      "Id": 101470730,
      "Speaker": "Player",
      "Text": "分かるような、分からないような……"
    },
    {
      "Id": 101470740,
      "Speaker": "Student",
      "Text": "実は、私もよく分かっていないの"
    },
    {
      "Id": 101470750,
      "Speaker": "Student",
      "Text": "この気持ちは……なんと言うのかしら"
    },
    {
      "Id": 101470760,
      "Speaker": "Student",
      "Text": "なんだか落ち着かないわ"
    },
    {
      "Id": 101470770,
      "Speaker": "Player",
      "Text": "私に手伝えることはあるかな？"
    },
    {
      "Id": 101470780,
      "Speaker": "Student",
      "Text": "う～ん"
    },
    {
      "Id": 101470790,
      "Speaker": "Student",
      "Text": "そうね……"
    },
    {
      "Id": 101470800,
      "Speaker": "Student",
      "Text": "……先生の顔を見せて頂戴"
    },
    {
      "Id": 101470810,
      "Speaker": "Player",
      "StoryEpisode": 5,
      "Text": "分かった、今どこにいるの？"
    },
    {
      "Id": 101470820,
      "Speaker": "Student",
      "Text": "先生、聞いて"
    },
    {
      "Id": 101470830,
      "Speaker": "Student",
      "Text": "人はね、見慣れたものを"
    },
    {
      "Id": 101470840,
      "Speaker": "Student",
      "Text": "いつの間にか「当たり前」だと思い込むらしいわ"
    },
    {
      "Id": 101470850,
      "Speaker": "Player",
      "Text": "なるほど、そうかもしれないね"
    },
    {
      "Id": 101470860,
      "Speaker": "Student",
      "Text": "だから先に言っておくわ"
    },
    {
      "Id": 101470870,
      "Speaker": "Player",
      "Text": "何を？"
    },
    {
      "Id": 101470880,
      "Speaker": "Student",
      "Text": "これからも"
    },
    {
      "Id": 101470890,
      "Speaker": "Student",
      "Text": "ずっと隣にいるって"
    },
    {
      "Id": 101470900,
      "Speaker": "Player",
      "Text": "慣れさせるってこと？"
    },
    {
      "Id": 101470910,
      "Speaker": "Student",
      "Text": "ええ"
    },
    {
      "Id": 101470920,
      "Speaker": "Student",
      "Text": "そうしていれば"
    },
    {
      "Id": 101470930,
      "Speaker": "Student",
      "Text": "いつか、それが当たり前になるでしょう？"
    },
    {
      "Id": 101470940,
      "Speaker": "Player",
      "Text": "うん、そうだね"
    },
    {
      "Id": 101470950,
      "Speaker": "Student",
      "Text": "そうよ。ふふっ"
    }
  ],
  "DialogKR": [
    {
      "Id": 101470010,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 101470020,
      "Speaker": "Player",
      "Text": "사츠키~"
    },
    {
      "Id": 101470030,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 101470040,
      "Speaker": "Student",
      "Text": "해변이 얼마나 위험한지"
    },
    {
      "Id": 101470050,
      "Speaker": "Student",
      "Text": "알고 있겠지?"
    },
    {
      "Id": 101470060,
      "Speaker": "Player",
      "Text": "그랬던가……"
    },
    {
      "Id": 101470070,
      "Speaker": "Student",
      "Text": "이건 만나서 설명하는 편이 낫겠네"
    },
    {
      "Id": 101470080,
      "Speaker": "Student",
      "Text": "지금 갈게~!"
    },
    {
      "Id": 101470090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "왠지 익숙한 기분이……"
    },
    {
      "Id": 101470100,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 101470110,
      "Speaker": "Student",
      "Text": "오늘의 안전 대책"
    },
    {
      "Id": 101470120,
      "Speaker": "Student",
      "Text": "잊으면 안 돼?"
    },
    {
      "Id": 101470130,
      "Speaker": "Player",
      "Text": "물론이지"
    },
    {
      "Id": 101470140,
      "Speaker": "Student",
      "Text": "그래도 혹시 모르니"
    },
    {
      "Id": 101470150,
      "Speaker": "Student",
      "Text": "앞으로도 계속"
    },
    {
      "Id": 101470160,
      "Speaker": "Student",
      "Text": "내가 옆에서 케어하겠어"
    },
    {
      "Id": 101470170,
      "Speaker": "Player",
      "Text": "나야 고마워"
    },
    {
      "Id": 101470180,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 101470190,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470200,
      "Speaker": "Student",
      "Text": "바다는 아주 무서운 곳이지?"
    },
    {
      "Id": 101470210,
      "Speaker": "Player",
      "Text": "갑자기?"
    },
    {
      "Id": 101470220,
      "Speaker": "Player",
      "Text": "무슨 일 있었어?"
    },
    {
      "Id": 101470230,
      "Speaker": "Student",
      "Text": "물속에서는 숨도 못 쉬고"
    },
    {
      "Id": 101470240,
      "Speaker": "Student",
      "Text": "마음대로 움직이지도 못하니까"
    },
    {
      "Id": 101470250,
      "Speaker": "Student",
      "Text": "파도에 쓸려가기라도 하면"
    },
    {
      "Id": 101470260,
      "Speaker": "Player",
      "Text": "확실히 무서운 일이긴 하지……"
    },
    {
      "Id": 101470270,
      "Speaker": "Student",
      "Text": "위험을 멀리하는 것이"
    },
    {
      "Id": 101470280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "현명한 판단이겠지"
    },
    {
      "Id": 101470290,
      "Speaker": "Student",
      "Text": "바다란……"
    },
    {
      "Id": 101470300,
      "Speaker": "Student",
      "Text": "의외로 즐거운 곳일지도 모르겠네"
    },
    {
      "Id": 101470310,
      "Speaker": "Student",
      "Text": "알려줘서 고마워"
    },
    {
      "Id": 101470320,
      "Speaker": "Player",
      "Text": "그치?"
    },
    {
      "Id": 101470330,
      "Speaker": "Student",
      "Text": "하지만 방심은 금물이야"
    },
    {
      "Id": 101470340,
      "Speaker": "Student",
      "Text": "선생은 제법 익숙한 것 같지만"
    },
    {
      "Id": 101470350,
      "Speaker": "Student",
      "Text": "항상 조심하도록 해"
    },
    {
      "Id": 101470360,
      "Speaker": "Player",
      "Text": "응 조심할게"
    },
    {
      "Id": 101470370,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470380,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470390,
      "Speaker": "Student",
      "Text": "바다는 아주 무서운 곳이지?"
    },
    {
      "Id": 101470400,
      "Speaker": "Player",
      "Text": "이 흐름 익숙한데"
    },
    {
      "Id": 101470410,
      "Speaker": "Player",
      "Text": "이제 괜찮지 않아?"
    },
    {
      "Id": 101470420,
      "Speaker": "Student",
      "Text": "바다 깊은 곳에는"
    },
    {
      "Id": 101470430,
      "Speaker": "Student",
      "Text": "무서운 뭔가가 있을 것 같아"
    },
    {
      "Id": 101470440,
      "Speaker": "Player",
      "Text": "그럴지도 모르지만……"
    },
    {
      "Id": 101470450,
      "Speaker": "Student",
      "Text": "얕은 곳은 괜찮겠지?"
    },
    {
      "Id": 101470460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "선생이 지켜줄 테니까"
    },
    {
      "Id": 101470470,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470480,
      "Speaker": "Student",
      "Text": "그거 알아?"
    },
    {
      "Id": 101470490,
      "Speaker": "Player",
      "Text": "아마 모를걸?"
    },
    {
      "Id": 101470500,
      "Speaker": "Student",
      "Text": "해파리는 서로의 독에"
    },
    {
      "Id": 101470510,
      "Speaker": "Student",
      "Text": "영향을 안 받는대"
    },
    {
      "Id": 101470520,
      "Speaker": "Player",
      "Text": "몰랐어! 신기하네"
    },
    {
      "Id": 101470530,
      "Speaker": "Student",
      "Text": "말하자면"
    },
    {
      "Id": 101470540,
      "Speaker": "Student",
      "Text": "선생과 나 같은 거지"
    },
    {
      "Id": 101470550,
      "Speaker": "Player",
      "Text": "그렇게 말하니 더 모르겠는데……"
    },
    {
      "Id": 101470560,
      "Speaker": "Player",
      "Text": "아무튼 그런 걸로 하자"
    },
    {
      "Id": 101470570,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470580,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 101470590,
      "Speaker": "Player",
      "Text": "사츠키~"
    },
    {
      "Id": 101470600,
      "Speaker": "Student",
      "Text": "자외선 대책은 완료됐어?"
    },
    {
      "Id": 101470610,
      "Speaker": "Player",
      "Text": "물론이지!"
    },
    {
      "Id": 101470620,
      "Speaker": "Student",
      "Text": "해파리 대책은?"
    },
    {
      "Id": 101470630,
      "Speaker": "Player",
      "Text": "어떻게든 될 거야!"
    },
    {
      "Id": 101470640,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470650,
      "Speaker": "Student",
      "Text": "출발하자"
    },
    {
      "Id": 101470660,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "그런데 어디로……?"
    },
    {
      "Id": 101470670,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470680,
      "Speaker": "Student",
      "Text": "그거 알아?"
    },
    {
      "Id": 101470690,
      "Speaker": "Player",
      "Text": "아마 알걸?"
    },
    {
      "Id": 101470700,
      "Speaker": "Student",
      "Text": "내 기분을 알았다고?"
    },
    {
      "Id": 101470710,
      "Speaker": "Student",
      "Text": "역시 선생이네"
    },
    {
      "Id": 101470720,
      "Speaker": "Player",
      "Text": "아 그 이야기였어?"
    },
    {
      "Id": 101470730,
      "Speaker": "Player",
      "Text": "알듯 말듯……"
    },
    {
      "Id": 101470740,
      "Speaker": "Student",
      "Text": "사실 나도 잘 모르겠지만"
    },
    {
      "Id": 101470750,
      "Speaker": "Student",
      "Text": "뭐라고 해야 할지 모르겠어"
    },
    {
      "Id": 101470760,
      "Speaker": "Student",
      "Text": "아무튼 이상해"
    },
    {
      "Id": 101470770,
      "Speaker": "Player",
      "Text": "내가 도울 일이 있을까?"
    },
    {
      "Id": 101470780,
      "Speaker": "Student",
      "Text": "음~~~~"
    },
    {
      "Id": 101470790,
      "Speaker": "Student",
      "Text": "뭔가~~~~~"
    },
    {
      "Id": 101470800,
      "Speaker": "Student",
      "Text": "선생의 얼굴을 보고 싶은데"
    },
    {
      "Id": 101470810,
      "Speaker": "Player",
      "StoryEpisode": 5,
      "Text": "어디로 갈까?"
    },
    {
      "Id": 101470820,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470830,
      "Speaker": "Student",
      "Text": "사람은 익숙한 것을"
    },
    {
      "Id": 101470840,
      "Speaker": "Student",
      "Text": "당연하게 생각하게 된대"
    },
    {
      "Id": 101470850,
      "Speaker": "Player",
      "Text": "확실히 그럴지도……"
    },
    {
      "Id": 101470860,
      "Speaker": "Student",
      "Text": "그래서 미리 말해둘게"
    },
    {
      "Id": 101470870,
      "Speaker": "Player",
      "Text": "어떤 거?"
    },
    {
      "Id": 101470880,
      "Speaker": "Student",
      "Text": "앞으로도"
    },
    {
      "Id": 101470890,
      "Speaker": "Student",
      "Text": "계속 옆에 있을 거라고"
    },
    {
      "Id": 101470900,
      "Speaker": "Player",
      "Text": "익숙하게 만들려고?"
    },
    {
      "Id": 101470910,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 101470920,
      "Speaker": "Student",
      "Text": "그러다 보면"
    },
    {
      "Id": 101470930,
      "Speaker": "Student",
      "Text": "그게 당연해지겠지?"
    },
    {
      "Id": 101470940,
      "Speaker": "Player",
      "Text": "좋아"
    },
    {
      "Id": 101470950,
      "Speaker": "Student",
      "Text": "좋아"
    }
  ],
