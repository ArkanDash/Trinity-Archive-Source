{
  "CharacterId": 10147,
  "DialogJP": [
    {
      "Id": 101470010,
      "Speaker": "Student",
      "Text": "先生、ちょっといいかしら"
    },
    {
      "Id": 101470020,
      "Speaker": "Player",
      "Text": "大丈夫だよ。どうしたの？"
    },
    {
      "Id": 101470030,
      "Speaker": "Student",
      "Text": "先生は……"
    },
    {
      "Id": 101470040,
      "Speaker": "Student",
      "Text": "海がどれだけ危険な場所か"
    },
    {
      "Id": 101470050,
      "Speaker": "Student",
      "Text": "ちゃんと理解してるかしら？"
    },
    {
      "Id": 101470060,
      "Speaker": "Player",
      "Text": "いや、あんまり……"
    },
    {
      "Id": 101470070,
      "Speaker": "Student",
      "Text": "……これは直接説明した方がよさそうね"
    },
    {
      "Id": 101470080,
      "Speaker": "Student",
      "Text": "今から行くから、待っていて頂戴"
    },
    {
      "Id": 101470090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "う、うん。待ってるね……"
    },
    {
      "Id": 101470100,
      "Speaker": "Student",
      "Text": "私が教えた海の安全対策……"
    },
    {
      "Id": 101470110,
      "Speaker": "Student",
      "Text": "ちゃんと覚えているかしら？"
    },
    {
      "Id": 101470120,
      "Speaker": "Student",
      "Text": "忘れたらダメよ？"
    },
    {
      "Id": 101470130,
      "Speaker": "Player",
      "Text": "大丈夫、覚えてるよ！"
    },
    {
      "Id": 101470140,
      "Speaker": "Student",
      "Text": "それを聞いて安心したわ"
    },
    {
      "Id": 101470150,
      "Speaker": "Student",
      "Text": "でもまだ少し心配だから……"
    },
    {
      "Id": 101470160,
      "Speaker": "Student",
      "Text": "これからもずっと、私がそばでケアしてあげる"
    },
    {
      "Id": 101470170,
      "Speaker": "Player",
      "Text": "それはうれしいな"
    },
    {
      "Id": 101470180,
      "Speaker": "Student",
      "Text": "ふふ、でしょう？"
    },
    {
      "Id": 101470190,
      "Speaker": "Student",
      "Text": "それじゃあ、またね"
    },
    {
      "Id": 101470200,
      "Speaker": "Student",
      "Text": "海は、とても恐ろしい場所よ。"
    },
    {
      "Id": 101470210,
      "Speaker": "Player",
      "Text": "い、いきなりだね。"
    },
    {
      "Id": 101470220,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 101470230,
      "Speaker": "Student",
      "Text": "水の中だと息もできないし"
    },
    {
      "Id": 101470240,
      "Speaker": "Student",
      "Text": "自由に動けないわ"
    },
    {
      "Id": 101470250,
      "Speaker": "Student",
      "Text": "もし波にさらわれたりでもしたらと考えると――"
    },
    {
      "Id": 101470260,
      "Speaker": "Player",
      "Text": "たしかに、そう思うと怖いね……"
    },
    {
      "Id": 101470270,
      "Speaker": "Student",
      "Text": "危険なものからは距離を取る"
    },
    {
      "Id": 101470280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "それが一番よね"
    },
    {
      "Id": 101470290,
      "Speaker": "Student",
      "Text": "海って……"
    },
    {
      "Id": 101470300,
      "Speaker": "Student",
      "Text": "案外楽しい場所なのかもしれないわね"
    },
    {
      "Id": 101470310,
      "Speaker": "Student",
      "Text": "教えてくれて感謝するわ"
    },
    {
      "Id": 101470320,
      "Speaker": "Player",
      "Text": "そうでしょう？"
    },
    {
      "Id": 101470330,
      "Speaker": "Student",
      "Text": "でも油断は禁物よ"
    },
    {
      "Id": 101470340,
      "Speaker": "Student",
      "Text": "先生は慣れているみたいだけど"
    },
    {
      "Id": 101470350,
      "Speaker": "Student",
      "Text": "常に警戒を怠らないこと"
    },
    {
      "Id": 101470360,
      "Speaker": "Player",
      "Text": "うん、気をつけるよ"
    },
    {
      "Id": 101470370,
      "Speaker": "Student",
      "Text": "ふふ、いい返事ね"
    },
    {
      "Id": 101470380,
      "Speaker": "Student",
      "Text": "海ってとっても怖い場所よね"
    },
    {
      "Id": 101470390,
      "Speaker": "Student",
      "Text": "先生もそう思うでしょう？"
    },
    {
      "Id": 101470400,
      "Speaker": "Player",
      "Text": "デジャブだね"
    },
    {
      "Id": 101470410,
      "Speaker": "Player",
      "Text": "サツキはもう大丈夫じゃないの？"
    },
    {
      "Id": 101470420,
      "Speaker": "Student",
      "Text": "海のずぅっと深いところには――"
    },
    {
      "Id": 101470430,
      "Speaker": "Student",
      "Text": "恐ろしい何かが潜んでいる気がするの"
    },
    {
      "Id": 101470440,
      "Speaker": "Player",
      "Text": "そういうのもいるかもしれないね"
    },
    {
      "Id": 101470450,
      "Speaker": "Student",
      "Text": "浅いところなら平気かもしれないわ"
    },
    {
      "Id": 101470460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "だって、先生が守ってくれるもの"
    },
    {
      "Id": 101470470,
      "Speaker": "Student",
      "Text": "ねえ先生"
    },
    {
      "Id": 101470480,
      "Speaker": "Student",
      "Text": "知ってる？"
    },
    {
      "Id": 101470490,
      "Speaker": "Player",
      "Text": "多分しらないかも？"
    },
    {
      "Id": 101470500,
      "Speaker": "Student",
      "Text": "クラゲ同士って"
    },
    {
      "Id": 101470510,
      "Speaker": "Student",
      "Text": "お互いの毒が効かないらしいのよ"
    },
    {
      "Id": 101470520,
      "Speaker": "Player",
      "Text": "そうなんだ！すごいね！"
    },
    {
      "Id": 101470530,
      "Speaker": "Student",
      "Text": "つまり……"
    },
    {
      "Id": 101470540,
      "Speaker": "Student",
      "Text": "先生と私みたいな関係ってこと"
    },
    {
      "Id": 101470550,
      "Speaker": "Player",
      "Text": "よく分からないけど……"
    },
    {
      "Id": 101470560,
      "Speaker": "Player",
      "Text": "サツキが言うのなら、そうなのかもね"
    },
    {
      "Id": 101470570,
      "Speaker": "Student",
      "Text": "ふふっ、そうよ"
    },
    {
      "Id": 101470580,
      "Speaker": "Student",
      "Text": "ねぇ、先生に聞きたいことがあるの"
    },
    {
      "Id": 101470590,
      "Speaker": "Player",
      "Text": "いいよ。どうしたの？"
    },
    {
      "Id": 101470600,
      "Speaker": "Student",
      "Text": "紫外線対策はしてる？"
    },
    {
      "Id": 101470610,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 101470620,
      "Speaker": "Student",
      "Text": "クラゲ対策は？"
    },
    {
      "Id": 101470630,
      "Speaker": "Player",
      "Text": "大丈夫！"
    },
    {
      "Id": 101470640,
      "Speaker": "Student",
      "Text": "ふむ……いいでしょう"
    },
    {
      "Id": 101470650,
      "Speaker": "Student",
      "Text": "じゃあ、出発するわよ！"
    },
    {
      "Id": 101470660,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "どこに？"
    },
    {
      "Id": 101470670,
      "Speaker": "Student",
      "Text": "ああ、そういえば"
    },
    {
      "Id": 101470680,
      "Speaker": "Student",
      "Text": "先生は知っているかしら？"
    },
    {
      "Id": 101470690,
      "Speaker": "Player",
      "Text": "たぶん……？"
    },
    {
      "Id": 101470700,
      "Speaker": "Student",
      "Text": "あら？私の気持ちが分かったの？"
    },
    {
      "Id": 101470710,
      "Speaker": "Student",
      "Text": "さすが先生ね"
    },
    {
      "Id": 101470720,
      "Speaker": "Player",
      "Text": "そ、そういう話だったの？"
    },
    {
      "Id": 101470730,
      "Speaker": "Player",
      "Text": "分かるような、分からないような……"
    },
    {
      "Id": 101470740,
      "Speaker": "Student",
      "Text": "実は、私もよく分かっていないの"
    },
    {
      "Id": 101470750,
      "Speaker": "Student",
      "Text": "この気持ちは……なんと言うのかしら"
    },
    {
      "Id": 101470760,
      "Speaker": "Student",
      "Text": "なんだか落ち着かないわ"
    },
    {
      "Id": 101470770,
      "Speaker": "Player",
      "Text": "私に手伝えることはあるかな？"
    },
    {
      "Id": 101470780,
      "Speaker": "Student",
      "Text": "う～ん"
    },
    {
      "Id": 101470790,
      "Speaker": "Student",
      "Text": "そうね……"
    },
    {
      "Id": 101470800,
      "Speaker": "Student",
      "Text": "……先生の顔を見せて頂戴"
    },
    {
      "Id": 101470810,
      "Speaker": "Player",
      "StoryEpisode": 5,
      "Text": "分かった、今どこにいるの？"
    },
    {
      "Id": 101470820,
      "Speaker": "Student",
      "Text": "先生、聞いて"
    },
    {
      "Id": 101470830,
      "Speaker": "Student",
      "Text": "人はね、見慣れたものを"
    },
    {
      "Id": 101470840,
      "Speaker": "Student",
      "Text": "いつの間にか「当たり前」だと思い込むらしいわ"
    },
    {
      "Id": 101470850,
      "Speaker": "Player",
      "Text": "なるほど、そうかもしれないね"
    },
    {
      "Id": 101470860,
      "Speaker": "Student",
      "Text": "だから先に言っておくわ"
    },
    {
      "Id": 101470870,
      "Speaker": "Player",
      "Text": "何を？"
    },
    {
      "Id": 101470880,
      "Speaker": "Student",
      "Text": "これからも"
    },
    {
      "Id": 101470890,
      "Speaker": "Student",
      "Text": "ずっと隣にいるって"
    },
    {
      "Id": 101470900,
      "Speaker": "Player",
      "Text": "慣れさせるってこと？"
    },
    {
      "Id": 101470910,
      "Speaker": "Student",
      "Text": "ええ"
    },
    {
      "Id": 101470920,
      "Speaker": "Student",
      "Text": "そうしていれば"
    },
    {
      "Id": 101470930,
      "Speaker": "Student",
      "Text": "いつか、それが当たり前になるでしょう？"
    },
    {
      "Id": 101470940,
      "Speaker": "Player",
      "Text": "うん、そうだね"
    },
    {
      "Id": 101470950,
      "Speaker": "Student",
      "Text": "そうよ。ふふっ"
    }
  ],
  "DialogKR": [
    {
      "Id": 101470010,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 101470020,
      "Speaker": "Player",
      "Text": "사츠키~"
    },
    {
      "Id": 101470030,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 101470040,
      "Speaker": "Student",
      "Text": "해변이 얼마나 위험한지"
    },
    {
      "Id": 101470050,
      "Speaker": "Student",
      "Text": "알고 있겠지?"
    },
    {
      "Id": 101470060,
      "Speaker": "Player",
      "Text": "그랬던가……"
    },
    {
      "Id": 101470070,
      "Speaker": "Student",
      "Text": "이건 만나서 설명하는 편이 낫겠네"
    },
    {
      "Id": 101470080,
      "Speaker": "Student",
      "Text": "지금 갈게~!"
    },
    {
      "Id": 101470090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "왠지 익숙한 기분이……"
    },
    {
      "Id": 101470100,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 101470110,
      "Speaker": "Student",
      "Text": "오늘의 안전 대책"
    },
    {
      "Id": 101470120,
      "Speaker": "Student",
      "Text": "잊으면 안 돼?"
    },
    {
      "Id": 101470130,
      "Speaker": "Player",
      "Text": "물론이지"
    },
    {
      "Id": 101470140,
      "Speaker": "Student",
      "Text": "그래도 혹시 모르니"
    },
    {
      "Id": 101470150,
      "Speaker": "Student",
      "Text": "앞으로도 계속"
    },
    {
      "Id": 101470160,
      "Speaker": "Student",
      "Text": "내가 옆에서 케어하겠어"
    },
    {
      "Id": 101470170,
      "Speaker": "Player",
      "Text": "나야 고마워"
    },
    {
      "Id": 101470180,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 101470190,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470200,
      "Speaker": "Student",
      "Text": "바다는 아주 무서운 곳이지?"
    },
    {
      "Id": 101470210,
      "Speaker": "Player",
      "Text": "갑자기?"
    },
    {
      "Id": 101470220,
      "Speaker": "Player",
      "Text": "무슨 일 있었어?"
    },
    {
      "Id": 101470230,
      "Speaker": "Student",
      "Text": "물속에서는 숨도 못 쉬고"
    },
    {
      "Id": 101470240,
      "Speaker": "Student",
      "Text": "마음대로 움직이지도 못하니까"
    },
    {
      "Id": 101470250,
      "Speaker": "Student",
      "Text": "파도에 쓸려가기라도 하면"
    },
    {
      "Id": 101470260,
      "Speaker": "Player",
      "Text": "확실히 무서운 일이긴 하지……"
    },
    {
      "Id": 101470270,
      "Speaker": "Student",
      "Text": "위험을 멀리하는 것이"
    },
    {
      "Id": 101470280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "현명한 판단이겠지"
    },
    {
      "Id": 101470290,
      "Speaker": "Student",
      "Text": "바다란……"
    },
    {
      "Id": 101470300,
      "Speaker": "Student",
      "Text": "의외로 즐거운 곳일지도 모르겠네"
    },
    {
      "Id": 101470310,
      "Speaker": "Student",
      "Text": "알려줘서 고마워"
    },
    {
      "Id": 101470320,
      "Speaker": "Player",
      "Text": "그치?"
    },
    {
      "Id": 101470330,
      "Speaker": "Student",
      "Text": "하지만 방심은 금물이야"
    },
    {
      "Id": 101470340,
      "Speaker": "Student",
      "Text": "선생은 제법 익숙한 것 같지만"
    },
    {
      "Id": 101470350,
      "Speaker": "Student",
      "Text": "항상 조심하도록 해"
    },
    {
      "Id": 101470360,
      "Speaker": "Player",
      "Text": "응 조심할게"
    },
    {
      "Id": 101470370,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470380,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470390,
      "Speaker": "Student",
      "Text": "바다는 아주 무서운 곳이지?"
    },
    {
      "Id": 101470400,
      "Speaker": "Player",
      "Text": "이 흐름 익숙한데"
    },
    {
      "Id": 101470410,
      "Speaker": "Player",
      "Text": "이제 괜찮지 않아?"
    },
    {
      "Id": 101470420,
      "Speaker": "Student",
      "Text": "바다 깊은 곳에는"
    },
    {
      "Id": 101470430,
      "Speaker": "Student",
      "Text": "무서운 뭔가가 있을 것 같아"
    },
    {
      "Id": 101470440,
      "Speaker": "Player",
      "Text": "그럴지도 모르지만……"
    },
    {
      "Id": 101470450,
      "Speaker": "Student",
      "Text": "얕은 곳은 괜찮겠지?"
    },
    {
      "Id": 101470460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "선생이 지켜줄 테니까"
    },
    {
      "Id": 101470470,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470480,
      "Speaker": "Student",
      "Text": "그거 알아?"
    },
    {
      "Id": 101470490,
      "Speaker": "Player",
      "Text": "아마 모를걸?"
    },
    {
      "Id": 101470500,
      "Speaker": "Student",
      "Text": "해파리는 서로의 독에"
    },
    {
      "Id": 101470510,
      "Speaker": "Student",
      "Text": "영향을 안 받는대"
    },
    {
      "Id": 101470520,
      "Speaker": "Player",
      "Text": "몰랐어! 신기하네"
    },
    {
      "Id": 101470530,
      "Speaker": "Student",
      "Text": "말하자면"
    },
    {
      "Id": 101470540,
      "Speaker": "Student",
      "Text": "선생과 나 같은 거지"
    },
    {
      "Id": 101470550,
      "Speaker": "Player",
      "Text": "그렇게 말하니 더 모르겠는데……"
    },
    {
      "Id": 101470560,
      "Speaker": "Player",
      "Text": "아무튼 그런 걸로 하자"
    },
    {
      "Id": 101470570,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470580,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 101470590,
      "Speaker": "Player",
      "Text": "사츠키~"
    },
    {
      "Id": 101470600,
      "Speaker": "Student",
      "Text": "자외선 대책은 완료됐어?"
    },
    {
      "Id": 101470610,
      "Speaker": "Player",
      "Text": "물론이지!"
    },
    {
      "Id": 101470620,
      "Speaker": "Student",
      "Text": "해파리 대책은?"
    },
    {
      "Id": 101470630,
      "Speaker": "Player",
      "Text": "어떻게든 될 거야!"
    },
    {
      "Id": 101470640,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 101470650,
      "Speaker": "Student",
      "Text": "출발하자"
    },
    {
      "Id": 101470660,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "그런데 어디로……?"
    },
    {
      "Id": 101470670,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470680,
      "Speaker": "Student",
      "Text": "그거 알아?"
    },
    {
      "Id": 101470690,
      "Speaker": "Player",
      "Text": "아마 알걸?"
    },
    {
      "Id": 101470700,
      "Speaker": "Student",
      "Text": "내 기분을 알았다고?"
    },
    {
      "Id": 101470710,
      "Speaker": "Student",
      "Text": "역시 선생이네"
    },
    {
      "Id": 101470720,
      "Speaker": "Player",
      "Text": "아 그 이야기였어?"
    },
    {
      "Id": 101470730,
      "Speaker": "Player",
      "Text": "알듯 말듯……"
    },
    {
      "Id": 101470740,
      "Speaker": "Student",
      "Text": "사실 나도 잘 모르겠지만"
    },
    {
      "Id": 101470750,
      "Speaker": "Student",
      "Text": "뭐라고 해야 할지 모르겠어"
    },
    {
      "Id": 101470760,
      "Speaker": "Student",
      "Text": "아무튼 이상해"
    },
    {
      "Id": 101470770,
      "Speaker": "Player",
      "Text": "내가 도울 일이 있을까?"
    },
    {
      "Id": 101470780,
      "Speaker": "Student",
      "Text": "음~~~~"
    },
    {
      "Id": 101470790,
      "Speaker": "Student",
      "Text": "뭔가~~~~~"
    },
    {
      "Id": 101470800,
      "Speaker": "Student",
      "Text": "선생의 얼굴을 보고 싶은데"
    },
    {
      "Id": 101470810,
      "Speaker": "Player",
      "StoryEpisode": 5,
      "Text": "어디로 갈까?"
    },
    {
      "Id": 101470820,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 101470830,
      "Speaker": "Student",
      "Text": "사람은 익숙한 것을"
    },
    {
      "Id": 101470840,
      "Speaker": "Student",
      "Text": "당연하게 생각하게 된대"
    },
    {
      "Id": 101470850,
      "Speaker": "Player",
      "Text": "확실히 그럴지도……"
    },
    {
      "Id": 101470860,
      "Speaker": "Student",
      "Text": "그래서 미리 말해둘게"
    },
    {
      "Id": 101470870,
      "Speaker": "Player",
      "Text": "어떤 거?"
    },
    {
      "Id": 101470880,
      "Speaker": "Student",
      "Text": "앞으로도"
    },
    {
      "Id": 101470890,
      "Speaker": "Student",
      "Text": "계속 옆에 있을 거라고"
    },
    {
      "Id": 101470900,
      "Speaker": "Player",
      "Text": "익숙하게 만들려고?"
    },
    {
      "Id": 101470910,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 101470920,
      "Speaker": "Student",
      "Text": "그러다 보면"
    },
    {
      "Id": 101470930,
      "Speaker": "Student",
      "Text": "그게 당연해지겠지?"
    },
    {
      "Id": 101470940,
      "Speaker": "Player",
      "Text": "좋아"
    },
    {
      "Id": 101470950,
      "Speaker": "Student",
      "Text": "좋아"
    }
  ],
  "DialogEN": [
    {
      "Id": 101470010,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 101470020,
      "Speaker": "Player",
      "Text": "Satsuki!"
    },
    {
      "Id": 101470030,
      "Speaker": "Student",
      "Text": "Fufu."
    },
    {
      "Id": 101470040,
      "Speaker": "Student",
      "Text": "You already know"
    },
    {
      "Id": 101470050,
      "Speaker": "Student",
      "Text": "how dangerous the ocean can be, right?"
    },
    {
      "Id": 101470060,
      "Speaker": "Player",
      "Text": "I do...?"
    },
    {
      "Id": 101470070,
      "Speaker": "Student",
      "Text": "It's best to explain this in person."
    },
    {
      "Id": 101470080,
      "Speaker": "Student",
      "Text": "I'll be there soon!"
    },
    {
      "Id": 101470090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "I'm getting deja vu..."
    },
    {
      "Id": 101470100,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 101470110,
      "Speaker": "Student",
      "Text": "You can't forget the proper safety measures"
    },
    {
      "Id": 101470120,
      "Speaker": "Student",
      "Text": "for today, okay?!"
    },
    {
      "Id": 101470130,
      "Speaker": "Player",
      "Text": "Of course."
    },
    {
      "Id": 101470140,
      "Speaker": "Student",
      "Text": "Just to be safe,"
    },
    {
      "Id": 101470150,
      "Speaker": "Student",
      "Text": "I'll still"
    },
    {
      "Id": 101470160,
      "Speaker": "Student",
      "Text": "keep an eye on you."
    },
    {
      "Id": 101470170,
      "Speaker": "Player",
      "Text": "Thank you."
    },
    {
      "Id": 101470180,
      "Speaker": "Student",
      "Text": "Fufu."
    },
    {
      "Id": 101470190,
      "Speaker": "Student",
      "Text": "Good."
    },
    {
      "Id": 101470200,
      "Speaker": "Student",
      "Text": "The sea is a very scary place, isn't it?"
    },
    {
      "Id": 101470210,
      "Speaker": "Player",
      "Text": "Why do you say that?"
    },
    {
      "Id": 101470220,
      "Speaker": "Player",
      "Text": "Did something happen?"
    },
    {
      "Id": 101470230,
      "Speaker": "Student",
      "Text": "It's just that you can't breathe underwater"
    },
    {
      "Id": 101470240,
      "Speaker": "Student",
      "Text": "or move freely."
    },
    {
      "Id": 101470250,
      "Speaker": "Student",
      "Text": "And if you get swept away by the waves..."
    },
    {
      "Id": 101470260,
      "Speaker": "Player",
      "Text": "That IS a scary thought."
    },
    {
      "Id": 101470270,
      "Speaker": "Student",
      "Text": "The smartest thing to do"
    },
    {
      "Id": 101470280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "is distance yourself from things that threaten your safety."
    },
    {
      "Id": 101470290,
      "Speaker": "Student",
      "Text": "The beach..."
    },
    {
      "Id": 101470300,
      "Speaker": "Student",
      "Text": "It actually can be fun."
    },
    {
      "Id": 101470310,
      "Speaker": "Student",
      "Text": "Thank you for teaching me that."
    },
    {
      "Id": 101470320,
      "Speaker": "Player",
      "Text": "I'm glad you think so!"
    },
    {
      "Id": 101470330,
      "Speaker": "Student",
      "Text": "Still. Never let your guard down."
    },
    {
      "Id": 101470340,
      "Speaker": "Student",
      "Text": "You have good judgment,"
    },
    {
      "Id": 101470350,
      "Speaker": "Student",
      "Text": "but you should still exercise caution."
    },
    {
      "Id": 101470360,
      "Speaker": "Player",
      "Text": "Will do, Satsuki"
    },
    {
      "Id": 101470370,
      "Speaker": "Student",
      "Text": "Good."
    },
    {
      "Id": 101470380,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101470390,
      "Speaker": "Student",
      "Text": "The sea is a very scary place, isn't it?"
    },
    {
      "Id": 101470400,
      "Speaker": "Player",
      "Text": "I feel like I've heard this before..."
    },
    {
      "Id": 101470410,
      "Speaker": "Player",
      "Text": "I thought it was fun now"
    },
    {
      "Id": 101470420,
      "Speaker": "Student",
      "Text": "I have a feeling..."
    },
    {
      "Id": 101470430,
      "Speaker": "Student",
      "Text": "there's something very scary down in the depths of the sea"
    },
    {
      "Id": 101470440,
      "Speaker": "Player",
      "Text": "I technically can't disprove that..."
    },
    {
      "Id": 101470450,
      "Speaker": "Student",
      "Text": "It should be safe in the shallows"
    },
    {
      "Id": 101470460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Since you'll be there to protect me"
    },
    {
      "Id": 101470470,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 101470480,
      "Speaker": "Student",
      "Text": "...Did you know?"
    },
    {
      "Id": 101470490,
      "Speaker": "Player",
      "Text": "Probably not!"
    },
    {
      "Id": 101470500,
      "Speaker": "Student",
      "Text": "Jellyfish"
    },
    {
      "Id": 101470510,
      "Speaker": "Student",
      "Text": "are immune to each other's venom."
    },
    {
      "Id": 101470520,
      "Speaker": "Player",
      "Text": "Whoa! That's a fun fact."
    },
    {
      "Id": 101470530,
      "Speaker": "Student",
      "Text": "In other words..."
    },
    {
      "Id": 101470540,
      "Speaker": "Student",
      "Text": "They're just like you and me, Sensei"
    },
    {
      "Id": 101470550,
      "Speaker": "Player",
      "Text": "You lost me there..."
    },
    {
      "Id": 101470560,
      "Speaker": "Player",
      "Text": "I'll just smile and nod."
    },
    {
      "Id": 101470570,
      "Speaker": "Student",
      "Text": "Good."
    },
    {
      "Id": 101470580,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 101470590,
      "Speaker": "Player",
      "Text": "Satsuki!"
    },
    {
      "Id": 101470600,
      "Speaker": "Student",
      "Text": "Do you have sufficient UV protection?"
    },
    {
      "Id": 101470610,
      "Speaker": "Player",
      "Text": "Of course!"
    },
    {
      "Id": 101470620,
      "Speaker": "Student",
      "Text": "And you've protected yourself against jellyfish attacks?"
    },
    {
      "Id": 101470630,
      "Speaker": "Player",
      "Text": "Sure, sure!"
    },
    {
      "Id": 101470640,
      "Speaker": "Student",
      "Text": "Good."
    },
    {
      "Id": 101470650,
      "Speaker": "Student",
      "Text": "Then let us be off!"
    },
    {
      "Id": 101470660,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "To where exactly...?"
    },
    {
      "Id": 101470670,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101470680,
      "Speaker": "Student",
      "Text": "Do you know...?"
    },
    {
      "Id": 101470690,
      "Speaker": "Player",
      "Text": "Probably!"
    },
    {
      "Id": 101470700,
      "Speaker": "Student",
      "Text": "You know how I'm feeling?!"
    },
    {
      "Id": 101470710,
      "Speaker": "Student",
      "Text": "You really are THE Sensei."
    },
    {
      "Id": 101470720,
      "Speaker": "Player",
      "Text": "Oh... That's what you meant."
    },
    {
      "Id": 101470730,
      "Speaker": "Player",
      "Text": "Maybe I do, maybe I don't..."
    },
    {
      "Id": 101470740,
      "Speaker": "Student",
      "Text": "I don't know if I even know."
    },
    {
      "Id": 101470750,
      "Speaker": "Student",
      "Text": "I don't know how to put it into words."
    },
    {
      "Id": 101470760,
      "Speaker": "Student",
      "Text": "The point is, it's weird."
    },
    {
      "Id": 101470770,
      "Speaker": "Player",
      "Text": "Is there any way I can help?"
    },
    {
      "Id": 101470780,
      "Speaker": "Student",
      "Text": "Hmm..."
    },
    {
      "Id": 101470790,
      "Speaker": "Student",
      "Text": "For some reason..."
    },
    {
      "Id": 101470800,
      "Speaker": "Student",
      "Text": "I want to see you."
    },
    {
      "Id": 101470810,
      "Speaker": "Player",
      "StoryEpisode": 5,
      "Text": "I can come to you."
    },
    {
      "Id": 101470820,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101470830,
      "Speaker": "Student",
      "Text": "They say people tend to make habits"
    },
    {
      "Id": 101470840,
      "Speaker": "Student",
      "Text": "out of familiar things."
    },
    {
      "Id": 101470850,
      "Speaker": "Player",
      "Text": "That's a well-known saying."
    },
    {
      "Id": 101470860,
      "Speaker": "Student",
      "Text": "So I have something to say"
    },
    {
      "Id": 101470870,
      "Speaker": "Player",
      "Text": "Yes?"
    },
    {
      "Id": 101470880,
      "Speaker": "Student",
      "Text": "I'll stay"
    },
    {
      "Id": 101470890,
      "Speaker": "Student",
      "Text": "by your side."
    },
    {
      "Id": 101470900,
      "Speaker": "Player",
      "Text": "So we can be familiar?"
    },
    {
      "Id": 101470910,
      "Speaker": "Student",
      "Text": "Yeah"
    },
    {
      "Id": 101470920,
      "Speaker": "Student",
      "Text": "That way..."
    },
    {
      "Id": 101470930,
      "Speaker": "Student",
      "Text": "I'll become a habit, right?"
    },
    {
      "Id": 101470940,
      "Speaker": "Player",
      "Text": "Right."
    },
    {
      "Id": 101470950,
      "Speaker": "Student",
      "Text": "Good."
    }
  ],
  "DialogTH": [
    {
      "Id": 101470010,
      "Speaker": "Student",
      "Text": "ครู~"
    },
    {
      "Id": 101470020,
      "Speaker": "Player",
      "Text": "ซัตสึกิ~"
    },
    {
      "Id": 101470030,
      "Speaker": "Student",
      "Text": "ฮุฮุ"
    },
    {
      "Id": 101470040,
      "Speaker": "Student",
      "Text": "รู้ใช่มั้ยว่า"
    },
    {
      "Id": 101470050,
      "Speaker": "Student",
      "Text": "ชายหาดอันตรายแค่ไหน?"
    },
    {
      "Id": 101470060,
      "Speaker": "Player",
      "Text": "เคยเป็นอย่างนั้นด้วยเหรอ..."
    },
    {
      "Id": 101470070,
      "Speaker": "Student",
      "Text": "เรื่องนี้ไว้อธิบายตอนเจอกันดีกว่า"
    },
    {
      "Id": 101470080,
      "Speaker": "Student",
      "Text": "เดี๋ยวฉันไปหานะ~!"
    },
    {
      "Id": 101470090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "รู้สึกคุ้นๆ ยังไงก็ไม่รู้..."
    },
    {
      "Id": 101470100,
      "Speaker": "Student",
      "Text": "ครู~"
    },
    {
      "Id": 101470110,
      "Speaker": "Student",
      "Text": "มาตรการความปลอดภัยวันนี้"
    },
    {
      "Id": 101470120,
      "Speaker": "Student",
      "Text": "ห้ามลืมเลยนะ?"
    },
    {
      "Id": 101470130,
      "Speaker": "Player",
      "Text": "แน่นอนอยู่แล้ว"
    },
    {
      "Id": 101470140,
      "Speaker": "Student",
      "Text": "ถึงอย่างนั้นก็ไม่รู้ว่าจะเกิดอะไรขึ้น"
    },
    {
      "Id": 101470150,
      "Speaker": "Student",
      "Text": "ต่อจากนี้ไป"
    },
    {
      "Id": 101470160,
      "Speaker": "Student",
      "Text": "ฉันจะคอยดูแลอยู่ใกล้ๆ เอง"
    },
    {
      "Id": 101470170,
      "Speaker": "Player",
      "Text": "ครูต่างหากที่ต้องขอบใจ"
    },
    {
      "Id": 101470180,
      "Speaker": "Student",
      "Text": "ฮุฮุ"
    },
    {
      "Id": 101470190,
      "Speaker": "Student",
      "Text": "ดีละ"
    },
    {
      "Id": 101470200,
      "Speaker": "Student",
      "Text": "ทะเลเป็นที่ที่น่ากลัวมากใช่มั้ย?"
    },
    {
      "Id": 101470210,
      "Speaker": "Player",
      "Text": "จู่ๆ ก็มาถามแบบนี้เลยเหรอ?"
    },
    {
      "Id": 101470220,
      "Speaker": "Player",
      "Text": "เกิดอะไรขึ้นหรือเปล่า?"
    },
    {
      "Id": 101470230,
      "Speaker": "Student",
      "Text": "ก็ใต้น้ำน่ะ เราหายใจก็ไม่ได้"
    },
    {
      "Id": 101470240,
      "Speaker": "Student",
      "Text": "จะขยับตัวตามใจก็ไม่ได้ด้วย"
    },
    {
      "Id": 101470250,
      "Speaker": "Student",
      "Text": "ถ้าโดนคลื่นซัดหายไป"
    },
    {
      "Id": 101470260,
      "Speaker": "Player",
      "Text": "ก็คงเป็นเรื่องน่ากลัวจริงๆ นั่นแหละ..."
    },
    {
      "Id": 101470270,
      "Speaker": "Student",
      "Text": "การอยู่ห่างจากอันตราย"
    },
    {
      "Id": 101470280,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "คงเป็นการตัดสินใจที่ฉลาดสินะ"
    },
    {
      "Id": 101470290,
      "Speaker": "Student",
      "Text": "ทะเลน่ะ..."
    },
    {
      "Id": 101470300,
      "Speaker": "Student",
      "Text": "อาจเป็นที่ที่สนุกกว่าที่คิดก็ได้นะ"
    },
    {
      "Id": 101470310,
      "Speaker": "Student",
      "Text": "ขอบคุณที่บอกนะ"
    },
    {
      "Id": 101470320,
      "Speaker": "Player",
      "Text": "ใช่มั้ยล่ะ?"
    },
    {
      "Id": 101470330,
      "Speaker": "Student",
      "Text": "แต่ก็ประมาทไม่ได้หรอกนะ"
    },
    {
      "Id": 101470340,
      "Speaker": "Student",
      "Text": "ดูเหมือนครูจะชำนาญไม่ใช่เล่นเลย"
    },
    {
      "Id": 101470350,
      "Speaker": "Student",
      "Text": "แต่ก็ระวังตัวไว้ตลอดนะ"
    },
    {
      "Id": 101470360,
      "Speaker": "Player",
      "Text": "อืม จะระวังนะ"
    },
    {
      "Id": 101470370,
      "Speaker": "Student",
      "Text": "ดีละ"
    },
    {
      "Id": 101470380,
      "Speaker": "Student",
      "Text": "ครู"
    },
    {
      "Id": 101470390,
      "Speaker": "Student",
      "Text": "ทะเลเป็นที่ที่น่ากลัวมากใช่มั้ย?"
    },
    {
      "Id": 101470400,
      "Speaker": "Player",
      "Text": "เหมือนเคยเจอคำถามนี้แล้วแฮะ"
    },
    {
      "Id": 101470410,
      "Speaker": "Player",
      "Text": "ตอนนี้โอเคแล้วไม่ใช่เหรอ?"
    },
    {
      "Id": 101470420,
      "Speaker": "Student",
      "Text": "รู้สึกเหมือนในส่วนลึกของทะเล"
    },
    {
      "Id": 101470430,
      "Speaker": "Student",
      "Text": "จะมีอะไรที่น่ากลัวอยู่"
    },
    {
      "Id": 101470440,
      "Speaker": "Player",
      "Text": "อาจจะเป็นอย่างนั้นก็ได้..."
    },
    {
      "Id": 101470450,
      "Speaker": "Student",
      "Text": "แต่ที่ตื้นๆ คงไม่เป็นไรหรอกเนอะ?"
    },
    {
      "Id": 101470460,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "เพราะครูจะคอยปกป้องให้ไง"
    },
    {
      "Id": 101470470,
      "Speaker": "Student",
      "Text": "ครู"
    },
    {
      "Id": 101470480,
      "Speaker": "Student",
      "Text": "รู้หรือเปล่า?"
    },
    {
      "Id": 101470490,
      "Speaker": "Player",
      "Text": "น่าจะไม่รู้นะ?"
    },
    {
      "Id": 101470500,
      "Speaker": "Student",
      "Text": "ว่ากันว่าแมงกะพรุนไม่ได้รับผลกระทบ"
    },
    {
      "Id": 101470510,
      "Speaker": "Student",
      "Text": "จากพิษของกันและกันนะ"
    },
    {
      "Id": 101470520,
      "Speaker": "Player",
