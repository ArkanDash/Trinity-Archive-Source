      "Text": "네?"
    },
    {
      "Id": 160170730,
      "Speaker": "Student",
      "Text": "선생님ㄲ서"
    },
    {
      "Id": 160170740,
      "Speaker": "Student",
      "Text": "아 아니요"
    },
    {
      "Id": 160170750,
      "Speaker": "Student",
      "Text": "아녜요 그런 의미로"
    },
    {
      "Id": 160170760,
      "Speaker": "Student",
      "Text": "한 말이ㅣ"
    },
    {
      "Id": 160170770,
      "Speaker": "Student",
      "Text": "아니라"
    },
    {
      "Id": 160170780,
      "Speaker": "Student",
      "Text": "!!!!"
    },
    {
      "Id": 160170790,
      "Speaker": "Player",
      "Text": "돕게 해줄래? 금방 끝날지도 모르잖아"
