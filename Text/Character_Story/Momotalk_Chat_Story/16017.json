    {
      "Id": 160170450,
      "Speaker": "Student",
      "Text": "それでは、今日はこれで"
    },
    {
      "Id": 160170460,
      "Speaker": "Student",
      "Text": "先生、アオバですけど……"
    },
    {
      "Id": 160170470,
      "Speaker": "Student",
      "Text": "何か壊れてるものとか"
    },
    {
      "Id": 160170480,
      "Speaker": "Student",
      "Text": "生活する上で不便なこと、ありますか……？"
    },
    {
      "Id": 160170490,
      "Speaker": "Player",
      "Text": "そういえば……"
    },
    {
      "Id": 160170500,
      "Speaker": "Student",
      "Text": "何かあるんですね！？"
    },
    {
      "Id": 160170510,
      "Speaker": "Player",
      "Text": "コーヒーポットが壊れちゃってね……"
    },
    {
      "Id": 160170520,
      "Speaker": "Student",
      "Text": "すぐにいきます！！"
    },
    {
      "Id": 160170530,
      "Speaker": "Student",
      "Text": "待ってててくくくください！！"
    },
    {
      "Id": 160170540,
      "Speaker": "Player",
      "Text": "いや、そんなに急ぎじゃ……"
    },
    {
      "Id": 160170550,
      "Speaker": "Student",
