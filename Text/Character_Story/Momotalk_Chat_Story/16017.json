    {
      "Id": 160170090,
      "Speaker": "Player",
      "Text": "もちろん！"
    },
    {
      "Id": 160170100,
      "Speaker": "Player",
      "Text": "なんでも聞いて"
    },
    {
      "Id": 160170110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "わ、ありがとうございます……"
    },
    {
      "Id": 160170120,
      "Speaker": "Student",
      "Text": "先生、今日は本当に……"
    },
    {
      "Id": 160170130,
      "Speaker": "Student",
      "Text": "ありがとうございました"
    },
    {
      "Id": 160170140,
      "Speaker": "Student",
      "Text": "こんなにいただいてしまって……"
    },
    {
      "Id": 160170150,
      "Speaker": "Player",
      "Text": "いいんだよ"
    },
    {
      "Id": 160170160,
      "Speaker": "Player",
      "Text": "そういえば、聞きたいことがあるって言ってなかった？"
    },
    {
      "Id": 160170170,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 160170180,
      "Speaker": "Student",
      "Text": "それは……"
    },
    {
      "Id": 160170190,
      "Speaker": "Student",
      "Text": "また今度でもいいですか？"
    },
    {
      "Id": 160170200,
      "Speaker": "Player",
      "Text": "もちろん、いつでもいいよ"
    },
    {
      "Id": 160170210,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    },
    {
      "Id": 160170220,
      "Speaker": "Student",
      "Text": "次があれば、ですが……"
    },
    {
      "Id": 160170230,
      "Speaker": "Student",
      "Text": "それではまた"
    },
    {
      "Id": 160170240,
      "Speaker": "Student",
      "Text": "お会いでき　い　なうお"
    },
    {
      "Id": 160170250,
      "Speaker": "Player",
      "Text": "アオバ？？"
    },
    {
      "Id": 160170260,
      "Speaker": "Student",
      "Text": "なんでもないです！"
    },
    {
      "Id": 160170270,
      "Speaker": "Student",
      "Text": "先生……"
    },
    {
      "Id": 160170280,
      "Speaker": "Student",
      "Text": "アオバ……です"
    },
    {
      "Id": 160170290,
      "Speaker": "Student",
      "Text": "急で申し訳ないのですが……"
    },
    {
      "Id": 160170300,
      "Speaker": "Student",
      "Text": "もしお忙しくないのでしたら……"
    },
    {
      "Id": 160170310,
      "Speaker": "Student",
      "Text": "手伝っていただきたいことが……"
    },
    {
      "Id": 160170320,
      "Speaker": "Player",
      "Text": "もちろん。どこに行けばいい？"
    },
    {
      "Id": 160170330,
      "Speaker": "Student",
      "Text": "あっ……！"
    },
    {
      "Id": 160170340,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 160170350,
      "Speaker": "Student",
      "Text": "こんなにすぐ返事をいただけるなんて；＠・！；！"
    },
    {
      "Id": 160170360,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "それで……場所がですね……"
    },
    {
      "Id": 160170370,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 160170380,
      "Speaker": "Student",
      "Text": "今日は本当にありがとうございました"
    },
    {
      "Id": 160170390,
      "Speaker": "Student",
      "Text": "私ばかり助けてもらっているので"
    },
    {
      "Id": 160170400,
      "Speaker": "Student",
      "Text": "何かお力になれることがあれば"
    },
    {
      "Id": 160170410,
      "Speaker": "Student",
      "Text": "遠慮なく呼んでほしいですけど"
    },
    {
      "Id": 160170420,
      "Speaker": "Player",
      "Text": "うん。分かったよ"
    },
    {
      "Id": 160170430,
      "Speaker": "Player",
      "Text": "アオバも、今日はお疲れ様"
    },
    {
      "Id": 160170440,
      "Speaker": "Student",
      "Text": "こちらこそ、先生のおかげで助かりました"
