{
  "CharacterId": 20025,
  "DialogJP": [
    {
      "Id": 200250010,
      "Speaker": "Student",
      "Text": "新年あけましておめでとうございます。（あなたの名前）でございます"
    },
    {
      "Id": 200250020,
      "Speaker": "Student",
      "Text": "（受け取る側の名前）様が幸多き一年になりますよう"
    },
    {
      "Id": 200250030,
      "Speaker": "Student",
      "Text": "心からお祈り申し上げます"
    },
    {
      "Id": 200250040,
      "Speaker": "Student",
      "Text": "本年もどうぞよろしくお願いいたします。（あなたの名前）"
    },
    {
      "Id": 200250050,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 200250060,
      "Speaker": "Player",
      "Text": "あ！ありがとう、ハルカ！"
    },
    {
      "Id": 200250070,
      "Speaker": "Player",
      "Text": "今年もよろしくね！"
    },
    {
      "Id": 200250080,
      "Speaker": "Student",
      "Text": "あっ"
    },
    {
      "Id": 200250090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "はい！！"
    },
    {
      "Id": 200250100,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200250110,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 200250120,
      "Speaker": "Student",
      "Text": "えっと"
    },
    {
      "Id": 200250130,
      "Speaker": "Student",
      "Text": "私を探していたと聞いて"
    },
    {
      "Id": 200250140,
      "Speaker": "Player",
      "Text": "うん、連絡ありがとう"
    },
    {
      "Id": 200250150,
      "Speaker": "Player",
      "Text": "今、時間大丈夫？"
    },
    {
      "Id": 200250160,
      "Speaker": "Student",
      "Text": "え？"
    },
    {
      "Id": 200250170,
      "Speaker": "Student",
      "Text": "あっはい今すぐ行きます"
    },
    {
      "Id": 200250180,
      "Speaker": "Student",
      "Text": "私が伺いますので先生は待っていてください"
    },
    {
      "Id": 200250190,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "呼んでくださってありがとうございます"
    },
    {
      "Id": 200250200,
      "Speaker": "Student",
      "Text": "ありがとうございます、先生。お陰で家に帰るまで暖かかったです"
    },
    {
      "Id": 200250210,
      "Speaker": "Player",
      "Text": "そっか。よかった"
    },
    {
      "Id": 200250220,
      "Speaker": "Student",
      "Text": "いただいたカイロは特殊加工して金庫に入れました。家宝として命に替えても守り抜きます"
    },
    {
      "Id": 200250230,
      "Speaker": "Player",
      "Text": "うん"
    },
    {
      "Id": 200250240,
      "Speaker": "Player",
      "Text": "……んん？"
    },
    {
      "Id": 200250250,
      "Speaker": "Student",
      "Text": "ここ最近風が冷たいので、風邪をひかないように防寒対策してください"
    },
    {
      "Id": 200250260,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 200250270,
      "Speaker": "Student",
      "Text": "いえ"
    },
    {
      "Id": 200250280,
      "Speaker": "Student",
      "Text": "なんか命令するみたいになってしまいましたが"
    },
    {
      "Id": 200250290,
      "Speaker": "Student",
      "Text": "こんな書き方をしようと思っていたのではなくて"
    },
    {
      "Id": 200250300,
      "Speaker": "Student",
      "Text": "いえ、こんな書き方をしようと思っていたのではないのではなくて"
    },
    {
      "Id": 200250310,
      "Speaker": "Student",
      "Text": "いえ"
    },
    {
      "Id": 200250320,
      "Speaker": "Student",
      "Text": "すみませんすみませんすみませんすみません"
    },
    {
      "Id": 200250330,
      "Speaker": "Player",
      "Text": "大丈夫、伝わっているよ"
    },
    {
      "Id": 200250340,
      "Speaker": "Player",
      "Text": "ありがとう、ハルカ"
    },
    {
      "Id": 200250350,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 200250360,
      "Speaker": "Student",
      "Text": "はい"
    },
    {
      "Id": 200250370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "すみません"
    },
    {
      "Id": 200250380,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200250390,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 200250400,
      "Speaker": "Student",
      "Text": "先ほど申し上げた通り、色々といただいてしまったので"
    },
    {
      "Id": 200250410,
      "Speaker": "Student",
      "Text": "来世"
    },
    {
      "Id": 200250420,
      "Speaker": "Student",
      "Text": "でも"
    },
    {
      "Id": 200250430,
      "Speaker": "Student",
      "Text": "どうぞよろしくお願いします"
    },
    {
      "Id": 200250440,
      "Speaker": "Student",
      "Text": "ありがとうございます"
    },
    {
      "Id": 200250450,
      "Speaker": "Player",
      "Text": "私もよろしくね"
    },
    {
      "Id": 200250460,
      "Speaker": "Player",
      "Text": "寒いから体調に気をつけて"
    },
    {
      "Id": 200250470,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 200250480,
      "Speaker": "Student",
      "Text": "はい！！"
    }
  ],
  "DialogKR": [
    {
      "Id": 200250010,
      "Speaker": "Student",
      "Text": "안녕하십니까? (본인 이름 기입)입니다."
    },
    {
      "Id": 200250020,
      "Speaker": "Student",
      "Text": "새해가 밝았습니다. (받으실 분 귀하)께서도 지난 한 해가 그러했듯,"
    },
    {
      "Id": 200250030,
      "Speaker": "Student",
      "Text": "새로 시작될 한 해 또한 복과 운이 가득하시길 진심으로 기원합니다."
    },
    {
      "Id": 200250040,
      "Speaker": "Student",
      "Text": "감사를 담아, (본인 이름 기입) 드림."
    },
    {
      "Id": 200250050,
      "Speaker": "Player",
      "Text": "……?"
    },
    {
      "Id": 200250060,
      "Speaker": "Player",
      "Text": "아. 응. 고마워, 하루카!"
    },
    {
      "Id": 200250070,
      "Speaker": "Player",
      "Text": "좋은 템플릿이구나. 고마워!"
    },
    {
      "Id": 200250080,
      "Speaker": "Student",
      "Text": "네ㅂ"
    },
    {
      "Id": 200250090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "넵!!"
    },
    {
      "Id": 200250100,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200250110,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 200250120,
      "Speaker": "Student",
      "Text": "그러니까"
    },
    {
      "Id": 200250130,
      "Speaker": "Student",
      "Text": "찾으셨다고 해서"
    },
    {
      "Id": 200250140,
      "Speaker": "Player",
      "Text": "아, 하루카. 응."
    },
    {
      "Id": 200250150,
      "Speaker": "Player",
      "Text": "혹시 지금 시간 괜찮아?"
    },
    {
      "Id": 200250160,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 200250170,
      "Speaker": "Student",
      "Text": "아네지금바로가겠습니다"
    },
    {
      "Id": 200250180,
      "Speaker": "Student",
      "Text": "제가찾아갈테니선생님은잊고계셔주세요"
    },
    {
      "Id": 200250190,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "불러주셔서감사합니다"
    },
    {
      "Id": 200250200,
      "Speaker": "Student",
      "Text": "감사합니다선생님 덕분에잘돌아왔습니다"
    },
    {
      "Id": 200250210,
      "Speaker": "Player",
      "Text": "응. 잘했어."
    },
    {
      "Id": 200250220,
      "Speaker": "Student",
      "Text": "주신핫팩은 가보로삼기위해 방부처리하여 금고에담았습니다 제목숨을걸고지키겠습니다"
    },
    {
      "Id": 200250230,
      "Speaker": "Player",
      "Text": "응"
    },
    {
      "Id": 200250240,
      "Speaker": "Player",
      "Text": "응?"
    },
    {
      "Id": 200250250,
      "Speaker": "Student",
      "Text": "바람이 정말 차갑습니다. 감기에 걸리지 않도록 따듯함을 유지하시기 바랍니다."
    },
    {
      "Id": 200250260,
      "Speaker": "Student",
      "Text": "어"
    },
    {
      "Id": 200250270,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 200250280,
      "Speaker": "Student",
      "Text": "뭔가시키는말투가돼버렸는데"
    },
    {
      "Id": 200250290,
      "Speaker": "Student",
      "Text": "이게 제가 쓴 게 아니고"
    },
    {
      "Id": 200250300,
      "Speaker": "Student",
      "Text": "아니 제가 쓴 게 아닌 건 아니고"
    },
    {
      "Id": 200250310,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 200250320,
      "Speaker": "Student",
      "Text": "죄송합니다죄송합니다죄송합니다죄송합니다"
    },
    {
      "Id": 200250330,
      "Speaker": "Player",
      "Text": "괜찮아. 뭔지 이해했어."
    },
    {
      "Id": 200250340,
      "Speaker": "Player",
      "Text": "고마워, 하루카."
    },
    {
      "Id": 200250350,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 200250360,
      "Speaker": "Student",
      "Text": "네"
    },
    {
      "Id": 200250370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "죄송합니다"
    },
    {
      "Id": 200250380,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 200250390,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 200250400,
      "Speaker": "Student",
      "Text": "아까 말씀드린 대로, 이런 대접을 받아버렸으니"
    },
    {
      "Id": 200250410,
      "Speaker": "Student",
      "Text": "다음 생"
    },
    {
      "Id": 200250420,
      "Speaker": "Student",
      "Text": "도"
    },
    {
      "Id": 200250430,
      "Speaker": "Student",
      "Text": "잘부탁드립니다"
    },
    {
      "Id": 200250440,
      "Speaker": "Student",
      "Text": "감사합니다"
    },
    {
      "Id": 200250450,
      "Speaker": "Player",
      "Text": "나도 잘 부탁해"
    },
    {
      "Id": 200250460,
      "Speaker": "Player",
      "Text": "날도 추우니 몸조심하고"
    },
    {
      "Id": 200250470,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 200250480,
      "Speaker": "Student",
      "Text": "넵!!"
    }
  ],
  "DialogEN": [
    {
      "Id": 200250010,
      "Speaker": "Student",
      "Text": "New Year's greetings from (Your Name Here)!"
    },
    {
      "Id": 200250020,
      "Speaker": "Student",
      "Text": "Best wishes for the upcoming year."
    },
    {
      "Id": 200250030,
      "Speaker": "Student",
      "Text": "I sincerely hope that you find it full of luck and good fortune, (Recipient's Name)."
    },
    {
      "Id": 200250040,
      "Speaker": "Student",
      "Text": "Warm Regards, (Your Name Here)."
    },
    {
      "Id": 200250050,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 200250060,
      "Speaker": "Player",
      "Text": "Ah. Yep. Thanks, Haruka!"
    },
    {
      "Id": 200250070,
      "Speaker": "Player",
      "Text": "It's a good template. Thank you!"
    },
    {
      "Id": 200250080,
      "Speaker": "Student",
      "Text": "Yes."
    },
    {
      "Id": 200250090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Yes!"
    },
    {
      "Id": 200250100,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 200250110,
      "Speaker": "Student",
      "Text": "So..."
    },
    {
      "Id": 200250120,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 200250130,
      "Speaker": "Student",
      "Text": "You were looking...for me?"
    },
    {
      "Id": 200250140,
      "Speaker": "Player",
      "Text": "Oh, Haruka! Yes."
    },
    {
      "Id": 200250150,
      "Speaker": "Player",
      "Text": "Is now a good time to meet?"
    },
    {
      "Id": 200250160,
      "Speaker": "Student",
      "Text": "Huh?"
    },
    {
      "Id": 200250170,
      "Speaker": "Student",
      "Text": "Oh, I'll be right over!"
    },
    {
      "Id": 200250180,
      "Speaker": "Student",
      "Text": "Don't worry! I'll come to you!"
    },
    {
      "Id": 200250190,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Thank you very much for contacting me!"
    },
    {
      "Id": 200250200,
      "Speaker": "Student",
      "Text": "Thank you, Sensei. I got back safely, thanks to you."
    },
    {
      "Id": 200250210,
      "Speaker": "Player",
      "Text": "Glad to hear it."
    },
    {
      "Id": 200250220,
      "Speaker": "Student",
      "Text": "Also I saved the hot pack you gave me and I put it into a vault to keep as an heirloom and I promise to protect it with my life."
    },
    {
      "Id": 200250230,
      "Speaker": "Player",
      "Text": "Uh huh."
    },
    {
      "Id": 200250240,
      "Speaker": "Player",
      "Text": "Huh?"
    },
    {
      "Id": 200250250,
      "Speaker": "Student",
      "Text": "The winds are quite cold. Please stay warm so that you don't catch a cold."
    },
    {
      "Id": 200250260,
      "Speaker": "Student",
      "Text": "Uh."
    },
    {
      "Id": 200250270,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 200250280,
      "Speaker": "Student",
      "Text": "Just now...that sounded kind of demanding..."
    },
    {
      "Id": 200250290,
      "Speaker": "Student",
      "Text": "And... Actually, I didn't write it..."
    },
    {
      "Id": 200250300,
      "Speaker": "Student",
      "Text": "That actually wasn't me..."
    },
    {
      "Id": 200250310,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 200250320,
      "Speaker": "Student",
      "Text": "I'msorryI'msorryI'msorryI'msorry"
    },
    {
      "Id": 200250330,
      "Speaker": "Player",
      "Text": "It's no problem. I understood."
    },
    {
      "Id": 200250340,
      "Speaker": "Player",
      "Text": "Thank you, Haruka."
    },
    {
      "Id": 200250350,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 200250360,
      "Speaker": "Student",
      "Text": "Okay."
    },
    {
      "Id": 200250370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Sorry..."
    },
    {
      "Id": 200250380,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 200250390,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 200250400,
      "Speaker": "Student",
      "Text": "I already said this, but... Since you've given me so much..."
    },
    {
      "Id": 200250410,
      "Speaker": "Student",
      "Text": "Please... I hope..."
    },
    {
      "Id": 200250420,
      "Speaker": "Student",
      "Text": "You'll take care of me..."
    },
    {
      "Id": 200250430,
      "Speaker": "Student",
      "Text": "In my next life, also."
    },
    {
      "Id": 200250440,
      "Speaker": "Student",
      "Text": "Thank you."
    },
    {
      "Id": 200250450,
      "Speaker": "Player",
      "Text": "Please keep taking care of me, too."
    },
    {
      "Id": 200250460,
      "Speaker": "Player",
      "Text": "Stay warm. It's freezing out there."
    },
    {
      "Id": 200250470,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 200250480,
      "Speaker": "Student",
      "Text": "Yes!"
    }
  ],
  "DialogTH": [
    {
      "Id": 200250010,
      "Speaker": "Student",
      "Text": "สวัสดีค่ะ (ใส่ชื่อตัวเอง) เองค่ะ"
    },
    {
      "Id": 200250020,
      "Speaker": "Student",
      "Text": "ในวารดิถีขึ้นปีใหม่ ปีที่แล้ว (ชื่อผู้รับ)\nมีโชคลาภฉันใด"
    },
    {
      "Id": 200250030,
      "Speaker": "Student",
      "Text": "ก็ขอให้ปีนี้มั่งมีโชคลาภฉันนั้น"
    },
    {
      "Id": 200250040,
      "Speaker": "Student",
      "Text": "ขอขอบคุณมา ณ โอกาสนี้\n(ใส่ชื่อตัวเอง) ด้วยความนับถือ"
    },
    {
      "Id": 200250050,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 200250060,
      "Speaker": "Player",
      "Text": "อ๋อ อื้ม ขอบใจนะ ฮารุกะ!"
    },
    {
      "Id": 200250070,
      "Speaker": "Player",
      "Text": "เทมเพลตดีงามมาก ขอบใจนะ!"
    },
    {
      "Id": 200250080,
      "Speaker": "Student",
      "Text": "ค่ะ"
    },
    {
      "Id": 200250090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ค่ะ!!"
    },
    {
      "Id": 200250100,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 200250110,
      "Speaker": "Student",
      "Text": "เอ่อ..."
    },
    {
      "Id": 200250120,
      "Speaker": "Student",
      "Text": "คือว่า..."
    },
    {
      "Id": 200250130,
      "Speaker": "Student",
      "Text": "ได้ยินว่าคุณครูกำลังหาฉันอยู่..."
    },
    {
      "Id": 200250140,
      "Speaker": "Player",
      "Text": "อ๋อ ฮารุกะ ใช่แล้ว"
    },
    {
      "Id": 200250150,
      "Speaker": "Player",
      "Text": "ตอนนี้ฮารุกะว่างรึเปล่า?"
    },
    {
      "Id": 200250160,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 200250170,
      "Speaker": "Student",
      "Text": "ค่ะ จะไปเดี๋ยวนี้เลยค่ะ"
    },
    {
      "Id": 200250180,
      "Speaker": "Student",
      "Text": "ไม่ต้องกังวลนะคะ ฉันจะรีบไปหา\nคุณครูเดี๋ยวนี้เลยค่ะ"
    },
    {
      "Id": 200250190,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ขอบคุณที่เรียกฉันไปพบนะคะ!"
    },
    {
      "Id": 200250200,
      "Speaker": "Student",
      "Text": "ขอบคุณค่ะ ฉันกลับมาได้อย่าง\nปลอดภัยเพราะคุณครูเลยค่ะ"
    },
    {
      "Id": 200250210,
      "Speaker": "Player",
      "Text": "อื้ม เก่งมาก"
    },
    {
      "Id": 200250220,
      "Speaker": "Student",
      "Text": "ฮอตแพ็กที่ครูให้มา ฉันจะใส่ยากันบูด\nแล้วเก็บใส่ตู้เซฟไว้เป็นสมบัติของตระกูลค่ะ\nสัญญาว่าจะรักษามันด้วยชีวิตเลยค่ะ"
    },
    {
      "Id": 200250230,
      "Speaker": "Player",
      "Text": "อื้ม"
    },
    {
      "Id": 200250240,
      "Speaker": "Player",
      "Text": "หืม?"
    },
    {
      "Id": 200250250,
      "Speaker": "Student",
      "Text": "ลมเย็นมากจริงๆ ค่ะ โปรดรักษาความ\nอบอุ่นเพื่อไม่ให้เป็นหวัดด้วยนะคะ"
    },
    {
      "Id": 200250260,
      "Speaker": "Student",
      "Text": "เอ่อ..."
    },
    {
      "Id": 200250270,
      "Speaker": "Student",
      "Text": "ไม่ใช่สิ..."
    },
    {
      "Id": 200250280,
      "Speaker": "Student",
      "Text": "เมื่อกี้มันเหมือนออกคำสั่งเลย..."
    },
    {
      "Id": 200250290,
      "Speaker": "Student",
      "Text": "เอ่อ... อันที่จริงฉันไม่ได้เป็นคนเขียนค่ะ..."
    },
    {
      "Id": 200250300,
      "Speaker": "Student",
      "Text": "ไม่สิ ไม่ใช่ว่าฉันไม่ได้เป็นคนเขียน"
    },
    {
      "Id": 200250310,
      "Speaker": "Student",
      "Text": "อืม..."
    },
    {
      "Id": 200250320,
      "Speaker": "Student",
      "Text": "ขอโทษค่ะขอโทษค่ะขอโทษค่ะ..."
    },
    {
      "Id": 200250330,
      "Speaker": "Player",
      "Text": "ไม่เป็นไรหรอก\nครูเข้าใจที่ฮารุกะจะบอกนะ"
    },
    {
      "Id": 200250340,
      "Speaker": "Player",
      "Text": "ขอบคุณนะ ฮารุกะ"
    },
    {
      "Id": 200250350,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 200250360,
      "Speaker": "Student",
      "Text": "ค่ะ"
    },
    {
      "Id": 200250370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ขอโทษนะคะ..."
    },
    {
      "Id": 200250380,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 200250390,
      "Speaker": "Student",
      "Text": "เอ่อ..."
    },
    {
      "Id": 200250400,
      "Speaker": "Student",
      "Text": "อย่างที่ฉันบอกไปเมื่อกี้ คุณครูคอย\nดูแลฉันอย่างดีมาโดยตลอด..."
    },
    {
      "Id": 200250410,
      "Speaker": "Student",
      "Text": "ถ้าอย่างนั้น... ชาติหน้า..."
    },
    {
      "Id": 200250420,
      "Speaker": "Student",
      "Text": "ก็ขอ..."
    },
    {
      "Id": 200250430,
      "Speaker": "Student",
      "Text": "ขอฝากเนื้อฝากตัวด้วยนะคะ"
    },
    {
      "Id": 200250440,
      "Speaker": "Student",
      "Text": "ขอบคุณค่ะ"
    },
    {
      "Id": 200250450,
      "Speaker": "Player",
      "Text": "ครูก็ขอฝากตัวด้วยนะ"
    },
    {
      "Id": 200250460,
      "Speaker": "Player",
      "Text": "อากาศหนาว ดูแลตัวเองดีๆ ด้วยนะ"
    },
    {
      "Id": 200250470,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 200250480,
      "Speaker": "Student",
      "Text": "ค่ะ!!"
    }
  ],
