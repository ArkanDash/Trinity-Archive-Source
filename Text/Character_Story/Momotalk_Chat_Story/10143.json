{
  "CharacterId": 10143,
  "DialogJP": [
    {
      "Id": 101430010,
      "Speaker": "Student",
      "Text": "先生、渓谷での余暇はいかがですか？"
    },
    {
      "Id": 101430020,
      "Speaker": "Player",
      "Text": "大自然、サイコー……"
    },
    {
      "Id": 101430030,
      "Speaker": "Student",
      "Text": "ふふ。お楽しみいただいているようで何よりです"
    },
    {
      "Id": 101430040,
      "Speaker": "Student",
      "Text": "ところで先生"
    },
    {
      "Id": 101430050,
      "Speaker": "Student",
      "Text": "今日は私もそちらでご一緒したいのですが"
    },
    {
      "Id": 101430060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "よろしいでしょうか？"
    },
    {
      "Id": 101430070,
      "Speaker": "Student",
      "Text": "私、夏って好きなんです"
    },
    {
      "Id": 101430080,
      "Speaker": "Player",
      "Text": "どこが好きなの？"
    },
    {
      "Id": 101430090,
      "Speaker": "Student",
      "Text": "理由はいくつかありますが……"
    },
    {
      "Id": 101430100,
      "Speaker": "Student",
      "Text": "自分の、いつもとは違った一面を"
    },
    {
      "Id": 101430110,
      "Speaker": "Student",
      "Text": "表現できる……からでしょうか？"
    },
    {
      "Id": 101430120,
      "Speaker": "Student",
      "Text": "ふふ、ですので"
    },
    {
      "Id": 101430130,
      "Speaker": "Student",
      "Text": "私のいつもとは違った一面をお見せしたいのですが"
    },
    {
      "Id": 101430140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "お時間をいただいてもよろしいでしょうか？"
    },
    {
      "Id": 101430150,
      "Speaker": "Student",
      "Text": "昨日はご迷惑をおかけしました……"
    },
    {
      "Id": 101430160,
      "Speaker": "Student",
      "Text": "本当に、色々と……"
    },
    {
      "Id": 101430170,
      "Speaker": "Player",
      "Text": "やっとシュンが声をかけてくれた……"
    },
    {
      "Id": 101430180,
      "Speaker": "Student",
      "Text": "え？"
    },
    {
      "Id": 101430190,
      "Speaker": "Student",
      "Text": "言われてみれば、そうですね……"
    },
    {
      "Id": 101430200,
      "Speaker": "Student",
      "Text": "あのとき……"
    },
    {
      "Id": 101430210,
      "Speaker": "Player",
      "Text": "何も見てない！何も覚えていないよ！"
    },
    {
      "Id": 101430220,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101430230,
      "Speaker": "Student",
      "Text": "それはちょっと"
    },
    {
      "Id": 101430240,
      "Speaker": "Student",
      "Text": "寂しいかもしれません……"
    },
    {
      "Id": 101430250,
      "Speaker": "Player",
      "Text": "私は……どうしたらいいのかな……"
    },
    {
      "Id": 101430260,
      "Speaker": "Student",
      "Text": "そう、ですね"
    },
    {
      "Id": 101430270,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101430280,
      "Speaker": "Student",
      "Text": "もしよろしければ"
    },
    {
      "Id": 101430290,
      "Speaker": "Student",
      "Text": "先生と一緒にリベンジをしたいのですが……"
    },
    {
      "Id": 101430300,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "お時間があれば今からでも……よろしいでしょうか？"
    },
    {
      "Id": 101430310,
      "Speaker": "Student",
      "Text": "先生にお願いしたいことがあるのですが……"
    },
    {
      "Id": 101430320,
      "Speaker": "Student",
      "Text": "よろしければ……"
    },
    {
      "Id": 101430330,
      "Speaker": "Student",
      "Text": "聞いていただけますでしょうか？"
    },
    {
      "Id": 101430340,
      "Speaker": "Player",
      "Text": "何でもどうぞ！"
    },
    {
      "Id": 101430350,
      "Speaker": "Student",
      "Text": "今日、梅花園の子供たちと"
    },
    {
      "Id": 101430360,
      "Speaker": "Student",
      "Text": "ウォーターパークに行くことになりまして……"
    },
    {
      "Id": 101430370,
      "Speaker": "Student",
      "Text": "一緒に引率していただけませんでしょうか？"
    },
    {
      "Id": 101430380,
      "Speaker": "Player",
      "Text": "任せて！"
    },
    {
      "Id": 101430390,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 101430400,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ありがとうございます。先生"
    },
    {
      "Id": 101430410,
      "Speaker": "Student",
      "Text": "無事にお帰りになられましたか、先生？"
    },
    {
      "Id": 101430420,
      "Speaker": "Player",
      "Text": "う、うん……ただ筋肉痛が……。"
    },
    {
      "Id": 101430430,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 101430440,
      "Speaker": "Student",
      "Text": "水遊びは、思いのほか体力を使いますからね"
    },
    {
      "Id": 101430450,
      "Speaker": "Student",
      "Text": "今日は、本当にありがとうございました"
    },
    {
      "Id": 101430460,
      "Speaker": "Student",
      "Text": "先生さえよろしければ、ですが……"
    },
    {
      "Id": 101430470,
      "Speaker": "Student",
      "Text": "また、このような時間が欲しいです"
    },
    {
      "Id": 101430480,
      "Speaker": "Player",
      "Text": "いつでも呼んでね"
    },
    {
      "Id": 101430490,
      "Speaker": "Student",
      "Text": "ふふ。ありがとうございます"
    },
    {
      "Id": 101430500,
      "Speaker": "Student",
      "Text": "そう言ってくださると思っていました"
    },
    {
      "Id": 101430510,
      "Speaker": "Student",
      "Text": "でしたら、次は……"
    },
    {
      "Id": 101430520,
      "Speaker": "Student",
      "Text": "二人きりで過ごす機会を設けますね"
    }
  ],
  "DialogKR": [
    {
      "Id": 101430010,
      "Speaker": "Student",
      "Text": "계곡은 어떠세요, 선생님?"
    },
    {
      "Id": 101430020,
      "Speaker": "Player",
      "Text": "자연이란 좋구나……."
    },
    {
      "Id": 101430030,
      "Speaker": "Student",
      "Text": "다행이에요."
    },
    {
      "Id": 101430040,
      "Speaker": "Student",
      "Text": "그런데 말이에요."
    },
    {
      "Id": 101430050,
      "Speaker": "Student",
      "Text": "오늘은 선생님과 함께 계곡을 보고 싶은데"
    },
    {
      "Id": 101430060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "괜찮으실까요?"
    },
    {
      "Id": 101430070,
      "Speaker": "Student",
      "Text": "여름이라는 계절은 신기하죠."
    },
    {
      "Id": 101430080,
      "Speaker": "Player",
      "Text": "어떤 의미에서?"
    },
    {
      "Id": 101430090,
      "Speaker": "Student",
      "Text": "이유도 의미도 여러 가지 있겠지만"
    },
    {
      "Id": 101430100,
      "Speaker": "Student",
      "Text": "역시 새로운 모습으로"
    },
    {
      "Id": 101430110,
      "Speaker": "Student",
      "Text": "누군가에게 다가갈 수 있다는 점이 아닐까요?"
    },
    {
      "Id": 101430120,
      "Speaker": "Student",
      "Text": "말씀드린 김에"
    },
    {
      "Id": 101430130,
      "Speaker": "Student",
      "Text": "새로운 모습을 선생님께 조금 보여드리고 싶은데"
    },
    {
      "Id": 101430140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "괜찮으실까요?"
    },
    {
      "Id": 101430150,
      "Speaker": "Student",
      "Text": "어제는"
    },
    {
      "Id": 101430160,
      "Speaker": "Student",
      "Text": "여러모로, 죄송했습니다."
    },
    {
      "Id": 101430170,
      "Speaker": "Player",
      "Text": "드디어 오늘 처음 슌이 말을 걸어 줬어……"
    },
    {
      "Id": 101430180,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 101430190,
      "Speaker": "Student",
      "Text": "생각해 보니, 그렇네요……"
    },
    {
      "Id": 101430200,
      "Speaker": "Student",
      "Text": "하지만, 저도……"
    },
    {
      "Id": 101430210,
      "Speaker": "Player",
      "Text": "아니야! 역시 아무것도 못 봤어! 잊었어!"
    },
    {
      "Id": 101430220,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101430230,
      "Speaker": "Student",
      "Text": "그건 조금"
    },
    {
      "Id": 101430240,
      "Speaker": "Student",
      "Text": "서운할지도, 모르겠는데요……?"
    },
    {
      "Id": 101430250,
      "Speaker": "Player",
      "Text": "나는…… 어떻게 해야 하는 걸까……."
    },
    {
      "Id": 101430260,
      "Speaker": "Student",
      "Text": "그러, 게요?"
    },
    {
      "Id": 101430270,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101430280,
      "Speaker": "Student",
      "Text": "선생님께서"
    },
    {
      "Id": 101430290,
      "Speaker": "Student",
      "Text": "리벤지에 참여해 주신다면……"
    },
    {
      "Id": 101430300,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "조금, 괜찮을…… 지도요?"
    },
    {
      "Id": 101430310,
      "Speaker": "Student",
      "Text": "안녕하세요. 선생님."
    },
    {
      "Id": 101430320,
      "Speaker": "Student",
      "Text": "정말, 송구스럽지만……"
    },
    {
      "Id": 101430330,
      "Speaker": "Student",
      "Text": "한가지, 의사를 여쭈어보아도 괜찮으실까요……?"
    },
    {
      "Id": 101430340,
      "Speaker": "Player",
      "Text": "얼마든지!"
    },
    {
      "Id": 101430350,
      "Speaker": "Student",
      "Text": "오늘, 매화원 아이들과 워터 파크에 방문하기로 했는데요."
    },
    {
      "Id": 101430360,
      "Speaker": "Student",
      "Text": "혹시 괜찮으시다면"
    },
    {
      "Id": 101430370,
      "Speaker": "Student",
      "Text": "저와 함께…… 아이들을 인솔해 주실 수 있을까, 해서요."
    },
    {
      "Id": 101430380,
      "Speaker": "Player",
      "Text": "문제 없어!"
    },
    {
      "Id": 101430390,
      "Speaker": "Student",
      "Text": "후후."
    },
    {
      "Id": 101430400,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "감사합니다. 선생님."
    },
    {
      "Id": 101430410,
      "Speaker": "Student",
      "Text": "잘 들어가셨나요, 선생님?"
    },
    {
      "Id": 101430420,
      "Speaker": "Player",
      "Text": "으어어…… 근육통과 피로가……"
    },
    {
      "Id": 101430430,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 101430440,
      "Speaker": "Student",
      "Text": "물놀이는, 체력을 상당히 소모하니까요."
    },
    {
      "Id": 101430450,
      "Speaker": "Student",
      "Text": "오늘 정말 감사했습니다."
    },
    {
      "Id": 101430460,
      "Speaker": "Student",
      "Text": "선생님만 괜찮으시다면, 이지만……"
    },
    {
      "Id": 101430470,
      "Speaker": "Student",
      "Text": "다음에도, 이런 시간이 또 있었으면 하네요."
    },
    {
      "Id": 101430480,
      "Speaker": "Player",
      "Text": "언제든지 불러 줘."
    },
    {
      "Id": 101430490,
      "Speaker": "Student",
      "Text": "후후. 그렇게 말씀하실 것 같았지만."
    },
    {
      "Id": 101430500,
      "Speaker": "Student",
      "Text": "역시 감사합니다."
    },
    {
      "Id": 101430510,
      "Speaker": "Student",
      "Text": "그러면 다음에는……"
    },
    {
      "Id": 101430520,
      "Speaker": "Student",
      "Text": "저희 둘만의 시간으로, 한번 자리를 만들어 볼게요."
    }
  ],
