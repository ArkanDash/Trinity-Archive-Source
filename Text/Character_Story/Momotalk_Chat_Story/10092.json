{
  "CharacterId": 10092,
  "DialogJP": [
    {
      "Id": 100920010,
      "Speaker": "Student",
      "Text": "そういえば先生"
    },
    {
      "Id": 100920020,
      "Speaker": "Student",
      "Text": "私、ビジュアル担当になったわけだけど"
    },
    {
      "Id": 100920030,
      "Speaker": "Student",
      "Text": "ビジュアルって、服とかも入ってくるわよね？"
    },
    {
      "Id": 100920040,
      "Speaker": "Student",
      "Text": "ってことは、服も私が選んで良いのよね？"
    },
    {
      "Id": 100920050,
      "Speaker": "Player",
      "Text": "そうだね"
    },
    {
      "Id": 100920060,
      "Speaker": "Player",
      "Text": "何か気になることが？"
    },
    {
      "Id": 100920070,
      "Speaker": "Student",
      "Text": "ん－と"
    },
    {
      "Id": 100920080,
      "Speaker": "Student",
      "Text": "一人で決めるのは気が重いって言うか"
    },
    {
      "Id": 100920090,
      "Speaker": "Student",
      "Text": "そもそもこれ、先生のせいだし"
    },
    {
      "Id": 100920100,
      "Speaker": "Student",
      "Text": "付き合ってもらおうかなって"
    },
    {
      "Id": 100920110,
      "Speaker": "Player",
      "Text": "つまり、デート……！？"
    },
    {
      "Id": 100920120,
      "Speaker": "Player",
      "Text": "誘ってくれて嬉しいよ"
    },
    {
      "Id": 100920130,
      "Speaker": "Student",
      "Text": "？"
    },
    {
      "Id": 100920140,
      "Speaker": "Student",
      "Text": "は"
    },
    {
      "Id": 100920150,
      "Speaker": "Student",
      "Text": "― ―；；；"
    },
    {
      "Id": 100920160,
      "Speaker": "Student",
      "Text": "ふざけないで"
    },
    {
      "Id": 100920170,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "場所は送るから、また後でね"
    },
    {
      "Id": 100920180,
      "Speaker": "Student",
      "Text": "何というかその……"
    },
    {
      "Id": 100920190,
      "Speaker": "Student",
      "Text": "ありがとう"
    },
    {
      "Id": 100920200,
      "Speaker": "Student",
      "Text": "すごく助かった"
    },
    {
      "Id": 100920210,
      "Speaker": "Student",
      "Text": "こんなつもりじゃなかったんだけど"
    },
    {
      "Id": 100920220,
      "Speaker": "Player",
      "Text": "気にしないで、好きでやってることだから"
    },
    {
      "Id": 100920230,
      "Speaker": "Player",
      "Text": "服選びを見せてもらったお礼だよ"
    },
    {
      "Id": 100920240,
      "Speaker": "Student",
      "Text": "そ、そう……"
    },
    {
      "Id": 100920250,
      "Speaker": "Student",
      "Text": "いきなりそんな真面目な回答されても困るんだけど……"
    },
    {
      "Id": 100920260,
      "Speaker": "Student",
      "Text": "まあ良いわ"
    },
    {
      "Id": 100920270,
      "Speaker": "Student",
      "Text": "助かったのは事実だし"
    },
    {
      "Id": 100920280,
      "Speaker": "Student",
      "Text": "ありがと、先生。お礼は今度ね！"
    },
    {
      "Id": 100920290,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 100920300,
      "Speaker": "Student",
      "Text": "分かんなくなってきた"
    },
    {
      "Id": 100920310,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 100920320,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100920330,
      "Speaker": "Student",
      "Text": "あ、いや"
    },
    {
      "Id": 100920340,
      "Speaker": "Student",
      "Text": "ちょっと描いてみたんだけど"
    },
    {
      "Id": 100920350,
      "Speaker": "Player",
      "Text": "描くってことは……"
    },
    {
      "Id": 100920360,
      "Speaker": "Player",
      "Text": "ロゴデザイン？"
    },
    {
      "Id": 100920370,
      "Speaker": "Student",
      "Text": "うん、そう"
    },
    {
      "Id": 100920380,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ちょっと見てもらえる？"
    },
    {
      "Id": 100920390,
      "Speaker": "Student",
      "Text": "本当何なの"
    },
    {
      "Id": 100920400,
      "Speaker": "Student",
      "Text": "どうしてあんなことするの？"
    },
    {
      "Id": 100920410,
      "Speaker": "Student",
      "Text": "やめてほしいんだけど"
    },
    {
      "Id": 100920420,
      "Speaker": "Student",
      "Text": "これからはホントにやめてよね"
    },
    {
      "Id": 100920430,
      "Speaker": "Player",
      "Text": "ごめんね"
    },
    {
      "Id": 100920440,
      "Speaker": "Player",
      "Text": "次からは気をつけるね"
    },
    {
      "Id": 100920450,
      "Speaker": "Student",
      "Text": "あー……"
    },
    {
      "Id": 100920460,
      "Speaker": "Student",
      "Text": "まったく"
    },
    {
      "Id": 100920470,
      "Speaker": "Student",
      "Text": "ほんっとむかつく"
    },
    {
      "Id": 100920480,
      "Speaker": "Student",
      "Text": "……今回は良いけど"
    },
    {
      "Id": 100920490,
      "Speaker": "Student",
      "Text": "もう次は無いからね"
    },
    {
      "Id": 100920500,
      "Speaker": "Student",
      "Text": "先生ちょっと"
    },
    {
      "Id": 100920510,
      "Speaker": "Student",
      "Text": "相談があるんだけど"
    },
    {
      "Id": 100920520,
      "Speaker": "Student",
      "Text": "時間大丈夫？"
    },
    {
      "Id": 100920530,
      "Speaker": "Player",
      "Text": "相談？"
    },
    {
      "Id": 100920540,
      "Speaker": "Player",
      "Text": "何だか真面目な話みたいだね？"
    },
    {
      "Id": 100920550,
      "Speaker": "Student",
      "Text": "あー……"
    },
    {
      "Id": 100920560,
      "Speaker": "Student",
      "Text": "まあ、そんな感じ"
    },
    {
      "Id": 100920570,
      "Speaker": "Student",
      "Text": "だから、来てほしいの"
    },
    {
      "Id": 100920580,
      "Speaker": "Student",
      "Text": "場所はまた送るから"
    },
    {
      "Id": 100920590,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "絶対来てよね"
    },
    {
      "Id": 100920600,
      "Speaker": "Student",
      "Text": "あー……"
    },
    {
      "Id": 100920610,
      "Speaker": "Student",
      "Text": "なんか放心状態"
    },
    {
      "Id": 100920620,
      "Speaker": "Student",
      "Text": "結局全部演奏しちゃったし"
    },
    {
      "Id": 100920630,
      "Speaker": "Player",
      "Text": "お世辞じゃなく凄かったよ"
    },
    {
      "Id": 100920640,
      "Speaker": "Player",
      "Text": "すごかった、また聴かせてね"
    },
    {
      "Id": 100920650,
      "Speaker": "Student",
      "Text": "……なによ"
    },
    {
      "Id": 100920660,
      "Speaker": "Student",
      "Text": "素直にもなれるじゃないの"
    },
    {
      "Id": 100920670,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100920680,
      "Speaker": "Student",
      "Text": "ありがとう"
    },
    {
      "Id": 100920690,
      "Speaker": "Student",
      "Text": "ちゃんと聴いてくれて"
    },
    {
      "Id": 100920700,
      "Speaker": "Player",
      "Text": "最初の曲が特に良かったな"
    },
    {
      "Id": 100920710,
      "Speaker": "Player",
      "Text": "どうやって検索したら良い？"
    },
    {
      "Id": 100920720,
      "Speaker": "Student",
      "Text": "は？やめなさいって！"
    },
    {
      "Id": 100920730,
      "Speaker": "Student",
      "Text": "― ―；"
    },
    {
      "Id": 100920740,
      "Speaker": "Student",
      "Text": "ほんっとムカつく"
    },
    {
      "Id": 100920750,
      "Speaker": "Student",
      "Text": "これだから先生は……"
    }
  ],
  "DialogKR": [
    {
      "Id": 100920010,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100920020,
      "Speaker": "Student",
      "Text": "그러고 보니 우리 밴드 복장을 구해야 하는데"
    },
    {
      "Id": 100920030,
      "Speaker": "Student",
      "Text": "옷이라든가 디자인은 전부 내 담당이잖아"
    },
    {
      "Id": 100920040,
      "Speaker": "Student",
      "Text": "그럼 복장도 내가 골라서 주면 되는 거겠지?"
    },
    {
      "Id": 100920050,
      "Speaker": "Player",
      "Text": "역시 그렇겠지?"
    },
    {
      "Id": 100920060,
      "Speaker": "Player",
      "Text": "걱정되는 거라도 있어?"
    },
    {
      "Id": 100920070,
      "Speaker": "Student",
      "Text": "흠"
    },
    {
      "Id": 100920080,
      "Speaker": "Student",
      "Text": "역시 혼자 가기는 좀 부담스러운데"
    },
    {
      "Id": 100920090,
      "Speaker": "Student",
      "Text": "이거 어차피 나한테 시킨 것도 선생님이니까"
    },
    {
      "Id": 100920100,
      "Speaker": "Student",
      "Text": "동행해 주셔야겠어"
    },
    {
      "Id": 100920110,
      "Speaker": "Player",
      "Text": "갑자기 데이트 신청?"
    },
    {
      "Id": 100920120,
      "Speaker": "Player",
      "Text": "흠. 그 정도면 자연스러웠어"
    },
    {
      "Id": 100920130,
      "Speaker": "Student",
      "Text": "?"
    },
    {
      "Id": 100920140,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100920150,
      "Speaker": "Student",
      "Text": "ㅡㅡ;;;"
    },
    {
      "Id": 100920160,
      "Speaker": "Student",
      "Text": "헛소리하지 마 진짜"
    },
    {
      "Id": 100920170,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "아무튼 장소 찍어줄 테니까, 거기서 봐."
    },
    {
      "Id": 100920180,
      "Speaker": "Student",
      "Text": "뭔가"
    },
    {
      "Id": 100920190,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 100920200,
      "Speaker": "Student",
      "Text": "엄청난 빚을 진 느낌인데"
    },
    {
      "Id": 100920210,
      "Speaker": "Student",
      "Text": "이럴 생각은 없었다고;;;"
    },
    {
      "Id": 100920220,
      "Speaker": "Player",
      "Text": "신경 쓰지 마, 좋아서 한 거니까."
    },
    {
      "Id": 100920230,
      "Speaker": "Player",
      "Text": "귀여운 구경했으니, 그 대가라고 생각해"
    },
    {
      "Id": 100920240,
      "Speaker": "Student",
      "Text": ";;;;;;;;"
    },
    {
      "Id": 100920250,
      "Speaker": "Student",
      "Text": "갑자기 그리 젠틀하게 굴어도 곤란하니까"
    },
    {
      "Id": 100920260,
      "Speaker": "Student",
      "Text": "아무튼"
    },
    {
      "Id": 100920270,
      "Speaker": "Student",
      "Text": "고마운 건 고마운 거겠지"
    },
    {
      "Id": 100920280,
      "Speaker": "Student",
      "Text": "고마워, 선생님. 나중에 꼭 뭐라도 갚을게!"
    },
    {
      "Id": 100920290,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100920300,
      "Speaker": "Student",
      "Text": "잘 모르겠네 괜찮은 거 같기도 하고"
    },
    {
      "Id": 100920310,
      "Speaker": "Player",
      "Text": "……?"
    },
    {
      "Id": 100920320,
      "Speaker": "Player",
      "Text": "뭐가?"
    },
    {
      "Id": 100920330,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 100920340,
      "Speaker": "Student",
      "Text": "미리 좀 그려 보고 있는데 잘 안돼서"
    },
    {
      "Id": 100920350,
      "Speaker": "Player",
      "Text": "그리는 중이라고?"
    },
    {
      "Id": 100920360,
      "Speaker": "Player",
      "Text": "밴드 디자인?"
    },
    {
      "Id": 100920370,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100920380,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "와서 좀 봐줄 수 있어?"
    },
    {
      "Id": 100920390,
      "Speaker": "Student",
      "Text": "대체 뭐야"
    },
    {
      "Id": 100920400,
      "Speaker": "Student",
      "Text": "병이라도 있어?"
    },
    {
      "Id": 100920410,
      "Speaker": "Student",
      "Text": "하루를 그냥 넘어가지 못하는 거야?"
    },
    {
      "Id": 100920420,
      "Speaker": "Student",
      "Text": "그냥 넘어가면 죽는 병?"
    },
    {
      "Id": 100920430,
      "Speaker": "Player",
      "Text": "오ㅋㅋ 그거 편리한 변명"
    },
    {
      "Id": 100920440,
      "Speaker": "Player",
      "Text": "그럼 이제부터 그런 걸로 할까~!"
    },
    {
      "Id": 100920450,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100920460,
      "Speaker": "Student",
      "Text": "ㅋㅋㅋㅋ"
    },
    {
      "Id": 100920470,
      "Speaker": "Student",
      "Text": "진짜 완전 열 받는다"
    },
    {
      "Id": 100920480,
      "Speaker": "Student",
      "Text": "ㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋㅋ"
    },
    {
      "Id": 100920490,
      "Speaker": "Student",
      "Text": "죽어 그냥;"
    },
    {
      "Id": 100920500,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100920510,
      "Speaker": "Student",
      "Text": "중요한 일이 있어"
    },
    {
      "Id": 100920520,
      "Speaker": "Student",
      "Text": "시간 괜찮을까?"
    },
    {
      "Id": 100920530,
      "Speaker": "Player",
      "Text": "중요한 일?"
    },
    {
      "Id": 100920540,
      "Speaker": "Player",
      "Text": "뭔가 분위기가 진지한걸"
    },
    {
      "Id": 100920550,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100920560,
      "Speaker": "Student",
      "Text": "음, 뭐 그렇지"
    },
    {
      "Id": 100920570,
      "Speaker": "Student",
      "Text": "그러니 괜찮으면 와줬으면 해"
    },
    {
      "Id": 100920580,
      "Speaker": "Student",
      "Text": "장소는 따로 보내줄 테니까"
    },
    {
      "Id": 100920590,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "꼭이야."
    },
    {
      "Id": 100920600,
      "Speaker": "Student",
      "Text": "후"
    },
    {
      "Id": 100920610,
      "Speaker": "Student",
      "Text": "죽겠다"
    },
    {
      "Id": 100920620,
      "Speaker": "Student",
      "Text": "설마설마했는데 진짜 다했네"
    },
    {
      "Id": 100920630,
      "Speaker": "Player",
      "Text": "빈말 없이 훌륭했어."
    },
    {
      "Id": 100920640,
      "Speaker": "Player",
      "Text": "대단한데, 자주 들려줘."
    },
    {
      "Id": 100920650,
      "Speaker": "Student",
      "Text": "뭐야"
    },
    {
      "Id": 100920660,
      "Speaker": "Student",
      "Text": "순순히 좋은 말도 해줄 수 있잖아, 역시."
    },
    {
      "Id": 100920670,
      "Speaker": "Student",
      "Text": "히히"
    },
    {
      "Id": 100920680,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100920690,
      "Speaker": "Student",
      "Text": "고마워. 진지하게 들어줘서."
    },
    {
      "Id": 100920700,
      "Speaker": "Player",
      "Text": "아 그러고 보니 아까 첫 곡 말인데ㅋㅋ"
    },
    {
      "Id": 100920710,
      "Speaker": "Player",
      "Text": "무슨 음악인지도 찾을 수 있겠더라고ㅋㅋ"
    },
    {
      "Id": 100920720,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100920730,
      "Speaker": "Student",
      "Text": "ㅡㅡ;"
    },
    {
      "Id": 100920740,
      "Speaker": "Student",
      "Text": "진짜 짜증나"
    },
    {
      "Id": 100920750,
      "Speaker": "Student",
      "Text": "완전 싫어"
    }
  ],
  "DialogEN": [
    {
      "Id": 100920010,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 100920020,
      "Speaker": "Student",
      "Text": "I just realized. We need band uniforms."
    },
    {
      "Id": 100920030,
      "Speaker": "Student",
      "Text": "I'm supposed to be our designer..."
    },
    {
      "Id": 100920040,
      "Speaker": "Student",
      "Text": "That means I have to figure out the uniforms, right?"
    },
    {
      "Id": 100920050,
      "Speaker": "Player",
      "Text": "Sounds about right."
    },
    {
      "Id": 100920060,
      "Speaker": "Player",
      "Text": "Are you worried about something?"
    },
    {
      "Id": 100920070,
      "Speaker": "Student",
      "Text": "Well"
    },
    {
      "Id": 100920080,
      "Speaker": "Student",
      "Text": "I don't know if I can handle all that by myself."
    },
    {
      "Id": 100920090,
      "Speaker": "Student",
      "Text": "You're the one who signed me up for this, Sensei."
    },
    {
      "Id": 100920100,
      "Speaker": "Student",
      "Text": "You gotta come help me!"
    },
    {
      "Id": 100920110,
      "Speaker": "Player",
      "Text": "Are you asking me out on a date?"
    },
    {
      "Id": 100920120,
      "Speaker": "Player",
      "Text": "Hm. That was very smooth, Yoshimi."
    },
    {
      "Id": 100920130,
      "Speaker": "Student",
      "Text": "?"
    },
    {
      "Id": 100920140,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 100920150,
      "Speaker": "Student",
      "Text": "ㅡㅡ;;;"
    },
    {
      "Id": 100920160,
      "Speaker": "Student",
      "Text": "Can you stop messing around?"
    },
    {
      "Id": 100920170,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'm sending you the spot. I'll see you there!"
    },
    {
      "Id": 100920180,
      "Speaker": "Student",
      "Text": "So, um..."
    },
    {
      "Id": 100920190,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 100920200,
      "Speaker": "Student",
      "Text": "That ended up being a huge favor."
    },
    {
      "Id": 100920210,
      "Speaker": "Student",
      "Text": "I swear I didn't think it'd be like that..."
    },
    {
      "Id": 100920220,
      "Speaker": "Player",
      "Text": "Don't sweat it. I enjoyed it."
    },
    {
      "Id": 100920230,
      "Speaker": "Player",
      "Text": "The cuteness of it all was my payment."
    },
    {
      "Id": 100920240,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100920250,
      "Speaker": "Student",
      "Text": "I don't know how to react when you're being all nice..."
    },
    {
      "Id": 100920260,
      "Speaker": "Student",
      "Text": "Anyway"
    },
    {
      "Id": 100920270,
      "Speaker": "Student",
      "Text": "I really am grateful."
    },
    {
      "Id": 100920280,
      "Speaker": "Student",
      "Text": "So thanks, Sensei. I'll pay you back for all this!"
    },
    {
      "Id": 100920290,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 100920300,
      "Speaker": "Student",
      "Text": "I can't get it right...but maybe it doesn't really matter."
    },
    {
      "Id": 100920310,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 100920320,
      "Speaker": "Player",
      "Text": "What?"
    },
    {
      "Id": 100920330,
      "Speaker": "Student",
      "Text": "Nah."
    },
    {
      "Id": 100920340,
      "Speaker": "Student",
      "Text": "I was tryna draw something... But it just won't look the way I want it to."
    },
    {
      "Id": 100920350,
      "Speaker": "Player",
      "Text": "You're drawing?"
    },
    {
      "Id": 100920360,
      "Speaker": "Player",
      "Text": "Is it a design for the band?"
    },
    {
      "Id": 100920370,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 100920380,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Do you mind...taking a look for me?"
    },
    {
      "Id": 100920390,
      "Speaker": "Student",
      "Text": "What's wrong?"
    },
    {
      "Id": 100920400,
      "Speaker": "Student",
      "Text": "Are you sick or something?"
    },
    {
      "Id": 100920410,
      "Speaker": "Student",
      "Text": "You can't just ignore it for a day?"
    },
    {
      "Id": 100920420,
      "Speaker": "Student",
      "Text": "It's a syndrome that'll kill you if you ignore it?"
    },
    {
      "Id": 100920430,
      "Speaker": "Player",
      "Text": "Haha. Okay. Good excuse."
    },
    {
      "Id": 100920440,
      "Speaker": "Player",
      "Text": "Sure, let's go with that!"
    },
    {
      "Id": 100920450,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 100920460,
      "Speaker": "Student",
      "Text": "Ahahaha"
    },
    {
      "Id": 100920470,
      "Speaker": "Student",
      "Text": "I'm soooo pissed"
    },
    {
      "Id": 100920480,
      "Speaker": "Student",
      "Text": "Ahahahahaha"
    },
    {
      "Id": 100920490,
      "Speaker": "Student",
      "Text": "Go die!"
    },
    {
      "Id": 100920500,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 100920510,
      "Speaker": "Student",
      "Text": "This is important, okay?"
    },
    {
      "Id": 100920520,
      "Speaker": "Student",
      "Text": "Are you busy?"
    },
    {
      "Id": 100920530,
      "Speaker": "Player",
      "Text": "Something important?"
    },
    {
      "Id": 100920540,
      "Speaker": "Player",
      "Text": "This feels so serious."
    },
    {
      "Id": 100920550,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 100920560,
      "Speaker": "Student",
      "Text": "Um, well, yeah..."
    },
    {
      "Id": 100920570,
      "Speaker": "Student",
      "Text": "If you've got time, can you come meet me?"
    },
    {
      "Id": 100920580,
      "Speaker": "Student",
      "Text": "I'm sending you the spot."
    },
    {
      "Id": 100920590,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "I'll be there."
    },
    {
      "Id": 100920600,
      "Speaker": "Student",
      "Text": "Phew"
    },
    {
      "Id": 100920610,
      "Speaker": "Student",
      "Text": "I'm dead."
    },
    {
      "Id": 100920620,
      "Speaker": "Student",
      "Text": "I can't believe I did it! I didn't think I could."
    },
    {
      "Id": 100920630,
      "Speaker": "Player",
      "Text": "You did amazing."
    },
    {
      "Id": 100920640,
      "Speaker": "Player",
      "Text": "You should play more often! You were great."
    },
    {
      "Id": 100920650,
      "Speaker": "Student",
      "Text": "Huh"
    },
    {
      "Id": 100920660,
      "Speaker": "Student",
      "Text": "You can be nice sometimes. Wow."
    },
    {
      "Id": 100920670,
      "Speaker": "Student",
      "Text": "Heehee"
    },
    {
      "Id": 100920680,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 100920690,
      "Speaker": "Student",
      "Text": "Thanks for being my audience."
    },
    {
      "Id": 100920700,
      "Speaker": "Player",
      "Text": "About that first song... Haha."
    },
    {
      "Id": 100920710,
      "Speaker": "Player",
      "Text": "I bet I could find the first song! Haha."
    },
    {
      "Id": 100920720,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 100920730,
      "Speaker": "Student",
      "Text": "ㅡㅡ;"
    },
    {
      "Id": 100920740,
      "Speaker": "Student",
      "Text": "You're annoying."
    },
    {
      "Id": 100920750,
      "Speaker": "Student",
      "Text": "I hate you sometimes!"
    }
  ],
  "DialogTH": [
    {
      "Id": 100920010,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100920020,
      "Speaker": "Student",
      "Text": "จะว่าไปแล้ว วงของเราต้องมีชุดสำหรับ\nแสดงนะ"
    },
    {
      "Id": 100920030,
      "Speaker": "Student",
      "Text": "แล้วฉันก็รับผิดชอบเรื่องคอสตูมของ\nวงด้วย"
    },
    {
      "Id": 100920040,
      "Speaker": "Student",
      "Text": "งั้นฉันต้องเลือกชุดให้ทุกคนใช่มั้ย?"
    },
    {
      "Id": 100920050,
      "Speaker": "Player",
      "Text": "น่าจะอย่างนั้นนะ"
    },
    {
      "Id": 100920060,
      "Speaker": "Player",
      "Text": "กังวลตรงไหนรึเปล่า?"
    },
    {
      "Id": 100920070,
      "Speaker": "Student",
      "Text": "ฮืม..."
    },
    {
      "Id": 100920080,
      "Speaker": "Student",
      "Text": "ฉันไม่อยากไปเลือกคนเดียวเลยนี่สิ"
    },
    {
      "Id": 100920090,
      "Speaker": "Student",
      "Text": "แล้วคนที่มอบหมายหน้าที่นี้ให้ฉันก็คือ\nคุณครูด้วย"
    },
    {
      "Id": 100920100,
      "Speaker": "Student",
      "Text": "งั้นก็ต้องไปด้วยกันแล้วละ"
    },
    {
      "Id": 100920110,
      "Speaker": "Player",
      "Text": "จู่ๆ ก็จะขอเดตเหรอ?"
    },
    {
      "Id": 100920120,
      "Speaker": "Player",
      "Text": "ฮืม... ก็เนียนใช้ได้เลยนะ"
    },
    {
      "Id": 100920130,
      "Speaker": "Student",
      "Text": "?"
    },
    {
      "Id": 100920140,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100920150,
      "Speaker": "Student",
      "Text": "- - ;;;"
    },
    {
      "Id": 100920160,
      "Speaker": "Student",
      "Text": "อย่าพูดอะไรเหลวไหลน่า"
    },
    {
      "Id": 100920170,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "เอาเป็นว่าฉันจะส่งพิกัดให้ แล้วเจอกัน\nที่นั่นนะ"
    },
    {
      "Id": 100920180,
      "Speaker": "Student",
      "Text": "รู้สึกเหมือน..."
    },
    {
      "Id": 100920190,
      "Speaker": "Student",
      "Text": "ฉัน..."
    },
    {
      "Id": 100920200,
      "Speaker": "Student",
      "Text": "รบกวนคุณครูไว้เยอะเลย"
    },
    {
      "Id": 100920210,
      "Speaker": "Student",
      "Text": "แต่ฉันไม่ได้คิดจะทำอย่างนั้นเลยนะ;;;"
    },
    {
      "Id": 100920220,
      "Speaker": "Player",
      "Text": "ไม่ต้องคิดมากหรอก\nครูช่วยเพราะอยากช่วยน่ะ"
    },
    {
      "Id": 100920230,
      "Speaker": "Player",
      "Text": "ครูได้เห็นอะไรน่ารักๆ แล้ว\nคิดว่านั่นเป็นค่าตอบแทนแล้วกัน"
    },
    {
      "Id": 100920240,
      "Speaker": "Student",
      "Text": ";;;;;;;;"
    },
    {
      "Id": 100920250,
      "Speaker": "Student",
      "Text": "จู่ๆ ก็มาพูดอะไรจริงจังแบบนี้ ฉันทำตัว\nไม่ถูกนะ"
    },
    {
      "Id": 100920260,
      "Speaker": "Student",
      "Text": "เอาเถอะ"
    },
    {
      "Id": 100920270,
      "Speaker": "Student",
      "Text": "แต่วันนี้ซื้อของได้หมดเพราะได้คุณครู\nช่วยไว้จริงๆ นั่นละ"
    },
    {
      "Id": 100920280,
      "Speaker": "Student",
      "Text": "ขอบคุณนะคุณครู ไว้ครั้งหน้าฉันจะหา\nอะไรมาตอบแทนนะ!"
    },
    {
      "Id": 100920290,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100920300,
      "Speaker": "Student",
      "Text": "ไม่รู้เลยว่าจะได้มั้ย แต่ก็ดูโอเคอยู่นะ"
    },
    {
      "Id": 100920310,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 100920320,
      "Speaker": "Player",
      "Text": "อะไรเหรอ?"
    },
    {
      "Id": 100920330,
      "Speaker": "Student",
      "Text": "ก็แบบ"
    },
    {
      "Id": 100920340,
      "Speaker": "Student",
      "Text": "ฉันลองออกแบบไว้ล่วงหน้าน่ะ แต่มัน\nไม่สวยเลย"
    },
    {
      "Id": 100920350,
      "Speaker": "Player",
      "Text": "กำลังออกแบบอยู่เหรอ?"
    },
    {
      "Id": 100920360,
      "Speaker": "Player",
      "Text": "สัญลักษณ์วงเหรอ?"
    },
    {
      "Id": 100920370,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100920380,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "มาช่วยดูหน่อยได้มั้ย?"
    },
    {
      "Id": 100920390,
      "Speaker": "Student",
      "Text": "มันอะไรกัน"
    },
    {
      "Id": 100920400,
      "Speaker": "Student",
      "Text": "มีโรคประจำตัวงั้นเหรอ?"
    },
    {
      "Id": 100920410,
      "Speaker": "Student",
      "Text": "จะให้มีวันที่สงบสุขสักวันไม่ได้รึไง?"
    },
    {
      "Id": 100920420,
      "Speaker": "Student",
      "Text": "หรือว่าถ้าไม่ได้แกล้งกันจะเป็นโรค\nนอนไม่หลับ?"
    },
    {
      "Id": 100920430,
      "Speaker": "Player",
      "Text": "โอ๊ะ 555+ แก้ตัวแบบนั้นก็ฟังขึ้นอยู่นะ"
    },
    {
      "Id": 100920440,
      "Speaker": "Player",
      "Text": "งั้นเอาเป็นว่าครูเป็นโรคนั้นแล้วกัน~!"
    },
    {
      "Id": 100920450,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100920460,
      "Speaker": "Student",
      "Text": "5555+"
    },
    {
      "Id": 100920470,
      "Speaker": "Student",
      "Text": "น่าหงุดหงิดที่สุดเลย!"
    },
    {
      "Id": 100920480,
      "Speaker": "Student",
      "Text": "5555++"
    },
    {
      "Id": 100920490,
      "Speaker": "Student",
      "Text": "จะไปไหนก็ไปเลยไป"
    },
    {
      "Id": 100920500,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100920510,
      "Speaker": "Student",
      "Text": "ฉันมีเรื่องสำคัญน่ะ"
    },
    {
      "Id": 100920520,
      "Speaker": "Student",
      "Text": "พอมีเวลามั้ย?"
    },
    {
      "Id": 100920530,
      "Speaker": "Player",
      "Text": "เรื่องสำคัญเหรอ?"
    },
    {
      "Id": 100920540,
      "Speaker": "Player",
      "Text": "บรรยากาศดูจริงจังขึ้นมาเลย"
    },
    {
      "Id": 100920550,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100920560,
      "Speaker": "Student",
      "Text": "ก็คงอย่างนั้นน่ะ"
    },
    {
      "Id": 100920570,
      "Speaker": "Student",
      "Text": "ถ้าไม่ติดอะไร มาหาฉันหน่อยได้มั้ย?"
    },
    {
      "Id": 100920580,
      "Speaker": "Student",
      "Text": "ฉันจะส่งพิกัดไปให้"
    },
    {
      "Id": 100920590,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "มาให้ได้นะ"
    },
    {
      "Id": 100920600,
      "Speaker": "Student",
      "Text": "ฮู่ว..."
    },
    {
      "Id": 100920610,
      "Speaker": "Student",
      "Text": "เหนื่อยเป็นบ้าเลย"
    },
    {
      "Id": 100920620,
      "Speaker": "Student",
      "Text": "ไม่คิดเลยนะว่าจะเล่นจนครบทุกเพลง"
    },
    {
      "Id": 100920630,
      "Speaker": "Player",
      "Text": "ยอดเยี่ยมเลยละ"
    },
    {
      "Id": 100920640,
      "Speaker": "Player",
      "Text": "เก่งมากเลย ไว้เล่นให้ฟังบ่อยๆ นะ"
    },
    {
      "Id": 100920650,
      "Speaker": "Student",
      "Text": "อะไรกัน"
    },
    {
      "Id": 100920660,
      "Speaker": "Student",
      "Text": "ชมกันดีๆ ก็เป็นเหรอเนี่ย"
    },
    {
      "Id": 100920670,
      "Speaker": "Student",
      "Text": "ฮิฮิ"
    },
    {
      "Id": 100920680,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100920690,
      "Speaker": "Student",
      "Text": "ขอบคุณที่ตั้งใจฟังนะ"
    },
    {
      "Id": 100920700,
      "Speaker": "Player",
      "Text": "อ้อ จะว่าไปแล้ว... เพลงแรกน่ะ 55"
    },
    {
      "Id": 100920710,
      "Speaker": "Player",
      "Text": "หาเจอแล้วละว่าเป็นเพลงอะไร 555+"
    },
    {
      "Id": 100920720,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100920730,
      "Speaker": "Student",
      "Text": "- - ;"
    },
    {
      "Id": 100920740,
      "Speaker": "Student",
      "Text": "น่าหงุดหงิดจริงๆ"
    },
    {
      "Id": 100920750,
      "Speaker": "Student",
      "Text": "เหนื่อยแล้วยังต้องหัวร้อนอีก"
    }
  ],
  "DialogTW": [
    {
      "Id": 100920010,
      "Speaker": "Student",
      "Text": "對了，老師"
