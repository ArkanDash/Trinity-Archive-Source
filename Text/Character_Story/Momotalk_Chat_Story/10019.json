  "DialogEN": [
    {
      "Id": 100190010,
      "Speaker": "Student",
      "Text": "I've confirmed there's a risk of our messages being watched."
    },
    {
      "Id": 100190020,
      "Speaker": "Student",
      "Text": "Let me get straight to the point."
    },
    {
      "Id": 100190030,
      "Speaker": "Student",
      "Text": "Tomorrow at 18:00. Come to these MGRS coordinates."
    },
    {
      "Id": 100190040,
      "Speaker": "Student",
      "Text": "TN 58XX.XXXX 17XX.XX"
    },
    {
      "Id": 100190050,
      "Speaker": "Student",
      "Text": "You must come alone."
    },
    {
      "Id": 100190060,
      "Speaker": "Student",
      "Text": "If you understand, reply back with \"Yes.\""
    },
    {
      "Id": 100190070,
      "Speaker": "Player",
      "Text": "...Azusa?"
    },
    {
      "Id": 100190080,
      "Speaker": "Student",
      "Text": "Sensei, you dummy!"
    },
    {
      "Id": 100190090,
      "Speaker": "Student",
      "Text": "You have to speak in code!"
    },
    {
      "Id": 100190100,
      "Speaker": "Student",
      "Text": "They're gonna find out who you are if you say your name!"
    },
    {
      "Id": 100190110,
      "Speaker": "Player",
      "Text": "Even through text messages...?"
    },
    {
      "Id": 100190120,
      "Speaker": "Student",
      "Text": "Of course! You can never let your guard down when it comes to privacy!"
    },
    {
      "Id": 100190130,
      "Speaker": "Student",
      "Text": "If you understand, reply back with \"Yes.\""
    },
    {
      "Id": 100190140,
      "Speaker": "Player",
      "Text": "Yes..."
    },
    {
      "Id": 100190150,
      "Speaker": "Student",
      "Text": "You're so high-maintenance..."
    },
    {
      "Id": 100190160,
      "Speaker": "Student",
      "Text": "Forget it."
    },
    {
      "Id": 100190170,
      "Speaker": "Student",
      "Text": "We'll talk tomorrow."
    },
    {
      "Id": 100190180,
      "Speaker": "Student",
      "Text": "Come to the meeting spot."
    },
    {
      "Id": 100190190,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "End of communication."
    },
    {
      "Id": 100190200,
      "Speaker": "Student",
      "Text": "Duck, please respond."
    },
    {
      "Id": 100190210,
      "Speaker": "Student",
      "Text": "This is Penguin."
    },
    {
      "Id": 100190220,
      "Speaker": "Player",
      "Text": "This is Duck."
    },
    {
      "Id": 100190230,
      "Speaker": "Player",
      "Text": "Penguin... I'm waiting."
    },
    {
      "Id": 100190240,
      "Speaker": "Student",
      "Text": "Okay. Duck."
    },
    {
      "Id": 100190250,
      "Speaker": "Student",
      "Text": "Our mission today is extremely confidential. You must be extra careful."
    },
    {
      "Id": 100190260,
      "Speaker": "Student",
      "Text": "End of communication."
    },
    {
      "Id": 100190270,
      "Speaker": "Student",
      "Text": "That's all. Penguin."
    },
    {
      "Id": 100190280,
      "Speaker": "Student",
      "Text": "Squirrel. Please respond. Squirrel."
    },
    {
      "Id": 100190290,
      "Speaker": "Student",
      "Text": "This is Chipmunk."
    },
    {
      "Id": 100190300,
      "Speaker": "Student",
      "Text": "I'll be visiting Squirrel very soon."
    },
    {
      "Id": 100190310,
      "Speaker": "Student",
      "Text": "Is Squirrel in the cave?"
    },
    {
      "Id": 100190320,
      "Speaker": "Player",
      "Text": "Aren't you Penguin, Azusa?"
    },
    {
      "Id": 100190330,
      "Speaker": "Player",
      "Text": "I'm not Squirrel. I'm Duck..."
    },
    {
      "Id": 100190340,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100190350,
      "Speaker": "Student",
      "Text": "Sensei...I mean, Squirrel."
    },
    {
      "Id": 100190360,
      "Speaker": "Student",
      "Text": "It's code. We're speaking in code."
    },
    {
      "Id": 100190370,
      "Speaker": "Student",
      "Text": "Code is meaningless if you don't change it up every day."
    },
    {
      "Id": 100190380,
      "Speaker": "Student",
      "Text": "I've confirmed that you're in place. I'll be there in 15 minutes."
    },
    {
      "Id": 100190390,
      "Speaker": "Student",
      "Text": "I'll disclose the details in person."
    },
    {
      "Id": 100190400,
      "Speaker": "Student",
      "Text": "Penguin."
    },
    {
      "Id": 100190410,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100190420,
      "Speaker": "Student",
      "Text": "Correction."
    },
    {
      "Id": 100190430,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Squirrel."
    },
    {
      "Id": 100190440,
      "Speaker": "Student",
      "Text": "I've confirmed your safety measures, so I've returned."
    },
    {
      "Id": 100190450,
      "Speaker": "Student",
      "Text": "Self-defense is important, but you have to take care of your health."
    },
    {
      "Id": 100190460,
      "Speaker": "Student",
      "Text": "If you understand, reply back with \"Yes.\" Squirrel."
    },
    {
      "Id": 100190470,
      "Speaker": "Player",
      "Text": "Yes..."
    },
    {
      "Id": 100190480,
      "Speaker": "Student",
      "Text": "Good. I'll be waiting for training day."
    },
    {
      "Id": 100190490,
      "Speaker": "Student",
      "Text": "That's all. Chipmunk."
    },
    {
      "Id": 100190500,
      "Speaker": "Student",
      "Text": "Welsh Corgi to Golden Retriever."
    },
    {
      "Id": 100190510,
      "Speaker": "Student",
      "Text": "It's D-Day."
    },
    {
      "Id": 100190520,
      "Speaker": "Student",
      "Text": "You didn't forget, did you?"
    },
    {
      "Id": 100190530,
      "Speaker": "Student",
      "Text": "If you remember, reply back with \"Yes.\""
    },
    {
      "Id": 100190540,
      "Speaker": "Player",
      "Text": "D-Day? What are you talking about?"
    },
    {
      "Id": 100190550,
      "Speaker": "Player",
      "Text": "Yes..."
    },
    {
      "Id": 100190560,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100190570,
      "Speaker": "Student",
      "Text": "I told you already..."
    },
    {
      "Id": 100190580,
      "Speaker": "Student",
      "Text": "Good. Let's begin."
    },
    {
      "Id": 100190590,
      "Speaker": "Student",
      "Text": "This training is designed to help me adapt to life here."
    },
    {
      "Id": 100190600,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Welsh Corgi is ready. Golden Retriever needs to be ready too."
    },
    {
      "Id": 100190610,
      "Speaker": "Student",
      "Text": "Golden Retriever."
    },
    {
      "Id": 100190620,
      "Speaker": "Student",
      "Text": "This is Welsh Corgi."
    },
    {
      "Id": 100190630,
      "Speaker": "Player",
      "Text": "Huh? What's going on?"
    },
    {
      "Id": 100190640,
      "Speaker": "Player",
      "Text": "Do you have any other questions?"
    },
    {
      "Id": 100190650,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100190660,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100190670,
      "Speaker": "Student",
      "Text": "I just felt like texting."
    },
    {
      "Id": 100190680,
      "Speaker": "Student",
      "Text": "10.0 10.1 9.7 9.3. 10.2 10.1"
    },
    {
      "Id": 100190690,
      "Speaker": "Student",
      "Text": "8.9 10.4 10.3 10.0 10.2 10.7"
    },
    {
      "Id": 100190700,
      "Speaker": "Player",
      "Text": "What are these numbers supposed to mean?"
    },
    {
      "Id": 100190710,
      "Speaker": "Player",
      "Text": "...Azusa?"
    },
    {
      "Id": 100190720,
      "Speaker": "Student",
      "Text": "...?"
    },
    {
      "Id": 100190730,
      "Speaker": "Student",
      "Text": "Oh..."
    },
    {
      "Id": 100190740,
      "Speaker": "Student",
      "Text": "Sorry. That was a mistake."
    },
    {
      "Id": 100190750,
      "Speaker": "Student",
      "Text": "I wrote it out to check something, but I sent it to you by accident, Pigeon."
    },
    {
      "Id": 100190760,
      "Speaker": "Student",
      "Text": "And please use code."
    },
    {
      "Id": 100190770,
      "Speaker": "Player",
      "Text": "Oh, I'm sorry."
    },
    {
      "Id": 100190780,
      "Speaker": "Player",
      "Text": "What are you, then? Sparrow?"
    },
    {
      "Id": 100190790,
      "Speaker": "Student",
      "Text": "Hmm."
    },
    {
      "Id": 100190800,
      "Speaker": "Student",
      "Text": "Sparrow?"
    },
    {
      "Id": 100190810,
      "Speaker": "Student",
      "Text": "Hmm, that's not bad. Let's just go with that."
    },
    {
      "Id": 100190820,
      "Speaker": "Student",
      "Text": "...Are you curious about those numbers, Pigeon?"
    },
    {
      "Id": 100190830,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Yes..."
    }
  ],
  "DialogTH": [
    {
      "Id": 100190010,
      "Speaker": "Student",
      "Text": "ยืนยันได้ว่าการสื่อสารนี้มีความเสี่ยง\nในการถูกติดตาม"
    },
    {
      "Id": 100190020,
      "Speaker": "Student",
      "Text": "ฉันจะเข้าเรื่องเลยก็แล้วกัน"
    },
    {
      "Id": 100190030,
      "Speaker": "Student",
      "Text": "พรุ่งนี้หกโมงเย็น มาเจอกันที่พิกัด\nMGRS"
    },
    {
      "Id": 100190040,
      "Speaker": "Student",
      "Text": "TN 58XX.XXXX 17XX.XX"
    },
    {
      "Id": 100190050,
      "Speaker": "Student",
      "Text": "มาแค่คนเดียวล่ะ"
    },
    {
      "Id": 100190060,
      "Speaker": "Student",
      "Text": "ถ้าเข้าใจแล้ว ให้ตอบว่า อื้ม!"
    },
    {
      "Id": 100190070,
      "Speaker": "Player",
      "Text": "อาซึสะ...?"
    },
    {
      "Id": 100190080,
      "Speaker": "Student",
      "Text": "คุณครูนี่ก็!"
    },
    {
      "Id": 100190090,
      "Speaker": "Student",
      "Text": "บอกว่าให้ใช้รหัสลับสื่อสารไงล่ะ!"
    },
    {
      "Id": 100190100,
      "Speaker": "Student",
      "Text": "ถ้าพูดชื่อก็รู้หมดสิว่าเป็นใคร!"
    },
    {
      "Id": 100190110,
      "Speaker": "Player",
      "Text": "ต้องทำถึงขนาดนั้น\nแม้แต่ในแชตด้วยเหรอ?"
    },
    {
      "Id": 100190120,
      "Speaker": "Student",
      "Text": "ก็ใช่น่ะสิ!! การรักษาความปลอดภัย\nเป็นเรื่องสำคัญมากนะ!"
    },
    {
      "Id": 100190130,
      "Speaker": "Student",
      "Text": "ถ้าเข้าใจแล้ว ให้ตอบว่า อื้ม!"
    },
    {
      "Id": 100190140,
      "Speaker": "Player",
      "Text": "อื้ม..."
    },
    {
      "Id": 100190150,
      "Speaker": "Student",
      "Text": "ช่างเป็นคนที่ยุ่งยากซะจริงๆ..."
    },
    {
      "Id": 100190160,
      "Speaker": "Student",
      "Text": "เอาเถอะ"
    },
    {
      "Id": 100190170,
      "Speaker": "Student",
      "Text": "ไว้จะบอกรายละเอียดให้ฟัง"
    },
    {
      "Id": 100190180,
      "Speaker": "Student",
      "Text": "ตอนที่เราเจอกันพรุ่งนี้"
    },
    {
      "Id": 100190190,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "จบการสื่อสาร"
    },
    {
      "Id": 100190200,
      "Speaker": "Student",
      "Text": "เจ้าเป็ด ฉันคือเพนกวิ้น"
    },
    {
      "Id": 100190210,
      "Speaker": "Student",
      "Text": "ว.2 ทราบแล้วเปลี่ยน"
    },
    {
      "Id": 100190220,
      "Speaker": "Player",
      "Text": "เป็ดตอบ"
    },
    {
      "Id": 100190230,
      "Speaker": "Player",
      "Text": "เพนกวิ้น... กำลังรออยู่เลย"
    },
    {
      "Id": 100190240,
      "Speaker": "Student",
      "Text": "ดีมาก เจ้าเป็ด"
    },
    {
      "Id": 100190250,
      "Speaker": "Student",
      "Text": "ภารกิจวันนี้เป็นความลับสุดยอด\nต้องระวังให้ดีล่ะ"
    },
    {
      "Id": 100190260,
      "Speaker": "Student",
      "Text": "จบการสื่อสาร"
    },
    {
      "Id": 100190270,
      "Speaker": "Student",
      "Text": "แล้วเจอกันใหม่นะเจ้าเป็ด"
    },
    {
      "Id": 100190280,
      "Speaker": "Student",
      "Text": "กระแต ทราบแล้วเปลี่ยน กระแต"
    },
    {
      "Id": 100190290,
      "Speaker": "Student",
      "Text": "ฉันคือกระรอก"
    },
    {
      "Id": 100190300,
      "Speaker": "Student",
      "Text": "ฉันจะไปหาที่โพรงกระแต"
    },
    {
      "Id": 100190310,
      "Speaker": "Student",
      "Text": "กระแตอยู่ในโพรงหรือเปล่า?"
    },
    {
      "Id": 100190320,
      "Speaker": "Player",
      "Text": "อาซึสะไม่ได้เป็นเพนกวิ้นเหรอ?"
    },
    {
      "Id": 100190330,
      "Speaker": "Player",
      "Text": "ครูไม่ใช่กระแต แต่เป็นเป็ดไม่ใช่เหรอ..."
    },
    {
      "Id": 100190340,
      "Speaker": "Student",
      "Text": "เฮ้อ..."
    },
    {
      "Id": 100190350,
      "Speaker": "Student",
      "Text": "คุณครู ไม่สิ กระแต"
