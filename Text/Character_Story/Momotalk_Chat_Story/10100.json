{
  "CharacterId": 10100,
  "DialogJP": [
    {
      "Id": 101000010,
      "Speaker": "Student",
      "Text": "テスト"
    },
    {
      "Id": 101000020,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 101000030,
      "Speaker": "Student",
      "Text": "あーあー"
    },
    {
      "Id": 101000040,
      "Speaker": "Student",
      "Text": "このメッセージ、見えてる？"
    },
    {
      "Id": 101000050,
      "Speaker": "Player",
      "Text": "ちゃんと見えるよ、シロコ"
    },
    {
      "Id": 101000060,
      "Speaker": "Student",
      "Text": "ん"
    },
    {
      "Id": 101000070,
      "Speaker": "Student",
      "Text": "良かった"
    },
    {
      "Id": 101000080,
      "Speaker": "Student",
      "Text": "じゃあ、また連絡する"
    },
    {
      "Id": 101000090,
      "Speaker": "Player",
      "Text": "待って、今どこにいるの？"
    },
    {
      "Id": 101000100,
      "Speaker": "Student",
      "Text": "私？"
    },
    {
      "Id": 101000110,
      "Speaker": "Student",
      "Text": "アビドス自治区だけど"
    },
    {
      "Id": 101000120,
      "Speaker": "Player",
      "Text": "これから少し会えないかな？"
    },
    {
      "Id": 101000130,
      "Speaker": "Student",
      "Text": "……ん"
    },
    {
      "Id": 101000140,
      "Speaker": "Student",
      "Text": "分かった"
    },
    {
      "Id": 101000150,
      "Speaker": "Student",
      "Text": "待ってるね"
    },
    {
      "Id": 101000160,
      "Speaker": "Player",
      "Text": "すぐ行くよ！"
    },
    {
      "Id": 101000170,
      "Speaker": "Student",
      "Text": "卵、牛乳、洗剤、タオル、ティッシュ"
    },
    {
      "Id": 101000180,
      "Speaker": "Student",
      "Text": "あと、ボディーソープも"
    },
    {
      "Id": 101000190,
      "Speaker": "Player",
      "Text": "……何の話？"
    },
    {
      "Id": 101000200,
      "Speaker": "Player",
      "Text": "シロコ？"
    },
    {
      "Id": 101000210,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 101000220,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ごめん、間違えた"
    },
    {
      "Id": 101000230,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101000240,
      "Speaker": "Student",
      "Text": "今、すごく良いアイデアが浮かんだ"
    },
    {
      "Id": 101000250,
      "Speaker": "Student",
      "Text": "ちょっと来てくれる？"
    },
    {
      "Id": 101000260,
      "Speaker": "Player",
      "Text": "とりあえず、すぐ行くね！"
    },
    {
      "Id": 101000270,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 101000280,
      "Speaker": "Student",
      "Text": "……ん"
    },
    {
      "Id": 101000290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "直接説明するね"
    },
    {
      "Id": 101000300,
      "Speaker": "Student",
      "Text": "先生、大変"
    },
    {
      "Id": 101000310,
      "Speaker": "Student",
      "Text": "昔のサイクルジャージを着てみたら"
    },
    {
      "Id": 101000320,
      "Speaker": "Student",
      "Text": "ファスナーが……"
    },
    {
      "Id": 101000330,
      "Speaker": "Player",
      "Text": "まさか……！？"
    },
    {
      "Id": 101000340,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 101000350,
      "Speaker": "Student",
      "Text": "念のため言っておくけど"
    },
    {
      "Id": 101000360,
      "Speaker": "Student",
      "Text": "太ったわけじゃないから"
    },
    {
      "Id": 101000370,
      "Speaker": "Player",
      "Text": "う、うん……"
    },
    {
      "Id": 101000380,
      "Speaker": "Student",
      "Text": "ん"
    },
    {
      "Id": 101000390,
      "Speaker": "Student",
      "Text": "おやすみ、先生"
    },
    {
      "Id": 101000400,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101000410,
      "Speaker": "Student",
      "Text": "時間があれば"
    },
    {
      "Id": 101000420,
      "Speaker": "Student",
      "Text": "今から会える？"
    },
    {
      "Id": 101000430,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 101000440,
      "Speaker": "Student",
      "Text": "ん"
    },
    {
      "Id": 101000450,
      "Speaker": "Student",
      "Text": "悩み事があって……"
    },
    {
      "Id": 101000460,
      "Speaker": "Player",
      "Text": "分かった、すぐ向かうね！"
    },
    {
      "Id": 101000470,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ん、ありがとう"
    },
    {
      "Id": 101000480,
      "Speaker": "Student",
      "Text": "勝負の決着がついた"
    },
    {
      "Id": 101000490,
      "Speaker": "Player",
      "Text": "勝負したの！？"
    },
    {
      "Id": 101000500,
      "Speaker": "Student",
      "Text": "ん"
    },
    {
      "Id": 101000510,
      "Speaker": "Student",
      "Text": "その場の成り行きで"
    },
    {
      "Id": 101000520,
      "Speaker": "Student",
      "Text": "サイクルレースをすることになった"
    },
    {
      "Id": 101000530,
      "Speaker": "Player",
      "Text": "サイクルレース！？"
    },
    {
      "Id": 101000540,
      "Speaker": "Player",
      "Text": "どっちが勝ったの！？"
    },
    {
      "Id": 101000550,
      "Speaker": "Student",
      "Text": "ん……"
    },
    {
      "Id": 101000560,
      "Speaker": "Student",
      "Text": "4勝7敗。1引き分け"
    },
    {
      "Id": 101000570,
      "Speaker": "Student",
      "Text": "私の負け"
    },
    {
      "Id": 101000580,
      "Speaker": "Player",
      "Text": "やっぱり、現役のほうが強かったんだ……"
    },
    {
      "Id": 101000590,
      "Speaker": "Student",
      "Text": "でも、今回は仕方ない"
    },
    {
      "Id": 101000600,
      "Speaker": "Student",
      "Text": "相手はサイクルジャージを着ていたから"
    },
    {
      "Id": 101000610,
      "Speaker": "Student",
      "Text": "準備が整ったら"
    },
    {
      "Id": 101000620,
      "Speaker": "Student",
      "Text": "リベンジするつもり"
    },
    {
      "Id": 101000630,
      "Speaker": "Student",
      "Text": "その時は見に来てね、先生"
    },
    {
      "Id": 101000640,
      "Speaker": "Player",
      "Text": "うん、もちろん。必ず行くね"
    },
    {
      "Id": 101000650,
      "Speaker": "Student",
      "Text": "先生は、どっちを応援する？"
    },
    {
      "Id": 101000660,
      "Speaker": "Player",
      "Text": "それは内緒"
    },
    {
      "Id": 101000670,
      "Speaker": "Player",
      "Text": "二人とも応援してるよ"
    },
    {
      "Id": 101000680,
      "Speaker": "Student",
      "Text": "ん"
    },
    {
      "Id": 101000690,
      "Speaker": "Student",
      "Text": "そう言うと思った"
    },
    {
      "Id": 101000700,
      "Speaker": "Student",
      "Text": "ありがとう、先生"
    },
    {
      "Id": 101000710,
      "Speaker": "Student",
      "Text": "また連絡するね"
    }
  ],
  "DialogKR": [
    {
      "Id": 101000010,
      "Speaker": "Student",
      "Text": "테스트용 메시지야"
    },
    {
      "Id": 101000020,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 101000030,
      "Speaker": "Student",
      "Text": "아아"
    },
    {
      "Id": 101000040,
      "Speaker": "Student",
      "Text": "잘 보여? 전송은 잘 되고 있어?"
    },
    {
      "Id": 101000050,
      "Speaker": "Player",
      "Text": "응. 잘되는 거 같아 시로코"
    },
    {
      "Id": 101000060,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 101000070,
      "Speaker": "Student",
      "Text": "그러네 다행이야"
    },
    {
      "Id": 101000080,
      "Speaker": "Student",
      "Text": "그럼 또 연락할게"
    },
    {
      "Id": 101000090,
      "Speaker": "Player",
      "Text": "잠깐만. 시로코는 지금은 어디에 있는 거야?"
    },
    {
      "Id": 101000100,
      "Speaker": "Student",
      "Text": "나?"
    },
    {
      "Id": 101000110,
      "Speaker": "Student",
      "Text": "아비도스 자치구에 있어"
    },
    {
      "Id": 101000120,
      "Speaker": "Player",
      "Text": "그럼 잠깐 만나자!!"
    },
    {
      "Id": 101000130,
      "Speaker": "Student",
      "Text": "……응."
    },
    {
      "Id": 101000140,
      "Speaker": "Student",
      "Text": "문제없어"
    },
    {
      "Id": 101000150,
      "Speaker": "Student",
      "Text": "기다리고 있을게"
    },
    {
      "Id": 101000160,
      "Speaker": "Player",
      "Text": "그래, 기다려!"
    },
    {
      "Id": 101000170,
      "Speaker": "Student",
      "Text": "세제, 우유 500ml, 계란 작은 팩, 티슈, 수건"
    },
    {
      "Id": 101000180,
      "Speaker": "Student",
      "Text": "바디클린저 < 꼭 살 것"
    },
    {
      "Id": 101000190,
      "Speaker": "Player",
      "Text": "……응?"
    },
    {
      "Id": 101000200,
      "Speaker": "Player",
      "Text": "시로코?"
    },
    {
      "Id": 101000210,
      "Speaker": "Student",
      "Text": "아."
    },
    {
      "Id": 101000220,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "잘못 보냈어. 미안 선생님."
    },
    {
      "Id": 101000230,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101000240,
      "Speaker": "Student",
      "Text": "나 엄청난 아이디어가 생각났어."
    },
    {
      "Id": 101000250,
      "Speaker": "Student",
      "Text": "당장 이쪽으로 와줘."
    },
    {
      "Id": 101000260,
      "Speaker": "Player",
      "Text": "뭔진 모르겠지만 당장 갈게!"
    },
    {
      "Id": 101000270,
      "Speaker": "Student",
      "Text": "아, 으응."
    },
    {
      "Id": 101000280,
      "Speaker": "Student",
      "Text": "그러니까……"
    },
    {
      "Id": 101000290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "만나서 설명할게."
    },
    {
      "Id": 101000300,
      "Speaker": "Student",
      "Text": "선생님 큰일 났어……."
    },
    {
      "Id": 101000310,
      "Speaker": "Student",
      "Text": "혹시 몰라 가지고 있던 라이딩 슈트를 입어봤는데"
    },
    {
      "Id": 101000320,
      "Speaker": "Student",
      "Text": "지퍼가……."
    },
    {
      "Id": 101000330,
      "Speaker": "Player",
      "Text": "저런……?!"
    },
    {
      "Id": 101000340,
      "Speaker": "Student",
      "Text": "아,"
    },
    {
      "Id": 101000350,
      "Speaker": "Student",
      "Text": "오해할까 봐 말해두겠는데"
    },
    {
      "Id": 101000360,
      "Speaker": "Student",
      "Text": "살이 찐 건 아니야."
    },
    {
      "Id": 101000370,
      "Speaker": "Player",
      "Text": "으음, 과연……."
    },
    {
      "Id": 101000380,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 101000390,
      "Speaker": "Student",
      "Text": "잘 자. 선생님."
    },
    {
      "Id": 101000400,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 101000410,
      "Speaker": "Student",
      "Text": "괜찮다면"
    },
    {
      "Id": 101000420,
      "Speaker": "Student",
      "Text": "혹시 좀 만날 수 있을까?"
    },
    {
      "Id": 101000430,
      "Speaker": "Player",
      "Text": "무슨 일이야, 시로코?"
    },
    {
      "Id": 101000440,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 101000450,
      "Speaker": "Student",
      "Text": "고민 상담이랄까……."
    },
    {
      "Id": 101000460,
      "Speaker": "Player",
      "Text": "그런 거라면 알겠어!"
    },
    {
      "Id": 101000470,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "응 고마워"
    },
    {
      "Id": 101000480,
      "Speaker": "Student",
      "Text": "승부는"
    },
    {
      "Id": 101000490,
      "Speaker": "Player",
      "Text": "승부……?!"
    },
    {
      "Id": 101000500,
      "Speaker": "Student",
      "Text": "아아."
    },
    {
      "Id": 101000510,
      "Speaker": "Student",
      "Text": "응. 어쩌다 보니까"
    },
    {
      "Id": 101000520,
      "Speaker": "Student",
      "Text": "로드 레이싱 승부로 이어져 버려서……."
    },
    {
      "Id": 101000530,
      "Speaker": "Player",
      "Text": "로드 레이싱?!"
    },
    {
      "Id": 101000540,
      "Speaker": "Player",
      "Text": "누가 이겼나요?!"
    },
    {
      "Id": 101000550,
      "Speaker": "Student",
      "Text": "승부 결과는……"
    },
    {
      "Id": 101000560,
      "Speaker": "Student",
      "Text": "12전 4승 7패 1무승부"
    },
    {
      "Id": 101000570,
      "Speaker": "Student",
      "Text": "내 패배야"
    },
    {
      "Id": 101000580,
      "Speaker": "Player",
      "Text": "역시 현역이 강하네……."
    },
    {
      "Id": 101000590,
      "Speaker": "Student",
      "Text": "하지만 괜찮아."
    },
    {
      "Id": 101000600,
      "Speaker": "Student",
      "Text": "그쪽은 라이딩 슈트까지 입고 왔으니까"
    },
    {
      "Id": 101000610,
      "Speaker": "Student",
      "Text": "내 자전거가 완성되면"
    },
    {
      "Id": 101000620,
      "Speaker": "Student",
      "Text": "리벤지 매치를 할 거니까"
    },
    {
      "Id": 101000630,
      "Speaker": "Student",
      "Text": "그땐 꼭 참관해 줘, 선생님."
    },
    {
      "Id": 101000640,
      "Speaker": "Player",
      "Text": "아아, 물론이야. 꼭 갈게."
    },
    {
      "Id": 101000650,
      "Speaker": "Student",
      "Text": "그땐 누구를 응원할 거야?"
    },
    {
      "Id": 101000660,
      "Speaker": "Player",
      "Text": "그건 비밀."
    },
    {
      "Id": 101000670,
      "Speaker": "Player",
      "Text": "알려줄 수 없지."
    },
    {
      "Id": 101000680,
      "Speaker": "Student",
      "Text": "응."
    },
    {
      "Id": 101000690,
      "Speaker": "Student",
      "Text": "그럴 거 같았어"
    },
    {
      "Id": 101000700,
      "Speaker": "Student",
      "Text": "고마워 선생님"
    },
    {
      "Id": 101000710,
      "Speaker": "Student",
      "Text": "다음에 또 연락할게"
    }
  ],
  "DialogEN": [
    {
      "Id": 101000010,
      "Speaker": "Student",
      "Text": "This is a test message."
    },
    {
      "Id": 101000020,
      "Speaker": "Student",
      "Text": "Ahem"
    },
    {
      "Id": 101000030,
      "Speaker": "Student",
      "Text": "AHEMMM"
    },
    {
      "Id": 101000040,
      "Speaker": "Student",
      "Text": "Can you see this? Is it working?"
    },
    {
      "Id": 101000050,
      "Speaker": "Player",
      "Text": "Yeah, Shiroko, I think it’s working okay"
    },
    {
      "Id": 101000060,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 101000070,
      "Speaker": "Student",
      "Text": "Good. I'm glad."
    },
    {
      "Id": 101000080,
      "Speaker": "Student",
      "Text": "Talk to you later."
    },
    {
      "Id": 101000090,
      "Speaker": "Player",
      "Text": "Hey, Shiroko, wait. Where are you now?"
    },
    {
      "Id": 101000100,
      "Speaker": "Student",
      "Text": "Me?"
    },
    {
      "Id": 101000110,
      "Speaker": "Student",
      "Text": "I'm in the Abydos district"
    },
    {
      "Id": 101000120,
      "Speaker": "Player",
      "Text": "Let's hang out!!"
    },
    {
      "Id": 101000130,
      "Speaker": "Student",
      "Text": "...All right."
    },
    {
      "Id": 101000140,
      "Speaker": "Student",
      "Text": "I can make that work"
    },
    {
      "Id": 101000150,
      "Speaker": "Student",
      "Text": "I'll be waiting"
    },
    {
      "Id": 101000160,
      "Speaker": "Player",
      "Text": "I won't be long!"
    },
    {
      "Id": 101000170,
      "Speaker": "Student",
      "Text": "Detergent, 500 milliliters of milk, a half dozen eggs, tissues, a towel"
    },
    {
      "Id": 101000180,
      "Speaker": "Student",
      "Text": "Shower gel < MUST get"
    },
    {
      "Id": 101000190,
      "Speaker": "Player",
      "Text": "...Huh?"
    },
    {
      "Id": 101000200,
      "Speaker": "Player",
      "Text": "Shiroko?"
    },
    {
      "Id": 101000210,
      "Speaker": "Student",
      "Text": "Oh."
    },
    {
      "Id": 101000220,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Sorry, Sensei, didn't mean to send that to you."
    },
    {
      "Id": 101000230,
      "Speaker": "Student",
      "Text": "Hey, Sensei."
    },
    {
      "Id": 101000240,
      "Speaker": "Student",
      "Text": "I have an amazing idea."
    },
    {
      "Id": 101000250,
      "Speaker": "Student",
      "Text": "Come here right away."
    },
    {
      "Id": 101000260,
      "Speaker": "Player",
      "Text": "Not sure what to expect here, but sure thing!"
    },
    {
      "Id": 101000270,
      "Speaker": "Student",
      "Text": "Okay, so..."
    },
    {
      "Id": 101000280,
      "Speaker": "Student",
      "Text": "So..."
    },
    {
      "Id": 101000290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Let me explain it in person."
    },
    {
      "Id": 101000300,
      "Speaker": "Student",
      "Text": "Sensei, this is a disaster..."
    },
    {
      "Id": 101000310,
      "Speaker": "Student",
      "Text": "I tried on a riding suit, just in case..."
    },
    {
      "Id": 101000320,
      "Speaker": "Student",
      "Text": "But the zipper..."
    },
    {
      "Id": 101000330,
      "Speaker": "Player",
      "Text": "Oh my..."
    },
    {
      "Id": 101000340,
      "Speaker": "Student",
      "Text": "Oh,"
    },
    {
      "Id": 101000350,
      "Speaker": "Student",
      "Text": "just so there's no misunderstanding"
    },
    {
      "Id": 101000360,
      "Speaker": "Student",
      "Text": "I have NOT gained weight."
    },
    {
      "Id": 101000370,
      "Speaker": "Player",
      "Text": "Um, of course not..."
    },
    {
      "Id": 101000380,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 101000390,
      "Speaker": "Student",
      "Text": "Goodnight, Sensei."
    },
    {
      "Id": 101000400,
      "Speaker": "Student",
      "Text": "Hey Sensei"
    },
    {
      "Id": 101000410,
      "Speaker": "Student",
      "Text": "Can we hang out"
    },
    {
      "Id": 101000420,
      "Speaker": "Student",
      "Text": "If it's all right with you?"
    },
    {
      "Id": 101000430,
      "Speaker": "Player",
      "Text": "What's wrong, Shiroko?"
    },
    {
      "Id": 101000440,
      "Speaker": "Student",
      "Text": "Uh"
    },
    {
      "Id": 101000450,
      "Speaker": "Student",
      "Text": "I need some advice..."
    },
    {
      "Id": 101000460,
      "Speaker": "Player",
      "Text": "All right!"
    },
    {
      "Id": 101000470,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Okay, thanks."
    },
    {
      "Id": 101000480,
      "Speaker": "Student",
      "Text": "The showdown..."
    },
    {
      "Id": 101000490,
      "Speaker": "Player",
      "Text": "The showdown...?"
    },
    {
      "Id": 101000500,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 101000510,
      "Speaker": "Student",
      "Text": "Yeah."
    },
    {
      "Id": 101000520,
      "Speaker": "Student",
      "Text": "It somehow led to a street race..."
    },
    {
      "Id": 101000530,
      "Speaker": "Player",
      "Text": "A street race?!"
    },
    {
      "Id": 101000540,
      "Speaker": "Player",
      "Text": "Who won?!"
    },
    {
      "Id": 101000550,
      "Speaker": "Student",
      "Text": "Well, if you want to know the results..."
    },
    {
      "Id": 101000560,
      "Speaker": "Student",
      "Text": "4 wins, 7 losses, 1 tie. We raced 12 times."
    },
    {
      "Id": 101000570,
      "Speaker": "Student",
      "Text": "I lost"
    },
    {
      "Id": 101000580,
      "Speaker": "Player",
      "Text": "I knew they'd be strong..."
    },
    {
      "Id": 101000590,
      "Speaker": "Student",
      "Text": "But, all good."
    },
    {
      "Id": 101000600,
      "Speaker": "Student",
      "Text": "They even had their riding suits on"
    },
    {
      "Id": 101000610,
      "Speaker": "Student",
      "Text": "I'll get them back next time."
    },
    {
      "Id": 101000620,
      "Speaker": "Student",
      "Text": "When I finish my bike, that is"
    },
    {
      "Id": 101000630,
      "Speaker": "Student",
      "Text": "You should come watch, Sensei."
    },
    {
      "Id": 101000640,
      "Speaker": "Player",
      "Text": "Ah, of course. I'll be there."
    },
    {
      "Id": 101000650,
      "Speaker": "Student",
      "Text": "Who are you going to support?"
    },
    {
      "Id": 101000660,
      "Speaker": "Player",
      "Text": "That's a secret."
    },
    {
      "Id": 101000670,
      "Speaker": "Player",
      "Text": "I can't tell you."
    },
    {
      "Id": 101000680,
      "Speaker": "Student",
      "Text": "Okay."
    },
    {
      "Id": 101000690,
      "Speaker": "Student",
      "Text": "I thought you'd say that"
    },
    {
      "Id": 101000700,
      "Speaker": "Student",
      "Text": "Thanks, Sensei"
    },
    {
      "Id": 101000710,
      "Speaker": "Student",
      "Text": "I'll talk to you next time."
    }
  ],
  "DialogTH": [
    {
      "Id": 101000010,
      "Speaker": "Student",
      "Text": "นี่มันแค่ข้อความทดสอบระบบนะ"
    },
    {
      "Id": 101000020,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 101000030,
      "Speaker": "Student",
      "Text": "อ่าๆ"
    },
    {
      "Id": 101000040,
      "Speaker": "Student",
      "Text": "เห็นหรือเปล่า? สัญญาณส่งไปถึง\nหรือเปล่านะ?"
    },
    {
      "Id": 101000050,
      "Speaker": "Player",
      "Text": "อื้อ สัญญาณโอเคนะ ชิโรโกะ"
    },
    {
      "Id": 101000060,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 101000070,
      "Speaker": "Student",
      "Text": "งั้นเหรอ ค่อยยังชั่วหน่อย"
    },
    {
      "Id": 101000080,
      "Speaker": "Student",
      "Text": "งั้นไว้ฉันจะติดต่อไปใหม่"
    },
    {
      "Id": 101000090,
      "Speaker": "Player",
      "Text": "เดี๋ยวก่อน ตอนนี้ชิโรโกะอยู่ที่ไหนน่ะ?"
    },
    {
      "Id": 101000100,
      "Speaker": "Student",
      "Text": "ฉันเหรอ?"
    },
    {
      "Id": 101000110,
      "Speaker": "Student",
      "Text": "อยู่ที่เขตปกครองอะบิดอสน่ะ"
    },
    {
      "Id": 101000120,
      "Speaker": "Player",
      "Text": "งั้นมาเจอกันหน่อยสิ!!"
    },
    {
      "Id": 101000130,
      "Speaker": "Student",
      "Text": "อื้ม..."
    },
    {
      "Id": 101000140,
      "Speaker": "Student",
      "Text": "ไม่มีปัญหา"
    },
    {
      "Id": 101000150,
      "Speaker": "Student",
      "Text": "แล้วฉันจะรอนะ"
    },
    {
      "Id": 101000160,
      "Speaker": "Player",
      "Text": "อื้อ รอได้เลย!"
    },
    {
      "Id": 101000170,
      "Speaker": "Student",
      "Text": "ผงซักฟอก นม 500 มล. ไข่แพ็กเล็ก\nทิชชู่ ผ้าเช็ดหน้า"
    },
    {
      "Id": 101000180,
      "Speaker": "Student",
      "Text": "ครีมอาบน้ำ < ของจำเป็น"
    },
    {
      "Id": 101000190,
      "Speaker": "Player",
      "Text": "หืม...?"
    },
    {
      "Id": 101000200,
      "Speaker": "Player",
      "Text": "ชิโรโกะ?"
    },
    {
      "Id": 101000210,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 101000220,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ฉันส่งผิดน่ะ ขอโทษนะคุณครู"
    },
    {
      "Id": 101000230,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101000240,
      "Speaker": "Student",
      "Text": "ฉันนึกไอเดียดีๆ ได้แล้วละ"
    },
    {
      "Id": 101000250,
      "Speaker": "Student",
      "Text": "ช่วยมาที่นี่หน่อยสิ"
    },
    {
      "Id": 101000260,
      "Speaker": "Player",
      "Text": "ไม่ค่อยเข้าใจหรอกนะ\nแต่ครูจะไปเดี๋ยวนี้ละ!"
    },
    {
      "Id": 101000270,
      "Speaker": "Student",
      "Text": "อ่า อื้ม"
    },
    {
      "Id": 101000280,
      "Speaker": "Student",
      "Text": "คือว่า..."
    },
    {
      "Id": 101000290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "มาเจอกันแล้วจะอธิบายให้ฟังนะ"
    },
    {
      "Id": 101000300,
      "Speaker": "Student",
      "Text": "คุณครู เกิดเรื่องใหญ่แล้วละ..."
    },
    {
      "Id": 101000310,
      "Speaker": "Student",
      "Text": "ฉันลองเอาชุดปั่นจักรยานที่มีมา\nลองใส่ดู"
    },
    {
      "Id": 101000320,
      "Speaker": "Student",
      "Text": "แต่ว่าซิปมัน..."
    },
    {
      "Id": 101000330,
      "Speaker": "Player",
      "Text": "เอ๊ะ...?!"
    },
    {
      "Id": 101000340,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 101000350,
      "Speaker": "Student",
      "Text": "ขอบอกไว้ก่อนนะเผื่อจะเข้าใจผิด"
    },
    {
      "Id": 101000360,
      "Speaker": "Student",
      "Text": "ฉันไม่ได้อ้วนขึ้น"
    },
    {
      "Id": 101000370,
      "Speaker": "Player",
      "Text": "อืม ถ้างั้น..."
    },
    {
      "Id": 101000380,
      "Speaker": "Student",
      "Text": "......"
    },
    {
      "Id": 101000390,
      "Speaker": "Student",
      "Text": "ฝันดีนะคุณครู"
    },
    {
      "Id": 101000400,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101000410,
      "Speaker": "Student",
      "Text": "ถ้าพอมีเวลาว่าง"
    },
    {
      "Id": 101000420,
      "Speaker": "Student",
      "Text": "มาเจอกันหน่อยได้มั้ย?"
    },
    {
      "Id": 101000430,
      "Speaker": "Player",
      "Text": "มีเรื่องอะไรเหรอ ชิโรโกะ?"
    },
    {
      "Id": 101000440,
      "Speaker": "Student",
      "Text": "อื้อ"
    },
    {
      "Id": 101000450,
      "Speaker": "Student",
      "Text": "มีเรื่องกังวลอยากปรึกษาน่ะ..."
    },
    {
      "Id": 101000460,
      "Speaker": "Player",
      "Text": "เข้าใจแล้ว!"
    },
    {
      "Id": 101000470,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "อื้อ ขอบคุณนะ"
    },
    {
      "Id": 101000480,
      "Speaker": "Student",
      "Text": "แข่งเสร็จแล้วละ"
    },
    {
      "Id": 101000490,
      "Speaker": "Player",
      "Text": "แข่งอะไร...?!"
    },
    {
      "Id": 101000500,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 101000510,
      "Speaker": "Student",
      "Text": "อื้อ จู่ๆ มัน..."
    },
    {
      "Id": 101000520,
      "Speaker": "Student",
      "Text": "กลายเป็นการแข่งขันจักรยาน\nประเภทถนนไปซะแล้ว..."
    },
    {
      "Id": 101000530,
      "Speaker": "Player",
      "Text": "การแข่งขันจักรยานประเภทถนน?!"
    },
    {
      "Id": 101000540,
      "Speaker": "Player",
      "Text": "แล้วใครชนะล่ะ?!"
    },
    {
      "Id": 101000550,
      "Speaker": "Student",
      "Text": "ผลการแข่งขัน..."
    },
    {
      "Id": 101000560,
      "Speaker": "Student",
      "Text": "แข่งกัน 12 ครั้ง ชนะ 4 แพ้ 7 เสมอ 1"
    },
    {
      "Id": 101000570,
      "Speaker": "Student",
      "Text": "ฉันเป็นฝ่ายแพ้ละ"
    },
    {
      "Id": 101000580,
      "Speaker": "Player",
      "Text": "นักปั่นอาชีพนี่แข็งแกร่งจริงๆ นะ..."
    },
    {
      "Id": 101000590,
      "Speaker": "Student",
      "Text": "แต่ไม่เป็นไรหรอก"
    },
    {
      "Id": 101000600,
      "Speaker": "Student",
      "Text": "เขาใส่ชุดปั่นจักรยานมาด้วยน่ะ"
    },
    {
      "Id": 101000610,
      "Speaker": "Student",
      "Text": "ถ้าจักรยานของฉันเสร็จเมื่อไรละก็"
    },
    {
      "Id": 101000620,
      "Speaker": "Student",
      "Text": "จะมีแมทช์แก้มือแน่นอน"
    },
    {
      "Id": 101000630,
      "Speaker": "Student",
      "Text": "ถ้าถึงตอนนั้นก็มาดูด้วยละ คุณครู"
    },
    {
      "Id": 101000640,
      "Speaker": "Player",
      "Text": "อ่า ได้เลย ครูไปแน่นอน"
    },
    {
      "Id": 101000650,
      "Speaker": "Student",
      "Text": "แล้วจะเชียร์ใครเหรอ?"
    },
    {
      "Id": 101000660,
      "Speaker": "Player",
      "Text": "เป็นความลับ"
    },
    {
      "Id": 101000670,
      "Speaker": "Player",
      "Text": "บอกไม่ได้หรอก"
    },
    {
      "Id": 101000680,
      "Speaker": "Student",
      "Text": "อื้อ"
    },
    {
      "Id": 101000690,
      "Speaker": "Student",
      "Text": "คิดแล้วว่าจะเป็นแบบนั้น"
    },
    {
      "Id": 101000700,
      "Speaker": "Student",
      "Text": "ขอบคุณนะคุณครู"
    },
    {
      "Id": 101000710,
      "Speaker": "Student",
      "Text": "แล้วฉันจะติดต่อไปใหม่นะ"
    }
  ],
  "DialogTW": [
