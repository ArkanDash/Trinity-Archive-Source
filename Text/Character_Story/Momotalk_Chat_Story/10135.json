{
  "CharacterId": 10135,
  "DialogJP": [
    {
      "Id": 101350010,
      "Speaker": "Student",
      "Text": "先生、少しよろしいですか？"
    },
    {
      "Id": 101350020,
      "Speaker": "Player",
      "Text": "どうしたのケイちゃん？"
    },
    {
      "Id": 101350030,
      "Speaker": "Student",
      "Text": "ケイちゃんじゃありません"
    },
    {
      "Id": 101350040,
      "Speaker": "Student",
      "Text": "まったく……それはともかく"
    },
    {
      "Id": 101350050,
      "Speaker": "Student",
      "Text": "無機物を器としている意識体において"
    },
    {
      "Id": 101350060,
      "Speaker": "Student",
      "Text": "ストレス解消はどのように行うべきでしょうか？"
    },
    {
      "Id": 101350070,
      "Speaker": "Player",
      "Text": "いきなり難しい質問をするね……"
    },
    {
      "Id": 101350080,
      "Speaker": "Student",
      "Text": "そうですよね"
    },
    {
      "Id": 101350090,
      "Speaker": "Student",
      "Text": "先生に期待した私がバカでした"
    },
    {
      "Id": 101350100,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "ひどいよぉ……"
    },
    {
      "Id": 101350110,
      "Speaker": "Student",
      "Text": "先生、本気ですか？"
    },
    {
      "Id": 101350120,
      "Speaker": "Player",
      "Text": "どうしたのケイちゃん？"
    },
    {
      "Id": 101350130,
      "Speaker": "Student",
      "Text": "ケイちゃんじゃありません"
    },
    {
      "Id": 101350140,
      "Speaker": "Student",
      "Text": "それはともかく"
    },
    {
      "Id": 101350150,
      "Speaker": "Student",
      "Text": "本当に来るんですか？"
    },
    {
      "Id": 101350160,
      "Speaker": "Player",
      "Text": "ケイちゃんと約束したからね"
    },
    {
      "Id": 101350170,
      "Speaker": "Student",
      "Text": "しましたけど！"
    },
    {
      "Id": 101350180,
      "Speaker": "Student",
      "Text": "どうしてそこまで授業の様子を観に来たいんですか！？"
    },
    {
      "Id": 101350190,
      "Speaker": "Player",
      "Text": "生徒の学力向上を見守るのは"
    },
    {
      "Id": 101350200,
      "Speaker": "Player",
      "Text": "教師としての責務だからね"
    },
    {
      "Id": 101350210,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "こういう時ばっかり正論を言うんですから！"
    },
    {
      "Id": 101350220,
      "Speaker": "Student",
      "Text": "なんだか"
    },
    {
      "Id": 101350230,
      "Speaker": "Student",
      "Text": "結果的に"
    },
    {
      "Id": 101350240,
      "Speaker": "Student",
      "Text": "いろんな人からお誘いを受けました……"
    },
    {
      "Id": 101350250,
      "Speaker": "Player",
      "Text": "先生は嬉しいよ"
    },
    {
      "Id": 101350260,
      "Speaker": "Student",
      "Text": "はあ"
    },
    {
      "Id": 101350270,
      "Speaker": "Player",
      "Text": "そんなに嫌だった……？"
    },
    {
      "Id": 101350280,
      "Speaker": "Student",
      "Text": "うっ"
    },
    {
      "Id": 101350290,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 101350300,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 101350310,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101350320,
      "Speaker": "Student",
      "Text": "嫌なわけじゃないです"
    },
    {
      "Id": 101350330,
      "Speaker": "Student",
      "Text": "せんせ"
    },
    {
      "Id": 101350340,
      "Speaker": "Student",
      "Text": "た"
    },
    {
      "Id": 101350350,
      "Speaker": "Student",
      "Text": "すけて"
    },
    {
      "Id": 101350360,
      "Speaker": "Player",
      "Text": "どうしたの！？"
    },
    {
      "Id": 101350370,
      "Speaker": "Student",
      "Text": "いま"
    },
    {
      "Id": 101350380,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ちょとこまって"
    },
    {
      "Id": 101350390,
      "Speaker": "Student",
      "Text": "ああ"
    },
    {
      "Id": 101350400,
      "Speaker": "Student",
      "Text": "もう"
    },
    {
      "Id": 101350410,
      "Speaker": "Student",
      "Text": "なんですか"
    },
    {
      "Id": 101350420,
      "Speaker": "Student",
      "Text": "このバグは"
    },
    {
      "Id": 101350430,
      "Speaker": "Player",
      "Text": "バグ？"
    },
    {
      "Id": 101350440,
      "Speaker": "Student",
      "Text": "こっちの話です"
    },
    {
      "Id": 101350450,
      "Speaker": "Student",
      "Text": "ん？"
    },
    {
      "Id": 101350460,
      "Speaker": "Student",
      "Text": "待ってください"
    },
    {
      "Id": 101350470,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 101350480,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101350490,
      "Speaker": "Student",
      "Text": "いま暇してますよね？"
    },
    {
      "Id": 101350500,
      "Speaker": "Student",
      "Text": "ちょっと来てください"
    },
    {
      "Id": 101350510,
      "Speaker": "Player",
      "Text": "えっ？私は予定が……"
    },
    {
      "Id": 101350520,
      "Speaker": "Student",
      "Text": "無いのは知っています"
    },
    {
      "Id": 101350530,
      "Speaker": "Student",
      "Text": "それくらい簡単に調べられますから"
    },
    {
      "Id": 101350540,
      "Speaker": "Player",
      "Text": "私のプライベートは！？"
    },
    {
      "Id": 101350550,
      "Speaker": "Student",
      "Text": "生徒が第一なんですよね？"
    },
    {
      "Id": 101350560,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "くっ……"
    },
    {
      "Id": 101350570,
      "Speaker": "Student",
      "Text": "はああ……"
    },
    {
      "Id": 101350580,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 101350590,
      "Speaker": "Student",
      "Text": "いえ"
    },
    {
      "Id": 101350600,
      "Speaker": "Student",
      "Text": "3日と経っていないのにまた部室掃除と思うと"
    },
    {
      "Id": 101350610,
      "Speaker": "Student",
      "Text": "気が滅入ってしまって"
    },
    {
      "Id": 101350620,
      "Speaker": "Player",
      "Text": "掃除？"
    },
    {
      "Id": 101350630,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "まあこっちの話です"
    },
    {
      "Id": 101350640,
      "Speaker": "Student",
      "Text": "シャーレの前に着きました"
    },
    {
      "Id": 101350650,
      "Speaker": "Player",
      "Text": "今日の当番はケイちゃん！！"
    },
    {
      "Id": 101350660,
      "Speaker": "Student",
      "StoryEpisode": 6,
      "Text": "はぁ、本当にもう"
    },
    {
      "Id": 101350670,
      "Speaker": "Student",
      "Text": "寮に着きました"
    },
    {
      "Id": 101350680,
      "Speaker": "Player",
      "Text": "それはよかった"
    },
    {
      "Id": 101350690,
      "Speaker": "Student",
      "Text": "はい"
    },
    {
      "Id": 101350700,
      "Speaker": "Student",
      "Text": "あ！"
    },
    {
      "Id": 101350710,
      "Speaker": "Player",
      "Text": "どうかした？"
    },
    {
      "Id": 101350720,
      "Speaker": "Student",
      "Text": "デイリーやるの忘れてました！"
    },
    {
      "Id": 101350730,
      "Speaker": "Player",
      "Text": "あ、うん……大事なことだからね"
    }
  ],
  "DialogKR": [
    {
      "Id": 101350010,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101350020,
      "Speaker": "Player",
      "Text": "왜 그러니. 케이 쨩."
    },
    {
      "Id": 101350030,
      "Speaker": "Student",
      "Text": "케이 쨩 아닙니다."
    },
    {
      "Id": 101350040,
      "Speaker": "Student",
      "Text": "어쨌든."
    },
    {
      "Id": 101350050,
      "Speaker": "Student",
      "Text": "비탄소 기반의 의식체는"
    },
    {
      "Id": 101350060,
      "Speaker": "Student",
      "Text": "어떻게 스트레스를 해소해야 할까요."
    },
    {
      "Id": 101350070,
      "Speaker": "Player",
      "Text": "시작부터 너무 난이도가 높은 질문이구나……"
    },
    {
      "Id": 101350080,
      "Speaker": "Student",
      "Text": "그렇겠죠."
    },
    {
      "Id": 101350090,
      "Speaker": "Student",
      "Text": "선생님에게 뭘 기대한 제가 바보였어요."
    },
    {
      "Id": 101350100,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "너무해……."
    },
    {
      "Id": 101350110,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101350120,
      "Speaker": "Player",
      "Text": "왜 그러니. 케이 쨩."
    },
    {
      "Id": 101350130,
      "Speaker": "Student",
      "Text": "케이 쨩 아닙니다."
    },
    {
      "Id": 101350140,
      "Speaker": "Student",
      "Text": "어쨌든."
    },
    {
      "Id": 101350150,
      "Speaker": "Student",
      "Text": "진짜 오실 건가요?"
    },
    {
      "Id": 101350160,
      "Speaker": "Player",
      "Text": "약속했잖니. 케이 쨩."
    },
    {
      "Id": 101350170,
      "Speaker": "Student",
      "Text": "했긴 했는데!"
    },
    {
      "Id": 101350180,
      "Speaker": "Student",
      "Text": "꼭 그렇게까지 제 수업 참관을 오셔야겠냐는 거예요!"
    },
    {
      "Id": 101350190,
      "Speaker": "Player",
      "Text": "학생의 학업 성취도를 지켜보는 것은."
    },
    {
      "Id": 101350200,
      "Speaker": "Player",
      "Text": "교사로서 해야 할 의무 중 하나란다."
    },
    {
      "Id": 101350210,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "꼭 이럴 때만 정론 가지고 오죠, 진짜!"
    },
    {
      "Id": 101350220,
      "Speaker": "Student",
      "Text": "뭔가"
    },
    {
      "Id": 101350230,
      "Speaker": "Student",
      "Text": "결과적으로"
    },
    {
      "Id": 101350240,
      "Speaker": "Student",
      "Text": "사방에서…… 온갖 초대를 받게 되었는데요……"
    },
    {
      "Id": 101350250,
      "Speaker": "Player",
      "Text": "이 선생님은 기쁘단다."
    },
    {
      "Id": 101350260,
      "Speaker": "Student",
      "Text": "아오"
    },
    {
      "Id": 101350270,
      "Speaker": "Player",
      "Text": "그렇게 싫고 부담스러워……?"
    },
    {
      "Id": 101350280,
      "Speaker": "Student",
      "Text": "으"
    },
    {
      "Id": 101350290,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 101350300,
      "Speaker": "Student",
      "Text": "저"
    },
    {
      "Id": 101350310,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 101350320,
      "Speaker": "Student",
      "Text": "싫은 건, 아니에요."
    },
    {
      "Id": 101350330,
      "Speaker": "Student",
      "Text": "선ㅅㅐ"
    },
    {
      "Id": 101350340,
      "Speaker": "Student",
      "Text": "니ㅁ"
    },
    {
      "Id": 101350350,
      "Speaker": "Student",
      "Text": "도와"
    },
    {
      "Id": 101350360,
      "Speaker": "Player",
      "Text": "무슨 일이야?!"
    },
    {
      "Id": 101350370,
      "Speaker": "Student",
      "Text": "ㅈㅣ금"
    },
    {
      "Id": 101350380,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "좀 곤ㄹㅏㄴ"
    },
    {
      "Id": 101350390,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 101350400,
      "Speaker": "Student",
      "Text": "진짜"
    },
    {
      "Id": 101350410,
      "Speaker": "Student",
      "Text": "정말이지"
    },
    {
      "Id": 101350420,
      "Speaker": "Student",
      "Text": "뭔 버그가"
    },
    {
      "Id": 101350430,
      "Speaker": "Player",
      "Text": "버그라니?"
    },
    {
      "Id": 101350440,
      "Speaker": "Student",
      "Text": "그런 게 있습니다."
    },
    {
      "Id": 101350450,
      "Speaker": "Student",
      "Text": "어라"
    },
    {
      "Id": 101350460,
      "Speaker": "Student",
      "Text": "잠깐만"
    },
    {
      "Id": 101350470,
      "Speaker": "Student",
      "Text": "흠"
    },
    {
      "Id": 101350480,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101350490,
      "Speaker": "Student",
      "Text": "어차피 지금 시간 남죠?"
    },
    {
      "Id": 101350500,
      "Speaker": "Student",
      "Text": "오십쇼."
    },
    {
      "Id": 101350510,
      "Speaker": "Player",
      "Text": "어, 어? 난 지금 일정이……"
    },
    {
      "Id": 101350520,
      "Speaker": "Student",
      "Text": "없는 거 압니다."
    },
    {
      "Id": 101350530,
      "Speaker": "Student",
      "Text": "그 정도는 조사 가능하니까요."
    },
    {
      "Id": 101350540,
      "Speaker": "Player",
      "Text": "내 사생활은!"
    },
    {
      "Id": 101350550,
      "Speaker": "Student",
      "Text": "학생 먼저 아니었습니까."
    },
    {
      "Id": 101350560,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "크윽!"
    },
    {
      "Id": 101350570,
      "Speaker": "Student",
      "Text": "하아아아."
    },
    {
      "Id": 101350580,
      "Speaker": "Player",
      "Text": "왜 그래?"
    },
    {
      "Id": 101350590,
      "Speaker": "Student",
      "Text": "아뇨."
    },
    {
      "Id": 101350600,
      "Speaker": "Student",
      "Text": "청소한 지 3일 만에 또 어질러진 부실을 청소하려니."
    },
    {
      "Id": 101350610,
      "Speaker": "Student",
      "Text": "맥이 좀 빠져서요."
    },
    {
      "Id": 101350620,
      "Speaker": "Player",
      "Text": "부실 청소?"
    },
    {
      "Id": 101350630,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "그런 게 있어요."
    },
    {
      "Id": 101350640,
      "Speaker": "Student",
      "Text": "샬레 앞에 다 왔는데, 올라갈게요."
    },
    {
      "Id": 101350650,
      "Speaker": "Player",
      "Text": "케이 쨩의 당번!!!"
    },
    {
      "Id": 101350660,
      "Speaker": "Student",
      "StoryEpisode": 6,
      "Text": "아 진짜 좀."
    },
    {
      "Id": 101350670,
      "Speaker": "Student",
      "Text": "기숙사, 도착했습니다……."
    },
    {
      "Id": 101350680,
      "Speaker": "Player",
      "Text": "잘 들어갔구나."
    },
    {
      "Id": 101350690,
      "Speaker": "Student",
      "Text": "네."
    },
    {
      "Id": 101350700,
      "Speaker": "Student",
      "Text": "아!"
    },
    {
      "Id": 101350710,
      "Speaker": "Player",
      "Text": "왜 그래?"
    },
    {
      "Id": 101350720,
      "Speaker": "Student",
      "Text": "일퀘 안 했어요!"
    },
    {
      "Id": 101350730,
      "Speaker": "Player",
      "Text": "아, 응. 그래. 그거 중요하지."
    }
  ],
  "DialogEN": [
    {
      "Id": 101350010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101350020,
      "Speaker": "Player",
      "Text": "What's wrong, Kei-Kei?"
    },
    {
      "Id": 101350030,
      "Speaker": "Student",
      "Text": "Don't call me Kei-Kei."
    },
    {
      "Id": 101350040,
      "Speaker": "Student",
      "Text": "Anyways."
    },
    {
      "Id": 101350050,
      "Speaker": "Student",
      "Text": "How is a non-carbon-based conscious being"
    },
    {
      "Id": 101350060,
      "Speaker": "Student",
      "Text": "supposed to relieve stress?"
    },
    {
      "Id": 101350070,
      "Speaker": "Player",
      "Text": "We're starting with a high-difficulty question!"
    },
    {
      "Id": 101350080,
      "Speaker": "Student",
      "Text": "I suppose."
    },
    {
      "Id": 101350090,
      "Speaker": "Student",
      "Text": "...It's my fault for expecting anything of you, Sensei."
    },
    {
      "Id": 101350100,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "So mean..."
    },
    {
      "Id": 101350110,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101350120,
      "Speaker": "Player",
      "Text": "What's wrong, Kei-Kei?"
    },
    {
      "Id": 101350130,
      "Speaker": "Student",
      "Text": "Don't call me Kei-Kei."
    },
    {
      "Id": 101350140,
      "Speaker": "Student",
      "Text": "Anyways."
    },
    {
      "Id": 101350150,
      "Speaker": "Student",
      "Text": "Are you really coming?"
    },
    {
      "Id": 101350160,
      "Speaker": "Player",
      "Text": "I promised you, Kei-Kei."
    },
    {
      "Id": 101350170,
      "Speaker": "Student",
      "Text": "I'm well aware!"
    },
    {
      "Id": 101350180,
      "Speaker": "Student",
      "Text": "But for what REASON do you have to observe my class?!"
    },
    {
      "Id": 101350190,
      "Speaker": "Player",
      "Text": "I'm monitoring a student's academic achievements!"
    },
    {
      "Id": 101350200,
      "Speaker": "Player",
      "Text": "It's one of my responsibilities as a teacher!"
    },
    {
      "Id": 101350210,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "You only use that argument when it suits you!"
    },
    {
      "Id": 101350220,
      "Speaker": "Student",
      "Text": "For some reason,"
    },
    {
      "Id": 101350230,
      "Speaker": "Student",
      "Text": "I ended up"
    },
    {
      "Id": 101350240,
      "Speaker": "Student",
      "Text": "getting...all sorts of invites..."
    },
    {
      "Id": 101350250,
      "Speaker": "Player",
      "Text": "This teacher is so happy and proud."
    },
    {
      "Id": 101350260,
      "Speaker": "Student",
      "Text": "Ugh."
    },
    {
      "Id": 101350270,
      "Speaker": "Player",
      "Text": "Does it really bother you?"
    },
    {
