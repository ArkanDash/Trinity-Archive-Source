{
  "CharacterId": 26011,
  "DialogJP": [
    {
      "Id": 260110010,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 260110020,
      "Speaker": "Student",
      "Text": "先生！"
    },
    {
      "Id": 260110030,
      "Speaker": "Student",
      "Text": "ここって本当にすごいですね！"
    },
    {
      "Id": 260110040,
      "Speaker": "Player",
      "Text": "佐天？"
    },
    {
      "Id": 260110050,
      "Speaker": "Player",
      "Text": "何か見つけたの？"
    },
    {
      "Id": 260110060,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 260110070,
      "Speaker": "Student",
      "Text": "急にすみません！"
    },
    {
      "Id": 260110080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "とりあえず、こっちに来てもらってもいいですか？"
    },
    {
      "Id": 260110090,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 260110100,
      "Speaker": "Student",
      "Text": "おかしいですね"
    },
    {
      "Id": 260110110,
      "Speaker": "Student",
      "Text": "あれだけ探し回ったのに……"
    },
    {
      "Id": 260110120,
      "Speaker": "Player",
      "Text": "諦めるのは、まだ早いんじゃなかった？"
    },
    {
      "Id": 260110130,
      "Speaker": "Player",
      "Text": "簡単に見つかるようなら「伝説」じゃないからね"
    },
    {
      "Id": 260110140,
      "Speaker": "Student",
      "Text": "たしかに……"
    },
    {
      "Id": 260110150,
      "Speaker": "Student",
      "Text": "こんなところで諦めるわけにはいきません！"
    },
    {
      "Id": 260110160,
      "Speaker": "Student",
      "Text": "じゃあ、何か見つかったらまた連絡しますね！"
    },
    {
      "Id": 260110170,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 260110180,
      "Speaker": "Student",
      "Text": "聞いてください！"
    },
    {
      "Id": 260110190,
      "Speaker": "Student",
      "Text": "ひとつ分かったことがあるんです！"
    },
    {
      "Id": 260110200,
      "Speaker": "Player",
      "Text": "佐天……？"
    },
    {
      "Id": 260110210,
      "Speaker": "Player",
      "Text": "何が分かったの？"
    },
    {
      "Id": 260110220,
      "Speaker": "Student",
      "Text": "もしよければ"
    },
    {
      "Id": 260110230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "今から会えませんか？"
    },
    {
      "Id": 260110240,
      "Speaker": "Student",
      "Text": "ん～"
    },
    {
      "Id": 260110250,
      "Speaker": "Student",
      "Text": "やっぱり、もう少し打ちたかったです"
    },
    {
      "Id": 260110260,
      "Speaker": "Student",
      "Text": "ちょっと物足りません……"
    },
    {
      "Id": 260110270,
      "Speaker": "Player",
      "Text": "夢中になってたもんね"
    },
    {
      "Id": 260110280,
      "Speaker": "Player",
      "Text": "すでに勝負はついてたと思うよ……"
    },
    {
      "Id": 260110290,
      "Speaker": "Student",
      "Text": "あれ"
    },
    {
      "Id": 260110300,
      "Speaker": "Student",
      "Text": "そうですか？"
    },
    {
      "Id": 260110310,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 260110320,
      "Speaker": "Student",
      "Text": "だったら、まあ……良しとしますか"
    },
    {
      "Id": 260110330,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 260110340,
      "Speaker": "Student",
      "Text": "息抜きをしようと思ってたら"
    },
    {
      "Id": 260110350,
      "Speaker": "Student",
      "Text": "ちょうど良い場所を見つけたんです"
    },
    {
      "Id": 260110360,
      "Speaker": "Student",
      "Text": "よかったら、一緒にどうですか？"
    },
    {
      "Id": 260110370,
      "Speaker": "Player",
      "Text": "もちろんだよ"
    },
    {
      "Id": 260110380,
      "Speaker": "Player",
      "Text": "何か面白いものでも見つかった？"
    },
    {
      "Id": 260110390,
      "Speaker": "Student",
      "Text": "ふふっ"
    },
    {
      "Id": 260110400,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "それがですね……"
    },
    {
      "Id": 260110410,
      "Speaker": "Student",
      "Text": "ふう！"
    },
    {
      "Id": 260110420,
      "Speaker": "Student",
      "Text": "スッキリしました！"
    },
    {
      "Id": 260110430,
      "Speaker": "Student",
      "Text": "あたし、何事もやってみないと気が済まないんですよね"
    },
    {
      "Id": 260110440,
      "Speaker": "Player",
      "Text": "正直、驚いたよ"
    },
    {
      "Id": 260110450,
      "Speaker": "Player",
      "Text": "もしかして、野球の選手だったの？"
    },
    {
      "Id": 260110460,
      "Speaker": "Student",
      "Text": "えーと"
    },
    {
      "Id": 260110470,
      "Speaker": "Student",
      "Text": "そうじゃないんですけど……"
    },
    {
      "Id": 260110480,
      "Speaker": "Student",
      "Text": "うーん、説明すると長くなりそうだなぁ"
    },
    {
      "Id": 260110490,
      "Speaker": "Student",
      "Text": "そうだ……"
    },
    {
      "Id": 260110500,
      "Speaker": "Student",
      "Text": "へへっ"
    },
    {
      "Id": 260110510,
      "Speaker": "Student",
      "Text": "バットと仲良し、みたいな感じです！"
    },
    {
      "Id": 260110520,
      "Speaker": "Student",
      "Text": "やっぱり"
    },
    {
      "Id": 260110530,
      "Speaker": "Student",
      "Text": "思ったようにはいかないですね"
    },
    {
      "Id": 260110540,
      "Speaker": "Student",
      "Text": "でもまあ"
    },
    {
      "Id": 260110550,
      "Speaker": "Student",
      "Text": "予想はしてましたけど！"
    },
    {
      "Id": 260110560,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 260110570,
      "Speaker": "Player",
      "Text": "……佐天？"
    },
    {
      "Id": 260110580,
      "Speaker": "Student",
      "Text": "あ～"
    },
    {
      "Id": 260110590,
      "Speaker": "Student",
      "Text": "えっと……"
    },
    {
      "Id": 260110600,
      "Speaker": "Student",
      "Text": "やっぱり"
    },
    {
      "Id": 260110610,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "大したことじゃないです！"
    },
    {
      "Id": 260110620,
      "Speaker": "Student",
      "Text": "ふ～っ！"
    },
    {
      "Id": 260110630,
      "Speaker": "Student",
      "Text": "楽しかったぁ～！"
    },
    {
      "Id": 260110640,
      "Speaker": "Student",
      "Text": "あたし、最初より上達したと思いませんか？"
    },
    {
      "Id": 260110650,
      "Speaker": "Student",
      "Text": "後半は集弾率も良くなりましたし、手応えを掴みました！"
    },
    {
      "Id": 260110660,
      "Speaker": "Player",
      "Text": "バッティングも、きっと努力したんだろうね"
    },
    {
      "Id": 260110670,
      "Speaker": "Player",
      "Text": "継続も才能のひとつだよ"
    },
    {
      "Id": 260110680,
      "Speaker": "Student",
      "Text": "またまた～"
    },
    {
      "Id": 260110690,
      "Speaker": "Student",
      "Text": "先生みたいなことを"
    },
    {
      "Id": 260110700,
      "Speaker": "Student",
      "Text": "って"
    },
    {
      "Id": 260110710,
      "Speaker": "Student",
      "Text": "そういえば、先生でしたね！"
    },
    {
      "Id": 260110720,
      "Speaker": "Student",
      "Text": "あははっ"
    },
    {
      "Id": 260110730,
      "Speaker": "Student",
      "Text": "ありがとうございます、先生！！"
    }
  ],
  "DialogKR": [
    {
      "Id": 260110010,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 260110020,
      "Speaker": "Student",
      "Text": "선생님!"
    },
    {
      "Id": 260110030,
      "Speaker": "Student",
      "Text": "굉장해, 여긴 정말 굉장하네요!"
    },
    {
      "Id": 260110040,
      "Speaker": "Player",
      "Text": "사텐?"
    },
    {
      "Id": 260110050,
      "Speaker": "Player",
      "Text": "응? 무슨 이야기야?"
    },
    {
      "Id": 260110060,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 260110070,
      "Speaker": "Student",
      "Text": "두서가 없었네요. 죄송합니다."
    },
    {
      "Id": 260110080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "일단 오시면 말씀드릴게요!!"
    },
    {
      "Id": 260110090,
      "Speaker": "Student",
      "Text": "으음"
    },
    {
      "Id": 260110100,
      "Speaker": "Student",
      "Text": "이상하네요."
    },
    {
      "Id": 260110110,
      "Speaker": "Student",
      "Text": "역시 접근법이 잘못됐던 걸까요."
    },
    {
      "Id": 260110120,
      "Speaker": "Player",
      "Text": "포기하기엔 이르지."
    },
    {
      "Id": 260110130,
      "Speaker": "Player",
      "Text": "쉽게 찾아지면 전설이 아니잖아."
    },
    {
      "Id": 260110140,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 260110150,
      "Speaker": "Student",
      "Text": "과연! 그럴듯한 이야기예요!"
    },
    {
      "Id": 260110160,
      "Speaker": "Student",
      "Text": "그럼, 뭔가 찾으면 다시 연락드리겠습니다!!"
    },
    {
      "Id": 260110170,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 260110180,
      "Speaker": "Student",
      "Text": "그렇군요"
    },
    {
      "Id": 260110190,
      "Speaker": "Student",
      "Text": "한가지 또 알아냈습니다."
    },
    {
      "Id": 260110200,
      "Speaker": "Player",
      "Text": "알아냈다니? 뭘?"
    },
    {
      "Id": 260110210,
      "Speaker": "Player",
      "Text": "사텐?"
    },
    {
      "Id": 260110220,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 260110230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "지금 좀 괜찮으실까요?"
    },
    {
      "Id": 260110240,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 260110250,
      "Speaker": "Student",
      "Text": "역시 조금 마음에 걸리는 걸요"
    },
    {
      "Id": 260110260,
      "Speaker": "Student",
      "Text": "승부를 마저 내지 못한 게……."
    },
    {
      "Id": 260110270,
      "Speaker": "Player",
      "Text": "당초의 목적을 잊어버렸어……."
    },
    {
      "Id": 260110280,
      "Speaker": "Player",
      "Text": "어떤 의미로는 승부가 났다고 생각하는데"
    },
    {
      "Id": 260110290,
      "Speaker": "Student",
      "Text": "어라"
    },
    {
      "Id": 260110300,
      "Speaker": "Student",
      "Text": "그런가요?"
    },
    {
      "Id": 260110310,
      "Speaker": "Student",
      "Text": "흠……."
    },
    {
      "Id": 260110320,
      "Speaker": "Student",
      "Text": "듣고 보니 그런 것 같기도……."
    },
    {
      "Id": 260110330,
      "Speaker": "Student",
      "Text": "뭔가"
    },
    {
      "Id": 260110340,
      "Speaker": "Student",
      "Text": "조금은 쉬는 것도 좋겠다는 생각이 드네요"
    },
    {
      "Id": 260110350,
      "Speaker": "Student",
      "Text": "마침 적당한 곳을 찾은 것 같은데"
    },
    {
      "Id": 260110360,
      "Speaker": "Student",
      "Text": "선생님만 괜찮으시다면, 한 번 와 주시겠어요?"
    },
    {
      "Id": 260110370,
      "Speaker": "Player",
      "Text": "나야 좋지만, 어딘데?"
    },
    {
      "Id": 260110380,
      "Speaker": "Player",
      "Text": "뭔가 재밌는 거라도 찾았어?"
    },
    {
      "Id": 260110390,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 260110400,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "그게 말이죠"
    },
    {
      "Id": 260110410,
      "Speaker": "Student",
      "Text": "후우-!"
    },
    {
      "Id": 260110420,
      "Speaker": "Student",
      "Text": "시원하네요! 역시 해보길 잘했달까"
    },
    {
      "Id": 260110430,
      "Speaker": "Student",
      "Text": "저, 뭔가 찝찝한 건 그냥 넘어가지 못하는 버릇이 있거든요"
    },
    {
      "Id": 260110440,
      "Speaker": "Player",
      "Text": "솔직하게 놀랐어."
    },
    {
      "Id": 260110450,
      "Speaker": "Player",
      "Text": "굉장했어. 혹시 선수 출신이야?"
    },
    {
      "Id": 260110460,
      "Speaker": "Student",
      "Text": "헤헤"
    },
    {
      "Id": 260110470,
      "Speaker": "Student",
      "Text": "뭐, 그런 건 아니고요."
    },
    {
      "Id": 260110480,
      "Speaker": "Student",
      "Text": "뭔가 설명하기에는 말이 너무 길어질 것 같기도……."
    },
    {
      "Id": 260110490,
      "Speaker": "Student",
      "Text": "음."
    },
    {
      "Id": 260110500,
      "Speaker": "Student",
      "Text": "역시, 그냥 조금"
    },
    {
      "Id": 260110510,
      "Speaker": "Student",
      "Text": "휘두를 일이 많았다……! 정도로!"
    },
    {
      "Id": 260110520,
      "Speaker": "Student",
      "Text": "역시"
    },
    {
      "Id": 260110530,
      "Speaker": "Student",
      "Text": "생각만큼 잘되지는 않네요"
    },
    {
      "Id": 260110540,
      "Speaker": "Student",
      "Text": "뭐어"
    },
    {
      "Id": 260110550,
      "Speaker": "Student",
      "Text": "솔직히 예상은 했지만요!"
    },
    {
      "Id": 260110560,
      "Speaker": "Player",
      "Text": "응? 무슨 일 있어?"
    },
    {
      "Id": 260110570,
      "Speaker": "Player",
      "Text": "……사텐?"
    },
    {
      "Id": 260110580,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 260110590,
      "Speaker": "Student",
      "Text": "그냥"
    },
    {
      "Id": 260110600,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 260110610,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "별 건 아니고요!"
    },
    {
      "Id": 260110620,
      "Speaker": "Student",
      "Text": "음!"
    },
    {
      "Id": 260110630,
      "Speaker": "Student",
      "Text": "개운하네요!"
    },
    {
      "Id": 260110640,
      "Speaker": "Student",
      "Text": "그래도 저, 전보다는 꽤 능숙해지지 않았던가요?"
    },
    {
      "Id": 260110650,
      "Speaker": "Student",
      "Text": "나중에 쏜 것들은 꽤 깔끔했다고 생각하는데?"
    },
    {
      "Id": 260110660,
      "Speaker": "Player",
      "Text": "생각해 보면 배팅도 잘했었고 말이지."
    },
    {
      "Id": 260110670,
      "Speaker": "Player",
      "Text": "사실 재능이라는 건 그런 마음가짐이니까."
    },
    {
      "Id": 260110680,
      "Speaker": "Student",
      "Text": "또"
    },
    {
      "Id": 260110690,
      "Speaker": "Student",
      "Text": "또 그렇게 선생님 같은 말을"
    },
    {
      "Id": 260110700,
      "Speaker": "Student",
      "Text": "앗"
    },
    {
      "Id": 260110710,
      "Speaker": "Student",
      "Text": "생각해 보니 선생님이셨죠?"
    },
    {
      "Id": 260110720,
      "Speaker": "Student",
      "Text": "하하"
    },
    {
      "Id": 260110730,
      "Speaker": "Student",
      "Text": "감사합니다, 선생님!!"
    }
  ],
  "DialogEN": [
    {
      "Id": 260110010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 260110020,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 260110030,
      "Speaker": "Student",
      "Text": "Amazing! This place is amazing!"
    },
    {
      "Id": 260110040,
      "Speaker": "Player",
      "Text": "Saten?"
    },
    {
      "Id": 260110050,
      "Speaker": "Player",
      "Text": "What do you mean?"
    },
    {
      "Id": 260110060,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 260110070,
      "Speaker": "Student",
      "Text": "Sorry! I guess I came on a little strong there."
    },
    {
      "Id": 260110080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'll tell you what I mean when you get here!"
    },
    {
      "Id": 260110090,
      "Speaker": "Student",
      "Text": "Hm..."
    },
    {
      "Id": 260110100,
      "Speaker": "Student",
      "Text": "How weird."
    },
    {
      "Id": 260110110,
      "Speaker": "Student",
      "Text": "Maybe we need to change our strategy."
    },
    {
      "Id": 260110120,
      "Speaker": "Player",
      "Text": "It's too soon to give up."
    },
    {
      "Id": 260110130,
      "Speaker": "Player",
      "Text": "If they were easy to find, they wouldn't be legends."
    },
    {
      "Id": 260110140,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 260110150,
      "Speaker": "Student",
      "Text": "Yeah! That makes sense!"
    },
    {
      "Id": 260110160,
      "Speaker": "Student",
      "Text": "Okay then! I'll contact you again if I find anything!!"
    },
    {
      "Id": 260110170,
      "Speaker": "Student",
      "Text": "Hm..."
    },
    {
      "Id": 260110180,
      "Speaker": "Student",
      "Text": "Okay."
    },
    {
      "Id": 260110190,
      "Speaker": "Student",
      "Text": "This is too weird."
    },
    {
      "Id": 260110200,
      "Speaker": "Player",
      "Text": "What might that be?"
    },
    {
      "Id": 260110210,
      "Speaker": "Player",
      "Text": "Saten?"
    },
    {
      "Id": 260110220,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 260110230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Is now a good time to meet?"
    },
    {
      "Id": 260110240,
      "Speaker": "Student",
      "Text": "Hm..."
    },
    {
      "Id": 260110250,
      "Speaker": "Student",
      "Text": "It's bugging me."
    },
    {
      "Id": 260110260,
      "Speaker": "Student",
      "Text": "All I can think about is finishing that game..."
    },
    {
      "Id": 260110270,
      "Speaker": "Player",
      "Text": "You forgot your original goal..."
    },
    {
      "Id": 260110280,
      "Speaker": "Player",
      "Text": "From where I'm sitting, you won that game."
    },
    {
      "Id": 260110290,
      "Speaker": "Student",
      "Text": "Huh..."
    },
    {
      "Id": 260110300,
      "Speaker": "Student",
      "Text": "Did I?"
    },
    {
      "Id": 260110310,
      "Speaker": "Student",
      "Text": "Hmm..."
    },
    {
      "Id": 260110320,
      "Speaker": "Student",
      "Text": "Now that I think about it, I guess..."
    },
    {
      "Id": 260110330,
      "Speaker": "Student",
      "Text": "Maybe I did."
    },
    {
      "Id": 260110340,
      "Speaker": "Student",
      "Text": "I think I'm due for a good rest."
    },
    {
      "Id": 260110350,
      "Speaker": "Student",
      "Text": "I've found the perfect spot."
    },
    {
      "Id": 260110360,
      "Speaker": "Student",
      "Text": "If it's okay, would you meet me there, Sensei?"
    },
    {
      "Id": 260110370,
      "Speaker": "Player",
      "Text": "Sure thing. Where is it?"
    },
    {
      "Id": 260110380,
      "Speaker": "Player",
      "Text": "Did you find someplace fun?"
    },
    {
      "Id": 260110390,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 260110400,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Well, actually..."
    },
    {
      "Id": 260110410,
      "Speaker": "Student",
      "Text": "Phew!"
    },
    {
      "Id": 260110420,
      "Speaker": "Student",
      "Text": "How refreshing! I'm glad I tried it!"
    },
    {
      "Id": 260110430,
      "Speaker": "Student",
      "Text": "I can't get these things out of my mind unless I try them for myself."
    },
    {
      "Id": 260110440,
      "Speaker": "Player",
      "Text": "I was honestly surprised."
    },
    {
      "Id": 260110450,
      "Speaker": "Player",
      "Text": "Amazing. Are you an athlete?"
    },
    {
      "Id": 260110460,
      "Speaker": "Student",
      "Text": "Heehee!"
    },
    {
      "Id": 260110470,
      "Speaker": "Student",
      "Text": "It's nothing like that."
    },
    {
      "Id": 260110480,
      "Speaker": "Student",
      "Text": "It's a long story, actually..."
    },
    {
      "Id": 260110490,
      "Speaker": "Student",
      "Text": "Hmm."
    },
    {
      "Id": 260110500,
      "Speaker": "Student",
      "Text": "I guess you could say"
    },
    {
      "Id": 260110510,
      "Speaker": "Student",
      "Text": "I had plenty of chances to practice my swing! Yes, let's say that!"
    },
    {
      "Id": 260110520,
      "Speaker": "Student",
      "Text": "It figures."
    },
    {
      "Id": 260110530,
      "Speaker": "Student",
      "Text": "I hoped I'd have a knack for this..."
    },
    {
      "Id": 260110540,
      "Speaker": "Student",
      "Text": "Then again..."
    },
    {
      "Id": 260110550,
      "Speaker": "Student",
      "Text": "I kind of knew this would happen!"
    },
    {
      "Id": 260110560,
      "Speaker": "Player",
      "Text": "Huh? Is something wrong?"
    },
    {
      "Id": 260110570,
      "Speaker": "Player",
      "Text": "...Saten?"
    },
    {
      "Id": 260110580,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 260110590,
      "Speaker": "Student",
      "Text": "I just..."
    },
    {
      "Id": 260110600,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 260110610,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "It's no big deal!"
    },
    {
      "Id": 260110620,
      "Speaker": "Student",
      "Text": "Mm!"
    },
    {
      "Id": 260110630,
      "Speaker": "Student",
      "Text": "Not bad!"
    },
    {
      "Id": 260110640,
      "Speaker": "Student",
      "Text": "Haven't I gotten better since last time?"
    },
    {
      "Id": 260110650,
      "Speaker": "Student",
      "Text": "Those last few shots were pretty clean, right?"
    },
    {
      "Id": 260110660,
      "Speaker": "Player",
      "Text": "Come to think of it, it's a lot like batting."
    },
    {
      "Id": 260110670,
      "Speaker": "Player",
      "Text": "They say talent is all in your attitude."
    },
    {
      "Id": 260110680,
      "Speaker": "Student",
      "Text": "Again!"
    },
    {
      "Id": 260110690,
      "Speaker": "Student",
      "Text": "You sound like such a teacher."
    },
    {
      "Id": 260110700,
      "Speaker": "Student",
      "Text": "Oh..."
    },
    {
      "Id": 260110710,
      "Speaker": "Student",
      "Text": "You are a teacher."
    },
    {
      "Id": 260110720,
      "Speaker": "Student",
      "Text": "Haha!"
    },
    {
      "Id": 260110730,
      "Speaker": "Student",
      "Text": "Thank you, Sensei!!"
    }
  ],
  "DialogTH": [
    {
      "Id": 260110010,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 260110020,
      "Speaker": "Student",
      "Text": "คุณครู!"
    },
    {
      "Id": 260110030,
      "Speaker": "Student",
      "Text": "สุดยอดเลย ที่นี่มันสุดยอดไปเลยค่ะ!"
    },
    {
      "Id": 260110040,
      "Speaker": "Player",
      "Text": "ซาเต็น?"
    },
    {
      "Id": 260110050,
      "Speaker": "Player",
      "Text": "หืม? มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 260110060,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 260110070,
      "Speaker": "Student",
      "Text": "ฉันมาแบบไม่มีปี่ไม่มีขลุ่ยเลยสินะ\nขอโทษค่ะ"
    },
    {
      "Id": 260110080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "เอาเป็นว่าฉันจะเล่าให้ฟังตอนคุณครู\nมาถึงค่ะ!!"
    },
    {
      "Id": 260110090,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 260110100,
      "Speaker": "Student",
      "Text": "แปลกจังเลยนะคะ"
    },
    {
      "Id": 260110110,
      "Speaker": "Student",
      "Text": "หรือว่าหาแบบผิดวิธีนะ?"
    },
    {
      "Id": 260110120,
      "Speaker": "Player",
      "Text": "ยังเร็วเกินกว่าจะยอมแพ้น่า"
    },
    {
      "Id": 260110130,
      "Speaker": "Player",
      "Text": "ถ้าหาเจอง่ายๆ ก็ไม่ใช่ตำนานน่ะสิ"
    },
    {
      "Id": 260110140,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 260110150,
      "Speaker": "Student",
      "Text": "นั่นสิ! ก็น่าจะใช่นะคะ!"
    },
    {
      "Id": 260110160,
      "Speaker": "Student",
      "Text": "งั้นถ้าเจออะไรแล้วจะติดต่อไปนะคะ!!"
    },
    {
      "Id": 260110170,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 260110180,
      "Speaker": "Student",
      "Text": "งั้นสินะคะ"
    },
    {
      "Id": 260110190,
      "Speaker": "Student",
      "Text": "ฉันได้พบอีกอย่างแล้วค่ะ"
    },
    {
      "Id": 260110200,
      "Speaker": "Player",
      "Text": "พบอีกอย่าง? พบอะไรเหรอ?"
    },
    {
      "Id": 260110210,
      "Speaker": "Player",
      "Text": "ซาเต็น?"
    },
    {
      "Id": 260110220,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 260110230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ตอนนี้พอมีเวลาสักครู่ไหมคะ?"
    },
    {
      "Id": 260110240,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 260110250,
      "Speaker": "Student",
      "Text": "มันยังค้างคาใจฉันอยู่น่ะค่ะ"
    },
    {
      "Id": 260110260,
      "Speaker": "Student",
      "Text": "การที่ไม่สามารถรู้ผลแพ้ชนะน่ะ..."
    },
    {
      "Id": 260110270,
      "Speaker": "Player",
      "Text": "ครูลืมเป้าหมายแรกเริ่มไปแล้ว..."
    },
    {
      "Id": 260110280,
      "Speaker": "Player",
      "Text": "ครูคิดว่าเธอชนะแล้วนะ"
    },
    {
      "Id": 260110290,
      "Speaker": "Student",
      "Text": "เอ๋?"
    },
    {
      "Id": 260110300,
      "Speaker": "Student",
      "Text": "งั้นเหรอคะ?"
    },
    {
      "Id": 260110310,
      "Speaker": "Student",
      "Text": "ฮืม..."
    },
    {
      "Id": 260110320,
      "Speaker": "Student",
      "Text": "ฟังดูแล้วก็น่าจะเป็นอย่างนั้นนะ..."
    },
    {
      "Id": 260110330,
      "Speaker": "Student",
      "Text": "ฉันว่า"
    },
    {
      "Id": 260110340,
      "Speaker": "Student",
      "Text": "ฉันน่าจะต้องพักสักหน่อยแล้วค่ะ"
    },
    {
      "Id": 260110350,
      "Speaker": "Student",
      "Text": "มาเจอที่ที่เหมาะพอดีเลย"
    },
    {
      "Id": 260110360,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูไม่ติดอะไร ช่วยออกมาหา\nหน่อยได้ไหมคะ?"
    },
    {
      "Id": 260110370,
      "Speaker": "Player",
      "Text": "ได้สิ ว่าแต่อยู่ไหนเหรอ?"
    },
    {
      "Id": 260110380,
      "Speaker": "Player",
      "Text": "เจออะไรสนุกๆ ที่นั่นมั้ย?"
    },
    {
      "Id": 260110390,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 260110400,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "นั่นสิคะ"
    },
    {
      "Id": 260110410,
      "Speaker": "Student",
      "Text": "ฮู่ว!"
    },
    {
      "Id": 260110420,
      "Speaker": "Student",
      "Text": "สดชื่นจังเลยค่ะ! ดีนะที่ลองทำดู"
    },
    {
      "Id": 260110430,
      "Speaker": "Student",
      "Text": "พอดีฉันเป็นพวกที่หากมีอะไรคาใจก็\nจะปล่อยผ่านไม่ได้น่ะค่ะ"
    },
    {
      "Id": 260110440,
      "Speaker": "Player",
      "Text": "บอกตรงๆ เลยว่าตกใจ"
    },
    {
      "Id": 260110450,
      "Speaker": "Player",
      "Text": "สุดยอดไปเลยนะ เป็นอดีตนักกีฬา\nเหรอเนี่ย?"
    },
    {
      "Id": 260110460,
      "Speaker": "Student",
      "Text": "ฮิฮิ"
    },
    {
      "Id": 260110470,
      "Speaker": "Student",
      "Text": "ไม่ใช่หรอกค่ะ"
    },
    {
      "Id": 260110480,
      "Speaker": "Student",
      "Text": "แต่ถ้าจะให้อธิบาย ฉันก็คงพูดยืดยาว..."
    },
    {
      "Id": 260110490,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 260110500,
      "Speaker": "Student",
      "Text": "ฉันก็แค่..."
    },
    {
      "Id": 260110510,
      "Speaker": "Student",
      "Text": "ได้ทำอะไรตามใจเยอะเลย...!\nประมาณนี้น่ะ!"
    },
    {
      "Id": 260110520,
      "Speaker": "Student",
      "Text": "กะไว้แล้วเชียว"
    },
    {
      "Id": 260110530,
      "Speaker": "Student",
      "Text": "มันไม่ง่ายอย่างที่คิดเลยค่ะ"
    },
    {
      "Id": 260110540,
      "Speaker": "Student",
      "Text": "ก็นะ"
    },
    {
      "Id": 260110550,
      "Speaker": "Student",
      "Text": "แต่ฉันก็คาดเอาไว้แล้วแหละ!"
    },
    {
      "Id": 260110560,
      "Speaker": "Player",
      "Text": "หืม? มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 260110570,
      "Speaker": "Player",
      "Text": "...ซาเต็น?"
    },
    {
      "Id": 260110580,
      "Speaker": "Student",
      "Text": "อ้อ"
    },
    {
      "Id": 260110590,
      "Speaker": "Student",
      "Text": "ก็แค่"
    },
    {
      "Id": 260110600,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 260110610,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ไม่มีอะไรมากหรอกค่ะ!"
    },
    {
      "Id": 260110620,
      "Speaker": "Student",
      "Text": "อื้ม!"
    },
    {
      "Id": 260110630,
      "Speaker": "Student",
      "Text": "โล่งใจจังเลยค่ะ!"
    },
    {
      "Id": 260110640,
      "Speaker": "Student",
      "Text": "แต่ว่าฉันก็เก่งขึ้นกว่าเดิมใช่มั้ยคะ?"
    },
    {
      "Id": 260110650,
      "Speaker": "Student",
      "Text": "ช่วงหลังๆ ฉันยิงได้เฉียบเลยใช่มั้ยคะ?"
    },
    {
      "Id": 260110660,
      "Speaker": "Player",
      "Text": "พอมาคิดดู ก็เหมือนตอนที่ตีลูกเลย"
    },
    {
      "Id": 260110670,
      "Speaker": "Player",
      "Text": "เพราะจริงๆ แล้วพรสวรรค์มันเป็นเรื่อง\nความตั้งใจนี่เอง"
    },
    {
      "Id": 260110680,
      "Speaker": "Student",
      "Text": "เอาอีกแล้ว"
    },
    {
      "Id": 260110690,
      "Speaker": "Student",
      "Text": "พูดอะไรเหมือนเป็นครูอีกแล้ว"
    },
    {
      "Id": 260110700,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 260110710,
      "Speaker": "Student",
      "Text": "พอมาคิดดู คุณครูเป็นครูนี่คะ?"
    },
    {
      "Id": 260110720,
      "Speaker": "Student",
      "Text": "แหะๆ"
    },
    {
      "Id": 260110730,
      "Speaker": "Student",
      "Text": "ขอบคุณนะคะคุณครู!!"
    }
  ],
  "DialogTW": [
    {
      "Id": 260110010,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 260110020,
      "Speaker": "Student",
      "Text": "老師！"
    },
    {
      "Id": 260110030,
      "Speaker": "Student",
      "Text": "太酷了，這裡真的是太酷了！"
    },
    {
      "Id": 260110040,
      "Speaker": "Player",
      "Text": "佐天？"
    },
    {
      "Id": 260110050,
      "Speaker": "Player",
      "Text": "嗯？你指的是什麼？"
    },
    {
      "Id": 260110060,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 260110070,
      "Speaker": "Student",
      "Text": "這樣有點沒頭沒尾的對吧，不好意思"
    },
    {
      "Id": 260110080,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "等老師來了之後，我會跟你解釋的！！"
    },
    {
      "Id": 260110090,
      "Speaker": "Student",
      "Text": "唔嗯"
    },
    {
      "Id": 260110100,
      "Speaker": "Student",
      "Text": "真奇怪"
    },
    {
      "Id": 260110110,
      "Speaker": "Student",
      "Text": "難道我們用錯方法了嗎？"
    },
    {
      "Id": 260110120,
      "Speaker": "Player",
      "Text": "現在放棄還太早囉"
    },
    {
      "Id": 260110130,
      "Speaker": "Player",
      "Text": "如果這麼好找的話，就不會被稱為傳說了"
    },
    {
      "Id": 260110140,
      "Speaker": "Student",
      "Text": "說的也是"
    },
    {
      "Id": 260110150,
      "Speaker": "Student",
      "Text": "果然沒錯！我就知道是這樣！"
    },
    {
      "Id": 260110160,
      "Speaker": "Student",
      "Text": "那麼，等我找到新的線索之後會再聯絡的！！"
    },
    {
      "Id": 260110170,
      "Speaker": "Student",
      "Text": "嗯～"
    },
    {
      "Id": 260110180,
      "Speaker": "Student",
      "Text": "原來如此"
    },
    {
      "Id": 260110190,
      "Speaker": "Student",
      "Text": "又明白了一件事"
    },
    {
      "Id": 260110200,
      "Speaker": "Player",
      "Text": "明白了一件事？"
    },
    {
      "Id": 260110210,
      "Speaker": "Player",
      "Text": "佐天？"
    },
    {
      "Id": 260110220,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 260110230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "如果方便的話，現在能見個面嗎？"
    },
    {
      "Id": 260110240,
      "Speaker": "Student",
      "Text": "嗯～"
    },
    {
      "Id": 260110250,
      "Speaker": "Student",
      "Text": "我果然還是很在意"
    },
    {
      "Id": 260110260,
      "Speaker": "Student",
      "Text": "沒有跟他們分出勝負的事……"
    },
    {
      "Id": 260110270,
      "Speaker": "Player",
      "Text": "結果忘記原本的目的了……"
    },
    {
      "Id": 260110280,
      "Speaker": "Player",
      "Text": "我覺得從某方面來看，已經分出勝負了"
    },
    {
      "Id": 260110290,
      "Speaker": "Student",
      "Text": "咦……"
    },
    {
      "Id": 260110300,
      "Speaker": "Student",
      "Text": "是這樣嗎？"
    },
    {
      "Id": 260110310,
      "Speaker": "Student",
      "Text": "嗯……"
    },
    {
      "Id": 260110320,
      "Speaker": "Student",
      "Text": "聽老師這麼一說，好像也沒錯……"
    },
