{
  "CharacterId": 10041,
  "DialogJP": [
    {
      "Id": 100410010,
      "Speaker": "Student",
      "Text": "……これ、誰？"
    },
    {
      "Id": 100410020,
      "Speaker": "Player",
      "Text": "ミサキ？どうしたの？"
    },
    {
      "Id": 100410030,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100410040,
      "Speaker": "Student",
      "Text": "ああ、先生か"
    },
    {
      "Id": 100410050,
      "Speaker": "Student",
      "Text": "そっか、そうだった"
    },
    {
      "Id": 100410060,
      "Speaker": "Student",
      "Text": "自分で追加しといて忘れてた"
    },
    {
      "Id": 100410070,
      "Speaker": "Student",
      "Text": "それじゃ、失礼しました"
    },
    {
      "Id": 100410080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "えっと……あの、ミサキ？"
    },
    {
      "Id": 100410090,
      "Speaker": "Student",
      "Text": "次の目的地が決まった"
    },
    {
      "Id": 100410100,
      "Speaker": "Student",
      "Text": "毎回報告する必要はないんだけど"
    },
    {
      "Id": 100410110,
      "Speaker": "Student",
      "Text": "念のため伝えておく"
    },
    {
      "Id": 100410120,
      "Speaker": "Player",
      "Text": "気を付けてね。時間がある時、何があったか聞かせてほしいな"
    },
    {
      "Id": 100410130,
      "Speaker": "Student",
      "Text": "……ん？私に何があったか、ってこと？"
    },
    {
      "Id": 100410140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "それは……"
    },
    {
      "Id": 100410150,
      "Speaker": "Student",
      "Text": "先生、今大丈夫？"
    },
    {
      "Id": 100410160,
      "Speaker": "Player",
      "Text": "ミサキ……？"
    },
    {
      "Id": 100410170,
      "Speaker": "Student",
      "Text": "ごめん……ちょっと、助けてほしい"
    },
    {
      "Id": 100410180,
      "Speaker": "Player",
      "Text": "分かった、すぐ行くね"
    },
    {
      "Id": 100410190,
      "Speaker": "Student",
      "Text": "場所は、この後送る……"
    },
    {
      "Id": 100410200,
      "Speaker": "Student",
      "Text": "その……"
    },
    {
      "Id": 100410210,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ありがとう"
    },
    {
      "Id": 100410220,
      "Speaker": "Student",
      "Text": "……子ども扱いしないで"
    },
    {
      "Id": 100410230,
      "Speaker": "Student",
      "Text": "腹立つ、最悪"
    },
    {
      "Id": 100410240,
      "Speaker": "Player",
      "Text": "すみません……"
    },
    {
      "Id": 100410250,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100410260,
      "Speaker": "Student",
      "Text": "今日お世話になった分は、今度お返しするから"
    },
    {
      "Id": 100410270,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100410280,
      "Speaker": "Student",
      "Text": "じゃ、また明日"
    },
    {
      "Id": 100410290,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100410300,
      "Speaker": "Student",
      "Text": "シャーレで放置されてるカバンを見なかった？"
    },
    {
      "Id": 100410310,
      "Speaker": "Player",
      "Text": "見てないよ？"
    },
    {
      "Id": 100410320,
      "Speaker": "Student",
      "Text": "ならいい"
    },
    {
      "Id": 100410330,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "ミサキ、何かあったの？"
    },
    {
      "Id": 100410340,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "どんなカバン？"
    }
  ],
  "DialogKR": [
    {
      "Id": 100410010,
      "Speaker": "Student",
      "Text": "누구냐, 넌?"
    },
    {
      "Id": 100410020,
      "Speaker": "Player",
      "Text": "……응? 미사키?"
    },
    {
      "Id": 100410030,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 100410040,
      "Speaker": "Student",
      "Text": "아아. 선생님이었나."
    },
    {
      "Id": 100410050,
      "Speaker": "Student",
      "Text": "그래, 맞아. 그랬었지."
    },
    {
      "Id": 100410060,
      "Speaker": "Student",
      "Text": "추가해 놓고 까먹고 있었어."
    },
    {
      "Id": 100410070,
      "Speaker": "Student",
      "Text": "그럼 실례했어."
    },
    {
      "Id": 100410080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "저, 저기요? 미사키?"
    },
    {
      "Id": 100410090,
      "Speaker": "Student",
      "Text": "다음 목적지가 결정되었어."
    },
    {
      "Id": 100410100,
      "Speaker": "Student",
      "Text": "매번 보고할 필요는 없겠지만."
    },
    {
      "Id": 100410110,
      "Speaker": "Student",
      "Text": "혹시 모르니까 말해둘게."
    },
    {
      "Id": 100410120,
      "Speaker": "Player",
      "Text": "응. 시간 될 때 잠깐 들러줘. 미사키."
    },
    {
      "Id": 100410130,
      "Speaker": "Student",
      "Text": "……응? 나 말이야?"
    },
    {
      "Id": 100410140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "관심 없어."
    },
    {
      "Id": 100410150,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100410160,
      "Speaker": "Player",
      "Text": "미사키……?"
    },
    {
      "Id": 100410170,
      "Speaker": "Student",
      "Text": "미안. 도움이 필요해."
    },
    {
      "Id": 100410180,
      "Speaker": "Player",
      "Text": "알았어. 바로 갈게."
    },
    {
      "Id": 100410190,
      "Speaker": "Student",
      "Text": "지금 어디냐면……."
    },
    {
      "Id": 100410200,
      "Speaker": "Student",
      "Text": "……응."
    },
    {
      "Id": 100410210,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "고마워."
    },
    {
      "Id": 100410220,
      "Speaker": "Student",
      "Text": "……짜증 나."
    },
    {
      "Id": 100410230,
      "Speaker": "Student",
      "Text": "화나."
    },
    {
      "Id": 100410240,
      "Speaker": "Player",
      "Text": "죄송합니다……."
    },
    {
      "Id": 100410250,
      "Speaker": "Student",
      "Text": "……."
    },
    {
      "Id": 100410260,
      "Speaker": "Student",
      "Text": "오늘 신세 진 건 다음에 갚도록 할게."
    },
    {
      "Id": 100410270,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100410280,
      "Speaker": "Student",
      "Text": "그럼 또 봐."
    },
    {
      "Id": 100410290,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100410300,
      "Speaker": "Student",
      "Text": "혹시 샬레 건물 근처에서 주인 없는 가방 봤어?"
    },
    {
      "Id": 100410310,
      "Speaker": "Player",
      "Text": "아니, 없는데……?"
    },
    {
      "Id": 100410320,
      "Speaker": "Student",
      "Text": "그럼 됐어."
    },
    {
      "Id": 100410330,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "무슨 일이야, 미사키?"
    },
    {
      "Id": 100410340,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "무슨 가방인데?"
    }
  ],
  "DialogEN": [
    {
      "Id": 100410010,
      "Speaker": "Student",
      "Text": "Who are you?"
    },
    {
      "Id": 100410020,
      "Speaker": "Player",
      "Text": "Huh? Misaki?"
    },
    {
      "Id": 100410030,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100410040,
      "Speaker": "Student",
      "Text": "Oh, it's you, Sensei."
    },
    {
      "Id": 100410050,
      "Speaker": "Student",
      "Text": "Yeah, that's right."
    },
    {
      "Id": 100410060,
      "Speaker": "Student",
      "Text": "I forgot I added you."
    },
    {
      "Id": 100410070,
      "Speaker": "Student",
      "Text": "Excuse me."
    },
    {
      "Id": 100410080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "U-Um, Misaki?"
    },
    {
      "Id": 100410090,
      "Speaker": "Student",
      "Text": "The next destination has been determined."
    },
    {
      "Id": 100410100,
      "Speaker": "Student",
      "Text": "I know there's no need to report every time,"
    },
    {
      "Id": 100410110,
      "Speaker": "Student",
      "Text": "But I'll tell you just in case."
    },
    {
      "Id": 100410120,
      "Speaker": "Player",
      "Text": "Okay. Come by when you can, Misaki."
    },
    {
      "Id": 100410130,
      "Speaker": "Student",
      "Text": "...Huh? Me?"
    },
    {
      "Id": 100410140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "I don't care."
    },
    {
      "Id": 100410150,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100410160,
      "Speaker": "Player",
      "Text": "Misaki...?"
    },
    {
      "Id": 100410170,
      "Speaker": "Student",
      "Text": "Sorry. I need help."
    },
    {
      "Id": 100410180,
      "Speaker": "Player",
      "Text": "Okay. I'll be right there."
    },
    {
      "Id": 100410190,
      "Speaker": "Student",
      "Text": "Right now, I'm at..."
    },
    {
      "Id": 100410200,
      "Speaker": "Student",
      "Text": "Okay."
    },
    {
      "Id": 100410210,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Thanks."
    },
    {
      "Id": 100410220,
      "Speaker": "Student",
      "Text": "...Annoying."
    },
    {
      "Id": 100410230,
      "Speaker": "Student",
      "Text": "I'm angry."
    },
    {
      "Id": 100410240,
      "Speaker": "Player",
      "Text": "Sorry..."
    },
    {
      "Id": 100410250,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100410260,
      "Speaker": "Student",
      "Text": "I'll repay you for today next time."
    },
    {
      "Id": 100410270,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100410280,
      "Speaker": "Student",
      "Text": "See you later."
    },
    {
      "Id": 100410290,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100410300,
      "Speaker": "Student",
      "Text": "Did you see a lost bag near the Schale building?"
    },
    {
      "Id": 100410310,
      "Speaker": "Player",
      "Text": "No...?"
    },
    {
      "Id": 100410320,
      "Speaker": "Student",
      "Text": "Oh, okay."
    },
    {
      "Id": 100410330,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "What's going on, Misaki?"
    },
    {
      "Id": 100410340,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "What kind of bag was it?"
    }
  ],
  "DialogTH": [
    {
      "Id": 100410010,
      "Speaker": "Student",
      "Text": "ใครน่ะ?"
    },
    {
      "Id": 100410020,
      "Speaker": "Player",
      "Text": "หืม...? มิซากิ?"
    },
    {
      "Id": 100410030,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100410040,
      "Speaker": "Student",
      "Text": "อ้อ คุณครูเองสินะ"
    },
    {
      "Id": 100410050,
      "Speaker": "Student",
      "Text": "น่าจะใช่แล้วล่ะ"
    },
    {
      "Id": 100410060,
      "Speaker": "Student",
      "Text": "แอดไอดีเอาไว้แล้วก็ลืมน่ะ"
    },
    {
      "Id": 100410070,
      "Speaker": "Student",
      "Text": "งั้นขอตัวก่อนนะ..."
    },
    {
      "Id": 100410080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "ดะ...เดี๋ยวก่อน มิซากิ?"
    },
    {
      "Id": 100410090,
      "Speaker": "Student",
      "Text": "ฉันตัดสินใจเรื่องเป้าหมายต่อไปได้แล้ว"
    },
    {
      "Id": 100410100,
      "Speaker": "Student",
      "Text": "ถึงไม่จำเป็นที่จะต้องรายงานทุกครั้ง"
    },
    {
      "Id": 100410110,
      "Speaker": "Student",
      "Text": "แต่ก็คิดว่ามาบอกไว้ก่อนดีกว่า"
    },
    {
      "Id": 100410120,
      "Speaker": "Player",
      "Text": "อืม ถ้ามีเวลาก็แวะมาหน่อยนะ มิซากิ"
    },
    {
      "Id": 100410130,
      "Speaker": "Student",
      "Text": "หืม? ฉันเหรอ?"
    },
    {
      "Id": 100410140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ฉันไม่สนใจหรอก"
    },
    {
      "Id": 100410150,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100410160,
      "Speaker": "Player",
      "Text": "มิซากิ...?"
    },
    {
      "Id": 100410170,
      "Speaker": "Student",
      "Text": "ขอโทษที ฉันอยากขอให้ช่วยหน่อย"
    },
    {
      "Id": 100410180,
      "Speaker": "Player",
      "Text": "เข้าใจแล้ว ครูจะไปเดี๋ยวนี้เลย"
    },
    {
      "Id": 100410190,
      "Speaker": "Student",
      "Text": "ที่ที่ฉันอยู่ตอนนี้..."
    },
    {
      "Id": 100410200,
      "Speaker": "Student",
      "Text": "อื้อ..."
    },
    {
      "Id": 100410210,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ขอบคุณนะ"
    },
    {
      "Id": 100410220,
      "Speaker": "Student",
      "Text": "น่าหงุดหงิดจริงๆ..."
    },
    {
      "Id": 100410230,
      "Speaker": "Student",
      "Text": "โมโหชะมัด"
    },
    {
      "Id": 100410240,
      "Speaker": "Player",
      "Text": "ขอโทษนะ..."
    },
    {
      "Id": 100410250,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100410260,
      "Speaker": "Student",
      "Text": "เรื่องที่ไปรบกวนวันนี้ฉันจะชดใช้ให้\nวันหลังแล้วกัน"
    },
    {
      "Id": 100410270,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100410280,
      "Speaker": "Student",
      "Text": "งั้นไว้เจอกันนะ"
    },
    {
      "Id": 100410290,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100410300,
      "Speaker": "Student",
      "Text": "วันนี้เห็นกระเป๋าหล่นอยู่แถวๆ อาคาร\nชาเล่ต์บ้างรึเปล่า?"
    },
    {
      "Id": 100410310,
      "Speaker": "Player",
      "Text": "ไม่นะ ไม่เห็นเลย..."
    },
    {
      "Id": 100410320,
      "Speaker": "Student",
      "Text": "งั้นก็ช่างเถอะ"
    },
    {
      "Id": 100410330,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "มีเรื่องอะไรเหรอ มิซากิ?"
    },
    {
      "Id": 100410340,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "กระเป๋าอะไรเหรอ?"
    }
  ],
  "DialogTW": [
    {
      "Id": 100410010,
      "Speaker": "Student",
      "Text": "……你是哪位？"
    },
    {
      "Id": 100410020,
      "Speaker": "Player",
      "Text": "美咲？怎麼了嗎？"
    },
    {
      "Id": 100410030,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100410040,
      "Speaker": "Student",
      "Text": "啊啊，是老師啊"
    },
    {
      "Id": 100410050,
      "Speaker": "Student",
      "Text": "這樣啊，原來如此"
    },
    {
      "Id": 100410060,
      "Speaker": "Student",
      "Text": "明明是我自己加的卻忘記了"
    },
    {
      "Id": 100410070,
      "Speaker": "Student",
      "Text": "抱歉打擾了"
    },
    {
      "Id": 100410080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "呃……那個，美咲？"
    },
    {
      "Id": 100410090,
      "Speaker": "Student",
      "Text": "下一個目的地已經決定了"
    },
    {
      "Id": 100410100,
      "Speaker": "Student",
      "Text": "雖然不需要每次都報告"
    },
    {
      "Id": 100410110,
      "Speaker": "Student",
      "Text": "以防萬一告訴你一聲"
    },
    {
      "Id": 100410120,
      "Speaker": "Player",
      "Text": "注意安全哦。有時間的話，希望能告訴我發生了什麼事"
    },
    {
      "Id": 100410130,
      "Speaker": "Student",
      "Text": "……嗯？告訴你發生了什麼？"
    },
    {
      "Id": 100410140,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "這……"
    },
    {
      "Id": 100410150,
      "Speaker": "Student",
      "Text": "老師，現在有空嗎？"
    },
    {
      "Id": 100410160,
      "Speaker": "Player",
      "Text": "美咲……？"
    },
    {
      "Id": 100410170,
      "Speaker": "Student",
      "Text": "對不起……希望你能幫點小忙"
    },
    {
      "Id": 100410180,
      "Speaker": "Player",
      "Text": "知道了，我馬上過去"
    },
    {
      "Id": 100410190,
      "Speaker": "Student",
      "Text": "地點之後傳給你……"
    },
    {
      "Id": 100410200,
      "Speaker": "Student",
      "Text": "那個……"
    },
    {
      "Id": 100410210,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "謝謝"
    },
    {
      "Id": 100410220,
      "Speaker": "Student",
      "Text": "……別把我當成小孩子"
    },
    {
      "Id": 100410230,
      "Speaker": "Student",
      "Text": "好生氣，糟透了"
    },
    {
      "Id": 100410240,
      "Speaker": "Player",
      "Text": "我很抱歉……"
    },
    {
      "Id": 100410250,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 100410260,
      "Speaker": "Student",
      "Text": "今天欠你的人情，下次會還你"
