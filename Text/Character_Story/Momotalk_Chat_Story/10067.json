{
  "CharacterId": 10067,
  "DialogJP": [
    {
      "Id": 100670010,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100670020,
      "Speaker": "Student",
      "Text": "いらっしゃいますか？"
    },
    {
      "Id": 100670030,
      "Speaker": "Player",
      "Text": "あれ、トキ？どうしたの？"
    },
    {
      "Id": 100670040,
      "Speaker": "Student",
      "Text": "そうです、私です"
    },
    {
      "Id": 100670050,
      "Speaker": "Student",
      "Text": "折り入ってお願いがあるのですが、よろしいでしょうか？"
    },
    {
      "Id": 100670060,
      "Speaker": "Player",
      "Text": "トキのお願いなら何でも聞くよ"
    },
    {
      "Id": 100670070,
      "Speaker": "Student",
      "Text": "その言葉、ゆめゆめ忘れないでくださいね"
    },
    {
      "Id": 100670080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "ちょっと待って！一旦、内容聞いてから考えさせて……？"
    },
    {
      "Id": 100670090,
      "Speaker": "Student",
      "Text": "先生、本日もシャーレにいらっしゃいますよね？"
    },
    {
      "Id": 100670100,
      "Speaker": "Student",
      "Text": "それでは、本日もお伺い致します。"
    },
    {
      "Id": 100670110,
      "Speaker": "Student",
      "Text": "よろしいですね？"
    },
    {
      "Id": 100670120,
      "Speaker": "Player",
      "Text": "生徒の訪問を断る理由は……"
    },
    {
      "Id": 100670130,
      "Speaker": "Player",
      "Text": "どこにも無いからね……"
    },
    {
      "Id": 100670140,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 100670150,
      "Speaker": "Student",
      "Text": "そんなに嬉しいのですか？"
    },
    {
      "Id": 100670160,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "でしたら急いで参ります。また、後ほど"
    },
    {
      "Id": 100670170,
      "Speaker": "Student",
      "Text": "突入準備完了"
    },
    {
      "Id": 100670180,
      "Speaker": "Student",
      "Text": "ご指示を"
    },
    {
      "Id": 100670190,
      "Speaker": "Player",
      "Text": "トキ……？"
    },
    {
      "Id": 100670200,
      "Speaker": "Student",
      "Text": "戦闘開始"
    },
    {
      "Id": 100670210,
      "Speaker": "Student",
      "Text": "通信を遮断します"
    },
    {
      "Id": 100670220,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "トキ！？"
    }
  ],
  "DialogKR": [
    {
      "Id": 100670010,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100670020,
      "Speaker": "Student",
      "Text": "계십니까?"
    },
    {
      "Id": 100670030,
      "Speaker": "Player",
      "Text": "오, 토키다."
    },
    {
      "Id": 100670040,
      "Speaker": "Student",
      "Text": "그렇습니다. 저입니다."
    },
    {
      "Id": 100670050,
      "Speaker": "Student",
      "Text": "선생님께 긴히 드리고 싶은 부탁이 있는데, 괜찮으실까요?"
    },
    {
      "Id": 100670060,
      "Speaker": "Player",
      "Text": "토키의 부탁이라면야, 얼마든지."
    },
    {
      "Id": 100670070,
      "Speaker": "Student",
      "Text": "그 말씀, 확실히 기억했습니다."
    },
    {
      "Id": 100670080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "어…… 잠깐만. 지금 좀 신중하게 생각하고 싶어졌는데……?"
    },
    {
      "Id": 100670090,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 100670100,
      "Speaker": "Student",
      "Text": "그러면 오늘도 실례하겠습니다."
    },
    {
      "Id": 100670110,
      "Speaker": "Student",
      "Text": "괜찮으시지요?"
    },
    {
      "Id": 100670120,
      "Speaker": "Player",
      "Text": "……학생의 방문을 막을 이유는."
    },
    {
      "Id": 100670130,
      "Speaker": "Player",
      "Text": "어떻게 생각해도 없겠지만 말이야……"
    },
    {
      "Id": 100670140,
      "Speaker": "Student",
      "Text": "음."
    },
    {
      "Id": 100670150,
      "Speaker": "Student",
      "Text": "아무 문제도 없다는 것이로군요."
    },
    {
      "Id": 100670160,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그러면 선생님. 그렇게 알고 있겠습니다."
    },
    {
      "Id": 100670170,
      "Speaker": "Student",
      "Text": "돌입 준비 완료."
    },
    {
      "Id": 100670180,
      "Speaker": "Student",
      "Text": "지시를 기다리겠습니다."
    },
    {
      "Id": 100670190,
      "Speaker": "Player",
      "Text": "토키……?"
    },
    {
      "Id": 100670200,
      "Speaker": "Student",
      "Text": "작전 개시."
    },
    {
      "Id": 100670210,
      "Speaker": "Student",
      "Text": "통신을 일시 차단합니다."
    },
    {
      "Id": 100670220,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "토키?!"
    }
  ],
  "DialogEN": [
    {
      "Id": 100670010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100670020,
      "Speaker": "Student",
      "Text": "Hello? Sensei?"
    },
    {
      "Id": 100670030,
      "Speaker": "Player",
      "Text": "Oh, Toki."
    },
    {
      "Id": 100670040,
      "Speaker": "Student",
      "Text": "Correct. It's Toki."
    },
    {
      "Id": 100670050,
      "Speaker": "Student",
      "Text": "I would like to make a request from you. Is that all right?"
    },
    {
      "Id": 100670060,
      "Speaker": "Player",
      "Text": "Of course! I'm happy to help you with anything you need."
    },
    {
      "Id": 100670070,
      "Speaker": "Student",
      "Text": "Anything I need... I will remember this."
    },
    {
      "Id": 100670080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "Hang on, hang on! I need to reword that!"
    },
    {
      "Id": 100670090,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100670100,
      "Speaker": "Student",
      "Text": "I would like to visit today."
    },
    {
      "Id": 100670110,
      "Speaker": "Student",
      "Text": "That's acceptable, no?"
    },
    {
      "Id": 100670120,
      "Speaker": "Player",
      "Text": "I can't think of any reason why not..."
    },
    {
      "Id": 100670130,
      "Speaker": "Player",
      "Text": "I wouldn't stop a student from visiting me..."
    },
    {
      "Id": 100670140,
      "Speaker": "Student",
      "Text": "Hmm."
    },
    {
      "Id": 100670150,
      "Speaker": "Student",
      "Text": "So, you're saying that it isn't a problem."
    },
    {
      "Id": 100670160,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "I will keep that in mind, Sensei."
    },
    {
      "Id": 100670170,
      "Speaker": "Student",
      "Text": "Preparations complete."
    },
    {
      "Id": 100670180,
      "Speaker": "Student",
      "Text": "I await the go order."
    },
    {
      "Id": 100670190,
      "Speaker": "Player",
      "Text": "Toki...?"
    },
    {
      "Id": 100670200,
      "Speaker": "Student",
      "Text": "Beginning operation."
    },
    {
      "Id": 100670210,
      "Speaker": "Student",
      "Text": "Going silent."
    },
    {
      "Id": 100670220,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "Toki?!"
    }
  ],
  "DialogTH": [
    {
      "Id": 100670010,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100670020,
      "Speaker": "Student",
      "Text": "อยู่มั้ยคะ?"
    },
    {
      "Id": 100670030,
      "Speaker": "Player",
      "Text": "โอ้ โทคินี่นา"
    },
    {
      "Id": 100670040,
      "Speaker": "Student",
      "Text": "ใช่ค่ะ ฉันเองค่ะ"
    },
    {
      "Id": 100670050,
      "Speaker": "Student",
      "Text": "ฉันมีเรื่องอยากรบกวนคุณครูสักหน่อย\nจะเป็นอะไรมั้ยคะ?"
    },
    {
      "Id": 100670060,
      "Speaker": "Player",
      "Text": "ถ้าโทคิมาขอความช่วยเหลือ\nครูก็พร้อมช่วยตลอดนะ"
    },
    {
      "Id": 100670070,
      "Speaker": "Student",
      "Text": "ฉันจำได้แม่นเลยค่ะว่าคุณครูเคยบอก\nไว้ว่าอย่างนั้น"
    },
    {
      "Id": 100670080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "อ่า... เดี๋ยวนะ ตอนนี้อยากจะคิดอย่าง\nรอบคอบขึ้นมาแล้วละ..."
    },
    {
      "Id": 100670090,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100670100,
      "Speaker": "Student",
      "Text": "ถ้าอย่างนั้นวันนี้ก็ขอรบกวน\nด้วยนะคะ"
    },
    {
      "Id": 100670110,
      "Speaker": "Student",
      "Text": "ไม่เป็นไรใช่มั้ยคะ?"
    },
    {
      "Id": 100670120,
      "Speaker": "Player",
      "Text": "ครูไม่มีเหตุผลที่จะปฏิเสธ\nสักหน่อยนี่นา..."
    },
    {
      "Id": 100670130,
      "Speaker": "Player",
      "Text": "ครูไม่ห้ามนักเรียนให้มาหาหรอกนะ"
    },
    {
      "Id": 100670140,
      "Speaker": "Student",
      "Text": "อื้ม"
    },
    {
      "Id": 100670150,
      "Speaker": "Student",
      "Text": "แปลว่าไม่เป็นไรสินะคะ"
    },
    {
      "Id": 100670160,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ถ้างั้นฉันจะจำเอาไว้ว่าสามารถ\nรบกวนคุณครูได้ค่ะ"
    },
    {
      "Id": 100670170,
      "Speaker": "Student",
      "Text": "เตรียมตัวพร้อมแล้ว"
    },
    {
      "Id": 100670180,
      "Speaker": "Student",
      "Text": "ฉันจะรอคำสั่งค่ะ"
    },
    {
      "Id": 100670190,
      "Speaker": "Player",
      "Text": "โทคิ...?"
    },
    {
      "Id": 100670200,
      "Speaker": "Student",
      "Text": "เริ่มแผนการ"
    },
    {
      "Id": 100670210,
      "Speaker": "Student",
      "Text": "ขอตัดการสื่อสารชั่วคราวค่ะ"
    },
    {
      "Id": 100670220,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "โทคิ?!"
    }
  ],
  "DialogTW": [
    {
      "Id": 100670010,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100670020,
      "Speaker": "Student",
      "Text": "您在嗎？"
    },
    {
      "Id": 100670030,
      "Speaker": "Player",
      "Text": "咦，季？怎麼了嗎？"
    },
    {
      "Id": 100670040,
      "Speaker": "Student",
      "Text": "沒錯，是我"
    },
    {
      "Id": 100670050,
      "Speaker": "Student",
      "Text": "有件事想請您幫忙，不知道您是否願意呢？"
    },
    {
      "Id": 100670060,
      "Speaker": "Player",
      "Text": "只要是季的請求，不管是什麼都願意哦"
    },
    {
      "Id": 100670070,
      "Speaker": "Student",
      "Text": "這句話，還請您務必銘記於心"
    },
    {
      "Id": 100670080,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "先等一下！讓我先聽內容再考慮……？"
    },
    {
      "Id": 100670090,
      "Speaker": "Student",
      "Text": "老師，您今天也在夏萊吧？"
    },
    {
      "Id": 100670100,
      "Speaker": "Student",
      "Text": "那麼，我今天也會去拜訪您"
    },
    {
      "Id": 100670110,
      "Speaker": "Student",
      "Text": "您不介意吧？"
    },
    {
      "Id": 100670120,
      "Speaker": "Player",
      "Text": "我怎麼也想不到……"
    },
    {
      "Id": 100670130,
      "Speaker": "Player",
      "Text": "拒絕學生來訪的理由……"
    },
    {
      "Id": 100670140,
      "Speaker": "Student",
      "Text": "呵呵"
    },
    {
      "Id": 100670150,
      "Speaker": "Student",
      "Text": "您這麼高興嗎？"
    },
    {
      "Id": 100670160,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "那麼我會盡快趕到。稍後再見"
    },
    {
      "Id": 100670170,
      "Speaker": "Student",
      "Text": "突擊準備完成"
    },
    {
      "Id": 100670180,
      "Speaker": "Student",
      "Text": "請下指示"
    },
    {
      "Id": 100670190,
      "Speaker": "Player",
      "Text": "季……？"
    },
    {
      "Id": 100670200,
      "Speaker": "Student",
      "Text": "戰鬥開始"
    },
    {
      "Id": 100670210,
      "Speaker": "Student",
      "Text": "將暫時阻斷通訊"
    },
    {
      "Id": 100670220,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "季！？"
    }
  ]
}