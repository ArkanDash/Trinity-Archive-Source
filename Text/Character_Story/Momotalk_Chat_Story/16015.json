{
  "CharacterId": 16015,
  "DialogJP": [
    {
      "Id": 160150010,
      "Speaker": "Student",
      "Text": "先生、アイリです！"
    },
    {
      "Id": 160150020,
      "Speaker": "Student",
      "Text": "今、お時間大丈夫でしょうか？"
    },
    {
      "Id": 160150030,
      "Speaker": "Player",
      "Text": "こんにちは、アイリ"
    },
    {
      "Id": 160150040,
      "Speaker": "Player",
      "Text": "大丈夫だよ。どうしたの？"
    },
    {
      "Id": 160150050,
      "Speaker": "Student",
      "Text": "はい！こんにちは"
    },
    {
      "Id": 160150060,
      "Speaker": "Student",
      "Text": "あ、それは良かったです！"
    },
    {
      "Id": 160150070,
      "Speaker": "Student",
      "Text": "その……ちょっとモモトークではお伝えしづらくて"
    },
    {
      "Id": 160150080,
      "Speaker": "Student",
      "Text": "少しお時間をいただければと……！\n10分くらいでも大丈夫なので！"
    },
    {
      "Id": 160150090,
      "Speaker": "Player",
      "Text": "……？"
    },
    {
      "Id": 160150100,
      "Speaker": "Student",
      "Text": "お待ちしてますねo(^▽^)o"
    },
    {
      "Id": 160150110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "本当に、ちょっとだけで良いので……！よろしくお願いします！"
    },
    {
      "Id": 160150120,
      "Speaker": "Student",
      "Text": "先生！無事に帰れましたか？"
    },
    {
      "Id": 160150130,
      "Speaker": "Student",
      "Text": "それとあらためて、スイーツどうでした？"
    },
    {
      "Id": 160150140,
      "Speaker": "Player",
      "Text": "並んだ甲斐があったよ！"
    },
    {
      "Id": 160150150,
      "Speaker": "Player",
      "Text": "アイリと色々話せて楽しかった！"
    },
    {
      "Id": 160150160,
      "Speaker": "Student",
      "Text": "！"
    },
    {
      "Id": 160150170,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 160150180,
      "Speaker": "Student",
      "Text": "それなら良かったです！"
    },
    {
      "Id": 160150190,
      "Speaker": "Student",
      "Text": "また連絡しますね！"
    },
    {
      "Id": 160150200,
      "Speaker": "Student",
      "Text": "先生こんにちは！"
    },
    {
      "Id": 160150210,
      "Speaker": "Student",
      "Text": "実は今"
    },
    {
      "Id": 160150220,
      "Speaker": "Student",
      "Text": "一人で練習中でして"
    },
    {
      "Id": 160150230,
      "Speaker": "Student",
      "Text": "よろしければ見ていただけませんか？"
    },
    {
      "Id": 160150240,
      "Speaker": "Student",
      "Text": "ちょっと詰まってしまって……"
    },
    {
      "Id": 160150250,
      "Speaker": "Player",
      "Text": "もちろん、すぐに行くよ"
    },
    {
      "Id": 160150260,
      "Speaker": "Player",
      "Text": "練習頑張ってるね、ちょっと待ってて"
    },
    {
      "Id": 160150270,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 160150280,
      "Speaker": "Student",
      "Text": "本当に助かります！"
    },
    {
      "Id": 160150290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "(((o(≧∇≦)o)))"
    },
    {
      "Id": 160150300,
      "Speaker": "Student",
      "Text": "ごめんなさい"
    },
    {
      "Id": 160150310,
      "Speaker": "Student",
      "Text": "ほんっとうにごめんなさい！"
    },
    {
      "Id": 160150320,
      "Speaker": "Player",
      "Text": "謝らなくても大丈夫だよ"
    },
    {
      "Id": 160150330,
      "Speaker": "Player",
      "Text": "怪我も無かったし。アイリの方は大丈夫だった？"
    },
    {
      "Id": 160150340,
      "Speaker": "Student",
      "Text": "はい、ですが……"
    },
    {
      "Id": 160150350,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 160150360,
      "Speaker": "Student",
      "Text": "もっと、良い雰囲気になるはずだったと言いますか"
    },
    {
      "Id": 160150370,
      "Speaker": "Student",
      "Text": "あんなことになってしまい……"
    },
    {
      "Id": 160150380,
      "Speaker": "Player",
      "Text": "そんなことないよ、楽しかったし"
    },
    {
      "Id": 160150390,
      "Speaker": "Player",
      "Text": "こういうのも思い出になるよ"
    },
    {
      "Id": 160150400,
      "Speaker": "Student",
      "Text": "そ"
    },
    {
      "Id": 160150410,
      "Speaker": "Student",
      "Text": "そう、なんでしょうか"
    },
    {
      "Id": 160150420,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 160150430,
      "Speaker": "Student",
      "Text": "先生がそう仰るなら"
    },
    {
      "Id": 160150440,
      "Speaker": "Student",
      "Text": "では、結果オーライで！！(((o(≧∇≦)o)))"
    },
    {
      "Id": 160150450,
      "Speaker": "Student",
      "Text": "そろそろ"
    },
    {
      "Id": 160150460,
      "Speaker": "Student",
      "Text": "学園祭も終わりますね"
    },
    {
      "Id": 160150470,
      "Speaker": "Student",
      "Text": "その……"
    },
    {
      "Id": 160150480,
      "Speaker": "Student",
      "Text": "╯︿╰"
    },
    {
      "Id": 160150490,
      "Speaker": "Player",
      "Text": "……アイリ？"
    },
    {
      "Id": 160150500,
      "Speaker": "Player",
      "Text": "大丈夫？"
    },
    {
      "Id": 160150510,
      "Speaker": "Student",
      "Text": "すみません"
    },
    {
      "Id": 160150520,
      "Speaker": "Student",
      "Text": "余計なことを言ってしまったかもです"
    },
    {
      "Id": 160150530,
      "Speaker": "Student",
      "Text": "大丈夫かどうかも、ちょっと分かりません"
    },
    {
      "Id": 160150540,
      "Speaker": "Student",
      "Text": "何と言うか……"
    },
    {
      "Id": 160150550,
      "Speaker": "Student",
      "Text": "╯︿╰"
    },
    {
      "Id": 160150560,
      "Speaker": "Student",
      "Text": "いえ"
    },
    {
      "Id": 160150570,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "やはりお気になさらず……"
    },
    {
      "Id": 160150580,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 160150590,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 160150600,
      "Speaker": "Student",
      "Text": "全然別の話なんですが……"
    },
    {
      "Id": 160150610,
      "Speaker": "Student",
      "Text": "今日のこと"
    },
    {
      "Id": 160150620,
      "Speaker": "Student",
      "Text": "あの、他の子には内緒で……"
    },
    {
      "Id": 160150630,
      "Speaker": "Student",
      "Text": "恥ずかしいので……"
    },
    {
      "Id": 160150640,
      "Speaker": "Player",
      "Text": "心配しないで、誰にも言わないよ"
    },
    {
      "Id": 160150650,
      "Speaker": "Player",
      "Text": "もちろん、二人だけの秘密で"
    },
    {
      "Id": 160150660,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 160150670,
      "Speaker": "Student",
      "Text": "はい！"
    },
    {
      "Id": 160150680,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 160150690,
      "Speaker": "Student",
      "Text": "ありがとうございます！！ヾ(^▽^*)))"
    }
  ],
  "DialogKR": [
    {
      "Id": 160150010,
      "Speaker": "Student",
      "Text": "선생님! 혹시 이번 주말에 시간 괜찮으신가요?"
    },
    {
      "Id": 160150020,
      "Speaker": "Student",
      "Text": "아이리에요!!"
    },
    {
      "Id": 160150030,
      "Speaker": "Player",
      "Text": "안녕, 아이리."
    },
    {
      "Id": 160150040,
      "Speaker": "Player",
      "Text": "괜찮지. 무슨 일 있어?"
    },
    {
      "Id": 160150050,
      "Speaker": "Student",
      "Text": "네! 안녕하세요!"
    },
    {
      "Id": 160150060,
      "Speaker": "Student",
      "Text": "아, 다행이네요!"
    },
    {
      "Id": 160150070,
      "Speaker": "Student",
      "Text": "아무튼 괜찮으시다면 말씀드린 대로……."
    },
    {
      "Id": 160150080,
      "Speaker": "Student",
      "Text": "주말에 시간 괜찮으실까요? 잠깐이면 되니까요!!"
    },
    {
      "Id": 160150090,
      "Speaker": "Player",
      "Text": "……?"
    },
    {
      "Id": 160150100,
      "Speaker": "Student",
      "Text": "헤헤 o(^▽^)o"
    },
    {
      "Id": 160150110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "꼭이에요!!"
    },
    {
      "Id": 160150120,
      "Speaker": "Student",
      "Text": "선생님! 잘 들어 가셨나요!"
    },
    {
      "Id": 160150130,
      "Speaker": "Student",
      "Text": "드신 건 입에 맞으셨을지 모르겠네요."
    },
    {
      "Id": 160150140,
      "Speaker": "Player",
      "Text": "기다린 보람이 있었지, 여러 가지로!"
    },
    {
      "Id": 160150150,
      "Speaker": "Player",
      "Text": "새로운 걸 알아서 좋았어. 여러 가지로."
    },
    {
      "Id": 160150160,
      "Speaker": "Student",
      "Text": "앗"
    },
    {
      "Id": 160150170,
      "Speaker": "Student",
      "Text": "헤헤"
    },
    {
      "Id": 160150180,
      "Speaker": "Student",
      "Text": "그럼 다행이네요!"
    },
    {
      "Id": 160150190,
      "Speaker": "Student",
      "Text": "다음에 또 말씀드리겠습니다!!"
    },
    {
      "Id": 160150200,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 160150210,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 160150220,
      "Speaker": "Student",
      "Text": "지금 혼자서 조금 연습 중인데"
    },
    {
      "Id": 160150230,
      "Speaker": "Student",
      "Text": "괜찮으시면, 같이 봐주실 수 있을까요?"
    },
    {
      "Id": 160150240,
      "Speaker": "Student",
      "Text": "잘 안되는 부분이 있어서요;;;"
    },
    {
      "Id": 160150250,
      "Speaker": "Player",
      "Text": "물론이지. 금방 갈게."
    },
    {
      "Id": 160150260,
      "Speaker": "Player",
      "Text": "정말 열심이구나."
    },
    {
      "Id": 160150270,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 160150280,
      "Speaker": "Student",
      "Text": "네!"
    },
    {
      "Id": 160150290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "감사합니다, 선생님!! (((o(≧∇≦)o)))"
    },
    {
      "Id": 160150300,
      "Speaker": "Student",
      "Text": "죄송해요"
    },
    {
      "Id": 160150310,
      "Speaker": "Student",
      "Text": "선생님 정말로 죄송합니다."
    },
    {
      "Id": 160150320,
      "Speaker": "Player",
      "Text": "사과할 필요 없어. 괜찮아."
    },
    {
      "Id": 160150330,
      "Speaker": "Player",
      "Text": "다치지 않았잖아. 이 정도야 거뜬하지!"
    },
    {
      "Id": 160150340,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 160150350,
      "Speaker": "Student",
      "Text": "그래도"
    },
    {
      "Id": 160150360,
      "Speaker": "Student",
      "Text": "뭔가 생각했던 건 좀 더 멋진 그림이었는데"
    },
    {
      "Id": 160150370,
      "Speaker": "Student",
      "Text": "그렇게 금방 꼴사나운 결과가 될 줄은……."
    },
    {
      "Id": 160150380,
      "Speaker": "Player",
      "Text": "그럴 리가. 이게 진짜 완성이잖아?"
    },
    {
      "Id": 160150390,
      "Speaker": "Player",
      "Text": "이건 이것대로 꽤 멋지지 않아?"
    },
    {
      "Id": 160150400,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 160150410,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 160150420,
      "Speaker": "Student",
      "Text": "그런가요?"
    },
    {
      "Id": 160150430,
      "Speaker": "Student",
      "Text": "그럴 지도……."
    },
    {
      "Id": 160150440,
      "Speaker": "Student",
      "Text": "그럼 다행인 것으로!! (((o(≧∇≦)o)))"
    },
    {
      "Id": 160150450,
      "Speaker": "Student",
      "Text": "슬슬"
    },
    {
      "Id": 160150460,
      "Speaker": "Student",
      "Text": "일정들도 다 끝나 가네요"
    },
    {
      "Id": 160150470,
      "Speaker": "Student",
      "Text": "뭔가 조금……. 뭐랄까……."
    },
    {
      "Id": 160150480,
      "Speaker": "Student",
      "Text": "╯︿╰"
    },
    {
      "Id": 160150490,
      "Speaker": "Player",
      "Text": "……아이리?"
    },
    {
      "Id": 160150500,
      "Speaker": "Player",
      "Text": "뭔가 고민이 있는 느낌이네."
    },
    {
      "Id": 160150510,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 160150520,
      "Speaker": "Student",
      "Text": "또 괜한 소리를 ㅎㅎ;;"
    },
    {
      "Id": 160150530,
      "Speaker": "Student",
      "Text": "모르겠어요."
    },
    {
      "Id": 160150540,
      "Speaker": "Student",
      "Text": "그런 걸까요? 그럴 지도……."
    },
    {
      "Id": 160150550,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 160150560,
      "Speaker": "Student",
      "Text": "괜한 메시지를 보냈네요."
    },
    {
      "Id": 160150570,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "죄송해요. ╯︿╰"
    },
    {
      "Id": 160150580,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 160150590,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 160150600,
      "Speaker": "Student",
      "Text": "그러고 보니 선생님"
    },
    {
      "Id": 160150610,
      "Speaker": "Student",
      "Text": "이건 완전히 다른 이야기긴 하지만요;"
    },
    {
      "Id": 160150620,
      "Speaker": "Student",
      "Text": "오늘 일……."
    },
    {
      "Id": 160150630,
      "Speaker": "Student",
      "Text": "뭔가 부끄러우니 다른 아이들에겐……."
    },
    {
      "Id": 160150640,
      "Speaker": "Player",
      "Text": "걱정하지 마. 아무 말 안 할게."
    },
    {
      "Id": 160150650,
      "Speaker": "Player",
      "Text": "저도 그 정도의 눈치는 있습니다ㅋㅋ"
    },
    {
      "Id": 160150660,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 160150670,
      "Speaker": "Student",
      "Text": "네"
    },
    {
      "Id": 160150680,
      "Speaker": "Student",
      "Text": "ㅎㅎㅎ"
    },
    {
      "Id": 160150690,
      "Speaker": "Student",
      "Text": "감사합니다!! ヾ(^▽^*)))"
    }
  ],
  "DialogEN": [
    {
      "Id": 160150010,
      "Speaker": "Student",
      "Text": "Hello, Sensei! Do you have plans this weekend?"
    },
    {
      "Id": 160150020,
      "Speaker": "Student",
      "Text": "It's Airi!"
    },
    {
      "Id": 160150030,
      "Speaker": "Player",
      "Text": "Hi, Airi."
    },
    {
      "Id": 160150040,
      "Speaker": "Player",
      "Text": "Zero plans! What's up?"
    },
    {
      "Id": 160150050,
      "Speaker": "Student",
      "Text": "Hello, Sensei!"
    },
    {
      "Id": 160150060,
      "Speaker": "Student",
      "Text": "Ah! Wonderful!"
    },
    {
      "Id": 160150070,
      "Speaker": "Student",
      "Text": "If you're free, then I was wondering..."
    },
    {
      "Id": 160150080,
      "Speaker": "Student",
      "Text": "Could I borrow you for a little this weekend? Just for a bit!"
    },
    {
      "Id": 160150090,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 160150100,
      "Speaker": "Student",
      "Text": "Heehee o(^▽^)o"
    },
    {
      "Id": 160150110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "It's a promise!"
    },
    {
      "Id": 160150120,
      "Speaker": "Student",
      "Text": "Sensei! Did you return home safely?"
    },
    {
      "Id": 160150130,
      "Speaker": "Student",
      "Text": "I hope your treat was to your taste."
    },
    {
      "Id": 160150140,
      "Speaker": "Player",
      "Text": "It was worth the wait, in many ways!"
    },
    {
      "Id": 160150150,
      "Speaker": "Player",
      "Text": "I learned a lot of new things!"
    },
    {
      "Id": 160150160,
      "Speaker": "Student",
      "Text": "Ah!"
    },
    {
      "Id": 160150170,
      "Speaker": "Student",
      "Text": "Heehee!"
    },
    {
      "Id": 160150180,
      "Speaker": "Student",
      "Text": "I'm delighted to hear that!"
    },
    {
      "Id": 160150190,
      "Speaker": "Student",
      "Text": "I'll teach you more next time, okay?"
    },
    {
      "Id": 160150200,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 160150210,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 160150220,
      "Speaker": "Student",
      "Text": "I've been practicing a bit on my own."
    },
    {
      "Id": 160150230,
      "Speaker": "Student",
      "Text": "Would you mind coming by to help me with something?"
    },
    {
      "Id": 160150240,
      "Speaker": "Student",
      "Text": "I can't seem to figure out this one part;;;"
    },
    {
      "Id": 160150250,
      "Speaker": "Player",
      "Text": "Of course. I'll be there right away!"
    },
    {
      "Id": 160150260,
      "Speaker": "Player",
      "Text": "You're working really hard."
    },
    {
