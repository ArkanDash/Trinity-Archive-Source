  "DialogTH": [
    {
      "Id": 160150010,
      "Speaker": "Student",
      "Text": "คุณครู! สุดสัปดาห์นี้มีเวลาว่างมั้ยคะ?"
    },
    {
      "Id": 160150020,
      "Speaker": "Student",
      "Text": "ฉันไอริเองค่ะ!!"
    },
    {
      "Id": 160150030,
      "Speaker": "Player",
      "Text": "สวัสดี ไอริ"
    },
    {
      "Id": 160150040,
      "Speaker": "Player",
      "Text": "ก็ว่างอยู่นะ มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 160150050,
      "Speaker": "Student",
      "Text": "ค่ะ! สวัสดีค่ะ!"
    },
    {
      "Id": 160150060,
      "Speaker": "Student",
      "Text": "อ๊ะ ดีจังเลยนะคะ!"
    },
    {
      "Id": 160150070,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูไม่ติดอะไร..."
    },
    {
      "Id": 160150080,
      "Speaker": "Student",
      "Text": "สุดสัปดาห์นี้มาเจอกันหน่อยได้มั้ยคะ?\nแค่เดี๋ยวเดียวเองค่ะ!!"
    },
    {
      "Id": 160150090,
      "Speaker": "Player",
      "Text": "...?"
    },
    {
      "Id": 160150100,
      "Speaker": "Student",
      "Text": "ฮิฮิ o(^▽^)o"
    },
    {
      "Id": 160150110,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ต้องมาให้ได้นะคะ!!"
    },
    {
      "Id": 160150120,
      "Speaker": "Student",
      "Text": "คุณครู! กลับไปถึงหรือยังคะ?"
    },
    {
      "Id": 160150130,
      "Speaker": "Student",
      "Text": "ไม่รู้เลยนะคะว่าขนมวันนี้ถูกปากคุณครู\nหรือเปล่า"
    },
    {
      "Id": 160150140,
      "Speaker": "Player",
      "Text": "มันคุ้มค่ากับการต่อแถวรอนะ!"
    },
    {
      "Id": 160150150,
      "Speaker": "Player",
      "Text": "วันนี้สนุกมาก ครูได้รู้อะไรใหม่ๆ\nเยอะเลย"
    },
    {
      "Id": 160150160,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 160150170,
      "Speaker": "Student",
      "Text": "แหะๆ"
    },
    {
      "Id": 160150180,
      "Speaker": "Student",
      "Text": "งั้นก็ค่อยยังชั่วหน่อยค่ะ!"
    },
    {
      "Id": 160150190,
      "Speaker": "Student",
      "Text": "ไว้คราวหน้าฉันจะเล่าให้ฟังอีกนะคะ!!"
    },
    {
      "Id": 160150200,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 160150210,
      "Speaker": "Student",
      "Text": "คือว่า..."
    },
    {
      "Id": 160150220,
      "Speaker": "Student",
      "Text": "ตอนนี้ฉันกำลังซ้อมดนตรีอยู่คนเดียว"
    },
    {
      "Id": 160150230,
      "Speaker": "Student",
      "Text": "ถ้าคุณครูไม่ติดอะไร มาดูการซ้อมของ\nฉันหน่อยได้มั้ยคะ?"
    },
    {
      "Id": 160150240,
      "Speaker": "Student",
      "Text": "พอดีมีท่อนที่ฉันเล่นไม่ได้น่ะค่ะ;;;"
    },
    {
      "Id": 160150250,
      "Speaker": "Player",
      "Text": "ได้สิ ครูจะรีบไปเดี๋ยวนี้ละ"
    },
    {
      "Id": 160150260,
      "Speaker": "Player",
      "Text": "ตั้งใจซ้อมจริงๆ เลยนะ"
    },
    {
      "Id": 160150270,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 160150280,
      "Speaker": "Student",
      "Text": "ค่ะ!"
    },
    {
      "Id": 160150290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ขอบคุณค่ะคุณครู!! (((o(≧∇≦)o)))"
    },
    {
      "Id": 160150300,
      "Speaker": "Student",
      "Text": "ขอโทษค่ะ"
    },
    {
      "Id": 160150310,
      "Speaker": "Student",
      "Text": "ขอโทษจริงๆ นะคะคุณครู"
    },
    {
      "Id": 160150320,
      "Speaker": "Player",
      "Text": "ไม่ต้องขอโทษหรอก ไม่เป็นไร"
