{
  "CharacterId": 20040,
  "DialogJP": [
    {
      "Id": 200400010,
      "Speaker": "Student",
      "Text": "先生？今大丈夫かしら"
    },
    {
      "Id": 200400020,
      "Speaker": "Student",
      "Text": "万魔殿の協力者として"
    },
    {
      "Id": 200400030,
      "Speaker": "Student",
      "Text": "今回も手伝ってくれない？"
    },
    {
      "Id": 200400040,
      "Speaker": "Player",
      "Text": "あれ、サツキ……？"
    },
    {
      "Id": 200400050,
      "Speaker": "Player",
      "Text": "どうかしたの？"
    },
    {
      "Id": 200400060,
      "Speaker": "Student",
      "Text": "ふむ……これは会って話した方がよさそうね"
    },
    {
      "Id": 200400070,
      "Speaker": "Student",
      "Text": "他の用件もあるし"
    },
    {
      "Id": 200400080,
      "Speaker": "Student",
      "Text": "今からシャーレに行くわ"
    },
    {
      "Id": 200400090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "ちょっと！？"
    },
    {
      "Id": 200400100,
      "Speaker": "Student",
      "Text": "こんにちは先生"
    },
    {
      "Id": 200400110,
      "Speaker": "Student",
      "Text": "前回は散々だったけど"
    },
    {
      "Id": 200400120,
      "Speaker": "Student",
      "Text": "今回は他の方法を試すつもりよ"
    },
    {
      "Id": 200400130,
      "Speaker": "Student",
      "Text": "いまシャーレにいるのよね？"
    },
    {
      "Id": 200400140,
      "Speaker": "Player",
      "Text": "うん……？"
    },
    {
      "Id": 200400150,
      "Speaker": "Player",
      "Text": "いるよ……？"
    },
    {
      "Id": 200400160,
      "Speaker": "Student",
      "Text": "じゃあそのまま待っていて頂戴"
    },
    {
      "Id": 200400170,
      "Speaker": "Student",
      "Text": "今向かうわ！"
    },
    {
      "Id": 200400180,
      "Speaker": "Player",
      "Text": "サツキ……？"
    },
    {
      "Id": 200400190,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "ちょっと！？"
    },
    {
      "Id": 200400200,
      "Speaker": "Student",
      "Text": "喜びなさい、先生"
    },
    {
      "Id": 200400210,
      "Speaker": "Player",
      "Text": "やったあ！"
    },
    {
      "Id": 200400220,
      "Speaker": "Student",
      "Text": "うふふっ"
    },
    {
      "Id": 200400230,
      "Speaker": "Student",
      "Text": "話す前からそんなに喜ぶなんて"
    },
    {
      "Id": 200400240,
      "Speaker": "Student",
      "Text": "何があったのか、気になるでしょう？"
    },
    {
      "Id": 200400250,
      "Speaker": "Player",
      "Text": "なんだか悪い予感が……"
    },
    {
      "Id": 200400260,
      "Speaker": "Student",
      "Text": "先生を対象に……"
    },
    {
      "Id": 200400270,
      "Speaker": "Student",
      "Text": "いえ、やっぱり会って話した方がよさそうね"
    },
    {
      "Id": 200400280,
      "Speaker": "Student",
      "Text": "今から向かうわ！"
    },
    {
      "Id": 200400290,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "サツキ……？"
    },
    {
      "Id": 200400300,
      "Speaker": "Student",
      "Text": "命令通り、帰ってきてゆっくり休んだわ"
    },
    {
      "Id": 200400310,
      "Speaker": "Student",
      "Text": "もう催眠は解除されたみたいだけど"
    },
    {
      "Id": 200400320,
      "Speaker": "Student",
      "Text": "本当に油断しちゃダメね"
    },
    {
      "Id": 200400330,
      "Speaker": "Player",
      "Text": "ちゃんと帰れてよかった"
    },
    {
      "Id": 200400340,
      "Speaker": "Student",
      "Text": "あと"
    },
    {
      "Id": 200400350,
      "Speaker": "Student",
      "Text": "私の真の目標のことは"
    },
    {
      "Id": 200400360,
      "Speaker": "Student",
      "Text": "内緒にしてよね"
    },
    {
      "Id": 200400370,
      "Speaker": "Student",
      "Text": "こんな巨大な陰謀"
    },
    {
      "Id": 200400380,
      "Speaker": "Student",
      "Text": "絶対表に出しちゃいけないわ"
    },
    {
      "Id": 200400390,
      "Speaker": "Player",
      "Text": "うん、内緒にするから心配しないで"
    },
    {
      "Id": 200400400,
      "Speaker": "Student",
      "Text": "それじゃ"
    },
    {
      "Id": 200400410,
      "Speaker": "Student",
      "Text": "またね"
    },
    {
      "Id": 200400420,
      "Speaker": "Student",
      "Text": "先生、大変よ"
    },
    {
      "Id": 200400430,
      "Speaker": "Student",
      "Text": "このままじゃ情報部が"
    },
    {
      "Id": 200400440,
      "Speaker": "Student",
      "Text": "いや、もしかしたら"
    },
    {
      "Id": 200400450,
      "Speaker": "Student",
      "Text": "万魔殿全体が崩壊するわ"
    },
    {
      "Id": 200400460,
      "Speaker": "Player",
      "Text": "どういうこと？"
    },
    {
      "Id": 200400470,
      "Speaker": "Player",
      "Text": "サツキ？大丈夫？"
    },
    {
      "Id": 200400480,
      "Speaker": "Student",
      "Text": "くっ"
    },
    {
      "Id": 200400490,
      "Speaker": "Student",
      "Text": "目の前に危険が迫っているわ"
    },
    {
      "Id": 200400500,
      "Speaker": "Student",
      "Text": "でも私は諦めない"
    },
    {
      "Id": 200400510,
      "Speaker": "Player",
      "Text": "サツキ、今どこ？"
    },
    {
      "Id": 200400520,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ここは……"
    },
    {
      "Id": 200400530,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 200400540,
      "Speaker": "Student",
      "Text": "あんなものよく耐えられたわね"
    },
    {
      "Id": 200400550,
      "Speaker": "Student",
      "Text": "やっぱりこの世界にはNKウルトラ計画が必要だわ"
    },
    {
      "Id": 200400560,
      "Speaker": "Student",
      "Text": "予防接種なんて要らない世界を作ってやるんだから"
    },
    {
      "Id": 200400570,
      "Speaker": "Student",
      "Text": "こんな風に誰かが苦しまないようにね"
    },
    {
      "Id": 200400580,
      "Speaker": "Player",
      "Text": "もっと大きな苦しみを作ってしまうんじゃ……"
    },
    {
      "Id": 200400590,
      "Speaker": "Student",
      "Text": "とにかく"
    },
    {
      "Id": 200400600,
      "Speaker": "Student",
      "Text": "今日は助かったわ"
    },
    {
      "Id": 200400610,
      "Speaker": "Student",
      "Text": "こんにちは、先生"
    },
    {
      "Id": 200400620,
      "Speaker": "Student",
      "Text": "今日は私が当番よ"
    },
    {
      "Id": 200400630,
      "Speaker": "Player",
      "Text": "気をつけて来てね、サツキ"
    },
    {
      "Id": 200400640,
      "Speaker": "Student",
      "Text": "万魔殿の予備協力者であり"
    },
    {
      "Id": 200400650,
      "Speaker": "Student",
      "Text": "ライバルでもある先生を"
    },
    {
      "Id": 200400660,
      "Speaker": "Student",
      "Text": "近くでじーっくりと観察できる"
    },
    {
      "Id": 200400670,
      "Speaker": "Student",
      "Text": "絶好の機会よ"
    },
    {
      "Id": 200400680,
      "Speaker": "Player",
      "Text": "そういうのって普通ひとりごとで言わない……？"
    },
    {
      "Id": 200400690,
      "Speaker": "Student",
      "Text": "待ってて頂戴"
    },
    {
      "Id": 200400700,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "今から向かうわ！"
    }
  ],
  "DialogKR": [
    {
      "Id": 200400010,
      "Speaker": "Student",
      "Text": "선생~"
    },
    {
      "Id": 200400020,
      "Speaker": "Student",
      "Text": "만마전의 협력자로서"
    },
    {
      "Id": 200400030,
      "Speaker": "Student",
      "Text": "이번 일도 협조해줘"
    },
    {
      "Id": 200400040,
      "Speaker": "Player",
      "Text": "사츠키……?"
    },
    {
      "Id": 200400050,
      "Speaker": "Player",
      "Text": "무슨 말이야?"
    },
    {
      "Id": 200400060,
      "Speaker": "Student",
      "Text": "이건 만나서 설명하는 편이 낫겠네"
    },
    {
      "Id": 200400070,
      "Speaker": "Student",
      "Text": "해두고 싶은 말도 있고"
    },
    {
      "Id": 200400080,
      "Speaker": "Student",
      "Text": "지금 샬레로 갈게~!"
    },
    {
      "Id": 200400090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "저기요?!"
    },
    {
      "Id": 200400100,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 200400110,
      "Speaker": "Student",
      "Text": "오늘은 다른 방법을"
    },
    {
      "Id": 200400120,
      "Speaker": "Student",
      "Text": "시험해 볼 생각이야"
    },
    {
      "Id": 200400130,
      "Speaker": "Student",
      "Text": "샬레에 있지?"
    },
    {
      "Id": 200400140,
      "Speaker": "Player",
      "Text": "으응……?"
    },
    {
      "Id": 200400150,
      "Speaker": "Player",
      "Text": "그렇긴 한데……"
    },
    {
      "Id": 200400160,
      "Speaker": "Student",
      "Text": "그럼 그대로 있어"
    },
    {
      "Id": 200400170,
      "Speaker": "Student",
      "Text": "지금 갈게~!"
    },
    {
      "Id": 200400180,
      "Speaker": "Player",
      "Text": "사츠키……?"
    },
    {
      "Id": 200400190,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "저기요?!"
    },
    {
      "Id": 200400200,
      "Speaker": "Student",
      "Text": "기뻐해, 선생"
    },
    {
      "Id": 200400210,
      "Speaker": "Player",
      "Text": "와하하핫!"
    },
    {
      "Id": 200400220,
      "Speaker": "Student",
      "Text": "후후, 소식을 듣기도 전에"
    },
    {
      "Id": 200400230,
      "Speaker": "Student",
      "Text": "그렇게나 좋아하다니"
    },
    {
      "Id": 200400240,
      "Speaker": "Student",
      "Text": "무슨 일인지 궁금하지?"
    },
    {
      "Id": 200400250,
      "Speaker": "Player",
      "Text": "안 좋은 예감이……"
    },
    {
      "Id": 200400260,
      "Speaker": "Student",
      "Text": "선생을 대상으로"
    },
    {
      "Id": 200400270,
      "Speaker": "Student",
      "Text": "음, 이건 만나서 말하는 편이 낫겠네"
    },
    {
      "Id": 200400280,
      "Speaker": "Student",
      "Text": "지금 갈게~!"
    },
    {
      "Id": 200400290,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "사츠키……?"
    },
    {
      "Id": 200400300,
      "Speaker": "Student",
      "Text": "선생의 명령대로 돌아와서 푹 쉬어버렸어"
    },
    {
      "Id": 200400310,
      "Speaker": "Student",
      "Text": "이제 최면은 풀린 것 같고"
    },
    {
      "Id": 200400320,
      "Speaker": "Student",
      "Text": "정말 방심해서는 안 되겠어"
    },
    {
      "Id": 200400330,
      "Speaker": "Player",
      "Text": "무사히 돌아갔다니 다행이야."
    },
    {
      "Id": 200400340,
      "Speaker": "Student",
      "Text": "그리고"
    },
    {
      "Id": 200400350,
      "Speaker": "Student",
      "Text": "내 진정한 목표에 대해서는"
    },
    {
      "Id": 200400360,
      "Speaker": "Student",
      "Text": "비밀을 지켜줘"
    },
    {
      "Id": 200400370,
      "Speaker": "Student",
      "Text": "이런 거대한 음모는"
    },
    {
      "Id": 200400380,
      "Speaker": "Student",
      "Text": "무조건 비밀리에 진행해야 하니까"
    },
    {
      "Id": 200400390,
      "Speaker": "Player",
      "Text": "비밀로 할게. 걱정 마."
    },
    {
      "Id": 200400400,
      "Speaker": "Student",
      "Text": "좋아"
    },
    {
      "Id": 200400410,
      "Speaker": "Student",
      "Text": "그럼 나중에 또~"
    },
    {
      "Id": 200400420,
      "Speaker": "Student",
      "Text": "선생, 큰일이야"
    },
    {
      "Id": 200400430,
      "Speaker": "Student",
      "Text": "이대로라면 정보부"
    },
    {
      "Id": 200400440,
      "Speaker": "Student",
      "Text": "아니, 더 나아가서"
    },
    {
      "Id": 200400450,
      "Speaker": "Student",
      "Text": "만마전 자체가 붕괴해 버려"
    },
    {
      "Id": 200400460,
      "Speaker": "Player",
      "Text": "무슨 말이야?"
    },
    {
      "Id": 200400470,
      "Speaker": "Player",
      "Text": "사츠키? 괜찮아?"
    },
    {
      "Id": 200400480,
      "Speaker": "Student",
      "Text": "크윽"
    },
    {
      "Id": 200400490,
      "Speaker": "Student",
      "Text": "위기가 눈앞까지 닥쳐왔어"
    },
    {
      "Id": 200400500,
      "Speaker": "Student",
      "Text": "하지만 끝까지 발버둥 쳐주지"
    },
    {
      "Id": 200400510,
      "Speaker": "Player",
      "Text": "사츠키, 어디야?"
    },
    {
      "Id": 200400520,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "여기는……"
    },
    {
      "Id": 200400530,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 200400540,
      "Speaker": "Student",
      "Text": "그 끔찍한 주사를 잘도 참아내던데"
    },
    {
      "Id": 200400550,
      "Speaker": "Student",
      "Text": "역시 이 세계에는 NK 울트라 프로젝트가 필요해"
    },
    {
      "Id": 200400560,
      "Speaker": "Student",
      "Text": "난 예방접종 따위 하지 않는 세상을 만들 거야"
    },
    {
      "Id": 200400570,
      "Speaker": "Student",
      "Text": "아무도 이렇게 고통받지 않도록"
    },
    {
      "Id": 200400580,
      "Speaker": "Player",
      "Text": "더 큰 고통을 방치하게 되는 거 아닌가……"
    },
    {
      "Id": 200400590,
      "Speaker": "Student",
      "Text": "어쨌든"
    },
    {
      "Id": 200400600,
      "Speaker": "Student",
      "Text": "덕분에 도움이 됐어 오늘"
    },
    {
      "Id": 200400610,
      "Speaker": "Student",
      "Text": "안녕, 선생"
    },
    {
      "Id": 200400620,
      "Speaker": "Student",
      "Text": "오늘 당번은 나야."
    },
    {
      "Id": 200400630,
      "Speaker": "Player",
      "Text": "조심히 와, 사츠키."
    },
    {
      "Id": 200400640,
      "Speaker": "Student",
      "Text": "만마전의 예비 협력자이자"
    },
    {
      "Id": 200400650,
      "Speaker": "Student",
      "Text": "경쟁자인 선생을"
    },
    {
      "Id": 200400660,
      "Speaker": "Student",
      "Text": "가까이에서 면밀하게 관찰할 수 있는"
    },
    {
      "Id": 200400670,
      "Speaker": "Student",
      "Text": "좋은 기회지"
    },
    {
      "Id": 200400680,
      "Speaker": "Player",
      "Text": "보통 그런 건 혼잣말로 하지 않아?"
    },
    {
      "Id": 200400690,
      "Speaker": "Student",
      "Text": "조금만 기다려"
    },
    {
      "Id": 200400700,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "지금 갈게~!"
    }
  ],
  "DialogEN": [
    {
      "Id": 200400010,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 200400020,
      "Speaker": "Student",
      "Text": "As Pandemonium Society's partner,"
    },
    {
      "Id": 200400030,
      "Speaker": "Student",
      "Text": "please cooperate with me again."
    },
    {
      "Id": 200400040,
      "Speaker": "Player",
      "Text": "Satsuki...?"
    },
    {
      "Id": 200400050,
      "Speaker": "Player",
      "Text": "What does that mean?"
    },
    {
      "Id": 200400060,
      "Speaker": "Student",
      "Text": "It's best to explain this in person."
    },
    {
      "Id": 200400070,
      "Speaker": "Student",
      "Text": "And there's another issue I wanted to inform you of as well."
    },
    {
      "Id": 200400080,
      "Speaker": "Student",
      "Text": "I'll head over to Schale right now!"
    },
    {
      "Id": 200400090,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "Excuse me?!"
    },
    {
      "Id": 200400100,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 200400110,
      "Speaker": "Student",
      "Text": "I'm going to be testing"
    },
    {
      "Id": 200400120,
      "Speaker": "Student",
      "Text": "a different method today"
    },
    {
      "Id": 200400130,
      "Speaker": "Student",
      "Text": "You're at Schale, right?"
    },
    {
      "Id": 200400140,
      "Speaker": "Player",
      "Text": "Huh...?"
    },
    {
      "Id": 200400150,
      "Speaker": "Player",
      "Text": "I am, but..."
    },
    {
      "Id": 200400160,
      "Speaker": "Student",
      "Text": "Then stay right there."
    },
    {
      "Id": 200400170,
      "Speaker": "Student",
      "Text": "I'll be there soon!"
    },
    {
      "Id": 200400180,
      "Speaker": "Player",
      "Text": "Satsuki...?"
    },
    {
      "Id": 200400190,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "Huh?!"
    },
    {
      "Id": 200400200,
      "Speaker": "Student",
      "Text": "Rejoice, Sensei!"
    },
    {
      "Id": 200400210,
      "Speaker": "Player",
      "Text": "Wahahaha!"
    },
    {
      "Id": 200400220,
      "Speaker": "Student",
      "Text": "Fufu, you're so happy,"
    },
    {
      "Id": 200400230,
      "Speaker": "Student",
      "Text": "and you haven't even heard the details yet."
    },
    {
      "Id": 200400240,
      "Speaker": "Student",
      "Text": "You're curious, right?"
    },
    {
      "Id": 200400250,
      "Speaker": "Player",
      "Text": "I have a bad feeling..."
    },
    {
      "Id": 200400260,
      "Speaker": "Student",
      "Text": "With you as the target"
    },
    {
      "Id": 200400270,
      "Speaker": "Student",
      "Text": "Um, actually, I think I should explain in person"
    },
    {
      "Id": 200400280,
      "Speaker": "Student",
      "Text": "I'll be there soon!"
    },
    {
      "Id": 200400290,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "Satsuki...?"
    },
    {
      "Id": 200400300,
      "Speaker": "Student",
      "Text": "I rested for a long time, as you told me to."
    },
    {
      "Id": 200400310,
      "Speaker": "Student",
      "Text": "It seems the fearsome power of the hypnosis has finally worn off."
    },
    {
      "Id": 200400320,
      "Speaker": "Student",
      "Text": "I really can't let my guard down"
    },
    {
      "Id": 200400330,
      "Speaker": "Player",
      "Text": "I'm glad you made it back safely."
    },
    {
      "Id": 200400340,
      "Speaker": "Student",
      "Text": "Also"
    },
    {
      "Id": 200400350,
      "Speaker": "Student",
      "Text": "regarding my true goal"
    },
    {
      "Id": 200400360,
      "Speaker": "Student",
      "Text": "please keep it secret"
    },
    {
      "Id": 200400370,
      "Speaker": "Student",
      "Text": "A detailed plot like this"
    },
    {
      "Id": 200400380,
      "Speaker": "Student",
      "Text": "must be carried out clandestinely."
    },
    {
      "Id": 200400390,
      "Speaker": "Player",
      "Text": "I'll keep it a secret. Don't worry."
    },
    {
      "Id": 200400400,
      "Speaker": "Student",
      "Text": "Good"
    },
    {
      "Id": 200400410,
      "Speaker": "Student",
      "Text": "Later then!"
    },
    {
      "Id": 200400420,
      "Speaker": "Student",
      "Text": "Sensei, there's a problem of enormous proportions."
    },
    {
      "Id": 200400430,
      "Speaker": "Student",
      "Text": "At this rate, the Intelligence Committee"
    },
    {
      "Id": 200400440,
      "Speaker": "Student",
      "Text": "no, even worse..."
    },
    {
      "Id": 200400450,
      "Speaker": "Student",
      "Text": "the Pandemonium Society itself will crumble!!!"
    },
    {
      "Id": 200400460,
      "Speaker": "Player",
      "Text": "What does that mean?"
    },
    {
      "Id": 200400470,
      "Speaker": "Player",
      "Text": "Satsuki? You okay?"
    },
    {
      "Id": 200400480,
      "Speaker": "Student",
      "Text": "Tch"
    },
    {
      "Id": 200400490,
      "Speaker": "Student",
      "Text": "The crisis knocks upon our doors!"
    },
    {
      "Id": 200400500,
      "Speaker": "Student",
      "Text": "But I'll fight until the end!"
    },
    {
      "Id": 200400510,
      "Speaker": "Player",
      "Text": "Satsuki, where are you?"
    },
    {
      "Id": 200400520,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Where I am is..."
    },
    {
      "Id": 200400530,
      "Speaker": "Student",
      "Text": "Sensei"
    },
    {
      "Id": 200400540,
      "Speaker": "Student",
      "Text": "You really endured that shot"
    },
    {
      "Id": 200400550,
      "Speaker": "Student",
      "Text": "This world desperately needs the NK Ultra Project"
    },
    {
      "Id": 200400560,
      "Speaker": "Student",
      "Text": "I'm going to make a world where something like vaccines don't exist"
    },
    {
      "Id": 200400570,
      "Speaker": "Student",
      "Text": "So that no one suffers like this anymore"
    },
    {
      "Id": 200400580,
      "Speaker": "Player",
      "Text": "That would make people suffer even more, though..."
    },
    {
      "Id": 200400590,
      "Speaker": "Student",
      "Text": "Anyways"
    },
    {
      "Id": 200400600,
      "Speaker": "Student",
      "Text": "That helped today"
    },
    {
      "Id": 200400610,
      "Speaker": "Student",
      "Text": "Hi, Sensei"
    },
    {
      "Id": 200400620,
      "Speaker": "Student",
      "Text": "I will be serving as Student Rep today."
    },
    {
      "Id": 200400630,
      "Speaker": "Player",
      "Text": "Be careful on your way here, Satsuki."
    },
    {
      "Id": 200400640,
      "Speaker": "Student",
      "Text": "It's a good opportunity to"
    },
    {
      "Id": 200400650,
      "Speaker": "Student",
      "Text": "observe Sensei closely,"
    },
    {
      "Id": 200400660,
      "Speaker": "Student",
      "Text": "the Pandemonium Society's future partner"
    },
    {
      "Id": 200400670,
      "Speaker": "Student",
      "Text": "and competitor"
    },
    {
      "Id": 200400680,
      "Speaker": "Player",
      "Text": "Wouldn't it be smart to keep that to yourself?"
    },
    {
      "Id": 200400690,
      "Speaker": "Student",
      "Text": "Wait right there"
    },
    {
      "Id": 200400700,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "I'll be there soon!"
    }
  ],
  "DialogTH": [
