{
  "CharacterId": 10151,
  "DialogJP": [
    {
      "Id": 101510010,
      "Speaker": "Student",
      "Text": "こんにちは、先生"
    },
    {
      "Id": 101510020,
      "Speaker": "Student",
      "Text": "183号特別クラス学級委員長の仁木アンナです"
    },
    {
      "Id": 101510030,
      "Speaker": "Student",
      "Text": "覚えていますか？"
    },
    {
      "Id": 101510040,
      "Speaker": "Student",
      "Text": "アカデミー主席活動会員で、連邦名誉発明家の……"
    },
    {
      "Id": 101510050,
      "Speaker": "Player",
      "Text": "こんにちは、アンナ！"
    },
    {
      "Id": 101510060,
      "Speaker": "Player",
      "Text": "もちろん覚えてるよ！"
    },
    {
      "Id": 101510070,
      "Speaker": "Student",
      "Text": "ありがとうございます！"
    },
    {
      "Id": 101510080,
      "Speaker": "Student",
      "Text": "実は興味深い論文がありまして"
    },
    {
      "Id": 101510090,
      "Speaker": "Student",
      "Text": "子犬たちはお互いに甘噛みをして遊びながら"
    },
    {
      "Id": 101510100,
      "Speaker": "Student",
      "Text": "痛みを学習するのだそうです"
    },
    {
      "Id": 101510110,
      "Speaker": "Student",
      "Text": "そうしないと攻撃的になってしまうのだとか！"
    },
    {
      "Id": 101510120,
      "Speaker": "Student",
      "Text": "社会化の重要なプロセスというわけですね"
    },
    {
      "Id": 101510130,
      "Speaker": "Player",
      "Text": "確かに興味深いね！"
    },
    {
      "Id": 101510140,
      "Speaker": "Student",
      "Text": "子犬の写真もたくさんあって可愛いですよ"
    },
    {
      "Id": 101510150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "一緒に読みませんか？"
    },
    {
      "Id": 101510160,
      "Speaker": "Student",
      "Text": "先生、ご協力ありがとうございます！"
    },
    {
      "Id": 101510170,
      "Speaker": "Student",
      "Text": "おかげさまで、十分な研究データが揃いました"
    },
    {
      "Id": 101510180,
      "Speaker": "Student",
      "Text": "適切な力加減が分かってきた気がします"
    },
    {
      "Id": 101510190,
      "Speaker": "Student",
      "Text": "お忙しいところ時間を割いていただき、感謝します"
    },
    {
      "Id": 101510200,
      "Speaker": "Player",
      "Text": "友達のために、アンナはえらいね！"
    },
    {
      "Id": 101510210,
      "Speaker": "Player",
      "Text": "先生として当然だよ！"
    },
    {
      "Id": 101510220,
      "Speaker": "Student",
      "Text": "と、友達のためではありません！"
    },
    {
      "Id": 101510230,
      "Speaker": "Student",
      "Text": "ケガをさせたら、ルール違反になってしまうので……"
    },
    {
      "Id": 101510240,
      "Speaker": "Student",
      "Text": "でも……"
    },
    {
      "Id": 101510250,
      "Speaker": "Student",
      "Text": "温かいお言葉、ありがとうございます"
    },
    {
      "Id": 101510260,
      "Speaker": "Student",
      "Text": "では、また！"
    },
    {
      "Id": 101510270,
      "Speaker": "Student",
      "Text": "こんにちは、仁木アンナです"
    },
    {
      "Id": 101510280,
      "Speaker": "Student",
      "Text": "先生は今、お一人ですか？"
    },
    {
      "Id": 101510290,
      "Speaker": "Player",
      "Text": "こんにちは！うん、一人だよ"
    },
    {
      "Id": 101510300,
      "Speaker": "Student",
      "Text": "では、そのまま一人で読み続けていてください"
    },
    {
      "Id": 101510310,
      "Speaker": "Student",
      "Text": "実は、とんでもない大発明をしてしまいまして……"
    },
    {
      "Id": 101510320,
      "Speaker": "Student",
      "Text": "ピアレビューをお願いしてもいいですか？"
    },
    {
      "Id": 101510330,
      "Speaker": "Player",
      "Text": "役に立てることがあるなら、もちろん！"
    },
    {
      "Id": 101510340,
      "Speaker": "Student",
      "Text": "助かります！では183号で"
    },
    {
      "Id": 101510350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "絶対に！他言無用、ですよ！"
    },
    {
      "Id": 101510360,
      "Speaker": "Student",
      "Text": "先生……"
    },
    {
      "Id": 101510370,
      "Speaker": "Player",
      "Text": "少しは落ち着いた？"
    },
    {
      "Id": 101510380,
      "Speaker": "Student",
      "Text": "ええ……ありがとうございます"
    },
    {
      "Id": 101510390,
      "Speaker": "Student",
      "Text": "閉所恐怖症ではないんですが"
    },
    {
      "Id": 101510400,
      "Speaker": "Student",
      "Text": "先生に会えなくなると思うと、怖かったです……"
    },
    {
      "Id": 101510410,
      "Speaker": "Player",
      "Text": "でも大発明だったね！"
    },
    {
      "Id": 101510420,
      "Speaker": "Student",
      "Text": "いえ、実はテストを続けていたら……"
    },
    {
      "Id": 101510430,
      "Speaker": "Student",
      "Text": "とけはしないんですが、湿度が低いと壊れてしまうことが分かりました"
    },
    {
      "Id": 101510440,
      "Speaker": "Student",
      "Text": "なので、病棟の増築には使えません……"
    },
    {
      "Id": 101510450,
      "Speaker": "Student",
      "Text": "残念ですが、別のものを考えようかと"
    },
    {
      "Id": 101510460,
      "Speaker": "Player",
      "Text": "元気出して！私も手伝うから！"
    },
    {
      "Id": 101510470,
      "Speaker": "Player",
      "Text": "諦めずに人助けをしようとして偉いね！"
    },
    {
      "Id": 101510480,
      "Speaker": "Student",
      "Text": "ありがとうございます、先生！"
    },
    {
      "Id": 101510490,
      "Speaker": "Student",
      "Text": "仮設建築物を作る分には問題ないので"
    },
    {
      "Id": 101510500,
      "Speaker": "Student",
      "Text": "アンナクリートもどこかで役に立てると思います"
    },
    {
      "Id": 101510510,
      "Speaker": "Student",
      "Text": "えへへ！"
    },
    {
      "Id": 101510520,
      "Speaker": "Student",
      "Text": "先生、仁木アンナです"
    },
    {
      "Id": 101510530,
      "Speaker": "Student",
      "Text": "業務と関係ないお話なのですが――"
    },
    {
      "Id": 101510540,
      "Speaker": "Student",
      "Text": "バーベキューパーティーをしたことはありますか？"
    },
    {
      "Id": 101510550,
      "Speaker": "Player",
      "Text": "うん！"
    },
    {
      "Id": 101510560,
      "Speaker": "Player",
      "Text": "いや、したことないよ！"
    },
    {
      "Id": 101510570,
      "Speaker": "Student",
      "Text": "実はバーベキューパーティーをしたくなったのですが"
    },
    {
      "Id": 101510580,
      "Speaker": "Student",
      "Text": "一緒にいかがですか？"
    },
    {
      "Id": 101510590,
      "Speaker": "Player",
      "Text": "是非よろしく！"
    },
    {
      "Id": 101510600,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "よかったです！では183号で"
    },
    {
      "Id": 101510610,
      "Speaker": "Student",
      "Text": "先生、あの時のことですが……"
    },
    {
      "Id": 101510620,
      "Speaker": "Student",
      "Text": "変な風には、受け取らないでくださいね！"
    },
    {
      "Id": 101510630,
      "Speaker": "Student",
      "Text": "褒められると、いい気になって……"
    },
    {
      "Id": 101510640,
      "Speaker": "Student",
      "Text": "甘ったれるかもしれないってだけです！"
    },
    {
      "Id": 101510650,
      "Speaker": "Student",
      "Text": "先生に頼りきりになるかもしれません！"
    },
    {
      "Id": 101510660,
      "Speaker": "Student",
      "Text": "それじゃダメですよね"
    },
    {
      "Id": 101510670,
      "Speaker": "Player",
      "Text": "変な風には思っていなかったけど"
    },
    {
      "Id": 101510680,
      "Speaker": "Player",
      "Text": "生徒なら甘えてもいいんだよ"
    },
    {
      "Id": 101510690,
      "Speaker": "Player",
      "Text": "アンナ？"
    },
    {
      "Id": 101510700,
      "Speaker": "Student",
      "Text": "先生、お聞きしたいことがあります"
    },
    {
      "Id": 101510710,
      "Speaker": "Student",
      "Text": "シャーレに業務の協力を依頼したいのですが"
    },
    {
      "Id": 101510720,
      "Speaker": "Student",
      "Text": "どこに問い合わせればいいのか……"
    },
    {
      "Id": 101510730,
      "Speaker": "Student",
      "Text": "そもそも、問い合わせていいのでしょうか？"
    },
    {
      "Id": 101510740,
      "Speaker": "Student",
      "Text": "それに、問い合わせるにしたってどこに……"
    },
    {
      "Id": 101510750,
      "Speaker": "Student",
      "Text": "あ……"
    },
    {
      "Id": 101510760,
      "Speaker": "Player",
      "Text": "アンナ？"
    },
    {
      "Id": 101510770,
      "Speaker": "Student",
      "Text": "すみません、先生。業務連絡にはまだ慣れてなくて……"
    },
    {
      "Id": 101510780,
      "Speaker": "Student",
      "Text": "緊張しちゃってるみたいです"
    },
    {
      "Id": 101510790,
      "Speaker": "Student",
      "Text": "先生に協力を依頼したいのですが"
    },
    {
      "Id": 101510800,
      "Speaker": "Student",
      "Text": "どこで先生にお願いしたらいいのか"
    },
    {
      "Id": 101510810,
      "Speaker": "Student",
      "Text": "先生にお聞きしてもよろしいでしょうか？"
    },
    {
      "Id": 101510820,
      "Speaker": "Student",
      "Text": "うあああ……ダメだぁ……"
    },
    {
      "Id": 101510830,
      "Speaker": "Player",
      "Text": "業務連絡って難しいよね"
    },
    {
      "Id": 101510840,
      "Speaker": "Player",
      "Text": "心配しないで。何でも手伝うから！"
    },
    {
      "Id": 101510850,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ありがとうございます……"
    },
    {
      "Id": 101510860,
      "Speaker": "Student",
      "Text": "資料の片付け、手伝っていただきありがとうございます！"
    },
    {
      "Id": 101510870,
      "Speaker": "Student",
      "Text": "おかげですっきり整理できました"
    },
    {
      "Id": 101510880,
      "Speaker": "Student",
      "Text": "……ほんとに、いろんな意味で"
    },
    {
      "Id": 101510890,
      "Speaker": "Student",
      "Text": "見違えるほど綺麗になったので、資料を追加するのは気が引けますね"
    },
    {
      "Id": 101510900,
      "Speaker": "Player",
      "Text": "新しいものもどんどん増やしていこう！"
    },
    {
      "Id": 101510910,
      "Speaker": "Player",
      "Text": "きっとどれも楽しいはずだよ！"
    },
    {
      "Id": 101510920,
      "Speaker": "Student",
      "Text": "あっ"
    },
    {
      "Id": 101510930,
      "Speaker": "Student",
      "Text": "はい！"
    },
    {
      "Id": 101510940,
      "Speaker": "Student",
      "Text": "たしかに、そうですね！"
    },
    {
      "Id": 101510950,
      "Speaker": "Student",
      "Text": "これからもよろしくお願いします、先生！"
    }
  ],
  "DialogKR": [
    {
      "Id": 101510010,
      "Speaker": "Student",
      "Text": "선생님, 안녕하세요."
    },
    {
      "Id": 101510020,
      "Speaker": "Student",
      "Text": "183호 특별반 반장, 니키 안나입니다."
    },
    {
      "Id": 101510030,
      "Speaker": "Student",
      "Text": "아, 혹시 기억나지 않으신다면,"
    },
    {
      "Id": 101510040,
      "Speaker": "Student",
      "Text": "아카데미 수석 활동 회원, 연방 명예 발명가에……"
    },
    {
      "Id": 101510050,
      "Speaker": "Player",
      "Text": "안녕, 안나!"
    },
    {
      "Id": 101510060,
      "Speaker": "Player",
      "Text": "잊을 리가 없지!"
    },
    {
      "Id": 101510070,
      "Speaker": "Student",
      "Text": "기억해 주셨군요, 감사합니다!"
    },
    {
      "Id": 101510080,
      "Speaker": "Student",
      "Text": "다름이 아니라, 흥미로운 논문을 읽었어요."
    },
    {
      "Id": 101510090,
      "Speaker": "Student",
      "Text": "어린 강아지들은 서로 물고 놀잖아요?"
    },
    {
      "Id": 101510100,
      "Speaker": "Student",
      "Text": "그러면서 '아파!'라고 알게 되는 거래요."
    },
    {
      "Id": 101510110,
      "Speaker": "Student",
      "Text": "그렇지 않으면 공격적인 성향이 된다고 하더라고요!"
    },
    {
      "Id": 101510120,
      "Speaker": "Student",
      "Text": "사회화의 중요한 과정인 거예요."
    },
    {
      "Id": 101510130,
      "Speaker": "Player",
      "Text": "흥미로운 논문인걸!"
    },
    {
      "Id": 101510140,
      "Speaker": "Student",
      "Text": "강아지 사진도 많아서 재밌었어요."
    },
    {
      "Id": 101510150,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "같이 읽어보실래요?"
    },
    {
      "Id": 101510160,
      "Speaker": "Student",
      "Text": "선생님, 감사합니다!"
    },
    {
      "Id": 101510170,
      "Speaker": "Student",
      "Text": "충분한 연구 데이터를 쌓았어요!"
    },
    {
      "Id": 101510180,
      "Speaker": "Student",
      "Text": "보다 설득력이 올라간 기분이네요!"
    },
    {
      "Id": 101510190,
      "Speaker": "Student",
      "Text": "곤란하셨을 텐데, 어울려주셔서 감사합니다."
    },
    {
      "Id": 101510200,
      "Speaker": "Player",
      "Text": "\"친구를 다치지 않게 하려는 안나, 기특해!\""
    },
    {
      "Id": 101510210,
      "Speaker": "Player",
      "Text": "\"당연히 선생님이 도와줘야지!\""
    },
    {
      "Id": 101510220,
      "Speaker": "Student",
      "Text": "그, 그런 거 아니에요!"
    },
    {
      "Id": 101510230,
      "Speaker": "Student",
      "Text": "진짜 다치게 하면 룰 위반이니까 그런 것뿐이에요!"
    },
    {
      "Id": 101510240,
      "Speaker": "Student",
      "Text": "그래도,"
    },
    {
      "Id": 101510250,
      "Speaker": "Student",
      "Text": "항상 좋게 봐주셔서 감사합니다."
    },
    {
      "Id": 101510260,
      "Speaker": "Student",
      "Text": "다음에 뵙겠습니다!"
    },
    {
      "Id": 101510270,
      "Speaker": "Student",
      "Text": "안녕하세요 선생님, 니키 안나입니다."
    },
    {
      "Id": 101510280,
      "Speaker": "Student",
      "Text": "혹시 지금 핸드폰 혼자 보고 있으신가요?"
    },
    {
      "Id": 101510290,
      "Speaker": "Player",
      "Text": "안녕 안나! 혼자서 보는 중이야."
    },
    {
      "Id": 101510300,
      "Speaker": "Student",
      "Text": "그러면, 계속 혼자서 봐주세요. 다른 게 아니라"
    },
    {
      "Id": 101510310,
      "Speaker": "Student",
      "Text": "엄청난 대발명을 해버렸어요……."
    },
    {
      "Id": 101510320,
      "Speaker": "Student",
      "Text": "괜찮으시다면, 피어리뷰 부탁드려도 될까요?"
    },
    {
      "Id": 101510330,
      "Speaker": "Player",
      "Text": "도움이 될지는 모르겠지만, 물론이지!"
    },
    {
      "Id": 101510340,
      "Speaker": "Student",
      "Text": "감사합니다! 183호에서 뵐게요."
    },
    {
      "Id": 101510350,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "절대로! 아무에게도 말하시면 안 돼요!"
    },
    {
      "Id": 101510360,
      "Speaker": "Student",
      "Text": "선생님……."
    },
    {
      "Id": 101510370,
      "Speaker": "Player",
      "Text": "괜찮아? 좀 진정했어!"
    },
    {
      "Id": 101510380,
      "Speaker": "Student",
      "Text": "네에…… 감사합니다."
    },
    {
      "Id": 101510390,
      "Speaker": "Student",
      "Text": "폐소공포증이 있는 건 아닌데,"
    },
    {
      "Id": 101510400,
      "Speaker": "Student",
      "Text": "선생님을 못 뵙게 되는 건 무서웠어요……."
    },
    {
      "Id": 101510410,
      "Speaker": "Player",
      "Text": "그래도 대발명을 했잖니!"
    },
    {
      "Id": 101510420,
      "Speaker": "Student",
      "Text": "그게, 테스트를 더 해봤는데요,"
    },
    {
      "Id": 101510430,
      "Speaker": "Student",
      "Text": "녹지는 않는데, 습도가 낮으면 승화해서 부서졌어요."
    },
    {
      "Id": 101510440,
      "Speaker": "Student",
      "Text": "그래서, 병원 건설에 도움은 주지 못하게 되었어요."
    },
    {
      "Id": 101510450,
      "Speaker": "Student",
      "Text": "아쉽지만 다른 발명을 생각해 보려고요."
    },
    {
      "Id": 101510460,
      "Speaker": "Player",
      "Text": "기운 내자! 선생님이 도와줄게!"
    },
    {
      "Id": 101510470,
      "Speaker": "Player",
      "Text": "포기하지 않고 남을 도우려는 거, 멋있어!"
    },
    {
      "Id": 101510480,
      "Speaker": "Student",
      "Text": "네! 고마워요, 선생님!"
    },
    {
      "Id": 101510490,
      "Speaker": "Student",
      "Text": "이걸로 임시 가건물 같은 건 만들 수 있을 테니까,"
    },
    {
      "Id": 101510500,
      "Speaker": "Student",
      "Text": "이 발명도, 어떤 식이건 세상에 도움이 될 거예요!"
    },
    {
      "Id": 101510510,
      "Speaker": "Student",
      "Text": "헤헤!"
    },
    {
      "Id": 101510520,
      "Speaker": "Student",
      "Text": "선생님, 니키 안나입니다."
    },
    {
      "Id": 101510530,
      "Speaker": "Student",
      "Text": "업무 관련된 일은 아닙니다만"
    },
    {
      "Id": 101510540,
      "Speaker": "Student",
      "Text": "혹시 바비큐 파티 가보신 적 있으신가요?"
    },
    {
      "Id": 101510550,
      "Speaker": "Player",
      "Text": "응!"
    },
    {
      "Id": 101510560,
      "Speaker": "Player",
      "Text": "아니, 안 가봤어!"
    },
    {
      "Id": 101510570,
      "Speaker": "Student",
      "Text": "그렇군요! 다름이 아니라, 이번에 해보고 싶어져서요."
    },
    {
      "Id": 101510580,
      "Speaker": "Student",
      "Text": "같이 바비큐 파티 어떠세요?"
    },
    {
      "Id": 101510590,
      "Speaker": "Player",
      "Text": "좋아!"
    },
    {
      "Id": 101510600,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "좋아요! 그럼 183호에서 뵐게요!"
    },
    {
      "Id": 101510610,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 101510620,
      "Speaker": "Student",
      "Text": "이상하게 이해한 거 아니시죠?!"
    },
    {
      "Id": 101510630,
      "Speaker": "Student",
      "Text": "칭찬받으면 그러니까, 약간 저 기고만장하니까요!"
    },
    {
      "Id": 101510640,
      "Speaker": "Student",
      "Text": "그래서 버릇없어지고, 응석 부릴 수 있다는 그런 뜻이에요!"
    },
    {
      "Id": 101510650,
      "Speaker": "Student",
      "Text": "선생님께 기대하는 것도 많아질지도 모르고요!"
    },
    {
      "Id": 101510660,
      "Speaker": "Student",
      "Text": "그러면 안 되는 거니까요! 그렇죠!"
    },
    {
      "Id": 101510670,
      "Speaker": "Player",
      "Text": "딱 그 의미로 이해했는데?"
    },
    {
      "Id": 101510680,
      "Speaker": "Player",
      "Text": "응석 부려도 괜찮아. 학생은 그래도 돼."
    },
    {
      "Id": 101510690,
      "Speaker": "Player",
      "Text": "안나야?"
    },
    {
      "Id": 101510700,
      "Speaker": "Student",
      "Text": "선생님, 문의드릴 게 있어요."
    },
    {
      "Id": 101510710,
      "Speaker": "Student",
      "Text": "샬레와 공무상 협업을 요청드리고 싶은데요."
    },
    {
      "Id": 101510720,
      "Speaker": "Student",
      "Text": "그걸 요청드리는 걸 어디에 문의해야 할지"
    },
    {
      "Id": 101510730,
      "Speaker": "Student",
      "Text": "어, 그러니까 그걸 문의하는 게 가능한지는……."
    },
    {
      "Id": 101510740,
      "Speaker": "Student",
      "Text": "어디에 문의를 드려야"
    },
    {
      "Id": 101510750,
      "Speaker": "Student",
      "Text": "아……."
    },
    {
      "Id": 101510760,
      "Speaker": "Player",
      "Text": "안나?"
    },
    {
      "Id": 101510770,
      "Speaker": "Student",
      "Text": "죄송해요. 선생님. 공무상 연락하는 게 아직 어려워서……."
    },
    {
      "Id": 101510780,
      "Speaker": "Student",
      "Text": "긴장했나 봐요"
    },
    {
      "Id": 101510790,
      "Speaker": "Student",
      "Text": "일단 협업을 요청드리고 싶은데요"
    },
    {
      "Id": 101510800,
      "Speaker": "Student",
      "Text": "그 협업 요청을 어디에 드려야 하는지를"
    },
    {
      "Id": 101510810,
      "Speaker": "Student",
      "Text": "선생님께 여쭤보아도 될까요"
    },
    {
      "Id": 101510820,
      "Speaker": "Student",
      "Text": "으아아아"
    },
    {
      "Id": 101510830,
      "Speaker": "Player",
      "Text": "발신자: 선생님, 도장: 꽝!"
    },
    {
      "Id": 101510840,
      "Speaker": "Player",
      "Text": "걱정 마! 선생님이 도와줄게!"
    },
    {
      "Id": 101510850,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "감사합니다아……."
    },
    {
      "Id": 101510860,
      "Speaker": "Student",
      "Text": "선생님, 감사합니다!"
    },
    {
      "Id": 101510870,
      "Speaker": "Student",
      "Text": "덕분에 정리가 잘 되었어요."
    },
    {
      "Id": 101510880,
      "Speaker": "Student",
      "Text": "이것저것, 여러 가지 의미로요."
    },
    {
      "Id": 101510890,
      "Speaker": "Student",
      "Text": "너무 잘 정리되어서, 새로 뭘 더하는 게 아까울 정도!"
    },
    {
      "Id": 101510900,
      "Speaker": "Player",
      "Text": "새로운 것을 아깝다고 생각하지 말자!"
    },
    {
      "Id": 101510910,
      "Speaker": "Player",
      "Text": "그것들도 분명 즐거울 테니까!"
    },
    {
      "Id": 101510920,
      "Speaker": "Student",
      "Text": "앗,"
    },
    {
      "Id": 101510930,
      "Speaker": "Student",
      "Text": "네!"
    },
    {
      "Id": 101510940,
      "Speaker": "Student",
      "Text": "분명 그럴 거예요."
    },
    {
      "Id": 101510950,
      "Speaker": "Student",
      "Text": "잘 부탁드려요. 선생님."
    }
  ],
