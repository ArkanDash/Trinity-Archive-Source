{
  "CharacterId": 10112,
  "DialogJP": [
    {
      "Id": 101120010,
      "Speaker": "Student",
      "Text": "ご主人様は、よくバス乗るの？"
    },
    {
      "Id": 101120020,
      "Speaker": "Player",
      "Text": "まあまあかな？"
    },
    {
      "Id": 101120030,
      "Speaker": "Student",
      "Text": "私も！"
    },
    {
      "Id": 101120040,
      "Speaker": "Student",
      "Text": "登下校の時に乗ってるんだけど"
    },
    {
      "Id": 101120050,
      "Speaker": "Student",
      "Text": "いつも人が多いんだよね～"
    },
    {
      "Id": 101120060,
      "Speaker": "Player",
      "Text": "たしかに、その時間帯は……"
    },
    {
      "Id": 101120070,
      "Speaker": "Player",
      "Text": "仕方ないかもね……"
    },
    {
      "Id": 101120080,
      "Speaker": "Student",
      "Text": "うんうん"
    },
    {
      "Id": 101120090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "やっぱり大変だよね？"
    },
    {
      "Id": 101120100,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 101120110,
      "Speaker": "Student",
      "Text": "さっき言い忘れちゃったんだけど"
    },
    {
      "Id": 101120120,
      "Speaker": "Student",
      "Text": "先生のシャツに、ファンデついちゃってたかも"
    },
    {
      "Id": 101120130,
      "Speaker": "Player",
      "Text": "あ、本当だ"
    },
    {
      "Id": 101120140,
      "Speaker": "Player",
      "Text": "あれだけ密着してたら……"
    },
    {
      "Id": 101120150,
      "Speaker": "Student",
      "Text": "ごめんね、私のせいで"
    },
    {
      "Id": 101120160,
      "Speaker": "Student",
      "Text": "学校が終わったら、お洗濯してあげる！"
    },
    {
      "Id": 101120170,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 101120180,
      "Speaker": "Student",
      "Text": "それならメイド服に着替えないといけないのかな"
    },
    {
      "Id": 101120190,
      "Speaker": "Student",
      "Text": "制服とメイド服"
    },
    {
      "Id": 101120200,
      "Speaker": "Student",
      "Text": "先生はどっちが好き？"
    },
    {
      "Id": 101120210,
      "Speaker": "Player",
      "Text": "ど、どういう意味！？"
    },
    {
      "Id": 101120220,
      "Speaker": "Student",
      "Text": "そろそろお昼休みだね"
    },
    {
      "Id": 101120230,
      "Speaker": "Student",
      "Text": "もうお腹空いちゃったよ"
    },
    {
      "Id": 101120240,
      "Speaker": "Player",
      "Text": "私はいつでも空いてる……"
    },
    {
      "Id": 101120250,
      "Speaker": "Student",
      "Text": "あははっ"
    },
    {
      "Id": 101120260,
      "Speaker": "Student",
      "Text": "何それ"
    },
    {
      "Id": 101120270,
      "Speaker": "Player",
      "Text": "アスナはお昼何食べるの？"
    },
    {
      "Id": 101120280,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 101120290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "考え中！"
    },
    {
      "Id": 101120300,
      "Speaker": "Student",
      "Text": "そういえば"
    },
    {
      "Id": 101120310,
      "Speaker": "Student",
      "Text": "最近いろんなところで"
    },
    {
      "Id": 101120320,
      "Speaker": "Student",
      "Text": "先生と会う気がする！"
    },
    {
      "Id": 101120330,
      "Speaker": "Player",
      "Text": "そうだね"
    },
    {
      "Id": 101120340,
      "Speaker": "Player",
      "Text": "またどこかで会えるかもね"
    },
    {
      "Id": 101120350,
      "Speaker": "Student",
      "Text": "あははっ"
    },
    {
      "Id": 101120360,
      "Speaker": "Student",
      "Text": "思いがけない出会いって"
    },
    {
      "Id": 101120370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "面白いよね！"
    },
    {
      "Id": 101120380,
      "Speaker": "Student",
      "Text": "公園にいるんだけど"
    },
    {
      "Id": 101120390,
      "Speaker": "Student",
      "Text": "先生にそっくりな雲を見つけたんだ"
    },
    {
      "Id": 101120400,
      "Speaker": "Student",
      "Text": "あははっ"
    },
    {
      "Id": 101120410,
      "Speaker": "Player",
      "Text": "散歩してるの？"
    },
    {
      "Id": 101120420,
      "Speaker": "Student",
      "Text": "うん！"
    },
    {
      "Id": 101120430,
      "Speaker": "Student",
      "Text": "それでね"
    },
    {
      "Id": 101120440,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 101120450,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "アスナ？"
    },
    {
      "Id": 101120460,
      "Speaker": "Student",
      "Text": "せんせ～！"
    },
    {
      "Id": 101120470,
      "Speaker": "Student",
      "Text": "心配してくれてありがとう"
    },
    {
      "Id": 101120480,
      "Speaker": "Student",
      "Text": "それと、スマホも！"
    },
    {
      "Id": 101120490,
      "Speaker": "Player",
      "Text": "見つかって良かったね"
    },
    {
      "Id": 101120500,
      "Speaker": "Student",
      "Text": "うん！"
    },
    {
      "Id": 101120510,
      "Speaker": "Student",
      "Text": "もう落とさないように気をつける"
    },
    {
      "Id": 101120520,
      "Speaker": "Student",
      "Text": "先生が一緒に探してくれたスマホだから！"
    },
    {
      "Id": 101120530,
      "Speaker": "Student",
      "Text": "お家に着いたら眠くなってきちゃった"
    },
    {
      "Id": 101120540,
      "Speaker": "Player",
      "Text": "今日はお疲れ様"
    },
    {
      "Id": 101120550,
      "Speaker": "Player",
      "Text": "おやすみ、アスナ"
    },
    {
      "Id": 101120560,
      "Speaker": "Student",
      "Text": "えへへ"
    },
    {
      "Id": 101120570,
      "Speaker": "Student",
      "Text": "うん、おやすみなさい！"
    }
  ],
  "DialogKR": [
    {
      "Id": 101120010,
      "Speaker": "Student",
      "Text": "주인님은 버스 자주 타?"
    },
    {
      "Id": 101120020,
      "Speaker": "Player",
      "Text": "그럭저럭?"
    },
    {
      "Id": 101120030,
      "Speaker": "Student",
      "Text": "나도나도"
    },
    {
      "Id": 101120040,
      "Speaker": "Student",
      "Text": "등교할 때랑 하교할 때마다 타는데"
    },
    {
      "Id": 101120050,
      "Speaker": "Student",
      "Text": "항상 사람이 많아"
    },
    {
      "Id": 101120060,
      "Speaker": "Player",
      "Text": "그렇지 아무래도……"
    },
    {
      "Id": 101120070,
      "Speaker": "Player",
      "Text": "그 시간대라면……"
    },
    {
      "Id": 101120080,
      "Speaker": "Student",
      "Text": "응응"
    },
    {
      "Id": 101120090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "역시 주인님도 아는구나 그 느낌"
    },
    {
      "Id": 101120100,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 101120110,
      "Speaker": "Student",
      "Text": "내릴 때 깜빡하고 말을 못 했는데"
    },
    {
      "Id": 101120120,
      "Speaker": "Student",
      "Text": "선생님 셔츠에 내 화장품 묻었어"
    },
    {
      "Id": 101120130,
      "Speaker": "Player",
      "Text": "아, 정말이네"
    },
    {
      "Id": 101120140,
      "Speaker": "Player",
      "Text": "역시 너무 가까웠나……"
    },
    {
      "Id": 101120150,
      "Speaker": "Student",
      "Text": "미안~ 내가 너무 기대느라"
    },
    {
      "Id": 101120160,
      "Speaker": "Student",
      "Text": "그거 아스나가 세탁해 줄게"
    },
    {
      "Id": 101120170,
      "Speaker": "Student",
      "Text": "앗 그런데"
    },
    {
      "Id": 101120180,
      "Speaker": "Student",
      "Text": "그러려면 메이드복을 입어야 하는"
    },
    {
      "Id": 101120190,
      "Speaker": "Student",
      "Text": "흠"
    },
    {
      "Id": 101120200,
      "Speaker": "Student",
      "Text": "교복이 좋아 메이드복이 좋아?"
    },
    {
      "Id": 101120210,
      "Speaker": "Player",
      "Text": "무슨 의미인지 모르겠어……"
    },
    {
      "Id": 101120220,
      "Speaker": "Student",
      "Text": "곧 점심시간이네"
    },
    {
      "Id": 101120230,
      "Speaker": "Student",
      "Text": "이때쯤이면 배가 고파져"
    },
    {
      "Id": 101120240,
      "Speaker": "Player",
      "Text": "나는 항상 고픈데……"
    },
    {
      "Id": 101120250,
      "Speaker": "Student",
      "Text": "아하하"
    },
    {
      "Id": 101120260,
      "Speaker": "Student",
      "Text": "뭐야 그게"
    },
    {
      "Id": 101120270,
      "Speaker": "Player",
      "Text": "아스나는 점심 뭐 먹어?"
    },
    {
      "Id": 101120280,
      "Speaker": "Student",
      "Text": "음~ 글쎄"
    },
    {
      "Id": 101120290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "고민 중!!"
    },
    {
      "Id": 101120300,
      "Speaker": "Student",
      "Text": "그러고 보니"
    },
    {
      "Id": 101120310,
      "Speaker": "Student",
      "Text": "요즘 여기저기서"
    },
    {
      "Id": 101120320,
      "Speaker": "Student",
      "Text": "선생님이랑 마주치는 것 같지 않아?"
    },
    {
      "Id": 101120330,
      "Speaker": "Player",
      "Text": "그러게 말야"
    },
    {
      "Id": 101120340,
      "Speaker": "Player",
      "Text": "어디서 마주칠지 예상이 안 돼"
    },
    {
      "Id": 101120350,
      "Speaker": "Student",
      "Text": "아하하"
    },
    {
      "Id": 101120360,
      "Speaker": "Student",
      "Text": "예상치 못한 만남이라"
    },
    {
      "Id": 101120370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "더 재미있지~!"
    },
    {
      "Id": 101120380,
      "Speaker": "Student",
      "Text": "지금 언덕 공원인데"
    },
    {
      "Id": 101120390,
      "Speaker": "Student",
      "Text": "선생님이랑 닮은 구름 있어"
    },
    {
      "Id": 101120400,
      "Speaker": "Student",
      "Text": "아하하"
    },
    {
      "Id": 101120410,
      "Speaker": "Player",
      "Text": "아스나는 산책 중?"
    },
    {
      "Id": 101120420,
      "Speaker": "Student",
      "Text": "응응"
    },
    {
      "Id": 101120430,
      "Speaker": "Student",
      "Text": "어"
    },
    {
      "Id": 101120440,
      "Speaker": "Player",
      "Text": "아스나, 별일 없지?"
    },
    {
      "Id": 101120450,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "아스나?"
    },
    {
      "Id": 101120460,
      "Speaker": "Student",
      "Text": "선생님~!"
    },
    {
      "Id": 101120470,
      "Speaker": "Student",
      "Text": "오늘 아스나 찾으러 와줘서 고마워"
    },
    {
      "Id": 101120480,
      "Speaker": "Student",
      "Text": "핸드폰도 같이 찾아줘서 고마워"
    },
    {
      "Id": 101120490,
      "Speaker": "Player",
      "Text": "응, 이렇게 모모톡 할 수 있어서 다행이야"
    },
    {
      "Id": 101120500,
      "Speaker": "Student",
      "Text": "맞아맞아"
    },
    {
      "Id": 101120510,
      "Speaker": "Student",
      "Text": "이제 안 잃어버리게 조심해야지"
    },
    {
      "Id": 101120520,
      "Speaker": "Student",
      "Text": "선생님이 같이 찾아준 핸드폰이니까"
    },
    {
      "Id": 101120530,
      "Speaker": "Student",
      "Text": "근데 집 오니까 엄청 졸려"
    },
    {
      "Id": 101120540,
      "Speaker": "Player",
      "Text": "오늘 고생했으니까"
    },
    {
      "Id": 101120550,
      "Speaker": "Player",
      "Text": "잘 자, 아스나"
    },
    {
      "Id": 101120560,
      "Speaker": "Student",
      "Text": "응! 헤헤"
    },
    {
      "Id": 101120570,
      "Speaker": "Student",
      "Text": "선생님도 잘 자~!!"
    }
  ],
  "DialogEN": [
    {
      "Id": 101120010,
      "Speaker": "Student",
      "Text": "Do you ride the bus often, Master?"
    },
    {
      "Id": 101120020,
      "Speaker": "Player",
      "Text": "Sometimes?"
    },
    {
      "Id": 101120030,
      "Speaker": "Student",
      "Text": "Me too, me too."
    },
    {
      "Id": 101120040,
      "Speaker": "Student",
      "Text": "I ride the bus to school and I take it back home."
    },
    {
      "Id": 101120050,
      "Speaker": "Student",
      "Text": "And there are always so many people."
    },
    {
      "Id": 101120060,
      "Speaker": "Player",
      "Text": "Yeah. I suppose..."
    },
    {
      "Id": 101120070,
      "Speaker": "Player",
      "Text": "If it's around that time..."
    },
    {
      "Id": 101120080,
      "Speaker": "Student",
      "Text": "Yeah yeah."
    },
    {
      "Id": 101120090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "So you know that feeling too, Master."
    },
    {
      "Id": 101120100,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 101120110,
      "Speaker": "Student",
      "Text": "I forgot to say this when I got off"
    },
    {
      "Id": 101120120,
      "Speaker": "Student",
      "Text": "but my makeup got on your shirt, Sensei."
    },
    {
      "Id": 101120130,
      "Speaker": "Player",
      "Text": "Oh, you're right."
    },
    {
      "Id": 101120140,
      "Speaker": "Player",
      "Text": "Maybe I made myself too comfy..."
    },
    {
      "Id": 101120150,
      "Speaker": "Student",
      "Text": "Sorry! I leaned on you too much."
    },
    {
      "Id": 101120160,
      "Speaker": "Student",
      "Text": "I'll straighten everything up for you."
    },
    {
      "Id": 101120170,
      "Speaker": "Student",
      "Text": "Oh, but"
    },
    {
      "Id": 101120180,
      "Speaker": "Student",
      "Text": "I have to wear my maid uniform if I want to do that..."
    },
    {
      "Id": 101120190,
      "Speaker": "Student",
      "Text": "Hm..."
    },
    {
      "Id": 101120200,
      "Speaker": "Student",
      "Text": "Do you prefer the school uniform or the maid uniform?"
    },
    {
      "Id": 101120210,
      "Speaker": "Player",
      "Text": "I'm not sure what you mean..."
    },
    {
      "Id": 101120220,
      "Speaker": "Student",
      "Text": "It's almost lunch."
    },
    {
      "Id": 101120230,
      "Speaker": "Student",
      "Text": "I always get hungry around this time."
    },
    {
      "Id": 101120240,
      "Speaker": "Player",
      "Text": "I'm always hungry..."
    },
    {
      "Id": 101120250,
      "Speaker": "Student",
      "Text": "Ahaha"
    },
    {
      "Id": 101120260,
      "Speaker": "Student",
      "Text": "What are you saying?"
    },
    {
      "Id": 101120270,
      "Speaker": "Player",
      "Text": "What are you getting for lunch, Asuna?"
    },
    {
      "Id": 101120280,
      "Speaker": "Student",
      "Text": "Hmm... Let's see."
    },
    {
      "Id": 101120290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Thinking about it!"
    },
    {
      "Id": 101120300,
      "Speaker": "Student",
      "Text": "Now that I think about it..."
    },
    {
      "Id": 101120310,
      "Speaker": "Student",
      "Text": "I've been running into you a lot lately, Sensei"
    },
    {
      "Id": 101120320,
      "Speaker": "Student",
      "Text": "Don't you agree?"
    },
    {
      "Id": 101120330,
      "Speaker": "Player",
      "Text": "That's true."
    },
    {
      "Id": 101120340,
      "Speaker": "Player",
      "Text": "I never know when I'll run into you next."
    },
    {
      "Id": 101120350,
      "Speaker": "Student",
      "Text": "Ahaha"
    },
    {
      "Id": 101120360,
      "Speaker": "Student",
      "Text": "An unexpected encounter..."
    },
    {
      "Id": 101120370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Those are always fun!"
    },
    {
      "Id": 101120380,
      "Speaker": "Student",
      "Text": "I'm at the hill park right now,"
    },
    {
      "Id": 101120390,
      "Speaker": "Student",
      "Text": "and there's a cloud that looks like you, Sensei."
    },
    {
      "Id": 101120400,
      "Speaker": "Student",
      "Text": "Ahaha"
    },
    {
      "Id": 101120410,
      "Speaker": "Player",
      "Text": "Are you taking a walk, Asuna?"
    },
    {
      "Id": 101120420,
      "Speaker": "Student",
      "Text": "Yup"
    },
    {
      "Id": 101120430,
      "Speaker": "Student",
      "Text": "Uh..."
    },
    {
      "Id": 101120440,
      "Speaker": "Player",
      "Text": "Did something happen?"
    },
    {
      "Id": 101120450,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "Asuna?"
    },
    {
      "Id": 101120460,
      "Speaker": "Student",
      "Text": "Sensei!"
    },
    {
      "Id": 101120470,
      "Speaker": "Student",
      "Text": "Thank you for coming to see me today."
    },
    {
      "Id": 101120480,
      "Speaker": "Student",
      "Text": "And for finding my phone."
    },
    {
      "Id": 101120490,
      "Speaker": "Player",
      "Text": "Yeah, I'm glad we can MomoTalk like this."
    },
    {
      "Id": 101120500,
      "Speaker": "Student",
      "Text": "Right right."
    },
    {
      "Id": 101120510,
      "Speaker": "Student",
      "Text": "I'll be careful to not lose it again,"
    },
    {
      "Id": 101120520,
      "Speaker": "Student",
      "Text": "since we found it together."
    },
    {
      "Id": 101120530,
      "Speaker": "Student",
      "Text": "I'm really sleepy now that I'm home"
    },
    {
      "Id": 101120540,
      "Speaker": "Player",
      "Text": "You had it rough today."
    },
    {
      "Id": 101120550,
      "Speaker": "Player",
      "Text": "Goodnight, Asuna."
    },
    {
      "Id": 101120560,
      "Speaker": "Student",
      "Text": "Yeah! Heehee."
    },
    {
      "Id": 101120570,
      "Speaker": "Student",
      "Text": "Goodnight, Sensei!"
    }
  ],
  "DialogTH": [
    {
      "Id": 101120010,
      "Speaker": "Student",
      "Text": "นายท่าน ปกตินั่งรถบัสบ่อยมั้ย?"
    },
    {
      "Id": 101120020,
      "Speaker": "Player",
      "Text": "ก็นั่งบ้างนะ"
    },
    {
      "Id": 101120030,
      "Speaker": "Student",
      "Text": "ฉันก็ด้วยๆ"
    },
    {
      "Id": 101120040,
      "Speaker": "Student",
      "Text": "ฉันนั่งทั้งตอนไปโรงเรียนและก็ตอน\nเลิกเรียนเลยละ"
    },
    {
      "Id": 101120050,
      "Speaker": "Student",
      "Text": "แต่คนเยอะตลอดเลย"
    },
    {
      "Id": 101120060,
      "Speaker": "Player",
      "Text": "ก็น่าจะเป็นอย่างนั้นนะ..."
    },
    {
      "Id": 101120070,
      "Speaker": "Player",
      "Text": "ยิ่งในเวลานั้นแล้วด้วย..."
    },
    {
      "Id": 101120080,
      "Speaker": "Student",
      "Text": "อื้อๆ"
    },
    {
      "Id": 101120090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "นายท่านเองก็เข้าใจเหมือนกันสินะ"
    },
    {
      "Id": 101120100,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 101120110,
      "Speaker": "Student",
      "Text": "เมื่อกี้ฉันลืมบอกไปตอนลงรถ"
    },
    {
      "Id": 101120120,
      "Speaker": "Student",
      "Text": "เครื่องสำอางฉันเลอะเสื้อคุณครูน่ะ"
    },
    {
      "Id": 101120130,
      "Speaker": "Player",
      "Text": "อ๊ะ จริงด้วยนะเนี่ย"
    },
    {
      "Id": 101120140,
      "Speaker": "Player",
      "Text": "เพราะเบียดกันมากไปหรือเปล่านะ..."
    },
    {
      "Id": 101120150,
      "Speaker": "Student",
      "Text": "ขอโทษนะ~ ฉันไปพิงคุณครูมากไปน่ะ"
    },
    {
      "Id": 101120160,
      "Speaker": "Student",
      "Text": "เสื้อตัวนั้นเดี๋ยวอาสึนะซักให้นะ"
    },
    {
      "Id": 101120170,
      "Speaker": "Student",
      "Text": "อ๊ะ จะว่าไป"
    },
    {
      "Id": 101120180,
      "Speaker": "Student",
      "Text": "งั้นก็ต้องใส่ชุดเมดน่ะสิ"
    },
    {
      "Id": 101120190,
      "Speaker": "Student",
      "Text": "ฮืม"
    },
    {
      "Id": 101120200,
      "Speaker": "Student",
      "Text": "ชอบชุดนักเรียนหรือชุดเมดเหรอ?"
    },
    {
      "Id": 101120210,
      "Speaker": "Player",
      "Text": "หมายความว่ายังไงน่ะ..."
    },
    {
      "Id": 101120220,
      "Speaker": "Student",
      "Text": "ใกล้ถึงเวลาอาหารกลางวันแล้ว"
    },
    {
      "Id": 101120230,
      "Speaker": "Student",
      "Text": "พอถึงเวลานี้ก็หิวตลอดเลย"
    },
    {
      "Id": 101120240,
      "Speaker": "Player",
      "Text": "แต่ครูหิวทั้งวันเลย..."
    },
    {
      "Id": 101120250,
      "Speaker": "Student",
      "Text": "อะฮ่าฮ่า"
    },
    {
      "Id": 101120260,
      "Speaker": "Student",
      "Text": "อะไรเนี่ย"
    },
    {
      "Id": 101120270,
      "Speaker": "Player",
      "Text": "กลางวันนี้อาสึนะกินอะไรเหรอ?"
    },
    {
      "Id": 101120280,
      "Speaker": "Student",
      "Text": "อืม~ ไม่รู้สิ"
    },
    {
      "Id": 101120290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "กำลังตัดสินใจอยู่น่ะ!!"
    },
    {
      "Id": 101120300,
      "Speaker": "Student",
      "Text": "จะว่าไป"
    },
    {
      "Id": 101120310,
      "Speaker": "Student",
      "Text": "ช่วงนี้เหมือนฉัน"
    },
    {
      "Id": 101120320,
      "Speaker": "Student",
      "Text": "บังเอิญเจอคุณครูตรงนั้นตรงนี้บ่อยๆ\nเลยนะ?"
    },
    {
      "Id": 101120330,
      "Speaker": "Player",
      "Text": "นั่นสิเนอะ"
    },
    {
      "Id": 101120340,
      "Speaker": "Player",
      "Text": "แต่ละที่บังเอิญๆ ทั้งนั้นเลย"
    },
    {
      "Id": 101120350,
      "Speaker": "Student",
      "Text": "อะฮ่าฮ่า"
    },
    {
      "Id": 101120360,
      "Speaker": "Student",
      "Text": "เจอกันแบบบังเอิญนี่ละ"
    },
    {
      "Id": 101120370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ถึงจะสนุก~!"
    },
    {
      "Id": 101120380,
      "Speaker": "Student",
      "Text": "ตอนนี้ฉันอยู่ในสวนที่เนินเขา"
    },
    {
      "Id": 101120390,
      "Speaker": "Student",
      "Text": "มีก้อนเมฆรูปร่างเหมือนคุณครูด้วย"
    },
    {
      "Id": 101120400,
      "Speaker": "Student",
      "Text": "อะฮ่าฮ่า"
    },
    {
      "Id": 101120410,
      "Speaker": "Player",
      "Text": "อาสึนะเดินเล่นอยู่เหรอ?"
    },
    {
      "Id": 101120420,
      "Speaker": "Student",
      "Text": "อื้อๆ"
    },
    {
      "Id": 101120430,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 101120440,
      "Speaker": "Player",
      "Text": "อาสึนะ ไม่ได้มีเรื่องอะไรใช่มั้ย?"
    },
    {
      "Id": 101120450,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "อาสึนะ?"
    },
    {
      "Id": 101120460,
      "Speaker": "Student",
      "Text": "คุณครู~!"
    },
    {
      "Id": 101120470,
      "Speaker": "Student",
      "Text": "ขอบคุณที่มาตามหาอาสึนะวันนี้ด้วยนะ"
    },
    {
      "Id": 101120480,
      "Speaker": "Student",
      "Text": "ขอบคุณที่ช่วยหาโทรศัพท์มือถือ\nให้ด้วย"
    },
    {
      "Id": 101120490,
      "Speaker": "Player",
      "Text": "อื้อ ค่อยโล่งใจหน่อยนะที่ยังส่ง\nMOMOTALK กันได้"
    },
    {
      "Id": 101120500,
      "Speaker": "Student",
      "Text": "ใช่ๆ"
    },
    {
      "Id": 101120510,
      "Speaker": "Student",
      "Text": "จากนี้ต้องระวังไม่ให้ทำหายแล้วละ"
    },
    {
      "Id": 101120520,
      "Speaker": "Student",
      "Text": "เพราะเป็นมือถือที่คุณครูช่วยหาให้\nนี่เนอะ"
    },
    {
      "Id": 101120530,
      "Speaker": "Student",
      "Text": "แต่พอกลับมาถึงก็ง่วงมากเลยละ"
    },
    {
      "Id": 101120540,
      "Speaker": "Player",
      "Text": "วันนี้เหนื่อยมากแล้ว"
    },
    {
      "Id": 101120550,
      "Speaker": "Player",
      "Text": "ฝันดีนะ อาสึนะ"
    },
    {
      "Id": 101120560,
      "Speaker": "Student",
      "Text": "อื้อ! แหะๆ"
    },
    {
      "Id": 101120570,
      "Speaker": "Student",
      "Text": "คุณครูก็นอนหลับฝันดีนะ~!!"
    }
  ],
  "DialogTW": [
    {
      "Id": 101120010,
      "Speaker": "Student",
      "Text": "主人常搭公車嗎？"
    },
    {
      "Id": 101120020,
      "Speaker": "Player",
      "Text": "普普通通吧？"
    },
    {
      "Id": 101120030,
      "Speaker": "Student",
      "Text": "我也是我也是"
    },
    {
      "Id": 101120040,
      "Speaker": "Student",
      "Text": "上學和放學的時候都會搭"
    },
    {
      "Id": 101120050,
      "Speaker": "Student",
      "Text": "車上的人總是很多"
    },
    {
      "Id": 101120060,
      "Speaker": "Player",
      "Text": "畢竟……"
    },
    {
      "Id": 101120070,
      "Speaker": "Player",
      "Text": "那種時段通常都……"
    },
    {
      "Id": 101120080,
      "Speaker": "Student",
      "Text": "嗯嗯"
    },
    {
      "Id": 101120090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "果然主人也懂那種感覺"
    },
    {
      "Id": 101120100,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 101120110,
      "Speaker": "Student",
      "Text": "下車的時候忘記說了"
    },
    {
      "Id": 101120120,
      "Speaker": "Student",
      "Text": "老師的襯衫上，好像沾到我的化妝品了"
    },
    {
      "Id": 101120130,
      "Speaker": "Player",
      "Text": "啊，真的耶"
    },
    {
      "Id": 101120140,
      "Speaker": "Player",
      "Text": "果然太靠近了嗎……"
    },
    {
      "Id": 101120150,
      "Speaker": "Student",
      "Text": "抱歉～是我靠太近了"
    },
    {
      "Id": 101120160,
      "Speaker": "Student",
      "Text": "那就讓明日奈來幫你洗吧"
    },
    {
      "Id": 101120170,
      "Speaker": "Student",
      "Text": "啊，不過"
    },
    {
      "Id": 101120180,
      "Speaker": "Student",
      "Text": "那樣的話就得穿女僕裝了呢"
    },
    {
      "Id": 101120190,
      "Speaker": "Student",
      "Text": "嗯……"
    },
    {
      "Id": 101120200,
      "Speaker": "Student",
      "Text": "話說老師喜歡制服還是女僕裝呢？"
    },
    {
      "Id": 101120210,
      "Speaker": "Player",
      "Text": "我不明白你的意思……"
    },
    {
      "Id": 101120220,
      "Speaker": "Student",
      "Text": "快到午餐時間了"
    },
    {
      "Id": 101120230,
      "Speaker": "Student",
      "Text": "肚子也有點餓了"
    },
    {
      "Id": 101120240,
      "Speaker": "Player",
      "Text": "我隨時都很餓……"
    },
    {
      "Id": 101120250,
      "Speaker": "Student",
      "Text": "啊哈哈"
    },
    {
      "Id": 101120260,
      "Speaker": "Student",
      "Text": "什麼啦"
    },
    {
      "Id": 101120270,
      "Speaker": "Player",
      "Text": "明日奈午餐吃什麼呢？"
    },
    {
      "Id": 101120280,
      "Speaker": "Student",
      "Text": "嗯～這個嘛"
    },
    {
      "Id": 101120290,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "目前還在考慮！"
    },
    {
      "Id": 101120300,
      "Speaker": "Student",
      "Text": "話說回來"
    },
    {
      "Id": 101120310,
      "Speaker": "Student",
      "Text": "最近好像總是在各種地方"
    },
    {
      "Id": 101120320,
      "Speaker": "Student",
      "Text": "遇到老師呢？"
    },
    {
      "Id": 101120330,
      "Speaker": "Player",
      "Text": "是啊"
    },
    {
      "Id": 101120340,
      "Speaker": "Player",
      "Text": "無法預測會在哪裡碰見呢"
    },
    {
      "Id": 101120350,
      "Speaker": "Student",
      "Text": "啊哈哈"
    },
    {
      "Id": 101120360,
      "Speaker": "Student",
      "Text": "因為是意想不到的相遇"
    },
    {
      "Id": 101120370,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "所以更有趣了～！"
    },
    {
      "Id": 101120380,
      "Speaker": "Student",
      "Text": "我現在在山丘公園"
    },
    {
      "Id": 101120390,
      "Speaker": "Student",
      "Text": "發現了一朵很像老師的雲"
    },
    {
      "Id": 101120400,
      "Speaker": "Student",
      "Text": "啊哈哈"
    },
    {
      "Id": 101120410,
      "Speaker": "Player",
      "Text": "明日奈在散步嗎？"
    },
    {
      "Id": 101120420,
      "Speaker": "Student",
      "Text": "嗯嗯"
    },
    {
      "Id": 101120430,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 101120440,
      "Speaker": "Player",
      "Text": "明日奈，你還好嗎？"
    },
    {
      "Id": 101120450,
      "Speaker": "Player",
      "StoryEpisode": 4,
      "Text": "明日奈？"
    },
    {
      "Id": 101120460,
      "Speaker": "Student",
      "Text": "老師～！"
    },
    {
      "Id": 101120470,
      "Speaker": "Student",
      "Text": "謝謝你今天來找明日奈"
    },
    {
      "Id": 101120480,
      "Speaker": "Student",
      "Text": "也謝謝你幫我找到手機"
    },
    {
      "Id": 101120490,
      "Speaker": "Player",
      "Text": "嗯，能這樣用MomoTalk聊天真是太好了"
    },
    {
      "Id": 101120500,
      "Speaker": "Student",
      "Text": "沒錯沒錯"
    },
    {
      "Id": 101120510,
      "Speaker": "Student",
      "Text": "我之後會注意別再弄丟了"
    },
    {
      "Id": 101120520,
      "Speaker": "Student",
      "Text": "畢竟是老師和我一起找回來的手機"
    },
    {
      "Id": 101120530,
      "Speaker": "Student",
      "Text": "一回到家就好想睡哦"
    },
    {
      "Id": 101120540,
      "Speaker": "Player",
      "Text": "畢竟今天很辛苦嘛"
    },
    {
      "Id": 101120550,
      "Speaker": "Player",
      "Text": "晚安，明日奈"
    },
    {
      "Id": 101120560,
      "Speaker": "Student",
      "Text": "嗯！嘿嘿"
    },
    {
      "Id": 101120570,
      "Speaker": "Student",
      "Text": "老師也晚安～！！"
    }
  ]
}