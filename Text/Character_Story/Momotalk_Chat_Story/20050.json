{
  "CharacterId": 20050,
  "DialogJP": [
    {
      "Id": 200500010,
      "Speaker": "Student",
      "Text": "やっほ！"
    },
    {
      "Id": 200500020,
      "Speaker": "Student",
      "Text": "薄葉リツだよ！"
    },
    {
      "Id": 200500030,
      "Speaker": "Player",
      "Text": "明日の当番はリツだったね！"
    },
    {
      "Id": 200500040,
      "Speaker": "Student",
      "Text": "そういうこと！"
    },
    {
      "Id": 200500050,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "よろしくね！先生！"
    },
    {
      "Id": 200500060,
      "Speaker": "Student",
      "Text": "せんせーせんせーせんせー"
    },
    {
      "Id": 200500070,
      "Speaker": "Student",
      "Text": "先生は何色が好き？"
    },
    {
      "Id": 200500080,
      "Speaker": "Player",
      "Text": "なにの色か、によるかな……？"
    },
    {
      "Id": 200500090,
      "Speaker": "Student",
      "Text": "おっけー！"
    },
    {
      "Id": 200500100,
      "Speaker": "Student",
      "Text": "じゃあボクが決めちゃうね！"
    },
    {
      "Id": 200500110,
      "Speaker": "Player",
      "Text": "え？何を？"
    },
    {
      "Id": 200500120,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "リツ？"
    },
    {
      "Id": 200500130,
      "Speaker": "Student",
      "Text": "シャーレの前ついたよー！"
    },
    {
      "Id": 200500140,
      "Speaker": "Student",
      "Text": "何してる？"
    },
    {
      "Id": 200500150,
      "Speaker": "Player",
      "Text": "いきなりどうしたの！？"
    },
    {
      "Id": 200500160,
      "Speaker": "Student",
      "Text": "服買いにいこって話したじゃん？"
    },
    {
      "Id": 200500170,
      "Speaker": "Student",
      "Text": "もしかして忙しい？"
    },
    {
      "Id": 200500180,
      "Speaker": "Player",
      "Text": "忙しい……"
    },
    {
      "Id": 200500190,
      "Speaker": "Player",
      "Text": "だからこそ、行くよ。"
    },
    {
      "Id": 200500200,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "えっ？"
    },
    {
      "Id": 200500210,
      "Speaker": "Student",
      "Text": "ねね、先生"
    },
    {
      "Id": 200500220,
      "Speaker": "Student",
      "Text": "ボク、すごく変なとこ見つけたの！"
    },
    {
      "Id": 200500230,
      "Speaker": "Player",
      "Text": "変なとこ···…?"
    },
    {
      "Id": 200500240,
      "Speaker": "Student",
      "Text": "ワイルドハントまで来てくれる？"
    },
    {
      "Id": 200500250,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "先生にも見せたい！"
    },
    {
      "Id": 200500260,
      "Speaker": "Student",
      "Text": "悲しいニュース"
    },
    {
      "Id": 200500270,
      "Speaker": "Student",
      "Text": "あそこ、輸入には使えないかも"
    },
    {
      "Id": 200500280,
      "Speaker": "Student",
      "Text": "学院内につながる道がなかったの……"
    },
    {
      "Id": 200500290,
      "Speaker": "Player",
      "Text": "そっか、残念……"
    },
    {
      "Id": 200500300,
      "Speaker": "Student",
      "Text": "でもいいんだ！"
    },
    {
      "Id": 200500310,
      "Speaker": "Student",
      "Text": "先生とボクだけの秘密基地ができたから！"
    },
    {
      "Id": 200500320,
      "Speaker": "Student",
      "Text": "また遊ぼ！先生！"
    }
  ],
  "DialogKR": [
    {
      "Id": 200500010,
      "Speaker": "Student",
      "Text": "안녕 선생님!"
    },
    {
      "Id": 200500020,
      "Speaker": "Student",
      "Text": "우스바 리츠입니다!"
    },
    {
      "Id": 200500030,
      "Speaker": "Player",
      "Text": "맞아, 리츠가 내일 당번이었지?"
    },
    {
      "Id": 200500040,
      "Speaker": "Student",
      "Text": "맞습니다!"
    },
    {
      "Id": 200500050,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "내일 봐! 선생님!"
    },
    {
      "Id": 200500060,
      "Speaker": "Student",
      "Text": "선생님선생님선생님"
    },
    {
      "Id": 200500070,
      "Speaker": "Student",
      "Text": "선생님은 무슨 색을 좋아해?"
    },
    {
      "Id": 200500080,
      "Speaker": "Player",
      "Text": "무엇의 색인지에 따라 다르지……?"
    },
    {
      "Id": 200500090,
      "Speaker": "Student",
      "Text": "아항!"
    },
    {
      "Id": 200500100,
      "Speaker": "Student",
      "Text": "그럼 그냥 이쪽에서 정해야겠다!"
    },
    {
      "Id": 200500110,
      "Speaker": "Player",
      "Text": "예? 뭘요?"
    },
    {
      "Id": 200500120,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "리츠?"
    },
    {
      "Id": 200500130,
      "Speaker": "Student",
      "Text": "나 이제 샬레 앞!"
    },
    {
      "Id": 200500140,
      "Speaker": "Student",
      "Text": "선생님은 뭐 해?"
    },
    {
      "Id": 200500150,
      "Speaker": "Player",
      "Text": "갑자기?!"
    },
    {
      "Id": 200500160,
      "Speaker": "Student",
      "Text": "저번에 같이 옷 사러 가자고 했었잖아!"
    },
    {
      "Id": 200500170,
      "Speaker": "Student",
      "Text": "혹시 바빠, 선생님?"
    },
    {
      "Id": 200500180,
      "Speaker": "Player",
      "Text": "당연히 바쁘지."
    },
    {
      "Id": 200500190,
      "Speaker": "Player",
      "Text": "당장 가자."
    },
    {
      "Id": 200500200,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "엥?"
    },
    {
      "Id": 200500210,
      "Speaker": "Student",
      "Text": "그래서 말인데 선생님"
    },
    {
      "Id": 200500220,
      "Speaker": "Student",
      "Text": "나 진짜 이상한 곳을 발견했어!"
    },
    {
      "Id": 200500230,
      "Speaker": "Player",
      "Text": "이상한 곳……?"
    },
    {
      "Id": 200500240,
      "Speaker": "Student",
      "Text": "응! 와일드헌트로 올 수 있어?"
    },
    {
      "Id": 200500250,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "선생님한테 꼭 보여주고 싶은 곳이 있어!"
    },
    {
      "Id": 200500260,
      "Speaker": "Student",
      "Text": "슬프게도 선생님"
    },
    {
      "Id": 200500270,
      "Speaker": "Student",
      "Text": "이곳은 밀수 통로로는 못 쓸 것 같아."
    },
    {
      "Id": 200500280,
      "Speaker": "Student",
      "Text": "교내로 연결되는 루트가 없더라고."
    },
    {
      "Id": 200500290,
      "Speaker": "Player",
      "Text": "앗……."
    },
    {
      "Id": 200500300,
      "Speaker": "Student",
      "Text": "그래도 괜찮아!"
    },
    {
      "Id": 200500310,
      "Speaker": "Student",
      "Text": "선생님하고 둘만 아는 비밀 기지가 생긴 거니까!"
    },
    {
      "Id": 200500320,
      "Speaker": "Student",
      "Text": "다음에 또 같이 가자!"
    }
  ],
  "DialogEN": [
    {
      "Id": 200500010,
      "Speaker": "Student",
      "Text": "Hello, Sensei!"
    },
    {
      "Id": 200500020,
      "Speaker": "Student",
      "Text": "This is Usuba Ritsu!"
    },
    {
      "Id": 200500030,
      "Speaker": "Player",
      "Text": "Oh right, you're on Student Rep duty tomorrow?"
    },
    {
      "Id": 200500040,
      "Speaker": "Student",
      "Text": "That's right!"
    },
    {
      "Id": 200500050,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "I'll see you tomorrow, Sensei!"
    },
    {
      "Id": 200500060,
      "Speaker": "Student",
      "Text": "Sensei Sensei Sensei"
    },
    {
      "Id": 200500070,
      "Speaker": "Student",
      "Text": "What color do you like, Sensei?"
    },
    {
      "Id": 200500080,
      "Speaker": "Player",
      "Text": "I guess it depends on what it's for...?"
    },
    {
      "Id": 200500090,
      "Speaker": "Student",
      "Text": "Aha!"
    },
    {
      "Id": 200500100,
      "Speaker": "Student",
      "Text": "I'm just going to pick!"
    },
    {
      "Id": 200500110,
      "Speaker": "Player",
      "Text": "Eh? Pick what?"
    },
    {
      "Id": 200500120,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "Ritsu?"
    },
    {
      "Id": 200500130,
      "Speaker": "Student",
      "Text": "I'm in front of Schale right now!"
    },
    {
      "Id": 200500140,
      "Speaker": "Student",
      "Text": "What are you up to, Sensei?"
    },
    {
      "Id": 200500150,
      "Speaker": "Player",
      "Text": "Right now?!"
    },
    {
      "Id": 200500160,
      "Speaker": "Student",
      "Text": "I said we should go shopping for clothes, remember?"
    },
    {
      "Id": 200500170,
      "Speaker": "Student",
      "Text": "Are you busy, Sensei?"
    },
    {
      "Id": 200500180,
      "Speaker": "Player",
      "Text": "Of course I'm busy."
    },
    {
      "Id": 200500190,
      "Speaker": "Player",
      "Text": "Let's run away."
    },
    {
      "Id": 200500200,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Huh?"
    },
    {
      "Id": 200500210,
      "Speaker": "Student",
      "Text": "So, Sensei."
    },
    {
      "Id": 200500220,
      "Speaker": "Student",
      "Text": "I found somewhere really weird!"
    },
    {
      "Id": 200500230,
      "Speaker": "Player",
      "Text": "A weird place...?"
    },
    {
      "Id": 200500240,
      "Speaker": "Student",
      "Text": "Yeah! Can you come to Wildhunt?"
    },
    {
      "Id": 200500250,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I really want to show you!"
    },
    {
      "Id": 200500260,
      "Speaker": "Student",
      "Text": "Unfortunately, Sensei,"
    },
    {
      "Id": 200500270,
      "Speaker": "Student",
      "Text": "I don't think this is a viable smuggling route."
    },
    {
      "Id": 200500280,
      "Speaker": "Student",
      "Text": "It didn't have a path leading to campus."
    },
    {
      "Id": 200500290,
      "Speaker": "Player",
      "Text": "Ah..."
    },
    {
      "Id": 200500300,
      "Speaker": "Student",
      "Text": "But it's okay!"
    },
    {
      "Id": 200500310,
      "Speaker": "Student",
      "Text": "It means there's a secret hideout that only the two of us know about!"
    },
    {
      "Id": 200500320,
      "Speaker": "Student",
      "Text": "Let's go again!"
    }
  ],
  "DialogTH": [
    {
      "Id": 200500010,
      "Speaker": "Student",
      "Text": "สวัสดี คุณครู!"
    },
    {
      "Id": 200500020,
      "Speaker": "Student",
      "Text": "ฉันอุสุบะ ริตสึค่ะ!"
    },
    {
      "Id": 200500030,
      "Speaker": "Player",
      "Text": "จริงสิ พรุ่งนี้เป็นเวรริตสึใช่มั้ย?"
    },
    {
      "Id": 200500040,
      "Speaker": "Student",
      "Text": "ใช่ค่ะ!"
    },
    {
      "Id": 200500050,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "เจอกันพรุ่งนี้นะ! คุณครู!"
    },
    {
      "Id": 200500060,
      "Speaker": "Student",
      "Text": "คุณครูคุณครูคุณครู"
    },
    {
      "Id": 200500070,
      "Speaker": "Student",
      "Text": "คุณครูชอบสีอะไรเหรอ?"
    },
    {
      "Id": 200500080,
      "Speaker": "Player",
      "Text": "น่าจะขึ้นอยู่กับว่าเป็นสีของอะไรน่ะ...?"
    },
    {
      "Id": 200500090,
      "Speaker": "Student",
      "Text": "อ่าฮะ!"
    },
    {
      "Id": 200500100,
      "Speaker": "Student",
      "Text": "งั้นฉันคงต้องตัดสินใจเองแล้วละ!"
    },
    {
      "Id": 200500110,
      "Speaker": "Player",
      "Text": "หืม? อะไรเหรอ?"
    },
    {
      "Id": 200500120,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "ริตสึ?"
    },
    {
      "Id": 200500130,
      "Speaker": "Student",
      "Text": "ตอนนี้ฉันอยู่หน้าชาเล่ต์!"
    },
    {
      "Id": 200500140,
      "Speaker": "Student",
      "Text": "คุณครูทำอะไรอยู่เหรอ?"
    },
    {
      "Id": 200500150,
      "Speaker": "Player",
      "Text": "มาไม่ให้ตั้งตัวเลย?!"
    },
    {
      "Id": 200500160,
      "Speaker": "Student",
      "Text": "ก็คราวก่อนเราตกลงไปซื้อเสื้อผ้า\nด้วยกันไม่ใช่เหรอ!"
    },
    {
      "Id": 200500170,
      "Speaker": "Student",
      "Text": "ยุ่งอยู่หรือเปล่า คุณครู?"
    },
    {
      "Id": 200500180,
      "Speaker": "Player",
      "Text": "ก็ต้องยุ่งอยู่แล้ว"
    },
    {
      "Id": 200500190,
      "Speaker": "Player",
      "Text": "แต่ไปกันเถอะ เดี๋ยวนี้เลย"
    },
    {
      "Id": 200500200,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "หืม?"
    },
    {
      "Id": 200500210,
      "Speaker": "Student",
      "Text": "เข้าเรื่องเลยนะ คุณครู"
    },
    {
      "Id": 200500220,
      "Speaker": "Student",
      "Text": "ฉันเจอที่ที่แปลกๆ เยอะเลยละ!"
    },
    {
      "Id": 200500230,
      "Speaker": "Player",
      "Text": "ที่ที่แปลกๆ...?"
    },
    {
      "Id": 200500240,
      "Speaker": "Student",
      "Text": "อื้อ! มาที่ไวลด์ฮันต์ได้มั้ย?"
    },
    {
      "Id": 200500250,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ฉันอยากพาคุณครูไปดูที่นั่นให้ได้เลย!"
    },
    {
      "Id": 200500260,
      "Speaker": "Student",
      "Text": "น่าเศร้านะ คุณครู"
    },
    {
      "Id": 200500270,
      "Speaker": "Student",
      "Text": "ที่นั่นไม่น่าจะใช้เป็นเส้นทางลักลอบ\nขนส่งสินค้าได้"
    },
    {
      "Id": 200500280,
      "Speaker": "Student",
      "Text": "เห็นว่ามันไม่มีเส้นทางเชื่อมมาใน\nโรงเรียนน่ะ"
    },
    {
      "Id": 200500290,
      "Speaker": "Player",
      "Text": "อ่อ..."
    },
    {
      "Id": 200500300,
      "Speaker": "Student",
      "Text": "แต่ก็ไม่เป็นไร!"
    },
    {
      "Id": 200500310,
      "Speaker": "Student",
      "Text": "ยังไงก็ได้เป็นฐานลับที่รู้กันเฉพาะฉัน\nกับคุณครูเท่านั้น!"
    },
    {
      "Id": 200500320,
      "Speaker": "Student",
      "Text": "ไว้คราวหน้าไปด้วยกันอีกนะ!"
    }
  ],
  "DialogTW": [
    {
      "Id": 200500010,
      "Speaker": "Student",
      "Text": "嗨，老師！"
    },
    {
      "Id": 200500020,
      "Speaker": "Student",
      "Text": "我是薄葉律！"
    },
    {
      "Id": 200500030,
      "Speaker": "Player",
      "Text": "對了，你是明天的值日生吧？"
    },
    {
      "Id": 200500040,
      "Speaker": "Student",
      "Text": "沒錯！"
    },
    {
      "Id": 200500050,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "明天見囉！老師！"
    },
    {
      "Id": 200500060,
      "Speaker": "Student",
      "Text": "老師老師老師"
    },
    {
      "Id": 200500070,
      "Speaker": "Student",
      "Text": "老師喜歡什麼顏色？"
    },
    {
      "Id": 200500080,
      "Speaker": "Player",
      "Text": "可能要看你指的是什麼東西……？"
    },
    {
      "Id": 200500090,
      "Speaker": "Student",
      "Text": "啊哈！"
    },
    {
      "Id": 200500100,
      "Speaker": "Student",
      "Text": "看來只能由我來決定了呢！"
    },
    {
      "Id": 200500110,
      "Speaker": "Player",
      "Text": "咦？決定什麼？"
    },
    {
      "Id": 200500120,
      "Speaker": "Player",
      "StoryEpisode": 2,
      "Text": "律？"
    },
    {
      "Id": 200500130,
      "Speaker": "Student",
      "Text": "我現在在夏萊前面！"
    },
    {
      "Id": 200500140,
      "Speaker": "Student",
      "Text": "老師你在做什麼呢？"
    },
    {
      "Id": 200500150,
      "Speaker": "Player",
      "Text": "這麼突然！？"
    },
    {
      "Id": 200500160,
      "Speaker": "Student",
      "Text": "我們上次不是說好要一起去買衣服嗎！"
    },
    {
      "Id": 200500170,
      "Speaker": "Student",
      "Text": "難道你現在很忙嗎，老師？"
    },
    {
      "Id": 200500180,
      "Speaker": "Player",
      "Text": "當然很忙"
    },
    {
      "Id": 200500190,
      "Speaker": "Player",
      "Text": "所以馬上出發吧"
    },
    {
      "Id": 200500200,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "咦？"
    },
    {
      "Id": 200500210,
      "Speaker": "Student",
      "Text": "老師老師"
    },
    {
      "Id": 200500220,
      "Speaker": "Student",
      "Text": "我這次真的找到了一個很奇怪的地方！"
    },
    {
      "Id": 200500230,
      "Speaker": "Player",
      "Text": "奇怪的地方……？"
    },
    {
      "Id": 200500240,
      "Speaker": "Student",
      "Text": "嗯！你可以來一趟狂獵嗎？"
    },
    {
      "Id": 200500250,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "有個地方我真的很想帶你去看！"
    },
    {
      "Id": 200500260,
      "Speaker": "Student",
      "Text": "老師，令人遺憾的是"
    },
    {
      "Id": 200500270,
      "Speaker": "Student",
      "Text": "那裡好像沒辦法當成走私通道"
    },
    {
      "Id": 200500280,
      "Speaker": "Student",
      "Text": "因為沒有路徑能連通到學院裡面"
    },
    {
      "Id": 200500290,
      "Speaker": "Player",
      "Text": "啊……"
    },
