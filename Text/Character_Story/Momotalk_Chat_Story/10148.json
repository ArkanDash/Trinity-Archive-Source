{
  "CharacterId": 10148,
  "DialogJP": [
    {
      "Id": 101480010,
      "Speaker": "Student",
      "Text": "お疲れ様です"
    },
    {
      "Id": 101480020,
      "Speaker": "Student",
      "Text": "今日は休みを勝ち取りました"
    },
    {
      "Id": 101480030,
      "Speaker": "Player",
      "Text": "おめでとう！"
    },
    {
      "Id": 101480040,
      "Speaker": "Player",
      "Text": "羨ましい！"
    },
    {
      "Id": 101480050,
      "Speaker": "Student",
      "Text": "そういうことなので、よろしくお願いします"
    },
    {
      "Id": 101480060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "どういうことなので？"
    },
    {
      "Id": 101480070,
      "Speaker": "Student",
      "Text": "分かってはいましたが……"
    },
    {
      "Id": 101480080,
      "Speaker": "Student",
      "Text": "執務室で水着になれだなんて"
    },
    {
      "Id": 101480090,
      "Speaker": "Student",
      "Text": "マニアックですね"
    },
    {
      "Id": 101480100,
      "Speaker": "Player",
      "Text": "言ったかなぁ！？"
    },
    {
      "Id": 101480110,
      "Speaker": "Player",
      "Text": "それより、なんで水着を持ってたの？"
    },
    {
      "Id": 101480120,
      "Speaker": "Player",
      "Text": "初めからそのつもりだったとか？"
    },
    {
      "Id": 101480130,
      "Speaker": "Player",
      "Text": "あれ？"
    },
    {
      "Id": 101480140,
      "Speaker": "Player",
      "Text": "おーい"
    },
    {
      "Id": 101480150,
      "Speaker": "Student",
      "Text": "お疲れ様です"
    },
    {
      "Id": 101480160,
      "Speaker": "Student",
      "Text": "今、シャーレですか？"
    },
    {
      "Id": 101480170,
      "Speaker": "Player",
      "Text": "そうだけど……"
    },
    {
      "Id": 101480180,
      "Speaker": "Player",
      "Text": "まさか……また？"
    },
    {
      "Id": 101480190,
      "Speaker": "Student",
      "Text": "はい？"
    },
    {
      "Id": 101480200,
      "Speaker": "Student",
      "Text": "ああ、水着ですか。持っていけばいいんですね？"
    },
    {
      "Id": 101480210,
      "Speaker": "Player",
      "Text": "一応、あるといいけど……"
    },
    {
      "Id": 101480220,
      "Speaker": "Player",
      "Text": "それより"
    },
    {
      "Id": 101480230,
      "Speaker": "Player",
      "Text": "虎丸に乗ってきてくれる？"
    },
    {
      "Id": 101480240,
      "Speaker": "Student",
      "Text": "……なぜです？"
    },
    {
      "Id": 101480250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "まあ、いいですけど"
    },
    {
      "Id": 101480260,
      "Speaker": "Student",
      "Text": "ああ"
    },
    {
      "Id": 101480270,
      "Speaker": "Student",
      "Text": "今日は充実してました"
    },
    {
      "Id": 101480280,
      "Speaker": "Student",
      "Text": "大満足です"
    },
    {
      "Id": 101480290,
      "Speaker": "Player",
      "Text": "それなら良かったけど……"
    },
    {
      "Id": 101480300,
      "Speaker": "Player",
      "Text": "思ってたのとはちょっと違ったけど……"
    },
    {
      "Id": 101480310,
      "Speaker": "Student",
      "Text": "寝転がって過ごす"
    },
    {
      "Id": 101480320,
      "Speaker": "Student",
      "Text": "やはり休みの日はこれに限ります"
    },
    {
      "Id": 101480330,
      "Speaker": "Player",
      "Text": "疲れた大人みたいなことを……"
    },
    {
      "Id": 101480340,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 101480350,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "一緒に逃げてしまいませんか？"
    },
    {
      "Id": 101480360,
      "Speaker": "Student",
      "Text": "ダメです"
    },
    {
      "Id": 101480370,
      "Speaker": "Student",
      "Text": "無理です"
    },
    {
      "Id": 101480380,
      "Speaker": "Student",
      "Text": "今すぐにでも逃げ出しませんか？"
    },
    {
      "Id": 101480390,
      "Speaker": "Player",
      "Text": "週末まで頑張ろう……！"
    },
    {
      "Id": 101480400,
      "Speaker": "Player",
      "Text": "来年の夏休みまで頑張ろう……！"
    },
    {
      "Id": 101480410,
      "Speaker": "Student",
      "Text": "はい？"
    },
    {
      "Id": 101480420,
      "Speaker": "Student",
      "Text": "そんなに私の水着姿が見たいんですか？"
    },
    {
      "Id": 101480430,
      "Speaker": "Player",
      "Text": "違うよ！？"
    },
    {
      "Id": 101480440,
      "Speaker": "Player",
      "Text": "違……くはないけど！"
    },
    {
      "Id": 101480450,
      "Speaker": "Student",
      "Text": "あ～"
    },
    {
      "Id": 101480460,
      "Speaker": "Student",
      "Text": "あぁ～……"
    },
    {
      "Id": 101480470,
      "Speaker": "Player",
      "Text": "頑張ろう……！"
    },
    {
      "Id": 101480480,
      "Speaker": "Student",
      "Text": "あぁ"
    },
    {
      "Id": 101480490,
      "Speaker": "Student",
      "Text": "まぁ"
    },
    {
      "Id": 101480500,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "はぁ"
    }
  ],
  "DialogKR": [
    {
      "Id": 101480010,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101480020,
      "Speaker": "Student",
      "Text": "저 휴가 받았습니다."
    },
    {
      "Id": 101480030,
      "Speaker": "Player",
      "Text": "오오, 축하해!"
    },
    {
      "Id": 101480040,
      "Speaker": "Player",
      "Text": "부럽다!"
    },
    {
      "Id": 101480050,
      "Speaker": "Student",
      "Text": "그런 연유로, 잘 부탁드립니다."
    },
    {
      "Id": 101480060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "네?"
    },
    {
      "Id": 101480070,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101480080,
      "Speaker": "Student",
      "Text": "알고는 있었지만, 참 매니악하시네요."
    },
    {
      "Id": 101480090,
      "Speaker": "Student",
      "Text": "굳이 사무실에서 수영복을 입으라니."
    },
    {
      "Id": 101480100,
      "Speaker": "Player",
      "Text": "아닌데요?!"
    },
    {
      "Id": 101480110,
      "Speaker": "Player",
      "Text": "그보다 수영복은 왜 갖고 온 거야?"
    },
    {
      "Id": 101480120,
      "Speaker": "Player",
      "Text": "애초에 수영복은 어디서 난 거야?"
    },
    {
      "Id": 101480130,
      "Speaker": "Player",
      "Text": "네? 이로하 씨?"
    },
    {
      "Id": 101480140,
      "Speaker": "Player",
      "Text": "저기요……?"
    },
    {
      "Id": 101480150,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101480160,
      "Speaker": "Student",
      "Text": "지금 샬레에 계신가요?"
    },
    {
      "Id": 101480170,
      "Speaker": "Player",
      "Text": "그렇긴 한데……."
    },
    {
      "Id": 101480180,
      "Speaker": "Player",
      "Text": "설마 또?"
    },
    {
      "Id": 101480190,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 101480200,
      "Speaker": "Student",
      "Text": "아, 수영복 말이네요. 챙겨 갈게요."
    },
    {
      "Id": 101480210,
      "Speaker": "Player",
      "Text": "아니, 그, 저, 뭐, 됐나……."
    },
    {
      "Id": 101480220,
      "Speaker": "Player",
      "Text": "그보다는"
    },
    {
      "Id": 101480230,
      "Speaker": "Player",
      "Text": "올때 꼭 토라마루를 타고 와줘."
    },
    {
      "Id": 101480240,
      "Speaker": "Student",
      "Text": "……?"
    },
    {
      "Id": 101480250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "네, 뭐, 어렵지는 않은데요."
    },
    {
      "Id": 101480260,
      "Speaker": "Student",
      "Text": "이야."
    },
    {
      "Id": 101480270,
      "Speaker": "Student",
      "Text": "오늘은 꽤 충실했네요."
    },
    {
      "Id": 101480280,
      "Speaker": "Student",
      "Text": "상당히 만족스러운 휴일이었어요."
    },
    {
      "Id": 101480290,
      "Speaker": "Player",
      "Text": "만족했다면 다행이지만……."
    },
    {
      "Id": 101480300,
      "Speaker": "Player",
      "Text": "생각한 거랑 좀 다른데……."
    },
    {
      "Id": 101480310,
      "Speaker": "Student",
      "Text": "무슨 말씀을."
    },
    {
      "Id": 101480320,
      "Speaker": "Student",
      "Text": "원래 휴일에는 누워서 쉬는 게 제일이에요."
    },
    {
      "Id": 101480330,
      "Speaker": "Player",
      "Text": "지친 직장인 같은 소리를……."
    },
    {
      "Id": 101480340,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101480350,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "함께 도망치지 않을래요?"
    },
    {
      "Id": 101480360,
      "Speaker": "Student",
      "Text": "선생님."
    },
    {
      "Id": 101480370,
      "Speaker": "Student",
      "Text": "진짜로 지금이라도, 떠나실래요?"
    },
    {
      "Id": 101480380,
      "Speaker": "Student",
      "Text": "아니, 뭔 놈의 일 처리를."
    },
    {
      "Id": 101480390,
      "Speaker": "Player",
      "Text": "곧 휴일이니까……!"
    },
    {
      "Id": 101480400,
      "Speaker": "Player",
      "Text": "다음 여름이 있으니까!"
    },
    {
      "Id": 101480410,
      "Speaker": "Student",
      "Text": "네?"
    },
    {
      "Id": 101480420,
      "Speaker": "Student",
      "Text": "그렇게까지 제 수영복 차림이 또 보고 싶으신 건가요?"
    },
    {
      "Id": 101480430,
      "Speaker": "Player",
      "Text": "그런 얘기 아닌데요?!"
    },
    {
      "Id": 101480440,
      "Speaker": "Player",
      "Text": "……아니지는 않지만!"
    },
    {
      "Id": 101480450,
      "Speaker": "Student",
      "Text": "아……."
    },
    {
      "Id": 101480460,
      "Speaker": "Student",
      "Text": "에휴……."
    },
    {
      "Id": 101480470,
      "Speaker": "Player",
      "Text": "힘내자……!"
    },
    {
      "Id": 101480480,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 101480490,
      "Speaker": "Student",
      "Text": "뭐"
    },
    {
      "Id": 101480500,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "네."
    }
  ],
  "DialogEN": [
    {
      "Id": 101480010,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101480020,
      "Speaker": "Student",
      "Text": "I got some time off."
    },
    {
      "Id": 101480030,
      "Speaker": "Player",
      "Text": "Ooh! Congrats!"
    },
    {
      "Id": 101480040,
      "Speaker": "Player",
      "Text": "I'm so jealous!"
    },
    {
      "Id": 101480050,
      "Speaker": "Student",
      "Text": "So I'm looking forward to seeing you."
    },
    {
      "Id": 101480060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "Eh?"
    },
    {
      "Id": 101480070,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101480080,
      "Speaker": "Student",
      "Text": "Not that I'm surprised, but you really are something else..."
    },
    {
      "Id": 101480090,
      "Speaker": "Student",
      "Text": "I never thought you'd force me to wear a swimsuit in your own office."
    },
    {
      "Id": 101480100,
      "Speaker": "Player",
      "Text": "Why are you making things up?!"
    },
    {
      "Id": 101480110,
      "Speaker": "Player",
      "Text": "Why did you even bring your swimsuit?"
    },
    {
      "Id": 101480120,
      "Speaker": "Player",
      "Text": "Where did you even get it from?!"
    },
    {
      "Id": 101480130,
      "Speaker": "Player",
      "Text": "Hello? Iroha?"
    },
    {
      "Id": 101480140,
      "Speaker": "Player",
      "Text": "Hello...?"
    },
    {
      "Id": 101480150,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101480160,
      "Speaker": "Student",
      "Text": "Are you at Schale right now?"
    },
    {
      "Id": 101480170,
      "Speaker": "Player",
      "Text": "I am, but..."
    },
    {
      "Id": 101480180,
      "Speaker": "Player",
      "Text": "Please... No... again...?"
    },
    {
      "Id": 101480190,
      "Speaker": "Student",
      "Text": "What?"
    },
    {
      "Id": 101480200,
      "Speaker": "Student",
      "Text": "Oh, my swimsuit. Since you insist, I'll bring it."
    },
    {
      "Id": 101480210,
      "Speaker": "Player",
      "Text": "That's not! what! I! meant!"
    },
    {
      "Id": 101480220,
      "Speaker": "Player",
      "Text": "More importantly..."
    },
    {
      "Id": 101480230,
      "Speaker": "Player",
      "Text": "Please ride Toramaru over here."
    },
    {
      "Id": 101480240,
      "Speaker": "Student",
      "Text": "...?"
    },
    {
      "Id": 101480250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Sure, I can do that."
    },
    {
      "Id": 101480260,
      "Speaker": "Student",
      "Text": "Wow."
    },
    {
      "Id": 101480270,
      "Speaker": "Student",
      "Text": "Today was fulfilling."
    },
    {
      "Id": 101480280,
      "Speaker": "Student",
      "Text": "That's what I call a successful day off."
    },
    {
      "Id": 101480290,
      "Speaker": "Player",
      "Text": "I guess as long as you're happy..."
    },
    {
      "Id": 101480300,
      "Speaker": "Player",
      "Text": "It wasn't exactly what I expected."
    },
    {
      "Id": 101480310,
      "Speaker": "Student",
      "Text": "Don't think too hard about it."
    },
    {
      "Id": 101480320,
      "Speaker": "Student",
      "Text": "You need to take advantage of days off and get some rest!"
    },
    {
      "Id": 101480330,
      "Speaker": "Player",
      "Text": "You sound like an exhausted wage worker..."
    },
    {
      "Id": 101480340,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101480350,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Want to run away with me?"
    },
    {
      "Id": 101480360,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 101480370,
      "Speaker": "Student",
      "Text": "It's not too late, want to run away with me?"
    },
    {
      "Id": 101480380,
      "Speaker": "Student",
      "Text": "Ugh. Who handles work like this?"
    },
    {
      "Id": 101480390,
      "Speaker": "Player",
      "Text": "I'll have a day off soon!"
    },
    {
      "Id": 101480400,
      "Speaker": "Player",
      "Text": "There's always next summer!"
    },
    {
      "Id": 101480410,
      "Speaker": "Student",
      "Text": "What?"
    },
    {
      "Id": 101480420,
      "Speaker": "Student",
      "Text": "You just want to see me in a swimsuit again, don't you?"
    },
    {
      "Id": 101480430,
      "Speaker": "Player",
      "Text": "That's not what I said?!"
    },
    {
      "Id": 101480440,
      "Speaker": "Player",
      "Text": "...I'm not saying no!"
    },
    {
      "Id": 101480450,
      "Speaker": "Student",
      "Text": "Ugh..."
    },
    {
      "Id": 101480460,
      "Speaker": "Student",
      "Text": "sighhh"
    },
    {
      "Id": 101480470,
      "Speaker": "Player",
      "Text": "Let's do our best...!"
    },
    {
      "Id": 101480480,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 101480490,
      "Speaker": "Student",
      "Text": "Well"
    },
    {
      "Id": 101480500,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Yes."
    }
  ],
  "DialogTH": [
    {
      "Id": 101480010,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101480020,
      "Speaker": "Student",
      "Text": "ฉันได้วันลาพักร้อนค่ะ"
    },
    {
      "Id": 101480030,
      "Speaker": "Player",
      "Text": "โอ้ ดีใจด้วยนะ!"
    },
    {
      "Id": 101480040,
      "Speaker": "Player",
      "Text": "น่าอิจฉาจัง!"
    },
    {
      "Id": 101480050,
      "Speaker": "Student",
      "Text": "เพราะงั้นก็ฝากด้วยนะคะ"
    },
    {
      "Id": 101480060,
      "Speaker": "Player",
      "StoryEpisode": 1,
      "Text": "หืม?"
    },
    {
      "Id": 101480070,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101480080,
      "Speaker": "Student",
      "Text": "ถึงจะรู้อยู่แล้วก็เถอะ แต่คุณครู\nคลั่งไคล้อะไรแบบนี้จริงๆ เลยนะคะ"
    },
    {
      "Id": 101480090,
      "Speaker": "Student",
      "Text": "ถึงกับให้ใส่ชุดว่ายน้ำในสำนักงาน\nเลยแบบนี้"
    },
    {
      "Id": 101480100,
      "Speaker": "Player",
      "Text": "ไม่ใช่นะ?!"
    },
    {
      "Id": 101480110,
      "Speaker": "Player",
      "Text": "ว่าแต่ ทำไมถึงเอาชุดว่ายน้ำมา\nด้วยล่ะ?"
    },
    {
      "Id": 101480120,
      "Speaker": "Player",
      "Text": "แล้วไปได้ชุดว่ายน้ำนั่นมาจากไหน?"
    },
    {
      "Id": 101480130,
      "Speaker": "Player",
      "Text": "หืม? คุณอิโรฮะ?"
    },
    {
      "Id": 101480140,
      "Speaker": "Player",
      "Text": "นี่...?"
    },
    {
      "Id": 101480150,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101480160,
      "Speaker": "Student",
      "Text": "ตอนนี้อยู่ที่ชาเล่ต์หรือเปล่าคะ?"
    },
    {
      "Id": 101480170,
      "Speaker": "Player",
      "Text": "ก็อยู่นะ..."
    },
    {
      "Id": 101480180,
      "Speaker": "Player",
      "Text": "จะเอาอีกเหรอ?"
    },
    {
      "Id": 101480190,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 101480200,
      "Speaker": "Student",
      "Text": "อ๋อ หมายถึงชุดว่ายน้ำสินะคะ\nงั้นจะเอาไปด้วยค่ะ"
    },
    {
      "Id": 101480210,
      "Speaker": "Player",
      "Text": "ไม่ใช่ เอ่อ คือ ช่างเถอะ..."
    },
    {
      "Id": 101480220,
      "Speaker": "Player",
      "Text": "ที่สำคัญกว่านั้น"
    },
    {
      "Id": 101480230,
      "Speaker": "Player",
      "Text": "ตอนมา ช่วยนั่งโทระมารุมาด้วยนะ"
    },
    {
      "Id": 101480240,
      "Speaker": "Student",
      "Text": "...?"
    },
    {
      "Id": 101480250,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "ค่ะ ก็... ไม่ใช่เรื่องลำบากอะไร\nหรอกนะคะ"
    },
    {
      "Id": 101480260,
      "Speaker": "Student",
      "Text": "โอ้โห"
    },
    {
      "Id": 101480270,
      "Speaker": "Student",
      "Text": "วันนี้ถือว่าคุ้มค่าเลยนะคะ"
    },
    {
      "Id": 101480280,
      "Speaker": "Student",
      "Text": "เป็นวันหยุดที่น่าพอใจมากทีเดียวค่ะ"
    },
    {
      "Id": 101480290,
      "Speaker": "Player",
      "Text": "ถ้าพอใจก็ดีแล้ว..."
    },
    {
      "Id": 101480300,
      "Speaker": "Player",
      "Text": "แต่มันต่างจากที่คิดไว้นิดหน่อย..."
    },
    {
      "Id": 101480310,
      "Speaker": "Student",
      "Text": "พูดอะไรอย่างนั้นคะ"
    },
    {
      "Id": 101480320,
      "Speaker": "Student",
      "Text": "เดิมทีวันหยุดก็ควรนอนพักอยู่เฉยๆ\nถึงจะดีที่สุดค่ะ"
    },
    {
      "Id": 101480330,
      "Speaker": "Player",
      "Text": "พูดเหมือนพนักงานออฟฟิศที่\nหมดไฟเลย..."
    },
    {
      "Id": 101480340,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101480350,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "มาหนีไปด้วยกันมั้ยคะ?"
    },
    {
      "Id": 101480360,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 101480370,
      "Speaker": "Student",
      "Text": "ออกไปเดี๋ยวนี้ด้วยกันเลยมั้ยคะ?"
    },
    {
      "Id": 101480380,
      "Speaker": "Student",
      "Text": "ให้ตายสิ งานบ้าอะไรกันเนี่ย"
    },
    {
      "Id": 101480390,
      "Speaker": "Player",
      "Text": "ก็มันใกล้วันหยุดแล้วนี่นา...!"
    },
    {
      "Id": 101480400,
      "Speaker": "Player",
      "Text": "ยังมีฤดูร้อนหน้าอีกนี่นา!"
    },
    {
      "Id": 101480410,
      "Speaker": "Student",
      "Text": "คะ?"
    },
    {
      "Id": 101480420,
      "Speaker": "Student",
      "Text": "อยากเห็นฉันใส่ชุดว่ายน้ำอีก\nถึงขนาดนั้นเลยเหรอคะ?"
    },
    {
      "Id": 101480430,
      "Speaker": "Player",
      "Text": "ครูไม่ได้พูดเรื่องนั้นสักหน่อย?!"
    },
    {
      "Id": 101480440,
      "Speaker": "Player",
      "Text": "แต่ก็ไม่ใช่ว่าไม่ใช่หรอกนะ...!"
    },
    {
      "Id": 101480450,
      "Speaker": "Student",
      "Text": "อ่า..."
    },
    {
      "Id": 101480460,
      "Speaker": "Student",
      "Text": "เฮ้อ..."
    },
    {
      "Id": 101480470,
      "Speaker": "Player",
      "Text": "สู้หน่อยนะ...!"
    },
    {
      "Id": 101480480,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 101480490,
      "Speaker": "Student",
      "Text": "ก็"
    },
    {
      "Id": 101480500,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ได้ค่ะ"
    }
  ],
  "DialogTW": [
