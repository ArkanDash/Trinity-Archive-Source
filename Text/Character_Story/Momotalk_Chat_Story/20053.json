{
  "CharacterId": 20053,
  "DialogJP": [
    {
      "Id": 200530010,
      "Speaker": "Student",
      "Text": "ドーモ、先生殿"
    },
    {
      "Id": 200530020,
      "Speaker": "Player",
      "Text": "ドーモ、ミチル殿"
    },
    {
      "Id": 200530030,
      "Speaker": "Student",
      "Text": "おぉっ！"
    },
    {
      "Id": 200530040,
      "Speaker": "Student",
      "Text": "先生殿も忍者らしくなってきたね～"
    },
    {
      "Id": 200530050,
      "Speaker": "Student",
      "Text": "そろそろ忍術研究部に入りたくなった？"
    },
    {
      "Id": 200530060,
      "Speaker": "Player",
      "Text": "ところで今日はどうしたの？"
    },
    {
      "Id": 200530070,
      "Speaker": "Student",
      "Text": "スルー！？"
    },
    {
      "Id": 200530080,
      "Speaker": "Student",
      "Text": "うぅ、忍者にも心というものがあるのに……"
    },
    {
      "Id": 200530090,
      "Speaker": "Student",
      "Text": "……えっと、新しい忍術を研究してるんだけど"
    },
    {
      "Id": 200530100,
      "Speaker": "Student",
      "Text": "上手く行かないんだよねー……"
    },
    {
      "Id": 200530110,
      "Speaker": "Student",
      "Text": "ちょっと負傷しちゃって"
    },
    {
      "Id": 200530120,
      "Speaker": "Player",
      "Text": "負傷！？"
    },
    {
      "Id": 200530130,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 200530140,
      "Speaker": "Student",
      "Text": "いや別に大したことないっていうか"
    },
    {
      "Id": 200530150,
      "Speaker": "Player",
      "Text": "すぐ向かう"
    },
    {
      "Id": 200530160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "え？"
    },
    {
      "Id": 200530170,
      "Speaker": "Student",
      "Text": "先生殿"
    },
    {
      "Id": 200530180,
      "Speaker": "Student",
      "Text": "その"
    },
    {
      "Id": 200530190,
      "Speaker": "Student",
      "Text": "ありがとね"
    },
    {
      "Id": 200530200,
      "Speaker": "Student",
      "Text": "買ってもらったのも、大事にするから"
    },
    {
      "Id": 200530210,
      "Speaker": "Student",
      "Text": "あと、さっきはごめん"
    },
    {
      "Id": 200530220,
      "Speaker": "Student",
      "Text": "……いや、やっぱり私は悪くないよね！？"
    },
    {
      "Id": 200530230,
      "Speaker": "Student",
      "Text": "（ボンッ！）←煙幕弾の効果音"
    },
    {
      "Id": 200530240,
      "Speaker": "Student",
      "Text": "ドーモ、先生殿"
    },
    {
      "Id": 200530250,
      "Speaker": "Student",
      "Text": "知らせが舞い込んできた……"
    },
    {
      "Id": 200530260,
      "Speaker": "Student",
      "Text": "傷が完治した、とのこと"
    },
    {
      "Id": 200530270,
      "Speaker": "Player",
      "Text": "……預けたドレスの話？"
    },
    {
      "Id": 200530280,
      "Speaker": "Student",
      "Text": "ふっふっふ！察しが良いね、先生殿！"
    },
    {
      "Id": 200530290,
      "Speaker": "Student",
      "Text": "さぁ、回収に行こーっ！"
    },
    {
      "Id": 200530300,
      "Speaker": "Player",
      "Text": "気をつけてね"
    },
    {
      "Id": 200530310,
      "Speaker": "Student",
      "Text": "何言ってるの？"
    },
    {
      "Id": 200530320,
      "Speaker": "Student",
      "Text": "始まりから終わりまで完璧に"
    },
    {
      "Id": 200530330,
      "Speaker": "Student",
      "Text": "それが忍者の鉄則！"
    },
    {
      "Id": 200530340,
      "Speaker": "Student",
      "Text": "それに、一緒に預けたんだから"
    },
    {
      "Id": 200530350,
      "Speaker": "Student",
      "Text": "受け取る時も一緒！"
    },
    {
      "Id": 200530360,
      "Speaker": "Player",
      "Text": "どういうこと！？"
    },
    {
      "Id": 200530370,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "1時間後、お店の前で待ってるよー！"
    },
    {
      "Id": 200530380,
      "Speaker": "Student",
      "Text": "先生殿"
    },
    {
      "Id": 200530390,
      "Speaker": "Student",
      "Text": "その、急に逃げちゃってごめん……"
    },
    {
      "Id": 200530400,
      "Speaker": "Player",
      "Text": "ミチルに捨てられた……"
    },
    {
      "Id": 200530410,
      "Speaker": "Student",
      "Text": "！？！？"
    },
    {
      "Id": 200530420,
      "Speaker": "Student",
      "Text": "なにいっねゆの！？！？"
    },
    {
      "Id": 200530430,
      "Speaker": "Student",
      "Text": "ついに"
    },
    {
      "Id": 200530440,
      "Speaker": "Student",
      "Text": "見つけてしまった"
    },
    {
      "Id": 200530450,
      "Speaker": "Student",
      "Text": "チャンネルを大きくする秘訣を"
    },
    {
      "Id": 200530460,
      "Speaker": "Student",
      "Text": "そして、その秘訣を手にする方法を……！"
    },
    {
      "Id": 200530470,
      "Speaker": "Player",
      "Text": "急にどうしたの……？"
    },
    {
      "Id": 200530480,
      "Speaker": "Student",
      "Text": "ふっふっふ"
    },
    {
      "Id": 200530490,
      "Speaker": "Student",
      "Text": "なんとなんと"
    },
    {
      "Id": 200530500,
      "Speaker": "Student",
      "Text": "ある説明会の、参加資格を貰ったの！"
    },
    {
      "Id": 200530510,
      "Speaker": "Student",
      "Text": "それに参加するとね"
    },
    {
      "Id": 200530520,
      "Speaker": "Student",
      "Text": "再生数と登録者数を増やす"
    },
    {
      "Id": 200530530,
      "Speaker": "Student",
      "Text": "その秘訣を伝授してくれるんだって！"
    },
    {
      "Id": 200530540,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "……な、なるほど"
    },
    {
      "Id": 200530550,
      "Speaker": "Student",
      "Text": "秘訣は自身の手で、とっておきのを生み出して見せる！"
    },
    {
      "Id": 200530560,
      "Speaker": "Student",
      "Text": "こうご期待！"
    },
    {
      "Id": 200530570,
      "Speaker": "Player",
      "Text": "お待ちしておりますぞ、ミチル殿"
    },
    {
      "Id": 200530580,
      "Speaker": "Student",
      "Text": "にゃははっ、ありがとー先生殿！"
    },
    {
      "Id": 200530590,
      "Speaker": "Student",
      "Text": "ふふっ"
    },
    {
      "Id": 200530600,
      "Speaker": "Student",
      "Text": "ふっふっふっふっふ"
    },
    {
      "Id": 200530610,
      "Speaker": "Student",
      "Text": "ついに分かっちゃったよ、先生殿！"
    },
    {
      "Id": 200530620,
      "Speaker": "Player",
      "Text": "\"な、何のこと？\""
    },
    {
      "Id": 200530630,
      "Speaker": "Student",
      "Text": "それはねー"
    },
    {
      "Id": 200530640,
      "Speaker": "Student",
      "Text": "ううん"
    },
    {
      "Id": 200530650,
      "Speaker": "Student",
      "Text": "やっぱりモモトークじゃなくて"
    },
    {
      "Id": 200530660,
      "Speaker": "Student",
      "Text": "直接話したほうが良いかも！"
    },
    {
      "Id": 200530670,
      "Speaker": "Student",
      "Text": "すぐにそちらへ参ろう！"
    },
    {
      "Id": 200530680,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "待っておれ！"
    },
    {
      "Id": 200530690,
      "Speaker": "Student",
      "Text": "先生殿……"
    },
    {
      "Id": 200530700,
      "Speaker": "Student",
      "Text": "安易に流行を取り入れるのはやめるよ……"
    },
    {
      "Id": 200530710,
      "Speaker": "Student",
      "Text": "真剣に、忍者の道を歩んでいくね……"
    }
  ],
  "DialogKR": [
    {
      "Id": 200530010,
      "Speaker": "Student",
      "Text": "도-모, 선생=공."
    },
    {
      "Id": 200530020,
      "Speaker": "Player",
      "Text": "도-모, 미치루 공."
    },
    {
      "Id": 200530030,
      "Speaker": "Student",
      "Text": "오"
    },
    {
      "Id": 200530040,
      "Speaker": "Student",
      "Text": "점점 닌자가 되어가고 있군!"
    },
    {
      "Id": 200530050,
      "Speaker": "Student",
      "Text": "슬슬 인법연구부로 오는 게 어때?"
    },
    {
      "Id": 200530060,
      "Speaker": "Player",
      "Text": "그래서 무슨 일이라고, 미치루 공?"
    },
    {
      "Id": 200530070,
      "Speaker": "Student",
      "Text": "은근슬쩍 넘겨 버렸어!"
    },
    {
      "Id": 200530080,
      "Speaker": "Student",
      "Text": "우으으, 닌자에게도 마음이라는 것이 있는데……."
    },
    {
      "Id": 200530090,
      "Speaker": "Student",
      "Text": "아무튼, 새로운 인법을 연구 중인데"
    },
    {
      "Id": 200530100,
      "Speaker": "Student",
      "Text": "쉽지 않더라고."
    },
    {
      "Id": 200530110,
      "Speaker": "Student",
      "Text": "그 과정에서 부상도 발생하고……"
    },
    {
      "Id": 200530120,
      "Speaker": "Player",
      "Text": "부상?! 무슨 일이야?!"
    },
    {
      "Id": 200530130,
      "Speaker": "Student",
      "Text": "응? 아니 별건 아니야."
    },
    {
      "Id": 200530140,
      "Speaker": "Student",
      "Text": "아무튼 그래서 말이지……"
    },
    {
      "Id": 200530150,
      "Speaker": "Player",
      "Text": "일단 지금 바로 갈게."
    },
    {
      "Id": 200530160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "엣?"
    },
    {
      "Id": 200530170,
      "Speaker": "Student",
      "Text": "선생 공"
    },
    {
      "Id": 200530180,
      "Speaker": "Student",
      "Text": "운동복, 잘 입겠소이다"
    },
    {
      "Id": 200530190,
      "Speaker": "Student",
      "Text": "그리고"
    },
    {
      "Id": 200530200,
      "Speaker": "Student",
      "Text": "그…… 고마워……."
    },
    {
      "Id": 200530210,
      "Speaker": "Student",
      "Text": "그리고 아까는…… 미안했……."
    },
    {
      "Id": 200530220,
      "Speaker": "Student",
      "Text": "아냐! 우냐악! 역시 안 미안해!!"
    },
    {
      "Id": 200530230,
      "Speaker": "Student",
      "Text": "(퍼버버벙!) <- 연막탄 터뜨리는 소리"
    },
    {
      "Id": 200530240,
      "Speaker": "Student",
      "Text": "선생=공"
    },
    {
      "Id": 200530250,
      "Speaker": "Student",
      "Text": "비로소, 부상이 완치되었다는"
    },
    {
      "Id": 200530260,
      "Speaker": "Student",
      "Text": "그런 낭보가 날아들었소이다."
    },
    {
      "Id": 200530270,
      "Speaker": "Player",
      "Text": "……수선 맡겼던 드레스 얘기지?"
    },
    {
      "Id": 200530280,
      "Speaker": "Student",
      "Text": "와하핫! 눈치가 빠르군, 선생=공!"
    },
    {
      "Id": 200530290,
      "Speaker": "Student",
      "Text": "그러면 이제 병문안을 가야 하는 법!"
    },
    {
      "Id": 200530300,
      "Speaker": "Player",
      "Text": "응! 잘 다녀와, 미치루!"
    },
    {
      "Id": 200530310,
      "Speaker": "Student",
      "Text": "응? 무슨 소리야 선생 공."
    },
    {
      "Id": 200530320,
      "Speaker": "Student",
      "Text": "시작과 끝은 같아야 하는 법!"
    },
    {
      "Id": 200530330,
      "Speaker": "Student",
      "Text": "그것이 닌자의 도리!"
    },
    {
      "Id": 200530340,
      "Speaker": "Student",
      "Text": "함께 가서 맡겼으니"
    },
    {
      "Id": 200530350,
      "Speaker": "Student",
      "Text": "찾아올 때도 같이 가야지!"
    },
    {
      "Id": 200530360,
      "Speaker": "Player",
      "Text": "그런 거였어……?!"
    },
    {
      "Id": 200530370,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "한 시간 뒤 수선집 앞에서 보자고!"
    },
    {
      "Id": 200530380,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 200530390,
      "Speaker": "Student",
      "Text": "도망쳐서…… 죄송합니다……"
    },
    {
      "Id": 200530400,
      "Speaker": "Player",
      "Text": "흑흑 미치루에게 버려졌어……"
    },
    {
      "Id": 200530410,
      "Speaker": "Student",
      "Text": "우와아악!"
    },
    {
      "Id": 200530420,
      "Speaker": "Student",
      "Text": "머;ㅣㄴ얾ㅁㄴ이뱦케ㅐ베;ㅓㅣㅇ럼;"
    },
    {
      "Id": 200530430,
      "Speaker": "Student",
      "Text": "마침내"
    },
    {
      "Id": 200530440,
      "Speaker": "Student",
      "Text": "찾아내고야 말았소이다."
    },
    {
      "Id": 200530450,
      "Speaker": "Student",
      "Text": "나의 채널을 성장시킬 비책을……!"
    },
    {
      "Id": 200530460,
      "Speaker": "Student",
      "Text": "그리고 그 비책을 얻을 기회를……!"
    },
    {
      "Id": 200530470,
      "Speaker": "Player",
      "Text": "……대체 무슨 일이야?"
    },
    {
      "Id": 200530480,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 200530490,
      "Speaker": "Student",
      "Text": "사실 이번에"
    },
    {
      "Id": 200530500,
      "Speaker": "Student",
      "Text": "어떤 설명회에 응모해서 당첨됐거든!"
    },
    {
      "Id": 200530510,
      "Speaker": "Student",
      "Text": "그런데 그 설명회가! 무려!"
    },
    {
      "Id": 200530520,
      "Speaker": "Student",
      "Text": "조회수와 구독자 수를 폭등시키는……!"
    },
    {
      "Id": 200530530,
      "Speaker": "Student",
      "Text": "그런 비법에 대한 설명회란 말이지!"
    },
    {
      "Id": 200530540,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "어…… 음……. 그렇구나……"
    },
    {
      "Id": 200530550,
      "Speaker": "Student",
      "Text": "기다려, 선생 공."
    },
    {
      "Id": 200530560,
      "Speaker": "Student",
      "Text": "곧 내가 끝내주는 비책을 가지고 돌아올 테니까!"
    },
    {
      "Id": 200530570,
      "Speaker": "Player",
      "Text": "기다리고 있겠습니다, 미치루=공"
    },
    {
      "Id": 200530580,
      "Speaker": "Student",
      "Text": "냐하하! 고마워 선생=공!"
    },
    {
      "Id": 200530590,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 200530600,
      "Speaker": "Student",
      "Text": "우후후후"
    },
    {
      "Id": 200530610,
      "Speaker": "Student",
      "Text": "드디어 알아냈다고, 선생=공!"
    },
    {
      "Id": 200530620,
      "Speaker": "Player",
      "Text": "\"응? 대체 뭘……?\""
    },
    {
      "Id": 200530630,
      "Speaker": "Student",
      "Text": "그건"
    },
    {
      "Id": 200530640,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200530650,
      "Speaker": "Student",
      "Text": "역시 모모톡보다는"
    },
    {
      "Id": 200530660,
      "Speaker": "Student",
      "Text": "직접 보고 말하는 게 좋겠어!"
    },
    {
      "Id": 200530670,
      "Speaker": "Student",
      "Text": "곧 찾아가겠소이다!"
    },
    {
      "Id": 200530680,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "기다리고 있으라고!"
    },
    {
      "Id": 200530690,
      "Speaker": "Student",
      "Text": "앞으로는"
    },
    {
      "Id": 200530700,
      "Speaker": "Student",
      "Text": "엉뚱하게 다른 분야에 손대지 않겠습니다……."
    },
    {
      "Id": 200530710,
      "Speaker": "Student",
      "Text": "우직하게, 오직 닌자의 길만 걸을 것이외다……!"
    }
  ],
  "DialogEN": [
    {
      "Id": 200530010,
      "Speaker": "Student",
      "Text": "Domo, Honorable Sensei."
    },
    {
      "Id": 200530020,
      "Speaker": "Player",
      "Text": "Domo, Honorable Michiru."
    },
    {
      "Id": 200530030,
      "Speaker": "Student",
      "Text": "Oh!"
    },
    {
      "Id": 200530040,
      "Speaker": "Student",
      "Text": "You're sounding more like a real ninja every day!"
    },
    {
      "Id": 200530050,
      "Speaker": "Student",
      "Text": "Do you want to join the Ninjutsu Research Club?"
    },
    {
      "Id": 200530060,
      "Speaker": "Player",
      "Text": "Anyways, what's up, Honorable Michiru?"
    },
    {
      "Id": 200530070,
      "Speaker": "Student",
      "Text": "Sensei used special technique: dodge the question completely!"
    },
    {
      "Id": 200530080,
      "Speaker": "Student",
      "Text": "Boo. Even ninjas have feelings, you know!"
    },
    {
      "Id": 200530090,
      "Speaker": "Student",
      "Text": "Whatever! So, I've been researching a new ninjutsu"
    },
    {
      "Id": 200530100,
      "Speaker": "Student",
      "Text": "but it hasn't been working all that great."
    },
    {
      "Id": 200530110,
      "Speaker": "Student",
      "Text": "I actually hurt myself too..."
    },
    {
      "Id": 200530120,
      "Speaker": "Player",
      "Text": "What? Where?! What happened?"
    },
    {
      "Id": 200530130,
      "Speaker": "Student",
      "Text": "Eh it's nothing."
    },
    {
      "Id": 200530140,
      "Speaker": "Student",
      "Text": "Anyways..."
    },
    {
      "Id": 200530150,
      "Speaker": "Player",
      "Text": "I'm coming. Right now."
    },
    {
      "Id": 200530160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Eh?"
    },
    {
      "Id": 200530170,
      "Speaker": "Student",
      "Text": "Honorable Sensei."
    },
    {
      "Id": 200530180,
      "Speaker": "Student",
      "Text": "I will make good use of the tracksuit"
    },
    {
      "Id": 200530190,
      "Speaker": "Student",
      "Text": "and"
    },
    {
      "Id": 200530200,
      "Speaker": "Student",
      "Text": "Um... Thank you..."
    },
    {
      "Id": 200530210,
      "Speaker": "Student",
      "Text": "And for earlier... I'm"
    },
    {
      "Id": 200530220,
      "Speaker": "Student",
      "Text": "You know what?! No! I'm NOT sorry at all"
    },
    {
      "Id": 200530230,
      "Speaker": "Student",
      "Text": "(Pooofff!) <- Sound of smoke bomb going off"
    },
    {
      "Id": 200530240,
      "Speaker": "Student",
      "Text": "Honorable Sensei"
    },
    {
      "Id": 200530250,
      "Speaker": "Student",
      "Text": "At least! I have heard the news!"
    },
    {
      "Id": 200530260,
      "Speaker": "Student",
      "Text": "The injury has healed!"
    },
    {
      "Id": 200530270,
      "Speaker": "Player",
      "Text": "...You mean the dress? At the tailor?"
    },
    {
      "Id": 200530280,
      "Speaker": "Student",
      "Text": "Wahaha! You're quick to catch on, Honorable Sensei!"
    },
    {
      "Id": 200530290,
      "Speaker": "Student",
      "Text": "This calls for a visit!"
    },
    {
      "Id": 200530300,
      "Speaker": "Player",
      "Text": "Okay! Have a safe trip, Michiru!"
    },
    {
      "Id": 200530310,
      "Speaker": "Student",
      "Text": "Hm? Honorable Sensei, what are you talking about?"
    },
    {
      "Id": 200530320,
      "Speaker": "Student",
      "Text": "The beginning and end must be the same!"
    },
    {
      "Id": 200530330,
      "Speaker": "Student",
      "Text": "That's the way of the ninja!"
    },
    {
      "Id": 200530340,
      "Speaker": "Student",
      "Text": "Since we left it there together,"
    },
    {
      "Id": 200530350,
      "Speaker": "Student",
      "Text": "We have to retrieve it together as well!"
    },
    {
      "Id": 200530360,
      "Speaker": "Player",
      "Text": "Is that how it works...?!"
    },
    {
      "Id": 200530370,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "I'll see you at the tailoring shop in an hour!"
    },
    {
      "Id": 200530380,
      "Speaker": "Student",
      "Text": "Uhm"
    },
    {
      "Id": 200530390,
      "Speaker": "Student",
      "Text": "I'm sorry... for running away..."
    },
    {
      "Id": 200530400,
      "Speaker": "Player",
      "Text": "*sob* Michiru abandoned me..."
    },
    {
      "Id": 200530410,
      "Speaker": "Student",
      "Text": "Aaaah!"
    },
    {
      "Id": 200530420,
      "Speaker": "Student",
      "Text": "ajskdhtkjajakhsdt"
    },
    {
      "Id": 200530430,
      "Speaker": "Student",
      "Text": "Finally,"
    },
    {
      "Id": 200530440,
      "Speaker": "Student",
      "Text": "I have found it."
    },
    {
      "Id": 200530450,
      "Speaker": "Student",
      "Text": "The secret to raise my channel...!"
    },
    {
      "Id": 200530460,
      "Speaker": "Student",
      "Text": "And the opportunity to learn that secret...!"
    },
    {
      "Id": 200530470,
      "Speaker": "Player",
      "Text": "...What's going on?"
    },
    {
      "Id": 200530480,
      "Speaker": "Student",
      "Text": "Fufu."
    },
    {
      "Id": 200530490,
      "Speaker": "Student",
      "Text": "The thing is"
    },
    {
      "Id": 200530500,
      "Speaker": "Student",
      "Text": "I've been invited to a presentation!"
    },
    {
      "Id": 200530510,
      "Speaker": "Student",
      "Text": "And the presentation! Is about!"
    },
    {
      "Id": 200530520,
      "Speaker": "Student",
      "Text": "How to rapidly increase your views and subscribers...!"
    },
    {
      "Id": 200530530,
      "Speaker": "Student",
      "Text": "And all the secrets behind it!"
    },
    {
      "Id": 200530540,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "Uh... Mmm... I see..."
    },
    {
      "Id": 200530550,
      "Speaker": "Student",
      "Text": "Just you wait, Honorable Sensei."
    },
    {
      "Id": 200530560,
      "Speaker": "Student",
      "Text": "I'll be back with an incredible strategy!"
    },
    {
      "Id": 200530570,
      "Speaker": "Player",
      "Text": "I'll be waiting, Honorable Michiru!"
    },
    {
      "Id": 200530580,
      "Speaker": "Student",
      "Text": "Nyahaha! Thank you, Honorable Sensei!"
    },
    {
      "Id": 200530590,
      "Speaker": "Student",
      "Text": "Fufu."
    },
    {
      "Id": 200530600,
      "Speaker": "Student",
      "Text": "Ufufufu"
    },
    {
      "Id": 200530610,
      "Speaker": "Student",
      "Text": "I finally got it, Honorable Sensei!"
    },
    {
      "Id": 200530620,
      "Speaker": "Player",
      "Text": "Hm? Got what...?"
    },
    {
      "Id": 200530630,
      "Speaker": "Student",
      "Text": "That's"
    },
    {
      "Id": 200530640,
      "Speaker": "Student",
      "Text": "Mm"
    },
    {
      "Id": 200530650,
      "Speaker": "Student",
      "Text": "It'd be better to say this in person"
    },
    {
      "Id": 200530660,
      "Speaker": "Student",
      "Text": "than over MomoTalk!"
    },
    {
      "Id": 200530670,
      "Speaker": "Student",
      "Text": "I'll be there soon!"
    },
    {
      "Id": 200530680,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Wait for me!"
    },
    {
      "Id": 200530690,
      "Speaker": "Student",
      "Text": "From now on"
    },
    {
      "Id": 200530700,
      "Speaker": "Student",
      "Text": "I won't venture onto irrelevant topics..."
    },
    {
      "Id": 200530710,
      "Speaker": "Student",
      "Text": "I'll stay firm on my path of ninja...!"
    }
  ],
  "DialogTH": [
    {
      "Id": 200530010,
      "Speaker": "Student",
      "Text": "โดโมะ ท่านอาจารย์"
    },
    {
      "Id": 200530020,
      "Speaker": "Player",
      "Text": "โดโมะ ท่านมิจิรุ"
    },
    {
      "Id": 200530030,
      "Speaker": "Student",
      "Text": "โอ้"
    },
    {
      "Id": 200530040,
      "Speaker": "Student",
      "Text": "เริ่มเหมือนนินจาเข้าทุกวันแล้วนะ!"
    },
    {
      "Id": 200530050,
      "Speaker": "Student",
      "Text": "มาเข้าชมรมวิจัยศาสตร์นินจามั้ยล่ะ?"
    },
    {
      "Id": 200530060,
      "Speaker": "Player",
      "Text": "ว่าแต่มีเรื่องอะไรเหรอ มิจิรุ?"
    },
    {
      "Id": 200530070,
      "Speaker": "Student",
      "Text": "เปลี่ยนเรื่องคุยแบบเนียนๆ เลยสินะ!"
    },
    {
      "Id": 200530080,
      "Speaker": "Student",
      "Text": "อึก... เห็นอย่างนี้นินจาก็มีหัวใจนะ..."
    },
    {
      "Id": 200530090,
      "Speaker": "Student",
      "Text": "แต่ก็เอาเถอะ ตอนนี้ข้าน้อยกำลังฝึก\nศาสตร์นินจาใหม่อยู่"
    },
    {
      "Id": 200530100,
      "Speaker": "Student",
      "Text": "มันไม่ง่ายเลยละ"
    },
    {
      "Id": 200530110,
      "Speaker": "Student",
      "Text": "ระหว่างฝึกก็ได้แผลด้วย..."
    },
    {
      "Id": 200530120,
      "Speaker": "Player",
      "Text": "ได้แผลเหรอ?! ไปฝึกท่าไหนน่ะ?!"
    },
    {
      "Id": 200530130,
      "Speaker": "Student",
      "Text": "หืม? ไม่ใช่เรื่องใหญ่อะไรหรอก"
    },
    {
      "Id": 200530140,
      "Speaker": "Student",
      "Text": "ที่ข้าน้อยจะบอกก็คือ..."
    },
    {
      "Id": 200530150,
      "Speaker": "Player",
      "Text": "ครูจะไปหาเดี๋ยวนี้เลย"
    },
    {
      "Id": 200530160,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "เอ๋?"
    },
    {
      "Id": 200530170,
      "Speaker": "Student",
      "Text": "ท่านอาจารย์"
    },
    {
      "Id": 200530180,
      "Speaker": "Student",
      "Text": "ข้าน้อยจะใส่ชุดกีฬาบ่อยๆ นะ"
    },
    {
      "Id": 200530190,
      "Speaker": "Student",
      "Text": "แล้วก็"
    },
    {
      "Id": 200530200,
      "Speaker": "Student",
      "Text": "ขะ... ขอบคุณนะ"
    },
    {
      "Id": 200530210,
      "Speaker": "Student",
      "Text": "แล้วก็เมื่อกี้... ขอโทษ..."
    },
    {
      "Id": 200530220,
      "Speaker": "Student",
      "Text": "ไม่สิ! ม่าย! ข้าน้อยไม่ขอโทษ!!"
    },
    {
      "Id": 200530230,
      "Speaker": "Student",
      "Text": "(ตู้มมม!) <- เสียงระเบิดควัน"
    },
    {
      "Id": 200530240,
      "Speaker": "Student",
      "Text": "ท่านอาจารย์"
    },
    {
      "Id": 200530250,
      "Speaker": "Student",
      "Text": "ข้าน้อยมีข่าวดีมาบอก"
    },
    {
      "Id": 200530260,
      "Speaker": "Student",
      "Text": "ตอนนี้แผลหายสนิทแล้วละ"
    },
    {
      "Id": 200530270,
      "Speaker": "Player",
      "Text": "หมายถึงชุดที่เอาไปเย็บไว้ใช่มั้ย...?"
    },
    {
      "Id": 200530280,
      "Speaker": "Student",
      "Text": "วะฮะฮ่า! ไหวพริบดีนี่ ท่านอาจารย์!"
    },
    {
      "Id": 200530290,
      "Speaker": "Student",
      "Text": "งั้นก็ถึงเวลาไปรับคนไข้!"
    },
    {
      "Id": 200530300,
      "Speaker": "Player",
      "Text": "อื้อ! เดินทางดีๆ นะ มิจิรุ!"
    },
    {
      "Id": 200530310,
      "Speaker": "Student",
      "Text": "หืม? พูดอะไรน่ะ ท่านอาจารย์"
    },
    {
      "Id": 200530320,
      "Speaker": "Student",
      "Text": "จุดเริ่มต้นกับจุดจบต้องเหมือนกันสิ!"
    },
    {
      "Id": 200530330,
      "Speaker": "Student",
      "Text": "นั่นคือวิถีของนินจานะ!"
    },
    {
      "Id": 200530340,
      "Speaker": "Student",
      "Text": "เราไปส่งคนไข้ด้วยกัน"
    },
    {
      "Id": 200530350,
      "Speaker": "Student",
      "Text": "งั้นก็ต้องไปรับกลับด้วยกันสิ!"
    },
    {
      "Id": 200530360,
      "Speaker": "Player",
      "Text": "เป็นงั้นหรอกเหรอ...?!"
    },
    {
      "Id": 200530370,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "อีก 1 ชั่วโมงเจอกันหน้าร้านเย็บผ้านะ!"
    },
    {
      "Id": 200530380,
      "Speaker": "Student",
      "Text": "เอ่อ"
    },
    {
      "Id": 200530390,
      "Speaker": "Student",
      "Text": "ขอโทษที่... หนีมานะคะ..."
    },
    {
      "Id": 200530400,
      "Speaker": "Player",
      "Text": "ฮือๆ โดนมิจิรุทิ้งจนได้..."
    },
    {
      "Id": 200530410,
      "Speaker": "Student",
      "Text": "ว้ากกก!"
    },
    {
      "Id": 200530420,
      "Speaker": "Student",
      "Text": "ฟหกด่าสวฟหกด่าสว"
    },
    {
      "Id": 200530430,
      "Speaker": "Student",
      "Text": "ในที่สุด"
    },
    {
      "Id": 200530440,
      "Speaker": "Student",
      "Text": "ก็ได้รู้จนได้"
    },
    {
      "Id": 200530450,
      "Speaker": "Student",
      "Text": "เคล็ดลับในการพัฒนาช่องของ\nข้าน้อย...!"
    },
    {
      "Id": 200530460,
      "Speaker": "Student",
      "Text": "และโอกาสในการคว้าเคล็ดลับนั้น...!"
    },
    {
      "Id": 200530470,
      "Speaker": "Player",
      "Text": "นี่มันเรื่องอะไรเหรอ...?"
    },
    {
      "Id": 200530480,
      "Speaker": "Student",
      "Text": "ฮุฮุ"
    },
    {
      "Id": 200530490,
      "Speaker": "Student",
      "Text": "ที่จริงข้าน้อย"
    },
    {
      "Id": 200530500,
      "Speaker": "Student",
      "Text": "ไปฟังสัมมนาบางอย่างมาน่ะ!"
    },
    {
      "Id": 200530510,
      "Speaker": "Student",
      "Text": "งานสัมมนาที่ว่า! ก็คือ!"
    },
    {
      "Id": 200530520,
      "Speaker": "Student",
      "Text": "งานสัมมนาบอกเคล็ดลับ...!"
    },
    {
      "Id": 200530530,
      "Speaker": "Student",
      "Text": "ในการเพิ่มจำนวนยอดวิวกับผู้ติดตาม!"
    },
    {
      "Id": 200530540,
      "Speaker": "Player",
      "StoryEpisode": 3,
      "Text": "อ่า... อืม... งั้นสินะ..."
    },
    {
      "Id": 200530550,
      "Speaker": "Student",
      "Text": "รอหน่อยนะ ท่านอาจารย์"
    },
    {
      "Id": 200530560,
      "Speaker": "Student",
      "Text": "ข้าน้อยจะรีบกลับมาพร้อมเคล็ดลับดีๆ\nเลยละ!"
    },
    {
      "Id": 200530570,
      "Speaker": "Player",
      "Text": "แล้วครูจะรอนะ มิจิรุ"
    },
    {
      "Id": 200530580,
      "Speaker": "Student",
      "Text": "อะฮะฮ่า! ขอบคุณนะ ท่านอาจารย์!"
    },
    {
      "Id": 200530590,
      "Speaker": "Student",
      "Text": "ฮุฮุ"
    },
    {
      "Id": 200530600,
      "Speaker": "Student",
      "Text": "อุฮุฮุฮุฮุ"
    },
    {
      "Id": 200530610,
      "Speaker": "Student",
      "Text": "ในที่สุดก็ได้รู้แล้วละ ท่านอาจารย์!"
    },
    {
      "Id": 200530620,
      "Speaker": "Player",
      "Text": "หืม? รู้อะไรเหรอ...?"
    },
    {
      "Id": 200530630,
      "Speaker": "Student",
      "Text": "ก็รู้ว่า"
    },
    {
      "Id": 200530640,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 200530650,
      "Speaker": "Student",
      "Text": "แทนที่จะบอกทาง MOMOTALK"
    },
    {
      "Id": 200530660,
      "Speaker": "Student",
      "Text": "ข้าน้อยไปหาแล้วบอกเองดีกว่า!"
    },
    {
      "Id": 200530670,
      "Speaker": "Student",
      "Text": "จะไปหาเดี๋ยวนี้ละ!"
    },
    {
      "Id": 200530680,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "รอข้าน้อยก่อนนะ!"
    },
    {
      "Id": 200530690,
      "Speaker": "Student",
      "Text": "ต่อไปนี้"
    },
    {
      "Id": 200530700,
      "Speaker": "Student",
      "Text": "ข้าน้อยจะไม่ไปยุ่มย่ามเรื่องอื่นแล้ว..."
    },
    {
      "Id": 200530710,
      "Speaker": "Student",
      "Text": "ขอเดินตามเส้นทางของนินจาแต่เพียง\nเท่านั้น...!"
    }
  ],
  "DialogTW": [
    {
