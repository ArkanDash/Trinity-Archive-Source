    {
      "Id": 101360210,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "transmitting &@ad*&coordinates."
    },
    {
      "Id": 101360220,
      "Speaker": "Student",
      "Text": "Good work today, Sensei."
    },
    {
      "Id": 101360230,
      "Speaker": "Player",
      "Text": "Another day done..."
    },
    {
      "Id": 101360240,
      "Speaker": "Student",
      "Text": "Yeah."
    },
    {
      "Id": 101360250,
      "Speaker": "Student",
      "Text": "I feel like my internal clock's been off lately."
    },
    {
      "Id": 101360260,
      "Speaker": "Player",
      "Text": "Maybe it's because you've been working inside all day?"
    },
    {
      "Id": 101360270,
      "Speaker": "Student",
      "Text": "Yeah."
    },
    {
      "Id": 101360280,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I think it's time to switch it up a little."
    },
    {
      "Id": 101360290,
      "Speaker": "Student",
      "Text": "Sensei?"
    },
    {
      "Id": 101360300,
      "Speaker": "Student",
      "Text": "Are you okay?"
    },
    {
      "Id": 101360310,
      "Speaker": "Player",
      "Text": "I'm completely fine. Why?"
    },
    {
      "Id": 101360320,
      "Speaker": "Student",
      "Text": "I was worried"
    },
    {
      "Id": 101360330,
      "Speaker": "Student",
      "Text": "that you caught a cold or something."
    },
    {
      "Id": 101360340,
      "Speaker": "Player",
      "Text": "I'm not THAT weak..."
    },
    {
      "Id": 101360350,
      "Speaker": "Student",
      "Text": "Right."
    },
    {
      "Id": 101360360,
      "Speaker": "Student",
      "Text": "That's unfortunate."
    },
    {
      "Id": 101360370,
      "Speaker": "Student",
      "Text": "Wait."
    },
    {
      "Id": 101360380,
      "Speaker": "Student",
      "Text": "I mean, I'm glad to hear it."
    },
    {
      "Id": 101360390,
      "Speaker": "Player",
      "Text": "What's that supposed to mean...?!"
    },
    {
      "Id": 101360400,
      "Speaker": "Player",
      "Text": "Eimi! Be real with me!"
    },
    {
      "Id": 101360410,
      "Speaker": "Student",
      "Text": "It was nothing."
    },
    {
      "Id": 101360420,
      "Speaker": "Student",
      "Text": "I just..."
    },
    {
      "Id": 101360430,
      "Speaker": "Student",
      "Text": "heard once that sharing body heat"
    },
    {
      "Id": 101360440,
      "Speaker": "Student",
      "Text": "is the most efficient way to warm someone up."
    },
    {
      "Id": 101360450,
      "Speaker": "Player",
      "Text": "...Eimi?"
    },
    {
      "Id": 101360460,
      "Speaker": "Player",
      "Text": "Miss Eimi?!"
    }
  ],
