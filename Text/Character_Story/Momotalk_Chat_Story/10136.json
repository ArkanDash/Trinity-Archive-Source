    {
      "Id": 101360380,
      "Speaker": "Student",
      "Text": "よかった"
    },
    {
      "Id": 101360390,
      "Speaker": "Player",
      "Text": "なんか言おうとした？"
    },
    {
      "Id": 101360400,
      "Speaker": "Player",
      "Text": "素直に白状しなさい！"
    },
    {
      "Id": 101360410,
      "Speaker": "Student",
      "Text": "何でもない"
    },
    {
      "Id": 101360420,
      "Speaker": "Student",
      "Text": "ただ"
    },
    {
      "Id": 101360430,
      "Speaker": "Student",
      "Text": "温めるのに一番効率的なのは"
    },
    {
      "Id": 101360440,
      "Speaker": "Student",
      "Text": "体温っていうからね"
    },
    {
      "Id": 101360450,
      "Speaker": "Player",
      "Text": "……それって？"
    },
    {
      "Id": 101360460,
      "Speaker": "Player",
      "Text": "……エイミ！？エイミさん！？"
    }
  ],
  "DialogKR": [
    {
