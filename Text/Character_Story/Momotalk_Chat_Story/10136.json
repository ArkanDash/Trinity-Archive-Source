      "Id": 101360160,
      "Speaker": "Student",
      "Text": "Sensei!#@$%!^?"
    },
    {
      "Id": 101360170,
      "Speaker": "Player",
      "Text": "Eimi?"
    },
    {
      "Id": 101360180,
      "Speaker": "Student",
      "Text": "I'm gl@^#*&ad."
    },
    {
      "Id": 101360190,
      "Speaker": "Student",
      "Text": "This is probably"
    },
    {
      "Id": 101360200,
      "Speaker": "Student",
      "Text": "the la*&#SAst battery"
