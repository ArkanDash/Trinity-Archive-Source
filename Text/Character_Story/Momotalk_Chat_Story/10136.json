      "Text": "ちょっと気分転換しようかなって"
    },
    {
      "Id": 101360290,
      "Speaker": "Student",
      "Text": "先生？"
    },
    {
      "Id": 101360300,
      "Speaker": "Student",
      "Text": "大丈夫？"
    },
    {
      "Id": 101360310,
      "Speaker": "Player",
      "Text": "大丈夫だよ。どうしたの？"
    },
    {
      "Id": 101360320,
