    {
      "Id": 101360330,
      "Speaker": "Student",
      "Text": "心配になって"
    },
    {
      "Id": 101360340,
      "Speaker": "Player",
      "Text": "そこまで弱くないよ……"
    },
    {
      "Id": 101360350,
      "Speaker": "Student",
      "Text": "そっか"
    },
    {
      "Id": 101360360,
      "Speaker": "Student",
      "Text": "ちょっと残念"
    },
    {
      "Id": 101360370,
      "Speaker": "Student",
      "Text": "うそ"
