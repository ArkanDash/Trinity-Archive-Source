  "DialogEN": [
    {
      "Id": 101360010,
      "Speaker": "Student",
      "Text": "Did you sleep well, Sensei?"
    },
    {
      "Id": 101360020,
      "Speaker": "Student",
      "Text": "Sensei?"
    },
    {
      "Id": 101360030,
      "Speaker": "Student",
      "Text": "Hello?"
    },
    {
      "Id": 101360040,
      "Speaker": "Player",
      "Text": "whaa"
    },
    {
      "Id": 101360050,
      "Speaker": "Player",
      "Text": "Thanks for waking me, Eimi..."
    },
    {
      "Id": 101360060,
      "Speaker": "Student",
      "Text": "Glad you're up."
    },
    {
      "Id": 101360070,
      "Speaker": "Student",
