    },
    {
      "Id": 101360260,
      "Speaker": "Player",
      "Text": "今日はほとんど室内にいたからね"
    },
    {
      "Id": 101360270,
      "Speaker": "Student",
      "Text": "うん、それでなんだけど……"
    },
    {
      "Id": 101360280,
      "Speaker": "Student",
