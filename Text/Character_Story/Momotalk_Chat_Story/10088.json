{
  "CharacterId": 10088,
  "DialogJP": [
    {
      "Id": 100880010,
      "Speaker": "Student",
      "Text": "何というか"
    },
    {
      "Id": 100880020,
      "Speaker": "Student",
      "Text": "予想してたことだけど……この人混みはちょっと疲れるかも"
    },
    {
      "Id": 100880030,
      "Speaker": "Student",
      "Text": "当面の仕事は終わっているし"
    },
    {
      "Id": 100880040,
      "Speaker": "Student",
      "Text": "ちょっと休もうかな"
    },
    {
      "Id": 100880050,
      "Speaker": "Player",
      "Text": "カヨコも休憩するの？"
    },
    {
      "Id": 100880060,
      "Speaker": "Player",
      "Text": "どこか良さげな場所でもある？"
    },
    {
      "Id": 100880070,
      "Speaker": "Student",
      "Text": "ふふ"
    },
    {
      "Id": 100880080,
      "Speaker": "Student",
      "Text": "先生も疲れたんだ"
    },
    {
      "Id": 100880090,
      "Speaker": "Student",
      "Text": "……そうだね"
    },
    {
      "Id": 100880100,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ちょうどいい場所あるよ"
    },
    {
      "Id": 100880110,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100880120,
      "Speaker": "Student",
      "Text": "一応、いっておくけど……"
    },
    {
      "Id": 100880130,
      "Speaker": "Player",
      "Text": "また必要になったら、いつでも呼んで"
    },
    {
      "Id": 100880140,
      "Speaker": "Player",
      "Text": "大丈夫、みんなには内緒にするから"
    },
    {
      "Id": 100880150,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 100880160,
      "Speaker": "Student",
      "Text": "ありがとう"
    },
    {
      "Id": 100880170,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100880180,
      "Speaker": "Student",
      "Text": "今日、事務所に来るって言ってたよね"
    },
    {
      "Id": 100880190,
      "Speaker": "Player",
      "Text": "うん。何か急な仕事でも入った？"
    },
    {
      "Id": 100880200,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 100880210,
      "Speaker": "Student",
      "Text": "ただ、その時間帯だとまだ誰もいないと思うから"
    },
    {
      "Id": 100880220,
      "Speaker": "Student",
      "Text": "私が事務所開けておくね"
    },
    {
      "Id": 100880230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "じゃあ、待っているね"
    },
    {
      "Id": 100880240,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100880250,
      "Speaker": "Student",
      "Text": "あとで時間もらえる？"
    },
    {
      "Id": 100880260,
      "Speaker": "Player",
      "Text": "カヨコ？"
    },
    {
      "Id": 100880270,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100880280,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 100880290,
      "Speaker": "Student",
      "Text": "大したことじゃないけど"
    },
    {
      "Id": 100880300,
      "Speaker": "Student",
      "Text": "この前のお返し、みたいのがしたくて"
    },
    {
      "Id": 100880310,
      "Speaker": "Student",
      "Text": "とにかく、いつでもいいから言って"
    },
    {
      "Id": 100880320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "こっちで合わせるから"
    },
    {
      "Id": 100880330,
      "Speaker": "Student",
      "Text": "あ"
    },
    {
      "Id": 100880340,
      "Speaker": "Student",
      "Text": "ひとつ言いそびれたけど"
    },
    {
      "Id": 100880350,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 100880360,
      "Speaker": "Player",
      "Text": "……カヨコ？"
    },
    {
      "Id": 100880370,
      "Speaker": "Player",
      "Text": "言いそびれたことって？"
    },
    {
      "Id": 100880380,
      "Speaker": "Student",
      "Text": "うーん"
    },
    {
      "Id": 100880390,
      "Speaker": "Student",
      "Text": "やっぱり"
    },
    {
      "Id": 100880400,
      "Speaker": "Student",
      "Text": "今はいいかな"
    },
    {
      "Id": 100880410,
      "Speaker": "Student",
      "Text": "あとで"
    },
    {
      "Id": 100880420,
      "Speaker": "Student",
      "Text": "改めて話すから"
    },
    {
      "Id": 100880430,
      "Speaker": "Student",
      "Text": "じゃあ"
    },
    {
      "Id": 100880440,
      "Speaker": "Student",
      "Text": "またね、先生"
    }
  ],
  "DialogKR": [
    {
      "Id": 100880010,
      "Speaker": "Student",
      "Text": "뭐랄까"
    },
    {
      "Id": 100880020,
      "Speaker": "Student",
      "Text": "예상은 했지만 사람 많은 곳은 피곤하네."
    },
    {
      "Id": 100880030,
      "Speaker": "Student",
      "Text": "일단 해야 할 일은 다 했고……."
    },
    {
      "Id": 100880040,
      "Speaker": "Student",
      "Text": "잠시 쉬어야겠어."
    },
    {
      "Id": 100880050,
      "Speaker": "Player",
      "Text": "카요코? 쉰다고?"
    },
    {
      "Id": 100880060,
      "Speaker": "Player",
      "Text": "어디 좋은 장소라도 있어?"
    },
    {
      "Id": 100880070,
      "Speaker": "Student",
      "Text": "후후"
    },
    {
      "Id": 100880080,
      "Speaker": "Student",
      "Text": "선생도 지친 모양이네."
    },
    {
      "Id": 100880090,
      "Speaker": "Student",
      "Text": "뭐"
    },
    {
      "Id": 100880100,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "마침 잘 됐나."
    },
    {
      "Id": 100880110,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 100880120,
      "Speaker": "Student",
      "Text": "혹시나 해서 하는 말인데"
    },
    {
      "Id": 100880130,
      "Speaker": "Player",
      "Text": "필요하면 또 말해"
    },
    {
      "Id": 100880140,
      "Speaker": "Player",
      "Text": "누구한테 말할 생각 없으니 걱정 마"
    },
    {
      "Id": 100880150,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 100880160,
      "Speaker": "Student",
      "Text": "고마워."
    },
    {
      "Id": 100880170,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 100880180,
      "Speaker": "Student",
      "Text": "사무실에 들를 일이 있다고 들었는데"
    },
    {
      "Id": 100880190,
      "Speaker": "Player",
      "Text": "응. 무슨 일 있어?"
    },
    {
      "Id": 100880200,
      "Speaker": "Student",
      "Text": "아니."
    },
    {
      "Id": 100880210,
      "Speaker": "Student",
      "Text": "그냥 그 시간대에는 사무실에 사람이 딱히 없을 거라"
    },
    {
      "Id": 100880220,
      "Speaker": "Student",
      "Text": "아마 내가 맞이하게 될 거 같아서."
    },
    {
      "Id": 100880230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그럼 그때 봐, 선생."
    },
    {
      "Id": 100880240,
      "Speaker": "Student",
      "Text": "선생"
    },
    {
      "Id": 100880250,
      "Speaker": "Student",
      "Text": "혹시 나중에라도 시간 좀 괜찮을까?"
    },
    {
      "Id": 100880260,
      "Speaker": "Player",
      "Text": "카요코?"
    },
    {
      "Id": 100880270,
      "Speaker": "Player",
      "Text": "응? 무슨 일이야?"
    },
    {
      "Id": 100880280,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 100880290,
      "Speaker": "Student",
      "Text": "대단한 일은 아니고."
    },
    {
      "Id": 100880300,
      "Speaker": "Student",
      "Text": "이전에 받은 일에 대한 답례 같은 건데."
    },
    {
      "Id": 100880310,
      "Speaker": "Student",
      "Text": "아무튼 괜찮은 날이 있으면 언제든 말해줘."
    },
    {
      "Id": 100880320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "나머지는 이쪽에서 맞출 테니까."
    },
    {
      "Id": 100880330,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100880340,
      "Speaker": "Student",
      "Text": "한 가지 잊고 말하지 않은 게 있어"
    },
    {
      "Id": 100880350,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100880360,
      "Speaker": "Player",
      "Text": "……카요코?"
    },
    {
      "Id": 100880370,
      "Speaker": "Player",
      "Text": "말하지 않은 거?"
    },
    {
      "Id": 100880380,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100880390,
      "Speaker": "Student",
      "Text": "아냐"
    },
    {
      "Id": 100880400,
      "Speaker": "Student",
      "Text": "역시 지금은 됐어."
    },
    {
      "Id": 100880410,
      "Speaker": "Student",
      "Text": "나중에"
    },
    {
      "Id": 100880420,
      "Speaker": "Student",
      "Text": "따로 기회가 되면 이야기하지, 뭐."
    },
    {
      "Id": 100880430,
      "Speaker": "Student",
      "Text": "그럼"
    },
    {
      "Id": 100880440,
      "Speaker": "Student",
      "Text": "조심해서 돌아가, 선생."
    }
  ],
  "DialogEN": [
    {
      "Id": 100880010,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 100880020,
      "Speaker": "Student",
      "Text": "I knew crowds were exhausting. And I was right."
    },
    {
      "Id": 100880030,
      "Speaker": "Student",
      "Text": "I'm done for the day."
    },
    {
      "Id": 100880040,
      "Speaker": "Student",
      "Text": "I need a break."
    },
    {
      "Id": 100880050,
      "Speaker": "Player",
      "Text": "Catching your breath?"
    },
    {
      "Id": 100880060,
      "Speaker": "Player",
      "Text": "Where are you thinking of relaxing?"
    },
    {
      "Id": 100880070,
      "Speaker": "Student",
      "Text": "Heehee."
    },
    {
      "Id": 100880080,
      "Speaker": "Student",
      "Text": "Even someone like you gets tired too."
    },
    {
      "Id": 100880090,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 100880100,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Maybe it's for the best."
    },
    {
      "Id": 100880110,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100880120,
      "Speaker": "Student",
      "Text": "Maybe I don't need to say it but..."
    },
    {
      "Id": 100880130,
      "Speaker": "Player",
      "Text": "If you need anything else, let me know."
    },
    {
      "Id": 100880140,
      "Speaker": "Player",
      "Text": "Don't worry. I'll carry this to my grave."
    },
    {
      "Id": 100880150,
      "Speaker": "Student",
      "Text": "Great,"
    },
    {
      "Id": 100880160,
      "Speaker": "Student",
      "Text": "thanks."
    },
    {
      "Id": 100880170,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100880180,
      "Speaker": "Student",
      "Text": "I heard you had business at our office."
    },
    {
      "Id": 100880190,
      "Speaker": "Player",
      "Text": "Yeah. Is something wrong?"
    },
    {
      "Id": 100880200,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100880210,
      "Speaker": "Student",
      "Text": "I figured the office would be empty by now."
    },
    {
      "Id": 100880220,
      "Speaker": "Student",
      "Text": "Looks like I'm the welcome wagon."
    },
    {
      "Id": 100880230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "See you soon, Sensei."
    },
    {
      "Id": 100880240,
      "Speaker": "Student",
      "Text": "Sensei."
    },
    {
      "Id": 100880250,
      "Speaker": "Student",
      "Text": "Any chance you're free later?"
    },
    {
      "Id": 100880260,
      "Speaker": "Player",
      "Text": "Oh, Kayoko."
    },
    {
      "Id": 100880270,
      "Speaker": "Player",
      "Text": "What is it?"
    },
    {
      "Id": 100880280,
      "Speaker": "Student",
      "Text": "Well,"
    },
    {
      "Id": 100880290,
      "Speaker": "Student",
      "Text": "it's nothing serious..."
    },
    {
      "Id": 100880300,
      "Speaker": "Student",
      "Text": "Just my way of saying thanks for earlier."
    },
    {
      "Id": 100880310,
      "Speaker": "Student",
      "Text": "Anyway, let me know when you're free."
    },
    {
      "Id": 100880320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "I'll handle the rest."
    },
    {
      "Id": 100880330,
      "Speaker": "Student",
      "Text": "Oh"
    },
    {
      "Id": 100880340,
      "Speaker": "Student",
      "Text": "there's something I forgot to tell you."
    },
    {
      "Id": 100880350,
      "Speaker": "Student",
      "Text": "Um"
    },
    {
      "Id": 100880360,
      "Speaker": "Player",
      "Text": "...Kayoko?"
    },
    {
      "Id": 100880370,
      "Speaker": "Player",
      "Text": "What did you forget? Do you need me to find it?"
    },
    {
      "Id": 100880380,
      "Speaker": "Student",
      "Text": "Um"
    },
    {
      "Id": 100880390,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100880400,
      "Speaker": "Student",
      "Text": "It's fine."
    },
    {
      "Id": 100880410,
      "Speaker": "Student",
      "Text": "We can talk later..."
    },
    {
      "Id": 100880420,
      "Speaker": "Student",
      "Text": "I'll tell you then."
    },
    {
      "Id": 100880430,
      "Speaker": "Student",
      "Text": "Well then"
    },
    {
      "Id": 100880440,
      "Speaker": "Student",
      "Text": "have a safe walk back, Sensei."
    }
  ],
  "DialogTH": [
    {
      "Id": 100880010,
      "Speaker": "Student",
      "Text": "จะว่ายังไงดีนะ"
    },
    {
      "Id": 100880020,
      "Speaker": "Student",
      "Text": "ฉันกะไว้แล้วละ แต่ที่ที่คนเยอะๆ มันทำ\nให้ฉันเหนื่อยจัง"
    },
    {
      "Id": 100880030,
      "Speaker": "Student",
      "Text": "ทำสิ่งที่ต้องทำวันนี้หมดแล้ว..."
    },
    {
      "Id": 100880040,
      "Speaker": "Student",
      "Text": "คงต้องไปพักสักหน่อย"
    },
    {
      "Id": 100880050,
      "Speaker": "Player",
      "Text": "คาโยโกะ? จะไปพักเหรอ?"
    },
    {
      "Id": 100880060,
      "Speaker": "Player",
      "Text": "มีที่ไหนดีๆ บ้างมั้ย?"
    },
    {
      "Id": 100880070,
      "Speaker": "Student",
      "Text": "ฮุฮุ"
    },
    {
      "Id": 100880080,
      "Speaker": "Student",
      "Text": "เหมือนครูก็จะเหนื่อยมาเหมือนกันแฮะ"
    },
    {
      "Id": 100880090,
      "Speaker": "Student",
      "Text": "งั้นก็"
    },
    {
      "Id": 100880100,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ถือว่าได้จังหวะเลย"
    },
    {
      "Id": 100880110,
      "Speaker": "Student",
      "Text": "ครู"
    },
    {
      "Id": 100880120,
      "Speaker": "Student",
      "Text": "ฉันแค่พูดไว้เผื่อๆ นะ"
    },
    {
      "Id": 100880130,
      "Speaker": "Player",
      "Text": "ถ้าต้องการอะไรก็บอกล่ะ"
    },
    {
      "Id": 100880140,
      "Speaker": "Player",
      "Text": "ครูไม่ไปบอกใครหรอก ไม่ต้องห่วง"
    },
    {
      "Id": 100880150,
      "Speaker": "Student",
      "Text": "อื้ม"
    },
    {
      "Id": 100880160,
      "Speaker": "Student",
      "Text": "ขอบใจนะ"
    },
    {
      "Id": 100880170,
      "Speaker": "Student",
      "Text": "ครู"
    },
    {
      "Id": 100880180,
      "Speaker": "Student",
      "Text": "ได้ยินว่ามีธุระก็เลยจะเข้ามาที่\nสำนักงานเหรอ?"
    },
    {
      "Id": 100880190,
      "Speaker": "Player",
      "Text": "อื้ม มีอะไรเหรอ?"
    },
    {
      "Id": 100880200,
      "Speaker": "Student",
      "Text": "ไม่หรอก"
    },
    {
      "Id": 100880210,
      "Speaker": "Student",
      "Text": "ก็แค่ตอนนั้นไม่น่ามีใครอยู่ที่สำนักงาน"
    },
    {
      "Id": 100880220,
      "Speaker": "Student",
      "Text": "ฉันเลยคิดว่าคงไปต้อนรับได้"
    },
    {
      "Id": 100880230,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "งั้นเจอกันตอนนั้นนะครู"
    },
    {
      "Id": 100880240,
      "Speaker": "Student",
      "Text": "ครู"
    },
    {
      "Id": 100880250,
      "Speaker": "Student",
      "Text": "หลังจากนี้พอมีเวลาบ้างมั้ย?"
    },
    {
      "Id": 100880260,
      "Speaker": "Player",
      "Text": "คาโยโกะ?"
    },
    {
      "Id": 100880270,
      "Speaker": "Player",
      "Text": "หืม? มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 100880280,
      "Speaker": "Student",
      "Text": "เปล่าหรอก"
    },
    {
      "Id": 100880290,
      "Speaker": "Student",
      "Text": "ไม่ใช่เรื่องใหญ่อะไร"
    },
    {
      "Id": 100880300,
      "Speaker": "Student",
      "Text": "ฉันอยากตอบแทนเรื่องที่เคยช่วยไว้\nคราวก่อน"
    },
    {
      "Id": 100880310,
      "Speaker": "Student",
      "Text": "เอาเป็นว่าวันไหนว่างก็บอกหน่อยนะ"
    },
    {
      "Id": 100880320,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "แล้วฉันจะหาเวลาให้ตรงกันเอง"
    },
    {
      "Id": 100880330,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 100880340,
      "Speaker": "Student",
      "Text": "ฉันลืมบอกอะไรไปหนึ่งอย่าง"
    },
    {
      "Id": 100880350,
