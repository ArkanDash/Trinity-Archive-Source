{
  "CharacterId": 20058,
  "DialogJP": [
    {
      "Id": 200580010,
      "Speaker": "Student",
      "Text": "やっほ、先生"
    },
    {
      "Id": 200580020,
      "Speaker": "Player",
      "Text": "エリカであってる？"
    },
    {
      "Id": 200580030,
      "Speaker": "Player",
      "Text": "こんにちは"
    },
    {
      "Id": 200580040,
      "Speaker": "Student",
      "Text": "あ、良かった"
    },
    {
      "Id": 200580050,
      "Speaker": "Student",
      "Text": "登録してくれてたんだ"
    },
    {
      "Id": 200580060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "なんか嬉しいかも笑"
    },
    {
      "Id": 200580070,
      "Speaker": "Student",
      "Text": "今日はごめんね"
    },
    {
      "Id": 200580080,
      "Speaker": "Student",
      "Text": "先生はあまり興味ないのに"
    },
    {
      "Id": 200580090,
      "Speaker": "Student",
      "Text": "連れ回しちゃったかもだけど……"
    },
    {
      "Id": 200580100,
      "Speaker": "Player",
      "Text": "全然。楽しかったよ！"
    },
    {
      "Id": 200580110,
      "Speaker": "Player",
      "Text": "エリカの好み探しだね"
    },
    {
      "Id": 200580120,
      "Speaker": "Student",
      "Text": "わお"
    },
    {
      "Id": 200580130,
      "Speaker": "Student",
      "Text": "そんな風に言ってくれるなんて、ちょっと意外"
    },
    {
      "Id": 200580140,
      "Speaker": "Student",
      "Text": "楽しかった！ありがとね"
    },
    {
      "Id": 200580150,
      "Speaker": "Student",
      "Text": "前言ってたやつ、買えたよ！"
    },
    {
      "Id": 200580160,
      "Speaker": "Player",
      "Text": "お、よかった！"
    },
    {
      "Id": 200580170,
      "Speaker": "Student",
      "Text": "えへへ。これが欲しくて"
    },
    {
      "Id": 200580180,
      "Speaker": "Student",
      "Text": "D.U.のお店ぜーんぶみて回ったんだから！"
    },
    {
      "Id": 200580190,
      "Speaker": "Player",
      "Text": "こんな時間まで？"
    },
    {
      "Id": 200580200,
      "Speaker": "Student",
      "Text": "そうなんだよね。夢中になってたらこんな時間になっちゃった笑"
    },
    {
      "Id": 200580210,
      "Speaker": "Student",
      "Text": "夜ご飯食べる時間もなかったよ～"
    },
    {
      "Id": 200580220,
      "Speaker": "Player",
      "Text": "私も！"
    },
    {
      "Id": 200580230,
      "Speaker": "Student",
      "Text": "お、先生いまどこにいるの？"
    },
    {
      "Id": 200580240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "よかったら一緒にご飯食べない？"
    },
    {
      "Id": 200580250,
      "Speaker": "Student",
      "Text": "先生、今日もありがとね"
    },
    {
      "Id": 200580260,
      "Speaker": "Student",
      "Text": "ご馳走してもらった上に送ってもらっちゃって……"
    },
    {
      "Id": 200580270,
      "Speaker": "Student",
      "Text": "ちょっと優しすぎない？"
    },
    {
      "Id": 200580280,
      "Speaker": "Player",
      "Text": "時間も遅いからね"
    },
    {
      "Id": 200580290,
      "Speaker": "Student",
      "Text": "まぁそれもそっか"
    },
    {
      "Id": 200580300,
      "Speaker": "Student",
      "Text": "ありがと"
    },
    {
      "Id": 200580310,
      "Speaker": "Student",
      "Text": "今度は私が奢るね！"
    },
    {
      "Id": 200580320,
      "Speaker": "Player",
      "Text": "今度はトマトくれる？"
    },
    {
      "Id": 200580330,
      "Speaker": "Student",
      "Text": "まだ引っ張ってるのそれ笑"
    },
    {
      "Id": 200580340,
      "Speaker": "Student",
      "Text": "ん～どうしよっかな？"
    },
    {
      "Id": 200580350,
      "Speaker": "Student",
      "Text": "あつーい。マジヤバくない？"
    },
    {
      "Id": 200580360,
      "Speaker": "Player",
      "Text": "ね、今日やばいね"
    },
    {
      "Id": 200580370,
      "Speaker": "Student",
      "Text": "ほんと笑笑"
    },
    {
      "Id": 200580380,
      "Speaker": "Student",
      "Text": "外出る時は"
    },
    {
      "Id": 200580390,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ちゃんと水分とるんだよ～！"
    },
    {
      "Id": 200580400,
      "Speaker": "Student",
      "Text": "あ、そうだ"
    },
    {
      "Id": 200580410,
      "Speaker": "Student",
      "Text": "手を洗ったりした時はちゃんと絆創膏変えるんだよ"
    },
    {
      "Id": 200580420,
      "Speaker": "Student",
      "Text": "雑菌繁殖しちゃうからね"
    },
    {
      "Id": 200580430,
      "Speaker": "Player",
      "Text": "これ可愛いのに"
    },
    {
      "Id": 200580440,
      "Speaker": "Student",
      "Text": "傷の治りが遅くなるからダメ"
    },
    {
      "Id": 200580450,
      "Speaker": "Student",
      "Text": "てか、それ気に入ってくれたんだ？"
    },
    {
      "Id": 200580460,
      "Speaker": "Player",
      "Text": "これどこで売ってるの？"
    },
    {
      "Id": 200580470,
      "Speaker": "Student",
      "Text": "教えませーん"
    },
    {
      "Id": 200580480,
      "Speaker": "Student",
      "Text": "また怪我しないでよ？"
    },
    {
      "Id": 200580490,
      "Speaker": "Student",
      "Text": "暇な時間ある？"
    },
    {
      "Id": 200580500,
      "Speaker": "Student",
      "Text": "会えたら嬉しいんだけど"
    },
    {
      "Id": 200580510,
      "Speaker": "Player",
      "Text": "何かあったの？"
    },
    {
      "Id": 200580520,
      "Speaker": "Student",
      "Text": "んー"
    },
    {
      "Id": 200580530,
      "Speaker": "Student",
      "Text": "ちょっと相談したいことがあって"
    },
    {
      "Id": 200580540,
      "Speaker": "Student",
      "Text": "話せたらなーと"
    },
    {
      "Id": 200580550,
      "Speaker": "Player",
      "Text": "今からとかどうかな？"
    },
    {
      "Id": 200580560,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "今から！？"
    },
    {
      "Id": 200580570,
      "Speaker": "Student",
      "Text": "友達にも言ってみようかな？"
    },
    {
      "Id": 200580580,
      "Speaker": "Student",
      "Text": "たまには一人の時間も必要かもって"
    },
    {
      "Id": 200580590,
      "Speaker": "Student",
      "Text": "んー、でもなんか"
    },
    {
      "Id": 200580600,
      "Speaker": "Student",
      "Text": "私のキャラと違う気がするかな"
    },
    {
      "Id": 200580610,
      "Speaker": "Player",
      "Text": "エリカってキャラ作ってたんだ？"
    },
    {
      "Id": 200580620,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200580630,
      "Speaker": "Player",
      "Text": "そうだったんだ！？"
    },
    {
      "Id": 200580640,
      "Speaker": "Student",
      "Text": "意地悪な人"
    },
    {
      "Id": 200580650,
      "Speaker": "Student",
      "Text": "先生、今日の空見た？"
    },
    {
      "Id": 200580660,
      "Speaker": "Player",
      "Text": "見れてないけど、どうかした？"
    },
    {
      "Id": 200580670,
      "Speaker": "Player",
      "Text": "いま地下鉄に乗ってて"
    },
    {
      "Id": 200580680,
      "Speaker": "Student",
      "Text": "すごい綺麗なんだ"
    },
    {
      "Id": 200580690,
      "Speaker": "Student",
      "Text": "外出たらちょっと見てみて"
    },
    {
      "Id": 200580700,
      "Speaker": "Student",
      "Text": "絶対感動するから"
    },
    {
      "Id": 200580710,
      "Speaker": "Player",
      "Text": "信じるからね？"
    },
    {
      "Id": 200580720,
      "Speaker": "Student",
      "Text": "いやいや笑"
    },
    {
      "Id": 200580730,
      "Speaker": "Student",
      "Text": "こんなことで嘘つかないから！"
    },
    {
      "Id": 200580740,
      "Speaker": "Player",
      "Text": "今ゲヘナに向かってるとこなんだ"
    },
    {
      "Id": 200580750,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "えっ！？"
    },
    {
      "Id": 200580760,
      "Speaker": "Student",
      "Text": "今日は穏やかな一日だったね"
    },
    {
      "Id": 200580770,
      "Speaker": "Player",
      "Text": "そうだね"
    },
    {
      "Id": 200580780,
      "Speaker": "Student",
      "Text": "私はあの後から"
    },
    {
      "Id": 200580790,
      "Speaker": "Student",
      "Text": "ちょっと、落ち着かないんだけどね"
    },
    {
      "Id": 200580800,
      "Speaker": "Student",
      "Text": "まあいいや"
    },
    {
      "Id": 200580810,
      "Speaker": "Student",
      "Text": "先生に喜んでもらえたならよかった"
    },
    {
      "Id": 200580820,
      "Speaker": "Player",
      "Text": "エリカと見る空、すごく綺麗だったよ"
    },
    {
      "Id": 200580830,
      "Speaker": "Player",
      "Text": "また一緒に行こうね"
    },
    {
      "Id": 200580840,
      "Speaker": "Student",
      "Text": "うう"
    },
    {
      "Id": 200580850,
      "Speaker": "Student",
      "Text": "あーー"
    },
    {
      "Id": 200580860,
      "Speaker": "Student",
      "Text": "ほんとさ"
    },
    {
      "Id": 200580870,
      "Speaker": "Student",
      "Text": "またそーやってーーー"
    },
    {
      "Id": 200580880,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200580890,
      "Speaker": "Student",
      "Text": "うん"
    },
    {
      "Id": 200580900,
      "Speaker": "Student",
      "Text": "また一緒に行こうね"
    }
  ],
  "DialogKR": [
    {
      "Id": 200580010,
      "Speaker": "Student",
      "Text": "요 선생님"
    },
    {
      "Id": 200580020,
      "Speaker": "Player",
      "Text": "에리카인가"
    },
    {
      "Id": 200580030,
      "Speaker": "Player",
      "Text": "안녕, 에리카"
    },
    {
      "Id": 200580040,
      "Speaker": "Student",
      "Text": "앗"
    },
    {
      "Id": 200580050,
      "Speaker": "Student",
      "Text": "내 번호 저장했었네"
    },
    {
      "Id": 200580060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "왠지 고마운걸ㅋㅋㅋ"
    },
    {
      "Id": 200580070,
      "Speaker": "Student",
      "Text": "오늘 쇼핑"
    },
    {
      "Id": 200580080,
      "Speaker": "Student",
      "Text": "선생님은 별로 관심 없는데"
    },
    {
      "Id": 200580090,
      "Speaker": "Student",
      "Text": "내가 너무 끌고 다닌 거 아냐?"
    },
    {
      "Id": 200580100,
      "Speaker": "Player",
      "Text": "나도 즐거웠어"
    },
    {
      "Id": 200580110,
      "Speaker": "Player",
      "Text": "에리카의 취향 공부"
    },
    {
      "Id": 200580120,
      "Speaker": "Student",
      "Text": "우왓"
    },
    {
      "Id": 200580130,
      "Speaker": "Student",
      "Text": "그렇게까지 말해주네"
    },
    {
      "Id": 200580140,
      "Speaker": "Student",
      "Text": "아무튼 즐거웠어 덕분에!"
    },
    {
      "Id": 200580150,
      "Speaker": "Student",
      "Text": "저번에 말했던 거 샀다!"
    },
    {
      "Id": 200580160,
      "Speaker": "Player",
      "Text": "오 좋겠네"
    },
    {
      "Id": 200580170,
      "Speaker": "Student",
      "Text": "이거 구한다고 D.U.를"
    },
    {
      "Id": 200580180,
      "Speaker": "Student",
      "Text": "완전 싹 돌았거든"
    },
    {
      "Id": 200580190,
      "Speaker": "Player",
      "Text": "이 늦은 시간까지?"
    },
    {
      "Id": 200580200,
      "Speaker": "Student",
      "Text": "맞아 어느새 시간이 이렇게"
    },
    {
      "Id": 200580210,
      "Speaker": "Student",
      "Text": "저녁도 안 먹었어ㅋㅋㅋ"
    },
    {
      "Id": 200580220,
      "Speaker": "Player",
      "Text": "나돈데!"
    },
    {
      "Id": 200580230,
      "Speaker": "Student",
      "Text": "오 선생님 어딘데?"
    },
    {
      "Id": 200580240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그럼 저녁 같이 먹을래?"
    },
    {
      "Id": 200580250,
      "Speaker": "Student",
      "Text": "선생님 오늘 즐거웠어"
    },
    {
      "Id": 200580260,
      "Speaker": "Student",
      "Text": "저녁도 사주고 바래다주기까지 하다니"
    },
    {
      "Id": 200580270,
      "Speaker": "Student",
      "Text": "너무 잘해주는 거 아냐?"
    },
    {
      "Id": 200580280,
      "Speaker": "Player",
      "Text": "학생에게는 좀 늦은 시간이었으니"
    },
    {
      "Id": 200580290,
      "Speaker": "Student",
      "Text": "아무래도 그렇지?"
    },
    {
      "Id": 200580300,
      "Speaker": "Student",
      "Text": "고마워"
    },
    {
      "Id": 200580310,
      "Speaker": "Student",
      "Text": "다음에는 내가 밥 살게!"
    },
    {
      "Id": 200580320,
      "Speaker": "Player",
      "Text": "토마토 줄 거야?"
    },
    {
      "Id": 200580330,
      "Speaker": "Student",
      "Text": "아ㅋㅋㅋ"
    },
    {
      "Id": 200580340,
      "Speaker": "Student",
      "Text": "글쎄~ 어떠려나!"
    },
    {
      "Id": 200580350,
      "Speaker": "Student",
      "Text": "오늘 엄청 더워"
    },
    {
      "Id": 200580360,
      "Speaker": "Player",
      "Text": "와 진짜 장난 아냐"
    },
    {
      "Id": 200580370,
      "Speaker": "Student",
      "Text": "ㅋㅋㅋ"
    },
    {
      "Id": 200580380,
      "Speaker": "Student",
      "Text": "밖에 나갈 일 있으면"
    },
    {
      "Id": 200580390,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "수분 섭취 잘하고!"
    },
    {
      "Id": 200580400,
      "Speaker": "Student",
      "Text": "아 혹시 모르니까"
    },
    {
      "Id": 200580410,
      "Speaker": "Student",
      "Text": "손 씻거나 하면 바로 갈아줘야 해"
    },
    {
      "Id": 200580420,
      "Speaker": "Student",
      "Text": "밴드"
    },
    {
      "Id": 200580430,
      "Speaker": "Player",
      "Text": "하지만 귀여운데"
    },
    {
      "Id": 200580440,
      "Speaker": "Student",
      "Text": "상처에 습기가 들어가면 안 좋아요"
    },
    {
      "Id": 200580450,
      "Speaker": "Student",
      "Text": "근데 그거 마음에 들었나 보네"
    },
    {
      "Id": 200580460,
      "Speaker": "Player",
      "Text": "이거 어디서 사?"
    },
    {
      "Id": 200580470,
      "Speaker": "Student",
      "Text": "안 가르쳐줄 거야"
    },
    {
      "Id": 200580480,
      "Speaker": "Student",
      "Text": "다치지 마!!"
    },
    {
      "Id": 200580490,
      "Speaker": "Student",
      "Text": "선생님 혹시"
    },
    {
      "Id": 200580500,
      "Speaker": "Student",
      "Text": "시간 언제 괜찮으려나?"
    },
    {
      "Id": 200580510,
      "Speaker": "Player",
      "Text": "무슨 일이 있나 본데"
    },
    {
      "Id": 200580520,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 200580530,
      "Speaker": "Student",
      "Text": "나 요즘"
    },
    {
      "Id": 200580540,
      "Speaker": "Student",
      "Text": "상담하고 싶은 게 있어서"
    },
    {
      "Id": 200580550,
      "Speaker": "Player",
      "Text": "좋아, 그럼 지금 볼까"
    },
    {
      "Id": 200580560,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "지금?!"
    },
    {
      "Id": 200580570,
      "Speaker": "Student",
      "Text": "친구들에게도 말해볼까"
    },
    {
      "Id": 200580580,
      "Speaker": "Student",
      "Text": "가끔 혼자만의 시간이 필요하다는 거"
    },
    {
      "Id": 200580590,
      "Speaker": "Student",
      "Text": "음 뭔가"
    },
    {
      "Id": 200580600,
      "Speaker": "Student",
      "Text": "내 이미지랑 안 어울릴까봐"
    },
    {
      "Id": 200580610,
      "Speaker": "Player",
      "Text": "에리카 쨩, 이미지 만들고 있었던 거야?"
    },
    {
      "Id": 200580620,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200580630,
      "Speaker": "Player",
      "Text": "에리카 쨩 그랬던 거야~?"
    },
    {
      "Id": 200580640,
      "Speaker": "Student",
      "Text": "못됐어 진짜"
    },
    {
      "Id": 200580650,
      "Speaker": "Student",
      "Text": "선생님 오늘 하늘 봤어?"
    },
    {
      "Id": 200580660,
      "Speaker": "Player",
      "Text": "왜? 못 봤어"
    },
    {
      "Id": 200580670,
      "Speaker": "Player",
      "Text": "지금은 지하철이라"
    },
    {
      "Id": 200580680,
      "Speaker": "Student",
      "Text": "엄~청 예쁘거든"
    },
    {
      "Id": 200580690,
      "Speaker": "Student",
      "Text": "밖에 나오면 한번 올려다봐"
    },
    {
      "Id": 200580700,
      "Speaker": "Student",
      "Text": "분명 감동할 거야"
    },
    {
      "Id": 200580710,
      "Speaker": "Player",
      "Text": "믿어본다?"
    },
    {
      "Id": 200580720,
      "Speaker": "Student",
      "Text": "ㅋㅋㅋ아니"
    },
    {
      "Id": 200580730,
      "Speaker": "Student",
      "Text": "이런 걸로 속이겠냐고!"
    },
    {
      "Id": 200580740,
      "Speaker": "Player",
      "Text": "마침 게헨나 가는 중이거든"
    },
    {
      "Id": 200580750,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "어??"
    },
    {
      "Id": 200580760,
      "Speaker": "Student",
      "Text": "오늘은 아주 평화로웠지?"
    },
    {
      "Id": 200580770,
      "Speaker": "Player",
      "Text": "그러게 말이야"
    },
    {
      "Id": 200580780,
      "Speaker": "Student",
      "Text": "나는 이제 평화로운지 아닌지"
    },
    {
      "Id": 200580790,
      "Speaker": "Student",
      "Text": "알 수 없게 되어버렸지만 말야"
    },
    {
      "Id": 200580800,
      "Speaker": "Student",
      "Text": "아무튼"
    },
    {
      "Id": 200580810,
      "Speaker": "Student",
      "Text": "선생님이 만족했다면 됐어"
    },
    {
      "Id": 200580820,
      "Speaker": "Player",
      "Text": "에리카의 하늘 좋더라"
    },
    {
      "Id": 200580830,
      "Speaker": "Player",
      "Text": "다음에도 같이 갈까"
    },
    {
      "Id": 200580840,
      "Speaker": "Student",
      "Text": "ㅓ"
    },
    {
      "Id": 200580850,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 200580860,
      "Speaker": "Student",
      "Text": "진짜ㅏ"
    },
    {
      "Id": 200580870,
      "Speaker": "Student",
      "Text": "이런 거ㅓ어"
    },
    {
      "Id": 200580880,
      "Speaker": "Student",
      "Text": "……"
    },
    {
      "Id": 200580890,
      "Speaker": "Student",
      "Text": "응"
    },
    {
      "Id": 200580900,
      "Speaker": "Student",
      "Text": "다음에도 같이"
    }
  ],
  "DialogEN": [
    {
      "Id": 200580010,
      "Speaker": "Student",
      "Text": "Yo, Sensei."
    },
    {
      "Id": 200580020,
      "Speaker": "Player",
      "Text": "Is this Erika?"
    },
    {
      "Id": 200580030,
      "Speaker": "Player",
      "Text": "Hi, Erika!"
    },
    {
      "Id": 200580040,
      "Speaker": "Student",
      "Text": "Ah"
    },
    {
      "Id": 200580050,
      "Speaker": "Student",
      "Text": "You saved my number"
    },
    {
      "Id": 200580060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Thank you lol"
    },
    {
      "Id": 200580070,
      "Speaker": "Student",
      "Text": "About shopping today..."
    },
    {
      "Id": 200580080,
      "Speaker": "Student",
      "Text": "I hope I didn't drag you around too much..."
    },
    {
      "Id": 200580090,
      "Speaker": "Student",
      "Text": "Especially if you weren't that interested"
    },
    {
      "Id": 200580100,
      "Speaker": "Player",
      "Text": "I had a lot of fun too!"
    },
    {
      "Id": 200580110,
      "Speaker": "Player",
      "Text": "I enjoyed learning more about your tastes!"
    },
    {
      "Id": 200580120,
      "Speaker": "Student",
      "Text": "Whoa"
    },
    {
      "Id": 200580130,
      "Speaker": "Student",
      "Text": "Thanks for saying that."
    },
    {
      "Id": 200580140,
      "Speaker": "Student",
      "Text": "Well, I had a good time too."
    },
    {
      "Id": 200580150,
      "Speaker": "Student",
      "Text": "And I bought that thing I was telling you about."
    },
    {
      "Id": 200580160,
      "Speaker": "Player",
      "Text": "Good for you!"
    },
    {
      "Id": 200580170,
      "Speaker": "Student",
      "Text": "I traveled literally all over"
    },
    {
      "Id": 200580180,
      "Speaker": "Student",
      "Text": "the D.U. to get my hands on it."
    },
    {
      "Id": 200580190,
      "Speaker": "Player",
      "Text": "All the way until now?"
    },
    {
      "Id": 200580200,
      "Speaker": "Student",
      "Text": "Yeah. I didn't even realize what time it was."
    },
    {
      "Id": 200580210,
      "Speaker": "Student",
      "Text": "I skipped dinner and everything lolol"
    },
    {
      "Id": 200580220,
      "Speaker": "Player",
      "Text": "I haven't eaten yet either!"
    },
    {
      "Id": 200580230,
      "Speaker": "Student",
      "Text": "Oh? Where you at, Sensei?"
    },
    {
      "Id": 200580240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Wanna grub with me?"
    },
    {
      "Id": 200580250,
      "Speaker": "Student",
      "Text": "Today was a blast, Sensei."
    },
    {
      "Id": 200580260,
      "Speaker": "Student",
      "Text": "You treated me out AND walked me home."
    },
    {
      "Id": 200580270,
      "Speaker": "Student",
      "Text": "It's almost a little too chivalrous."
    },
    {
      "Id": 200580280,
      "Speaker": "Player",
      "Text": "It's dangerous to walk around so late at night."
    },
    {
      "Id": 200580290,
      "Speaker": "Student",
      "Text": "Eh. That's fair."
    },
    {
      "Id": 200580300,
      "Speaker": "Student",
      "Text": "Well, thanks."
    },
    {
      "Id": 200580310,
      "Speaker": "Student",
      "Text": "Next one's on me, okay?"
    },
    {
      "Id": 200580320,
      "Speaker": "Player",
      "Text": "Are you going to be giving me tomatoes?"
    },
    {
      "Id": 200580330,
      "Speaker": "Student",
      "Text": "Ah lol"
    },
    {
      "Id": 200580340,
      "Speaker": "Student",
      "Text": "You'll just have to find out!"
    },
    {
      "Id": 200580350,
      "Speaker": "Student",
      "Text": "It's so hot today."
    },
    {
      "Id": 200580360,
      "Speaker": "Player",
      "Text": "Like, seriously."
    },
    {
      "Id": 200580370,
      "Speaker": "Student",
      "Text": "lol"
    },
    {
      "Id": 200580380,
      "Speaker": "Student",
      "Text": "Be careful if you go out today!"
    },
    {
      "Id": 200580390,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "Make sure you stay hydrated!"
    },
    {
      "Id": 200580400,
      "Speaker": "Student",
      "Text": "Ah, just to be safe"
    },
    {
      "Id": 200580410,
      "Speaker": "Student",
      "Text": "if you wash your hands, make sure to replace it."
    },
    {
      "Id": 200580420,
      "Speaker": "Student",
      "Text": "The bandage"
    },
    {
      "Id": 200580430,
      "Speaker": "Player",
      "Text": "It's so cute, though!!"
    },
    {
      "Id": 200580440,
      "Speaker": "Student",
      "Text": "Yeah, but you don't want moisture to get trapped inside."
    },
    {
      "Id": 200580450,
      "Speaker": "Student",
      "Text": "So, you like that stuff like that, huh?"
    },
    {
      "Id": 200580460,
      "Speaker": "Player",
      "Text": "Where can I get my own??"
    },
    {
      "Id": 200580470,
      "Speaker": "Student",
      "Text": "Mmm... Not telling."
    },
    {
      "Id": 200580480,
      "Speaker": "Student",
      "Text": "So don't hurt yourself!!"
    },
    {
      "Id": 200580490,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 200580500,
      "Speaker": "Student",
      "Text": "When's the next time you're free?"
    },
    {
      "Id": 200580510,
      "Speaker": "Player",
      "Text": "Why? Do you need something?"
    },
    {
      "Id": 200580520,
      "Speaker": "Student",
      "Text": "Um"
    },
    {
      "Id": 200580530,
      "Speaker": "Student",
      "Text": "Well actually..."
    },
    {
      "Id": 200580540,
      "Speaker": "Student",
      "Text": "I've been wanting to ask for your advice about something."
    },
    {
      "Id": 200580550,
      "Speaker": "Player",
      "Text": "Then I'm free right now."
    },
    {
      "Id": 200580560,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "Right now?!"
    },
    {
      "Id": 200580570,
      "Speaker": "Student",
      "Text": "Should I tell my friends too?"
    },
    {
      "Id": 200580580,
      "Speaker": "Student",
      "Text": "That I just need some \"me\" time every once in a while?"
    },
    {
      "Id": 200580590,
      "Speaker": "Student",
      "Text": "I just kinda feel like"
    },
    {
      "Id": 200580600,
      "Speaker": "Student",
      "Text": "that's not how they see me. As a person."
    },
    {
      "Id": 200580610,
      "Speaker": "Player",
      "Text": "Erika, have you been working on improving your public image?"
    },
    {
      "Id": 200580620,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200580630,
      "Speaker": "Player",
      "Text": "Is that a yes, Erika?"
    },
    {
      "Id": 200580640,
      "Speaker": "Student",
      "Text": "You're so mean."
    },
    {
      "Id": 200580650,
      "Speaker": "Student",
      "Text": "Sensei, have you seen the sky today?"
    },
    {
      "Id": 200580660,
      "Speaker": "Player",
      "Text": "No, why?"
    },
    {
      "Id": 200580670,
      "Speaker": "Player",
      "Text": "I'm in the subway right now."
    },
    {
      "Id": 200580680,
      "Speaker": "Student",
      "Text": "It's suuuperrr pretty."
    },
    {
      "Id": 200580690,
      "Speaker": "Student",
      "Text": "Go check it out later!"
    },
    {
      "Id": 200580700,
      "Speaker": "Student",
      "Text": "I'm sure you'll love it."
    },
    {
      "Id": 200580710,
      "Speaker": "Player",
      "Text": "Maybe I'll just take your word for it..."
    },
    {
      "Id": 200580720,
      "Speaker": "Student",
      "Text": "lol"
    },
    {
      "Id": 200580730,
      "Speaker": "Student",
      "Text": "I'm not lying about the SKY okay?!"
    },
    {
      "Id": 200580740,
      "Speaker": "Player",
      "Text": "I'm actually on my way to Gehenna right now."
    },
    {
      "Id": 200580750,
      "Speaker": "Student",
      "StoryEpisode": 5,
      "Text": "Oh??"
    },
    {
      "Id": 200580760,
      "Speaker": "Student",
      "Text": "Wasn't it nice and peaceful today?"
    },
    {
      "Id": 200580770,
      "Speaker": "Player",
      "Text": "It really was."
    },
    {
      "Id": 200580780,
      "Speaker": "Student",
      "Text": "Although I don't really know"
    },
    {
      "Id": 200580790,
      "Speaker": "Student",
      "Text": "if I can say it's peaceful anymore..."
    },
    {
      "Id": 200580800,
      "Speaker": "Student",
      "Text": "Anyway"
    },
    {
      "Id": 200580810,
      "Speaker": "Student",
      "Text": "As long as you're good, I'm good, Sensei."
    },
    {
      "Id": 200580820,
      "Speaker": "Player",
      "Text": "I really enjoyed Erika's sky."
    },
    {
      "Id": 200580830,
      "Speaker": "Player",
      "Text": "Let's go again some day."
    },
    {
      "Id": 200580840,
      "Speaker": "Student",
      "Text": "A"
    },
    {
      "Id": 200580850,
      "Speaker": "Student",
      "Text": "Ah."
    },
    {
      "Id": 200580860,
      "Speaker": "Student",
      "Text": "Srsly"
    },
    {
      "Id": 200580870,
      "Speaker": "Student",
      "Text": "Something like this..."
    },
    {
      "Id": 200580880,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 200580890,
      "Speaker": "Student",
      "Text": "Yeah"
    },
    {
      "Id": 200580900,
      "Speaker": "Student",
      "Text": "Let's go together next time too."
    }
  ],
  "DialogTH": [
    {
      "Id": 200580010,
      "Speaker": "Student",
      "Text": "โย่ คุณครู"
    },
    {
      "Id": 200580020,
      "Speaker": "Player",
      "Text": "เอริกะเหรอ?"
    },
    {
      "Id": 200580030,
      "Speaker": "Player",
      "Text": "ว่าไง เอริกะ"
    },
    {
      "Id": 200580040,
      "Speaker": "Student",
      "Text": "อ๊ะ"
    },
    {
      "Id": 200580050,
      "Speaker": "Student",
      "Text": "เมมเบอร์ของฉันไว้แล้วสินะ"
    },
    {
      "Id": 200580060,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "น่าซึ้งใจจัง 555"
    },
    {
      "Id": 200580070,
      "Speaker": "Student",
      "Text": "ที่ไปซื้อของกันวันนี้"
    },
    {
      "Id": 200580080,
      "Speaker": "Student",
      "Text": "ดูคุณครูไม่ค่อยสนใจเท่าไรเลย"
    },
    {
      "Id": 200580090,
      "Speaker": "Student",
      "Text": "ฉันลากคุณครูไปตรงโน้นตรงนี้\nมากไปหรือเปล่า?"
    },
    {
      "Id": 200580100,
      "Speaker": "Player",
      "Text": "ครูก็สนุกนะ"
    },
    {
      "Id": 200580110,
      "Speaker": "Player",
      "Text": "ได้รู้จักรสนิยมของเอริกะด้วย"
    },
    {
      "Id": 200580120,
      "Speaker": "Student",
      "Text": "ว้าย?"
    },
    {
      "Id": 200580130,
      "Speaker": "Student",
      "Text": "พูดถึงขนาดนั้นเลยเหรอ"
    },
    {
      "Id": 200580140,
      "Speaker": "Student",
      "Text": "เอาเป็นว่าวันนี้สนุกมากเลย\nขอบคุณนะ!"
    },
    {
      "Id": 200580150,
      "Speaker": "Student",
      "Text": "ฉันซื้อของที่เคยบอกไว้คราวก่อน\nแล้วนะ!"
    },
    {
      "Id": 200580160,
      "Speaker": "Player",
      "Text": "โอ้ ดีเลย"
    },
    {
      "Id": 200580170,
      "Speaker": "Student",
      "Text": "กว่าจะได้ของชิ้นนี้มา"
    },
    {
      "Id": 200580180,
      "Speaker": "Student",
      "Text": "ฉันต้องเดินหาทั่ว D.U. เลยละ"
    },
    {
      "Id": 200580190,
      "Speaker": "Player",
      "Text": "จนถึงป่านนี้น่ะเหรอ?"
    },
    {
      "Id": 200580200,
      "Speaker": "Student",
      "Text": "นั่นสินะ เวลาล่วงเลยมาขนาดนี้แล้ว\nเหรอเนี่ย"
    },
    {
      "Id": 200580210,
      "Speaker": "Student",
      "Text": "ลืมกินมื้อเย็นไปเลย 555"
    },
    {
      "Id": 200580220,
      "Speaker": "Player",
      "Text": "ครูก็ด้วย!"
    },
    {
      "Id": 200580230,
      "Speaker": "Student",
      "Text": "โอ้ ตอนนี้คุณครูอยู่ไหนเหรอ?"
    },
    {
      "Id": 200580240,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "มากินมื้อเย็นด้วยกันมั้ย?"
    },
    {
      "Id": 200580250,
      "Speaker": "Student",
      "Text": "คุณครู วันนี้ฉันสนุกมากเลย"
    },
    {
      "Id": 200580260,
      "Speaker": "Student",
      "Text": "คุณครูทั้งเลี้ยงข้าวให้ ทั้งเดินมาส่ง\nเลยนะ"
    },
    {
      "Id": 200580270,
      "Speaker": "Student",
      "Text": "ทำดีกับฉันมากเกินไปหรือเปล่าเนี่ย?"
    },
    {
      "Id": 200580280,
      "Speaker": "Player",
      "Text": "ก็เวลานั้นมันดึกเกินไปสำหรับ\nนักเรียนนี่นา"
    },
    {
      "Id": 200580290,
      "Speaker": "Student",
      "Text": "ก็จริงอย่างที่ว่า"
    },
    {
      "Id": 200580300,
      "Speaker": "Student",
      "Text": "ขอบคุณนะ"
    },
    {
      "Id": 200580310,
      "Speaker": "Student",
      "Text": "เอาไว้คราวหน้าฉันขอเลี้ยงข้าว\nตอบแทนนะ!"
    },
    {
      "Id": 200580320,
      "Speaker": "Player",
      "Text": "จะให้มะเขือเทศเหรอ?"
    },
    {
      "Id": 200580330,
      "Speaker": "Student",
      "Text": "อ่า 555"
    },
    {
      "Id": 200580340,
      "Speaker": "Student",
      "Text": "ก็ไม่รู้สินะ~ ว่าจะเป็นยังไง!"
    },
    {
      "Id": 200580350,
      "Speaker": "Student",
      "Text": "วันนี้ร้อนระเบิดเลย"
    },
    {
      "Id": 200580360,
      "Speaker": "Player",
      "Text": "ร้อนจนครูจะละลายแล้ว"
    },
    {
      "Id": 200580370,
      "Speaker": "Student",
      "Text": "555"
    },
    {
      "Id": 200580380,
      "Speaker": "Student",
      "Text": "ถ้ามีเรื่องต้องออกไปข้างนอก"
    },
    {
      "Id": 200580390,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ก็หมั่นจิบน้ำด้วยล่ะ!"
    },
    {
      "Id": 200580400,
      "Speaker": "Student",
      "Text": "อ้อ ฉันขอบอกเผื่อไว้ก่อน"
    },
    {
      "Id": 200580410,
      "Speaker": "Student",
      "Text": "ถ้าล้างมือก็ต้องเปลี่ยนอันใหม่เลยนะ"
    },
    {
      "Id": 200580420,
      "Speaker": "Student",
      "Text": "พลาสเตอร์ปิดแผลน่ะ"
    },
    {
      "Id": 200580430,
      "Speaker": "Player",
      "Text": "แต่อันนี้มันน่ารักนะ"
    },
    {
      "Id": 200580440,
      "Speaker": "Student",
      "Text": "ถ้าน้ำเข้าแผล จะยิ่งแย่เข้าไปใหญ่\nนะคะ"
    },
    {
      "Id": 200580450,
      "Speaker": "Student",
      "Text": "แต่ดูเหมือนจะถูกใจคุณครูเลยนะ"
    },
    {
      "Id": 200580460,
      "Speaker": "Player",
      "Text": "ซื้อมาจากไหนเหรอ?"
    },
    {
      "Id": 200580470,
      "Speaker": "Student",
      "Text": "ไม่บอกหรอก"
    },
    {
      "Id": 200580480,
      "Speaker": "Student",
      "Text": "อย่ามีเรื่องให้เจ็บตัวอีกล่ะ!!"
    },
    {
      "Id": 200580490,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 200580500,
      "Speaker": "Student",
      "Text": "พอจะมีเวลาบ้างมั้ย?"
    },
    {
      "Id": 200580510,
      "Speaker": "Player",
      "Text": "มีเรื่องอะไรมาสินะ"
    },
    {
      "Id": 200580520,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 200580530,
      "Speaker": "Student",
      "Text": "ช่วงนี้ฉัน"
    },
    {
      "Id": 200580540,
      "Speaker": "Student",
      "Text": "มีเรื่องอยากปรึกษาน่ะ"
    },
    {
      "Id": 200580550,
      "Speaker": "Player",
      "Text": "ได้สิ งั้นมาเจอกันเลยมั้ย?"
    },
    {
      "Id": 200580560,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ตอนนี้เลยเหรอ?!"
    },
    {
      "Id": 200580570,
      "Speaker": "Student",
      "Text": "ฉันควรบอกเพื่อนๆ หรือเปล่า"
    },
    {
      "Id": 200580580,
      "Speaker": "Student",
      "Text": "ว่าบางครั้งก็ต้องการเวลาส่วนตัวบ้าง"
    },
    {
      "Id": 200580590,
      "Speaker": "Student",
      "Text": "อืม คือว่า"
    },
    {
