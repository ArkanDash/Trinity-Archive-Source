{
  "CharacterId": 10079,
  "DialogJP": [
    {
      "Id": 100790010,
      "Speaker": "Student",
      "Text": "なかなか面白いわね"
    },
    {
      "Id": 100790020,
      "Speaker": "Student",
      "Text": "どれも似てるようで、違ってたりして"
    },
    {
      "Id": 100790030,
      "Speaker": "Student",
      "Text": "観光地に来た気分だわ"
    },
    {
      "Id": 100790040,
      "Speaker": "Player",
      "Text": "何を見てるの？"
    },
    {
      "Id": 100790050,
      "Speaker": "Player",
      "Text": "たとえば、どんなところが？"
    },
    {
      "Id": 100790060,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 100790070,
      "Speaker": "Student",
      "Text": "そうね"
    },
    {
      "Id": 100790080,
      "Speaker": "Student",
      "Text": "来てもらった方が分かりやすいかしら"
    },
    {
      "Id": 100790090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "時間大丈夫？"
    },
    {
      "Id": 100790100,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 100790110,
      "Speaker": "Student",
      "Text": "くっ……"
    },
    {
      "Id": 100790120,
      "Speaker": "Player",
      "Text": "ご、ごめん"
    },
    {
      "Id": 100790130,
      "Speaker": "Player",
      "Text": "私が余計なことを……"
    },
    {
      "Id": 100790140,
      "Speaker": "Student",
      "Text": "あっ"
    },
    {
      "Id": 100790150,
      "Speaker": "Student",
      "Text": "いや、先生には感謝してるわ"
    },
    {
      "Id": 100790160,
      "Speaker": "Student",
      "Text": "おかげで、いろんな場所を見て回れたし"
    },
    {
      "Id": 100790170,
      "Speaker": "Student",
      "Text": "とりあえず、それで満足としましょう"
    },
    {
      "Id": 100790180,
      "Speaker": "Student",
      "Text": "……でも"
    },
    {
      "Id": 100790190,
      "Speaker": "Student",
      "Text": "これで諦めたりしないんだから"
    },
    {
      "Id": 100790200,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100790210,
      "Speaker": "Student",
      "Text": "あのさ"
    },
    {
      "Id": 100790220,
      "Speaker": "Student",
      "Text": "悪いんだけど、ちょっとトラブっちゃって"
    },
    {
      "Id": 100790230,
      "Speaker": "Student",
      "Text": "今って大丈夫？"
    },
    {
      "Id": 100790240,
      "Speaker": "Player",
      "Text": "トラブル！？"
    },
    {
      "Id": 100790250,
      "Speaker": "Player",
      "Text": "えっ！？どうしたの？今どこ！？"
    },
    {
      "Id": 100790260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "えっと……"
    },
    {
      "Id": 100790270,
      "Speaker": "Student",
      "Text": "はぁ"
    },
    {
      "Id": 100790280,
      "Speaker": "Student",
      "Text": "疲れたわね"
    },
    {
      "Id": 100790290,
      "Speaker": "Student",
      "Text": "というか、こっちに来ても、お姉様って呼ばれるなんて……"
    },
    {
      "Id": 100790300,
      "Speaker": "Player",
      "Text": "それって……"
    },
    {
      "Id": 100790310,
      "Speaker": "Player",
      "Text": "いつも呼ばれてたってこと？"
    },
    {
      "Id": 100790320,
      "Speaker": "Student",
      "Text": "ご、誤解よ！"
    },
    {
      "Id": 100790330,
      "Speaker": "Student",
      "Text": "うーん……"
    },
    {
      "Id": 100790340,
      "Speaker": "Student",
      "Text": "ややこしくなるから、この話は終わりましょう"
    },
    {
      "Id": 100790350,
      "Speaker": "Student",
      "Text": "……その、助かったわ、先生"
    },
    {
      "Id": 100790360,
      "Speaker": "Student",
      "Text": "じゃ、また連絡するから"
    },
    {
      "Id": 100790370,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100790380,
      "Speaker": "Student",
      "Text": "いま忙しい？"
    },
    {
      "Id": 100790390,
      "Speaker": "Player",
      "Text": "どうしたの？"
    },
    {
      "Id": 100790400,
      "Speaker": "Player",
      "Text": "急用だったり？"
    },
    {
      "Id": 100790410,
      "Speaker": "Student",
      "Text": "ううん"
    },
    {
      "Id": 100790420,
      "Speaker": "Student",
      "Text": "そんな急ぎってわけじゃないんだけど……"
    },
    {
      "Id": 100790430,
      "Speaker": "Student",
      "Text": "忙しいなら大丈夫"
    },
    {
      "Id": 100790440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ちょっと聞きたいことがあるだけだから"
    },
    {
      "Id": 100790450,
      "Speaker": "Student",
      "Text": "先生に買ってもらったペロロなんだけど"
    },
    {
      "Id": 100790460,
      "Speaker": "Student",
      "Text": "これ、ただのペロロじゃないみたいなの"
    },
    {
      "Id": 100790470,
      "Speaker": "Student",
      "Text": "「ペロロ博士」って言うらしいわ"
    },
    {
      "Id": 100790480,
      "Speaker": "Player",
      "Text": "どっちも同じなんじゃ……？"
    },
    {
      "Id": 100790490,
      "Speaker": "Player",
      "Text": "ペロロには変わりないんじゃないの？"
    },
    {
      "Id": 100790500,
      "Speaker": "Student",
      "Text": "？？？？？"
    },
    {
      "Id": 100790510,
      "Speaker": "Student",
      "Text": "いや"
    },
    {
      "Id": 100790520,
      "Speaker": "Student",
      "Text": "いやいや、全然違うわよ"
    },
    {
      "Id": 100790530,
      "Speaker": "Student",
      "Text": "どう見ても違うじゃない！"
    },
    {
      "Id": 100790540,
      "Speaker": "Student",
      "Text": "ふぅ……"
    },
    {
      "Id": 100790550,
      "Speaker": "Student",
      "Text": "もっと詳しくなって、先生にいろいろ教えてあげるわね"
    },
    {
      "Id": 100790560,
      "Speaker": "Student",
      "Text": "今日はありがと！"
    },
    {
      "Id": 100790570,
      "Speaker": "Student",
      "Text": "またね、先生！"
    },
    {
      "Id": 100790580,
      "Speaker": "Student",
      "Text": "あぁ、もう"
    },
    {
      "Id": 100790590,
      "Speaker": "Student",
      "Text": "なによ"
    },
    {
      "Id": 100790600,
      "Speaker": "Student",
      "Text": "こっちでもやられるなんて！"
    },
    {
      "Id": 100790610,
      "Speaker": "Player",
      "Text": "こっちでも、って……？"
    },
    {
      "Id": 100790620,
      "Speaker": "Player",
      "Text": "何があったの？"
    },
    {
      "Id": 100790630,
      "Speaker": "Student",
      "Text": "先生"
    },
    {
      "Id": 100790640,
      "Speaker": "Student",
      "Text": "今すぐ来られそう？"
    },
    {
      "Id": 100790650,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ちょっと手伝ってもらいたくて……"
    },
    {
      "Id": 100790660,
      "Speaker": "Student",
      "Text": "そうだ"
    },
    {
      "Id": 100790670,
      "Speaker": "Student",
      "Text": "念のため言っておくけど"
    },
    {
      "Id": 100790680,
      "Speaker": "Student",
      "Text": "別に私、普段からそんなに暴力的なわけじゃないからね"
    },
    {
      "Id": 100790690,
      "Speaker": "Student",
      "Text": "勘違いしないでよ？"
    },
    {
      "Id": 100790700,
      "Speaker": "Player",
      "Text": "そんな風には思ってなかったけど……"
    },
    {
      "Id": 100790710,
      "Speaker": "Player",
      "Text": "もしかして、自覚があるとか？"
    },
    {
      "Id": 100790720,
      "Speaker": "Student",
      "Text": "ち"
    },
    {
      "Id": 100790730,
      "Speaker": "Student",
      "Text": "違う"
    },
    {
      "Id": 100790740,
      "Speaker": "Student",
      "Text": "違うわよ、もうっ！"
    }
  ],
  "DialogKR": [
    {
      "Id": 100790010,
      "Speaker": "Student",
      "Text": "여기도 꽤 재밌네"
    },
    {
      "Id": 100790020,
      "Speaker": "Student",
      "Text": "다 비슷한 거 같으면서도, 확실히 조금씩 다르고"
    },
    {
      "Id": 100790030,
      "Speaker": "Student",
      "Text": "관광지에 온 기분이야"
    },
    {
      "Id": 100790040,
      "Speaker": "Player",
      "Text": "응? 뭘 보고 있어?"
    },
    {
      "Id": 100790050,
      "Speaker": "Player",
      "Text": "비슷하면서도 다르다? 뭐가?"
    },
    {
      "Id": 100790060,
      "Speaker": "Student",
      "Text": "여러 가지"
    },
    {
      "Id": 100790070,
      "Speaker": "Student",
      "Text": "그러네"
    },
    {
      "Id": 100790080,
      "Speaker": "Student",
      "Text": "생각해 보니 선생님이 있으면 좀 더 알아보기 편할지도"
    },
    {
      "Id": 100790090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "혹시 지금 시간 괜찮아?"
    },
    {
      "Id": 100790100,
      "Speaker": "Student",
      "Text": "…………."
    },
    {
      "Id": 100790110,
      "Speaker": "Student",
      "Text": "크윽"
    },
    {
      "Id": 100790120,
      "Speaker": "Player",
      "Text": "뭔가 미안"
    },
    {
      "Id": 100790130,
      "Speaker": "Player",
      "Text": "헛수고였나……."
    },
    {
      "Id": 100790140,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100790150,
      "Speaker": "Student",
      "Text": "아니, 선생님한테는 고맙지"
    },
    {
      "Id": 100790160,
      "Speaker": "Student",
      "Text": "덕분에 구경이라도 많이 했으니"
    },
    {
      "Id": 100790170,
      "Speaker": "Student",
      "Text": "그걸로 일단 만족"
    },
    {
      "Id": 100790180,
      "Speaker": "Student",
      "Text": "……을……"
    },
    {
      "Id": 100790190,
      "Speaker": "Student",
      "Text": "하자……."
    },
    {
      "Id": 100790200,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100790210,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 100790220,
      "Speaker": "Student",
      "Text": "미안한데"
    },
    {
      "Id": 100790230,
      "Speaker": "Student",
      "Text": "혹시 지금 괜찮을까? 약간 사람들이랑 문제가 생겨서……."
    },
    {
      "Id": 100790240,
      "Speaker": "Player",
      "Text": "사람들이랑 문제!?"
    },
    {
      "Id": 100790250,
      "Speaker": "Player",
      "Text": "뭐!? 지금 어디야!?"
    },
    {
      "Id": 100790260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "그러니까……."
    },
    {
      "Id": 100790270,
      "Speaker": "Student",
      "Text": "으으"
    },
    {
      "Id": 100790280,
      "Speaker": "Student",
      "Text": "피곤하다"
    },
    {
      "Id": 100790290,
      "Speaker": "Student",
      "Text": "여기까지 와서도 누님이니 언니니 하며 들러붙는 걸 볼 줄이야"
    },
    {
      "Id": 100790300,
      "Speaker": "Player",
      "Text": "여기까지 와서도?"
    },
    {
      "Id": 100790310,
      "Speaker": "Player",
      "Text": "또 아는 사람이 있나 보네"
    },
    {
      "Id": 100790320,
      "Speaker": "Student",
      "Text": "그"
    },
    {
      "Id": 100790330,
      "Speaker": "Student",
      "Text": "음"
    },
    {
      "Id": 100790340,
      "Speaker": "Student",
      "Text": "아니야, 말하면 또 길어질 테니 여기까지."
    },
    {
      "Id": 100790350,
      "Speaker": "Student",
      "Text": "그래도 마지막엔 잘 말해줘서 고마웠어."
    },
    {
      "Id": 100790360,
      "Speaker": "Student",
      "Text": "또 봐, 선생님."
    },
    {
      "Id": 100790370,
      "Speaker": "Student",
      "Text": "선생님"
    },
    {
      "Id": 100790380,
      "Speaker": "Student",
      "Text": "선생님 지금 바빠?"
    },
    {
      "Id": 100790390,
      "Speaker": "Player",
      "Text": "응? 무슨 일이야?"
    },
    {
      "Id": 100790400,
      "Speaker": "Player",
      "Text": "뭔가 다급해 보이는데"
    },
    {
      "Id": 100790410,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 100790420,
      "Speaker": "Student",
      "Text": "다급한 것까진 아니지만"
    },
    {
      "Id": 100790430,
      "Speaker": "Student",
      "Text": "아무튼 지금 바빠?"
    },
    {
      "Id": 100790440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "뭐 좀 물어볼 게 있는데"
    },
    {
      "Id": 100790450,
      "Speaker": "Student",
      "Text": "선생님 이거"
    },
    {
      "Id": 100790460,
      "Speaker": "Student",
      "Text": "그냥 페로로가 아니라는 거 같은데"
    },
    {
      "Id": 100790470,
      "Speaker": "Student",
      "Text": "정확한 이름은 '페로로 박사님'이라는 것 같아"
    },
    {
      "Id": 100790480,
      "Speaker": "Player",
      "Text": "그게 그거 같긴 하지만……."
    },
    {
      "Id": 100790490,
      "Speaker": "Player",
      "Text": "결국 페로로인 거 아냐?"
    },
    {
      "Id": 100790500,
      "Speaker": "Student",
      "Text": "?????"
    },
    {
      "Id": 100790510,
      "Speaker": "Student",
      "Text": "아니"
    },
    {
      "Id": 100790520,
      "Speaker": "Student",
      "Text": "아니지 아냐 절대 아니지"
    },
    {
      "Id": 100790530,
      "Speaker": "Student",
      "Text": "이런 건 중요한 차이라고"
    },
    {
      "Id": 100790540,
      "Speaker": "Student",
      "Text": "후"
    },
    {
      "Id": 100790550,
      "Speaker": "Student",
      "Text": "나중에 좀 더 공부해서 제대로 설명해 줄게"
    },
    {
      "Id": 100790560,
      "Speaker": "Student",
      "Text": "아무튼 오늘 고마웠어"
    },
    {
      "Id": 100790570,
      "Speaker": "Student",
      "Text": "또 봐, 선생님!!"
    },
    {
      "Id": 100790580,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100790590,
      "Speaker": "Student",
      "Text": "뭐야 이게"
    },
    {
      "Id": 100790600,
      "Speaker": "Student",
      "Text": "여기서까지 이러기야?"
    },
    {
      "Id": 100790610,
      "Speaker": "Player",
      "Text": "응? 여기서까지?"
    },
    {
      "Id": 100790620,
      "Speaker": "Player",
      "Text": "무슨 일 생겼어?"
    },
    {
      "Id": 100790630,
      "Speaker": "Student",
      "Text": "크윽"
    },
    {
      "Id": 100790640,
      "Speaker": "Student",
      "Text": "선생님, 잠깐 좀 와줄 수 있어?"
    },
    {
      "Id": 100790650,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "아무래도 또 도움이 필요할 거 같은데……."
    },
    {
      "Id": 100790660,
      "Speaker": "Student",
      "Text": "그러고 보니"
    },
    {
      "Id": 100790670,
      "Speaker": "Student",
      "Text": "혹시나 해서 하는 말이지만"
    },
    {
      "Id": 100790680,
      "Speaker": "Student",
      "Text": "딱히 그렇게 막 폭력적인 사람은 아니니까"
    },
    {
      "Id": 100790690,
      "Speaker": "Student",
      "Text": "알겠지?"
    },
    {
      "Id": 100790700,
      "Speaker": "Player",
      "Text": "그렇게 말한 적은 없는데"
    },
    {
      "Id": 100790710,
      "Speaker": "Player",
      "Text": "혹시 뭔가 찔리시는 게……."
    },
    {
      "Id": 100790720,
      "Speaker": "Student",
      "Text": "아"
    },
    {
      "Id": 100790730,
      "Speaker": "Student",
      "Text": "아냐"
    },
    {
      "Id": 100790740,
      "Speaker": "Student",
      "Text": "아니라면 아닌 줄 알아 좀!"
    }
  ],
  "DialogEN": [
    {
      "Id": 100790010,
      "Speaker": "Student",
      "Text": "It's actually pretty fun here."
    },
    {
      "Id": 100790020,
      "Speaker": "Student",
      "Text": "Everything's a little familiar, a little different."
    },
    {
      "Id": 100790030,
      "Speaker": "Student",
      "Text": "It's like visiting a theme park."
    },
    {
      "Id": 100790040,
      "Speaker": "Player",
      "Text": "Hm? What do you mean, specifically?"
    },
    {
      "Id": 100790050,
      "Speaker": "Player",
      "Text": "What sort of things are familiar, but different?"
    },
    {
      "Id": 100790060,
      "Speaker": "Student",
      "Text": "Oh, lots of things."
    },
    {
      "Id": 100790070,
      "Speaker": "Student",
      "Text": "Maybe..."
    },
    {
      "Id": 100790080,
      "Speaker": "Student",
      "Text": "I think it would be easier to just show you."
    },
    {
      "Id": 100790090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "Is now a good time to meet?"
    },
    {
      "Id": 100790100,
      "Speaker": "Student",
      "Text": "..."
    },
    {
      "Id": 100790110,
      "Speaker": "Student",
      "Text": "Ugh..."
    },
    {
      "Id": 100790120,
      "Speaker": "Player",
      "Text": "I'm sorry."
    },
    {
      "Id": 100790130,
      "Speaker": "Player",
      "Text": "Maybe that was too much..."
    },
    {
      "Id": 100790140,
      "Speaker": "Student",
      "Text": "Ah!"
    },
    {
      "Id": 100790150,
      "Speaker": "Student",
      "Text": "No no, I'm grateful, Sensei."
    },
    {
      "Id": 100790160,
      "Speaker": "Student",
      "Text": "Thanks to you, I got to see the sights."
    },
    {
      "Id": 100790170,
      "Speaker": "Student",
      "Text": "That's plenty for now."
    },
    {
      "Id": 100790180,
      "Speaker": "Student",
      "Text": "...this..."
    },
    {
      "Id": 100790190,
      "Speaker": "Student",
      "Text": "...let's..."
    },
    {
      "Id": 100790200,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 100790210,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 100790220,
      "Speaker": "Student",
      "Text": "Sorry, but"
    },
    {
      "Id": 100790230,
      "Speaker": "Student",
      "Text": "is now a good time? I'm having a bit of trouble with some people..."
    },
    {
      "Id": 100790240,
      "Speaker": "Player",
      "Text": "Trouble with people?!"
    },
    {
      "Id": 100790250,
      "Speaker": "Player",
      "Text": "What's wrong? Who's troubling you?!"
    },
    {
      "Id": 100790260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "Well the trouble is..."
    },
    {
      "Id": 100790270,
      "Speaker": "Student",
      "Text": "Ugh..."
    },
    {
      "Id": 100790280,
      "Speaker": "Student",
      "Text": "I'm tired."
    },
    {
      "Id": 100790290,
      "Speaker": "Student",
      "Text": "Even here they're clinging to me and calling me Sissy."
    },
    {
      "Id": 100790300,
      "Speaker": "Player",
      "Text": "Even here?"
    },
    {
      "Id": 100790310,
      "Speaker": "Player",
      "Text": "You have friends like that back home?"
    },
    {
      "Id": 100790320,
      "Speaker": "Student",
      "Text": "Um..."
    },
    {
      "Id": 100790330,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 100790340,
      "Speaker": "Student",
      "Text": "It's a long story, so I'll cut it short here."
    },
    {
      "Id": 100790350,
      "Speaker": "Student",
      "Text": "But thanks for looking out for me."
    },
    {
      "Id": 100790360,
      "Speaker": "Student",
      "Text": "See you around, Sensei."
    },
    {
      "Id": 100790370,
      "Speaker": "Student",
      "Text": "Sensei..."
    },
    {
      "Id": 100790380,
      "Speaker": "Student",
      "Text": "Sensei, are you busy?"
    },
    {
      "Id": 100790390,
      "Speaker": "Player",
      "Text": "Hm? What is it?"
    },
    {
      "Id": 100790400,
      "Speaker": "Player",
      "Text": "Is it urgent?"
    },
    {
      "Id": 100790410,
      "Speaker": "Student",
      "Text": "Well..."
    },
    {
      "Id": 100790420,
      "Speaker": "Student",
      "Text": "I wouldn't call it urgent, but..."
    },
    {
      "Id": 100790430,
      "Speaker": "Student",
      "Text": "Anyway, are you busy?"
    },
    {
      "Id": 100790440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "There's something I want to ask you."
    },
    {
      "Id": 100790450,
      "Speaker": "Student",
      "Text": "Sensei, this...!"
    },
    {
      "Id": 100790460,
      "Speaker": "Student",
      "Text": "I don't think this is any ordinary Peroro!"
    },
    {
      "Id": 100790470,
      "Speaker": "Student",
      "Text": "This must be a Dr. Peroro, I think."
    },
    {
      "Id": 100790480,
      "Speaker": "Player",
      "Text": "That sounds the same to me..."
    },
    {
      "Id": 100790490,
      "Speaker": "Player",
      "Text": "Isn't it all just Peroro in the end?"
    },
    {
      "Id": 100790500,
      "Speaker": "Student",
      "Text": "?????"
    },
    {
      "Id": 100790510,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100790520,
      "Speaker": "Student",
      "Text": "Absolutely not."
    },
    {
      "Id": 100790530,
      "Speaker": "Student",
      "Text": "They are totally distinct."
    },
    {
      "Id": 100790540,
      "Speaker": "Student",
      "Text": "Hm..."
    },
    {
      "Id": 100790550,
      "Speaker": "Student",
      "Text": "I'll explain it all to you properly sometime."
    },
    {
      "Id": 100790560,
      "Speaker": "Student",
      "Text": "Anyway, thanks for today."
    },
    {
      "Id": 100790570,
      "Speaker": "Student",
      "Text": "See you again soon, Sensei!!"
    },
    {
      "Id": 100790580,
      "Speaker": "Student",
      "Text": "Argh!"
    },
    {
      "Id": 100790590,
      "Speaker": "Student",
      "Text": "What is this?"
    },
    {
      "Id": 100790600,
      "Speaker": "Student",
      "Text": "I've really still got to put up with this?"
    },
    {
      "Id": 100790610,
      "Speaker": "Player",
      "Text": "Hm? Even in another world?"
    },
    {
      "Id": 100790620,
      "Speaker": "Player",
      "Text": "What happened?"
    },
    {
      "Id": 100790630,
      "Speaker": "Student",
      "Text": "Ugh..."
    },
    {
      "Id": 100790640,
      "Speaker": "Student",
      "Text": "Sensei, could you come see me?"
    },
    {
      "Id": 100790650,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "I need your help again..."
    },
    {
      "Id": 100790660,
      "Speaker": "Student",
      "Text": "Now that I think about it..."
    },
    {
      "Id": 100790670,
      "Speaker": "Student",
      "Text": "And I'm mentioning this just in case..."
    },
    {
      "Id": 100790680,
      "Speaker": "Student",
      "Text": "I'm not a violent person,"
    },
    {
      "Id": 100790690,
      "Speaker": "Student",
      "Text": "you know?"
    },
    {
      "Id": 100790700,
      "Speaker": "Player",
      "Text": "I never said you were."
    },
    {
      "Id": 100790710,
      "Speaker": "Player",
      "Text": "If there's something you want to get off your chest..."
    },
    {
      "Id": 100790720,
      "Speaker": "Student",
      "Text": "Ah..."
    },
    {
      "Id": 100790730,
      "Speaker": "Student",
      "Text": "No."
    },
    {
      "Id": 100790740,
      "Speaker": "Student",
      "Text": "And I mean it!"
    }
  ],
  "DialogTH": [
    {
      "Id": 100790010,
      "Speaker": "Student",
      "Text": "ที่นี่ก็สนุกไม่เบาเลยนะ"
    },
    {
      "Id": 100790020,
      "Speaker": "Student",
      "Text": "ถึงทุกอย่างจะดูคล้ายกัน แต่ก็มีบางอย่าง\nที่แตกต่างกันอยู่นิดหน่อย"
    },
    {
      "Id": 100790030,
      "Speaker": "Student",
      "Text": "รู้สึกเหมือนได้มาเที่ยวเลย"
    },
    {
      "Id": 100790040,
      "Speaker": "Player",
      "Text": "หืม? ดูอะไรอยู่เหรอ?"
    },
    {
      "Id": 100790050,
      "Speaker": "Player",
      "Text": "คล้ายๆ แต่ก็แตกต่าง?\nหมายถึงอะไรเหรอ?"
    },
    {
      "Id": 100790060,
      "Speaker": "Student",
      "Text": "ก็หลายๆ อย่าง"
    },
    {
      "Id": 100790070,
      "Speaker": "Student",
      "Text": "นั่นสินะ"
    },
    {
      "Id": 100790080,
      "Speaker": "Student",
      "Text": "พอคิดๆ ดูแล้ว ให้คุณครูเห็นเองเลย\nน่าจะเข้าใจง่ายกว่า"
    },
    {
      "Id": 100790090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "ตอนนี้พอมีเวลารึเปล่า?"
    },
    {
      "Id": 100790100,
      "Speaker": "Student",
      "Text": "......"
    },
    {
      "Id": 100790110,
      "Speaker": "Student",
      "Text": "อึก"
    },
    {
      "Id": 100790120,
      "Speaker": "Player",
      "Text": "รู้สึกผิดแฮะ"
    },
    {
      "Id": 100790130,
      "Speaker": "Player",
      "Text": "เหนื่อยเปล่าเหรอเนี่ย..."
    },
    {
      "Id": 100790140,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100790150,
      "Speaker": "Student",
      "Text": "ไม่หรอก ฉันต้องขอบคุณ\nคุณครูมากกว่า"
    },
    {
      "Id": 100790160,
      "Speaker": "Student",
      "Text": "ฉันได้ไปดูอะไรมาเยอะเลย"
    },
    {
      "Id": 100790170,
      "Speaker": "Student",
      "Text": "แค่นั้นฉันก็พอใจแล้วละ"
    },
    {
      "Id": 100790180,
      "Speaker": "Student",
      "Text": "...แล้ว..."
    },
    {
      "Id": 100790190,
      "Speaker": "Student",
      "Text": "...ละ..."
    },
    {
      "Id": 100790200,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100790210,
      "Speaker": "Student",
      "Text": "เอ่อ"
    },
    {
      "Id": 100790220,
      "Speaker": "Student",
      "Text": "ขอโทษนะ"
    },
    {
      "Id": 100790230,
      "Speaker": "Student",
      "Text": "ตอนนี้ว่างมั้ย? พอดีฉันมีปัญหา\nกับคนอื่นๆ นิดหน่อยน่ะ..."
    },
    {
      "Id": 100790240,
      "Speaker": "Player",
      "Text": "มีปัญหากับคนอื่น!?"
    },
    {
      "Id": 100790250,
      "Speaker": "Player",
      "Text": "ว่าไงนะ?? ตอนนี้อยู่ที่ไหนน่ะ!?"
    },
    {
      "Id": 100790260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "เอ่อ..."
    },
    {
      "Id": 100790270,
      "Speaker": "Student",
      "Text": "เฮ้อ"
    },
    {
      "Id": 100790280,
      "Speaker": "Student",
      "Text": "เหนื่อยจัง"
    },
    {
      "Id": 100790290,
      "Speaker": "Student",
      "Text": "ไม่คิดเลยว่าขนาดอยู่ที่นี่ยังมีคนมาตาม\nแบบนี้อีก แถมยังมาเรียกว่าท่านพี่อีกด้วย"
    },
    {
      "Id": 100790300,
      "Speaker": "Player",
      "Text": "ที่นี่ก็ด้วยงั้นเหรอ?"
    },
    {
      "Id": 100790310,
      "Speaker": "Player",
      "Text": "ที่โลกโน้นมีคนเรียกแบบนั้น\nเหมือนกันสินะ"
    },
    {
      "Id": 100790320,
      "Speaker": "Student",
      "Text": "เอ่อ"
    },
    {
      "Id": 100790330,
      "Speaker": "Student",
      "Text": "อืม"
    },
    {
      "Id": 100790340,
      "Speaker": "Student",
      "Text": "ช่างเถอะ ถ้าพูดเดี๋ยวจะยืดยาวไปกว่านี้\nแค่นี้แล้วกัน"
    },
    {
      "Id": 100790350,
      "Speaker": "Student",
      "Text": "แต่ก็ขอบคุณที่บอกกัน\nในตอนสุดท้ายนะ"
    },
    {
      "Id": 100790360,
      "Speaker": "Student",
      "Text": "ไว้เจอกันใหม่นะคุณครู"
    },
    {
      "Id": 100790370,
      "Speaker": "Student",
      "Text": "คุณครู"
    },
    {
      "Id": 100790380,
      "Speaker": "Student",
      "Text": "ตอนนี้คุณครูยุ่งรึเปล่า?"
    },
    {
      "Id": 100790390,
      "Speaker": "Player",
      "Text": "หืม? มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 100790400,
      "Speaker": "Player",
      "Text": "มีเรื่องด่วนอะไรรึเปล่า?"
    },
    {
      "Id": 100790410,
      "Speaker": "Student",
      "Text": "เปล่าหรอก"
    },
    {
      "Id": 100790420,
      "Speaker": "Student",
      "Text": "มันก็ไม่ได้ด่วนอะไรขนาดนั้น..."
    },
    {
      "Id": 100790430,
      "Speaker": "Student",
      "Text": "ตกลงตอนนี้ยุ่งอยู่รึเปล่า?"
    },
    {
      "Id": 100790440,
      "Speaker": "Student",
      "StoryEpisode": 3,
      "Text": "ฉันมีอะไรจะถามหน่อยน่ะ"
    },
    {
      "Id": 100790450,
      "Speaker": "Student",
      "Text": "คุณครู อันนี้"
    },
    {
      "Id": 100790460,
      "Speaker": "Student",
      "Text": "ไม่น่าจะเป็นแค่เพโรโร่ธรรมดาๆ เลย"
    },
    {
      "Id": 100790470,
      "Speaker": "Student",
      "Text": "ชื่อที่ถูกต้องน่าจะเป็น\n'ด็อกเตอร์เพโรโร่' มากกว่านะ"
    },
    {
      "Id": 100790480,
      "Speaker": "Player",
      "Text": "ครูก็ว่างั้นแหละ"
    },
    {
      "Id": 100790490,
      "Speaker": "Player",
      "Text": "แต่ยังไงมันก็คือเพโรโร่อยู่ดี\nไม่ใช่เหรอ?"
    },
    {
      "Id": 100790500,
      "Speaker": "Student",
      "Text": "?????"
    },
    {
      "Id": 100790510,
      "Speaker": "Student",
      "Text": "ไม่"
    },
    {
      "Id": 100790520,
      "Speaker": "Student",
      "Text": "ไม่หรอก ไม่ๆ ไม่เด็ดขาด"
    },
    {
      "Id": 100790530,
      "Speaker": "Student",
      "Text": "มันต่างกันอย่างสิ้นเชิงเลยต่างหาก"
    },
    {
      "Id": 100790540,
      "Speaker": "Student",
      "Text": "ฮู่ว"
    },
    {
      "Id": 100790550,
      "Speaker": "Student",
      "Text": "ไว้ฉันจะไปหาข้อมูลมาแล้วมาอธิบายให้\nอีกทีแล้วกัน"
    },
    {
      "Id": 100790560,
      "Speaker": "Student",
      "Text": "เอาเป็นว่า วันนี้ขอบคุณมากเลย"
    },
    {
      "Id": 100790570,
      "Speaker": "Student",
      "Text": "ไว้เจอกันใหม่นะคุณครู!!"
    },
    {
      "Id": 100790580,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100790590,
      "Speaker": "Student",
      "Text": "นี่มันอะไรเนี่ย"
    },
    {
      "Id": 100790600,
      "Speaker": "Student",
      "Text": "มาที่นี่ก็ยังเป็นแบบนี้เหรอเนี่ย?"
    },
    {
      "Id": 100790610,
      "Speaker": "Player",
      "Text": "หืม? มาที่นี่ก็ยังเป็นแบบนี้?"
    },
    {
      "Id": 100790620,
      "Speaker": "Player",
      "Text": "มีเรื่องอะไรเหรอ?"
    },
    {
      "Id": 100790630,
      "Speaker": "Student",
      "Text": "อึก"
    },
    {
      "Id": 100790640,
      "Speaker": "Student",
      "Text": "คุณครู มาหาฉันหน่อยได้มั้ย?"
    },
    {
      "Id": 100790650,
      "Speaker": "Student",
      "StoryEpisode": 4,
      "Text": "ดูท่า ฉันคงต้องให้คุณครู\nช่วยอีกแล้ว..."
    },
    {
      "Id": 100790660,
      "Speaker": "Student",
      "Text": "จะว่าไป"
    },
    {
      "Id": 100790670,
      "Speaker": "Student",
      "Text": "นี่ฉันแค่บอกไว้เฉยๆ นะ"
    },
    {
      "Id": 100790680,
      "Speaker": "Student",
      "Text": "ฉันไม่ใช่คนที่ชอบใช้ความรุนแรงหรอก"
    },
    {
      "Id": 100790690,
      "Speaker": "Student",
      "Text": "เข้าใจใช่มั้ย?"
    },
    {
      "Id": 100790700,
      "Speaker": "Player",
      "Text": "ครูไม่เคยพูดอะไรแบบนั้นนี่"
    },
    {
      "Id": 100790710,
      "Speaker": "Player",
      "Text": "มีอะไรที่แทงใจรึไง..."
    },
    {
      "Id": 100790720,
      "Speaker": "Student",
      "Text": "อ่า"
    },
    {
      "Id": 100790730,
      "Speaker": "Student",
      "Text": "ไม่หรอก"
    },
    {
      "Id": 100790740,
      "Speaker": "Student",
      "Text": "ถ้าบอกว่าไม่ใช่ ก็แค่รู้ไว้ว่าไม่ใช่แล้วกัน!"
    }
  ],
  "DialogTW": [
    {
      "Id": 100790010,
      "Speaker": "Student",
      "Text": "這裡也很有趣呢"
    },
    {
      "Id": 100790020,
      "Speaker": "Student",
      "Text": "雖然乍看之下沒什麼區別，實際上卻有很多不同的地方"
    },
    {
      "Id": 100790030,
      "Speaker": "Student",
      "Text": "有種來到觀光景點的感覺"
    },
    {
      "Id": 100790040,
      "Speaker": "Player",
      "Text": "嗯？你在看什麼？"
    },
    {
      "Id": 100790050,
      "Speaker": "Player",
      "Text": "怎麼說呢？"
    },
    {
      "Id": 100790060,
      "Speaker": "Student",
      "Text": "各方面都是吧"
    },
    {
      "Id": 100790070,
      "Speaker": "Student",
      "Text": "對了"
    },
    {
      "Id": 100790080,
      "Speaker": "Student",
      "Text": "仔細想想，如果老師在的話說不定調查會更順利"
    },
    {
      "Id": 100790090,
      "Speaker": "Student",
      "StoryEpisode": 1,
      "Text": "現在有空嗎？"
    },
    {
      "Id": 100790100,
      "Speaker": "Student",
      "Text": "…………"
    },
    {
      "Id": 100790110,
      "Speaker": "Student",
      "Text": "咳哼"
    },
    {
      "Id": 100790120,
      "Speaker": "Player",
      "Text": "總覺得有點抱歉"
    },
    {
      "Id": 100790130,
      "Speaker": "Player",
      "Text": "白忙一場了嗎……"
    },
    {
      "Id": 100790140,
      "Speaker": "Student",
      "Text": "啊"
    },
    {
      "Id": 100790150,
      "Speaker": "Student",
      "Text": "不會，我很感謝老師"
    },
    {
      "Id": 100790160,
      "Speaker": "Student",
      "Text": "多虧有老師才能去那麼多地方"
    },
    {
      "Id": 100790170,
      "Speaker": "Student",
      "Text": "光是這樣，我就已經很滿足了"
    },
    {
      "Id": 100790180,
      "Speaker": "Student",
      "Text": "……我們……"
    },
    {
      "Id": 100790190,
      "Speaker": "Student",
      "Text": "一起……"
    },
    {
      "Id": 100790200,
      "Speaker": "Student",
      "Text": "老師"
    },
    {
      "Id": 100790210,
      "Speaker": "Student",
      "Text": "那個"
    },
    {
      "Id": 100790220,
      "Speaker": "Student",
      "Text": "抱歉"
    },
    {
      "Id": 100790230,
      "Speaker": "Student",
      "Text": "你現在有空嗎？我跟別人發生了一點糾紛……"
    },
    {
      "Id": 100790240,
      "Speaker": "Player",
      "Text": "跟別人發生了糾紛！？"
    },
    {
      "Id": 100790250,
      "Speaker": "Player",
      "Text": "什麼！？你現在在哪裡！？"
    },
    {
      "Id": 100790260,
      "Speaker": "Student",
      "StoryEpisode": 2,
      "Text": "那個……"
    },
    {
