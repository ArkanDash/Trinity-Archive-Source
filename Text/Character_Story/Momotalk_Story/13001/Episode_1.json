    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "こっちの方でもない……。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "こっちも、違う。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "う～ん……。"
    },
    {
      "Text": "[s] \"チセ、ちょっといい？\""
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "ん？なあに？"
    },
    {
      "Text": "[s1] \"特徴を教えてほしいな。\""
    },
    {
      "Text": "[s2] \"具体的には、どんな雲なの？\""
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "特徴……。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "特徴……。"
    },
    {
      "Text": "[s] \"それが分かったら私も探せるし。\""
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "……確かに。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "うん、それもそうだね。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "特徴……えっと、"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "まず……"
    },
    {
      "Text": "[s] \"まず……？\""
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "柔らかい。"
    },
    {
      "Text": "[s3] \"そういえばさっきも柔らかいって\""
    },
    {
      "Text": "[s4] \"言ってたね。他には？\""
