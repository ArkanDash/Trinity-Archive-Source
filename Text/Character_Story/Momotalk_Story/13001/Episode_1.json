    },
    {
      "Text": "[s10] \"……私？\""
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "うん、お日様みたいに暖かくて、良い香りがして、近くにいると幸せな気持ちにもなれて……。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "うん、お日様みたいに暖かくて、良い香りがして、近くにいると幸せな気持ちにもなれて……。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "大好きだなあって、そんな感じ。"
    },
    {
      "Text": "[s11] \"そ、そっか。\""
    },
    {
      "Text": "[s12] \"チセが見た雲の話……だよね？\""
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "そう、雲の話。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "そう、雲の話。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "こんなに良い空だったから、今日なら見つけられるんじゃないかなって。"
    },
    {
      "CharacterName": 4099878918,
      "Name": "チセ",
      "Text": "見つかったらいいな。"
    },
    {
