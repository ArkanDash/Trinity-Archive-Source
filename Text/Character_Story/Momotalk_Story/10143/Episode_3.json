  "DialogKR": [
    {
      "Text": "추억 되감기"
    },
    {
      "Text": "[ns] \"…….\""
    },
    {
      "Name": "슌",
      "Text": "왜, 왜 그러세요. 선생님?"
    },
    {
      "Text": "[s] \"정말…… 어제와 똑같이 하게?\""
    },
    {
      "Name": "슌",
      "Text": "여, 역시…… 부담스러우실…… 까요……?"
    },
    {
      "Name": "슌",
      "Text": "어제의 기억을 오늘의 기억으로 덮어씌우기 위해, 어제 갔던 곳을 다시 한번 가 본다는…… 제 생각이……."
    },
    {
      "Text": "[s1] \"그런 건 아닌데!\""
    },
    {
      "Text": "[s2] \"한번 해봤던 것들이었으니까, 지겹지 않을까 해서…….\""
    },
    {
      "Name": "슌",
      "Text": "아뇨. 그럴 일은 없을 거예요."
    },
    {
      "Name": "슌",
      "Text": "선생님도 아시다시피, 환경이 같다고 해도 '어렸을' 때의 경험과 '자랐을' 때의 경험은, 다르게 다가오는 법이잖아요?"
    },
    {
      "Name": "슌",
      "Text": "아……. 그렇지만 생각해 보니 선생님에게는…… 역시, 지루하게 느껴지시려나요……?"
    },
    {
      "Text": "[s3] \"나, 나는 괜찮아!\""
    },
    {
      "Text": "[s4] \"오늘은 '슌'과 함께 하는 경험이니까!\""
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "그렇게 말씀해 주셔서 감사합니다. 선생님. "
    },
    {
      "Name": "슌",
      "Text": "그러면, 오늘 하루 잘 부탁드릴게요."
    },
    {
      "Name": "래프팅 강사",
      "Text": "래프팅은 정말 신나죠! 제가 주의 사항을 말씀드리겠습니다."
    },
    {
      "Name": "래프팅 강사",
      "Text": "그러면 출발하도록 하죠!"
    },
    {
      "Name": "슌",
      "Text": "잘 부탁드리겠습니다."
    },
    {
      "Name": "래프팅 강사",
      "Text": "자, 여기에서 오른쪽을 보시면 동굴 같은 구멍이 뚫린 큰 바위가 보일 텐데요."
    },
    {
      "Name": "슌",
      "Text": "어머나. 꼭 물소처럼 생겼네요. 혹시 물소 바위인가요?"
    },
    {
      "Name": "래프팅 강사",
      "Text": "오호라, 눈썰미가 좋으시군요! 아니면 혹시 미리 이 계곡에 대해 알아보고 오신 건가요? 저희로서는 감사한 일이네요."
    },
    {
      "Name": "래프팅 강사",
      "Text": "함께 오신 분이 좋아하시겠어요!"
    },
    {
      "Name": "슌",
      "Text": "네, 네?! 그, 그러니까…… 그게……!"
    },
    {
      "Name": "래프팅 강사",
      "Text": "아이구, 오늘따라 물살이 강하네요. 꽉 잡으세요!"
    },
    {
      "Text": "[ns] \"어, 어어?!\""
    },
    {
      "Name": "슌",
      "Text": "선생님?!"
    },
    {
      "Name": "래프팅 강사",
      "Text": "잘 하셨습니다! 이 물살을 빠져나갈 때 까지 조금만 서로를 꼭 붙잡고 계십쇼!"
    },
    {
      "Name": "슌",
      "Text": "그, 그렇다고 하네요. 선생님."
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "저만, 믿으세요. 아셨죠?"
    },
    {
      "Text": "[s] \"으, 응……!\""
    },
    {
      "Name": "래프팅 강사",
      "Text": "이것으로 오늘의 래프팅을 종료하겠습니다!"
    },
    {
      "Name": "슌",
      "Text": "감사합니다. 정말 수고 많으셨습니다."
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "어, 어떠셨나요. 선생님?"
    },
    {
      "Name": "슌",
      "Text": "어제와 비교해서…… 새로운 경험이, 되셨을까요?"
    },
    {
      "Name": "슌",
      "Text": "저는…… 그랬던 것 같아요."
    },
    {
      "Text": "[s] \"나, 나도…… 마찬가지야!\""
    },
    {
      "Name": "슌",
      "Text": "다행이네요……."
    },
    {
      "Name": "슌",
      "Text": "그러면! 이제부터 상가 거리에 한번, 가 보지 않으시겠어요?"
    },
    {
      "Name": "슌",
      "Text": "기억나네요. 어제 처음으로 먹었던 음식이, 바비큐였죠. 그러면 오늘은……."
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "오늘은 그냥 한가하게…… 같이 온 일행처럼, 선생님과 함께 걷고 싶은데…… 괜찮으실까요?"
    },
    {
      "Text": "[s] \"응? 그래. 그러자.\""
    },
    {
      "Name": "슌",
      "Text": "네……. 감사합니다. 선생님. 그러면……."
    },
    {
      "Text": "(슌이 돌연 자연스럽게 팔짱을 껴 왔다……!)"
    },
    {
      "Name": "슌",
      "Text": "……괜찮, 으시죠? 같이 온 일행…… 이니까요."
    },
    {
      "Name": "슌",
      "Text": "후후……."
    },
    {
      "Name": "슌",
      "Text": "다시 한번, 감사합니다. 선생님."
    },
    {
      "Text": "(슌과 함께, 한가하게 거리를 걸어 다녔다.)"
    },
    {
      "Text": "(결국 도중에 배가 고파져서, 식당을 찾기도 했지만.)"
    },
    {
      "Name": "슌",
      "Text": "이틀 연속이나 제 어리광을 받아 주셔서 감사합니다. 선생님."
    },
    {
      "Text": "[s] \"오히려 내가 고마웠어…….\""
    },
    {
      "Name": "슌",
      "Text": "어머나. 그렇게 생각해 주실 줄은."
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "제가 스스로 말하는 것도 우스울지도 모르지만, 조금 신기한 경험이었어요. "
    },
    {
      "Text": "[s] \"어떤 점이?\""
    },
    {
      "Name": "슌",
      "Text": "어제와 오늘…… 거의 같은 상황이었잖아요?"
    },
    {
      "Name": "슌",
      "Text": "하지만 그 같은 상황에서 저는…… 조금, 다르게 행동하고 대응했던 것 같아서요."
    },
    {
      "Name": "슌",
      "Text": "제 입으로 말하려니 조금 부끄럽기도 하지만, 제 행동이……. 어제보다 뭔가 더욱 '성숙했던' 것 같았거든요."
    },
    {
      "Name": "슌",
      "Text": "어렸을 때의 기억도 떠오르고, 그때 제가 어떤 식으로 행동했는지도 기억나고……."
    },
    {
      "Name": "슌",
      "Text": "그런 것들이, 뭔가……."
    },
    {
      "Name": "슌",
      "Text": "꼭 어제와 오늘이 아니더라도, 산과 강은 그 모습 그대로 남아 있는데, 거기에 있는 저…… 사람만이 변한 것 같아서요."
    },
    {
      "Text": "[s] \"사실 산과 강도 느리게 변하기는 해.\""
    },
    {
      "Name": "슌",
      "Text": "그건 그렇죠. 하지만 공유하는 시간 자체가 다르다고 할까요."
    },
    {
      "Name": "슌",
      "Text": "저도 언젠가 선생님처럼, 저의 시간을 살아 낸 다음, 되어야만 하는 어른이 되겠지만……."
    },
    {
      "Name": "슌",
      "Text": "그렇게 되어도 저는, 선생님만큼 충분한 '어른'이 되지 못할 것 같다는 생각이 들기도 하고요."
    },
    {
      "Name": "슌",
      "Text": "네? 그건 제가 선생님을 너무 높게 평가하고 있는 것일지도 모른다고요?"
    },
    {
      "Text": "[s] \"어른도 말이지……. 가슴에 어린아이를 최소 세 명 숨기고 있단다…….\""
    },
    {
      "Name": "슌",
      "Text": "하, 한 명이나 두 명도 아니고 세 명이라니, 구체적인 숫자가 뭔가 마음에 와닿네요……."
    },
    {
      "Name": "슌",
      "Text": "사람은 결국 언제까지나 자라도, 어디 한군데는 어린아이일 수밖에 없는 것이라고요?"
    },
    {
      "Name": "슌",
      "Text": "후후……."
    },
    {
      "Name": "슌",
      "Text": "그러면 선생님도, 선생님 안쪽 어딘가에 그런 개구쟁이가 숨어 있다는 뜻이겠네요?"
    },
    {
      "Text": "[s5] \"슌 누나~ 놀아 주세요~\""
    },
    {
      "Text": "[s6] \"슌 언니~ 놀아 주세요~\""
    },
    {
      "Name": "슌",
      "Text": "서, 선생님?!"
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "자, 자. 이리 오세요. [USERNAME] 어린이. 우리 같이 놀까요?"
    },
    {
      "Text": "[s7] \"와아~ 슌 누나 최고~\""
    },
    {
      "Text": "[s8] \"와아~ 슌 언니 최고~\""
    },
    {
      "Name": "슌",
      "Text": "네, 네. 이제 다 괜찮답니다. 무섭고 어려운 건 제가 모두 쫓아내 버렸어요."
    },
    {
      "Text": "(다음 순간 슌의 부드러운 느낌이, 모든 감각을 가득 채웠다……!"
    },
    {
      "Text": "[ns] \"?!?!\""
    },
    {
      "Name": "슌",
      "Text": "쉬잇. 착하죠, [USERNAME] 어린이."
    },
    {
      "Name": "슌",
      "Text": "저만, 믿어도 좋으니까요."
    },
    {
      "Name": "슌",
      "Text": "적어도, 지금은요."
    },
    {
      "Text": "[ns] \"…….\""
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Text": "[s] \"…….\""
    },
    {
      "Name": "슌",
      "Text": "…………."
    },
    {
      "Name": "슌",
      "Text": "……서, 선생님……? 뭔가, 말씀을……."
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Text": "[s] \"……죄송합니다. 너무 분위기를 타 버렸습니다.\""
    },
    {
      "Name": "슌",
      "Text": "아, 아뇨! 오히려 제가……."
    },
    {
      "Name": "슌",
      "Text": "거기에 사실, 저는 나쁘지 않았고……. 오히려 좋았고……. 허락만 된다면 더 그렇게 있고 싶기도 했고……."
    },
    {
      "Name": "슌",
      "Text": "크, 크흠!"
    },
    {
      "Name": "슌",
      "Text": "여름 계곡이라는 건! 무섭네요!"
    },
    {
      "Text": "[s] \"그, 그러게! 정말로 그래!\""
    },
    {
      "Name": "슌",
      "Text": "그렇죠?! 그러니까 조금 전까지 있었던 모든 일은, 여름 계곡 때문인 것으로 하죠!"
    },
    {
      "Text": "(격렬하게 찬성하며 고개를 끄덕였다!)"
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "풋……. 후훗……. 아하하하……!"
    },
    {
      "Name": "슌",
      "Text": "표, 표정이 왜 그러세요, 선생님! "
    },
    {
      "Name": "슌",
      "Text": "네? 저도 어딘가 어색해 보이는 건 마찬가지라고요?"
    },
    {
      "Name": "슌",
      "Text": "……."
    },
    {
      "Name": "슌",
      "Text": "정말 어쩔 수 없네요, 여름 계곡!"
    },
    {
      "Text": "(슌과 함께 한참이나, 어색함이 모두 사라질 때까지 서로를 보며 웃었다.)"
    },
    {
      "Name": "슌",
      "Text": "그런데, 선생님?"
    },
    {
      "Name": "슌",
      "Text": "어제와 오늘 말인데요……."
    },
    {
      "Name": "슌",
      "Text": "지금의 저와 어린 저, 어느 쪽이 더 좋으셨나요?"
    },
    {
      "Text": "[ns] \"……!\""
    },
    {
      "Text": "[ns] \"어, 어느 쪽이든 모두 선생님에게는, 똑같은 슌이니까……!\""
    },
    {
      "Name": "슌",
      "Text": "안 돼요."
    },
    {
      "Name": "슌",
      "Text": "그렇게 '선생님다운' 대답, 이번에는 접수해드리지 않을 테니까요!"
    },
    {
      "Text": "(집요하게 질문해 오는 슌을 어떻게든 얼버무리며, 간신히 숙소로 향했다…….)"
    }
  ],
