    {
      "Name": "ラフティングガイド",
      "Text": "はいっ、いっち、にっ、いっち、にっ！"
    },
    {
      "Name": "シュエリン",
      "Text": "――いっち、にっ！"
    },
    {
      "Text": "[s] \"いっち、にっ！！\""
    },
    {
      "Text": "（ガイドに従って漕ぎ始めた！）"
    },
    {
      "Name": "シュエリン",
      "Text": "あ、先生！見てください！"
    },
    {
      "Name": "シュエリン",
      "Text": "私たち、あの急流を下るんですね！"
    },
    {
      "Name": "ラフティングガイド",
      "Text": "最初の大きなポイントですよ！岩に気をつけてください！"
    },
    {
      "Name": "シュエリン",
      "Text": "きゃー！！！"
    },
    {
      "Text": "（ボートが適度な高さまで上がった！）"
    },
    {
      "Text": "（川の水が波立ち、すっかり濡れてしまった！）"
    },
    {
      "Name": "ラフティングガイド",
      "Text": "右側に、大きな穴の開いた岩がありますよね？"
    },
    {
