    {
      "Text": "（少しぼーっとしながら、その様子を見つめていると……）"
    },
    {
      "Name": "シュエリン",
      "Text": "わ、わあ！？"
    },
    {
      "Text": "[ns] \"ん……？ど、どうしたの！？！？\""
    },
    {
      "Text": "[wa:2020]― [log=슌 수영복]えっ、[wa:600]ひゃああ！？[/log]"
    },
    {
      "Text": "― [log=슌 수영복]せ、[wa:278]先生！？[/log]"
    },
    {
      "Text": "― [log=슌 수영복]これは、[wa:630]その……！[/log]"
    },
    {
      "Text": "[wa:1210]― [log=슌 수영복]そ、[wa:350]そういえば……。[/log]"
    },
    {
      "Text": "― [log=슌 수영복]サヤさんが、[wa:1070]少し不安定になるかもと仰っていましたが……っ[wa:3000]まさか……？[/log]"
    },
    {
      "Text": "[ns] \"ご、ごめん！\""
    },
    {
      "Text": "[wa:880]― [log=슌 수영복]せ、[wa:440]先生が謝る必要はありません……！[/log]"
    },
    {
      "Text": "― [log=슌 수영복]と、[wa:380]というか……[wa:970]あの……[wa:1280]えっと。[/log]"
    },
    {
      "Text": "― [log=슌 수영복]わ、[wa:570]私はどうしたら……！[/log]"
    },
    {
      "Text": "[ns] \"と、とりあえず……私はあっちに行くね！\""
    },
    {
      "Text": "[wa:660]― [log=슌 수영복]ダメです！[/log]"
    },
    {
      "Text": "― [log=슌 수영복]そ、[wa:260]その……！[/log]"
    },
    {
      "Text": "― [log=슌 수영복]そこに立っていただいてもいいですか？[/log]"
    },
    {
      "Text": "― [log=슌 수영복]隠れるので……。[/log]"
    },
    {
      "Text": "[wa:2260]― [log=슌 수영복]私……[wa:1550]大丈夫、[wa:880]ですから。[/log]"
    },
    {
      "Text": "― [log=슌 수영복]先生、[wa:750]でしたら……[/log]"
