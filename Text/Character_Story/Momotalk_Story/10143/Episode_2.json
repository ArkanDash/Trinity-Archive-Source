  "DialogJP": [
    {
      "Text": "夏。いつもとは違う一面。"
    },
    {
      "Name": "シュエリン",
      "Text": "こんにちは！先生！！！"
    },
    {
      "Text": "[ns] \"……。\""
    },
    {
      "Name": "シュエリン",
      "Text": "どうかしましたか？"
    },
    {
      "Text": "[s] \"いつもとは違った一面って……。\""
    },
    {
      "Name": "シュエリン",
      "Text": "えへへ。そうです。間違っていませんよね？"
    },
    {
      "Text": "[s] \"たしかにそうだけど……。\""
    },
    {
      "Name": "シュエリン",
      "Text": "ほら、遊びに行きましょう！"
    },
    {
      "Name": "シュエリン",
      "Text": "時間は有限ですよ！"
    },
    {
      "Text": "（シュエリンの手に引かれ、ロープウェイ乗り場に向かった……）"
    },
    {
      "Name": "シュエリン",
      "Text": "見てください！建物がおもちゃみたいですよ！"
    },
    {
      "Name": "シュエリン",
      "Text": "あの山、本当に不思議な形です……！"
    },
    {
      "Name": "シュエリン",
      "Text": "この辺りはコウノキがたくさん生えているんですね！"
    },
    {
      "Text": "[s] \"ところで……体は大丈夫なの？\""
    },
    {
      "Name": "シュエリン",
      "Text": "あ……「若返りの秘薬」のこと、ですよね？"
