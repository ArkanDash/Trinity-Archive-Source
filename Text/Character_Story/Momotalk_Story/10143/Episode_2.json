    },
    {
      "Name": "シュエリン",
      "Text": "はい！"
    },
    {
      "Name": "シュエリン",
      "Text": "……いよいよですね！"
    },
    {
      "Name": "シュエリン",
      "Text": "あははっ！"
    },
    {
      "Name": "シュエリン",
      "Text": "すごいですね！"
    },
    {
      "Name": "シュエリン",
      "Text": "わあっ！？"
    },
    {
      "Text": "[ns] \"危ない！\""
