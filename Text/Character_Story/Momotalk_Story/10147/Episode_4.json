  "DialogJP": [
    {
      "Text": "サツキの視線対策"
    },
    {
      "Name": "サツキ",
      "Text": "こっちのビーチは人が多いわ……。"
    },
    {
      "Name": "サツキ",
      "Text": "同じ海でも、場所によって結構違うのね。"
    },
    {
      "Text": "[s1] \"にぎやかというか――\""
    },
    {
      "Text": "[s2] \"『ザ・海！』って感じだね。\""
    },
    {
      "Name": "サツキ",
      "Text": "そうね。ちょっと騒がしいくらいだわ。"
    },
    {
      "Name": "サツキ",
      "Text": "実は私、人が多い場所ってあまり好きじゃないの。"
    },
    {
      "Name": "サツキ",
      "Text": "人が多いと、気にすることが増えるじゃない？"
    },
    {
      "Name": "サツキ",
      "Text": "それでもここに来たのは――"
    },
    {
      "Name": "サツキ",
      "Text": "いつもと違う環境で、私の心がどう動くか観察したかったから。"
    },
    {
      "Name": "サツキ",
      "Text": "最近、先生と一緒にいると不思議な気分になるの。"
    },
    {
      "Name": "サツキ",
      "Text": "あ、別にイヤとかじゃないのよ？むしろその逆。"
    },
    {
      "Name": "サツキ",
      "Text": "帰ったら、今日のデータをもとにその理由を分析してみるつもり。"
    },
    {
      "Name": "子供A",
      "Text": "あははっ！捕まえたらジュースもらうね！"
    },
    {
      "Name": "子供B",
      "Text": "待ってよ……あっ！"
    },
    {
      "Text": "[ns] \"あちゃ～、派手に転んじゃったね……！\""
    },
    {
      "Name": "子供B",
      "Text": "うわあああん！痛いよ～！！"
    },
    {
      "Text": "[ns] \"大丈夫？怪我はない？\""
    },
    {
      "Name": "子供B",
      "Text": "ぐすっ……うん……。"
    },
    {
      "Text": "[s] \"砂の上は転びやすいから、ゆっくり歩こうね。\""
    },
    {
      "Name": "子供B",
      "Text": "うん！ゆっくり歩く！"
    },
    {
      "Name": "子供A",
      "Text": "ゆっくり歩く～！"
    },
    {
      "Name": "サツキ",
      "Text": "へぇ……すぐ泣き止んでえらいわね。痛かったでしょうに。"
    },
    {
      "Name": "サツキ",
      "Text": "それにしても……先生は子どもの扱いにも慣れてるのね。"
    },
    {
      "Text": "[s] \"一応先生だからね。\""
    },
    {
      "Name": "サツキ",
      "Text": "うふふ。さすが私の協力者といったところかしら。"
    },
    {
      "Name": "サツキ",
      "Text": "それで、さっきの話だけど――"
    },
    {
      "Name": "観光客A",
      "Text": "た、助けてください！！"
    },
    {
      "Name": "サツキ",
      "Text": "えっ……。"
    },
    {
      "Text": "[s] \"誰か溺れてる！？\""
    },
    {
      "Text": "（溺れかけている人を、水から引き上げた）"
    },
    {
      "Name": "観光客",
      "Text": "はぁ、はぁ……あ、ありがとうございます……。"
    },
    {
      "Name": "観光客",
      "Text": "突然足がつっちゃって……頭が真っ白になっちゃいまして……。"
    },
    {
      "Text": "[s] \"準備運動を入念にすると良いかもしれませんね。\""
    },
    {
      "Name": "観光客",
      "Text": "いやぁ～海を見ていると飛び込みたくなっちゃった！すみません！"
    },
    {
      "Name": "観光客",
      "Text": "おかげで命拾いしました。助けていただきありがとうございます。"
    },
    {
      "Name": "サツキ",
      "Text": "ふぅん……あんなに即座に動けるなんて。"
    },
    {
      "Name": "サツキ",
      "Text": "困っている人を見ると放っておけないのかしら。"
    },
    {
      "Name": "サツキ",
      "Text": "でも気をつけて頂戴。\n水難事故の救助は、救助者も巻き込まれる可能性があるのよ。"
    },
    {
      "Text": "[s3] \"うん、ありがとう。\""
    },
    {
      "Text": "[s4] \"気をつけるね。\""
    },
    {
      "Name": "サツキ",
      "Text": "人が多いと、こういう問題も出てくるわね。"
    },
    {
      "Name": "サツキ",
      "Text": "じゃあ――"
    },
    {
      "Name": "ヴァルキューレの海警",
      "Text": "あれ？もしかしてシャーレの先生ですか？"
    },
    {
      "Text": "[s] \"うん、そうだよ。\""
    },
    {
      "Name": "ヴァルキューレの海警",
      "Text": "ちょうどよかった！ もしよろしければ、少し手伝っていただけませんか？"
    },
    {
      "Name": "ヴァルキューレの海警",
      "Text": "海の家でちょっとしたケンカが起きているんですが、二人とも強情で……。"
    },
    {
      "Name": "ヴァルキューレの海警",
      "Text": "私たちだけでは手に負えなくて……。\n先生の話なら、二人とも聞くと思うのですが……。"
    },
    {
      "Text": "[s] \"どこに行けばいい？\""
    },
    {
      "Name": "ヴァルキューレの海警",
      "Text": "ありがとうございます！こちらです！"
    },
    {
      "Text": "（その後もトラブルは続き、忙しく動き回った……）"
    },
    {
      "Text": "[ns] \"ふう……。\""
    },
    {
      "Name": "サツキ",
      "Text": "……。"
    },
    {
      "Text": "[s] \"ごめんね、サツキ……ずっとバタバタしてて。\""
    },
    {
      "Name": "サツキ",
      "Text": "ふぅん……。"
    },
    {
      "Name": "サツキ",
      "Text": "まあ、仕方ないわ。"
    },
    {
      "Name": "サツキ",
      "Text": "先生は事件を見過ごせない性分だものね。"
    },
    {
      "Name": "サツキ",
      "Text": "でも……視野が広すぎるのも考え物よ。"
    },
    {
      "Name": "サツキ",
      "Text": "今日起きた事件のほとんどは、先生がいなくても解決したんじゃない？"
    },
    {
      "Text": "[s] \"それは……そうかも。\""
    },
    {
      "Name": "サツキ",
      "Text": "だから……今からはよそ見禁止。"
    },
    {
      "Name": "サツキ",
      "Text": "先生は私のことだけ見ていればいいの。"
    },
    {
      "Name": "サツキ",
      "Text": "それが一番安全なんだから。"
    },
    {
      "Text": "[s] \"周りを見ないほうが、むしろ危ないと思うんだけど……。\""
    },
    {
      "Name": "サツキ",
      "Text": "先生の代わりに、私が見ていてあげる。これで安心でしょ？"
    },
    {
      "Name": "サツキ",
      "Text": "だから……先生は私だけ見ていて頂戴。"
    },
    {
      "Name": "サツキ",
      "Text": "ほら、ここに座って。"
    },
    {
      "Text": "（しばらくして……）"
    },
    {
      "Name": "サツキ",
      "Text": "……。"
    },
    {
      "Text": "[s] \"ねえ、サツキ。\""
    },
    {
      "Name": "サツキ",
      "Text": "なぁに、先生？"
    },
    {
      "Text": "[s5] \"サツキもずっと私のこと見てるけど……。\""
    },
    {
      "Text": "[s6] \"これだと、他を見られてないんじゃない？\""
    },
    {
      "Name": "サツキ",
      "Text": "え？そ、そうかしら？"
    },
    {
      "Name": "サツキ",
      "Text": "私……そんなに先生のことばかり見ているの……？"
    },
    {
      "Text": "[s] \"うん。さっきからずっと……。\""
    },
    {
      "Name": "サツキ",
      "Text": "……。"
    },
    {
      "Name": "サツキ",
      "Text": "よ、よく気づいたわね！"
    },
    {
      "Name": "サツキ",
      "Text": "先生がちゃんと私の話を聞いているかテストしていたのよ。"
    },
    {
      "Name": "サツキ",
      "Text": "さ、気を取り直して続けましょ。"
    },
    {
      "Text": "（それからも、サツキが視線をそらすことはなかった）"
    },
    {
      "Text": "（帰るまで、ずっと私だけをどこか嬉しそうに見ていた）"
    }
  ],
  "DialogKR": [
    {
      "Text": "사츠키의 시선 대책"
    },
    {
      "Name": "사츠키",
      "Text": "이쪽 해변에는 확실히 사람이 많네~"
