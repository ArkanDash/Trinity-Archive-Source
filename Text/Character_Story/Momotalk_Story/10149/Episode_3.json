    {
      "Text": "[s5] \"いいの？\""
    },
    {
      "Text": "[s6] \"ちょうどお腹が空いてたんだ！\""
    },
    {
      "Name": "ココロ",
      "Text": "ちょっと待っててください。すぐに温めてきます。"
    },
    {
      "Text": "[s7] \"あれ？だけど前に言ってなかったっけ……？\""
