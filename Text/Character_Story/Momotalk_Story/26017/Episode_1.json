{
  "TitleJP": "パケットスリーピング",
  "TitleKR": "패킷 슬리핑",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "シャーレに届いた正体不明の大きな箱。先生が慎重に開けてみると、その中には「お土産」としてラナが入っていた。",
  "DescKR": "샬레에 배달된 정체불명의 커다란 상자. 선생님이 조심스럽게 열어보니, 그 안에는 라나가 스스로를 선물로 삼아 들어가 있었다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "パケットスリーピング"
    },
    {
      "Text": "（そろそろ荷物が届く時間だ……）"
    },
    {
      "Text": "（気になって、なかなか仕事が手につかない）"
    },
    {
      "CharacterName": 2842136588,
      "Name": "配達員",
      "Text": "お荷物お届けに上がりました。"
    },
    {
      "Text": "[ns] \"来たあああぁぁぁ！！！\""
    },
    {
      "CharacterName": 2842136588,
      "Name": "配達員",
      "Text": "こんにちは。今日は量が多いですね。"
    },
    {
      "CharacterName": 2842136588,
      "Name": "配達員",
      "Text": "ドアの前に他の荷物もあったので、一緒に入れておきましたよ。"
    },
    {
      "CharacterName": 2842136588,
      "Name": "配達員",
      "Text": "この大きな段ボールはどこに置きましょうか？"
    },
    {
      "Text": "[s] \"これは……何の荷物でしょうか……？\""
    },
    {
      "CharacterName": 2842136588,
      "Name": "配達員",
      "Text": "さあ？私も分からないです。\nドアの前に置いてあったので、こちら宛の荷物だと思うのですが……。"
    },
    {
      "CharacterName": 2842136588,
      "Name": "配達員",
      "Text": "では、すみませんが……私はこれで。"
    },
    {
      "Text": "[ns1] \"……。\""
    },
    {
      "Text": "[ns2] （恐る恐る段ボールを開けてみる）"
    },
    {
      "Text": "[wa:800]― [log=라나]……[wa:2350]お世話になっております、[wa:1690]先生。[/log] "
    },
    {
      "Text": "― [log=라나]見慣れた天井……[wa:2250]ですね。[/log] "
    },
    {
      "Text": "― [log=라나]なんとかお会いできて[wa:1200]よかったです。[/log] "
    },
    {
      "Text": "[ns] \"ラナ！？どうして段ボールの中に！？\""
    },
    {
      "Text": "[wa:630]― [log=라나]うん？[wa:1690]宅配の荷物に[wa:1310]入っている理由……？[/log]"
    },
    {
      "Text": "― [log=라나]「入ったから」です。[/log]"
    },
    {
      "Text": "― [log=라나]列車の乗車券を買ったら、[/log]"
    },
    {
      "Text": "― [log=라나]お土産を買えなくなってしまって……。[/log]"
    },
    {
      "Text": "― [log=라나]そうしたら、[wa:1280]シャーレにちょうど[/log]"
    },
    {
      "Text": "― [log=라나]先生宛の段ボールが[wa:1430]あるではないですか。 [/log]"
    },
    {
      "Text": "― [log=라나]なので、[wa:1280]お土産になってみました。[/log]"
    },
    {
      "Text": "[ns] \"捨てた段ボールの中にずっと入ってたの！？大丈夫だった？\""
    },
    {
      "Text": "[wa:680]― [log=라나]問題ありません。[/log] "
    },
    {
      "Text": "― [log=라나]暇つぶしは得意です――[/log] "
    },
    {
      "Text": "― [log=라나]緩衝材はふかふかでしたし、[/log] "
    },
    {
      "Text": "― [log=라나]先生が開封の際に[wa:1550]気をつけてくださったので、[wa:1970]無事です。[/log] "
    },
    {
      "Text": "― [log=라나]ふふっ……。[/log] "
    },
    {
      "Text": "[wa:1920]― [log=라나]こうして顔が見れて、[wa:1970]嬉しいです。[/log] "
    },
    {
      "Text": "― [log=라나]すごく、[wa:1660]会いたかったです。[wa:1360]先生。[/log] "
    },
    {
      "Text": "― [log=라나]うぅん……。[/log] "
    },
    {
      "Text": "[wa:600]― [log=라나]ふぁ……。[/log] "
    },
    {
      "Text": "― [log=라나]それでは、[wa:1860]おやすみなさい。[/log] "
    },
    {
      "Text": "― [log=라나]すやぁ……。[/log] "
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "すぅ……すぅ……。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "せん……せい……。"
    },
    {
      "Text": "（寝てしまったラナをそっと抱き上げて、ベッドに移動させた）"
    },
    {
      "Text": "（とても疲れていたのか、ぐっすりと眠っていた）"
    },
    {
      "Text": "（しばらくするとラナが目を覚ましたので、玄関まで見送った）"
    }
  ],
  "DialogKR": [
    {
      "Text": "패킷 슬리핑"
    },
    {
      "Text": "(택배가 올 시간인데…….)"
    },
    {
      "Text": "(라고 생각하며, 일에 집중하지 않고 있었다.)"
    },
    {
      "CharacterName": 2842136588,
      "Name": "택배 기사",
      "Text": "택배 왔습니다-!"
    },
    {
      "Text": "[ns] \"택배다!!!!!!!!!!!!!!\""
    },
    {
      "CharacterName": 2842136588,
      "Name": "택배 기사",
      "Text": "아휴, 안녕하십니까. 오늘은 평소보다 물건이 많네요?"
    },
    {
      "CharacterName": 2842136588,
      "Name": "택배 기사",
      "Text": "문 앞에 다른 택배도 있길래, 같이 들여놨습니다."
    },
    {
      "CharacterName": 2842136588,
      "Name": "택배 기사",
      "Text": "이 커다란 상자는 어디에 둘까요?"
    },
    {
      "Text": "[s] \"이건…… 무슨 상자일까요……?\""
    },
    {
      "CharacterName": 2842136588,
      "Name": "택배 기사",
      "Text": "글쎄요? 저도 모르겠습니다. 문 앞에 놓여있으니 여기로 온 택배인 줄 알았는데요……."
    },
    {
      "CharacterName": 2842136588,
      "Name": "택배 기사",
      "Text": "그럼, 이만 가보겠습니다! 오늘도 수고하십쇼-"
    },
    {
      "Text": "[ns1] \"…….\""
    },
    {
      "Text": "[ns2] (조심스럽게 상자를 손으로 열어본다.)"
    },
    {
      "Text": "[wa:800]― [log=라나]……[wa:2350]신세지고 있습니다. [wa:1690]선생님.[/log]"
    },
    {
      "Text": "― [log=라나]익숙한 천장, [wa:2250]이군요.[/log]"
    },
    {
      "Text": "― [log=라나]어떻게든 만나서, [wa:1200]다행입니다. [/log]"
    },
    {
      "Text": "[ns] \"라나?! 어째서 택배 상자에 있는 거니?\""
    },
    {
      "Text": "[wa:630]― [log=라나]네? [wa:1690]'어째서 택배 상자에 [wa:1070]있느냐'……?[wa:80] [/log]"
    },
    {
      "Text": "― [log=라나]'들어갔기 때문' 입니다.[/log]"
    },
    {
      "Text": "― [log=라나]기차표를 샀더니,[/log]"
    },
    {
      "Text": "― [log=라나]선물을 살 여유가 없어서……[wa:80] [/log]"
    },
    {
      "Text": "― [log=라나]도착하고 보니, [wa:1160]샬레에 마침[wa:80] [/log]"
    },
    {
      "Text": "― [log=라나]선생님께 온 상자가 [wa:1350]있었지 뭡니까.[wa:80] [/log]"
    },
    {
      "Text": "― [log=라나]그래서, [wa:1200]직접 선물이 되었습니다.[/log]"
    },
    {
      "Text": "[ns] \"버린 상자 속에서 계속 기다린 거니? 괜찮아?\""
    },
    {
      "Text": "[wa:680]― [log=라나]문제 없습니다.[/log]"
    },
    {
      "Text": "― [log=라나]시간 때우기는 제 전문이기도 하고-[/log]"
    },
    {
      "Text": "― [log=라나]완충재도 푹신했고,[/log]"
    },
    {
      "Text": "― [log=라나]선생님께서 개봉할 때[wa:1430] 주의해 주셔서 [wa:2090]무사합니다.[/log]"
    },
    {
      "Text": "― [log=라나]……후훗…….[/log]"
    },
    {
      "Text": "[wa:1920]― [log=라나]역시, 직접 뵙게 되니 [wa:1850]좋습니다.[wa:40] [/log]"
    },
    {
      "Text": "― [log=라나]많이, [wa:1660]보고 싶었습니다. [wa:1280]선생님.[/log]"
    },
    {
      "Text": "― [log=라나]으음……. [/log]"
    },
    {
      "Text": "[wa:600]― [log=라나]하-암…….[/log]"
    },
    {
      "Text": "― [log=라나]그럼, [wa:1860]안녕히 주무세요.[/log]"
    },
    {
      "Text": "― [log=라나]쿠울…….[/log]"
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "쿨…… 쿠울……."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "선생…… 님……."
    },
    {
      "Text": "(라나를 조심스럽게 안아서 침대에 눕혔다.)"
    },
    {
      "Text": "(많이 피곤했던 모양인지, 깊이 잠들어 있었다.)"
    },
    {
      "Text": "(충분히 쉬게 하고 놀아준 뒤, 현관까지 마중 나갔다.)"
    }
  ],
