{
  "TitleJP": "少女のピックアップ",
  "TitleKR": "소녀의 픽업",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "街乗りの練習に付き合ってほしいと先生にお願いするアズサ。しかし停めておいたはずの戦車が消えてしまい、2人は駐車場を探して歩く。結局、「車両点検のために移動させた」ということが判明し、アズサは安堵するのだった。",
  "DescKR": "시내 주행 연습을 부탁하려던 아즈사. 그런데 세워둔 전차가 사라져, 두 사람은 주차장에서 전차를 찾아 헤매게 된다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "少女のピックアップ"
    },
    {
      "Text": "第2駐車場"
    },
    {
      "Text": "（第2駐車場に向かうと――）"
    },
    {
      "Text": "（すでにアズサが待っていた）"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "来たか、先生。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "今度、副戦車長を任されることになった。\n操縦手を兼ねるから、戦車を運転する役割だ。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "一応、操縦にはそれなりの自信がある。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "でも街乗りするのは慣れてないから……。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "知らない場所、知らない人、知らない生活――\n少しずつ慣れてきたが、まだ緊張する。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "だから、練習に付き合ってほしい。"
    },
    {
      "Text": "[s] \"喜んで！\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "先生は、いつもそうやって受け止めてくれるね。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "では、早速戦車に乗って――"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "――ん？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "んん……？"
    },
    {
      "Text": "[ns] \"どうしたの？\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "戦車が……ない。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "この辺りに停めたはずなんだけど……。"
    },
    {
      "Text": "[s] \"忘れちゃうことってあるよね……！\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "ピックアップ地点は、常に覚えておかなければいけないのに。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "どうも車は停めた場所を忘れやすい。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "リモコンキーは……電池切れか。目視で探すしかなさそうだ。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "……これだ。\n記憶とは少し場所が違う気もするけど。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "あとで反省点を洗い出そう。次は注意しないと。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "なんだ？もうエンジンがかかっている。\n近づくと自動で始動する仕様らしい。"
    },
    {
      "Text": "[s] \"……ん？\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "さあ、乗ろう。"
    },
    {
      "CharacterName": 3592400769,
      "Name": "正義実現委員会部員",
      "Text": "えっ！？あっ、お、お疲れ様です、先輩――えっ！？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "先輩……？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "[ruby=しらす]白洲[/ruby]アズサだ。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "ところで、私の車両で何をしている？"
    },
    {
      "CharacterName": 3592400769,
      "Name": "正義実現委員会部員",
      "Text": "これは[ruby=私たち]正義実現委員会[/ruby]の戦車ですけど！？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "それはおかしい。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "勘違いしてしまうのも理解はできる。同じ戦車だからな。\n念のため、もう一度確認した方がいい。"
    },
    {
      "Text": "[s] \"たぶん正義実現委員会ので合ってると思う！\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "えっ！？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "こんな間違いをするなんて……恥ずかしい。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "一緒に謝ってくれてありがとう、先生。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "車種も同じで駐車位置も似ていた。\nだから……クルセイダーちゃんと誤認した。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "……それで、私の戦車はどこに？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "こんなことを忘れるなんて、気が緩んでいる証拠だ。\n反省しないと……。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "ん？連絡だ。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "車両点検のために移動させた――"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "――らしい。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "私が場所を忘れていたわけじゃなかったのか。"
    },
    {
      "Text": "[s] \"そりゃ見つからないよね！\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "はあ……よかった。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "ここまで腑抜けていたのかと思って、少し焦った。"
    },
    {
      "Text": "[s1] \"これくらい普通だよ！\""
    },
    {
      "Text": "[s2] \"誰でもやる凡ミスだよ！\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "そうなのか？"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "普通の凡ミス……。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "そうか。これは怠慢ではなく……普通のことなんだな。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "……そっか。ふふ。そういうことか。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "それなら、少し安心した。ありがとう、先生。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "では、戦車もないことだし……どこかで休憩しよう。"
    },
    {
      "Text": "[s] \"運転の練習は大丈夫？\""
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "うん。"
    },
    {
      "CharacterName": 583581552,
      "Name": "アズサ",
      "Text": "今日は代わりに「普通の日常」を覚えたから。"
    }
  ],
  "DialogKR": [
    {
      "Text": "소녀의 픽업"
    },
    {
      "Text": "선수촌 야외 주차장"
    },
    {
      "Text": "(모모톡으로 전해들은 주차장으로 가보니…….)"
    },
    {
      "Text": "(아즈사가 기다리고 있었다.)"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "왔구나, 선생님."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "다름이 아니라, 이번에 부차장을 맡게 됐어. 조종수를 겸하다 보니, 운전도 해야 해."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "일단, 조종에는 자신이 있어."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "하지만, 시내 주행은 아직 익숙하지 않아서……."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "낯선 곳. 낯선 사람들. 낯선 생활……. 조금씩 적응하고는 있지만 아직은 긴장돼."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그러니, 운전 연습을 같이 해줬으면 해."
    },
    {
      "Text": "[s] \"좋아!\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "선생님은 항상 긍정해줘서 좋아."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그러면, 바로 전차에 타서……"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "……음?"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "으음……?"
    },
    {
      "Text": "[ns] \"왜 그러니? 뭔가 문제 있어?\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "전차가…… 없어."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "어디에…… 세워뒀더라……? 이 근처였을 텐데……."
    },
    {
      "Text": "[s] \"아 그럴 때가 있지……!\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "픽업 포인트는 항상 기억해둬야 하는데,"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "유독 차는 어디에 세워 둔지 잊게 되는 것 같아."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "리모컨 키 배터리가 다 되어서 그냥 찾아보는 수밖에 없겠어."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "……여기 있네. 기억하던 것하곤 좀 다른 곳에 있었던 것 같지만."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "상황 강평을 좀 더 날카롭게 하고 주의할 필요가 있겠어."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "뭐지? 시동이 걸려 있어. 가까이 오면 시동이 자동으로 걸리는 모양이야."
    },
    {
      "Text": "[s] \"……응?\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "자, 타자."
    },
    {
      "CharacterName": 3592400769,
      "Name": "정의실현부 부원",
      "Text": "아 오셨습니까, 선배…… 에, 엥?!"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "선배……?"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "시라스 아즈사 야."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그런데, 우리 차에서 뭘 하고 있는 거지?"
    },
    {
      "CharacterName": 3592400769,
      "Name": "정의실현부 부원",
      "Text": "이건 저희 정의실현부 전차인데요?!"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그거 참 이상하네."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "착각하는 것도 이해는 돼. 같은 전차니까. 혹시 모르니까 한 번 더 확인해 보는 게 좋다고 생각해."
    },
    {
      "Text": "[s] \"아마 정의실현부 전차가 맞을 거야!\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "응?!"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "……이런 실수를 하다니, 부끄럽네."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "사과하는 것, 도와줘서 고마워 선생님."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "차종도 똑같고 비슷한 곳에 세워뒀어서, 크루세이더 쨩이라고 오해했어."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "……그렇다면, 대체 우리 전차는 어디에 있는 걸까."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "이런 것도 잊다니, 요즘 정신력이 너무 해이해진 것 같아서 반성을 해야겠……."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "응? 연락이다."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "차량 점검을 위해 이동시켰다……"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "……라고 왔네."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "내가 어디 세웠는지 기억 못 하는 게 아니었네."
    },
    {
      "Text": "[s] \"그러면 당연히 못 찾지!\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "하아…… 다행이야."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "내가 너무 기강이 빠진 줄 알고, 조금 걱정했었어."
    },
    {
      "Text": "[s1] \"그럴 수도 있지! 잊는 것 정도야 뭐!\""
    },
    {
      "Text": "[s2] \"모두가 하는 평범한 실수야!\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "!"
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "'평범한 실수'……."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그러면, 괜찮은 일이구나…… 긴장하지 않아도 되는구나."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "……응, 후후. 그런 거구나."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그거면 안심되네. 고마워, 선생님."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "그러면 전차도 없으니…… 잠시 전투휴식이라도 취하러 갈까."
    },
    {
      "Text": "[s] \"운전 연습 안 해도 괜찮아?\""
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "응."
    },
    {
      "CharacterName": 583581552,
      "Name": "아즈사",
      "Text": "오늘은 대신 '평범한 일상' 하나를 배웠으니까."
    }
  ],
