  "DialogJP": [
    {
      "Text": "鬼怒川カスミ"
    },
    {
      "Name": "カスミ",
      "Text": "先生、こっちだ！"
    },
    {
      "Name": "カスミ",
      "Text": "私から誘ったとはいえ、まさか二人で海に来ることになるなんてな。"
    },
    {
      "Name": "カスミ",
      "Text": "はたから見ればデートと思われそうだ！"
    },
    {
      "Name": "カスミ",
      "Text": "少し、歩かないか？"
    },
    {
      "Text": "（カスミと一緒に海辺を散策した）"
    },
    {
      "Name": "カスミ",
      "Text": "ここは私が持つ。好きに食べてくれ。"
    },
    {
      "Name": "カスミ",
      "Text": "食事がパワーに繋がり、パワーが温泉に繋がるのだ！ハーッハッハッハ！"
    },
    {
      "Name": "カスミ",
      "Text": "む？私か？"
    },
    {
      "Name": "カスミ",
      "Text": "んー……いや、遠慮しておこう。"
    },
    {
      "Name": "カスミ",
      "Text": "どうやら私は小食なようでね。部員からもよく言われるよ。"
    },
    {
      "Name": "カスミ",
      "Text": "比較対象が些か大食らいであることは留意してもらいたいが――"
    },
    {
      "Name": "カスミ",
      "Text": "くじ引きか。普通に買うよりもロマンがあるな。"
    },
    {
      "Name": "カスミ",
      "Text": "先生がやりたいのなら好きなだけチャレンジするといい。\n私の財布の紐がこんなに緩いこともそうそうないぞ！"
    },
    {
      "Name": "カスミ",
      "Text": "……なぜ私にやらせようとするんだ？"
    },
    {
      "Name": "カスミ",
      "Text": "むぅ……私の好みを言うなら、そうだな……。"
    },
    {
      "Name": "カスミ",
      "Text": "この手の場所じゃ、型にはめた「ロマン」をこれ見よがしに提供するからな。"
    },
    {
      "Name": "カスミ",
      "Text": "あまりにチープで、お断りだ。"
    },
    {
      "Name": "カスミ",
      "Text": "たしかこの場所は……。"
    },
    {
      "Name": "カスミ",
      "Text": "ああ、思い出した。取り壊して駐車場にしようとしていたのだったか。"
    },
    {
      "Name": "カスミ",
      "Text": "立地は良かったんだがな。近くに源泉がなくて白紙になった。"
    },
    {
      "Name": "スケバンDJ",
      "Text": "なんか寒気が……。"
    },
    {
      "Name": "カスミ",
      "Text": "……もう夜か。"
    },
    {
      "Name": "カスミ",
      "Text": "んぐ……。"
    },
    {
      "Name": "カスミ",
      "Text": "んぐぐ……。"
    },
    {
      "Name": "カスミ",
      "Text": "降参だ、降参！"
    },
    {
      "Name": "カスミ",
      "Text": "本当に何も聞いてこないのだな！！"
    },
    {
      "Name": "カスミ",
      "Text": "ここまで強情とは恐れ入る。想定以上だ。"
    },
    {
      "Name": "カスミ",
      "Text": "いつも言っていると思うが、私は借りを作るのが大嫌いだ。"
    },
    {
      "Name": "カスミ",
      "Text": "やむを得ず作ってしまったなら一刻も早く清算したい！"
    },
    {
      "Name": "カスミ",
      "Text": "先生にはもう少し協力的になってほしいものだ。"
    },
    {
      "Name": "カスミ",
      "Text": "……1つだけ。"
    },
    {
      "Name": "カスミ",
      "Text": "今なら何でも答えよう。これでチャラにしてくれ。"
    },
    {
      "Text": "[s] \"本当！？\""
    },
    {
      "Name": "カスミ",
      "Text": "待ってましたと言わんばかりだな。"
    },
    {
      "Name": "カスミ",
      "Text": "……本当だ。私は1度言ったことは守る。"
    },
    {
      "Text": "[s1] \"実はずっと気になってて……。\""
    },
    {
      "Text": "[s2] \"前にさ――\""
    },
    {
      "Text": "[ns3] \"白衣脱いでたよね！？\""
    },
    {
      "Text": "[ns4] \"白衣を着てないの初めて見た！\""
    },
    {
      "Name": "カスミ",
      "Text": "……は？"
    },
    {
      "Name": "カスミ",
      "Text": "それが質問か？いや、質問というか……。"
    },
    {
      "Name": "カスミ",
      "Text": "……。"
    },
    {
      "Name": "カスミ",
      "Text": "本当にいいんだな？"
    },
    {
      "Name": "カスミ",
      "Text": "私はよほどのことがない限り、自分の言ったことは守る。"
    },
    {
      "Name": "カスミ",
      "Text": "そして……先生。あの話について聞きたいのであれば、チャンスは今日限りだ。"
    },
    {
      "Name": "カスミ",
      "Text": "それでもいいのか？"
    },
    {
      "Text": "[s] \"……。\""
    },
    {
      "Text": "[ns] \"すっごい気になってる！！\""
    },
    {
      "Name": "カスミ",
      "Text": "だろうな。"
    },
    {
      "Text": "[s5] \"でも、カスミの気持ちが優先だよ。\""
    },
    {
      "Text": "[s6] \"あんまり話したくなさそうだし。\""
    },
    {
      "Name": "カスミ",
      "Text": "そうだな。"
    },
    {
      "Text": "[s7] \"じゃあ大丈夫。\""
    },
    {
      "Text": "[s8] \"聞かないでおく。\""
    },
    {
      "Name": "カスミ",
      "Text": "……む。"
    },
    {
      "Name": "カスミ",
      "Text": "むむむむ……。"
    },
    {
      "Name": "カスミ",
      "Text": "先生は本当に人を困らせる天才だな。"
    },
    {
      "Name": "カスミ",
      "Text": "借りを返したいと言っているのに、また借りを作らせるつもりか？"
    },
    {
      "Name": "カスミ",
      "Text": "……いや、お言葉に甘えさせてもらおう。"
    },
    {
      "Name": "カスミ",
      "Text": "その代わり、と言ってはなんだが。"
    },
    {
      "Name": "カスミ",
      "Text": "さっきの質問について……少しだけ。"
    },
    {
      "Name": "カスミ",
      "Text": "私はいつも白衣を着ている。"
    },
    {
      "Name": "カスミ",
      "Text": "理由は――"
    },
    {
      "Name": "カスミ",
      "Text": "カッコいいからだ。"
    },
    {
      "Name": "カスミ",
      "Text": "変なのは百も承知だ。とはいえ……部員たちの感想なのだよ。"
    },
    {
      "Name": "カスミ",
      "Text": "映画に出てくるような……頭の良い博士みたいだ、と。"
    },
    {
      "Name": "カスミ",
      "Text": "……この私を見て、そう言ってくれるんだ。"
    },
    {
      "Name": "カスミ",
      "Text": "だから、それに対する少しばかりの誠意とでも言おうか。"
    },
    {
      "Name": "カスミ",
      "Text": "本物のドクターになんてなれやしない。だが、真似はできる。\nそれならば、と。まずは見た目から入ったのさ。"
    },
    {
      "Name": "カスミ",
      "Text": "……故に、[ruby=・]あ[/ruby][ruby=・]の[/ruby][ruby=・]時[/ruby][ruby=・]は[/ruby]脱いだ。どうにも気分が悪くてね。"
    },
    {
      "Name": "カスミ",
      "Text": "……。"
    },
    {
      "Name": "カスミ",
      "Text": "はい、終わり！"
    },
    {
      "Name": "カスミ",
      "Text": "似合わない話はここまでだ。"
    },
    {
      "Name": "カスミ",
      "Text": "分かっていると思うがこの話は――"
    },
    {
      "Text": "[s9] \"誰にも言わないよ。\""
    },
    {
      "Text": "[s10] \"二人だけの秘密！\""
    },
    {
      "Name": "カスミ",
      "Text": "ははっ。"
    },
    {
      "Name": "カスミ",
      "Text": "……先生は、青春に落とし込むのが上手だな。"
    },
    {
      "Name": "カスミ",
      "Text": "なに、言葉通りだ。"
    },
    {
      "Name": "カスミ",
      "Text": "褒め言葉さ、うむ。"
    }
  ],
  "DialogKR": [
    {
      "Text": "키누가와 카스미"
