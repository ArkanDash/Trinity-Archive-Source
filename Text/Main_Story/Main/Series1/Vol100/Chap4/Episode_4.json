    {
      "CharacterName": 850915274,
      "Name": "유우카",
      "Text": "게임개발부!!"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "오케이!! 기다리고 있었다고."
    },
    {
      "CharacterName": 3545855058,
      "Name": "노노미",
      "Text": "네! 동쪽 비상해제 장치 파괴 완료!!"
    },
    {
      "CharacterName": 3797093869,
      "Name": "아리스",
      "Text": "빛이여---!!"
    },
    {
      "CharacterName": 3353674757,
      "Name": "유즈",
      "Text": "파, 파괴했습니다. 서쪽 비상해제 장치도……!"
    },
    {
      "CharacterName": 1596498697,
      "Name": "하루나",
      "Text": "후후후, 네. 방벽이 열리고 있습니다."
