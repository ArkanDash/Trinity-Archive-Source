  "DialogJP": [
    {
      "Text": "第7話;よく分からない"
    },
    {
      "Text": "（マユミとカレンから、思い悩んでいるような連絡が来た）"
    },
    {
      "Text": "（待ち合わせ場所に急いで向かった）"
    },
    {
      "Name": "マユミ",
      "Text": "先生……。"
    },
    {
      "Name": "カレン",
      "Text": "……やっほ、先生。"
    },
    {
      "Text": "[s] \"ごめん、お待たせ。\""
    },
    {
      "Name": "カレン",
      "Text": "先生、知ってるよね……？ゲヘナの状況……。"
    },
    {
      "Text": "[s] 頷く。"
    },
    {
      "Name": "カレン",
      "Text": "やはっ、やっぱり。先生って大変だね。"
    },
    {
      "Name": "カレン",
      "Text": "全部の学園に気を配らなきゃいけないのに、ゲヘナがこんな事になってさ……。"
    },
    {
      "Name": "マユミ",
      "Text": "……先生はどう思う？"
    },
    {
      "Text": "[ns] \"どうにかするよ。全力で。\""
    },
    {
      "Name": "マユミ",
      "Text": "……言うと思った。"
    },
    {
      "Name": "マユミ",
      "Text": "私たちがどう思ってるか、って？"
    },
    {
      "Name": "マユミ",
      "Text": "どう思ってるんだろうね……何が何だかさっぱりなんだ……。"
    },
    {
      "Name": "マユミ",
      "Text": "万魔殿と風紀委員が手を組んだのは良かったと思う。\nゲヘナがまとまる第一歩だし、私たちが言ってきたことでもあるから。"
    },
    {
      "Name": "マユミ",
      "Text": "でも、この雰囲気は……違う。\n高圧的で、生徒を恐怖で統制しようとしてて……。"
    },
    {
      "Name": "マユミ",
      "Text": "それにキヴォトスに攻撃って何？撃ったり壊したりするのとはぜんぜん違うじゃん。"
    },
    {
      "Name": "マユミ",
      "Text": "先輩たちは準備にかかりきりみたいだけど……あれ、本当に本気なのかな？"
    },
    {
      "Name": "マユミ",
      "Text": "周りの子も、裏切り者扱いされたくなくて巻き込まれてるし……。"
    },
    {
      "Name": "マユミ",
      "Text": "これって本当に正しいの？これが本当に、偉大なゲヘナへ向かう道なの？\n……どうしたらいいのかな。"
    },
    {
      "Name": "カレン",
      "Text": "委員長……。"
    },
    {
      "Name": "マユミ",
      "Text": "ずーっと、頭ぐるぐるしちゃってるんだ。"
    },
    {
      "Name": "カレン",
      "Text": "悪い事ばっかりでもないよね。"
    },
    {
      "Name": "カレン",
      "Text": "普段は言うこと聞かない連中も、みんな静かになった。見方によっちゃ平和そのもの。"
    },
    {
      "Name": "カレン",
      "Text": "万魔殿と風紀委員会だって上手くやってるみたいだし。"
    },
    {
      "Name": "カレン",
      "Text": "うちらが思ってたゲヘナには近いのかもね。"
    },
    {
      "Name": "カレン",
      "Text": "うちは……まあ、ケンカ好きだし、ぶん殴るのも好きだし？\nあ、ちゃんと相手は選んでるからね？"
    },
    {
      "Name": "カレン",
      "Text": "今のゲヘナは……変な目的さえなければなぁ……。"
    },
    {
      "Name": "カレン",
      "Text": "キヴォトスに攻撃するってのは、よく分かんない。"
    },
    {
      "Name": "カレン",
      "Text": "理由もなく殴るのは意味不だし、後味が悪いだけだから。"
    },
    {
      "Name": "カレン",
      "Text": "ゲヘナがやろうとしてることには大義がない。"
    },
    {
      "Name": "カレン",
      "Text": "なーんでこんなことになってるんだろ。頭痛くなってきた。"
    },
    {
      "Name": "マユミ",
      "Text": "……私が今いちばん怖いの、何だと思う？"
    },
    {
      "Name": "カレン",
      "Text": "何？"
    },
    {
      "Name": "マユミ",
      "Text": "……私たちは昔のゲヘナに憧れてた。"
    },
    {
      "Name": "マユミ",
      "Text": "だから委員会の名前は、ゲヘナ再興委員会。ゲヘナを「再び」偉大に、って。"
    },
    {
      "Name": "マユミ",
      "Text": "でも、「昔」を勘違いしてたとしたら……？"
    },
    {
      "Name": "マユミ",
      "Text": "高圧的に生徒を押さえつけて、他学園に危害を及ぼそうとする。\nこれが昔のゲヘナだったとしたら……。"
    },
    {
      "Name": "カレン",
      "Text": "……。"
    },
    {
      "Name": "マユミ",
      "Text": "私たち、何をしてきたんだろう……？"
    },
    {
      "Name": "マユミ",
      "Text": "「偉大なゲヘナ」って、こんなのだったの？"
    },
    {
      "Name": "カレン",
      "Text": "委員長……。"
    },
    {
      "Name": "マユミ",
      "Text": "それに……それに……っ！"
    },
    {
      "Name": "マユミ",
      "Text": "私たちは……ゲヘナに取り返しのつかないことをしちゃったんじゃ……。"
    },
    {
      "Name": "マユミ",
      "Text": "何も知らないまま[ruby=・]昔[/ruby][ruby=・]の[/ruby][ruby=・]ゲ[/ruby][ruby=・]ヘ[/ruby][ruby=・]ナ[/ruby]に憧れたせいで……！！"
    },
    {
      "Text": "[ns] マユミの手を取って落ち着かせる。"
    },
    {
      "Name": "マユミ",
      "Text": "先生……。"
    },
    {
      "Text": "[s1] \"君たちのせいじゃないよ。\""
    },
    {
      "Text": "[s2] \"私が保証する。\""
    },
    {
      "Name": "カレン",
      "Text": "……。"
    },
    {
      "Name": "マユミ",
      "Text": "私たち、間違ってたのかな……全部、無駄だったのかな……。"
    },
    {
      "Name": "マユミ",
      "Text": "頑張ったつもりなんだけどな……。"
    },
    {
      "Text": "[s] \"無駄じゃない。\""
    },
    {
      "Name": "マユミ",
      "Text": "え……？"
    },
    {
      "Text": "[s] \"だって、違和感を覚えてるんだから。\""
    },
    {
      "Name": "カレン",
      "Text": "違和感……？"
    },
    {
      "Text": "[s3] \"もしも君たちが中途半端だったら――\""
    },
    {
      "Text": "[s4] \"今のゲヘナを偉大だと認めてたかもしれない。\""
    },
    {
      "Text": "[ns5] \"でも、二人はそうじゃなかった。\""
    },
    {
      "Text": "[ns6] \"目指してた偉大さとは違うからだよね？\""
    },
    {
      "Text": "[ns7] \"私は知ってる。\""
    },
    {
      "Text": "[ns8] \"マユミも、カレンも、再興委員会のみんなも。\""
    },
    {
      "Text": "[ns9] \"ゲヘナを良い方向へ変えようと頑張ってきた。\""
    },
    {
      "Name": "マユミ",
      "Text": "うわあああぁぁん～～～！！"
    },
    {
      "Name": "カレン",
      "Text": "い、委員長……！"
    },
    {
      "Name": "カレン",
      "Text": "泣かないでよ……つられて、うちまで……！！"
    },
    {
      "Name": "マユミ",
      "Text": "ああぁぁ～～～～～！！！"
    },
    {
      "Text": "（二人が泣き止むまで、なだめ続けた）"
    },
    {
      "Name": "マユミ",
      "Text": "ふっ、うぅ……っ、ぐすっ！"
    },
    {
      "Name": "カレン",
      "Text": "メイク、全部落ちちゃったじゃん……。"
    },
    {
      "Name": "マユミ",
      "Text": "ごめん……。"
    },
    {
      "Name": "マユミ",
      "Text": "でもあんなこと言われたら、私……。"
    },
    {
      "Name": "カレン",
      "Text": "はあ……。"
    },
    {
      "Name": "マユミ",
      "Text": "だけど、もう大丈夫！立ち直りは早いから！"
    },
    {
      "Name": "マユミ",
      "Text": "完全復活！"
    },
    {
      "Name": "カレン",
      "Text": "……。"
    },
    {
      "Name": "カレン",
      "Text": "やはっ、それでこそ委員長だよね。"
    },
    {
      "Text": "[s] \"二人はこれからどうする？\""
    },
    {
      "Name": "カレン",
      "Text": "こんなの、偉大なゲヘナじゃない。"
    },
    {
      "Name": "カレン",
      "Text": "だよね、委員長？"
    },
    {
      "Name": "マユミ",
      "Text": "うん！全部やめさせなきゃ！"
    },
    {
      "Name": "マユミ",
      "Text": "本当に偉大なゲヘナを――私たちが作る！"
    },
    {
      "Text": "[s] \"じゃあ、紹介したい子がいるんだ。\""
    },
    {
      "Name": "マユミ",
      "Text": "え、同じ志の生徒……？他にもいるの？"
    },
    {
      "Name": "カレン",
      "Text": "やはっ、大歓迎。今は多ければ多いほどいいし。"
    },
    {
      "Text": "[s] \"だけど、その……ショウコは？\""
    },
    {
      "Name": "マユミ",
      "Text": "ショウコは――"
    },
    {
      "Name": "カレン",
      "Text": "うちらとは少し考えが違うみたい。"
    },
    {
      "Name": "カレン",
      "Text": "センパイたちのところで作戦参謀みたいなことやってるんだ。"
    },
    {
      "Name": "マユミ",
      "Text": "自分からやりたがってるっぽくて……。"
    },
    {
      "Name": "マユミ",
      "Text": "そもそも、話もちゃんとできてないんだけどね……。"
    },
    {
      "Text": "[s] \"私から話してみるよ。\""
    },
    {
      "Name": "マユミ",
      "Text": "うん……お願い。"
    },
    {
      "Name": "マユミ",
      "Text": "先生の話なら、ショウコも聞いてくれると思うから。"
    },
    {
      "Name": "カレン",
      "Text": "ショウコちゃん……。"
    },
    {
      "Name": "マユミ",
      "Text": "ねぇ、先生……。"
    },
    {
      "Name": "マユミ",
      "Text": "今日は話を聞いてくれて、ありがとね。"
    },
    {
      "Name": "カレン",
      "Text": "マジマジ！うちも！！やはっ。"
    },
    {
      "Text": "（二人の笑顔が消えませんように）"
    },
    {
      "Text": "（そう、心から願った）"
    },
    {
      "Text": "次回;チアキ"
    }
  ],
  "DialogKR": [
    {
      "Text": "제7화;잘 모르겠어"
    },
    {
      "Text": "(마유미와 카렌에게 연락이 왔다.)"
    },
    {
      "Text": "(깊은 고민이 느껴져서, 빠르게 장소로 이동했다.)"
    },
    {
      "Name": "마유미",
      "Text": "선생님……."
    },
    {
      "Name": "카렌",
      "Text": "야핫…… 안녕, 선생님."
    },
    {
      "Text": "[s] \"안녕. 마유미, 카렌.\""
    },
    {
      "Name": "카렌",
      "Text": "선생님, 알지……? 지금 게헨나의 상황……."
    },
    {
      "Text": "[s] 끄덕인다."
    },
    {
      "Name": "카렌",
      "Text": "야하핫, 선생님도 좀 난감하겠네."
    },
    {
      "Name": "카렌",
      "Text": "샬레니까 이것저것 신경 써야 하는데, 게헨나에서 전쟁을 벌인다니……."
    },
    {
      "Name": "마유미",
      "Text": "……선생님은 어떻게 생각해?"
    },
    {
      "Text": "[ns] \"그런 일이 벌어지지 않게 최선을 다할 거야.\""
    },
    {
      "Name": "마유미",
      "Text": "……역시."
    },
    {
      "Name": "마유미",
      "Text": "우리는 어떻게 생각하냐고?"
    },
    {
      "Name": "마유미",
      "Text": "모, 모르겠어. 지금 일이 어떻게 돌아가는 건지."
    },
    {
      "Name": "마유미",
      "Text": "만마전과 선도부가 힘을 합친 건 좋아. 하나 된 게헨나로 가는 길이고. 우리가 말해왔던 거니까. 으응."
    },
    {
      "Name": "마유미",
      "Text": "그런데 이런 분위기는…… 바라지 않았어. 강압적이고, 학생들을 무섭게 통제하려고 하고……."
    },
    {
      "Name": "마유미",
      "Text": "게다가 전쟁이라니. 그건 그냥 쏘고 부수고 하는 거랑은 다르잖아?"
    },
    {
      "Name": "마유미",
      "Text": "선배들은 벌써 이런저런 전쟁 준비들에 여념이 없던데. 그거 진짜일까? 진심일까?"
    },
    {
      "Name": "마유미",
      "Text": "우리 후배들은 어버버하다가 끌려가기도 하고, 배반자 취급받지 않으려고 그냥 따라 하는 것 같기도 하고……."
    },
    {
      "Name": "마유미",
      "Text": "어, 어떻게 해야 하지? 이게 진짜 맞는 걸까? 정말 이게 위대한 게헨나로 가는 길일까?"
    },
    {
      "Name": "카렌",
      "Text": "회장……."
    },
    {
      "Name": "마유미",
      "Text": "……정말 잘 모르겠어. 혼란스럽기만 해."
    },
    {
      "Name": "카렌",
      "Text": "잘 생각해 보면 나름 괜찮거든?"
    },
    {
      "Name": "카렌",
      "Text": "평소에 말 안 듣던 녀석들이 전부 조용해졌고, 이제 교내에서 말썽부리는 사람도 없어."
    },
    {
      "Name": "카렌",
      "Text": "만마전과 선도부도 서로 싸우지 않고 잘 지내는 것 같고."
    },
    {
      "Name": "카렌",
      "Text": "어쩌면 우리가 꿈꾸던 위대한 게헨나와 어느 정도 맞는 것 같기도 해."
    },
    {
      "Name": "카렌",
      "Text": "근데 전쟁이라……."
    },
    {
      "Name": "카렌",
      "Text": "나는 솔직히 싸움도 좋아하고, 맞을 짓 한 녀석들 때려주는 것도 좋아하지만……"
    },
    {
      "Name": "카렌",
      "Text": "이건 잘 모르겠어."
    },
    {
      "Name": "카렌",
      "Text": "아무것도 안 한 녀석을 때리는 건 의미도 없고 기분만 더러워질 뿐이니까."
    },
    {
      "Name": "카렌",
      "Text": "이 전쟁에는 정당한 명분이 없어. 누가 잘못한 것도 아니야."
    },
    {
      "Name": "카렌",
      "Text": "하. 잘 모르겠다. 머리 아프네."
    },
    {
      "Name": "마유미",
      "Text": "……내가 지금 무서운 게 뭔지 알아?"
    },
    {
      "Name": "카렌",
      "Text": "뭔데?"
    },
    {
      "Name": "마유미",
      "Text": "우리는 예전의 게헨나를 동경해 온 사람들이잖아."
    },
    {
      "Name": "마유미",
      "Text": "그래서 동아리 이름도 재흥위원회. 게헨나를 '다시' 위대하게."
    },
    {
      "Name": "마유미",
      "Text": "그런데 예전의 게헨나가 이런 분위기였다면……."
    },
    {
      "Name": "마유미",
      "Text": "예전의 게헨나가 이렇게 강압적으로 학생들을 찍어 누르고, 타 학원과의 전쟁을 준비하던 그런 학원이라면……."
    },
    {
      "Name": "카렌",
      "Text": "……."
    },
    {
      "Name": "마유미",
      "Text": "그럼, 우리는 지금까지 무슨 일을 해오고 있었던 거지……?"
    },
    {
      "Name": "마유미",
      "Text": "우리가 외쳤던 위대한 게헨나가…… 이런 모습이었다고?"
    },
    {
      "Name": "카렌",
      "Text": "회장……."
    },
    {
      "Name": "마유미",
      "Text": "그리고, 그리고……!"
    },
    {
      "Name": "마유미",
      "Text": "이 상황, 지금 이 상황이 우리가 해왔던 일들 때문이라면, 우리는 어떻게 해……?"
    },
    {
      "Name": "마유미",
      "Text": "우리가 과거를 불러오려고 해서, 아무것도 모르고 과거의 게헨나를 동경하는 바람에……!!"
    },
    {
      "Text": "[ns] 마유미의 손을 잡고 진정시킨다."
    },
    {
      "Name": "마유미",
      "Text": "……선생님……."
    },
    {
      "Text": "[s1] \"그렇지 않다는 건 내가 보장할게.\""
    },
    {
      "Text": "[s2] \"너희의 탓이 아니야.\""
    },
    {
      "Name": "카렌",
      "Text": "……."
    },
    {
      "Name": "마유미",
      "Text": "나는, 나는…… 우리가 했던 일들이, 모두 헛된 일이 될까 봐 무서워."
    },
    {
      "Name": "마유미",
      "Text": "우리가 해왔던 노력들이…… 결국 이런 걸 위해서였다고 생각하면……."
    },
    {
      "Text": "[s] \"너희의 노력이 헛되지 않았다는 증거가 있어.\""
    },
    {
      "Name": "마유미",
      "Text": "으응?"
    },
    {
      "Text": "[s] \"지금 느끼는 위화감이야.\""
    },
    {
      "Name": "카렌",
      "Text": "위화감……?"
    },
    {
      "Text": "[s3] \"너희가 진심으로 게헨나에 대한 고민이 없었다면,\""
    },
    {
      "Text": "[s4] \"지금의 게헨나가 위대하다며 박수를 치고 있었을지도 몰라.\""
    },
    {
      "Text": "[ns5] \"하지만 둘은 이게 틀렸다는 걸 알아챘잖아.\""
    },
    {
      "Text": "[ns6] \"너희가 추구한 위대함이 아니었기 때문이겠지.\""
    },
    {
      "Text": "[ns7] \"나는 알고 있어.\""
    },
    {
      "Text": "[ns8] \"마유미와 카렌, 재흥위의 부원들이,\""
    },
    {
      "Text": "[ns9] \"게헨나를 더 좋은 방향으로 만들기 위해 노력했다는 것을.\""
    },
    {
      "Name": "마유미",
      "Text": "우와아앙~~~!!"
    },
    {
      "Name": "카렌",
      "Text": "회, 회장……!"
    },
    {
      "Name": "카렌",
      "Text": "울지 마, 나까지 울고 싶어지잖아……!!"
    },
    {
      "Name": "마유미",
      "Text": "우아아아아앙~~~~~!!!"
    },
    {
      "Text": "(마유미와 카렌이 울음을 그칠 때까지 달래주었다…….)"
    },
    {
      "Name": "마유미",
      "Text": "휴우…… 킁!"
    },
    {
      "Name": "카렌",
      "Text": "정말. 화장 다 지워졌잖아……."
    },
    {
      "Name": "마유미",
      "Text": "미안…… 카렌, 선생님."
    },
    {
      "Name": "마유미",
      "Text": "그 말을 들으니까, 나도 모르게 눈물이 나와서……."
    },
    {
      "Name": "카렌",
      "Text": "하아……."
    },
    {
      "Name": "마유미",
      "Text": "하지만, 금방금방 일어서는 것이 나의 장점!"
    },
    {
      "Name": "마유미",
      "Text": "지금은 완전 회복했어!"
    },
    {
      "Name": "카렌",
      "Text": "……."
    },
    {
      "Name": "카렌",
      "Text": "야핫, 그래. 이래야 우리 회장이지."
    },
    {
      "Text": "[s] \"둘은 이제 어떻게 할 거야?\""
    },
    {
      "Name": "카렌",
      "Text": "뭐, 이제 확실히 알았지."
    },
    {
      "Name": "카렌",
      "Text": "이런 게헨나는 위대하지 않다는 거."
    },
    {
      "Name": "마유미",
      "Text": "응! 그러니까, 전쟁이니 뭐니, 이런 거 다 집어치우게 해야지!"
    },
    {
      "Name": "마유미",
      "Text": "우리는 진정으로 위대한 게헨나를 만들 거야!"
    },
    {
      "Text": "[s] \"그럼, 둘에게 소개하고 싶은 사람들이 있어.\""
    },
    {
      "Name": "마유미",
      "Text": "뜻이 같은 사람들……?"
    },
    {
      "Name": "카렌",
      "Text": "아, 그런 거라면 얼마든지 환영이지. 많을수록 좋아."
    },
    {
      "Text": "[s] \"그런데…… 쇼코는?\""
    },
    {
      "Name": "마유미",
      "Text": "쇼코는……"
    },
    {
      "Name": "카렌",
      "Text": "쇼코는 우리와 생각이 조금 다른 것 같아."
    },
    {
      "Name": "카렌",
      "Text": "지금 키보토스 침공 계획에서 작전참모 역할을 하고 있더라."
    },
    {
      "Name": "마유미",
      "Text": "요즘 이야기도 별로 못했어."
    },
    {
      "Name": "마유미",
      "Text": "그리고, 전쟁을 바라는 것처럼 보이기도 하고……."
    },
    {
      "Text": "[s] \"쇼코와는 내가 한번 이야기를 해볼게.\""
    },
    {
      "Name": "마유미",
      "Text": "응…… 부탁해, 선생님."
    },
    {
      "Name": "마유미",
      "Text": "선생님의 이야기라면, 쇼코도 주의 깊게 들어줄 거야."
    },
    {
      "Name": "카렌",
      "Text": "쇼코 쨩……."
    },
    {
      "Name": "마유미",
      "Text": "아, 그리고……"
    },
    {
      "Name": "마유미",
      "Text": "오늘 상담, 고마웠어. 선생님."
    },
    {
      "Name": "카렌",
      "Text": "응응! 나도!! 야핫."
    },
    {
      "Text": "(이 아이들의 미소가 사라지지 않기를,)"
    },
    {
      "Text": "(진심으로 빌었다.)"
    },
    {
      "Text": "다음화;치아키"
    }
  ],
