{
  "TitleJP": "ゲヘナは今日も平和なり",
  "TitleKR": "오늘도 평화로운 게헨나",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "風紀委員会がいつものように問題児を取り締まっていると、通りがかったマコトが、こちらもいつものように横やりを入れる。往来でにらみ合う万魔殿と風紀委員会だったが、そこに割って入る謎の3人組が現れた。",
  "DescKR": "평소처럼 광장에서 대치하는 만마전과 선도부. 그 자리에 정체불명의 후배 3인조가 등장한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第1話;ゲヘナは今日も平和なり"
    },
    {
      "Text": "[ns] \"今日も今日とて――\""
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "だ～か～ら～さ～！！"
    },
    {
      "Text": "ゲヘナ広場"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "も～、埒が明かない！\nやっぱ解決するならこれでしょ！"
    },
    {
      "Text": "[ns] \"――ゲヘナだなぁ。\""
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "そこまでだ！"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "風紀委員会！？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "ちょっちょっちょ、待って待って！\nこれには理由があって……！"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "……何だ？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "あそこにドラム缶あるでしょ？\nあれ、私の作品[ruby=・]だ[/ruby][ruby=・]っ[/ruby][ruby=・]た[/ruby]の！"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "それで？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "私は、最高にイカした「爆炎の塔」を作ろうとしてたわけよ。\nドラム缶を1個ずつ積み上げて、一気に爆発させるの。"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "なのに、こいつ何したと思う！？\n私より先に撃っちゃったんだよ！？ありえなくない！？"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "つい撃ちたくなっちゃって……。\nってか、あんな「撃ってください」って標的作るほうが悪いじゃん。"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "だ、か、ら！私が！撃とうとしてたの！\nなんで私の楽しみ奪うのさ！"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "そもそも、広場にドラム缶を積むのも、爆破するのも禁止だ。\n公共の場で騒ぎ起こすのは控えろと言ってるだろ！"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "ちぇっ、厳しすぎなんだよ。"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "なんか息苦しいっていうか……。"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "暴れなくたって息はできるだろ？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "こんな窮屈な空気じゃ窒息するっての！"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "何を言ってるんだ……。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "いったい何の騒ぎですか！"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "[ruby=パンデモニウム・ソサエティー]万魔殿の対応だ[/ruby]けでも面倒なのに、揉め事を起こさないでください。"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "また何か言われたの？"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "風紀委員会の装備を明日までに全数調査することになりました。\n過剰戦力だから、9mm弾を超える威力の弾薬は返納しろ、と。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "今に始まったことではないですが……まったく、話になりません。"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "呆れた……。"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "気になってたんだけどさ。"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "なんで万魔殿の言いなりなの？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "言いなり！？なんてことを言うんですか！！"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "やろうと思えば、風紀委員長がどうとでもできるでしょ？\nなのに、どうして従ってるのかな、って。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "はぁ……。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "力で覆して、どうするんですか？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "え？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "倒して、[ruby=・]そ[/ruby][ruby=・]の[/ruby][ruby=・]後[/ruby]は？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "その後って……。"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "勝ったら勝ちでしょ？\n好き放題できるってことじゃないの？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "そうそう！めっちゃ最高じゃん？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "では……力に任せて、何でも好き放題にして良いと？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "ゲヘナを風紀委員会の思うままにしたら、皆さんにも影響が及ぶかもしれませんよ？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "ど、どういうこと？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "例えば……委員長が「制服の着崩し禁止」と仰ったら？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "ネクタイをきちんと締めて、シャツは全部入れて、上着を必ず羽織らなければならなくなります。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "これも、力ある者が好き放題した結果です。それでも素晴らしいと思えますか？\nもちろん、委員長はそんな方ではありませんけど。"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "あんま良くないかも……。"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "それは嫌だなぁ……。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "力があっても、勝手はしない。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "力があっても、守るべき一線を守る。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "――力があるからこそ、守るべき一線を守る。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "それが風紀委員会の方針です。"
    },
    {
      "CharacterName": 2746145574,
      "Name": "？？？",
      "Text": "チナツの言う通り。"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "委員長……！"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "すみません……出過ぎた真似を……。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "なぜ？私とアコがいつも言っていることじゃない。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "覚えていてくれて嬉しいわ。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "委員長……。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "ありがとうございます。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "とにかく。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "力があるからって好き放題するのは許さない。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "でも、過剰に規制するつもりもない。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "自由な――"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "これからも自由であるはずのゲヘナが、一線を越えないように見守ること。\nそれが風紀委員会の役割。"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "……私の約束でもあるから。"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "わ、分かった……。"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "カッコいい……私も入ろっかな？"
    },
    {
      "CharacterName": 4133385733,
      "Name": "ゲヘナの生徒A",
      "Text": "えっ、あんたみたいなサボり魔が？"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "はぁ！？出来ないって言いたいの！？"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "風紀委員会はいつでも歓迎してる。\n申請書を書いて持ってこい。"
    },
    {
      "CharacterName": 1904515627,
      "Name": "ゲヘナの生徒B",
      "Text": "えー、やっぱめんどくさいからいいや……。"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "じゃあ最初から言うな！！"
    },
    {
      "CharacterName": 2746145574,
      "Name": "？？？",
      "Text": "キシシッ、相変わらず滑稽だな。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "あなたは……！"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "はぁ……やっぱり素通りはできないんですね。"
    },
    {
      "CharacterName": 3925286920,
      "Name": "マコト",
      "Text": "どれほど格好つけようと、お前たちには限界がある。"
    },
    {
      "CharacterName": 3925286920,
      "Name": "マコト",
      "Text": "すぐ暴力に頼るからな。それでは心まで従わせることはできない。"
    },
    {
      "CharacterName": 3925286920,
      "Name": "マコト",
      "Text": "このマコト様とは器の広さが違うのだ！"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "いつもの言いがかりでしたか……。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "そもそも、あなたに「器」を語る資格はないでしょう？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "今回の命令だってそうです。\nあれこれと理由をつけて、風紀委員会の予算を削減する。\nそのくせ、活動費の決裁は先延ばしじゃないですか！"
    },
    {
      "CharacterName": 3925286920,
      "Name": "マコト",
      "Text": "そんなことに構っている暇などない！！"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "あなた達がやらないで誰がやるんですか！？"
    },
    {
      "CharacterName": 3925286920,
      "Name": "マコト",
      "Text": "ええい！万魔殿は忙しいんだ！風紀委員会のことなど後回しだ！"
    },
    {
      "CharacterName": 703456608,
      "Name": "ヒナ",
      "Text": "……本当にそれが理由なら、見過ごすわけにはいかない。"
    },
    {
      "CharacterName": 2190153660,
      "Name": "ゲヘナの生徒C",
      "Text": "うわ、ケンカしてら。"
    },
    {
      "CharacterName": 330118802,
      "Name": "ゲヘナの生徒D",
      "Text": "いつものことじゃん。"
    },
    {
      "CharacterName": 2746145574,
      "Name": "？？？",
      "Text": "待った！！"
    },
    {
      "Text": "[ns] \"？？？\""
    },
    {
      "Text": "次回;ゲヘナ再興委員会"
    }
  ],
  "DialogKR": [
    {
      "Text": "제1화;오늘도 평화로운 게헨나"
    },
    {
      "Text": "[ns] \"오늘도 평화로운……\""
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "그~러~니~까~!!"
    },
    {
      "Text": "게헨나 광장"
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "이건 별수 없네! 화약으로 해결할 수밖에!"
    },
    {
      "Text": "[ns] \"……평소의 게헨나다.\""
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "거기, 그런 짓은 그만둬!"
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "서, 선도부다!"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "잠깐, 들어봐! 이건 내가 억울한 사연이라고?"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "뭔데 그래……?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "아니, 저기 드럼통 쌓아둔 거 보여? 내가 만들려고 한 작품이거든!"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "그런데?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "저렇게 쌓아두고 한 번에 폭발시키면 그야말로 끝내주는 불꽃의 탑이 완성될 거란 말이지!"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "그런데 이 녀석이 내가 불을 붙이기 전에 먼저 쏴버렸다고! 이게 무슨 짓이냔 말이야!"
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "아니, 저렇게 쏘기 좋게 생겼는데 어떻게 가만히 보고만 있냐고! 너 같았어도 쐈을걸?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "그러니까 내가 쏴야지! 왜 네가 튀어나와서 내 즐거움을 망치는 건데!"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "광장에서는 드럼통을 쌓는 것도 폭파시키는 것도 안 돼!\n둘 다 공공장소에서 소란을 피우는 건 자제하라고!"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "에잇, 너무 빡빡하단 말이야! 선도부는!"
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "숨 쉴 여유 정도는 줘야 하는 거 아냐?"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "그렇게 기물을 파손하지 않고도 숨은 쉴 수 있잖아?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "그렇게 쪼잔한 숨, 쉬고 싶지 않다고!!"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "이게 무슨 소리야……."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "정말, 또 무슨 소란인가요!"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "안 그래도 만마전에서 또 이상한 공문이 내려오는 바람에 신경 쓸 것도 많은데……."
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "또 뭐가 왔어?"
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "선도부에서 사용하는 장비 대부분이 필요 이상의 고화력이라고, 내일까지 전수 조사 후 9mm 탄환을 초과하는 위력의 탄약은 모두 반납하라는 이야기예요."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "말이 되는 소린가요! 어린아이들 장난감도 아니고!! "
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "어이가 없네……."
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "그런데……"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "너희는 왜 매번 만마전한테 당하고 있는 거야?"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "당하다뇨!! 무슨 그런 말씀을!!"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "아니, 선도부장이 다 이기는 거 아니야? 가끔 보면 억지에 어울려주는 느낌이던데……."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "하아, 그건……"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "이기면요?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "응?"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "이기면, 그다음은요?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "그다음이라니……."
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "뭐, 이기면 이기는 거지? 그럼 자기 마음대로 할 수 있는 거 아냐?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "맞아! 우리 마음대로 할 수 있다는 게 얼마나 멋진 일이야?"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "그럼, 저희가 힘이 있다고 무엇이든 마음대로 한다면요?"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "저희 선도부 마음대로 게헨나를 쥐락펴락한다면, 여러분에게 피해가 갈지도 모르는데요?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "어?"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "만약 저희 부장님이 지금부터 모든 게헨나 학생들은 정해진 교복만 입어야 한다고 하신다면요? 물론 그럴 분은 아니지만요."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "넥타이도 똑바로 하고, 상의도 모두 넣어서 입어야 하고, 외투까지 항상 걸쳐야 한다면."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "그때도 마음대로 할 수 있는 게 멋진 일일까요? 물론 그럴 분은 아니지만요."
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "듣고 보니 그 생각은 별로 안 좋은 것 같아……"
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "내 마음대로 해야 재미있는 건데, 다른 사람 마음대로 되는 건 환영할 수 없네."
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "힘이 있더라도 마음대로 하지 않는다……"
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "힘이 있음에도, 지켜야 할 선을 지킨다."
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "힘이 있으니, 지켜야 할 선을 지킨다."
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "이것이 저희 선도부의 방침입니다."
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "치나츠의 말이 맞아."
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "부, 부장……!"
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "아, 이건…… 제멋대로 떠들어서 죄송해요."
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "아냐. 나와 아코가 항상 하는 말이기도 했고."
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "기억하고 있어 줬다니 고마운 일이지."
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "그런……"
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "가, 감사합니다. 부장님……."
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "아무튼……"
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "힘이 있다고 해서 제멋대로 구는 건 용납할 수 없어."
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "그렇다고 해서 학생들을 지나치게 통제할 생각도 없고."
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "단지……"
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "이 자유로운, 그리고 앞으로도 자유로울 게헨나가 선을 넘지 않도록 지켜보는 것.\n그게 우리 선도부가 할 일이야."
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "……내가 했던 약속이기도 하고."
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "아, 알았어……."
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "왠지 멋진걸. 나도 선도부에 가입할까?"
    },
    {
      "CharacterName": 4133385733,
      "Name": "게헨나 학생 A",
      "Text": "엑, 네가? 너처럼 뺀질거리는 애가 어떻게 선도부가 되겠어?"
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "뭐라고? 내가 못 할 줄 알아?"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "자, 자. 선도부의 문은 언제나 열려 있으니까. 신청서부터 작성해서 방문해 줘."
    },
    {
      "CharacterName": 1904515627,
      "Name": "게헨나 학생 B",
      "Text": "아, 생각해 보니 귀찮네."
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "그럼 하지 말든가!!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "키시싯, 여전히 골계스러운 풍경이군."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "당신은……!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "하아, 역시 그냥 지나가는 법이 없네요."
    },
    {
      "CharacterName": 3925286920,
      "Name": "마코토",
      "Text": "키킥, 잘난 척 말했지만, 결국 너희들에게는 명확한 한계가 존재한다."
    },
    {
      "CharacterName": 3925286920,
      "Name": "마코토",
      "Text": "권위나 폭력으로 찍어 눌러봐야 결국 마음마저 꺾지는 못하지."
    },
    {
      "CharacterName": 3925286920,
      "Name": "마코토",
      "Text": "무슨 일이든 금세 폭력에 기대곤 하는 너희 선도부 녀석들은, 이 마코토 님처럼 위대한 도량으로 모두를 품을 수 없다는 이야기다."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "무슨 소리를 하나 했더니, 역시나 그냥 시비일 뿐이군요……."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "아무튼, 마코토 의장 당신이 도량 운운할 수 있는 사람은 아닐 텐데요!"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "이번에 보낸 이상한 공문도 그렇고! 선도부의 분기 예산을 별별 이유를 들어가며 삭감하고, 영업비 결재는 차일피일 미루고!"
    },
    {
      "CharacterName": 3925286920,
      "Name": "마코토",
      "Text": "그런 하찮은 일 따위에 신경 쓸 여유는 없다!!"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "그게 왜 하찮은 일이냐고요! 학생회인 당신들이 안 하면 누가 하나요?"
    },
    {
      "CharacterName": 3925286920,
      "Name": "마코토",
      "Text": "에이잇, 선도부에게 이득이 되는 일은 우리 만마전의 지극히 많은 업무 중에서도 후순위!\n그중에서도 지극히 후순위니까 말이다!"
    },
    {
      "CharacterName": 703456608,
      "Name": "히나",
      "Text": "마코토…… 정말 그 이유 때문이라면, 그냥은 넘어갈 수 없을지도 몰라."
    },
    {
      "CharacterName": 2190153660,
      "Name": "게헨나 학생 C",
      "Text": "우와, 또 싸운다."
    },
    {
      "CharacterName": 330118802,
      "Name": "게헨나 학생 D",
      "Text": "뭐 매번 있는 일이잖아."
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "잠깐!!"
    },
    {
      "Text": "[ns] \"???\""
    },
    {
      "Text": "다음화;게헨나재흥위원회"
    }
  ],
