  "DialogKR": [
    {
      "Text": "약사의 방황길 4"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "보호비라고……? 보호는 무슨 보호! 평소 너희들이 하는 게 뭐가 있다고!"
    },
    {
      "CharacterName": 2748324066,
      "Name": "갱단원 A",
      "Text": "우리가 순찰 안 돌면, 댁 집은 진작에 다 도둑맞았을걸?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "차라리 그렇게 해라! 너희들에게 뜯기나 도둑 녀석들에게 뜯기나 마찬가지야!"
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "이거 말이 안 통하네. 혹시 그거야? 그 카이인가 뭔가 하는 녀석을 집에 들였다고 위세 부리는 거야?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그 아이와는 상관없는 일이다!"
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "정말 세상 물정 모르는구만! 이봐, 한 가지 재미있는 사실 알려 줄까? 그 신타니 카이라는 녀석 말인데……."
    },
    {
      "CharacterName": 2748324066,
      "Name": "갱단원 A",
      "Text": "바깥에서는 손도 못 쓸 문제아라서, 일곱 죄수라고 불리는 흉악범 중 하나라고!"
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "00;듣기로는 산해경이란 학원을 완전히 뿌리부터 뒤집어 놓았다던데?"
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "거기에 그 학원에 쳐들어갈 때, 여기 블랙마켓에서 사람을 왕창 고용해 가기도 했다지?"
    },
    {
      "CharacterName": 2748324066,
      "Name": "갱단원 A",
      "Text": "사실 여기에서 그런 게 뭐 큰 흠집이나 되나 싶지만, 아무튼 그렇다고!"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "……!"
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "그리고 말이지, 이왕 말이 나온 김에 또 하나 덧붙이자면 말이야……."
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "카이 녀석, 진작에 댁을 지금처럼 낫게 할 수 있었다는 모양이더라고!"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "……."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "호오……. 저 녀석들도 알고 있었던 건가."
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "그자식, 다른 건 몰라도 의술 하나만은 확실한 모양이더라고!"
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "그런데 왜 댁을 지금까지 이대로 내버려뒀느냐고? 그거야 당연히……."
    },
    {
      "CharacterName": 2748324066,
      "Name": "갱단원 A",
      "Text": "댁이 자기에게 집을 넘겨줄 순간만 기다리고 있었기 때문이지!"
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "블랙마켓에서는 아무것도 숨길 수 없어! 알고 있을 거 아냐!"
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "모든 건 시간의 문제일 뿐이지, 결국 다 공유되기 마련이라고!"
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "거기에 우리, 오늘 카이 녀석에게 좀 당한 게 있어서 말이야……."
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "댁이 대신 좀 그 분풀이까지 갚아 줘야 할 것 같기도 하고! 하하하!"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "……!!!!!"
    },
    {
      "Text": "[ns] \"말려야 해!\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……."
    },
    {
      "Text": "[s] \"카이……?\""
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "……이 녀석들아."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그 정도는, 이미 진작에 알고 있었다."
    },
    {
      "CharacterName": 2748324066,
      "Name": "갱단원 A",
      "Text": "뭐, 뭐라고?!?!"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "……내가 여기에서 살게 된 지 얼마나 지났는지 아느냐?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "얼마나 많은 사람들을 보아 왔고, 그 중 어느 만큼이나 되는 사람들이 속거나, 속이려 했는지를 말이다."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "인석들아. 그 정도는 너희들이 굳이 말해 주지 않아도, 처음부터 눈치채고 있었단 말이다."
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "그, 그런데 도대체, 어째서……?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그 아이를 남겨 두고, 집까지 물려주려 했느냐고?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그걸로 이미 충분했기 때문이다."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "카이가 어떤 아이이든, 밖에서 무슨 취급을 받든, 내게는 아무래도 좋은 일이다. 너희들 말마따나 말이지."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그 아이는 여기에 있었고, 잠시나마 내 집에 살았다. 그거면 됐지, 무엇을 더 바라겠느냐."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "사람 모습 한 명뿐인 집보다야, 둘이 있는 집이 더욱 좋지 않겠느냐. 집이라는 녀석도 생각이 있다면, 그리 여길 게야."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그러니, 청소나 마저 끝내게 내버려둬라!"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "그 아이에게 이 집을 물려주기 전에 말이다!"
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "뭐, 뭐야! 기껏 남이 큰맘 먹고 현실을 알려줬더니!"
    },
    {
      "CharacterName": 2748324066,
      "Name": "갱단원 A",
      "Text": "그래! 누구 앞에서 큰소리 치고 협박질이야! 청소? 그런 게 뭐가 대수냐!"
    },
    {
      "CharacterName": 1621886353,
      "Name": "갱단원 B",
      "Text": "안되겠구만, 이거! 우리도 좋게좋게 넘어가고 싶었는데! 댁이 일을 망친 거라고!"
    },
    {
      "CharacterName": 1146300566,
      "Name": "갱단원 C",
      "Text": "야! 다들 나와! 여기다!"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……짜증이 나는군."
    },
    {
      "Text": "[s] \"카이……?\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "마음에 안 든다."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "물려주느니 마느니 하는 소리를 입에 담는 노인도."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "시끄럽게 천둥벌거숭이마냥, 하룻강아지 범 무서운 줄도 모르고 떠들어대는 저 얼간이들도. 모든 것이, 전부."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "나서지 마라, 선생. 이것은 경고다."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……뭐, 선생이 걱정하는 일은 일으키지 않도록 하지."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "적어도 그 생명에는 큰 지장이 없도록 할 테니까."
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "너, 너는?! 카이다! 카이가 여기에 있다!!!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "수, 숨을 쉬기가 힘들어……!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "가려워……. 온몸이 너무 가려워……! 으이이이익!!!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "아하! 아하하하하! 그만! 그만해! 이상한 가스를 마셨더니, 간지러움이–"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "환각……? 이건, 환각인가……? 저, 저리 가! 난…… 나는……! 그건 내가 아니었어!!!!!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "비다……. 비가…… 내린다……! 하늘에는, 하늘에는 저렇게 달이 떠 있는데……."
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "아, 아아……. 몸이, 몸이 녹아내리는 것 같아……! 내 팔, 내 다리, 내 머리카락!!!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "흐히, 히히히, 흐히후히히히히히히!!!!!"
    },
    {
      "Text": "[ns] \"지, 지금은 도대체……?\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "왜 그러지, 선생? 보시다시피……."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "겉으로는, 모두 무사하지 않은가."
    },
    {
      "Text": "[s] \"그건, 그런데……!\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "걱정하지 마라."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "나는, 웬만해서는 함부로 돌이킬 수 없는 일을 행하지 않으니까."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "카이야……?"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……!"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "……."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "들어가자꾸나. 날이 많이 저물었다."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……그래. 그러지."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "괜찮느냐, 카이야?"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……그 물음은, 내가 꺼내는 편이 자연스럽지 않을까 하는데……?"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "허허허……. 이 정도야. 이런 곳에 남아 있는 늙다리를 보거든, '생존자'라고 생각하거라."
    },
    {
      "Text": "(카이와 노인의 대화는, 끊어질 듯 이어지는 것처럼, 느린 강물과 같이 흘러갔다.)"
    },
    {
      "Text": "(내가 할 일이라고는, 중간중간 맞장구나 추임새를 넣는 것 정도였다…….)"
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "으음, 벌써 이런 시간인가……. 피곤하구나."
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "더 나눌 이야기가 있다면, 이 늙은이는 그만 물러나도록 하지. "
    },
    {
      "CharacterName": 1541162835,
      "Name": "노인",
      "Text": "너무 늦게 잠들면 안 된단다?"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……그러지."
    },
    {
      "Text": "(노인은 방 안쪽으로 절룩거리며 들어갔다.)"
    },
    {
      "Text": "(……머지않아, 코를 고는 소리가 들려왔다.)"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……."
    },
    {
      "Text": "[s] \"역시 좋은 어르신이네.\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "음? 으음. 그래. 그렇지."
    },
    {
      "Text": "[s] \"괜찮아?\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……이상한 말을 하는군, 선생. 혹시 시야가 상하기라도 했나?"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "그 물음은, 지금도 밖에 널브러져 있는 그자들에게 하는 것이, 보다 경우에 맞을 것 같은데."
    },
    {
      "Text": "[s] \"하지만 뭔가, 표정이 복잡해 보여서.\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……!"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "뭐라고 해야 할까, 조금."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "스스로가 다소…… 낯설게 느껴지고 있기는 하다."
    },
    {
      "Text": "[s] \"노인 분을 도운 것 때문에?\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……!"
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……이런 문제에서 선생을 속이려 해 봤자, 쓸모는 없겠지."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "하지만 나는 특별히, 노인을 돕는다거나 좋은 일을 하려고 했던 것은 아니다."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "그저 마음 내키는 대로 행동했고, 그 결과가 그렇게 되었을 뿐이지."
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……그래. 오늘 하루 종일 내가, 그렇게 행동했던 것처럼."
    },
    {
      "Text": "[s] \"그거면 됐어.\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "뭐라고……?"
    },
    {
      "Text": "[s] \"사람이 꼭 착해야만, 좋은 일을 하는 건 아니니까.\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "점점 이해하기 힘든 말을 하고 있는 것 같다만……?"
    },
    {
      "Text": "[s1] \"하지만 적지 않은 선행은, 우연이나 충동으로 일어나거든.\""
    },
    {
      "Text": "[s2] \"사람은 종종, 어쩌다 보니 좋은 일을 하는 존재이기도 하고.\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "결과적인 것일 뿐이라도, 조금 전 같은 모습을 보일 수 있다면…… 된다고?"
    },
    {
      "Text": "[s] \"적어도, 지금은.\""
    },
    {
      "CharacterName": 1419259347,
      "Name": "카이",
      "Text": "……!"
    }
  ],
