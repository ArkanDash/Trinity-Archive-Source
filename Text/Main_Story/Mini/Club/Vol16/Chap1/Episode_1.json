    },
    {
      "Name": "이부키",
      "Text": "화가 나서 걷다가 보니 여기까지 와버렸는데……."
    },
    {
      "Name": "이부키",
      "Text": "우우……."
    },
    {
      "Name": "아루",
      "Text": "과장, 가자니까 뭘 그렇게 보고 있어?"
    },
    {
      "Name": "카요코",
      "Text": "아, 저기……."
    },
    {
      "Name": "아루",
      "Text": "응? 아이가 있네. 미아인가?"
    },
    {
      "Name": "아루",
      "Text": "후후, 길을 잃은 아이는 보호자를 찾아줘야지!"
    },
    {
      "Name": "카요코",
      "Text": "앗, 사장…… 그 아이는……."
    },
    {
      "Name": "카요코",
      "Text": "으음. 안 듣고 가버렸네."
    },
    {
      "Name": "카요코",
      "Text": "……어째서 이부키가 이곳에 있는 거지?"
    },
    {
      "Name": "아루",
      "Text": "안녕~! 꼬마 아가씨!"
    },
    {
      "Name": "이부키",
      "Text": "아, 안녕하세요. 예쁜 언니."
    },
    {
      "Name": "아루",
      "Text": "예, 예쁜……."
    },
    {
      "Name": "아루",
      "Text": "오호호홋! 너, 보는 눈이 있구나? 후후, 좋았어."
    },
    {
      "Name": "아루",
      "Text": "이 언니가 책임지고 너를 데려다줄게!"
    },
    {
      "Name": "이부키",
      "Text": "응? 이부키가 어디서 왔는지 알아?"
    },
    {
      "Name": "아루",
      "Text": "그건 이제부터……"
    },
    {
      "Name": "아루",
      "Text": "어…… 너, 혹시……."
    },
    {
      "Name": "아루",
      "Text": "자, 잠깐. 너, 너……"
    },
    {
      "Name": "아루",
      "Text": "마, 마, 만마전?!"
    },
    {
      "Name": "이부키",
      "Text": "와아~! 언니, 정말 알고 있었구나!"
    },
    {
      "Name": "아루",
      "Text": "만마전~~~~?!?!"
    },
    {
      "Name": "아루",
      "Text": "어디서 많이 봤다 했더니 만마전의 아이였어!"
    },
    {
      "Name": "아루",
      "Text": "어쩌지? 이를 어쩌지?"
    },
    {
      "Name": "또 다른 아루",
      "Text": "흥, 그게 뭐 어떻다고?"
    },
    {
      "Name": "또 다른 아루",
      "Text": "그냥 게헨나 학원 주변에 데려다 주면 알아서 찾아가겠지. 한 두 살 먹은 어린애도 아니고."
    },
    {
      "Name": "또 또 다른 아루",
      "Text": "아니야. 지금 이 아이는 매우 외롭고 불안한 상태일 거야. 우리가 도와줘야 해."
    },
    {
      "Name": "또 다른 아루",
      "Text": "무슨 소리! 게헨나와는 더 이상 엮이지 않기로 했잖아."
    },
    {
      "Name": "또 다른 아루",
      "Text": "그것도 게헨나를 지배하는 만마전 소속의 아이라고! 무슨 일이 일어날 줄 알고?"
    },
    {
      "Name": "또 또 다른 아루",
      "Text": "혼자 떨어진 아이가 얼마나 힘들고 슬픈지는 너도 알고 있잖아? 옆에 있어줘."
    },
    {
      "Name": "아루",
      "Text": "으, 으아……."
    },
    {
      "Name": "이부키",
      "Text": "언니, 괜찮아? 갑자기 땀을 흘리고…… 아파?"
    },
    {
      "Name": "아루",
      "Text": "(이 아이…… 혼자서 불안했을 텐데, 오히려 내 손을 잡아주고 있어…….)"
    },
    {
      "Name": "아루",
      "Text": "좋아, 언니만 따라와! 너를 만마전에 데려다 줄게!"
    },
    {
      "Name": "무츠키",
      "Text": "사장, 무슨 말이야? 만마전으로 간다고?"
    },
    {
      "Name": "아루",
      "Text": "……응! 그게 내가 해야 할 일이야!"
    },
    {
      "Name": "카요코",
      "Text": "왜 그런 생각을 했는지는 알겠지만…… 일단 잠깐만, 사장."
    },
    {
      "Name": "아루",
      "Text": "길 잃은 어린 양을 보았다면, 올바른 곳으로 인도하는 것이 하드보일드한 악당의 자세!"
    },
    {
      "Name": "카요코",
      "Text": "아니, 좋은 일이긴 한데 악당의 자세인가?! 싶기도 하고…… 아무튼 기다려 봐……"
    },
    {
      "Name": "이부키",
      "Text": "아니야! 이부키는 돌아가지 않을 거야!"
    },
    {
      "Name": "이부키",
      "Text": "마코토 선배가 이부키의 푸딩, 먹어버렸어!"
    },
    {
      "Name": "이부키",
      "Text": "이부키는 화가 풀릴 때까지 돌아가지 않을 거야! 흐응!!"
    },
    {
      "Name": "아루",
      "Text": "……그, 그래……?"
    },
    {
      "Name": "아루",
      "Text": "어, 어쩐다……?"
    }
  ],
