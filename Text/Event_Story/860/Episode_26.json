{
  "TitleJP": "不凍の港の無敵徹甲（２）",
  "TitleKR": "얼어붙지 않는 항구의 무적철갑 2",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "星を5つ集め、ついに「クイーンのなんでも券」を手にしたマコト。世界征服を望み、願いが叶う――ことはなく、マコトの意識は現実に引き戻された。すべては儚い夢の後。現実は漂流の最中であった。それと同じころ、目を覚ましたホシノはセリカからお小言をもらうものの、どこか幸せそうな表情を浮かべるのだった。",
  "DescKR": "마침내 〈여왕의 소원권〉을 손에 쥔 마코토. 그러나 모든 것은……?",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キキキッ……。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キシシシッ！ついにレッドウィンターまで倒れた！！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "これでゲヘナに勝てる学園はないと証明されたのだ！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キヴォトスに住まう有象無象の民よ！このマコト様の英知と力に、ひざまずけ！"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "私が貴様らを支配してやる！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "はあ……イブキが真似するから変なこと言わないでください。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "「クイーンのなんでも券」よ！私の願いを叶えたまえ！"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "それで？結局お願いは何にするの？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "愚問だな。世界征服に決まっているだろう！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "だと思いました……。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "では私の願いを……！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "……。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "マコト先輩？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "いや、やはり……。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "私の、願いは……。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "あ、起きたわ。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "言ったでしょう？体が丈夫なことだけが、マコト先輩のとりえなんですから。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "ん……？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "どういうことだ、これは……？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "覚えてない？マコトちゃん、カモメを捕まえるって言って船の上に登ろうとして、\nそこから真っ逆さまに落ちたのよ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "タイガーシャーク丸はどうした！？\nどんな願いも叶える「クイーンのなんでも券」は！？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "はい……？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "あの……寝言くらいまともなこと言ってくれませんか？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "寝言だからまともじゃないんじゃないの？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……それもそうですね。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "あれが全部夢だと！？そんな馬鹿な！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "認めん！私は認めんぞおおお！！！"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "あれ？"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "わあ～かわいいヤドカリさんだ！"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "ホシノ先輩！"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "わっ！？"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "もう！本当に寝てたの！？"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "あー……えーっとぉ～"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "倉庫の整理！お願いしたでしょ！？"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "そうそう、そうなんだけどさ～"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "そうなんだけど寝てたんでしょ！言い訳は？"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "ありません……。"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "まったく……手伝ってあげるから、早く起きて！二人でやればすぐ終わるでしょ。"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "うへ～さすがセリカちゃん～持つべきは可愛い後輩だね～"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "う、うるさいっ！あんまからかうと怒るわよ！？"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "……ホシノ先輩？"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "起きてからなんか変だけど、大丈夫？もしかして悪い夢でも……。"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "ん……？"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "いや～？ただの意味のない夢だよ～"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "いや……カニのある夢か。"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "まあでも……。"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "かわいい海の生き物たくさん見れたし、得しちゃったかな～"
    }
  ],
  "DialogKR": [
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키키킷……."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키시시시싯!!! 마침내, 붉은겨울마저 쓰러졌다!!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "이로써 게헨나를 넘어서는 학원이 없다는 사실이 증명된 거다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "하찮은 키보토스의 인간들이여! 지배해주마! 이 마코토 님의 지혜와 힘 앞에 무릎을 꿇어라!"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "지배해주마-!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아, 이부키가 배우니까 이상한 소리 하지 말아주세요."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "<여왕의 소원권>이여! 이 몸의 소원을 이뤄다오!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "소원은 뭘로 빌 거야?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "당연한 것을 묻는군! 그야 세계 정복으로 정해져 있지 않느냐!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그럴 줄 알았어요."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "그러면 나의 소원을……!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "……."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "마코토 선배?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "……아니, 역시."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "내 소원은……."
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "아, 일어났다."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "거 봐요. 몸 튼튼한 거 빼면 시체라니까요."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "응……?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "어떻게 된 거지……?"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "기억 안 나? 마코토 쨩, 갈매기를 잡겠다면서 배 위에 올라갔다가 거꾸로 떨어졌잖아."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "타이거샤크마루는?! 어떤 소원도 들어주는 <여왕의 소원권>은?!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "네……?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그게, 뭔……. 잠꼬대 정도는 말이 되게 하면 안 될까요?"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "잠꼬대니까 말이 안 되는 거 아냐?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……그건 그렇네요."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "그게 전부 꿈이었다고?! 말도 안 돼!! "
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "나 다시 돌아갈래!!!!"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "응?"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "와아~ 귀여운 소라게 씨다!"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "호시노 선배~!"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "우왓?!"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "아, 진짜! 정말로 자고 있던 거야?"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "어, 그러니까~ 이게……."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "창고 정리! 부탁했잖아!"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "참참~ 그랬지~ 그랬는데~"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "그랬는데! 잠들어 버렸고! 변명은?"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "없습니다……."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "하여튼…… 얼른 일어나! 도와줄 테니까! 둘이서 하면 빨리 끝날 거야."
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "으헤~ 역시 세리카 쨩~ 귀여운 후배는 두고 볼 일이라니까~"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "시, 시끄러워! 자꾸 놀리면 화낸다?!"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "……선배?"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "아까부터 반응이 좀 굼뜬데, 괜찮아? 혹시 이상한 꿈이라도……?"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "으, 응?"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "아냐아냐, 그냥 평범한 개꿈이었어."
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "아니, 그보다는 게꿈……?"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "……뭐, 그치만."
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "귀여운 바다 생물을 잔뜩 봐서, 조금 이득 본 기분일지도~"
    }
  ],
