{
  "TitleJP": "ロマンティック・クルージング（本当）",
  "TitleKR": "로맨틱 크루징(진짜)",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "海賊と勘違いして攻撃したお詫びとして、万魔殿一行はオデュッセイアの歓待を受ける。当初の予定とは異なるものの、今度こそ「本当」のクルーズ旅行が始まるのだった。",
  "DescKR": "오디세이아의 사과로 '진짜' 크루즈 여행이 시작된다!",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "後日談その1;ロマンティック・クルージング（本当）"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キシシッ！先生よ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "ちゃんと楽しんでいるか？遅くなったが、約束通りクルージングの旅を用意したぞ！"
    },
    {
      "Text": "[s1] \"ああ、うん。\""
    },
    {
      "Text": "[s2] \"用意してくれたのはオデュッセイアだけど……。\""
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "結局こういう待遇も万魔殿であるがゆえに受けられるのだ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "つまり万魔殿が用意したものと変わりない！"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "ごもっともです！万魔殿の議長様！"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "先生も、ど～か我が家のように！ごゆっくりお過ごしくださいね！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キシシッ！その素晴らしい心構え、きっとお前がトライデントの部長なのだろう。"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "……えっ？ああ、まあそんな感じです。へへっ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "いま私は気分がいい。オデュッセイアの無礼な先制攻撃はなかったことにしてやろう。"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "誠にありがとうございます！！"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "……部長、でいいのかしら？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "ただのバカなんでしょう、きっと。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "おおっ！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ここがあの、オデュッセイア海洋高等学校！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "とはいえ……。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "聞いていた話よりは少し小さい気がするのですが、やっぱり噂は誇張されがちなんでしょうか？"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "あ、私たちは主に治安要員で、別で活動してるんです。"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "[ruby=・]学[/ruby][ruby=・]園[/ruby][ruby=・]の[/ruby][ruby=・]方[/ruby]は、今頃遠征から帰路につく頃じゃないでしょうか？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "学園の方……！？全体規模で航海に出てるんですか！？噂以上でした！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あ、よければ写真撮っても大丈夫ですか？"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "撮影は……ごめんなさい。\n私たちはゲヘナでいう風紀委員会みたいな組織でして。\nセキュリティ上、あまりこの船の写真は撮らないでいただけると……。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あ、いえ、オデュッセイアの方は初めてなので、一緒に写真を撮りたいと思って！"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "えっ、わ、私ですか！？ちょっと、いつもの格好だから、恥ずかし……。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "そのいつも通りの姿をカメラに収めたいんです！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あっもちろん、強制ではありません！本当に嫌でしたら言ってくださいね。"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "あっ……じゃあ。"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "ピース。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "わあ！すごく可愛いです！いいショットです！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "二人で撮っても大丈夫ですか？"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "ああ、はい。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ありがとうございます！人生のお宝がまた一つ増えました！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あれ……？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ん～……写真で見ると、なんかどこかでお会いしたような。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あっ、思い出した！さっき船で戦った時の方ですよね？"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "あ……実は、はい。"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "気付かなかったので……は言い訳にならないかもしれませんが……。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "おお！では是非インタビューをお願いしたいです！"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "……えっ？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ナマで武勇伝なんてそうそう聞けないので！しかもご本人からなんて尚更です！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "海に現れた凶悪な海賊をやっつけた感想とか！お話を聞けたらなと思います！"
    },
    {
      "CharacterName": 3704769125,
      "Name": "トライデントの部員",
      "Text": "あの……海賊の方じゃ、なかったんですか？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "先生、ここにいたのね。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "それとも、私のこと探してたのかしら？"
    },
    {
      "Text": "[s3] \"今回は大活躍したね。\""
    },
    {
      "Text": "[s4] \"本当にお疲れ様。\""
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "そうよ！？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "私すっごく……。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "怖くて大変だったんだから！？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "ここで200パーセント楽しまなきゃ損よ。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "当然、先生も付き合ってくれるわね？"
    }
  ],
  "DialogKR": [
    {
      "Text": "후일담;로맨틱 크루징(진짜)"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키시싯! 선생!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "잘 즐기고 있나? 조금 늦긴 했지만, 약속대로 크루즈 여행을 마련해줬지!"
    },
    {
      "Text": "[s1] \"아, 응…….\""
    },
    {
      "Text": "[s2] \"준비해 준 거는 오디세이아지만…….\""
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "결국은, 이러한 대접 역시 만마전이기에 받을 수 있는 것."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "즉, 실질 만마전에서 준비한 것과 다르지 않다!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "지당하신 말씀입니다, 대만마전 의장님!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "선생님도 부~디~! 자기 집처럼 편하게 지내 주세요!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키시싯! 그 훌륭한 태도를 미뤄보아, 네가 이 트라이던트의 부장이겠군."
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "……네? 음, 비슷한 거라 보셔도 좋습니다, 헤헤."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "지금 이 몸은 기분이 좋다. 오디세이아에서 무례하게 가한 선제공격은 없던 일로 해주마!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "성은이 망극합니다!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "……부장의 비슷한 거는 뭘까?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "바보겠죠. 아마도."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "오옷!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "여기가 바로 그 유명한 오디세이아 해양학원!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "그~렇다~! 해도……."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "듣던 것보다 살짝 작은 느낌인데, 역시 소문은 소문이라는 걸까요?"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "아, 저희 트라이던트는 치안 임무로 별동 활동 중이라서요."
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "<학원>이라면, 지금쯤 원양 항해에서 돌아오고 있지 않으려나요?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "학원 전체가요?! 항해에 나가 있는 건가요?! 소문 그 이상이네요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아, 혹시 사진 찍어도 괜찮을까요?"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "아…… 일단은, 저희는 선도부 같은 거라, 기함 <로도스 호>만큼은 아니라도 여기에도 보안 구역이 꽤 있어서요."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아, 아뇨, 오디세이아 분은 처음 만나서 함께 사진을 찍고 싶었어서요!"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "네, 넷?! 저요?! 그…… 하나도 안 꾸며서, 부끄러운데……."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "그 자연스러운 모습을 찍고 싶었던 거라서요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아, 물론, 강요는 아니에요! 정말 싫으시면, 말씀해 주세요."
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "아, 저, 그럼……."
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "브이."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "오옷! 엄청 귀여워요! 좋은 사진을 찍었네요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "같이 셀카 찍어도 될까요?"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "아, 네."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "감사합니다! 인생에 보물이 늘었네요"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "어라……?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "으으음~ 역시, 사진으로 보니 조금 낯이 익은데~"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아! 기억났다! 아까 배에서 싸울 때, 반대편에 계셨죠?"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "그…… 사실, 맞아요."
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "몰랐다고 변명이 되지는 않지만……."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "오오! 그러면, 꼭 인터뷰하고 싶어요!"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "……네?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "역시 생생한 무용담은 좀처럼 듣기 힘들잖아요? 게다가 본인의 이야기는 더더욱이요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "바다에 나타난 흉악한 해적을 물리친 소감이라든지! 들어보고 싶은데요!"
    },
    {
      "CharacterName": 3704769125,
      "Name": "트라이던트 부원",
      "Text": "……죄송한데, 그 해적 아니신가요?"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "선생, 여기 있었네?"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "아니면 혹시 날 찾은 거야?"
    },
    {
      "Text": "[s3] \"이번에는 사츠키가 맹활약했지.\""
    },
    {
      "Text": "[s4] \"정말 고생 많았어.\""
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "맞아!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "진짜로, 진짜로~!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "엄청 무섭고 힘들었단 말이야!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "여기서 백배로 즐기지 않으면 수지가 안 맞아!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "당연히 선생도 어울려 줄 거지?"
    }
  ],
