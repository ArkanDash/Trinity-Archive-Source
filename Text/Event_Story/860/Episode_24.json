{
  "TitleJP": "夕闇の高飛車トライアムヴィレイト（２）",
  "TitleKR": "저녁 바다의 우쭐한 트리움비라투스 2",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "ヒフミを相手に万魔殿は勝利を収める。これで優勝まで残すところ星1つとなったが、トリニティを下した今、最後の敵が誰なのか、想像がつかないのだった。",
  "DescKR": "비밀 병기로 끌려 나온 히후미와 그녀의 게를 상대로, 만마전이 또 한 번 승리한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キシシッ！見たか！これが窮鼠猫を噛むというやつだ！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "いや、ネズミはそちらの方か！キシシッ！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "どっちでもいいでしょ……。"
    },
    {
      "CharacterName": 364307345,
      "Name": "ナギサ",
      "Text": "ハッ……？私は今まで何を……？"
    },
    {
      "CharacterName": 3764981078,
      "Name": "ミカ",
      "Text": "あっ、いつものナギちゃんだ。"
    },
    {
      "CharacterName": 1180855895,
      "Name": "セイア",
      "Text": "よかった。戻ったようだね。"
    },
    {
      "CharacterName": 4002563878,
      "Name": "ヒフミ",
      "Text": "あうう……私はもう帰ってもいいでしょうか？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キキキッ！あの忌まわしきティーパーティーでさえ、我々を止められはしなかった！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "このキヴォトスに……万魔殿の、いや私の敵は最早いない！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "うわあ、すごい天狗になってる。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "カニ同士の戦いでここまで調子に乗れるのもすごいですね……。"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "これで星は4つだね！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "おお。イブキ、よく覚えてましたね。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "……あれ？でもこの流れなら、トリニティが最後の相手になるはずだよね？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "まあ、そうですね。それがなにか？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "思い出してよ。\n「[ruby=てんかいっかい]天下一蟹[/ruby]・武術大会」の優勝には、星が5つ必要だったでしょ？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……そんな設定、よく覚えてますね。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "あと1校……トリニティより強い学園なんてありましたっけ？"
    },
    {
      "CharacterName": 2746145574,
      "Name": "？？？",
      "Text": "…………。"
    }
  ],
  "DialogKR": [
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키시시싯! 보아라! 이게 바로 언더독의 반란이라는 거다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "아니, 애당초 그쪽이 언더였지만!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "둘 중 하나만 하라고요."
    },
    {
      "CharacterName": 364307345,
      "Name": "나기사",
      "Text": "핫…… 방금까지 저는 도대체 무엇을……?"
    },
    {
      "CharacterName": 3764981078,
      "Name": "미카",
      "Text": "앗, 평소의 나기 쨩이다."
    },
    {
      "CharacterName": 1180855895,
      "Name": "세이아",
      "Text": "돌아왔군요. 아니, 오히려 이쪽이 연기일 가능성도……?"
    },
    {
      "CharacterName": 4002563878,
      "Name": "히후미",
      "Text": "아우우…… 저는 혹시 돌아가 봐도 될까요……?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키키킷! 그 가증스러운 티파티조차 우리를 막지 못했다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "이 키보토스에 만마전의, 이 몸의 적수는 없다고 해도 무방하겠군! 키히힛! "
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "우와, 엄청 기고만장."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "도대체 게 싸움을 이긴 정도로 얼마나 흥이 오른 건지……."
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "이제 별은 4개야!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "오, 잘 기억하고 있네요. 역시나 이부키."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "……어라? 그치만, 지금 흐름대로면, 트리니티가 마지막 상대가 아닌가요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그런데요?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "하지만 <천하게일무술대회> 우승에는 별 다섯 개가 필요한걸요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……그 얼토당토않은 설정, 잘도 기억하고 있네요."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그치만, 있나요? 트리니티 다음으로, 나타날 만한 학원이……?"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "…………."
    }
  ],
