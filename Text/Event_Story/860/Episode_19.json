{
  "TitleJP": "東奔西走、年中無休マッドドッグ（１）",
  "TitleKR": "동분서주한 연중무휴 매드 독 1",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "島を探索していた一行は、公安局のカンナとコノカに声をかけられる。曰く、優勝候補だった対策委員会を倒したことで噂になっているとして、挑戦状を叩きつけられるのだった。",
  "DescKR": "이번에는 발키리 공안국의 칸나와 코노카가 도전장을 내민다. ",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "東奔西走、年中無休マッドドッグ"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "わあ！お祭りだ～！"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "へぇ、結構賑わってるのね。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "おお！結構大きなイベントなんですね！テンション上がってきました！"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "美味しそうな匂い～"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "ふふっ、久々に海鮮以外が食べられそうね。"
    },
    {
      "CharacterName": 2746145574,
      "Name": "？？？",
      "Text": "へいへーい、そこの可愛いおねーさんたち。"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "ちょーっとこっちに来てもらえます？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "ヴァルキューレ！？チアキ、一体何やらかしたのよ！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "へっ！？な、何もしてませんよ～！"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "副局長、いきなり呼び止めたら驚くだろう。"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "あー、たしかに。さーせん。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "本当に反省してるのか？まったく……。コホン、失礼した。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "改めて、我々はヴァルキューレ警察学校の者だ。"
    },
    {
      "Text": "東奔西走、\n年中無休マッドドッグ"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "今はこの島の治安を担当している。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "そちらの噂はかねがね。なんでも、対策委員会を倒したとか。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "それは事実ですが……どうしてそれを？"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "こんな小さい島っすから、噂はすーぐ広まるんすよ。"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "対策委員会は優勝候補の一つでしたし。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "これはちょっとした事件だ。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "それに、ザリガニとヤドカリは明らかな上下関係にある生物……。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "町の秩序に加えて、生態系を乱されたとあっては、我々も黙ってはいられない。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "……キキキッ。なるほど。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "そんな言い訳をしてまで私たちの邪魔をしたいのか？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "いいだろう。その挑戦、受けて立とうではないか！"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "……フッ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "何がおかしい？"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "これは失礼……確かに、対策委員会は強力な優勝候補だったが……。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "順位は公安局よりも下だった。"
    },
    {
      "CharacterName": 4050342034,
      "Name": "カンナ",
      "Text": "挑戦者は、そちらの方だ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "お……面白い！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "連邦生徒会の犬ごときに、本気を出すまでもないわ！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "うわ、雑魚みたいなセリフ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "うるさいぞイロハ！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "さあチアキ！万魔殿の書記として、威厳を見せてこい！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "えっえっ！？私ですか！？急すぎません！？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "おおっ！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "頑張ってください、チアキ。応援してます。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "イロハちゃん、今すごい喜んでなかった！？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "いや、いつもは私がそっち側なんで。はたから見てる分には楽しいもんですね。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ひ、ひどい！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "うぅ……こうなった以上、やるしかありませんね！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "いきますよ、ブラックドリー！私たちの絆を見せつけてやりましょう！"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "ふっ、選手が決まったみたいっすね。"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "それじゃ両カニ、位置について……！"
    },
    {
      "CharacterName": 1921885066,
      "Name": "コノカ",
      "Text": "クラブ、ファイッ！！"
    }
  ],
  "DialogKR": [
    {
      "Text": "동분서주한 연중무휴 매드 독"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "와아! 축제 같아!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "저쪽 해변에서는 전혀 보이지 않았는데, 사람이 꽤 많네?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "오오! 진짜로 대회군요! 텐션이 오르네요!"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "맛있는 냄새~"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "어머, 먹을 것까지 팔고 있네. 오랜만에 해산물이 아닌 걸 먹을 수 있는 걸까?"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "헤이헤이헤이~ 거기 이쁜이들~"
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "해변에 들어가기 전에, 잠깐 우리 좀 보실까~?"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "바, 발키리?! 치아키, 대체 무슨 짓을 한 거야?!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "네엣?! 저는 아무것도 안 했는데요?!"
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "코노카, 다짜고짜 멈춰 세우면 당황하지 않겠나."
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "죄송쓰~"
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "그걸 사과라고…… 이거, 실례했습니다."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "저희는 발키리 공안국입니다."
    },
    {
      "Text": "동분서주한\n연중무휴 매드 독"
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "지금은, 이 섬의 치안을 담당하고 있죠."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "이야기는 들었습니다. 대책위원회를 쓰러트렸다죠."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그건 사실이긴 한데요…… 어떻게 그 사실을?"
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "쯧. 쯧. 쯧. 이런 작은 섬에서는 소문이 빠르게 돈다는 말씀!"
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "하물며 대책위원회는 우승 후보로 꼽히는 거물이었으니……."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "이건 중대한 문제입니다."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "하물며, 소라게와 가재는 명백한 상하관계에 있는 생물."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "도시의 질서를 지키는 것도, 더 나아가 생태계의 질서를 지키는 것도! 우리 공안국의 사명입니다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "……키키킷. 과연."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "그런 핑계를 대면서까지 우리의 발목을 잡겠다는 건가?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "좋다. 도전이라면, 마다하지 않으마!"
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "훗."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "뭐가 우습지?"
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "이거 실례. 대책위원회는 분명 강력한 우승 후보였지만."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "순위는 공안국보다 낮았습니다."
    },
    {
      "CharacterName": 4050342034,
      "Name": "칸나",
      "Text": "도전자는 그쪽입니다."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "우…… 웃기는 소리로군!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "총학생회의 개 따위, 우리 만마전에서 진심으로 나설 정도는 아니다!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "우와, 진짜 조무래기 같은 대사."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "시끄럽다, 이로하!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "자, 치아키! 가서 만마전 서기의 위엄을 보여라!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "네, 넵?! 갑자기 저요?!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "오!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "잘됐네요. 치아키, 응원할게요."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "이로하 쨩, 갑자기 엄청 신나지 않았나요?!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아니, 보통은 제가 그쪽에 서니까. 이야, 이쪽에 서는 건 즐겁네요~"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "너, 너무해~!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "으으~ 이, 이렇게 된 이상, 하는 수밖에 없네요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "가죠, 블랙 돌리! 저희의 유대를 보여주는 거예요!"
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "후후, 선수가 정해졌슴까."
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "그러면, 두 게 모두 자리로……!"
    },
    {
      "CharacterName": 1921885066,
      "Name": "코노카",
      "Text": "크랩 파이트-!!"
    }
  ],
