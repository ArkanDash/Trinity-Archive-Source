{
  "TitleJP": "デイ・オブ・ザ・ロブスター",
  "TitleKR": "데이 오브 더 랍스터",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "一行が漂流してからついに〇日目。万魔殿のメンバーと言えども限界が近づいていた。もはやこれまでかと思われた時、イブキが発見した無人島に上陸を果たす。その島で見つけたヤドカリにファイターとしての闘志を見出したマコトは「タイガーシャーク丸」と名付けるのだった。",
  "DescKR": "표류 끝에 발견한 무인도. 마코토는 우연히 마주친 소라게에게 '타이거샤크마루'라는 이름을 붙인다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "デイ・オブ・ザ・ロブスター"
    },
    {
      "Text": "[log]漂 流 〇 日 目[/log]"
    },
    {
      "Text": "[ns1] \"……今頃みんなはどうしてるんだろう。\""
    },
    {
      "Text": "[ns2] \"元気にしてるかなぁ……。\""
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "朝から弱気とはらしくないな、先生よ。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "この私が統治するネオ・ゲヘナでの生活に、何か不満でもあるのか？"
    },
    {
      "Text": "[s] \"ネオ……ゲヘナ？\""
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "ああ、今朝……私は目覚めたのだ！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "マコト様がいるこの船こそが真のゲヘナなのだと！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "よって、ここを「ネオ・ゲヘナ」と名付けたのだ！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "……どうした、先生？何か言いたげな顔だな。"
    },
    {
      "Text": "[s3] \"その考え方は大事だなと思って。\""
    },
    {
      "Text": "[s4] \"やっぱりマコトはたくましいね。\""
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キシシッ！要は褒めているということか！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "先生も安心してこの時間を楽しんでくれ！救助隊はじき到着する！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "なるほど～！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "海での生活にはそんな悩みがあるんですね！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "おや、先生！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "え？あ、こちらはですね――"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ご紹介します！取材に協力いただいている、お魚のヨナさんです！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "袖振り合うも他生の縁！いえ、エラ振り合うも他生の縁！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "この広い海で出会えた奇跡！とても他人とは思えません！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "そんなわけで、色々とインタビューしていたんです。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "先生はどうされました？"
    },
    {
      "Text": "[s5] \"えっと……少し立ち寄っただけ。\""
    },
    {
      "Text": "[s6] \"インタビュー……頑張ってね。\""
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "はい！ありがとうございます！！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "それで、巨大魚に飲み込まれた話の続きなんですが――"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "はぁ……本当、目も当てられませんね。"
    },
    {
      "Text": "[s7] \"イロハ！\""
    },
    {
      "Text": "[s8] \"よかった！大丈夫だったんだ――\""
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……どうしました？幽霊でも見たような顔して。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "え？これですか？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "見ての通り虎丸ですけど？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "何か問題でも？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "主砲、装甲、異常なし……。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "特に変わったところはありませんが……？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "先生の気のせいじゃないんですか？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……じゃあ、私は見回りがあるのでこれで。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "いきましょう、虎丸。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "ブーン。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "……陸に戻るまで、そっとしておいた方がよさそうね。"
    },
    {
      "Text": "[s9] \"サツキ！！\""
    },
    {
      "Text": "[s10] \"無事だったんだね！！\""
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "その言い方だと無事じゃない人もいるように聞こえるんだけど……。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "今の状況を見ると、そうじゃないとは言い切れないわよね。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "それにしても……マコトちゃんはさておき、イロハやチアキまで……。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "これじゃ万魔殿の面子は丸つぶれね。"
    },
    {
      "Text": "[s11] \"マコトはさておくんだ……。\""
    },
    {
      "Text": "[s12] \"みんな、ストレスが溜まっちゃってるみたいだね。\""
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "そうね、私だってここまで長引くとは思ってなかったもの。"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "せんせ～！"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "サツキ先輩もやっほー！"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "イブキちゃん、船の上で走ったら危ないわよ？"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "あっ！うん、気をつける……。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "それで、そんなに急いでどうしたの？"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "あのね！あっちに島があったの！"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "まさか。この近くに島なんて……。"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "はっ！まさか、イブキちゃんまで幻覚を！？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "……ん？先生？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "ぼーっとしてどうしたの？気を付けないと海に落ちちゃう――"
    },
    {
      "Text": "[ns] \"り……。\""
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "り？"
    },
    {
      "Text": "[ns] \"陸だ！！！\""
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "え！ほ、本当！？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "陸！？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "なっ、本当かそれは！？"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "……本当に、こんな大きな島があるなんて。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "今のところ、人の気配はないですね。無人島でなければいいのですが。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "何を言う、イロハ！無人島の方が良いに決まっているだろう！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "え？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "無人島ということは……このマコト様が、この島の最初の発見者ということになる！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "キシシッ！今日からこの島の名前は「マコト島」だ！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……どうやったらそんなポジティブ思考になれるんですか。"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "ん？"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "わあ～かわいいヤドカリさんだ！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "本当だ、かわいい！写真撮るね！"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "いぇ～い、万魔殿ヤドカリ～！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "え？万魔殿ヤドカリ……？"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "そうだよ！これはマコト先輩。こっちはサツキ先輩……。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "おおっ！たしかに、殻の色がマコト先輩たちの髪色と一緒！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "じゃあ、こっちの黒い子は万魔殿ヤドカリの書記？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……なるほど、それなりに生態系は整っているんですね。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "つまり食料調達ができる可能性が高い、と。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "イブキには申し訳ないですが、この子たちも……。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "なんだとっ！？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "こいつを食べるというのか！？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "び、ビックリした……今度は何ですか。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "何ですか、ではない！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "食糧など言語道断！こいつは正真正銘のファイターだ！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "…………。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……はい？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "純真無垢な目の奥にたぎる熱い闘志……お前、タダのヤドカリではないな！？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "お前の正体はなんだ！"
    },
    {
      "CharacterName": 2533185223,
      "Name": "イブキ",
      "Text": "言え！一体なんなのだ！"
    },
    {
      "CharacterName": 902192482,
      "Name": "サツキ",
      "Text": "あら、おめでとうヤドカリさん。マコトちゃんがこんな風に褒めるなんて珍しいわよ。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "いやいや……。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "ヤドカリ一匹に、そんな大袈裟な……。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あははっ！でもいつものみんなに戻ったみたいでよかった！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……まあ、そうですね。落ち込んでいるよりかは。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "分かったぞ！こいつはサメなのだ！\nたとえ体が小さかろうと、気概はサメに勝るとも劣らん！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "今からお前は「タイガーシャーク丸」だ！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "ヤドカリ界の頂点……。\nいやそれを飛び越え、甲殻類最強のチャンピオンになるのだ！"
    },
    {
      "CharacterName": 2746145574,
      "Name": "？？？",
      "Text": "うへ～"
    }
  ],
  "DialogKR": [
    {
      "Text": "데이 오브 더 랍스터"
    },
    {
      "Text": "[log]표 류 XX 일 차[/log]"
    },
    {
      "Text": "[ns1] \"……육지에서는 어쩌고 있을까?\""
    },
    {
      "Text": "[ns2] \"다들 잘 지내고 있을까……?\""
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "아침 댓바람부터 무슨 나약한 소리인가, 선생!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "이 몸이 통치하는 네오 게헨나에서의 생활에 불만이라도 있는 건가?"
    },
    {
      "Text": "[s] \"네오…… 게헨나……?\""
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "그래, 오늘 아침, 이 몸은 불현듯이 깨닫고 말았다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "게헨나는 멀리 있지 않다고…… 아니, 오히려 이 마코토 님이 있는 곳이야말로 진정한 게헨나라고!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "즉, 이 배는 새로운 게헨나, <네오 게헨나>인 것이다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "……뭔가, 선생? 하고 싶은 말이 있어 보이는데."
    },
    {
      "Text": "[s3] \"그런 마인드, 훌륭하다 생각합니다.\""
    },
    {
      "Text": "[s4] \"마코토는 역시 씩씩하구나…….\""
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키히힛! 잘은 모르겠지만, 칭찬이로군!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "선생도 쓸데없는 생각 말고 이 시간을 만끽하는 게 좋을 거다! 어차피 구조대는 금방 도착할 테니 말이야!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "헤에~ 그렇군요."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "바다에서의 삶에는 바다만의 고충이 있다! 라는 것이네요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "어라. 아, 선생님!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "네? 누구랑 대화하고 있느냐고요?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "후후, 소개해 드릴게요! 여기 계신 분은 물고기 요나 씨에요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "옷깃만 스쳐도 인연! 아니, 지느러미만 스쳐도 인연!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "망망대해 한복판에서 마주친 기적, 더는 남이라고 할 수는 없죠!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "그래서 모처럼이니 이것저것 여쭤보고 있었거든요."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "근데, 왜 그러세요?"
    },
    {
      "Text": "[s5] \"아, 아니, 괜찮다 생각해. \""
    },
    {
      "Text": "[s6] \"그, 인터뷰 힘내.\""
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "네엡! 감사합니다!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "그러면, 커다란 물고기한테 통째로 삼켜진 이야기부터 마저 듣고 싶은데요……."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "하아…… 정말 못 봐주겠네요."
    },
    {
      "Text": "[s7] \"아, 이로하!\""
    },
    {
      "Text": "[s8] \"믿고 있었어! 이로하는 제정ㅅ…….\""
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……? 뭔가요? 무슨 유령이라도 본 것처럼?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "네? 손에 들고 있는 이거요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "보시다시피 토라마루인데요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "제 토라마루에 뭔가 문제라도……?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "주포는 멀쩡하고, 장갑에도 이상이 없고……."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "제가 보기에는 정상 같은데요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "네? 아무것도 아니라고요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……하여튼 저는 순찰 일정이 있어 이만."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "갑시다, 토라마루."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "부우웅."
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "……육지에 돌아갈 때까지, 진실은 말하지 않는 편이 좋겠지?"
    },
    {
      "Text": "[s9] \"사츠키!\""
    },
    {
      "Text": "[s10] \"무사했구나!\""
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "자, 잠깐! 그렇게 말하면 무사하지 않을 수도 있는 것 같잖아!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "불안해지니까 그런 식으로 말하지 마!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "……그나저나, 마코토 쨩은 그렇다 쳐도. 이로하에, 치아키까지."
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "이래서는 만마전의 체면이 대손상이야."
    },
    {
      "Text": "[s11] \"마코토는 그렇다 치는구나…….\""
    },
    {
      "Text": "[s12] \"다들 이래저래 스트레스가 쌓인 걸까.\""
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "하긴, 나도 이렇게 표류가 길어질 줄은 몰랐으니까."
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "선생님~!"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "아, 사츠키 선배도 있다! 안녕하세요!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "어머, 이부키 쨩. 배 위에서 뛰면 넘어진다고."
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "아차……. 조심조심……."
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "그래서, 왜 그렇게 급하게 달려온 거니?"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "응, 있지! 저기 끝에, 섬이 있어!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "아니, 이런 망망대해 한복판에 섬이 있을 리가……."
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "헉! 설마 이부키 쨩마저 헛것을?!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "……선생님?"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "갑자기 왜 그래, 바다를 빤히 바라보고. 조심하지 않으면 떨어진다고?"
    },
    {
      "Text": "[ns] \"유…….\""
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "유?"
    },
    {
      "Text": "[ns] \"육지다!!\""
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "뭐, 뭐야?! 진짜야?!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "육지라고요?!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "뭐?! 그 말이 사실인가?!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "정말이네…… 이렇게 큰 섬이 바다 한복판에 있을 줄이야."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……사람의 흔적이 없네요. 무인도, 는 아니었으면 좋겠는데."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "응? 아니지. 차라리 발견된 적 없는 무인도인 편이 좋다!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "네?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "그 말은 즉, 이 섬을 처음으로 발견한 게 이 몸이라는 뜻이 되니까 말이다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "키시싯! 오늘부터 이 섬은 마코토 섬이라 부르겠다!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……어떻게 그렇게 포지티브한 사고방식이 가능한 건지, 슬슬 신기할 지경인데요?"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "응?"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "와아~ 귀여운 소라게 씨다!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "정말이네요! 귀여워라! 사진 찍을까요?"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "소라게 만마전이야!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "소라게 만마전……?"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "응! 이건 마코토 선배, 이건 사츠키 선배……."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "오오! 그러고 보니! 등껍질 색깔이 저희 머리색이랑 똑같네요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "그러면, 이 검은 아이는 소라게 만마전의 서기인 걸까요?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……과연. 나름 생태는 갖춰져 있나요."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그렇다는 것은, 여기서 식량 조달이 가능할지도 모르겠네요."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "이부키에게는 미안하지만, 이 녀석들도……."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "뭣이라고?!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "지금 먹겠다는 거냐?! 이 녀석을?!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "까, 깜짝이야……. 또 뭐가 문제예요?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "보고도 모르겠나?!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "식량 따위 언어도단! 이 녀석은 파이터다!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "…………."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……네?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "똘망거리는 눈 너머로 보이는 이글거리는 투지는……, 너는 평범한 소라게가 아니군?!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "대체 정체가 뭐냐, 네 녀석?!"
    },
    {
      "CharacterName": 2533185223,
      "Name": "이부키",
      "Text": "정체가 뭐냐!"
    },
    {
      "CharacterName": 902192482,
      "Name": "사츠키",
      "Text": "어머, 대단한 고평가네. 축하해, 작은 소라게야. 마코토 쨩한테 이런 평가는 쉽게 받기 어려워."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아니, 무슨……."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "다들, 고작 소라게 한 마리로 무슨 호들갑을……."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아하하! 그래도 좋잖아? 오랜만에 평소의 만마전으로 돌아온 기분인걸!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……뭐, 그렇네요. 축 쳐져 있는 것보다야……."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "알았다! 이 녀석은 상어다! 비록 육체는 소라게지만, 기백은 상어에 못지않다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "지금부터 너는 <타이거샤크마루>다!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "소라게의 정점, 아니, 그걸 뛰어넘어 갑각류 최강이 될 챔프다!"
    },
    {
      "CharacterName": 2746145574,
      "Name": "???",
      "Text": "으헤~"
    }
  ],
