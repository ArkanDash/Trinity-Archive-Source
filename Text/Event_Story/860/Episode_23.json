{
  "TitleJP": "夕闇の高飛車トライアムヴィレイト（１）",
  "TitleKR": "저녁 바다의 우쭐한 트리움비라투스 1",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "順調に白星を重ねる万魔殿の前に、様子のおかしいティーパーティーが立ちはだかる。3対1は卑怯だと抗議するマコトに対し、ナギサは虎の子として1人の選手を紹介する。突然連れてこられて事情が分かっていない様子のヒフミとマコトの戦いが幕を開ける。",
  "DescKR": "트리니티 티파티의 나기사가 일행의 앞을 가로막는다. ",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "夕闇の高飛車トライアムヴィレイト"
    },
    {
      "Name": "マコト",
      "Text": "諸君、私は非常に重要な事実に気が付いた。"
    },
    {
      "Name": "イロハ",
      "Text": "あ、そうですか。イブキ、暗いので足元に注意してください。"
    },
    {
      "Name": "イブキ",
      "Text": "うん！イロハ先輩も気をつけてね！"
    },
    {
      "Name": "マコト",
      "Text": "我々の優勝を左右する、とんでもない手がかりだ。"
    },
    {
      "Name": "サツキ",
      "Text": "みんな、夜の海の何がそんなに好きなの！？ちょっとチアキ、離れないで！"
    },
    {
      "Name": "チアキ",
      "Text": "分っかりました～！でも、もう少しで商店街につきますので～"
    },
    {
      "Name": "マコト",
      "Text": "気になるだろう？気になって、夜も眠れなくなるはずだ！"
    },
    {
      "Name": "マコト",
      "Text": "そうだろう！？"
    },
    {
      "Text": "[s1] \"う、うん！！\""
    },
    {
      "Text": "[s2] \"すごく気になる！！\""
    },
    {
      "Name": "マコト",
      "Text": "キシシッ！よくぞ聞いてくれた。"
    },
    {
      "Name": "マコト",
      "Text": "それは――敵が現れる順番が決まっているということだ！"
    },
    {
      "Name": "マコト",
      "Text": "最初に出会ったのは誰か、思い出してみるがいい。"
    },
    {
      "Name": "イロハ",
      "Text": "……たしかアビドスでしたね。"
    },
    {
      "Name": "マコト",
      "Text": "ああ。名もほとんど忘れられた、弱小学園だ。その次は……。"
    },
    {
      "Name": "チアキ",
      "Text": "ヴァルキューレ警察学校、ですよね？\n公安局長、ずっと怒った顔してましたけど……何かあったのでしょうか？"
    },
    {
      "Name": "マコト",
      "Text": "ふむ、連邦生徒会の犬ではあるがアビドスとはワケが違う。\nそして、直前の学園はというと……。"
    },
    {
      "Name": "サツキ",
      "Text": "百鬼夜行連合学院。なるほど、マコトちゃんの言いたいことは分かったわ。"
    },
    {
      "Name": "マコト",
      "Text": "流石だサツキ。そうだ、百鬼夜行は我々ゲヘナとは比べるまでもないが、\nそれでも相当な規模の学園になる。"
    },
    {
      "Name": "マコト",
      "Text": "つまり、我々の相手はどんどん強くなっている！\nとなれば……百鬼夜行よりも強く、ゲヘナに匹敵する強敵――"
    },
    {
      "Name": "マコト",
      "Text": "いや、宿敵とも言える「あの学園」と対峙するのも時間の問題ということだ！"
    },
    {
      "Name": "イブキ",
      "Text": "宿敵ー？"
    },
    {
      "Name": "？？？",
      "Text": "オーッホッホッホッホ！順調に勝ち進んでいるようですね！"
    },
    {
      "Name": "？？？",
      "Text": "しかし快進撃もそこまでです！"
    },
    {
      "Name": "マコト",
      "Text": "やはり来たか……！"
    },
    {
      "Name": "イロハ",
      "Text": "何ですかこのベタな展開……。"
    },
    {
      "Name": "ナギサ",
      "Text": "どこの馬の骨とも知れない……。\nそれも、ヤドカリごときが旋風を巻き起こしているようで。"
    },
    {
      "Text": "夕闇の高飛車\nトライアムヴィレイト"
    },
    {
      "Name": "ナギサ",
      "Text": "「クラブファイト」は血統のスポーツだと……その身をもって知ってもらいます！"
    },
    {
      "Name": "マコト",
      "Text": "はっ！好き勝手言ってくれる！"
    },
    {
      "Name": "ナギサ",
      "Text": "ヤドカリ風情がトリニティの名カニに勝てるとでも？\n身の程知らずも甚だしいですね。"
    },
    {
      "Name": "ナギサ",
      "Text": "そんなもの、夢のまた夢のお話ですよ！オーッホッホッホ！"
    },
    {
      "Name": "ミカ",
      "Text": "な、ナギちゃんどうしたの……？"
    },
    {
      "Name": "ミカ",
      "Text": "ストレス？それとも、ロールケーキの賞味期限切れてた？"
    },
    {
      "Name": "セイア",
      "Text": "……。"
    },
    {
      "Name": "セイア",
      "Text": "……！"
    },
    {
      "Name": "セイア",
      "Text": "……そうじゃないだろう？ミカ。"
    },
    {
      "Name": "ミカ",
      "Text": "え？"
    },
    {
      "Name": "セイア",
      "Text": "真の友人であるならば、我々のやるべきことは一つだ。"
    },
    {
      "Name": "ミカ",
      "Text": "ど、どういう意味……？"
    },
    {
      "Name": "セイア",
      "Text": "要するに……。"
    },
    {
      "Name": "セイア",
      "Text": "その貧相なヤドカリ……見ているだけで、せっかくのお茶が不味くなりますわ！"
    },
    {
      "Name": "ミカ",
      "Text": "セイアちゃん！？"
    },
    {
      "Name": "ナギサ",
      "Text": "オーッホッホッホ！"
    },
    {
      "Name": "ミカ",
      "Text": "ナギちゃんまで！？"
    },
    {
      "Name": "ミカ",
      "Text": "……あーもうっ！知らないから！！"
    },
    {
      "Name": "ミカ",
      "Text": "さあ、かかっておいでなさい！身の程を分からせてやりますわ！！"
    },
    {
      "Name": "マコト",
      "Text": "ついに本性を現したな！ティーパーティー！"
    },
    {
      "Name": "マコト",
      "Text": "3対1とは卑怯だぞ！"
    },
    {
      "Name": "ナギサ",
      "Text": "3対1……？ふっ。"
    },
    {
      "Name": "マコト",
      "Text": "何がおかしい？"
    },
    {
      "Name": "ナギサ",
      "Text": "先ほどお伝えしたように、クラブファイトとは血統のスポーツ……。"
    },
    {
      "Name": "ナギサ",
      "Text": "つまり、選手の優劣がそのまま勝敗を分けます。"
    },
    {
      "Name": "ナギサ",
      "Text": "では……我々トリニティの、最高の選手をご紹介しましょう！"
    },
    {
      "Name": "ヒフミ",
      "Text": "えっ……な、なんですか？というか、どこですかここ！？"
    },
    {
      "Name": "マコト",
      "Text": "そ、そいつは！？"
    },
    {
      "Name": "マコト",
      "Text": "……誰だ？"
    },
    {
      "Name": "ナギサ",
      "Text": "ヒフミさんです。"
    },
    {
      "Name": "マコト",
      "Text": "……名前を聞いても分からん！"
    },
    {
      "Name": "ナギサ",
      "Text": "ヒフミさんを知らないなんて……お里が知れますね。"
    },
    {
      "Name": "ナギサ",
      "Text": "では……お願いしますわ！ヒフミさん！"
    },
    {
      "Name": "ヒフミ",
      "Text": "へっ！？ナギサ様！？これはどういう状況で……えっ！？"
    },
    {
      "Name": "ヒフミ",
      "Text": "ええ～っ！？"
    }
  ],
  "DialogKR": [
    {
      "Text": "저녁 바다의 우쭐한 트리움비라투스"
    },
    {
      "Name": "마코토",
      "Text": "제군, 이 몸은 몹시 중대한 사실을 깨달았다."
    },
    {
      "Name": "이로하",
      "Text": "아, 네. 이부키, 어두우니까 발밑 조심해요."
    },
    {
      "Name": "이부키",
      "Text": "응! 이로하 선배도 조심해서 걷자!"
    },
    {
      "Name": "마코토",
      "Text": "이 섬에도 도착하고 나서, 만나는 상대에는 어떠한 패턴이 있다는 것이다!"
    },
    {
      "Name": "사츠키",
      "Text": "왜 사람들은 밤바다를 좋아하는 거야? 으스스하기만 한데…… 잠깐, 치아키! 떨어지지 마!"
    },
    {
      "Name": "치아키",
      "Text": "앗, 네! 그치만, 여기서 돌아가면 바로 노점가니까요."
    },
    {
      "Name": "마코토",
      "Text": "아마 궁금하겠지. 궁금해서 미칠 지경일 거야."
    },
    {
      "Name": "마코토",
      "Text": "……그렇지 않나?!"
    },
    {
      "Text": "[s1] \"으, 응!\""
    },
    {
      "Text": "[s2] \"되, 되게 궁금해!\""
    },
    {
      "Name": "마코토",
      "Text": "키시싯! 잘 물어보았다!"
    },
    {
      "Name": "마코토",
      "Text": "그건 바로! 적들이 나타나는 순서는 정해져 있다는 거다!"
    },
    {
      "Name": "마코토",
      "Text": "떠올려 봐라. 우리가 처음 마주친 녀석들이 누구였지?"
    },
    {
      "Name": "이로하",
      "Text": "……분명, 아비도스였죠."
    },
    {
      "Name": "마코토",
      "Text": "그래, 이름조차 거의 잊힌 군소 학원이지. 그다음에 나타난 것은……."
    },
    {
      "Name": "치아키",
      "Text": "발키리 경찰학원이었죠…… 공안국장이란 분, 계속 화난 표정이었는데, 기분이 나빴던 걸까요……?"
    },
    {
      "Name": "마코토",
      "Text": "음, 비록 총학생회의 개지만, 아비도스 같은 영락한 학원에 비할 바는 아니지. 그리고 직전에 만났던 것이 바로……."
    },
    {
      "Name": "사츠키",
      "Text": "백귀야행 연합학원이었네. 마코토 쨩이 하고 싶은 말은 알겠어."
    },
    {
      "Name": "마코토",
      "Text": "과연 명석하군, 사츠키! 그렇다! 백귀야행은 우리 게헨나에 비할 바는 못되지만, 상당한 규모의 학원!"
    },
    {
      "Name": "마코토",
      "Text": "즉, 우리의 상대는 점점 강해지고 있다는 거다! 이 추세라면, 백귀야행보다 강하면서, 우리 게헨나에 필적하는 강적……."
    },
    {
      "Name": "마코토",
      "Text": "숙적이라 불러 마지 못할 <그 학원>과 마주치는 것도 시간문제겠지!"
    },
    {
      "Name": "이부키",
      "Text": "숙적-?"
    },
    {
      "Name": "???",
      "Text": "오호호호~! 꽤 승승장구하고 있는 듯하군요~!"
    },
    {
      "Name": "???",
      "Text": "하지만, 그 연승도 거기까집니다~!"
    },
    {
      "Name": "마코토",
      "Text": "역시, 나타났나?!"
    },
    {
      "Name": "이로하",
      "Text": "뭔가요, 이 작위적인 전개……?"
    },
    {
      "Name": "나기사",
      "Text": "감히 품종도 모를 게헨나의 잡종 따위가, 하물며 소라게 따위가 풍파를 일으키고 있는 모양입니다만."
    },
    {
      "Text": "저녁 바다의\n우쭐한 트리움비라투스"
    },
    {
      "Name": "나기사",
      "Text": "<크랩 파이트>는 혈통의 스포츠. 그 사실을 뼈저리게 느끼게 해주죠."
    },
    {
      "Name": "마코토",
      "Text": "크으읏! 뚫린 입이라고 잘도 말하는구나!"
    },
    {
      "Name": "나기사",
      "Text": "분수를 모르는 것은 그쪽이죠. 천한 소라게 따위로 트리니티의 명名게를 이기겠다고요?"
    },
    {
      "Name": "나기사",
      "Text": "꿈도 크군요! 오호호호!"
    },
    {
      "Name": "미카",
      "Text": "우왓, 나기 쨩…… 무슨 일이야?"
    },
    {
      "Name": "미카",
      "Text": "스트레스 쌓인 거야? 상한 롤케이크라도 먹었어?"
    },
    {
      "Name": "세이아",
      "Text": "……."
    },
    {
      "Name": "세이아",
      "Text": "……!"
    },
    {
      "Name": "세이아",
      "Text": "……틀려요, 미카."
    },
    {
      "Name": "미카",
      "Text": "응?"
    },
    {
      "Name": "세이아",
      "Text": "진정한 친구라면, 여기서 그렇게 반응해서는 안 됩니다."
    },
    {
      "Name": "미카",
      "Text": "무슨 말……?"
    },
    {
      "Name": "세이아",
      "Text": "즉……."
    },
    {
      "Name": "세이아",
      "Text": "차 맛이 떨어집니다! 그 천박한 잡종을 내쫓으시죠!"
    },
    {
      "Name": "미카",
      "Text": "세이아 쨩?!"
    },
    {
      "Name": "나기사",
      "Text": "오호호호홋!"
    },
    {
      "Name": "미카",
      "Text": "나기 쨩까지?!"
    },
    {
      "Name": "미카",
      "Text": "……아아!! 진짜!! 이젠 나도 모르니까!!"
    },
    {
      "Name": "미카",
      "Text": "덤벼!! 분수도 모르는 잡종에게, 위아래를 알려주겠어!!"
    },
    {
      "Name": "마코토",
      "Text": "드디어 본색을 드러냈군, 티파티!!"
    },
    {
      "Name": "마코토",
      "Text": "비겁하게 삼 대 일이라!"
    },
    {
      "Name": "나기사",
      "Text": "삼 대 일? 훗……"
    },
    {
      "Name": "마코토",
      "Text": "뭐가 웃기지?"
    },
    {
      "Name": "나기사",
      "Text": "앞서 말했듯이, 크랩 파이트는 혈통의 스포츠……."
    },
    {
      "Name": "나기사",
      "Text": "즉, 우수한 자원을 배치하는 것만이 승리로 이어지죠."
    },
    {
      "Name": "나기사",
      "Text": "저희 트리니티가 내놓을 수 있는, 최고의 선수를 소개하죠!"
    },
    {
      "Name": "히후미",
      "Text": "엣…… 뭐, 뭐죠? 여기는 어디고?"
    },
    {
      "Name": "마코토",
      "Text": "그, 그 녀석은?!"
    },
    {
      "Name": "마코토",
      "Text": "……누구냐?"
    },
    {
      "Name": "나기사",
      "Text": "히후미 씨입니다."
    },
    {
      "Name": "마코토",
      "Text": "……히후미가 누구냐?"
    },
    {
      "Name": "나기사",
      "Text": "이래서 히후미 씨가 가진 각별한 사랑을 이해하지 못하는 사람이란……."
    },
    {
      "Name": "나기사",
      "Text": "자, 그러면 부탁드립니다! 히후미 씨!"
    },
    {
      "Name": "히후미",
      "Text": "네?! 나기사 님?! 지금 이게 무슨 상황이죠?! 어, 어어?!"
    },
    {
      "Name": "히후미",
      "Text": "에에에엣?!?!"
    }
  ],
