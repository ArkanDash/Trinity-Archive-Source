{
  "TitleJP": "ライフ・オブ・ビス丸（２）",
  "TitleKR": "라이프 오브 비스마루 2",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "体当たりをして乗り込んできたトライデントを退けていくマコトたち。勢いのまま、トライデントをハルピュイア号に押し戻すことに成功する。しかし喜んでいるのも束の間、トライデントの本隊が到着し、圧倒的で無慈悲な艦砲射撃の前に、なす術なくビス丸は水底へと沈んでいく。その刹那、海へ投げ出されそうになったマコトを助けたのは、喧嘩中だったはずのイロハだった。",
  "DescKR": "트라이던트의 충각 돌격에 이어 본 함대까지 도착하자, 비스마루는 결국 바닷속으로 가라앉는다. 이로하는 물에 빠질 뻔한 마코토를 붙잡아준다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Name": "マコト",
      "Text": "ヨーホホ！見たか、[ruby=マン・オブ・パンデモニウム]我が万魔船の底[/ruby]力を！！"
    },
    {
      "Name": "トライデントの部員A",
      "Text": "こいつら、普通の海賊じゃないぞ！？"
    },
    {
      "Name": "トライデントの部員B",
      "Text": "特にあの銀髪の船長……只者じゃねえ、スミカも一撃だったけど！？"
    },
    {
      "Name": "トライデントの部員A",
      "Text": "あいつって結構強くなかった……？"
    },
    {
      "Name": "スミカ",
      "Text": "後退！後退です！"
    },
    {
      "Name": "トライデントの部員A",
      "Text": "あれ？ピンピンしてる。"
    },
    {
      "Name": "トライデントの部員B",
      "Text": "さっき倒れてたよな……？ちゃんと見たぞ。"
    },
    {
      "Name": "スミカ",
      "Text": "いきなり本気を見せるわけないでしょう、当然です！本気は隠せば隠すほどいいんですから！"
    },
    {
      "Name": "トライデントの部員A",
      "Text": "なんかイイ感じに言ってるけど、要はテキトーにやったってことだろ……？"
    },
    {
      "Name": "トライデントの部員B",
      "Text": "本気出せば勝てるってこと？"
    },
    {
      "Name": "スミカ",
      "Text": "……正直、あの人の相手はちょっと自信ないですね。"
    },
    {
      "Name": "スミカ",
      "Text": "そうですね……体感的に、副部長の相手をしてるような感じ？というか。"
    },
    {
      "Name": "トライデントの部員A",
      "Text": "はっ？そんなんただの化け物じゃん！"
    },
    {
      "Name": "トライデントの部員B",
      "Text": "あっ、囲まれるっ！逃げるぞ！！"
    },
    {
      "Name": "マコト",
      "Text": "我がビス丸に土足で上がりおって……無事に帰れると思うか？"
    },
    {
      "Name": "マコト",
      "Text": "一人も残さずサメの餌食にしてやれ！"
    },
    {
      "Name": "チアキ",
      "Text": "あのぉ……マコト先輩が戦ってる姿、初めて見たんですが……。"
    },
    {
      "Name": "チアキ",
      "Text": "にしても強すぎませんか……？"
    },
    {
      "Name": "サツキ",
      "Text": "あれはトランス状態よ！"
    },
    {
      "Name": "チアキ",
      "Text": "えっ？催眠の時のアレ、ですか？"
    },
    {
      "Name": "サツキ",
      "Text": "そう。今のマコトちゃんは、自分を極悪非道な海賊船長と信じ込んでるわ。"
    },
    {
      "Name": "サツキ",
      "Text": "そのおかげでいつも以上の力を出せてるの。"
    },
    {
      "Name": "チアキ",
      "Text": "思い込みだけで強くなるんですか？"
    },
    {
      "Name": "サツキ",
      "Text": "もちろん。心理状態は身体に影響を及ぼすって、スポーツ分野ではすでに常識よ。"
    },
    {
      "Name": "サツキ",
      "Text": "私の催眠術でみんなが強くなるのも、それの応用ってわけ。"
    },
    {
      "Name": "チアキ",
      "Text": "なるほど！よく分かりましたっ！"
    },
    {
      "Name": "イロハ",
      "Text": "一気に信憑性なくなりましたけど！？"
    },
    {
      "Name": "サツキ",
      "Text": "でも、普通は自己暗示でここまでの効果は出ないわ……\nさすがマコトちゃんってところかしら。"
    },
    {
      "Name": "イロハ",
      "Text": "……バカ単純ってことではなく？"
    },
    {
      "Name": "海賊A",
      "Text": "奴らが逃げたぞ！"
    },
    {
      "Name": "海賊B",
      "Text": "勝った！！"
    },
    {
      "Name": "海賊たち",
      "Text": "キャプテン！マコト！キャプテン！マコト！"
    },
    {
      "Name": "マコト",
      "Text": "ヨーホホ！見たかこれが我々の……！"
    },
    {
      "Name": "マコト",
      "Text": "なっ、なんだこの揺れは！？"
    },
    {
      "Name": "海賊A",
      "Text": "た、大変ですキャプテンマコト！"
    },
    {
      "Name": "海賊A",
      "Text": "敵の増員です！機関銃じゃなく本物の艦砲です！"
    },
    {
      "Name": "マコト",
      "Text": "増員！？ここは遠洋だぞ？どこから増員が来るというのだ！？"
    },
    {
      "Text": "[s1] \"なんだか既視感が……。\""
    },
    {
      "Text": "[s2] \"見たことあるような流れだ。\""
    },
    {
      "Name": "海賊B",
      "Text": "水平線向こうに！奴らが現れました！"
    },
    {
      "Name": "海賊B",
      "Text": "艦隊……大規模な艦隊です！"
    },
    {
      "Name": "海賊B",
      "Text": "トライデントのメイン艦隊が到着しました！！"
    },
    {
      "Name": "マコト",
      "Text": "卑怯な奴らめ……援軍を呼ぶだと？"
    },
    {
      "Name": "マコト",
      "Text": "みな、応戦だ！あいつらも全員、サメの餌食にしてやれ！！"
    },
    {
      "Name": "海賊A",
      "Text": "無理です！こっちの大砲じゃそもそも届きません！"
    },
    {
      "Name": "海賊B",
      "Text": "巡視船とはワケが違います！こっちの砲弾が効くわけないっす！？"
    },
    {
      "Name": "マコト",
      "Text": "ええいっ！また泣き言か！"
    },
    {
      "Name": "マコト",
      "Text": "根性のない奴らだ！私がやる！"
    },
    {
      "Name": "マコト",
      "Text": "うあっ！？滑っ……。"
    },
    {
      "Text": "[ns3] \"あっ、マコト！？\""
    },
    {
      "Text": "[ns4] マコトに向かって走る。"
    },
    {
      "Text": "[ns5] （届か、ない……！）"
    },
    {
      "Text": "[ns6] （このままじゃマコトが海に……！）"
    },
    {
      "Name": "イロハ",
      "Text": "……何やってるんですか！！"
    },
    {
      "Name": "イロハ",
      "Text": "気は確かですか！？海に落ちるとこでしたよ！？"
    },
    {
      "Name": "マコト",
      "Text": "い、イロハ？"
    },
    {
      "Name": "マコト",
      "Text": "お前は私を、嫌ってるとばかり……。"
    },
    {
      "Name": "イロハ",
      "Text": "……ああっもう！"
    },
    {
      "Name": "イロハ",
      "Text": "本物のバカなんです！？\nこんな状況でそんなこと気にしてる場合ですか！？"
    },
    {
      "Name": "イロハ",
      "Text": "というか、マコト先輩カナヅチですよね！？"
    },
    {
      "Name": "マコト",
      "Text": "なっ、どうやってそれを！？マコト様最大の秘密をっ！？"
    },
    {
      "Name": "イロハ",
      "Text": "水泳の授業全部休んでるのに、知らないわけないでしょうが！！"
    },
    {
      "Name": "イロハ",
      "Text": "それに私はそもそも……！"
    },
    {
      "Name": "イロハ",
      "Text": "先に謝ってくるような先輩、なんて……。"
    },
    {
      "Name": "海賊A",
      "Text": "また着弾しました！"
    },
    {
      "Name": "海賊B",
      "Text": "し、沈んでしまう……！！"
    },
    {
      "Text": "（そしてビス丸は海の底へ沈んでいった）"
    }
  ],
  "DialogKR": [
    {
      "Name": "마코토",
      "Text": "요호호! 보았느냐! 우리 [ruby=맨 오브 판데모니움]만마선[/ruby]의 저력을!"
    },
    {
      "Name": "트라이던트 부원 A",
      "Text": "이 녀석들, 평범한 해적이 아닌데?!"
    },
    {
      "Name": "트라이던트 부원 B",
      "Text": "특히 저 은발 선장은 보통내기가 아니야! 스미카도 한 방에 쓰러졌어!"
    },
    {
      "Name": "트라이던트 부원 A",
      "Text": "걔, 꽤 강하지 않았나……?"
    },
    {
      "Name": "스미카",
      "Text": "후퇴, 후퇴입니다!"
    },
    {
      "Name": "트라이던트 부원 A",
      "Text": "어라, 멀쩡한데?"
    },
    {
      "Name": "트라이던트 부원 B",
      "Text": "분명히 쓰러지는 걸 봤는데……?"
    },
    {
      "Name": "스미카",
      "Text": "당연하죠! 이 바다에서 무슨 일이 생길 줄 알고, 함부로 전력을 드러내나요! 힘은 숨길수록 좋은 법이라고요!"
    },
    {
      "Name": "트라이던트 부원 A",
      "Text": "그럴싸하게 말하지만, 결국 대충 싸웠다는 거잖아……."
    },
    {
      "Name": "트라이던트 부원 B",
      "Text": "진심으로 싸우면 이길 수 있다는 뜻?"
    },
    {
      "Name": "스미카",
      "Text": "……솔직히 저 사람 상대로는 살~짝 자신 없네요."
    },
    {
      "Name": "스미카",
      "Text": "체감상, 그렇네요. 부부장님을 적으로 만난 느낌이라 할까요?"
    },
    {
      "Name": "트라이던트 부원 A",
      "Text": "뭐? 그건 그냥 괴물이잖아?!"
    },
    {
      "Name": "트라이던트 부원 B",
      "Text": "앗, 포위해 온다! 도망쳐!"
    },
    {
      "Name": "마코토",
      "Text": "감히 이 몸의 기함, 비스마루에 올라타고 무사히 돌아가려 하다니!"
    },
    {
      "Name": "마코토",
      "Text": "쫓아서 한 놈도 빠짐없이 상어밥으로 만들어줘라!"
    },
    {
      "Name": "치아키",
      "Text": "……저요, 마코토 선배가 싸우는 모습 자체를 처음 보기는 하는데요……."
    },
    {
      "Name": "치아키",
      "Text": "아무리 그래도 너무 강하지 않나요……?"
    },
    {
      "Name": "사츠키",
      "Text": "저건, 트랜스 상태야!"
    },
    {
      "Name": "치아키",
      "Text": "네? 최면할 때 그거요?"
    },
    {
      "Name": "사츠키",
      "Text": "맞아. 지금 마코토 쨩은 자신을 흉악무도한 해적 선장이라 믿어 의심치 않고 있어."
    },
    {
      "Name": "사츠키",
      "Text": "그 암시 덕분에, 평소 이상의 힘을 낼 수 있는 거야."
    },
    {
      "Name": "치아키",
      "Text": "고작 믿는 것만으로 강해지는 건가요?"
    },
    {
      "Name": "사츠키",
      "Text": "물론이지. 심리 상태가 신체에 영향을 끼친다는 것은 스포츠 분야에서는 이미 상식이야."
    },
    {
      "Name": "사츠키",
      "Text": "내 최면술로 부하들이 강해지는 것도, 그 응용이지."
    },
    {
      "Name": "치아키",
      "Text": "아하! 단번에 이해했습니다!"
    },
    {
      "Name": "이로하",
      "Text": "아니! 단번에 사라졌는데요, 신뢰성!"
    },
    {
      "Name": "사츠키",
      "Text": "하지만, 고작 자기암시 정도로 이렇게 효과가 나오지는 않을 텐데…… 역시 마코토 쨩이네."
    },
    {
      "Name": "이로하",
      "Text": "……단순 무식한 바보라는 뜻 아닌가요?"
    },
    {
      "Name": "해적 A",
      "Text": "놈들이 도망갔다!"
    },
    {
      "Name": "해적 B",
      "Text": "이겼다!"
    },
    {
      "Name": "해적들",
      "Text": "캡틴! 캡틴! 캡틴!"
    },
    {
      "Name": "마코토",
      "Text": "요호호호! 보았느냐! 이게 바로……!"
    },
    {
      "Name": "마코토",
      "Text": "뭐, 뭐냐?! 이 엄청난 진동은?!"
    },
    {
      "Name": "해적 A",
      "Text": "크, 큰일입니다, 캡틴!"
    },
    {
      "Name": "해적 A",
      "Text": "적의 증원입니다! 기관총이 아니라, 진짜 함포입니다!"
    },
    {
      "Name": "마코토",
      "Text": "증원이라니?! 여기는 바다 한복판이란 말이다! 어디서 증원이 올 수 있단 말이냐?!"
    },
    {
      "Text": "[s1] \"뭔가, 데자뷔가…….\""
    },
    {
      "Text": "[s2] \"본 적 있는 흐름이다.\""
    },
    {
      "Name": "해적 B",
      "Text": "수평선 너머로! 나타났습니다!"
    },
    {
      "Name": "해적 B",
      "Text": "함대, 대규모 함대입니다!"
    },
    {
      "Name": "해적 B",
      "Text": "트라이던트 선도부의 본 함대가 도착했습니다!"
    },
    {
      "Name": "마코토",
      "Text": "비열한 녀석들! 원군을 부르다니!"
    },
    {
      "Name": "마코토",
      "Text": "다들 대응 사격하라! 저 함선들 모두 상어밥으로 만들어줘라!"
    },
    {
      "Name": "해적 A",
      "Text": "불가능해요! 저희 대포로는 아예 사거리가 안 나와요!"
    },
    {
      "Name": "해적 B",
      "Text": "순찰선이랑은 체급부터 다릅니다! 대포알이 먹힐 리가 없어요!"
    },
    {
      "Name": "마코토",
      "Text": "에에잇! 또 우는 소리냐!"
    },
    {
      "Name": "마코토",
      "Text": "근성 부족한 녀석들! 이 몸이 직접 나서겠다!"
    },
    {
      "Name": "마코토",
      "Text": "으앗?! 균형이……."
    },
    {
      "Text": "[ns3] \"앗, 마코토?!\""
    },
    {
      "Text": "[ns4] 마코토를 향해 달린다."
    },
    {
      "Text": "[ns5] (거리가, 안 닿아……!)"
    },
    {
      "Text": "[ns6] (이대로면 마코토가 물에……!)"
    },
    {
      "Name": "이로하",
      "Text": "……뭐하는 거에요!"
    },
    {
      "Name": "이로하",
      "Text": "제정신이에요?! 바다에 빠질 뻔했다고요!"
    },
    {
      "Name": "마코토",
      "Text": "이, 이로하?"
    },
    {
      "Name": "마코토",
      "Text": "너는 나를 미워한다 생각했는데……."
    },
    {
      "Name": "이로하",
      "Text": "……아! 진짜!"
    },
    {
      "Name": "이로하",
      "Text": "이미 바보면서 얼마나 더 바보가 될 셈인가요?! 이런 상황에 그런 걸 따질 거 같아요?!"
    },
    {
      "Name": "이로하",
      "Text": "게다가 마코토 선배, 맥주병이잖아요!"
    },
    {
      "Name": "마코토",
      "Text": "뭣?! 그걸 어떻게?! 철저히 숨기고 있었는데?!"
    },
    {
      "Name": "이로하",
      "Text": "수영 수업을 전부 빼먹으면, 모르고 싶어도 알거든요?!"
    },
    {
      "Name": "이로하",
      "Text": "그리고, 저는 애초에……!"
    },
    {
      "Name": "이로하",
      "Text": "먼저 사과하는 선배 모습 같은 건……!"
    },
    {
      "Name": "해적 A",
      "Text": "또 착탄!"
    },
    {
      "Name": "해적 B",
      "Text": "가, 가라앉는다!"
    },
    {
      "Text": "(그렇게, 비스마루는 바닷속으로 가라앉았다.)"
    }
  ],
