{
  "TitleJP": "海賊、忍者、万魔殿",
  "TitleKR": "해적, 닌자, 만마전",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "海賊にすっかり夢中になったイブキは「忍者海賊万魔殿」という新たなコンセプトを提案する。そうしてマコトとイブキがたわむれる裏で、イロハはチアキにこっそり謝るのだった。",
  "DescKR": "해적에 푹 빠진 이부키가 '닌자 해적 만마전'이라는 컨셉을 제안한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "後日談その2;海賊、忍者、万魔殿"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "よっほっほ！"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "イブキはおそろしー海賊だー！"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "イブキがキャプテンで、くまさんが副キャプテン……。"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "そしてニンペロさんは忍者！"
    },
    {
      "Text": "[s1] \"忍者……？\""
    },
    {
      "Text": "[s2] \"先生は？\""
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "あ、先生！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "海賊のこと、結構気に入ったようですねイブキ。"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "うん！あのね、海賊はすごくカッコイイの！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "カッコイイのかは分からないですけど……イブキが好きならよかったです。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "忍者に続き今度は海賊か。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "もちろん、一番はマコト様だろうがな！キキキキッ！"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "忍者……海賊……マコト先輩……？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "全部好きってことだ！！！"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "「好き」に優劣などない！！！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "あ、今不安になって無理やりまとめましたね。"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "あっ。"
    },
    {
      "CharacterName": 2290663045,
      "Name": "イブキ",
      "Text": "いいこと思いついた！忍者海賊万魔殿はどう？"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "よい！！！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "分かってないのに適当な返事しないでください。"
    },
    {
      "CharacterName": 423514476,
      "Name": "マコト",
      "Text": "イブキの提案がよくないわけがないだろう！！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "いやまあ、そうですけど……。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "忍者海賊万魔殿って……怪しすぎませんか？"
    },
    {
      "Text": "[ns3] \"忍者に、海賊……？\""
    },
    {
      "Text": "[ns4] \"イブキは天才だった？\""
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "……？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "私が世間についていけてないのでしょうか？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あははっ！イロハちゃんは空気読まない派だもんね。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "その反対だと思ってますけど……？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "ん～そうかなあ？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "う……チアキ？"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "あはは！ごめんごめん、でもイロハちゃんが不安そうな姿、珍しいからつい。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "あの……チアキ。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "え？"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "すみませんでした。"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "その、不安にさせましたよね。船でのこと。"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "……！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "今の顔、今の顔もう一回だけ！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "ああっ、もう！今のなしです！"
    },
    {
      "CharacterName": 137522584,
      "Name": "チアキ",
      "Text": "もう一回だけ～～！お願い！撮らせて～～！！"
    },
    {
      "CharacterName": 3009492682,
      "Name": "イロハ",
      "Text": "二度とするかっ！！"
    }
  ],
  "DialogKR": [
    {
      "Text": "후일담;해적, 닌자, 만마전"
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "요호호!"
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "이부키는 무시무시한 해적이다!"
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "이부키가 선장이고, 곰돌이 씨가 부선장……."
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "그리고 닌페로 씨는 닌자야!"
    },
    {
      "Text": "[s1] \"닌자……?\""
    },
    {
      "Text": "[s2] \"선생님은?\""
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "아, 선생님!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "해적이 꽤 마음에 들었나 보네요, 이부키."
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "응! 있지! 해적은 되게 멋있다!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "멋있는지는…… 잘 모르겠지만, 이부키가 좋아하니 다행이네요."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "닌자에 이어서, 이번에는 해적인가."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "물론, 일등은 이 몸이겠지만 말이야! 키시싯!"
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "닌자…… 해적…… 마코토 선배……?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "전부 좋다는 걸로!!!!"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "좋아하는 것에 우열은 없다!!!!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아, 지금 밀려날까 봐 억지로 정리했네요."
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "아."
    },
    {
      "CharacterName": 2290663045,
      "Name": "이부키",
      "Text": "좋은 생각 났어! 닌자 해적 만마전은 어때~?"
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "좋다!!!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "무슨 말인지도 모르면서 대답하지 마세요."
    },
    {
      "CharacterName": 423514476,
      "Name": "마코토",
      "Text": "이부키의 제안이 나쁜 것일 리 없지 않느냐!!!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아니, 뭐, 그렇기는 하지만……."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "닌자 해적 만마전이라니…… 너무 수상한 집단 아닌가요?"
    },
    {
      "Text": "[ns3] \"닌자에, 해적……? \""
    },
    {
      "Text": "[ns4] \"이부키는 천재인가……?\""
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "혹시 제가 세상을 못 따라가는 건가요?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아하하! 이로하 쨩은 분위기를 읽지 않으니까."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "저는 그 반대라 생각했는데요……?"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "으음~ 과연 그럴까~?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "으…… 치아키."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "아핫! 미안! 그치만, 이로하 쨩이 초조해하는 건 보기 드물어서 무심코."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "……저, 치아키."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "응?"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "미안해요."
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "그, 불안하게 했죠? 배에서 여러 일들 때문에."
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "……!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "지금 얼굴! 지금 얼굴 한 번만 찍게 해줘!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아, 됐어요! 이걸로 끝이에요!"
    },
    {
      "CharacterName": 137522584,
      "Name": "치아키",
      "Text": "한 번만~!"
    },
    {
      "CharacterName": 3009492682,
      "Name": "이로하",
      "Text": "아, 진짜! 다시는 사과 같은 거 안 할 거예요!"
    }
  ],
