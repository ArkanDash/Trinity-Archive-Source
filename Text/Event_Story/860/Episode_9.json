{
  "TitleJP": "ライフ・オブ・ビス丸（１）",
  "TitleKR": "라이프 오브 비스마루 1",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "装備が古く練度も低い万魔船のクルーたち。しかしイブキがその場で計算して作った弾道表のおかげで大砲の命中精度が大幅に向上する。そしてマコトの気合に応えるように、万魔船一行は迎撃に立ち上がる。思いがけぬ反撃にあったトライデントは取り乱し、船を使った体当たりを敢行するのだった。",
  "DescKR": "마코토의 기합으로 응전하는 만마전, 그리고 비스마루. ",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第8話;ライフ・オブ・ビス丸"
    },
    {
      "CharacterName": 3282390374,
      "Name": "海賊A",
      "Text": "全部外れました！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "ちっ！小さくてすばしっこいな。"
    },
    {
      "CharacterName": 3425493620,
      "Name": "チアキ",
      "Text": "というよりは私たちが下手なだけな気がします！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "外れたなら当たるまで撃てばいい！続けろ！"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "ううん……。"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "あっ！"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "これをーこうしたらー……。"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "じゃじゃーん！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "まだだ、もう一度だ！"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "マコト先輩、マコト先輩！"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "あっ、今はキャプテンだった……！"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "キャプテンマコト！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "ん？どうしたイブキ？"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "……おお！？これはもしや艦砲の弾道表か？"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "うん！これで悪い人たちお説教！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "よくやったイブキ！でも……どこでこれを？"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "イブキが作った！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "……この一瞬で、自分で計算しただと……！？"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "うん！こういう大砲はあんまりライフリングがないから、正確には計算できないけど……。"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "照準を調整した感じ、変わる距離が同じだったの！\nだからどんな角度で撃てば当たりやすくなるか、計算してみたんだ！"
    },
    {
      "CharacterName": 1299199857,
      "Name": "イブキ",
      "Text": "どう？イブキえらい？賢い？"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "分かってはいたが……本当にゾッとするほどの才能だ……！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "よくやったイブキ！諸君、全員注目！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "奴らをギャフンと言わせる時が来た！\n指示に従って、全ての大砲の角度を調整せよ！"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "うわっ、あいつら急に射撃の腕が上がった！？"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "誰か前装式の有効射程知ってる人～？"
    },
    {
      "CharacterName": 618624221,
      "Name": "トライデントの部員B",
      "Text": "そんな化石の射程なんて誰が知ってるのよ？"
    },
    {
      "CharacterName": 2908012040,
      "Name": "トライデントの部員C",
      "Text": "あっちの口径の方が大きいし、射程距離の戦いだと不利かも……？"
    },
    {
      "CharacterName": 618624221,
      "Name": "トライデントの部員B",
      "Text": "いや、でもこっちは現代の兵器だよ！？"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "でも機関銃じゃ効かないでしょ！こっちは一撃貰ったら沈没だよ！？"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "キャプテン！なんとかしてよ！"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "……えっ？私ですか？"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "いえいえキャプテンだなんて、そんなそんな！\n私たちは各々の役割をこなしてるだけです！"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "おい、逃げたぞ！捕まえろ！"
    },
    {
      "CharacterName": 618624221,
      "Name": "トライデントの部員B",
      "Text": "一人だけとんずらするつもり！？"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "ちょ、ちょっとやめてください！私キャプテンですけど！？\nこれ反乱ですよね！？"
    },
    {
      "CharacterName": 2908012040,
      "Name": "トライデントの部員C",
      "Text": "……体当たりでいこう。"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "……え？"
    },
    {
      "CharacterName": 2908012040,
      "Name": "トライデントの部員C",
      "Text": "手元の武器じゃ無理でしょ？あっちとの射程差も分からないし。"
    },
    {
      "CharacterName": 2908012040,
      "Name": "トライデントの部員C",
      "Text": "つまり一番の[ruby=・   ・]武器[/ruby]をゼロ距離でぶち込んじゃえばいいんですよ。"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "……いやなんでそうなるんです？"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "いいや！それが正しいかもよ！？"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "今も昔も、海戦は体当たりが一番だし！"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "昔のことは知りませんが、今は違います……。"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "え？私だけが常識人みたいな、そんな状況じゃないですよね？"
    },
    {
      "CharacterName": 618624221,
      "Name": "トライデントの部員B",
      "Text": "……合ってるよ。"
    },
    {
      "CharacterName": 618624221,
      "Name": "トライデントの部員B",
      "Text": "「速度×質量＝パワー」！！"
    },
    {
      "CharacterName": 618624221,
      "Name": "トライデントの部員B",
      "Text": "さあ！全速前進ー！！"
    },
    {
      "CharacterName": 2069141105,
      "Name": "トライデントの部員A",
      "Text": "ヨーソロー！"
    },
    {
      "CharacterName": 1603758886,
      "Name": "スミカ",
      "Text": "……。"
    },
    {
      "CharacterName": 3425493620,
      "Name": "チアキ",
      "Text": "うああああっ！？"
    },
    {
      "CharacterName": 696649018,
      "Name": "イロハ",
      "Text": "突っ込んできた！？バカですか！？"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "なっ！？このビス丸に穴がっ！？"
    },
    {
      "CharacterName": 696649018,
      "Name": "イロハ",
      "Text": "いつの間に名前まで……。"
    },
    {
      "CharacterName": 3282390374,
      "Name": "海賊A",
      "Text": "キャプテン！奴ら、こっちの船を奪おうとしてます！！"
    },
    {
      "CharacterName": 3992058048,
      "Name": "海賊B",
      "Text": "船に開いた穴から侵入を！！"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "これは……[ruby=マン・オブ・パンデモニウム]我が万魔船も、[/ruby]見くびられたものだ。"
    },
    {
      "CharacterName": 2842121518,
      "Name": "マコト",
      "Text": "お前らっ！！存分にもてなしてやれっ！！！！"
    }
  ],
  "DialogKR": [
    {
      "Text": "제8화;라이프 오브 비스마루"
    },
    {
      "CharacterName": 3282390374,
      "Name": "해적 A",
      "Text": "전부 빗나갔습니다!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "칫! 조그만 배로 요리조리 잘도 피하는군!"
    },
    {
      "CharacterName": 3425493620,
      "Name": "치아키",
      "Text": "아하하! 그보다 그냥 저희가 못 맞추는 거 같지만요!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "빗나가면 맞을 때까지 쏘면 된다! 다시 장전하라!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "으응……!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "아!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "이거를, 이렇게 하면은~"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "짜안!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "아직, 아직이다! 다시 사격한다! 장전!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "마코토 선배! 마코토 선배!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "아, 아차. 지금은 캡틴이지……!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "캡틴 마코토!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "응? 무슨 일이지, 이부키?"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "……오오?! 이건, 설마?! 함포의 탄도 제원표인가?!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "응! 이걸로 나쁜 사람들을 혼내주는 거야!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "장하다! 이부키! 하지만…… 이런 것을 도대체 어디서?"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "이부키가 만들었어!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "……그 짧은 사이에, 직접 계산했다고……?!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "응! 원래 이런 대포에는 강선이 없어서, 이렇게 정확하게 계산할 수 없는데……."
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "신기하게 포각을 조정할 때마다 변하는 거리가 균일했어! 그래서 어떤 각도로 쏘면 맞출 확률이 올라갈지 계산했어!"
    },
    {
      "CharacterName": 1299199857,
      "Name": "이부키",
      "Text": "어때? 이부키, 똑똑해? 장해?"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "알고는 있었지만, 정말 오싹할 정도의 재능이군……!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "잘해주었다! 이부키! 선원들, 모두 주목!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "이제 제대로 한 방 먹여줄 때가 됐다! 이 몸의 지시에 따라, 모든 대포의 각도를 재조정한다!"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "우왓! 저 녀석들, 갑자기 사격이 정밀해졌는데?!"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "누구 전장식 함포 유효 사거리 아는 사람?"
    },
    {
      "CharacterName": 618624221,
      "Name": "트라이던트 부원 B",
      "Text": "그런 구닥다리 유물을 어떻게 알아!"
    },
    {
      "CharacterName": 2908012040,
      "Name": "트라이던트 부원 C",
      "Text": "저쪽 구경이 더 크니까, 사거리 싸움으로 가면 불리한가……?"
    },
    {
      "CharacterName": 618624221,
      "Name": "트라이던트 부원 B",
      "Text": "아니, 아무리 그래도 우리는 현대 병기라고?!"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "그치만 우리 기관총으로는 유효타가 안 나잖아! 반면 이쪽은 한 발만 맞아도 침몰이라고?!"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "캡틴! 뭐라도 좀 해봐!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "……네? 혹시 저 말인가요?"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "아뇨, 캡틴이라뇨. 당치도 않아요. 저희는 저마다 다른 역할을 수행하고 있을 뿐."
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "야, 저 자식, 튄다! 잡아!"
    },
    {
      "CharacterName": 618624221,
      "Name": "트라이던트 부원 B",
      "Text": "어디서 혼자 꼬리 빼려고?!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "자, 잠깐만요! 잡지 마세요?! 저 캡틴이라고요?! 이거 선상반란이거든요?!"
    },
    {
      "CharacterName": 2908012040,
      "Name": "트라이던트 부원 C",
      "Text": "……충각."
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "……네?"
    },
    {
      "CharacterName": 2908012040,
      "Name": "트라이던트 부원 C",
      "Text": "우리 무기로는 유효타가 안 나잖아요? 상대의 사거리도 모르고."
    },
    {
      "CharacterName": 2908012040,
      "Name": "트라이던트 부원 C",
      "Text": "그러면 가장 큰 포탄을, 지근거리에서 때려 박으면 되잖아요?"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "……아니, 그게 왜 그렇게 돼요?"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "아니야! 저 말이 맞을지도 몰라!"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "예나 지금이나 해전은 충각이 제일이야!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "예전은 몰라도, 지금은 아니거든요……."
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "저 혼자 상식인, 그런 상황은 아니죠? 네?"
    },
    {
      "CharacterName": 618624221,
      "Name": "트라이던트 부원 B",
      "Text": "……맞아."
    },
    {
      "CharacterName": 618624221,
      "Name": "트라이던트 부원 B",
      "Text": "<속도 X 질량 = 파워>-!!"
    },
    {
      "CharacterName": 618624221,
      "Name": "트라이던트 부원 B",
      "Text": "기관, 양현전속!"
    },
    {
      "CharacterName": 2069141105,
      "Name": "트라이던트 부원 A",
      "Text": "좋아, 가보자고!"
    },
    {
      "CharacterName": 1603758886,
      "Name": "스미카",
      "Text": "……."
    },
    {
      "CharacterName": 3425493620,
      "Name": "치아키",
      "Text": "우와아아아앗?!"
    },
    {
      "CharacterName": 696649018,
      "Name": "이로하",
      "Text": "들이박았다고요?! 바보들인가요?!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "뭣?! 이 몸의 비스마루에 구멍이?!"
    },
    {
      "CharacterName": 696649018,
      "Name": "이로하",
      "Text": "어느 틈에 이름까지……."
    },
    {
      "CharacterName": 3282390374,
      "Name": "해적 A",
      "Text": "캡틴! 저 녀석들, 도선하려 합니다!"
    },
    {
      "CharacterName": 3992058048,
      "Name": "해적 B",
      "Text": "배에 난 구멍으로 침입하고 있어요!"
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "이거…… 우리 [ruby=맨 오브 판데모니움]만마선[/ruby]이 어지간히도 얕보인 모양이군."
    },
    {
      "CharacterName": 2842121518,
      "Name": "마코토",
      "Text": "앓!!! 애들아, 손님맞이를 해줘라!!!"
    }
  ],
