    {
      "Name": "이부키",
      "Text": "아, 고맙습니다, 이로하 선배! 아직 이부키 힘으로는 못 들겠어……."
    },
    {
      "Name": "이부키",
      "Text": "그다음에는 대포알! 그리고 이렇게 노끈 뭉치를 넣어서 대포알을 고정하고……."
    },
    {
      "Name": "이부키",
      "Text": "마지막에 점화구에 화약을 넣고, 불을 붙이는 거야!"
    },
    {
      "Name": "이로하",
      "Text": "오, 오오…… 대단히 잘 아네요, 이부키?"
    },
    {
      "Name": "이부키",
      "Text": "응! 잔뜩 공부했으니까!"
    },
    {
      "Name": "해적 A",
      "Text": "……."
    },
    {
      "Name": "해적 B",
      "Text": "……."
    },
    {
      "Name": "마코토",
      "Text": "선원들이여! 장전은 되었나!"
    },
    {
      "Name": "이로하",
      "Text": "네, 뭐……."
    },
    {
      "Name": "마코토",
      "Text": "대답이 작다!"
    },
    {
      "Name": "치아키",
      "Text": "네, 캡틴!"
    },
    {
      "Name": "이부키",
      "Text": "이제 붙을 붙이면 빵야! 하고 발사될 거야!"
    },
    {
      "Name": "마코토",
      "Text": "과연, 훌륭하다, 훌륭해!"
    },
    {
      "Name": "마코토",
      "Text": "초탄은 이 몸의 구령에 맞춰 일제 사격한다!"
    },
    {
      "Name": "마코토",
      "Text": "목표는 저 가증스러운 해군 놈들의 배!"
    },
    {
      "Name": "해적 A",
      "Text": "의미 없는 짓이야."
    },
    {
      "Name": "해적 B",
      "Text": "될 리가 없는데, 뭘 저렇게 바보처럼……."
    },
    {
      "Name": "마코토",
      "Text": "요호호! 보고 있어라!"
    },
    {
      "Name": "마코토",
      "Text": "이 몸이 기적을 보여줄 테니까 말이다!"
    },
    {
      "Name": "마코토",
      "Text": "준비……!"
    },
    {
      "Name": "마코토",
      "Text": "───발사!!!"
    },
    {
      "Name": "이로하",
      "Text": "……하아?"
    },
    {
      "Name": "이로하",
      "Text": "무슨 말도 안 되는……?"
    },
    {
      "Name": "치아키",
      "Text": "와아! 엄청난 소리!"
    },
    {
      "Name": "이부키",
      "Text": "이부키도 쏴볼래! 에잇!"
    },
    {
      "Name": "마코토",
      "Text": "요호호! 역시 기합 문제였군!"
    },
    {
      "Name": "해적 A",
      "Text": "……대포가, 쏴졌다?"
    },
    {
      "Name": "해적 B",
      "Text": "그날 이후로, 다시는 나가지 않았던 대포가……."
    },
    {
      "Name": "마코토",
      "Text": "반격은 이제 시작이다! 선원들! 다시 장전하라!"
    },
    {
      "Name": "해적들",
      "Text": "아이 아이!!! 캡틴!!!"
    }
  ],
