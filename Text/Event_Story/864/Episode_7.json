{
  "TitleJP": "弱い者の話は聞かない",
  "TitleKR": "약자의 말은 듣지 않는다",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "強豪たちが一台、また一台と脱落していく。快進撃を続けていたC&Cチームも、トキが操る同型戦車とのミラーマッチで相打ちとなってしまう。そんな中、次の標的へと向かっていた183号の3人は思わぬ相手に遭遇する。",
  "DescKR": "강호들이 하나씩 트랙에서 사라져간다. 다음 표적으로 향하던 183호는 뜻밖의 상대와 마주친다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第5話;弱い者の話は聞かない"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "おおーっと！これはどういうことでしょう！\nヴァルキューレ警察学校チーム、派手な爆発と共に脱落です～！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "優勝なんて朝飯前って感じだったんですけどね～"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "イブキは朝ごはん食べたよー！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "戦車戦の基本はヒットアンドアウェイ！\nスタート地点付近で得点を重ねていましたが、\n奇襲攻撃を許してしまいましたね！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "今回初出場の183号特別クラスは、これが初撃破です！\nおめでとうございます～！！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "それでは、再び現場の様子を見る前に――"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "先生、締めをお願いします！"
    },
    {
      "Text": "[ns] \"チャンネルは、そのままだよ！\""
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "ありがとうございます！！"
    },
    {
      "CharacterName": 1944734108,
      "Name": "ヘルメット団",
      "Text": "ぐはっ！！！"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "イオリ！戦車をもう少し近くに寄せてください！この銃で直接殴ってやります！"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "興奮しすぎだって……。チナツも止めてよ。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "無理です。さっきから、\n「万魔殿主催の大会で優勝カップを奪い取るのが風紀委員会の宿命だ」\nなんて言い出してますし……。"
    },
    {
      "CharacterName": 1867911819,
      "Name": "チナツ",
      "Text": "一度スイッチが入った行政官を止められるのは、委員長だけです。"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "ほら、もっと撃ち込みなさい！優勝の栄光は、委員長のものです！"
    },
    {
      "CharacterName": 792267831,
      "Name": "イオリ",
      "Text": "……ん？なんだ、あの光？"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "光なんてどうでもいいでしょう！？目の前の敵にもうちょっと集中し――"
    },
    {
      "CharacterName": 2071829941,
      "Name": "アコ",
      "Text": "きゃあああっ！！！"
    },
    {
      "CharacterName": 4220213473,
      "Name": "カリン",
      "Text": "あの人、戦車の上で銃を振り回してた。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "変な不良みてぇな奴だな……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "アスナ、プリズム砲は問題なかったか？"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "だいじょーぶ！問題なしだよ～！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "まさか、ゲーム開発部のチビどもにやられるとはな……\nまあ、直せたから良かったけどよ。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "しっかし、やっぱ4人だときちーな……。\nトキは昨日からどこに行っちまったんだ？"
    },
    {
      "CharacterName": 4220213473,
      "Name": "カリン",
      "Text": "連絡も取れないから心配だ。"
    },
    {
      "CharacterName": 1872351598,
      "Name": "アカネ",
      "Text": "トラブルに巻き込まれていなければ良いのですが……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "そう簡単にやられる奴じゃないだろ？ 心配すんなって。\nつーか……なんでどいつもこいつも、うちの戦車を見るなりすげー勢いで噛みついてくるんだ！？"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "もしかして、一番変だからー？あははっ！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "まあ、エンジニア部の奴らが作ったからな……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "こんなヘンテコ戦車、他には一台もな……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "……はあ？"
    },
    {
      "CharacterName": 4220213473,
      "Name": "カリン",
      "Text": "これは、私たちのと同じプリズム砲……？"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "プリズムではありません。プリティメイドです。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "お前、どこほっつき歩いてたんだよ！！んで、何だその戦車は！！！"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "私も同じものをエンジニア部の方にお願いしました。"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "ネル先輩に、一度勝ちたいと思いまして。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "あいつら、それを引き受けたのか！？"
    },
    {
      "CharacterName": 1111474507,
      "Name": "ウタハ",
      "Text": "ミラーマッチはロマンだからね。"
    },
    {
      "CharacterName": 2510891413,
      "Name": "コトリ",
      "Text": "設計図も、一度しか使わないのはもったいないです！"
    },
    {
      "CharacterName": 1995116401,
      "Name": "ヒビキ",
      "Text": "面白そうだし。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "あいつら、ったく……！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "いいぜ、かかってこい！！ぶっ壊してやる！！"
    },
    {
      "Text": "[ns] \"ミラーマッチ！ミラーマッチ！ミラーマッチ！\""
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "これは予想外の展開ですね！\n行方をくらましていた部員が同じ型の戦車に乗ってくるとは！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "どっちが勝つんだろう？楽しみ～！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "同じ戦車同士なら、後は乗組員の腕で決まります！\nあっ！そんなことを言っている内に始まりました！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "カメラが追いつきません！防御も回避も一切ない、ノーガードの殴り合いです！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "んだよ、トキもエンジニア部の奴らも大したことねぇな！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "おら！戦車もぶっ壊れたぞ！もうあきらめろ！"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "な、なんだ！？"
    },
    {
      "CharacterName": 3624058471,
      "Name": "トキ",
      "Text": "何かという質問に答えますと……スーパープリティメイドです。"
    },
    {
      "CharacterName": 3624058471,
      "Name": "トキ",
      "Text": "ピース、ピース。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "んなこと聞いてねぇよ！！！！"
    },
    {
      "CharacterName": 3624058471,
      "Name": "トキ",
      "Text": "今回の勝負は、私の勝ちです。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "お、おい！！！"
    },
    {
      "CharacterName": 4103320205,
      "Name": "審判",
      "Text": "そこのロボットメイドさん！失格です！降りてください！"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "失格なの？"
    },
    {
      "CharacterName": 3624058471,
      "Name": "トキ",
      "Text": "私はスーパープリティメイドです。"
    },
    {
      "CharacterName": 4103320205,
      "Name": "審判",
      "Text": "そんなことはどうでもいいです。変身した選手は、ルール上戦車と判定します。"
    },
    {
      "CharacterName": 4103320205,
      "Name": "審判",
      "Text": "戦車は1チーム当たり1台が原則なので、2台ですと反則になります。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "ははは！ざまあみろ！"
    },
    {
      "CharacterName": 4103320205,
      "Name": "審判",
      "Text": "それと……車体の損傷で走行不能のため、C&Cチームも脱落となります。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "んだと！？"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "あはは！あ～面白かった～！"
    },
    {
      "CharacterName": 4220213473,
      "Name": "カリン",
      "Text": "予想よりは長く残った。"
    },
    {
      "CharacterName": 1872351598,
      "Name": "アカネ",
      "Text": "ゲヘナは温泉が多いようなので、\nそれを堪能してからカラオケにでも行きましょうか？"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "お前たち、なんでそんなにあっさりしてんだよ！？"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "みんなで十分楽しんだし、それでいいんじゃない？"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "トキ、お前はこっちに来い！！もう一度勝負だ！！さっきのは反則だろ！！"
    },
    {
      "CharacterName": 545869831,
      "Name": "トキ",
      "Text": "嫌です。"
    },
    {
      "CharacterName": 545869831,
      "Name": "トキ",
      "Text": "先輩は下手なので。"
    },
    {
      "CharacterName": 545869831,
      "Name": "トキ",
      "Text": "雑魚は相手にしません。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "誰が雑魚だゴルァ！！！"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "二人とも、はっや～い！あはは！"
    },
    {
      "CharacterName": 4220213473,
      "Name": "カリン",
      "Text": "ふふっ、まだ力が有り余っているようだな。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "あれって、パワードスーツとかいうやつ！？すごい！！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "それより、こっちの細い道を行ったら3つ目の的だよ！早く行こう！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "さっきみたいに、また誰かに会ったらどうしよう……！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "そうならないために脇道使うんだって！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "それで変速機に負担がかかったら？"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "も～！じゃあどうするの！？"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "あ。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "前に、戦車。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "ここにも敵が！！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "装填！装填！早く早く早く！！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "ぐぎぎぎぃ～！砲弾、重すぎるって～！なんで揚弾機外すかなぁ！？"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "的以外を砲撃するなんて思ってなかったもの！レースだって聞いてたし！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "ひ、HEAT弾装填！標的情報はよ～！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "1時の方向！距離、130！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "現在、敵の戦車は……。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "……ヒッチハイク中？"
    }
  ],
  "DialogKR": [
    {
      "Text": "제5화;약자의 말은 듣지 않는다"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "아아앗-! 이게 웬일이죠! 발키리 경찰학교 팀, 화려한 폭발과 함께 탈~~~~락입니다!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "우승까지 식은 죽 먹기라는 느낌이었는데 말이죠~"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "이부키는 식은 죽이 더 먹기 힘들던데!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "포사격의 기본은 쏘고 도망치는 거죠! 제자리에서 오랫동안 점수 이득을 보다가 그만 기습을 허용해 버렸군요!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "이번이 첫 출전인 183호 특별반, 이걸로 첫 격파를 달성했습니다. 축하축하축하!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "자, 다시 현장으로 가기 전에—"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "선생님! 마무리 부탁드립니닷!"
    },
    {
      "Text": "[ns] \"채널 고정이래!\""
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "감사합니다앙-!!"
    },
    {
      "CharacterName": 1944734108,
      "Name": "헬멧단",
      "Text": "끄악!!!"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "이오리! 전차를 좀 더 가까이 대주세요! 제 총으로 직접 때리고 싶군요!"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "너무 신난 거 아니야? 치나츠도 좀 말려봐."
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "무리예요. 아까부터 만마전이 주최한 행사에서 우승컵을 가져오는 게 선도부의 숙명이라고 하질 않나……."
    },
    {
      "CharacterName": 1867911819,
      "Name": "치나츠",
      "Text": "선임 행정관님이 한번 스위치 들어가면 히나 부장님이 오셔야 진정할 수 있을 거예요."
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "맹렬하게 공격하세요! 이 영광은 선도부장님의 것이에요!"
    },
    {
      "CharacterName": 792267831,
      "Name": "이오리",
      "Text": "……응? 뭐지, 저 빛은?"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "그런 사소한 거에 신경 쓸 시간에 눈앞의 적에 더 집중을 하—"
    },
    {
      "CharacterName": 2071829941,
      "Name": "아코",
      "Text": "꺄아아악!!!"
    },
    {
      "CharacterName": 4220213473,
      "Name": "카린",
      "Text": "저 사람, 전차 위에서 총을 휘두르고 있었어."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "뭔가 이상한 깡패 같은 녀석이네……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "아스나, 프리즘 포에는 이상 없었어?"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "응! 문제없이 잘 나갔어!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "게임개발부 꼬맹이들한테 그렇게 당할 줄이야……. 다행히 현장에서 고칠 수 있었네."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "네 명이서 고치기 힘들었다구. 토키 녀석은 어제부터 어디로 간 거야?"
    },
    {
      "CharacterName": 4220213473,
      "Name": "카린",
      "Text": "응. 연락도 되지 않아서 걱정이야."
    },
    {
      "CharacterName": 1872351598,
      "Name": "아카네",
      "Text": "뭔가, 곤란한 일을 겪고 있는 게 아니라면 좋겠는데 말이죠……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "쉽게 당할 녀석이 아니잖아? 걱정 말자구. 그보다, 왜 다들 우리만 보면 못 잡아먹어서 안달이야?!"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "우리 전차가 제일 이상하게 생겨서 그런 거 아닐까? 아하핫!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "하기야, 엔지니어부 녀석들이 특이하게도 만들긴 했지……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "이런 괴상한 전차, 다른 팀은 끌고 나올 리가……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "……에?"
    },
    {
      "CharacterName": 4220213473,
      "Name": "카린",
      "Text": "우리 것과 같은 프리즘 포……?"
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "프리즘보다는 프리티 메이드입니다."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "넌 어디 갔다가 온 거야!! 그 탱크는 뭔데!!!"
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "저도 똑같은 걸로 엔지니어부의 분들께 주문했습니다."
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "네루 선배를 한번 이겨보고 싶었습니다."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "엔지니어부 이 자식들, 그걸 또 들어준 거야?!"
    },
    {
      "CharacterName": 1111474507,
      "Name": "우타하",
      "Text": "미러 매치는 로망이니까."
    },
    {
      "CharacterName": 2510891413,
      "Name": "코토리",
      "Text": "설계도를 한 번만 쓰는 건 아깝잖아요!"
    },
    {
      "CharacterName": 1995116401,
      "Name": "히비키",
      "Text": "재밌어 보이기도 하고."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "이, 이것들이 진짜……!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "다 덤벼!!! 박살 내주마!!!"
    },
    {
      "Text": "[ns] \"미러전! 미러전! 미러전!\""
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "이건 예상 밖의 전개군요! 배신한 부원이 같은 전차를 타고 오다니!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "어느 쪽이 이길까? 재밌겠다~!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "똑같은 전차의 대결이면, 나머지는 순수 실력으로 결판나겠죠! 아! 말씀드리는 순간 바로 격전이 시작됩니다!!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "카메라가 따라가지 못할 정도의 호각! 방어와 회피 모두 하지 않는 순수한 노가드 난타전이네요!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "헹. 토키와 엔지니어부 녀석들, 완전 약골이잖아!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "어떠냐! 전차도 다 부서졌으니 항복하시지!"
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "뭐, 뭐야!!!"
    },
    {
      "CharacterName": 3624058471,
      "Name": "토키",
      "Text": "누구냐고 물으신다면, 슈퍼 프리티 메이드입니다."
    },
    {
      "CharacterName": 3624058471,
      "Name": "토키",
      "Text": "피스피스."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "그걸 물었겠냐고!!!!"
    },
    {
      "CharacterName": 3624058471,
      "Name": "토키",
      "Text": "이번 승부는, 제가 승리하겠습니다."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "야, 얌마!!!"
    },
    {
      "CharacterName": 4103320205,
      "Name": "경기 심판",
      "Text": "거기, 로봇 메이드 씨! 실격입니다! 내려오세요!"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "실격?"
    },
    {
      "CharacterName": 3624058471,
      "Name": "토키",
      "Text": "저는 슈퍼 프리티 메이드입니다만."
    },
    {
      "CharacterName": 4103320205,
      "Name": "경기 심판",
      "Text": "그건 모르겠구요, 지금 변신하신 거 규정상 전차 판정이에요."
    },
    {
      "CharacterName": 4103320205,
      "Name": "경기 심판",
      "Text": "1팀 1전차 출전이 원칙이어서, 몰수패 처리합니다."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "크하하! 꼴좋다!"
    },
    {
      "CharacterName": 4103320205,
      "Name": "경기 심판",
      "Text": "그리고, C&C 팀 분들도 탈락입니다. 차체 손상으로 기동 완전 불가능이에요."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "뭐라고?!"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "아하하! 재밌었다!"
    },
    {
      "CharacterName": 4220213473,
      "Name": "카린",
      "Text": "그래도 예상보다 더 오래 남았었네."
    },
    {
      "CharacterName": 1872351598,
      "Name": "아카네",
      "Text": "게헨나가 온천이 많다던데, 씻고 노래방이라도 갈까요?"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "너희들 뭐 이렇게 미련이 없어?!"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "그치만 참가해서 재밌게 즐겼으면 된 거 아냐?"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "야! 토키!! 너 이리 와!! 다시 붙어!! 반칙이잖아!"
    },
    {
      "CharacterName": 545869831,
      "Name": "토키",
      "Text": "싫습니다."
    },
    {
      "CharacterName": 545869831,
      "Name": "토키",
      "Text": "선배, 허접이잖아요."
    },
    {
      "CharacterName": 545869831,
      "Name": "토키",
      "Text": "저는 허접하고는 겨루지 않습니다."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "넌 진짜 죽었어!!!"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "둘 다 엄청 빠르네! 아하하!"
    },
    {
      "CharacterName": 4220213473,
      "Name": "카린",
      "Text": "후훗. 힘이 남아도는 모양이야."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "이야아……. 뭔가 대단한 걸 봤네……. 변신 외골격이라니, 대단해!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "됐으니까! 이쪽 오솔길로 쭉 가면 세 번째 표적이야. 빨리 가자!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "지금 가도 괜찮으려나? 갔다가 아까처럼 또 누구 마주치면 어떡해!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "그러니까 최대한 트랙은 피해서 샛길로 빠지는 거잖아!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "그러다가 변속기에 무리 가면 어쩌려고 그래?"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "그럼 어쩔 건데?!"
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "아."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "앞에, 전차."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "여기로 와도 적이 있잖아!!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "장전!! 빨리빨리빨리!!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "크아악!! 포탄이 얼마나 무거운지 알아?! 양탄기는 왜 빼자고 해서 진짜!!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "표적 이외에는 포를 쏠 일 없을 줄 알았지! 레이싱이라고 들었으니까!!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "대, 대탄 장전! 표적 정보나 알려줘!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "1시 방향! 거리 130!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "현재 적 전차……."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "……히치하이킹 중……?"
    }
  ],
