{
  "TitleJP": "駆け抜けた所に楽園はある",
  "TitleKR": "달려온 곳에 낙원은 있다",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "レースは終わり、片づけが進むなか、息も絶え絶えな戦車が姿を現した。最後まで諦めなかった忍術研究部は、スタッフに見守られながらゴールインするのだった。",
  "DescKR": "레이스가 끝난 지 오래인 밤의 결승선. 그러나, 아직 달리고 있는 이들이 있었다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "後日談その3;駆け抜けた所に楽園はある"
    },
    {
      "Text": "ゲヘナカップ・ゴール"
    },
    {
      "Text": "（レース終了後の夜）"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "そこ、抜けなければハンマーで壊してもいいよ。"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "どうせ、また新しく作るんだから。"
    },
    {
      "CharacterName": 3378558447,
      "Name": "万魔殿の部員B",
      "Text": "でも、なんかもったいないですね。みんなで一生懸命作ったのに。"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "たしかにそうだけど、また頑張ればいいでしょ。"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "早く終わらせて、打ち上げにでも行こう！"
    },
    {
      "CharacterName": 3378558447,
      "Name": "万魔殿の部員B",
      "Text": "いいですね！それなら、どんどん壊します！よいしょ！"
    },
    {
      "CharacterName": 3378558447,
      "Name": "万魔殿の部員B",
      "Text": "ここを叩けば……。"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "誰か手伝いに来てくれたのかな？"
    },
    {
      "CharacterName": 3378558447,
      "Name": "万魔殿の部員B",
      "Text": "戦車で撤去しようとしてくれてるみたいです。"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "いや、あれは戦車じゃなくて……。"
    },
    {
      "CharacterName": 2719706734,
      "Name": "謎の戦車のエンジン",
      "Text": "ひいぃ……ふうっ……はあっ……。"
    },
    {
      "CharacterName": 1965649612,
      "Name": "謎の戦車のギア",
      "Text": "うにゃあ……げへっ……くはぁ……。"
    },
    {
      "CharacterName": 3961557074,
      "Name": "謎の戦車の砲塔",
      "Text": "あっ！ゴールが見えました！もう少しですよ！"
    },
    {
      "CharacterName": 1852961561,
      "Name": "ミチル",
      "Text": "へぇっ……へっ……な、なに！？みんなどこに行ったの？"
    },
    {
      "CharacterName": 2134514859,
      "Name": "ツクヨ",
      "Text": "ひいぃ……。"
    },
    {
      "CharacterName": 4220116446,
      "Name": "イズナ",
      "Text": "まだ誰もゴールしてないみたいです！私たちが優勝ですね！"
    },
    {
      "CharacterName": 1852961561,
      "Name": "ミチル",
      "Text": "さすがにそれはないでしょ！"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "せん……。"
    },
    {
      "CharacterName": 3378558447,
      "Name": "万魔殿の部員B",
      "Text": "……しゃ？"
    },
    {
      "CharacterName": 4220116446,
      "Name": "イズナ",
      "Text": "ああっ……ゴールが……。"
    },
    {
      "CharacterName": 1852961561,
      "Name": "ミチル",
      "Text": "撤去してる……？まさか……もう終わったの……？"
    },
    {
      "CharacterName": 2134514859,
      "Name": "ツクヨ",
      "Text": "か、完走したのに……。"
    },
    {
      "CharacterName": 4220116446,
      "Name": "イズナ",
      "Text": "きゅう……。"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "ま、まだゴールしていませんよ！"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "ラインまで、あと少しです！！"
    },
    {
      "CharacterName": 3378558447,
      "Name": "万魔殿の部員B",
      "Text": "が、頑張れ！！頑張れ！！"
    },
    {
      "CharacterName": 672503669,
      "Name": "忍者タンク",
      "Text": "ぶぅぅぅんっ！"
    },
    {
      "CharacterName": 672503669,
      "Name": "忍者タンク",
      "Text": "ゴールイン～！"
    }
  ],
  "DialogKR": [
    {
      "Text": "후일담;달려온 곳에 낙원은 있다"
    },
    {
      "Text": "게헨나컵 결승선"
    },
    {
      "Text": "(경기 종료 후, 그날 밤)"
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "거기, 잘 안 빠지면 그냥 망치로 부숴도 괜찮아."
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "어차피 결승선은 다음 경기 때 새로 만드는 거라서 너무 애쓸 필요 없어."
    },
    {
      "CharacterName": 3378558447,
      "Name": "만마전 부원 B",
      "Text": "그렇지만 아까운걸요. 기껏 다들 모여서 열심히 그린 간판인데."
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "그렇긴 한데, 다음에도 또 그리면 되니깐."
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "빨리 철거하고 들어가서 쉬자. 무사히 경기 끝난 뒤풀이해야지!"
    },
    {
      "CharacterName": 3378558447,
      "Name": "만마전 부원 B",
      "Text": "좋네요! 그러면 그냥 부술게요. 영차!"
    },
    {
      "CharacterName": 3378558447,
      "Name": "만마전 부원 B",
      "Text": "여기를 때리면……."
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "뭐지? 늦어지니까 도와주려고 누굴 보냈나?"
    },
    {
      "CharacterName": 3378558447,
      "Name": "만마전 부원 B",
      "Text": "탱크로 철거해 주려고 하나 봐요."
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "아니, 저거 탱크가 아니라……."
    },
    {
      "CharacterName": 2719706734,
      "Name": "의문의 전차 엔진",
      "Text": "히잉……. 헤엑……. 헥……."
    },
    {
      "CharacterName": 1965649612,
      "Name": "의문의 전차 변속기",
      "Text": "흐갸악……. 게엑……. 크하악……."
    },
    {
      "CharacterName": 3961557074,
      "Name": "의문의 전차 포탑",
      "Text": "앗! 결승선입니다! 이제 다 왔어요!"
    },
    {
      "CharacterName": 1852961561,
      "Name": "미치루",
      "Text": "헤엑……. 헥……. 뭐, 뭐야?! 다 어디 갔어?!"
    },
    {
      "CharacterName": 2134514859,
      "Name": "츠쿠요",
      "Text": "히이잉……. 헤엑……."
    },
    {
      "CharacterName": 4220116446,
      "Name": "이즈나",
      "Text": "아직 아무도 도착 안 했나 봅니다! 우리가 1등인가 봐요!"
    },
    {
      "CharacterName": 1852961561,
      "Name": "미치루",
      "Text": "아무래도 그건 아니겠지!"
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "전……."
    },
    {
      "CharacterName": 3378558447,
      "Name": "만마전 부원 B",
      "Text": "……차?"
    },
    {
      "CharacterName": 4220116446,
      "Name": "이즈나",
      "Text": "아앗……. 결승선이……."
    },
    {
      "CharacterName": 1852961561,
      "Name": "미치루",
      "Text": "철거 중이잖아……. 설마 경기……. 끝난 거야……?"
    },
    {
      "CharacterName": 2134514859,
      "Name": "츠쿠요",
      "Text": "와, 완주했는데……."
    },
    {
      "CharacterName": 4220116446,
      "Name": "이즈나",
      "Text": "캐앵……."
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "아, 아직 경기 안 끝났어요!"
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "아직 결승선 남아있으면 끝난 거 아니에요!"
    },
    {
      "CharacterName": 3378558447,
      "Name": "만마전 부원 B",
      "Text": "히, 힘내라!! 힘내라!!"
    },
    {
      "CharacterName": 672503669,
      "Name": "닌자탱크",
      "Text": "우우웃-!"
    },
    {
      "CharacterName": 672503669,
      "Name": "닌자탱크",
      "Text": "골-인-!"
    }
  ],
