{
  "TitleJP": "そこに行ったらお便りします",
  "TitleKR": "그곳에 가면 편지를 띄우세요",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "183号の3人は、ゲヘナカップ優勝祝賀会でチェリノからの表彰を受ける。喜ぶ3人だったが、一転、予選に出場する過程で起こした騒動についての追及が始まる。結果として183号特別クラスへの無期限在留が言い渡され、脱出は叶わず環境は変わらなかった。しかし3人の間には、確かに変わったものもあるはずだ。",
  "DescKR": "붉은겨울로 돌아온 세 사람. 사무국이 마련한 자리에서, 체리노의 ‘포상’이 발표된다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第12話;そこに行ったらお便りします"
    },
    {
      "CharacterName": 913048351,
      "Name": "レッドウィンターの生徒A",
      "Text": "来たよ！"
    },
    {
      "CharacterName": 852619036,
      "Name": "レッドウィンターの生徒B",
      "Text": "お疲れ様ー！初出場で優勝なんて、すごい！"
    },
    {
      "CharacterName": 2559385178,
      "Name": "レッドウィンターの生徒C",
      "Text": "かっこいー！！ほんとにほんとによく頑張ったね！"
    },
    {
      "CharacterName": 1881716009,
      "Name": "トモエ",
      "Text": "それでは、これよりゲヘナカップ優勝祝賀会を開催いたします。"
    },
    {
      "CharacterName": 1881716009,
      "Name": "トモエ",
      "Text": "まず、チェリノ会長による表彰です。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "ゲヘナカップに優勝した183号。前に。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "183号特別クラス学級委員長、[ruby=にき]仁木[/ruby]アンナ。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "183号特別クラス副学級委員長、[ruby=にき]二木[/ruby]エリナ。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "そして183号特別クラス[ruby=・]副[/ruby][ruby=・]副[/ruby]学級委員長、[ruby=ふるはた]古畑[/ruby]ラナ。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "書記長である私の悲願であった、ゲヘナカップ優勝杯を持ち帰ってくれたこと。\n大いに称えよう。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "巨大なゲヘナの戦車に、正面から立ち向かった勇気。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "そして最後まで諦めないレッドウィンター精神。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "諸君の活躍は、みんなに大きな感動を与えた。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "レッドウィンター事務局の権限で、\n183号特別クラスには「努力髭勲章」を授与する！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "あ、ありがとうございます……！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "やったぁ……！夢じゃないよね……！？"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "事務局、そしておいらは……レッドウィンターのみんなが、\n功績に見合ったものを与えられるべきだと考えている。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "ということで、発案者は誰だ？"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "え、それは……。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "副学級委員長です！\nエリナが励ましてくれなければ、参加すらできませんでした！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "ええっ！？なんでいきなり謙遜してんの！？"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "わ、私は提案しただけです！学級委員長のアンナが一番頑張ってくれました！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "それにラナも、先生も……みんなで力を合わせました！"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "ブイ。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "そうか、学級委員長の仁木アンナが主導し、お前たちはそれに従ったのだな。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "つまり――"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "仁木アンナの指示で事務局を襲撃し、おいらの銅像を削った……。"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "さらに窓ガラスを盗んだ上、広場を砲撃したというのだな？"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "え、えへへ……大したことありません、会長。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "え！？"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "事務局が知らないとでも思ったか！？この反乱分子め！！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "そ、それは！！つまり！！"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "賞は賞で、罰は罰！"
    },
    {
      "CharacterName": 2422553686,
      "Name": "チェリノ",
      "Text": "183号全員、特別クラスに無期限在留だ！！！！"
    },
    {
      "CharacterName": 2800662853,
      "Name": "アンナ&エリナ",
      "Text": "うあああぁぁぁん！！！"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "……こうして、私たちは183号特別クラスに戻りました。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "みんな、元気に過ごしています。\n先生がいらっしゃる前に比べたら、確実に変わっている気がします。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "アンナはさらに見栄っ張りになり、エリナはからかい方が上手くなっています。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "「戦車レースはインパクトが足りなかった！\nもっとデカイの一発食らわせよう！」と二人は言っていますが……。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "研究テーマを決める段階からRWWEをしていて、\n選ぶのにちょっと時間がかかっています。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "みんなが先生に会いたがっているので……\n研究テーマが決まる頃、また遊びに来ていただけると嬉しいです。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "追伸。約束どおり、銅像と窓ガラスは元に戻しました。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "2人の親友と共に。古畑ラナより。"
    },
    {
      "Text": "[ns] \"……そうなんだ。\""
    },
    {
      "Text": "[ns1] \"ところで、これを直接持ってきたってことは……。\""
    },
    {
      "Text": "[ns2] \"もう研究テーマが決まったの？\""
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "そうではありません。手紙を出そうと思ったら、切手が不足していたのです。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "ここに来るのは2回目ですが、やはり大変ですね。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "すぅ……すぅ……。"
    },
    {
      "Text": "Start Your Engines!～183号よ永遠に！～"
    }
  ],
  "DialogKR": [
    {
      "Text": "제12화;그곳에 가면 편지를 띄우세요"
    },
    {
      "CharacterName": 913048351,
      "Name": "붉은겨울 학생 A",
      "Text": "저기! 우승자들 온다!"
    },
    {
      "CharacterName": 852619036,
      "Name": "붉은겨울 학생 B",
      "Text": "수고했어! 첫 출전에 우승이라니 대단해!"
    },
    {
      "CharacterName": 2559385178,
      "Name": "붉은겨울 학생 C",
      "Text": "멋있다!! 너무너무 잘했어!"
    },
    {
      "CharacterName": 1881716009,
      "Name": "토모에",
      "Text": "그러면, 붉은겨울 연방학원의 게헨나컵 우승 축하 행사가 있겠습니다."
    },
    {
      "CharacterName": 1881716009,
      "Name": "토모에",
      "Text": "먼저, 체리노 회장님의 표창식이 있겠습니다."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "게헨나컵 우승을 거머쥔 183호. 앞으로."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "183호 특별반 반장. 니키 안나."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "183호 특별반 부반장. 니키 에리나."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "그리고, 183호 특별반 부부반장. 후루하타 라나."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "본 회장의 염원이던, 게헨나 컵에서 우승컵을 가져온 것. 아주 크게 칭찬하지."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "게헨나의 거대한 전차에, 정면으로 맞서 싸운 용기."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "그리고 끝까지 포기하지 않은 붉은겨울의 정신 그 자체."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "제군들의 활약은, 우리 모두에게 큰 감동을 주었어."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "이에, 붉은겨울 사무국의 권한으로 183호 특별반에게 노력수염훈장을 수여한다!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "가, 감사합니다……!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "해냈다……! 이거 꿈 아니지……?!"
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "사무국, 그리고 이 몸은……. 붉은겨울의 모두가, 이렇게 업적에 합당한 보상이 있어야 한다고 생각한다."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "그런 점에서, 누가 이 일을 하자고 했지?"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "어, 그게……."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "부반장, 에리나가 하자고 했어요! 에리나가 응원하지 않았다면 참가도 못 했을 거예요!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "야, 여기서 괜히 겸손하게 굴려는 거야?!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "저는 제안한 것에 불과하고요, 반장인 안나가 가장 열심히 해줬어요!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "그리고 라나도, 선생님도…… 모두 힘을 합쳐서 만들었어요!"
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "브이."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "그렇군, 반장인 니키 안나가 주도하고, 너희들은 그것에 따랐던 것이군."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "즉—"
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "니키 안나의 지시로, 사무국을 습격하고 이 몸의 동상을 깎아냈다……."
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "거기에 유리창을 훔쳐 간 것도 모자라서 광장에 포격까지 했다. 맞나?"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "우, 우헤헤……. 별거 아니에요, 회장님."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "네?!"
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "사무국이 끝까지 모를 줄 알았어?! 이 반동 녀석들!!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "그, 그게요!! 그러니까!!"
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "상은 상이고 벌은 벌!"
    },
    {
      "CharacterName": 2422553686,
      "Name": "체리노",
      "Text": "183호 전원, 특별반 무기한 복귀다!!!!"
    },
    {
      "CharacterName": 2800662853,
      "Name": "안나&에리나",
      "Text": "끄아앙-!"
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "……이렇게 해서, 저희 183호는 다시 원래대로 복귀했습니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "모두들 잘 지내고 있습니다. 선생님께서 오시기 전에 비해 확실히 달라진 기분이 듭니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "안나는 더 거만해졌고, 에리나는 그에 맞게 더 잘 놀리고 있습니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "'전차대회는 임팩트가 부족하긴 했지! 더 큰 한 방을 보여주자!'라며 열중하곤 있습니다만……."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "연구 주제를 무엇으로 해야 할지의 단계부터 RWWE를 하고 있어서, 고르는 데 시간이 좀 걸릴 것 같습니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "모두 선생님을 그리워하기에, 조만간 연구 주제가 정해질 때 다시 한번 더 놀러 와주시면 감사하겠습니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "추신. 약속드린 대로, 동상과 유리창은 원래대로 되돌려주었습니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "두 친한 친구들과 함께. 후루하타 라나 올림."
    },
    {
      "Text": "[ns] \"……그렇구나.\""
    },
    {
      "Text": "[ns1] \"그런데, 이 편지를 직접 들고 왔다는 건…….\""
    },
    {
      "Text": "[ns2] \"벌써 연구 주제가 정해진 거니?\""
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "그건 아닙니다. 편지를 부치려는데 우표가 부족해서 직접 찾아왔습니다."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "역시, 두 번 와도 쉽지는 않군요."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "쿠울…… 쿨……."
    },
    {
      "Text": "Start Your Engines! ~183호여, 영원하라!~"
    }
  ],
