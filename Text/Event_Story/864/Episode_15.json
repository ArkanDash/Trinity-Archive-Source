{
  "TitleJP": "空冷0気筒",
  "TitleKR": "공랭식 0기통",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "本戦を目前にして、補習授業部のクルセイダーちゃんはエアコンが故障してしまった。改善の策としてドライアイスを注文していたヒフミのもとに、万魔殿から荷物が届けられる。けれど予想とは裏腹に、箱の中に入っていたのは機能的で涼し気なレーシングスーツだった。",
  "DescKR": "레이스 전날의 선수촌. 더위와 씨름하던 보충수업부에게 정체불명의 택배가 도착한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "後日談その1;空冷0気筒"
    },
    {
      "Text": "（レース前日）"
    },
    {
      "Text": "ゲヘナカップ宿泊施設"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "暑い。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "ほんっと暑い！ムカつく！！やってらんない！！！"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "あはは……結局、クルセイダーちゃんのエアコンは直せませんでしたね。"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "私はピタっとしてベタベタするのも良いと思いますよ。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "嫌っ！汗かいてるのにくっついたら気持ち悪いでしょ！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "そういうのは、本で見るほうが好きなんですよね？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "な、何言ってんの！？そんなの知らないもん！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "それなら……コハルちゃんのカバンに入っている\n『戦車装備教範』、今から一緒に見ても良いですか？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "そ、それは……！あんたには難しいからダメ！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "なるほど……。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "何よ、その目！？"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "別の表紙でカモフラージュなんて、古典的ですね。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "！！！"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "出発前から一生懸命に読んでたね。教範は全ての戦術の基本だ。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "良ければ、私も読みたい。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "ダメったらダメ！！！"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "あはは、大丈夫ですよ。教範がなくても修理する方法はありますから。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "そろそろ、注文した「涼しくなるもの」が到着するはずなんですが……。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "涼しくなるもの？"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "こんな時間に誰でしょう？お隣さんですかね？"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "コハルちゃん。\n夜に呼び鈴が鳴ったら、その後何が起こるか……よく知ってますよね？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "質問の意図が不純なんだけど！最っ低！"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "離れて、催涙弾を投げ込まれるかもしれない。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "防毒マスク、今回も持ってきたんですね。"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "やっほー！ぱんでもにうむ・そさえてぃーだよー！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "荷物を届けに来たの！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "わっ！う、宇宙人！？こわい～！！"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "宇宙人じゃない。[ruby=しらす]白洲[/ruby]アズサだ。よろしく。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "それ、早く外しなさいよ！その子びっくりしてるじゃん！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "コハルちゃんのも私が外してあげますね……♡"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "死刑、死刑、死刑っ！！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "しけい？イブキ、悪い子……？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "そ、そうじゃなくて……！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "そうなんだ！おいしいキャンディーをありがとう！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "お姉ちゃん、ここって616号室だよね？ここにサインしてくれる？"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "ありがとうございます！重いのにご苦労様です！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "[ruby=パンデモニウム・ソサエティー]万魔殿って、ゲ[/ruby]ヘナの生徒会ですよね？宅配業務もするんですか？"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "うん！みんな忙しいから、イブキがお手伝いしてるんだ！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "えへへ！いろんな人に会えて楽しいよ！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "あら、偉いですね。"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "コハルちゃんと一緒で[ruby=・]オ[/ruby][ruby=・]ト[/ruby][ruby=・]ナ[/ruby]です！"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "決まってんでしょ、私はエリートなんだから大人……。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "ん？もしかして、からかってる……？"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "からかってませんよ～"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "どうして急に抱きつくの！？"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "ここにサインですね……はいっ！ありがとうございます！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "うん！明日のレース、頑張ってね！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "ところで、何を注文したんですか？"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "壊れたのはエアコンのエバポレーターなので……\n冷媒を直接冷やせば、冷たい風が出てくると思って……。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "さっきドライアイスを注文したんです！"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "早く、保冷バッグに移さないと……。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "これは……。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "ドライアイスじゃないけど、涼しそうではあるね。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "中身間違われちゃったってこと？\n616ってあるし、この部屋宛てではあるんだよね？"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "はい、そのはずなんですけど……。"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "車両点検を受けた時に故障の話をしたので、運営さんが送ってくれたのでしょうか？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "そんなはず……なくはないの？運営が送ってくるなんて……。"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "これは……レーシングスーツですね。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "レーシングスーツ、ですか？"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "はい！広告でもこういう衣装を着た人を見るでしょう？"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "それは出場選手じゃなくて、進行の人たちが着ているような……。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "トリニティとは違う風習かもしれない。涼しそうだし、機能的で良いと思う。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "うーん……ドライアイスがないなら、エアコンは機能しないでしょうし……。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "制服だと熱中症の恐れもあるので、これを着たほうが良いかもしれませんね。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "でも2着しかないわよ？"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "もしかしたら、戦車長と副戦車長の分だけなのかも。"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "でしたら、ヒフミちゃんとアズサちゃんの分ですね！"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "私たちは念のために持ってきた水着を着ましょう、コハルちゃん！"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "何言ってんの？私は水着なんて持ってきてないけど。"
    },
    {
      "CharacterName": 3486651750,
      "Name": "ハナコ",
      "Text": "コハルちゃんの分も私が持ってきてます。非常時に備えて、当然のことです。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "どんな非常時よ！？"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "戦場に出るための鎧、気に入った。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "熱中症も心配ですし……せっかく運営さんが準備してくださったんですから、\n遠慮なく着させてもらいましょう。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "水着で戦車に乗るなんておかしいでしょ！"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "え！？"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "ふんふん～るんるん～♪"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "えっと～"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "616号室にドライアイス、配達完了！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "それと919号室にマコト先輩の服を配達したら、お仕事終わり！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "えへへ！"
    }
  ],
  "DialogKR": [
    {
      "Text": "후일담;공랭식 0기통"
    },
    {
      "Text": "(경기 전날)"
    },
    {
      "Text": "게헨나 컵 선수촌"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "더워."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "더워, 짜증 나, 우울해!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "아하하……. 결국, 크루세이더 쨩의 에어컨은 고치지 못했네요."
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "저는 미끌미끌하고 끈적해서 나름대로 좋다고 생각해요."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "싫어! 좁은 전차 안에서 비비적거리면 찝찝하다고!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "그런 건, 역시 책으로 보는 게 더 좋긴 하죠?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "무, 무슨 소리야!! 난 그런 거 몰라!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "그런가요? 그러면, 코하루 쨩이 가방에 가져온 '전차 정비 교범', 지금 같이 봐도 될까요?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "그, 그건……! 네가 보기엔 어려운 책이니까 안 돼!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "흐음-"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "뭐야, 그 눈빛은?!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "고전적이네요, '다른 책 표지 덮어씌우기'."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "!!!!!"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "출발하기 전부터 열심히 읽던 책이 교범이었군. 교범은 모든 전술의 기본이지."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "괜찮다면, 나도 보고 싶어."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "안 돼에에!!!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "아하하……. 괜찮아요, 교범이 없어도 수리할 다른 방법은 있으니까요."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "이제 곧, 주문한 '시원해지는 것'이 올 텐데……."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "시원해지는 것?"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "이 시간에 누굴까요? 이웃분일까요?"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "코하루 쨩, 밤에 초인종이 울리면, 그 후에 무슨 일이 일어나는지……. 잘 알고 있죠?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "질문의 의도가 불순하고 비열해!"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "물러서, 최루탄이 들어올지도 몰라."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "방독면, 이번에도 챙겨오셨군요."
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "안녕~! 만마전에서 왔어요~!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "택배 왔습니다아~!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "히이…… 뭐야?! 외계인?! 무서워!!"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "후욱……. 시라스 아즈사야. 잘 부탁해."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "애가 놀랐잖아! 얼른 벗으라구!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "코하루 쨩도 제가 벗겨드릴게요……♡"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "사형, 사형, 사형!!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "사형? 이부키, 나쁜 아이야……?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "아, 아니야!!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "그랬구나! 맛있는 사탕 줘서 고마워!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "언니들, 여기 616호 맞지? 사인해 줘!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "고마워요! 와아, 꽤 무거운데 수고 많았어요!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "만마전이면 게헨나 학생회 아닌가요? 택배 업무도 하던가요?"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "그게 말이지! 다들 바빠서 이부키가 잠시 돕고 있었어!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "여러 사람들 만나는 거 재밌기도 하구! 에헤헤!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "어머, 어린데도 어른스럽네요."
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "코하루 쨩처럼 어른스러워요!"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "당연하지, 나는 엘리트니까 당연히 어른스럽……."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "응? 놀린 거였어……?"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "놀리긴요, 놀리긴요-"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "왜 갑자기 껴안는 거야?!!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "사인은 여기, 하고……. 여기! 고마워요!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "응! 내일 경기, 힘내!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "그런데, 뭘 시킨 거예요?"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "에어컨 냉각판이 망가져서요, 그렇지만 냉매를 직접 냉각하면 찬바람이 나오긴 해서……."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "급한 대로 드라이아이스로 계통을 냉각해 주려고, 아까 주문했었어요!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "녹아서 없어지기 전에 보냉백에 어서 옮겨야……."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "이건……."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "드라이아이스는 아니지만, 시원해 보이긴 해."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "잘못 온 건가? 616호라 적힌 거 보면, 이 방으로 온 건 맞는 거지?"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "네, 그건 맞는데요……."
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "아까 차량 검사받을 때, 에어컨 고장 났다고 말했더니 주최 측에서 보내준 걸까요?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "그럴 리가 있……. 으음, 아닌가? 그럴 수도 있나……?"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "이거, 경기복 아닐까요?"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "경기복, 이요?"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "네! 레이싱 광고에서도 이런 의상 입은 사람들이 나오잖아요."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "그건 레이싱 선수가 아니라, 진행 요원분들이 입는 게……."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "트리니티와는 다른 풍습일 수도 있고, 시원해서 기능적이라 생각해."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "으음, 드라이아이스가 없다면 결국 에어컨은 작동 불가인 거구……."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "교복을 입고 경기를 하기엔 열 피로 때문에, 이걸 입고 경기하는 게 낫겠네요."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "그런 것치고는, 사람은 네 명인데 두 벌밖에 없잖아?"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "아마도 차장과 부차장만 주는 것 같아."
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "그렇다면, 히후미 쨩과 아즈사 쨩을 위한 옷이네요!"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "저희는 혹시 몰라서 챙겨온 수영복을 입도록 하죠, 코하루 쨩!"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "수영복? 무슨 소리야? 나는 안 챙겨왔는데?"
    },
    {
      "CharacterName": 3486651750,
      "Name": "하나코",
      "Text": "당연히 제가 코하루 쨩 수영복까지 챙겨왔는걸요? 비상 수영복 상황에 대비해서요."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "그런 상황이 어딨어?!"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "전장에 나서는 갑옷, 마음에 들어."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "아무래도 열사병 걱정도 있으니까, 대회 측에서 모처럼 마련해주셨으니 사양 않고 입어볼까요?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "이상하다고! 전차를 타는데 수영복이라니!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "네?!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "흥흥, 룬룬-"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "어디 보자~"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "616호에 드라이아이스, 배송 완료!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "그리고 919호 만마전 대기실에 마코토 선배 옷 배달하면 끝!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "에헤헤-!"
    }
  ],
