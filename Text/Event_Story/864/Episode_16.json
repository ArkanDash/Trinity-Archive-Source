{
  "TitleJP": "戦士たちの楽園",
  "TitleKR": "전사들의 낙원",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "レースは終わり、閉幕の祝賀パーティーが催された。ともに優勝を競った選手たちが一堂に集まり懇親を深めるのだった。",
  "DescKR": "모든 경기가 끝난 뒤 열린 폐막 파티. 트랙에서 맞붙었던 이들이 한자리에 모인다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "後日談その2;戦士たちの楽園"
    },
    {
      "Text": "閉幕の祝賀パーティー"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "イッツー！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "パーティータイム！だよ～！"
    },
    {
      "CharacterName": 3925286920,
      "Name": "マコト",
      "Text": "祝うにはまだ早いぞ！！\nイロハの奴は逃げ、服を盗んだ犯人もまだ捕まっていないんだからな！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "まあまあ！大会は無事終わったんだから、いいじゃないですか！"
    },
    {
      "CharacterName": 954095842,
      "Name": "サツキ",
      "Text": "でも、本当に不思議よね。\n荷物を受け取った時には、たしかに重みを感じたのに……。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "服が盗まれたのか……ゲヘナも経済的に困ってるみたいだね。"
    },
    {
      "CharacterName": 3972500147,
      "Name": "ハナコ",
      "Text": "水着が1着あれば、人は十分生きていけるのですが……。"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "あんたは早く服を着なさいよ！！それしかないの！？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "レースは終わったのに、どうしてまた水着なの！？"
    },
    {
      "CharacterName": 3972500147,
      "Name": "ハナコ",
      "Text": "さっき着ていた水着は汗でびしょびしょになってしまったので……\nこのような場には清潔でサラっとした水着を着てくるのがマナーかと。"
    },
    {
      "CharacterName": 3972500147,
      "Name": "ハナコ",
      "Text": "それとも、コハルちゃんはびしょびしょの私のほうが好きですか？"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "い、嫌っ！！近づかないで！！"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "うわああぁぁん！"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "あはは……\nですが、誰もケガすることなく無事にレースが終わって良かったです。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "ん？"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "あなたは、あの時の……。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "ふむ。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "また会えたので、今は敵ですね。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "うん、そうだね。"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "ラナと同じ漫画を読んでるんだね～。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "類は友を呼ぶからね。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "よく考えると前に再会しているので、\n今は一周回って友達になったということです。"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "不変の法則だ。また会えば敵、さらに会えば戦友。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "前回も敵というより、味方でしたけどね。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "こんばんは、183号のみなさん！"
    },
    {
      "CharacterName": 3972500147,
      "Name": "ハナコ",
      "Text": "改めて、優勝おめでとうございます。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "ヒフミさん！ハナコさん！昨日から本当にお世話になりました！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "ううっ……\nもう一滴も出ないと思ってたけど、みんなの顔を見たらまた涙が……。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "や、やめてよ。私まで泣いちゃうじゃない……ひぃん……。"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "ふふっ。せっかくのパーティーなんですから、一緒に楽しくお祝いしましょう！"
    },
    {
      "CharacterName": 2402650919,
      "Name": "アズサ",
      "Text": "あの二人は泣き虫だね。"
    },
    {
      "CharacterName": 4274692822,
      "Name": "ラナ",
      "Text": "他にもいろいろな側面がありますが、はぁ……今は泣き虫のようです。"
    },
    {
      "CharacterName": 2800662853,
      "Name": "アンナ&エリナ",
      "Text": "うあぁん！ありがとー！！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "あー！すっきりした！思いっきり暴れた後のパーティーってのも悪くねぇな！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "だろ？お前ら！"
    },
    {
      "CharacterName": 1185701049,
      "Name": "モモイ",
      "Text": "私たちの上であんだけ暴れたんだから、そりゃすっきりするでしょ……。"
    },
    {
      "CharacterName": 3353674757,
      "Name": "ユズ",
      "Text": "デコピンされたところが、たんこぶになってそう……。"
    },
    {
      "CharacterName": 1647715460,
      "Name": "ケイ",
      "Text": "アリスが何をしたって言うんですか！とばっちりです！"
    },
    {
      "CharacterName": 3797093869,
      "Name": "アリス",
      "Text": "チビメイド様は戦車より強いと思います！"
    },
    {
      "CharacterName": 484846910,
      "Name": "ミドリ",
      "Text": "銃を撃つのが違反じゃないなんて、このレースおかしい……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "文句ばっか言いやがって！勝負は勝負だろうがぁ！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "……ほんとに痛むのか？……悪ぃ。"
    },
    {
      "CharacterName": 1185701049,
      "Name": "モモイ",
      "Text": "痛いよ！！ひどすぎる！！ちゃんと謝って！！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "ちっ。たしかにやりすぎちまったかもな。悪か……。"
    },
    {
      "CharacterName": 1111474507,
      "Name": "ウタハ",
      "Text": "ここにいたのかい、ネル？プリズム戦車はどうだった？"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "あ、ちょっと待ってろお前ら。ウタハ、戦車は問題なかったぜ。"
    },
    {
      "CharacterName": 4079356321,
      "Name": "アスナ",
      "Text": "ビームがババーン！って出てくるの、すっごくかっこよかったよー！"
    },
    {
      "CharacterName": 1111474507,
      "Name": "ウタハ",
      "Text": "満足してもらえたなら、エンジニアとしては嬉しい限りだ。"
    },
    {
      "CharacterName": 1111474507,
      "Name": "ウタハ",
      "Text": "それでは、ここにサインを。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "ああ、そういや後払いだったな……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "あぁ？なんで2枚なんだよ？"
    },
    {
      "CharacterName": 1111474507,
      "Name": "ウタハ",
      "Text": "C&Cからの注文は2台だからさ。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "んなわけねーだろ！！1台しか……。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "おい、[ruby=あすま]飛鳥馬[/ruby]トキ。"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "はい、トキです。"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "いかがされましたか？"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "良い度胸じゃねぇか！堂々とC&C名義で決済しやがって！！"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "名案だと思ったのですが、\n先々のことまで考えが及ばなかったのは失敗でしたね。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "てめぇ、今日という今日は……！"
    },
    {
      "CharacterName": 2776394221,
      "Name": "トキ",
      "Text": "代筆していただいたネル先輩のサインは完璧だったのに……\nすみません、モモイ。"
    },
    {
      "CharacterName": 1185701049,
      "Name": "モモイ",
      "Text": "ああっ！！バラしちゃダメじゃん！！"
    },
    {
      "CharacterName": 1185701049,
      "Name": "モモイ",
      "Text": "……あっ！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "……ははっ。"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "当然、ボコられる覚悟はできてんだよなぁ？"
    },
    {
      "CharacterName": 942829409,
      "Name": "ゲーム開発部一同",
      "Text": "ぎゃあああああっ！"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "ん、花火。すごい。"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "というか今、悲鳴が聞こえなかった！？"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "ふぁあー……おじさんはパーティーより寝ていたいかなー。"
    },
    {
      "CharacterName": 3545855058,
      "Name": "ノノミ",
      "Text": "先輩！そんなこと言ってないで、一緒にパーティーを楽しみましょう☆"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "パジャマパーティーだったらよかったんだけどねー。"
    },
    {
      "CharacterName": 2615847832,
      "Name": "アヤネ",
      "Text": "みんな無事にレースを終えられたことは良かったのですが……。"
    },
    {
      "CharacterName": 2615847832,
      "Name": "アヤネ",
      "Text": "私たちの戦車、完全に壊れてしまいましたね。修理費はどうしましょう……？"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "砲身は壊れて、自力走行も2速ギアがやっとって……\nもうまともなトコないわね。"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "それなら問題ない。どうせタダだから。"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "タダってどういうこと？"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "これは、カイザーローンが校門の前に停めてたやつだから。"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "元に戻しておけばいいだけ。"
    },
    {
      "CharacterName": 2615847832,
      "Name": "アヤネ",
      "Text": "それって、まさか盗んできたってことですか？"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "無断駐車したってことは、その土地の持ち主が使うことに同意したってこと。"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "カイザーローンが不法投棄したゴミは、毎日私たちが片づけてるでしょ。"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "そ、それとこれとは違うでしょ！"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "昔のこと思い出すなぁー。"
    },
    {
      "CharacterName": 85542774,
      "Name": "ホシノ",
      "Text": "うちの後輩……どこかに行くと、いつも何か拾ってきてたよねー。"
    },
    {
      "CharacterName": 3545855058,
      "Name": "ノノミ",
      "Text": "恩返しする猫みたいでしたね☆"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "思い出に浸ってる場合じゃないでしょ！！"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "もう……これ、どうやって戻すの！？"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "簡単だよ。カイザーローンの戦車なんだし……。"
    },
    {
      "CharacterName": 532452930,
      "Name": "シロコ",
      "Text": "銀行の前に駐車しよう。"
    },
    {
      "CharacterName": 1089369137,
      "Name": "セリカ",
      "Text": "誤解されるわよ！！！"
    },
    {
      "CharacterName": 3431605305,
      "Name": "ネル",
      "Text": "待て！！"
    },
    {
      "CharacterName": 1185701049,
      "Name": "モモイ",
      "Text": "うわああぁぁん！！"
    },
    {
      "CharacterName": 1994093906,
      "Name": "コハル",
      "Text": "いやあぁ！！水着ハグはやめて！！"
    },
    {
      "CharacterName": 3972500147,
      "Name": "ハナコ",
      "Text": "えいっ♡えいっ♡"
    },
    {
      "CharacterName": 4200835236,
      "Name": "ヒフミ",
      "Text": "もう、泣くのはおしまいですよ～！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "わああぁぁん！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "ひいいぃぃん！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "こうして、ゲヘナカップは無事に幕を下ろしました！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "先生！最後に一言お願いします！"
    },
    {
      "Text": "[ns] \"うん！\""
    },
    {
      "Text": "[ns] \"青春だなぁ！\""
    }
  ],
  "DialogKR": [
    {
      "Text": "후일담;전사들의 낙원"
    },
    {
      "Text": "폐막 축하 파티"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "잇-츠!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "파티타임-! 이래!"
    },
    {
      "CharacterName": 3925286920,
      "Name": "마코토",
      "Text": "축하하기엔 이르다!! 이로하 녀석은 도망쳤고!! 옷 도둑은 잡지 못했잖나!!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "에이, 어쨌건 경기는 끝났잖아요! 좋은 게 좋은 거라구요!"
    },
    {
      "CharacterName": 954095842,
      "Name": "사츠키",
      "Text": "정말 이상하네, 분명 어제 받아왔을 때는 상자가 묵직했는데……."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "옷 도둑이라……. 게헨나도 경제적으로 넉넉한 곳은 아닌가 봐."
    },
    {
      "CharacterName": 3972500147,
      "Name": "하나코",
      "Text": "사람은 수영복 한 벌만 있어도 충분히 살아갈 수 있는데 말이죠."
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "너는 제대로 된 옷 좀 입어! 옷장에 불이라도 난 거야?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "경기 끝났으면 멀쩡한 옷 좀 입으라구, 왜 이번에도 수영복인데?!"
    },
    {
      "CharacterName": 3972500147,
      "Name": "하나코",
      "Text": "그렇지만, 아까 입은 수영복은 땀으로 셔츠까지 젖어버렸는걸요? 격식 있는 자리에는 청결하고 보송보송한 수영복이 매너에 맞죠."
    },
    {
      "CharacterName": 3972500147,
      "Name": "하나코",
      "Text": "아니면, 코하루 쨩은 제가 축축한 쪽이 더 좋으신 걸까요?"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "시, 싫어!! 다가오지 마!!"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "으아아아앙!!"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "아하하……. 그래도 다친 분 없이 무사히 경기가 끝나서 다행이에요."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "음?"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "너는, 그때의……."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "음."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "다시 만났으니, 적이군요."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "아아, 그래."
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "라나하고 똑같은 만화책을 보고 있나 보네~"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "동류는 동류를 알아보는 법이야."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "따지고 보면 저번에 한 번 더 만났기 때문에, 지금은 한 바퀴 돌아서 친구인 게 맞습니다."
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "불변의 법칙이지. 다시 만나면 적, 또다시 만나면 전우."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "그런 것치고, 저번에도 적보다는 아군이었지만요."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "안녕하세요, 183호 여러분!"
    },
    {
      "CharacterName": 3972500147,
      "Name": "하나코",
      "Text": "우승, 다시 한번 축하해요."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "히후미 씨! 하나코 씨! 어제도 오늘도, 정말 신세 많았어요!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "으읏……. 다 울었다고 생각했는데, 막상 다시 보니까 눈물이……."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "바, 바보야……. 나까지 눈물 나잖아, 히잉……."
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "후후! 좋은 날이잖아요! 다 같이 놀고 축하하면 되죠!"
    },
    {
      "CharacterName": 2402650919,
      "Name": "아즈사",
      "Text": "저 두 사람은 울보로군."
    },
    {
      "CharacterName": 4274692822,
      "Name": "라나",
      "Text": "그 이외에도 가지가지 하는 편입니다만, 일단 지금은 울보입니다."
    },
    {
      "CharacterName": 2800662853,
      "Name": "안나&에리나",
      "Text": "으아앙-! 고마워요-!!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "아-! 개운하다! 그래도 한바탕 날뛰고 파티하니까 좋네!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "그치? 꼬맹이들!"
    },
    {
      "CharacterName": 1185701049,
      "Name": "모모이",
      "Text": "우리 위에서 날뛰었으니까 개운하지……."
    },
    {
      "CharacterName": 3353674757,
      "Name": "유즈",
      "Text": "딱밤 맞은 이마에 혹 난 것 같은데요……."
    },
    {
      "CharacterName": 1647715460,
      "Name": "케이",
      "Text": "아리스는 무슨 잘못을 했다고 같이 혼낸 겁니까! 억울합니다!"
    },
    {
      "CharacterName": 3797093869,
      "Name": "아리스",
      "Text": "꼬마 메이드 씨, 탱크보다 더 센 것 같았습니다!"
    },
    {
      "CharacterName": 484846910,
      "Name": "미도리",
      "Text": "주먹으로 때리는 게 룰 위반이 아니라니, 이 경기 이상해."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "경기는 경기잖아! 불평하기는!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "……진짜 많이 아파? ……미안."
    },
    {
      "CharacterName": 1185701049,
      "Name": "모모이",
      "Text": "아파!! 너무 과했어!! 사과해라, 사과해!!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "끄응, 내가 너무 심했나, 그렇다면 미……."
    },
    {
      "CharacterName": 1111474507,
      "Name": "우타하",
      "Text": "여기 있었네, 네루. 프리즘 탱크는 어땠어?"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "아, 잠깐만. 우타하, 탱크는 문제없었어. 꽤 괜찮던데?"
    },
    {
      "CharacterName": 4079356321,
      "Name": "아스나",
      "Text": "빔이 빠바바-! 하고 나가는 게 엄청 멋있었어!"
    },
    {
      "CharacterName": 1111474507,
      "Name": "우타하",
      "Text": "만족했다니, 엔지니어로서 더할 나위 없이 기쁜걸."
    },
    {
      "CharacterName": 1111474507,
      "Name": "우타하",
      "Text": "그렇다면, 여기 대금 영수증에 서명해 줘."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "아차, 그렇지. 사용해 보고 결제하기로 했으니까……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "뭐야, 왜 영수증이 두 장이야?"
    },
    {
      "CharacterName": 1111474507,
      "Name": "우타하",
      "Text": "C&C에서 두 대를 주문했으니까?"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "뭔 소리야?! 우리는 한 대밖에 못 받았……."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "어이, 아스마 토키."
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "네, 토키입니다."
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "뭔가 용건이라도 있으신지요."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "깡 있네, 인마. C&C의 공금으로 당당하게 결제했다고?"
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "좋은 아이디어라고 생각했습니다만, 그 이후의 일은 생각하지 않았던 게 문제였군요."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "너, 진짜 오늘……."
    },
    {
      "CharacterName": 2776394221,
      "Name": "토키",
      "Text": "대필해 주신 네루 선배의 사인은 완벽했는데……. 죄송합니다, 모모이."
    },
    {
      "CharacterName": 1185701049,
      "Name": "모모이",
      "Text": "아앗!!! 일러바쳤겠다!!!"
    },
    {
      "CharacterName": 1185701049,
      "Name": "모모이",
      "Text": "……헉……!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "……하."
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "당연히, 맞을 거 각오하고 한 거지?"
    },
    {
      "CharacterName": 942829409,
      "Name": "게임개발부 전원",
      "Text": "끄아앙!"
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "응, 불꽃놀이. 멋있어."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "그런데, 비명 소리 들리지 않았어?"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "으하아암- 아저씨는 파티보다는 더 자고 싶은데-"
    },
    {
      "CharacterName": 3545855058,
      "Name": "노노미",
      "Text": "선배! 그러지 말고 같이 즐겨요, 파티☆"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "파티는 파자마 파티가 최고라구-"
    },
    {
      "CharacterName": 2615847832,
      "Name": "아야네",
      "Text": "다치지 않고 무사히 경기를 마쳐서 다행이긴 한데요……."
    },
    {
      "CharacterName": 2615847832,
      "Name": "아야네",
      "Text": "저희 전차, 완전히 망가졌는데 어떻게 하죠? 수리비가……."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "포신도 망가지고, 자력주행은 기어 2단으로 겨우 가능한데, 멀쩡한 게 없잖아?"
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "그거라면 문제없어. 어차피 공짜 전차였거든."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "공짜 전차? 그게 무슨 소리야?"
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "응, 카이저 론이 학교 후문에 세워뒀던 전차거든."
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "다시 원래 자리에 되돌려 놓으면 돼."
    },
    {
      "CharacterName": 2615847832,
      "Name": "아야네",
      "Text": "시로코 선배, 설마 전차를 훔쳐 온 거예요?!"
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "불법 주차를 했다는 건, 땅 주인이 마음껏 써도 된다는 동의라고 할 수 있어."
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "카이저론이 불법 투기한 쓰레기는 우리가 매일 치웠잖아."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "그, 그거랑 그거는 다른 거잖아! 내가 못 살아!"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "옛날 생각나는구먼-"
    },
    {
      "CharacterName": 85542774,
      "Name": "호시노",
      "Text": "우리 후배, 어디 나갔다 오면 항상 뭘 가지고 오곤 했었지-"
    },
    {
      "CharacterName": 3545855058,
      "Name": "노노미",
      "Text": "은혜 갚는 고양이 같았죠☆"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "추억에 젖지 말고!!"
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "으아……. 이걸 어떻게 돌려줘야 하지?!"
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "간단해. 카이저론 전차잖아."
    },
    {
      "CharacterName": 532452930,
      "Name": "시로코",
      "Text": "몰아서 은행에 갖다주자."
    },
    {
      "CharacterName": 1089369137,
      "Name": "세리카",
      "Text": "오해할 거라고!!!"
    },
    {
      "CharacterName": 3431605305,
      "Name": "네루",
      "Text": "거기 서!!"
    },
    {
      "CharacterName": 1185701049,
      "Name": "모모이",
      "Text": "끄아앙!!"
    },
    {
      "CharacterName": 1994093906,
      "Name": "코하루",
      "Text": "으아앙!! 수영복 허그 그마안!!"
    },
    {
      "CharacterName": 3972500147,
      "Name": "하나코",
      "Text": "에잇♡ 에잇♡"
    },
    {
      "CharacterName": 4200835236,
      "Name": "히후미",
      "Text": "자, 이제 뚝이에요, 뚝!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "와아앙-!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "히에에엥-!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "자! 이렇게, 게헨나 컵은 무사히 막을 내렸습니다!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "선생님! 소감 한 말씀 부탁드립니다!"
    },
    {
      "Text": "[ns] \"음!\""
    },
    {
      "Text": "[ns] \"청춘이구나!\""
    }
  ],
