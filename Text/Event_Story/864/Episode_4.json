{
  "TitleJP": "今からお互いに……（２）",
  "TitleKR": "지금부터 서로…… 2",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "戦車レースのはずが、なぜか砲撃戦に巻き込まれて困惑する183号の3人。ゲヘナカップのルールは「全ての的を砲撃して、最初にスタートラインまで戻ってくる」こと。裏を返せば、そのためには何をしてもいい、と183号は大混戦の中でイロハから教えてもらうのだった。",
  "DescKR": "충격적인 룰을 가지고 있던 게헨나 컵, 과연 어떻게 흘러가게 될지 183호는 혼란에 빠진다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "どうしてみんなこっちを撃ってくるの！？"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "分っかんないよ！？みんな、おかしくなっちゃったんだ！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "きゃあああっ！！！"
    },
    {
      "CharacterName": 814495898,
      "Name": "レーシングヘルメット団A",
      "Text": "キルマークにしてやるよ！！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "撃たないでください！撃たないでください！！うわあああん！！！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "反則～！これ反則だって～！"
    },
    {
      "CharacterName": 2311124724,
      "Name": "レーシングヘルメット団B",
      "Text": "往生際が悪いぞ！おとなしく……。"
    },
    {
      "CharacterName": 2311124724,
      "Name": "レーシングヘルメット団B",
      "Text": "ん？"
    },
    {
      "CharacterName": 2311124724,
      "Name": "レーシングヘルメット団B",
      "Text": "ぐはあっ！！！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "……。"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "……。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "う、うあっ……。"
    },
    {
      "CharacterName": 100999644,
      "Name": "？？？",
      "Text": "救護が必要な場に救護を！"
    },
    {
      "CharacterName": 541729462,
      "Name": "ミネ",
      "Text": "これより、移動式野戦病院にて、救護活動を開始します！"
    },
    {
      "CharacterName": 541729462,
      "Name": "ミネ",
      "Text": "私は悲しいです。\n理由もなく他人に暴力を行使するなんて……。"
    },
    {
      "CharacterName": 541729462,
      "Name": "ミネ",
      "Text": "救護が必要不可欠だと断定します。"
    },
    {
      "CharacterName": 541729462,
      "Name": "ミネ",
      "Text": "救護騎士団の信念と誇り、そして決意を皆さんにお伝えいたします！"
    },
    {
      "CharacterName": 667578093,
      "Name": "セリナ",
      "Text": "団長！次弾、装填しました！"
    },
    {
      "CharacterName": 541729462,
      "Name": "ミネ",
      "Text": "素晴らしいです、セリナ！ハナエ、次に救護が必要な方はどちらでしょう！"
    },
    {
      "CharacterName": 912463881,
      "Name": "ハナエ",
      "Text": "あっちにもこっちにもいます！"
    },
    {
      "CharacterName": 541729462,
      "Name": "ミネ",
      "Text": "もっと近くに寄せてください！私を、救護の場に！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "私たちを攻撃してた戦車が、あんなところまで飛んでいっちゃった！"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "うわあ～ん！怖いよぉ～！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "あ、あの戦車！！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "この前見た絶対王者！？"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "先日の風変わりな戦車……。"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "あなた方、スタートもしないで何をしてるんですか？"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "聞いてください！みんなが急に砲撃を始めたんです！"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "クーデターでも起きたのでしょうか！？"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "クーデターだなんて……ゲヘナでそんな複雑なことは起きませんよ。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "う、撃たないでくださいぃ……。\n私たちの戦車は装甲もしょぼいし、大したことないんです。うわあああん！"
    },
    {
      "CharacterName": 994664319,
      "Name": "万魔殿の部員A",
      "Text": "3時方向から敵の砲撃！跳弾したため被害はありません！"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "はぁ……。ちょっと待っていてください。"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "イロハ選手！敵の先制攻撃をものともせず、一発で制圧しました！"
    },
    {
      "CharacterName": 4149007208,
      "Name": "チアキ",
      "Text": "砲塔リングにしっかり差し込みましたね！さすがランキング1位！"
    },
    {
      "CharacterName": 2331895039,
      "Name": "イブキ",
      "Text": "痛そう～！"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "あなた方が余計なことをしなければ、こちらからは何もしません。面倒なので。"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "というか、本戦まで上がってきたのにルールも知らないんですか？"
    },
    {
      "CharacterName": 1887605445,
      "Name": "エリナ",
      "Text": "失礼な！知ってますよ！\n全ての的を砲撃して、最初にスタートラインまで戻ってくればいいんでしょ！"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "はい。それが唯一のルールです。"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "[ruby=・]最[/ruby][ruby=・]初[/ruby][ruby=・]に[/ruby]というのは……\n言い換えれば、前に他の戦車がいないということです。"
    },
    {
      "CharacterName": 2587043513,
      "Name": "アンナ",
      "Text": "それって、前を走るライバルの戦車を破壊するってことですか！？"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "そういうことです。ほら、モタモタしてるとやられますよ。"
    },
    {
      "CharacterName": 2806697779,
      "Name": "イロハ",
      "Text": "虎丸、前進！"
    },
    {
      "CharacterName": 1895183685,
      "Name": "183号特別クラス",
      "Text": "に……。"
    },
    {
      "CharacterName": 1895183685,
      "Name": "183号特別クラス",
      "Text": "逃げろー！！！"
    }
  ],
  "DialogKR": [
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "이게 무슨 일이야 대체?! 왜 우리를 쏘는 거야?!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "낸들 알아?! 갑자기 다들 미쳤나 봐!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "꺄악!!"
    },
    {
      "CharacterName": 814495898,
      "Name": "레이싱 헬멧단 A",
      "Text": "내 킬마크로 삼아주마!!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "쏘지 마세요!! 쏘지 마세요!! 으아앙!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "이거 반칙 아니야?! 갑자기 왜 쏘는 거냐구!!"
    },
    {
      "CharacterName": 2311124724,
      "Name": "레이싱 헬멧단 B",
      "Text": "괜히 저항하지 말고 얌전히……."
    },
    {
      "CharacterName": 2311124724,
      "Name": "레이싱 헬멧단 B",
      "Text": "응?"
    },
    {
      "CharacterName": 2311124724,
      "Name": "레이싱 헬멧단 B",
      "Text": "끄악!!!!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "……."
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "……."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "허, 허억……."
    },
    {
      "CharacterName": 100999644,
      "Name": "???",
      "Text": "구호가 필요한 곳에 구호를!!"
    },
    {
      "CharacterName": 541729462,
      "Name": "미네",
      "Text": "이동식야전병원이 이제부터 여러분 모두를 구호하겠습니다!"
    },
    {
      "CharacterName": 541729462,
      "Name": "미네",
      "Text": "슬픕니다……. 저는 진심으로 슬픕니다! 타인에게 이유 없이 불필요한 폭력을 행사하는 이 광경……."
    },
    {
      "CharacterName": 541729462,
      "Name": "미네",
      "Text": "이것이야말로 구호가 필요한 자리!"
    },
    {
      "CharacterName": 541729462,
      "Name": "미네",
      "Text": "구호기사단은 그런 여러분 모두에게, 신념과 긍지로 기사단의 의지를 전해드리도록 하겠습니다!"
    },
    {
      "CharacterName": 667578093,
      "Name": "세리나",
      "Text": "영-차! 장전했어요, 단장님!"
    },
    {
      "CharacterName": 541729462,
      "Name": "미네",
      "Text": "훌륭합니다, 세리나! 하나에, 다음 구호가 필요하신 분은 어디에 계신가요!"
    },
    {
      "CharacterName": 912463881,
      "Name": "하나에",
      "Text": "사방에 계세요!"
    },
    {
      "CharacterName": 541729462,
      "Name": "미네",
      "Text": "더 가까이 몰아주세요! 저를 구호의 현장으로!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "앞에 있던 전차, 저 멀리 날아가 버렸어!!"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "으아앙~! 무서워~!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "저, 저 회색 전차!!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "전에 본 1위라던 사람 아니야?!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "저번에 봤던 그 특이한 전차……."
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "당신들, 출발도 하지 않고 뭐 하고 있는 건가요?"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "그, 그게요. 갑자기 쏘고, 싸우고 있잖아요!"
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "뭔가 쿠데타라도 일어난 건가요?!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "쿠데타라니…… 게헨나에서 그런 복잡한 일을 할 리가 없잖아요."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "쏘, 쏘지 말아 주세요오……. 저희는 장갑도 얇아서 맛도 없어요, 으아앙-"
    },
    {
      "CharacterName": 994664319,
      "Name": "만마전 부원 A",
      "Text": "3시 방향 적 발포! 도탄되었습니다! 피해 없습니다!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "하아…… 잠시만요."
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "오옷 이로하 선수! 선제공격에 눈도 깜짝 안 하고 단 한 발의 응사로 제압했습니다!"
    },
    {
      "CharacterName": 4149007208,
      "Name": "치아키",
      "Text": "포탑링에 정확하게 꽂아 넣었네요! 역시 랭킹 1위!"
    },
    {
      "CharacterName": 2331895039,
      "Name": "이부키",
      "Text": "아프겠다아!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "당신들이 먼저 건드리지 않는다면 아무것도 안 해요. 귀찮으니까."
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "그보다, 본선까지 왔으면서 경기 규칙을 하나도 모르는 거예요?"
    },
    {
      "CharacterName": 1887605445,
      "Name": "에리나",
      "Text": "실례네요! 룰은 알거든요! 모든 과녁을 맞히고 먼저 출발선으로 돌아오면 된다고 했잖아요!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "네. 그게 유일한 룰이잖아요."
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "'가장 먼저'라는 건, 앞에 '다른 전차'가 없으면 된다는 거니까요."
    },
    {
      "CharacterName": 2587043513,
      "Name": "안나",
      "Text": "그래서 지금, 서로 1등 못 하게 하려고 전차를 격파하는 거라구요?!"
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "그런 거죠. 자, 꾸물대다간 당할 거예요."
    },
    {
      "CharacterName": 2806697779,
      "Name": "이로하",
      "Text": "토라마루, 전차 전진."
    },
    {
      "CharacterName": 1895183685,
      "Name": "183호 특별반",
      "Text": "도……."
    },
    {
      "CharacterName": 1895183685,
      "Name": "183호 특별반",
      "Text": "도망쳐!!!!"
    }
  ],
