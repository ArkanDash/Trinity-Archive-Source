{
  "TitleJP": "交渉決裂（２）",
  "TitleKR": "협상 결렬 2",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "「拝金のブローカー」の強さは想像を越えていた。しかし膝をつきそうになるも再起するマナミを見て、先生は勝つための指揮を開始する。",
  "DescKR": "브로커는 생각보다 강했다. 이에 선생님이 나서서 평의회를 위한 특별 지휘를 시작한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "……！"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "マナミ様……！ご無事ですか？"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": " ……ええ。まだ、戦えます。"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "マナミ様……。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "……何これ。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "舐めてんの？"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "この程度なら、最初から力で潰しとくんだった。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "とんだ無駄足じゃん。"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "さすがボス！お見事です！"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "さあ、評議会の皆様！もう諦めて、己の無力を受け入れるのです！"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "流通に関する権限を明け渡すだけ！簡単なことでしょう？"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "金が湯水のように流れ込む――\n利益第一の芸術学院へと生まれ変わらせて差し上げましょう！"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "……させません。"
    },
    {
      "Text": "[s1] \"うん。そんなことはさせない。\""
    },
    {
      "Text": "[s2] \"ここから指揮の仕方を変えるよ。\""
    },
    {
      "Text": "[ns] \"マナミが足首を気にせず、力を発揮できる形に。\""
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "……。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "先生……ご存じだったのですか？"
    },
    {
      "Text": "[s] \"うん。私の生徒のことだから。\""
    },
    {
      "Text": "[ns3] \"でも、このやり方はできれば避けたかった。\""
    },
    {
      "Text": "[ns4] \"マナミの過去に触れてしまうようで。\""
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "……ふふっ。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "構いません。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "過去のことは、もう気にしないと決めましたから。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "……指揮を変える？"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "そんなことで、あの雑魚どもが私に勝てるとでも思ってる？"
    },
    {
      "Text": "[s] \"雑魚じゃない。\""
    },
    {
      "Text": "[ns] \"大切な、私の生徒たちだ。\""
    }
  ],
  "DialogKR": [
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "……!"
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "마나미 님……! 괜찮으십니까?"
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "……괜찮습니다. 아직은 버틸 수 있어요."
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "마나미 님……."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "……뭐야, 이거."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "야. 장난해?"
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "이런 녀석들인 줄 알았다면 처음부터 힘으로 해결할걸."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "괜히 시간 낭비만 했잖아."
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "후후후, 역시 보스! 강하십니다!"
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "자! 평의회 여러분! 이제 포기하고 결과에 승복하십시오!"
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "학원의 모든 유통 권한을 우리에게 넘기는 겁니다!"
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "자금이 물처럼 흐르는, 아주 실리적인 예술학원으로 만들어 드리겠습니다!"
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "……그렇게 둘 순 없어요."
    },
    {
      "Text": "[s1] \"그래. 그렇게 둘 순 없어.\""
    },
    {
      "Text": "[s2] \"마나미. 지금부터 지휘 방법을 바꿀게.\""
    },
    {
      "Text": "[ns] \"발목이 불편한 마나미가, 최대한 활약할 수 있는 방법으로.\""
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "……."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "선생님. 알고 계셨던 건가요?"
    },
    {
      "Text": "[s] \"응. 내 학생에 대한 일이니까.\""
    },
    {
      "Text": "[ns3] \"그래도 이 방법은…….\""
    },
    {
      "Text": "[ns4] \"과거를 건드리는 것 같아서 최대한 하지 않으려 했는데.\""
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "……후후."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "괜찮습니다."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "과거 같은 건, 신경 쓰지 않기로 했으니까요."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "……지휘를 바꾸겠다?"
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "그런다고 저 오합지졸들이 날 이길 수 있을 거라 생각하나?"
    },
    {
      "Text": "[s] \"오합지졸이 아니야.\""
    },
    {
      "Text": "[ns] \"소중한, 내 학생들이야.\""
    }
  ],
