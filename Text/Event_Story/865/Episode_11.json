{
  "TitleJP": "交渉決裂（１）",
  "TitleKR": "협상 결렬 1",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "ブラックマーケットの組織員が寮監隊を足止めし、「拝金のブローカー」が評議会に対抗する。",
  "DescKR": "블랙마켓 조직원들이 사감대의 발을 묶고, 브로커가 단독으로 평의회를 상대한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第9話;交渉決裂"
    },
    {
      "CharacterName": 2935450294,
      "Name": "組織員A",
      "Text": "学院の武装組織と聞いて少しは期待したが……大したことねぇな。"
    },
    {
      "CharacterName": 2154389683,
      "Name": "組織員B",
      "Text": "油断するな。お前の悪い癖だ。"
    },
    {
      "CharacterName": 438449286,
      "Name": "組織員C",
      "Text": "油断するな。お前の悪い癖だ。"
    },
    {
      "CharacterName": 2935450294,
      "Name": "組織員A",
      "Text": "二人して同じこと言うな！"
    },
    {
      "CharacterName": 141212648,
      "Name": "ヒロミ",
      "Text": "あいつら……私たちを前にして、舐めた口を利いてくれるじゃないか……！"
    },
    {
      "CharacterName": 3254626457,
      "Name": "ミリア",
      "Text": "以前、耳にしたことがあります。\nブローカーの直属の部下は、いずれも選りすぐりの精鋭だと。"
    },
    {
      "CharacterName": 3254626457,
      "Name": "ミリア",
      "Text": "破格の報酬を受け取るほどの実力者ばかりを集めているそうです。"
    },
    {
      "CharacterName": 2935450294,
      "Name": "組織員A",
      "Text": "なあ？私たちがどうして顔を隠してるか分かるか？"
    },
    {
      "CharacterName": 2935450294,
      "Name": "組織員A",
      "Text": "全員、とんでもない懸賞金がかかってるんだ。\n裏に詳しけりゃ、顔を見ただけで分かるような猛者ばかり。"
    },
    {
      "CharacterName": 2154389683,
      "Name": "組織員B",
      "Text": "そんな私たちに、実力相応の値をつけたのはボスだけだった。"
    },
    {
      "CharacterName": 438449286,
      "Name": "組織員C",
      "Text": "ボスのとこは誰でも入れるような組織じゃねぇんだ。\n言ってみれば裏社会の一流企業ってところかな。"
    },
    {
      "CharacterName": 2935450294,
      "Name": "組織員A",
      "Text": "で、お前らの給料はどうなんだ？\nこっちの半分くらいは貰ってんのか？"
    },
    {
      "CharacterName": 141212648,
      "Name": "ヒロミ",
      "Text": "うるさい！金目当てで寮監隊にいるとは思わないことだ！"
    },
    {
      "CharacterName": 3254626457,
      "Name": "ミリア",
      "Text": "……エスコートされたとあれば、こちらも、少し本気でお相手しましょうか。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "そうだね。手加減するのはもう十分かな。"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "……寮監隊の方は思っていた以上に長引いていますね。"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "予測では、とうに決着がついているはずなのですが……。"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "どうやら、ただの雑兵ではないようです。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "……。"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "ふふふ、我々は一騎当千の猛者ばかり！"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "大規模学園の武装組織と互角に渡り合えるほどなのですよ。"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "強くなければ生き残れない。この世界は弱肉強食……！"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "皆様が歯向かっているのは、そんな精鋭を従える――我らがボス！\n勝ち目などありませんよ！"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "さあ、今ならまだ遅くありません。\n大人しくひれ伏して、こちらの条件を受け入れるというのなら――！"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "邪魔。"
    },
    {
      "CharacterName": 3905779942,
      "Name": "ブラックマーケット幹部",
      "Text": "くぁっ……！"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "喋りすぎ。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "時は金なり、だからね。"
    },
    {
      "Text": "[s] \"本当に、何でもお金で考えるんだね。\""
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "そうやって生きてきたから。"
    },
    {
      "Text": "[s] \"この世には、お金じゃ解決できないこともあるよ。\""
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "……。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "だから？"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "それ、今日聞いた中で、一番ムカつくんだけど。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "お礼に、すぐ楽にしてあげる。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "アンタたち、逃げ道を塞いで。"
    },
    {
      "CharacterName": 29117215,
      "Name": "拝金のブローカー",
      "Text": "私を怒らせた分、利子つけて払ってもらうよ。"
    }
  ],
  "DialogKR": [
    {
      "Text": "제9화;협상 결렬"
    },
    {
      "CharacterName": 2935450294,
      "Name": "조직원 A",
      "Text": "흥, 학원의 무력 조직이라 대단할 줄 알았더니 별거 아니군."
    },
    {
      "CharacterName": 2154389683,
      "Name": "조직원 B",
      "Text": "자만하지 마. 너의 안 좋은 버릇이야."
    },
    {
      "CharacterName": 438449286,
      "Name": "조직원 C",
      "Text": "자만하지 마. 너의 안 좋은 버릇이야."
    },
    {
      "CharacterName": 2935450294,
      "Name": "조직원 A",
      "Text": "알았으니까 둘이 똑같이 말하지 말라고!"
    },
    {
      "CharacterName": 141212648,
      "Name": "히로미",
      "Text": "저 녀석들, 우리를 앞에 두고 농담하고 있잖아……!"
    },
    {
      "CharacterName": 3254626457,
      "Name": "미리아",
      "Text": "어디선가 들어본 적이 있어요. 브로커의 직속 부하들은 모두가 정예라고."
    },
    {
      "CharacterName": 3254626457,
      "Name": "미리아",
      "Text": "이쪽 세계에서도 엄청난 보수를 받는 뛰어난 자들만을 모았다고요."
    },
    {
      "CharacterName": 2935450294,
      "Name": "조직원 A",
      "Text": "키킥…… 너희들, 왜 우리가 얼굴을 가리고 있는지 알아?"
    },
    {
      "CharacterName": 2935450294,
      "Name": "조직원 A",
      "Text": "다들 엄청난 현상금이 걸려 있거든. 이 바닥에 관심이 있다면 한눈에 알아보는 강자들이지."
    },
    {
      "CharacterName": 2154389683,
      "Name": "조직원 B",
      "Text": "그런 우리 실력에 걸맞은 몸값을 맞춰준 사람은 보스뿐이었어."
    },
    {
      "CharacterName": 438449286,
      "Name": "조직원 C",
      "Text": "여긴 아무나 올 수 없다고. 이쪽 세계의 엘리트 기업이라고 할까. 크크큭."
    },
    {
      "CharacterName": 2935450294,
      "Name": "조직원 A",
      "Text": "너희 보수는 어때? 우리 절반은 되냐?"
    },
    {
      "CharacterName": 141212648,
      "Name": "히로미",
      "Text": "시끄러, 이 범죄자 놈들아! 누가 보수를 원해서 사감대에 온 줄 알아?!"
    },
    {
      "CharacterName": 3254626457,
      "Name": "미리아",
      "Text": "아무래도, 좀 더 진지하게 싸워야겠네요."
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "그래. 대충 싸우는 건 그만둘래."
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "……으으, 사감대 쪽의 전투가 생각보다 길게 이어지고 있네요."
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "이상하군요. 계산대로라면 벌써 끝나야 했는데."
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "아무래도 평범한 조무래기들이 아닌 모양입니다."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "……."
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "후후후, 우리 병력은 다들 거물급이죠."
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "평균적인 전투력은 대형 학원의 무력 집단과 대등한 정도입니다."
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "그 정도의 실력이 없으면 이 바닥에서 오래 못 버티거든요."
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "그런 병력이 따르는 우리 보스입니다! 당신들은 절대 못 이겨요!"
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "자, 지금이라도 늦지 않았습니다. \n바닥에 납작 엎드리고 우리의 조건을 순순히 받아들이신다면……!"
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "야. 꺼져."
    },
    {
      "CharacterName": 3905779942,
      "Name": "블랙마켓 간부",
      "Text": "꾸엣……!"
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "부하 놈이 말이 많군."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "시간은 돈인데 말이야."
    },
    {
      "Text": "[s] \"넌…… 모든 걸 돈으로 비유하는구나?\""
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "그렇게 살아왔으니까."
    },
    {
      "Text": "[s] \"이 세상엔 돈으로 해결할 수 없는 것도 있어.\""
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "……."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "제법이군."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "오늘 들었던 것 중에서 제일 짜증 나는 이야기였어."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "그 보답으로 최대한 빨리 끝내주지."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "얘들아. 퇴로를 막아라."
    },
    {
      "CharacterName": 29117215,
      "Name": "배금의 브로커",
      "Text": "날 화나게 한 대가를 치르게 해주마."
    }
  ],
