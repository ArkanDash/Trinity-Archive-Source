{
  "TitleJP": "ブラックマーケット調査（１）",
  "TitleKR": "블랙마켓 조사 1",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "調査のため、寮監隊を伴ってブラックマーケットに乗り込んだ芸術評議会。早々にスケバンから絡まれると、マナミは寮監長のサヨに対応を命じる。",
  "DescKR": "블랙마켓에서 불량배들과 조우한다. 마나미가 사감대장 사요에게 처리를 명령한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第3話;ブラックマーケット調査"
    },
    {
      "Text": "（次の日）"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "ここ……かな？"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "書記官が言っていたブラックマーケットは。"
    },
    {
      "CharacterName": 141212648,
      "Name": "ヒロミ",
      "Text": "……隊長。\nブラックマーケットはこうも簡単に来られる場所なんですか？"
    },
    {
      "CharacterName": 141212648,
      "Name": "ヒロミ",
      "Text": "もっと人目につかない所に隠れているものだとばかり。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "普通の生徒が、モモフレンズのグッズを探しに来るらしいよ。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "スケバンから身を守れるだけの力は持っているんだろうけど。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "それにしても……こんな場所を最初に作ったのは誰なんだろう。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "一度、ゆっくりお話してみたいな。"
    },
    {
      "CharacterName": 141212648,
      "Name": "ヒロミ",
      "Text": "それは私も気になりますね。無法地帯の元祖はどこの誰なんだか。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "ふふっ、皆さんやる気に満ちていて何よりです。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "さっそく調査を始めましょうか。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "可能な限り多くの芸術品を回収し、学院へ持ち帰るのです。"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "り、寮監隊の皆さん……どうか、よろしくお願いします……。"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "当のウララ様には、あまり覇気を感じませんが……。"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "こ、こういう場所はどうにも慣れなくて……。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "優しすぎるところはウララ副会長の長所であり短所ですね。\nもう少し自信をお持ちなさい。"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "ふむ……ウララ様。\nこう叫んでみるのはいかがでしょう。"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "貴様らァ！！全員まとめてかかってこい――っ！！"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "えぇっ……！？"
    },
    {
      "CharacterName": 132621487,
      "Name": "カノン",
      "Text": "さあ、ウララ様も。\nマナミ様のお言葉通り、まずは自信を持つことですよ。"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "き、ききき、きさまらぁ～！\nぜ、ぜぜ、全員まとめて……かかって……かかって、きて、ください……！"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "ふふっ、その意気です。"
    },
    {
      "Text": "[ns] \"みんな、向こうから誰か来るよ？\""
    },
    {
      "CharacterName": 1761870018,
      "Name": "スケバンA",
      "Text": "何だ？ワイルドハントの優等生どもじゃねぇか。"
    },
    {
      "CharacterName": 2080377079,
      "Name": "スケバンB",
      "Text": "おい、てめぇら！人のシマで何してやがる！？"
    },
    {
      "CharacterName": 3861431074,
      "Name": "スケバンC",
      "Text": "目障りなんだよ、痛い目見る前にとっとと失せな……！！"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "あら。初手から活きのいい獲物が餌にかかりましたね。"
    },
    {
      "CharacterName": 2186105748,
      "Name": "ウララ",
      "Text": "わ、わたくしは餌だったのですか……！？"
    },
    {
      "CharacterName": 1761870018,
      "Name": "スケバンA",
      "Text": "てめぇら……うちらを前にして、ふざけてんのか！？"
    },
    {
      "CharacterName": 2080377079,
      "Name": "スケバンB",
      "Text": "舐めた真似したツケ、きっちり払わせてやる……！"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "さて。代償を払うのはどちらでしょうね。"
    },
    {
      "CharacterName": 1522647268,
      "Name": "マナミ",
      "Text": "サヨ寮監隊長。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "私の出番だね。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "準備はいい？"
    },
    {
      "CharacterName": 1761870018,
      "Name": "スケバンA",
      "Text": "な、何だよ……？"
    },
    {
      "CharacterName": 2080377079,
      "Name": "スケバンB",
      "Text": "こいつ、圧が急に――！"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "それじゃあ……。"
    },
    {
      "CharacterName": 1751237262,
      "Name": "サヨ",
      "Text": "みんなで楽しく「お話」しようか。"
    }
  ],
  "DialogKR": [
    {
      "Text": "제3화;블랙마켓 조사"
    },
    {
      "Text": "(다음 날.)"
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "으음, 여기구나?"
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "서기관이 말한, 예술품을 취급하는 블랙마켓이."
    },
    {
      "CharacterName": 141212648,
      "Name": "히로미",
      "Text": "……대장. 블랙마켓이라는 곳이 이렇게 쉽게 올 수 있는 곳이었습니까?"
    },
    {
      "CharacterName": 141212648,
      "Name": "히로미",
      "Text": "좀 더 은밀한 곳에 숨어 있어야 하는 거 아니야?"
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "일반 학생이 모모프렌즈 굿즈를 구하러 올 정도로 말이야."
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "물론 불량배들에게서 자신을 지킬 힘 정도는 있어야겠지."
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "대체 누가 이런 곳을 만들었을까. 만나서 대화를 나눠보고 싶네."
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "궁금한 게 너무 많아."
    },
    {
      "CharacterName": 141212648,
      "Name": "히로미",
      "Text": "그건 저도 궁금하네요. 대체 어떤 녀석이 불법의 시초였을까."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "후후, 다들 의욕적인 모습이 보기 좋군요."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "자, 어서 조사를 시작하도록 하죠."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "가능하면 많은 예술품을 회수해 학원으로 가져가는 거예요."
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "사, 사감대 여러분…… 들으셨죠? 모두 힘내 주세요……."
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "정작 우라라 님은 별로 힘이 나지 않으시는 눈치입니다만……."
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "이, 이런 곳은 왠지 익숙하지 않아서……."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "너무 순한 것이 우라라 부회장의 흠입니다. 조금 더 자신감을 가지세요."
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "그렇다면…… 우라라 님. 이렇게 외쳐보는 건 어떨까요?"
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "다 덤벼 짜식들아!!"
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "……?!"
    },
    {
      "CharacterName": 132621487,
      "Name": "카논",
      "Text": "자. 해보는 겁니다. 마나미 님의 말씀처럼 자신감을 가지는 거예요."
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "다, 다 다 덤비세요……! 짜식들아……!!"
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "후후, 좋습니다. 바로 그 기세입니다."
    },
    {
      "Text": "[ns] \"다들, 저쪽에서 누군가가 오는데?\""
    },
    {
      "CharacterName": 1761870018,
      "Name": "불량배 A",
      "Text": "뭐야? 와일드헌트의 범생이들이잖아?"
    },
    {
      "CharacterName": 2080377079,
      "Name": "불량배 B",
      "Text": "어이! 네놈들! 우리 구역에서 뭐 하는 거야?!"
    },
    {
      "CharacterName": 3861431074,
      "Name": "불량배 C",
      "Text": "재수 없으니까 좋은 말로 할 때 꺼져……!!"
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "이런. 시작부터 상대가 미끼를 물었군요."
    },
    {
      "CharacterName": 2186105748,
      "Name": "우라라",
      "Text": "저, 저는 미끼였던 건가요……?!"
    },
    {
      "CharacterName": 1761870018,
      "Name": "불량배 A",
      "Text": "이 자식들, 지금 우리 앞에서 장난치고 있어?!"
    },
    {
      "CharacterName": 2080377079,
      "Name": "불량배 B",
      "Text": "우릴 무시한 대가를 치르게 해주마……!"
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "글쎄요? 대가를 치르는 건 누구일지."
    },
    {
      "CharacterName": 1522647268,
      "Name": "마나미",
      "Text": "사요 사감대장."
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "이제 내 차례구나?"
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "다들 준비는 됐니?"
    },
    {
      "CharacterName": 1761870018,
      "Name": "불량배 A",
      "Text": "뭐, 뭐야 저 녀석……?"
    },
    {
      "CharacterName": 2080377079,
      "Name": "불량배 B",
      "Text": "부, 분위기가……!"
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "자, 그럼……"
    },
    {
      "CharacterName": 1751237262,
      "Name": "사요",
      "Text": "즐거운 <대화>의 시간이야."
    }
  ],
