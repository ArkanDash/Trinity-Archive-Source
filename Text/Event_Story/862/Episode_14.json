{
  "TitleJP": "ゲヘナに行くと",
  "TitleKR": "게헨나에 가면",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "ついに、ゲヘナカップの本戦会場に到着した183号特別クラス一行。数多くのライバルと、戦車レースの絶対王者であるイロハに出会うのだった。",
  "DescKR": "마침내 게헨나 컵 본선 경기장에 도착한 183호 일행. 그 곳에서 수많은 경쟁자들과, 전차레이싱 최고의 강자를 만나게 된다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "後日談その1;ゲヘナに行くと"
    },
    {
      "Text": "ゲヘナカップ競技場"
    },
    {
      "Name": "ラナ",
      "Text": "到着。"
    },
    {
      "Name": "エリナ",
      "Text": "腰、痛～！椅子のクッション、もっと柔らかくしとけば良かった！"
    },
    {
      "Name": "アンナ",
      "Text": "見て、戦車がいっぱいある！私、ちょっと行ってくるわね！！"
    },
    {
      "Name": "エリナ",
      "Text": "待って、一緒に行こー！！"
    },
    {
      "Name": "マコト",
      "Text": "キキキッ……。この得体のしれない車は何だ？"
    },
    {
      "Name": "マコト",
      "Text": "レッドウィンターの奴らだな。キキッ……ゲヘナカップによくぞ来て――"
    },
    {
      "Name": "ラナ",
      "Text": "駐車係さんですね。よろしくお願いします。"
    },
    {
      "Name": "マコト",
      "Text": "？？？"
    },
    {
      "Name": "アンナ",
      "Text": "おおー……！"
    },
    {
      "Name": "アンナ",
      "Text": "強敵だらけの予感がするわね……！"
    },
    {
      "Name": "エリナ",
      "Text": "どの戦車もかっこいいねぇ……。"
    },
    {
      "Name": "アンナ",
      "Text": "子犬号だって負けてないわ！通行料も割引してもらったんだから！"
    },
    {
      "Name": "エリナ",
      "Text": "それはサイズが小さいからでしょ……。"
    },
    {
      "Name": "アンナ",
      "Text": "ねえ！あそこ！見にいくわよ！"
    },
    {
      "Name": "エリナ",
      "Text": "速っ！ちょっと待ってよー！！"
    },
    {
      "Name": "アンナ",
      "Text": "垂直装甲なのに、防御力が高そう……。"
    },
    {
      "Name": "アンナ",
      "Text": "……砲は88ミリ。見事な戦車ね。"
    },
    {
      "Name": "エリナ",
      "Text": "すご～い。めっちゃ重そうだけど、ちゃんと動くのかな？"
    },
    {
      "Name": "アンナ",
      "Text": "一緒に写真でも撮るのはどう？ "
    },
    {
      "Name": "エリナ",
      "Text": "う～ん……でも、持ち主が出てきたらマズイからな～"
    },
    {
      "Name": "イロハ",
      "Text": "何ですか。あなた方は。"
    },
    {
      "Name": "アンナ",
      "Text": "うわあっ！！本当に出てきた！！"
    },
    {
      "Name": "エリナ",
      "Text": "そりゃいるでしょ！？"
    },
    {
      "Name": "イロハ",
      "Text": "まるで幽霊でも見たような顔ですね……。"
    },
    {
      "Name": "イロハ",
      "Text": "危ないので戦車から離れていてください。"
    },
    {
      "Name": "アンナ",
      "Text": "は、はいっ！すみません！！"
    },
    {
      "Name": "エリナ",
      "Text": "もぉ～！めっちゃ恥ずかしいんだけど！"
    },
    {
      "Name": "ラナ",
      "Text": "私たちの戦車、別のところに止めたほうがいいかも。"
    },
    {
      "Name": "ラナ",
      "Text": "変なところに駐車されてる。何回か車体を擦ってたし。"
    },
    {
      "Name": "エリナ",
      "Text": "操縦席を戦闘室に移したのがマズかったかなー？"
    },
    {
      "Name": "アンナ",
      "Text": "それは仕方ないでしょ。\nそうだラナ、エンジンが大きくなったから……操縦席、狭くて暑かったでしょ？"
    },
    {
      "Name": "ラナ",
      "Text": "ううん。ちょうど良かったよ。暖かくて、よく眠れた。"
    },
    {
      "Name": "エリナ",
      "Text": "それ、運転の時に一番ダメなやつじゃない！？"
    },
    {
      "Name": "イロハ",
      "Text": "ふむ……。"
    },
    {
      "Name": "イロハ",
      "Text": "奇抜な発想の戦車……。"
    },
    {
      "Name": "イロハ",
      "Text": "あなた方、面白いですね。"
    },
    {
      "Name": "クロノスの記者生徒",
      "Text": "イロハ選手！本大会の絶対王者として、コメントをお願いします！"
    },
    {
      "Name": "イロハ",
      "Text": "はあ……これだから外に出たくなかったんです。"
    },
    {
      "Name": "イロハ",
      "Text": "ここは人が多いので、あちらに移動しましょう。"
    },
    {
      "Name": "エリナ",
      "Text": "え？あの人、絶対王者だったの？"
    },
    {
      "Name": "エリナ",
      "Text": "じっとこっちを見てくるから、何かと思ってたけど……。"
    },
    {
      "Name": "エリナ",
      "Text": "あんな立派な戦車に比べたら、こっちのはヘンテコだと思うよね～"
    },
    {
      "Name": "アンナ",
      "Text": "せ……。"
    },
    {
      "Name": "エリナ",
      "Text": "あっ、怒らないで。バカにしてる感じはしなかったし――"
    },
    {
      "Name": "アンナ",
      "Text": "戦車って言ってくれた！！"
    },
    {
      "Name": "アンナ",
      "Text": "ほら！やっぱり誰がどう見ても戦車よ！！あの人、見る目あるわね！！"
    },
    {
      "Name": "アンナ",
      "Text": "私って、ほんとに天才！"
    },
    {
      "Name": "エリナ",
      "Text": "あ、あはは……。アンナが嬉しそうで何よりだよ……。"
    }
  ],
  "DialogKR": [
    {
      "Text": "후일담;게헨나에 가면"
    },
    {
      "Text": "게헨나 컵 경기장"
    },
    {
      "Name": "라나",
      "Text": "도착."
    },
    {
      "Name": "에리나",
      "Text": "허리 아파- 의자에 쿠션 좀 푹신하게 만들걸!"
    },
    {
      "Name": "안나",
      "Text": "전차가 잔뜩!! 나, 구경하고 올게!!"
    },
    {
      "Name": "에리나",
      "Text": "야, 같이 가-!!"
    },
    {
      "Name": "마코토",
      "Text": "키키킥……. 이 괴상하기 짝이 없는 수레는 뭐지?"
    },
    {
      "Name": "마코토",
      "Text": "붉은겨울 녀석들이로구나. 키킥……. 게헨나 컵에 용케도 왔-"
    },
    {
      "Name": "라나",
      "Text": "주차요원이시군요. 잘 부탁드립니다."
    },
    {
      "Name": "마코토",
      "Text": "???"
    },
    {
      "Name": "안나",
      "Text": "오오오……!"
    },
    {
      "Name": "안나",
      "Text": "다들, 엄청난 호적수의 예감!"
    },
    {
      "Name": "에리나",
      "Text": "전차도 하나같이 그럴듯하고 멋있네……."
    },
    {
      "Name": "안나",
      "Text": "강아지호도 엄청 멋있거든! 주차 요금도 할인받았잖아!"
    },
    {
      "Name": "에리나",
      "Text": "그건 강아지호가 작아서 그런 거고……."
    },
    {
      "Name": "안나",
      "Text": "와앗!! 저거!! 저거 구경하러 가자!!"
    },
    {
      "Name": "에리나",
      "Text": "애야, 무슨? 왜 이리 신났어! 같이 가!!"
    },
    {
      "Name": "안나",
      "Text": "수직장갑인데도, 방어력이 높아 보여……."
    },
    {
      "Name": "안나",
      "Text": "……포는 88mm인가, 이 전차, 놀라워."
    },
    {
      "Name": "에리나",
      "Text": "대단해~ 엄청 무거워 보이는데 잘 움직이려나?"
    },
    {
      "Name": "안나",
      "Text": "같이 셀카로 사진이라도 찍을까?"
    },
    {
      "Name": "에리나",
      "Text": "으음- 그런데, 주인 나타나면 부끄러울 것 같은데~"
    },
    {
      "Name": "이로하",
      "Text": "뭔가요. 당신들."
    },
    {
      "Name": "안나",
      "Text": "으갹!! 진짜 나타났다!!"
    },
    {
      "Name": "에리나",
      "Text": "그럼 주인이 있겠지, 없었겠어?!"
    },
    {
      "Name": "이로하",
      "Text": "사람을 보고 뭔 귀신이라도 본 것처럼……."
    },
    {
      "Name": "이로하",
      "Text": "위험하니까 전차 곁에는 서지 말아요."
    },
    {
      "Name": "안나",
      "Text": "네, 넵!! 죄송합니다!!!"
    },
    {
      "Name": "에리나",
      "Text": "부끄러워 죽겠어, 진짜!"
    },
    {
      "Name": "라나",
      "Text": "우리 전차, 다른 데 다시 대야겠다. 거기 주차 자리 없어?"
    },
    {
      "Name": "라나",
      "Text": "맡겨 놨더니 이상하게 주차해 놨어. 옆에도 긁혔고."
    },
    {
      "Name": "에리나",
      "Text": "전투실로 운전석을 옮겨서 그런 건가-?"
    },
    {
      "Name": "안나",
      "Text": "어쩔 수 없다구. 그러고 보니 라나, 엔진이 커져서 좁고 더웠었지?"
    },
    {
      "Name": "라나",
      "Text": "난 좋던데. 엔진 옆에 있으면 따듯해서 잠도 잘 왔어."
    },
    {
      "Name": "에리나",
      "Text": "운전할 때 제일 안 좋은 거 아냐?!"
    },
    {
      "Name": "이로하",
      "Text": "흐음……."
    },
    {
      "Name": "이로하",
      "Text": "발상이 특이한 전차……."
    },
    {
      "Name": "이로하",
      "Text": "재미있겠군요. 당신들."
    },
    {
      "Name": "크로노스 기자",
      "Text": "이로하 선수! 전차대회 부동의 1위로서 잠시 인터뷰 좀 부탁드립니다!"
    },
    {
      "Name": "이로하",
      "Text": "하아…… 이래서 차 밖으로 나오기 싫었던 건데."
    },
    {
      "Name": "이로하",
      "Text": "여기는 혼잡하니 인터뷰는 저기서 하시죠."
    },
    {
      "Name": "에리나",
      "Text": "뭐야 저 사람? 1위라고?"
    },
    {
      "Name": "에리나",
      "Text": "뭔가 우리를 지긋이 쳐다보고. 기분이 묘한데……."
    },
    {
      "Name": "에리나",
      "Text": "저런 그럴듯한 전차에 비하면, 역시 강아지호는 우스운가~"
    },
    {
      "Name": "안나",
      "Text": "저……."
    },
    {
      "Name": "에리나",
      "Text": "앗, 너무 화내지는 말고. 딱히 뭔가 비웃는 느낌은 아니었으니-"
    },
    {
      "Name": "안나",
      "Text": "전차라고 해줬어!!"
    },
    {
      "Name": "안나",
      "Text": "거봐! 역시 누가 봐도 전차지!! 저 사람, 보는 눈이 있네!!"
    },
    {
      "Name": "안나",
      "Text": "역시 난 천재야!"
    },
    {
      "Name": "에리나",
      "Text": "아, 아하하…… 네가 행복하다니 됐다……."
    }
  ],
