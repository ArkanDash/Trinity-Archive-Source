  "DialogJP": [
    {
      "Text": "第3話;水遊びと査察、総合的に休暇（１）"
    },
    {
      "Name": "シュン",
      "Text": "川は、「文明のゆりかご」とも言えます。"
    },
    {
      "Name": "シュン",
      "Text": "遥か昔から農業や交通、暮らしの拠点として多くの役割を果たしてきました。"
    },
    {
      "Name": "キサキ",
      "Text": "そうじゃな。そして、山海経にとっても大きな意味を持つ。"
    },
    {
      "Name": "キサキ",
      "Text": "例えば、「治める」という字。本来は、水の流れを調整するという意味だったのじゃ。"
    },
    {
      "Name": "キサキ",
      "Text": "洪水の後、境界線が曖昧になった土地を如何にして再分配するかが大事だったそうじゃな。"
    },
    {
      "Name": "シュン",
      "Text": "このことから、治水とは即ち、世を治めるという意味に拡張されたのです。"
    },
    {
      "Name": "シュン",
      "Text": "この査察が渓谷で行われるのも、何かしらの意味を感じますね。"
    },
    {
      "Text": "[ns] \"わぁ……。\""
    },
    {
      "Name": "ルミ",
      "Text": "どう？先生。いいところでしょ。\nしばらくここで待っててくれる？"
    },
    {
      "Name": "ルミ",
      "Text": "あたしたちは水着に着替えてくるから。\nふふっ、楽しみにしててね？"
    },
    {
      "Text": "（楽しそうに走っていく後ろ姿を眺めながら）"
    },
    {
      "Text": "（自分なりの準備をして待つことにした）"
    },
    {
      "Name": "？？？",
      "Text": "ココナちゃん？\nはしゃぎすぎて転ばないように気をつけてくださいね。"
    },
    {
      "Name": "？？？",
      "Text": "大丈夫！私はもう立派なレディーだから！"
    },
    {
      "Name": "ココナ",
      "Text": "先生ー！！！"
    },
    {
      "Text": "[s] \"ココナちゃん！\""
    },
    {
      "Name": "ココナ",
      "Text": "もう！またココナちゃんって呼んで～！"
    },
    {
      "Name": "ココナ",
      "Text": "でも、それも今日までです！\n私はもう立派なレディーですから！"
    },
    {
      "Text": "[s] \"おぉっ！すっごく大人っぽい！\""
    },
    {
      "Name": "ココナ",
      "Text": "ふふん、当然です！"
    },
    {
      "Name": "ココナ",
      "Text": "って！違います！\n大人[ruby=・]っ[/ruby][ruby=・]ぽ[/ruby][ruby=・]い[/ruby]ではありません！レディーです！"
    },
    {
      "Name": "ココナ",
      "Text": "えっへん！レディーな私に似合う水着を用意したんですよ。"
    },
    {
      "Text": "[ns] （そういうところがココナちゃんだよね！）"
    },
    {
      "Text": "（喜びを隠しきれていないココナちゃんに……）"
    },
    {
      "Text": "（高い高いをしてあげた！）"
    },
    {
      "Name": "ココナ",
      "Text": "わあ！あははっ！"
    },
    {
      "Name": "ココナ",
      "Text": "先生！すごいです！"
    },
    {
      "Name": "ルミ",
      "Text": "お～、ココナちゃん、楽しんでるね。"
    },
    {
      "Name": "ココナ",
      "Text": "ルミお姉さんまで「ちゃん付け」だなんて……！"
    },
    {
      "Name": "ルミ",
      "Text": "だって、あたしたちは査察に来てるんだから。"
    },
    {
      "Name": "ルミ",
      "Text": "できる限り「普通の生徒」を装うべきでしょ？"
    },
    {
      "Name": "ココナ",
      "Text": "あ、たしかに……！"
    },
    {
      "Name": "ココナ",
      "Text": "仕方ありませんね！\n特別にココナちゃん呼びを許可します！"
    },
    {
      "Name": "ルミ",
      "Text": "うん、うん。やっぱりココナちゃんは大人だなぁ。"
    },
    {
      "Name": "ココナ",
      "Text": "当然です！ルミお姉さんも分かってますね！"
    },
    {
      "Name": "ルミ",
      "Text": "それで……どう？"
    },
    {
      "Text": "[s] \"な、何が？\""
    },
    {
      "Name": "ルミ",
      "Text": "ここでとぼけられるのは、ちょ～っと寂しいなぁ。"
    },
    {
      "Name": "ルミ",
      "Text": "先生のリクエスト、反映したつもりだけど……？"
    },
    {
      "Text": "[s] \"私、リクエストしたっけ……？\""
    },
    {
      "Name": "ルミ",
      "Text": "してなくてもさ、あたしたちの仲でしょ？"
    },
    {
      "Name": "ルミ",
      "Text": "先生の好きそうなやつにしたんだけど……どうかな。"
    },
    {
      "Text": "[s1] \"なんで私の好みが分かったの……すごく良い。\""
    },
    {
      "Text": "[s2] \"うん、良いと思うよ。すごく似合ってる。\""
    },
    {
      "Name": "ルミ",
      "Text": "え、うん。ありがとう。"
    },
    {
      "Name": "ルミ",
      "Text": "や、あはは……率直な反応されると照れちゃうね。"
    },
    {
      "Name": "ルミ",
      "Text": "これだから先生は……。"
    },
    {
      "Name": "ルミ",
      "Text": "ま、今日のところはこれで良しかな。"
    },
    {
      "Name": "ルミ",
      "Text": "あらら、大人な対応。残念。"
    },
    {
      "Name": "ルミ",
      "Text": "まあ、先生のことはこれから知っていけばいいわけだもんね。"
    },
    {
      "Name": "ルミ",
      "Text": "だけど、その、似合ってるってストレートに言われると……あはは……うん。"
    },
    {
      "Name": "ルミ",
      "Text": "あ、ありがとう。"
    },
    {
      "Name": "キサキ",
      "Text": "妾も輪に入れてもらえるかの？"
    },
    {
      "Name": "ココナ",
      "Text": "門主様？"
    },
    {
      "Name": "キサキ",
      "Text": "はて。妾はキサキじゃが……。"
    },
    {
      "Name": "ココナ",
      "Text": "あ、そうでした！ごめんなさい、キサキお姉さん。"
    },
    {
      "Name": "キサキ",
      "Text": "ふふ。ココナからそう呼ばれる日がくるとは。\nこれもまた一興じゃな。"
    },
    {
      "Text": "[ns] \"キサキ……。\""
    },
    {
      "Name": "ルミ",
      "Text": "おっ、気合入れたね！"
    },
    {
      "Name": "キサキ",
      "Text": "妾はただの高校生、[ruby=りゅうげ]竜華[/ruby]キサキ。"
    },
    {
      "Name": "キサキ",
      "Text": "この程度の着こなしは普通じゃよ。"
    },
    {
      "Name": "キサキ",
      "Text": "それで……どうじゃろうか。"
    },
    {
      "Name": "キサキ",
      "Text": "思いは、言葉にせんと伝わらんぞ？"
    },
    {
      "Text": "[s] \"色々と、夢みたい……。\""
    },
    {
      "Name": "キサキ",
      "Text": "なるほど。好意は示しつつも明言は避け、解釈は相手に委ねる……。"
    },
    {
      "Name": "キサキ",
      "Text": "よかろう。合格点じゃ。"
    },
    {
      "Name": "キサキ",
      "Text": "ん？なんじゃ、体の調子か？ふむ……。"
    },
    {
      "Text": "（一瞬、キサキとルミの目が合った）"
    },
    {
      "Name": "キサキ",
      "Text": "心なしか、いつもより軽く感じる。皆には感謝しておるぞ。"
    },
    {
      "Name": "シュン",
      "Text": "それはなによりです。門し――キサキさん。"
    },
    {
      "Name": "シュン",
      "Text": "うふふ。こんな呼び方、なんだか失礼なことをしている気分ですね。"
    },
    {
      "Name": "キサキ",
      "Text": "シュンか。\n……ほう？これはまた。"
    },
    {
      "Name": "シュン",
      "Text": "せっかくの機会ですから。キサキさんもよくお似合いですよ。"
    },
    {
      "Name": "シュン",
      "Text": "それで、先生は見ているだけなんですか？\nたとえありきたりな言葉でも、言ってもらうと嬉しいのですよ？"
    },
    {
      "Text": "[s3] \"その前振りの後だとあれだけど……。\""
    },
    {
      "Text": "[s4] \"すごく似合ってるよ。\""
    },
    {
      "Name": "シュン",
      "Text": "ありがとうございます。嬉しいです。"
    },
    {
      "Name": "シュン",
      "Text": "これで水着の感想は満足したので……この機会に、もう1つ。\n前々から言ってみたかったことがあるんです。"
    },
    {
      "Name": "ルミ",
      "Text": "なになに？"
    },
    {
      "Name": "シュン",
      "Text": "皆さん、帰るまでが遠足ですよ？"
    },
    {
      "Name": "ココナ",
      "Text": "シュン姉さんらしいね……。"
    },
    {
      "Name": "キサキ",
      "Text": "そうじゃな。"
    },
    {
      "Name": "ミナ",
      "Text": "さて、準備はできたようだな！\nこの場の安全は私に任せて、それぞれの役割を果たしてくれ！"
    },
    {
      "Text": "[ns] \"よ～っし……。\""
    },
    {
      "Name": "一同",
      "Text": "わあ～川だ～！！"
    },
    {
      "Name": "ミナ",
      "Text": "遊びに来ているわけではないんだぞ……！"
    },
    {
      "Text": "[ns] \"行こう！！！\""
    },
    {
      "Name": "ミナ",
      "Text": "まあ、いいか……観光客を演じる必要もあるし……。"
    },
    {
      "Name": "ココナ",
      "Text": "……冷た～い！"
    },
    {
      "Name": "シュン",
      "Text": "ココナちゃん？まずは準備体操ですよ？"
    },
    {
      "Name": "ルミ",
      "Text": "水に入る前の体操って何をしたらいいんだっけ。"
    },
    {
      "Name": "ミナ",
      "Text": "私も詳しくは……。"
    },
    {
      "Name": "キサキ",
      "Text": "ふむ。"
    },
    {
      "Text": "（キサキが目くばせをしてきた）"
    },
    {
      "Name": "キサキ",
      "Text": "では……ここは妾がお手本を見せるとしよう。"
    },
    {
      "Name": "ミナ",
      "Text": "もっ――キサキ……様！？"
    },
    {
      "Name": "シュン",
      "Text": "あら。"
    },
    {
      "Name": "ココナ",
      "Text": "あれ？でも……。"
    },
    {
      "Name": "ルミ",
      "Text": "よろしく！"
    },
    {
      "Text": "（キサキのお手本にあわせて、みんなで「水辺のばんざい体操」をした）"
    },
    {
      "Text": "（査察という名の休暇が始まった！）"
    }
