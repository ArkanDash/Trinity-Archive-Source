    },
    {
      "Text": "[s9] \"ごめん、油断してた……。\""
    },
    {
      "Text": "[s10] \"話が通じる相手じゃないね……。\""
    },
    {
      "Name": "？？？",
      "Text": "新しい臣下を迎えると聞いたが、まさかシャーレの先生まで含まれているとは。"
    },
    {
      "Name": "？？？",
      "Text": "白蛤を開けたら、思いがけず真珠が出てきた気分だな。"
    },
    {
      "Name": "潮水の蛟龍",
      "Text": "まずは余とじっくり話し合わぬか？"
    },
    {
      "Name": "潮水の蛟龍",
      "Text": "[ruby=とうみ]渡海[/ruby]ココロ。"
    }
  ],
  "DialogKR": [
    {
      "Text": "제7화;블루홀"
    },
    {
      "Text": "(블루홀을 향한 긴 항해가 끝나갈 무렵……)"
    },
    {
      "Name": "사유리",
      "Text": "선생님, 도착했어."
    },
    {
      "Name": "사유리",
      "Text": "여기가 보물 지도에 표시된 장소야."
    },
    {
      "Text": "(배가 정박하고, 선수 밖으로 나가 밖을 바라보니 블루홀의 풍경이 눈 앞에 펼쳐졌다.)"
    },
    {
      "Text": "(수면 한 가운데 위치한 블루홀은 그 이름처럼 바다에 푸른 잉크를 떨어트린 것처럼 짙푸른 빛깔로 물들어 있었다.)"
    },
    {
      "Text": "[ns] \"……정말 신비로운 풍경이네.\""
    },
    {
      "Name": "코코로",
      "Text": "네…… 정말 아름다운 풍경이지만요."
    },
    {
      "Name": "코코로",
      "Text": "블루홀은 석회 동굴과 같은 원리로 생성된 지형이라, 안에 들어가면 길을 잃고 빠져나오지 못할 수도 있어요."
    },
    {
      "Name": "코코로",
      "Text": "그래서 다이버들에게는 도전의 대상이기도 하지만, 해난 사고가 자주 일어나는 위험한 다이빙 포인트이기도 해요."
    },
    {
      "Name": "코코로",
      "Text": "그런 만큼…… 더 철저히 안전 준비를 하지 않으면……!"
    },
    {
      "Name": "마키나",
      "Text": "코코로 부장이 평소에 하는 것 이상으로 더 철저히 준비를 할 수 있는 거야?"
    },
    {
      "Name": "코코로",
      "Text": "무, 물론이지!"
    },
    {
      "Name": "코코로",
      "Text": "두 번 봐야 하는 걸 세 번 보고, 세 번 볼 것을 네 번 보면서 계속 체크하면—"
    },
    {
      "Name": "사유리",
      "Text": "그러다 하루가 다 저물겠어~"
    },
    {
      "Name": "코토네",
      "Text": "우선은 누가 먼저 들어갈지 부터 정하자."
    },
    {
      "Name": "마키나",
      "Text": "나, 나, 나, 나, 나!\n나랑 사유리가 먼저 들어갈게!"
    },
    {
      "Name": "코코로",
      "Text": "마키나가 먼저?"
    },
    {
      "Name": "마키나",
      "Text": "응."
    },
    {
      "Name": "마키나",
      "Text": "이번 일은 내 책임도 있으니까……"
    },
    {
      "Name": "코코로",
      "Text": "하, 하지만 어떤 위험이 있을지 알 수 없는 장소이니, 여기선 역시 부장인 내가 먼저 들어가는 편이……"
    },
    {
      "Name": "마키나",
      "Text": "위험한 건 부장이든 누구든 마찬가지 잖아?"
    },
    {
      "Name": "마키나",
      "Text": "걱정 마. 위험한 일이 있으면 바로 빠르게 물 밖으로 도망칠 테니까."
    },
    {
      "Name": "사유리",
      "Text": "아이 엠 패스트~"
    },
    {
      "Name": "코코로",
      "Text": "무, 물 밖으로 나올 때는 천천히 시간을 들여서 나와야 하거든?!"
    },
    {
      "Text": "(이후, 코코로의 신신당부를 받아가며 마키나와 사유리가 물 속으로 들어가는 것을 지켜보았다.)"
    },
    {
      "Text": "(그리고 그로부터 약 한 시간 정도 지났을 때……)"
    },
    {
      "Name": "마키나",
      "Text": "후우……"
    },
    {
      "Name": "코토네",
      "Text": "생각보다 일찍 올라왔네."
    },
    {
      "Name": "코코로",
      "Text": "무, 무슨 문제라도 있었어?"
    },
    {
      "Name": "마키나",
      "Text": "아니, 다이빙 자체는 큰 문제가 없었는데……"
    },
    {
      "Name": "사유리",
      "Text": "고래가 있어~"
    },
    {
      "Text": "[s] \"고래?\""
    },
    {
      "Name": "마키나",
      "Text": "응. 한 60m 정도 내려갔을 때 한 무리의 혹등고래가 몰려와서 우리가 더 내려가는 걸 방해하더라고."
    },
    {
      "Name": "마키나",
      "Text": "다른 곳에서는 이런 행동을 보인 적이 었었는데…… 왜 그러는 걸까?"
    },
    {
      "Name": "코토네",
      "Text": "뭔가 더 깊은 곳에 포식 생물이라도 있는 건가? 가끔 상어 떼를 발견하면 그러잖아."
    },
    {
      "Name": "마키나",
      "Text": "블루홀의 수심 100m 지점에 그렇게 위험한 생물이 살고 있을 것 같지는 않은데."
    },
    {
      "Name": "사유리",
      "Text": "루스카다……!"
    },
    {
      "Name": "마키나",
      "Text": "그러니까 그건 도시 전설이라니까."
    },
    {
      "Name": "코코로",
      "Text": "……설마. 그 때 말한 보물이라는 게……"
    },
    {
      "Name": "마키나",
      "Text": "……부장?"
    },
    {
      "Name": "코코로",
      "Text": "아, 아니야."
    },
    {
      "Name": "코코로",
      "Text": "여하튼 수고 많았어. 이어서 이번에는 나와 코토네가 내려갈게."
    },
    {
      "Name": "코토네",
      "Text": "오케이~"
    },
    {
      "Name": "사유리",
      "Text": "아, 괭이갈매기다."
    },
    {
      "Name": "마키나",
      "Text": "……그러게."
    },
    {
      "Name": "사유리",
      "Text": "이번에는 새날치야~"
    },
    {
      "Name": "마키나",
      "Text": "……진짜네."
    },
    {
      "Name": "마키나",
      "Text": "………."
    },
    {
      "Text": "[s] \"뭔가 하고 싶은 말이라도 있어?\""
    },
    {
      "Name": "마키나",
      "Text": "아, 아니!"
    },
    {
      "Name": "마키나",
      "Text": "그냥 두 사람이 언제 올라올지 기다리다 보니 심심해서."
    },
    {
      "Name": "마키나",
      "Text": "……저기."
    },
    {
      "Name": "마키나",
      "Text": "샬레의 선생님이라는 건 총학생회장에 준하는 초법적인 권한을 갖고 있는 거지?"
    },
    {
      "Name": "마키나",
      "Text": "그럼 원한다면 학생들에게 마음대로 명령하고, 지시할 수 있는 거 아냐?"
    },
    {
      "Text": "[s1] \"아…… 마도?\""
    },
    {
      "Text": "[s2] \"해본 적은 없지만 그렇지 않을까?\""
    },
    {
      "Name": "사유리",
      "Text": "……그럼 원하는 것도 뭐든지 가질 수 있는 거야?"
    },
    {
      "Name": "사유리",
      "Text": "아무 학생에게나 10만엔만 빌려달라고 하면 무조건 빌려줘야 해?"
    },
    {
      "Text": "[s3] \"그건 아닐 거야……\""
    },
    {
      "Text": "[s4] \"가능하더라도 그런 말은 하고 싶지 않아……\""
    },
    {
      "Name": "마키나",
      "Text": "그런데, 왜 그런 권한을 갖고 있으면서 학생들의 이야기를 듣고만 있는 거야?"
    },
    {
      "Text": "[s] \"예를 들면?\""
    },
    {
      "Name": "마키나",
      "Text": "생각대로 해결되지 않는 문제라도, 선생님이라면 한 마디로 해결할 수 있잖아."
    },
    {
      "Name": "마키나",
      "Text": "다이빙부의 문제도…… 선생님이 우리에게 다이빙을 그만두라고 명령하면 바로 해결되었을 텐데."
    },
    {
      "Text": "[s] \"응? 혹시 마키나는 다이빙을 그만두고 싶어?\""
    },
    {
      "Name": "마키나",
      "Text": "그건 아니지만……!"
    },
    {
      "Name": "마키나",
      "Text": "아일랜드는 우리 때문에 곤란해 했잖아."
    },
    {
      "Name": "마키나",
      "Text": "선생님 입장에서는 그 쪽도 학생이잖아?"
    },
    {
      "Text": "[s] \"학생이지.\""
    },
    {
      "Name": "마키나",
      "Text": "그런데 선생님은 학생을 위한다면서도 학생들이 서로 갈등하고 싸우는 데도 쉬이 결단을 내리지 않고 계속 기다리는 것만 같아서."
    },
    {
      "Name": "마키나",
      "Text": "뭔가 답이 없는 문제를 되풀이하며 억지를 부리는 학생을 보면……"
    },
    {
      "Name": "마키나",
      "Text": "답답하지 않아?"
    },
    {
      "Text": "[s] \"답답할 때도 있지.\""
    },
    {
      "Name": "마키나",
      "Text": "그럼 선생님이 대신 결론을 내려주면 안 돼?"
    },
    {
      "Text": "[s5] \"안 돼.\""
    },
    {
      "Text": "[s6] \"나는 그럴 권한이 없거든.\""
    },
    {
      "Name": "마키나",
      "Text": "왜? 아까는 모든 학생에게 명령하고, 지시할 권한이 있다며."
    },
    {
      "Text": "[s7] \"그건 어디까지나 지시를 할 수 있을 뿐이지.\""
    },
    {
      "Text": "[s8] \"지시를 받아들이고 수용하는 건 학생 본인이니까.\""
    },
    {
      "Name": "마키나",
      "Text": "으음…… 뭔가 궤변론자처럼 보이는데."
    },
    {
      "Name": "마키나",
      "Text": "이상한 어른의 향기가……"
    },
    {
      "Name": "사유리",
      "Text": "마키나, 마키나."
    },
    {
      "Name": "마키나",
      "Text": "왜? 부장이랑 부부장이 올라오는 것처럼 보여?"
    },
    {
      "Name": "사유리",
      "Text": "아니, 수평선 쪽에서 누군가가 이쪽으로 오고 있어."
    },
    {
      "Name": "마키나",
      "Text": "이 주변은 항로도 아닌데? 트라이던트가 순찰을 나오기엔 꽤 먼 거리인데……"
    },
    {
      "Name": "사유리",
      "Text": "……익숙한 깃발."
    },
    {
      "Name": "마키나",
      "Text": "저건……"
    },
    {
      "Name": "마키나",
      "Text": "<조수의 교룡>이잖아?!"
    },
    {
      "Text": "[s] \"조수의 교룡이라면…… 그 문제아 학생?\""
    },
    {
      "Name": "마키나",
      "Text": "문제아라는 말 만으로는 부족해!"
    },
    {
      "Name": "마키나",
      "Text": "조수의 교룡은 오디세이아에서…… 아니, 키보토스에서 가장 악랄한 해적 집단의 리더라고!"
    },
    {
      "Name": "마키나",
      "Text": "선생님, 도망—"
    },
    {
      "Name": "마키나",
      "Text": "아니, 도망칠 곳도 없나."
    },
    {
      "Name": "마키나",
      "Text": "일단은 숨어! 그리고 사유리, 바로 부장에게 연락해. 해적이 나타났다고!"
    },
    {
      "Name": "사유리",
      "Text": "메이데이, 메이데이~"
    },
    {
      "Name": "코코로",
      "Text": "……선생님!"
    },
    {
      "Name": "코코로",
      "Text": "젠장, 어느 틈에……"
    },
    {
      "Name": "코토네",
      "Text": "이미 상대가 너무 가까이 접근해서 보트로 돌아가는 건 어려울 것 같아."
    },
    {
      "Name": "코토네",
      "Text": "부장, 어쩌지?"
    },
    {
      "Name": "코코로",
      "Text": "일단은 버디 체크부터…… 다들 문제 없지?"
    },
    {
      "Name": "코토네",
      "Text": "올 그린. 문제없어."
    },
    {
      "Name": "코코로",
      "Text": "사유리. 아까 마키나가 분명히 상대가 '조수의 교룡' 이라고 했었어?"
    },
    {
      "Name": "사유리",
      "Text": "응. 나도 확실히 깃발을 확인했어."
    },
    {
      "Name": "코코로",
      "Text": "어느 틈에 이 정도의 선단을 확보했는지는 모르겠지만…… 흘수가 낮은 것으로 보아 장비를 많이 싣고 있는 건 아닌 것 같아."
    },
    {
      "Name": "코코로",
      "Text": "일단은 다시 물 속으로 잠수해서 교룡의 위치를—"
    },
    {
      "Name": "???",
      "Text": "허튼 수작을 부릴 거라면 포기하는 게 좋을 텐데."
    },
    {
      "Name": "???",
      "Text": "네 동료와 [USERNAME] 선생님은 이미 우리 손에 넘어왔거든."
    },
    {
      "Name": "코토네",
      "Text": "어느 틈에……"
    },
    {
      "Name": "마키나",
      "Text": "미안, 부장……"
    },
    {
      "Name": "마키나",
      "Text": "부장이 올라올 때까지 어떻게든 시간을 벌어보려고 했는데……"
    },
    {
      "Name": "마키나",
      "Text": "그 사이에 선생님이 붙잡혀 버렸어."
    },
    {
      "Text": "[s9] \"미안. 방심해 버렸어……\""
    },
    {
      "Text": "[s10] \"말이 통하는 상대가 아니었네……\""
    },
    {
      "Name": "???",
      "Text": "새로운 가신이 온다고 들었는데, 그 무리에 설마 샬레의 선생님이 섞여 있었을 줄이야."
    },
    {
      "Name": "???",
      "Text": "귀한 백합을 열었더니, 생각지도 못한 진주를 손에 넣은 기분이구나."
    },
    {
      "Name": "조수의 교룡",
      "Text": "우선은 여와 천천히 이야기를 나누어 보지 않겠나?"
    },
    {
      "Name": "조수의 교룡",
      "Text": "토미 코코로."
    }
  ],
