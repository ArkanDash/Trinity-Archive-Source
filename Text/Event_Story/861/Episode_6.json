{
  "TitleJP": "損害賠償",
  "TitleKR": "손해배상청구서",
  "TitleEN": "",
  "TitleTH": "",
  "TitleTW": "",
  "DescJP": "財務状況を改善するどころか、事故の責任を問われて損害賠償が加わり莫大な借金を背負うことになったダイビング部。賠償は「部」に請求されるため、廃部にすれば事実上の帳消しになるとミナトが提案する。回答は保留し、途方に暮れるココロたちのもとへ、怪しげな生徒が近づいてくる。",
  "DescKR": "재정 문제를 해결하기는커녕, 수리비로 막대한 빚을 지게 된 다이빙부. 고민에 잠긴 코코로 일행에게 한 수상한 학생이 접근한다.",
  "DescEN": "",
  "DescTH": "",
  "DescTW": "",
  "DialogJP": [
    {
      "Text": "第5話;損害賠償"
    },
    {
      "Text": "アイランド・士官室"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "……船底を掃除していたらフジツボが爆発した、と？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "……はい。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "俄かには信じがたいけど……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "とはいえ、作業中の爆発で船に穴が開くこと自体は日常茶飯事。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "例えば――掃除が面倒だからといって、付着物を爆弾で吹き飛ばそうとしたり。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "…………。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "心当たりはないの？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "まったくない、わけでは……ない、です……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "……残念でならないわ、ココロ部長。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "不慮の事故なら酌量の余地もあったけど……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "個人の不注意が原因なら、ダイビング部にも修理費を負担してもらうことになる。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "あ、あの……。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "こんなことを聞くのは恥ずかしいのですが……。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "その……金額はどのくらいに……？"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "補修に係る費用と、海水に浸った物の損害賠償まで考慮すると……。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "概算でこの程度になるかと。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "ひぇっ……！"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "あ、あの……何かの間違いじゃないですか？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "うちの年間活動費以上の金額に見えるのですが……。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "計算に間違いはありません。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "むしろこれでも少なく見積もっています。\n事故で船を使用できない間の損失は、アイランドが負担しますので。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "ううぅ……。"
    },
    {
      "Text": "[s1] \"どうにかならないかな？\""
    },
    {
      "Text": "[s2] \"なんかこう、例外として……。\""
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "[ruby=・]例[/ruby][ruby=・]外[/ruby]、ですか……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "先生。不確定要素の多い航海で、最もやってはいけない判断は何だと思いますか？"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "答えは、例外を認めること。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "意図したものではないから。しょうがないから。今回だけだから。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "理由はどうあれ、例外を認め始めた瞬間――"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "船の結束は一息に緩み、荒波を乗り越える力を失います。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "今は停泊中であることだけは幸いでしたが、これが海のど真ん中だったら……\n小さなミスが、命を脅かす大事故につながっていたかもしれません。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "たった1枚、あるべき場所から板がなくなるだけで、船が沈むこともあるのです。"
    },
    {
      "Text": "[s] \"でも……。\""
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "先生の口添えがあろうと、本件に例外を適用することはできません。\nですが……チャラにする方法が、あるにはあります。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "賠償は、部員ではなく、部に請求されるもの。部そのものが無くなれば免除されます。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "廃部という手もあるけど……どうする？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "えっ……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "それほど難しい選択でもないと思うけど。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "ダイビング部は身体能力が高いから、トライデントや他の部でも活躍できるはず。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "でも……水中での活動をするならダイビング部でないと……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "うん、それも理解してる。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "……すみません。みんなと考えてきます。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "ふぅ……。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "悪役は趣味じゃないんですけどね。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "仕方ないですよ。艦長とはそういうものです。"
    },
    {
      "CharacterName": 1479622210,
      "Name": "ミナト",
      "Text": "ぴえーん。"
    },
    {
      "CharacterName": 3210836661,
      "Name": "アミ",
      "Text": "幼稚な言葉遣いは慎んでください。"
    },
    {
      "CharacterName": 2087192359,
      "Name": "コトネ",
      "Text": "……部長！"
    },
    {
      "CharacterName": 2373149292,
      "Name": "マキナ",
      "Text": "ごめん、部長……しこたま詰められたよね？"
    },
    {
      "CharacterName": 3608916501,
      "Name": "サユリ",
      "Text": "……ごめんね。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "ううん、大丈夫。仕方なかったんだから。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "フジツボが急に爆発するなんて思わなかったし……。"
    },
    {
      "CharacterName": 2087192359,
      "Name": "コトネ",
      "Text": "賠償請求とか……平気？"
    },
    {
      "CharacterName": 2087192359,
      "Name": "コトネ",
      "Text": "借金がこれ以上増えたら手に負えないよ。"
    },
    {
      "CharacterName": 2087192359,
      "Name": "コトネ",
      "Text": "やっぱり諦めたほうが……。"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "そ、そんなことない！"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "今から弱音を吐いてちゃダメ。きっと打開策があるはずだから。"
    },
    {
      "CharacterName": 3608916501,
      "Name": "サユリ",
      "Text": "……例えば？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "一獲千金を狙えるような宝の地図とか……。"
    },
    {
      "CharacterName": 2685891367,
      "Name": "怪しげなオデュッセイアの生徒",
      "Text": "もしかして、ダイビング部の皆さんですか？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "はっ、えっ、はいっ！？"
    },
    {
      "CharacterName": 4061181276,
      "Name": "ココロ",
      "Text": "ご、ごめんなさい！\n私たちが破った網の話なら――"
    },
    {
      "CharacterName": 2685891367,
      "Name": "怪しげなオデュッセイアの生徒",
      "Text": "網……？\nいえ。お尋ねしたいことがありまして。"
    },
    {
      "CharacterName": 2685891367,
      "Name": "怪しげなオデュッセイアの生徒",
      "Text": "オデュッセイアで最も優秀なダイバーが集まってると聞いたんですけど……。"
    },
    {
      "CharacterName": 2685891367,
      "Name": "怪しげなオデュッセイアの生徒",
      "Text": "その腕を見込んで……依頼をしても？"
    }
  ],
  "DialogKR": [
    {
      "Text": "제5화;손해배상청구서"
    },
    {
      "Text": "아일랜드 사관실"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "그러니까…… 선저 작업 중 따개비가 폭발했다는 거지?"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "……네."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "증언만으로는 조금 믿기 어렵지만."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "뭐, 키보토스에서 해상 작업 중 폭발로 인해 배에 구멍이 나는 일은 제법 흔하니까."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "예를 들면— 청소하는 게 귀찮다고 총기나 폭발물로 선체 부착 생물을 제거하려다 유폭이 발생한다던가."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "………."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "관련하여 뭔가 짚이는 부분은 없었어?"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "짚이는 부분이…… 있긴 합니다……."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "유감이야, 코코로 부장."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "불의의 사고라면 어느정도 참작이 가능하지만, 개인의 부주의로 발생한 사고에 대해서는 아일랜드도 적극적으로 지원을 하기는 어려워서……"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "아무래도 이번 사고에 대해서는 다이빙부에도 어느 정도 수리비를 청구해야 할 것 같네."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "저, 저기……"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "이런 질문을 드리는 게 다소 면목없다는 건 알고 있지만……"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "호, 혹시 비용이 얼마나 나오려나요……?"
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "우선 보수 및 배수 작업에 든 기재 비용을 시작으로 함선 수리 비용과 침수로 인해 못 쓰게 된 적재물의 배상 비용까지 더하면……"
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "아마, 이 정도 금액이 청구될 예정입니다."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "………!"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "저, 저기…… 혹시 숫자가 잘못된 건 아닌가요?"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "뭔가 화면에 저희 동아리 1년 운영비를 넘는 비용이 적혀 있는 것 같은데……"
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "계산에 틀린 부분은 없습니다."
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "오히려 사고로 배를 사용하지 못하는 동안의 손실액은 아일랜드에서 부담하기로 했으니 예상보다 적게 나왔다고 생각하시는 편이 좋을 겁니다."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "으으……"
    },
    {
      "Text": "[s1] \"뭔가 봐줄 수는 없는 거야?\""
    },
    {
      "Text": "[s2] \"아무리 그래도 불의의 사고인데, 예외로 할 수는……\""
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "예외라……"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "선생님. 변수로 가득한 바다를 항해할 때 가장 내려서는 안 되는 위험한 판단이 무엇인지 아시나요?"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "바로 예외를 두는 것입니다."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "의도치 않았으니까. 어쩔 수 없으니까. 이번만이니까."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "편의를 위해, 혹은 상대를 배려하기 위해 예외를 하나씩 두기 시작하는 순간……"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "배의 결속은 순식간에 헐거워지고, 파도를 견뎌낼 수 없게 됩니다."
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "게다가 이곳이 정박지가 아니라 망망대해 한 가운데였더라면, 이 사소한 실수가 인명 사고로 이어졌을 수도 있습니다."
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "제 자리를 떠난 판자 한 장 때문에, 배가 가라앉을 수도 있는 법이니까요."
    },
    {
      "Text": "[s] \"하지만……\""
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "사실 다이빙부가 지고 있는 빚을 모두 없앨 수 있는 다른 방법이 있기는 합니다."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "지금 바로 폐부 신청을 하신다면 다이빙부에 청구된 비용은 일괄 면제됩니다."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "어때. 지금 바로 폐부 신청서를 작성할래?"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "………!"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "그리 가혹한 결정은 아니라고 생각하는데."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "다이빙부의 부원들은 신체 능력이 뛰어난 편이니, 트라이던트나 다른 동아리에 입부하더라도 충분히 활약할 수 있을 거야."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "하지만…… 오디세이아에서도 수중 활동을 할 수 있는 장소는 다이빙부 뿐인데……"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "그건, 그렇지만."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "……죄송합니다. 부원들과 조금 더 고민해 보고 올게요."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "후우……"
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "악역은 별로 취향이 아닌데."
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "어쩌겠습니까. 아일랜드의 함장이라는 것이 그러기 위한 자리인데."
    },
    {
      "CharacterName": 1479622210,
      "Name": "미나토",
      "Text": "히잉."
    },
    {
      "CharacterName": 3210836661,
      "Name": "아미",
      "Text": "어른스럽게 구세요."
    },
    {
      "CharacterName": 2087192359,
      "Name": "코토네",
      "Text": "……부장!"
    },
    {
      "CharacterName": 2373149292,
      "Name": "마키나",
      "Text": "미안, 부장…… 많이 혼났어?"
    },
    {
      "CharacterName": 3608916501,
      "Name": "사유리",
      "Text": "……미안해."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "아니, 괜찮아. 어쩔 수 없는 사고였으니까."
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "따개비가 갑자기 폭발할 거라곤 아무도 생각하지 못했으니까……"
    },
    {
      "CharacterName": 2087192359,
      "Name": "코토네",
      "Text": "하지만 청구서가 꽤 나왔을 텐데, 괜찮겠어?"
    },
    {
      "CharacterName": 2087192359,
      "Name": "코토네",
      "Text": "이미 진 빚도 꽤 있는데, 이 이상 빚이 늘어나면 감당할 수 없을 거야."
    },
    {
      "CharacterName": 2087192359,
      "Name": "코토네",
      "Text": "역시 포기하는 편이……"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "그, 그렇지 않아!"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "벌써 약한 소리를 하면 안 되지. 이 상황을 타개할 수 있는 다른 방법이 또 있을 거야."
    },
    {
      "CharacterName": 3608916501,
      "Name": "사유리",
      "Text": "……다른 방법이라면?"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "뭔가 일확천금을 단번에 벌 수 있는 보물섬의 지도라던가~"
    },
    {
      "CharacterName": 2685891367,
      "Name": "수상한 오디세이아 학생",
      "Text": "저기, 혹시 다이빙부 학생들이신가요?"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "네, 네, 넷?!"
    },
    {
      "CharacterName": 4061181276,
      "Name": "코코로",
      "Text": "죄, 죄송합니다. 혹시 저희 때문에 망가진 어망이나 통발 이야기라면—"
    },
    {
      "CharacterName": 2685891367,
      "Name": "수상한 오디세이아 학생",
      "Text": "아뇨. 그런 문제가 아니라 여쭈고 싶은 게 있어서요."
    },
    {
      "CharacterName": 2685891367,
      "Name": "수상한 오디세이아 학생",
      "Text": "듣기로는 오디세이아에서 제일 가는 잠수 전문가들이라고 하시던데."
    },
    {
      "CharacterName": 2685891367,
      "Name": "수상한 오디세이아 학생",
      "Text": "한 가지 의뢰를 드려도 괜찮을까요?"
    }
  ],
